import stdin from "@std/io/io.ms"
import lines, collect from "@std/io/streams.ms"
import range_by from "@std/collections/collections.ms"

fn pad2(n: Int) String: return if n < 10: "0{n}" else: "{n}"

// Parses s when it is lo to hi ASCII digits.
fn digits(s: String, lo: Int, hi: Int) Int?:
    if s.length() < lo or s.length() > hi or not s.scalar_values().all(fn c: c >= 48 and c <= 57): return none
    return s.parse_int().get()

fn days_from_civil(year: Int, m: Int, d: Int) Int:
    y := if m <= 2: year - 1 else: year
    era := y / 400
    yoe := y - era * 400
    doy := (153 * (if m <= 2: m + 9 else: m - 3) + 2) / 5 + d - 1
    return era * 146097 + yoe * 365 + yoe / 4 - yoe / 100 + doy - 719468

// Returns [year, month, day].
fn civil_from_days(days: Int) List[Int]:
    z := days + 719468
    era := z / 146097
    doe := z - era * 146097
    yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    doy := doe - (365 * yoe + yoe / 4 - yoe / 100)
    mp := (5 * doy + 2) / 153
    m := if mp >= 10: mp - 9 else: mp + 3
    return [yoe + era * 400 + (if m <= 2: 1 else: 0), m, doy - (153 * mp + 2) / 5 + 1]

fn parse_field(text: String, lo: Int, hi: Int) List[Bool]?:
    var set = [false].repeated(hi + 1)
    for item in text.split(","):
        parts := item.split("/")
        body := parts[0]
        step := if parts.length() == 2: digits(parts[1], 1, 2).get(0) else: 1
        single := digits(body, 1, 2)
        r := body.split("-")
        if parts.length() > 2 or step < 1: return none
        rg := if body == "*": [lo, hi] else if single.is_some() and parts.length() == 1: [single.get(), single.get()] else if r.length() == 2 and digits(r[0], 1, 2).is_some() and digits(r[1], 1, 2).is_some(): [digits(r[0], 1, 2).get(), digits(r[1], 1, 2).get()] else: [1, 0]
        if rg[0] > rg[1] or rg[0] < lo or rg[1] > hi: return none
        for v in range_by(rg[0], rg[1] + 1, step).get(): set[v] = true
    return set

// Returns [day number, minute of day] for a valid START, or an empty list.
fn parse_start(s: String) List[Int]:
    if s.length() != 16 or s.slice(4, 5).get() != "-" or s.slice(7, 8).get() != "-" or s.slice(10, 11).get() != "T" or s.slice(13, 14).get() != ":": return []
    f := [s.slice(0, 4).get(), s.slice(5, 7).get(), s.slice(8, 10).get(), s.slice(11, 13).get(), s.slice(14, 16).get()].map(fn p: digits(p, p.length(), p.length()).get(-1))
    leap := (f[0] % 4 == 0 and f[0] % 100 != 0) or f[0] % 400 == 0
    limit := if f[1] == 2 and leap: 29 else: [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31].get(f[1] - 1, 0)
    if f.any(fn x: x < 0) or f[0] < 1970 or f[0] > 2099 or f[1] < 1 or f[1] > 12 or f[2] < 1 or f[2] > limit or f[3] > 23 or f[4] > 59: return []
    return [days_from_civil(f[0], f[1], f[2]), f[3] * 60 + f[4]]

fn schedule(count: Int, start: List[Int], sets: List[List[Bool]]) List[String]:
    var runs = List[String]()
    for k in 0..3001:
        day := start[0] + k
        ymd := civil_from_days(day)
        if not sets[3][ymd[1]] or not sets[2][ymd[2]] or not sets[4][(day + 4) % 7]: continue
        for h in 0..24:
            if not sets[1][h]: continue
            for m in 0..60:
                if not sets[0][m] or (k == 0 and h * 60 + m <= start[1]): continue
                runs.append("{ymd[0]}-{pad2(ymd[1])}-{pad2(ymd[2])} {pad2(h)}:{pad2(m)}")
                if runs.length() == count: return runs
    return runs

fn solve(t: List[String]) String:
    names := ["minute", "hour", "day-of-month", "month", "day-of-week"]
    lows := [0, 0, 1, 1, 0]
    highs := [59, 23, 31, 12, 6]
    if t.length() != 7: return "error: bad line"
    start := parse_start(t[0])
    if start.is_empty(): return "error: bad start"
    count := digits(t[1], 1, 2).get(0)
    if count < 1 or count > 20: return "error: bad count"
    sets := (0..5).map(fn i: parse_field(t[2 + i], lows[i], highs[i]))
    if bad := sets.index_of(none): return "error: bad {names[bad]}"
    runs := schedule(count, start, sets.map(fn s: s.get([])))
    return if runs.is_empty(): "never" else: "{runs.length()} runs\n{runs.join("\n")}"

fn main() Unit:
    if ls := stdin() | lines | collect(none):
        for i in 0..ls.length():
            if not ls[i].replace(" ", "").is_empty(): print("line {i + 1}: {solve(ls[i].split(" "))}")
