# Generator for c55-jq-lite. The expected outputs come from the Go oracle in oracle/*.ref (built with the
# local Go toolchain); this file only supplies the inputs. Deterministic; run: ms run bench/agent/gen.ms -- c55
import Cases, build_oracle, write_cases from "../../lib/gen.ms"

let PEOPLE = "[\{\"name\":\"Alice\",\"age\":30,\"tags\":[\"a\",\"b\"],\"addr\":\{\"city\":\"Paris\",\"zip\":\"75001\"\}\},\{\"name\":\"Bob\",\"age\":25,\"tags\":[],\"addr\":\{\"city\":\"Rome\",\"zip\":null\}\},\{\"name\":\"Carol\",\"age\":35,\"tags\":[\"c\"],\"addr\":null\}]"
let ORDERS = "\{\"orders\":[\{\"id\":1,\"items\":[\{\"sku\":\"a\",\"qty\":2,\"price\":3.5\},\{\"sku\":\"b\",\"qty\":1,\"price\":10\}],\"status\":\"paid\"\},\{\"id\":2,\"items\":[\{\"sku\":\"a\",\"qty\":5,\"price\":3.5\}],\"status\":\"open\"\},\{\"id\":3,\"items\":[],\"status\":\"paid\"\}]\}"

fn add(var cs: Cases, name: String, prog: String, inputs: String = "null", opts: String = "") Unit:
    let head = if opts.is_empty(): "" else: opts + " "
    let tail = if inputs.ends_with("\n"): "" else: "\n"
    cs.push(name, head + prog + "\n" + inputs + tail)


export fn gen_c55() Unit:
    var cs = Cases(build_oracle("c55-jq-lite"))
    add(var cs, "field-access", ".a, .b.c, .b.c.d, .x, .a.y", "\{\"a\":\{\"y\":1\},\"b\":\{\"c\":\{\"d\":[1]\}\}\}")
    add(var cs, "index-array", ".[0], .[2], .[-1], .[-3], .[3], .[-4], .[1.7]", "[10,20,30]")
    add(var cs, "slices", ".[1:3], .[:2], .[-2:], .[2:], .[1:-1], .[5:], .[-10:2], .[1.5:3.2]", "[0,1,2,3,4]")
    add(var cs, "iterate", ".[], .[]?", "[1,[2],\{\"a\":3\}]")
    add(var cs, "iterate-object", ".[], keys, [.[]]", "\{\"b\":2,\"a\":1,\"c\":[3]\}")
    add(var cs, "recurse-dots", "[..]", "[1,[2,\{\"a\":3\}],\{\"b\":[4]\}]")
    add(var cs, "array-construct", "[.[] | . * 2], [], [1,2,3,4][1:3], [.[0], .[1]], [range(3)]", "[1,2,3]")
    add(var cs, "object-construct", "\{a: 1, \"b\": 2, (.k): 3, \"c\\(.k)\": 4, name, \"age\": .age\}", "\{\"k\":\"kk\",\"name\":\"N\",\"age\":5\}")
    add(var cs, "object-generators", "\{a: (1,2), b: (3,4)\}, \{(.k,\"z\"): 1\}, \{a: .l[]\}", "\{\"k\":\"q\",\"l\":[7,8]\}")
    add(var cs, "pipes-commas", ".a | (.b, .c) | . + 1", "\{\"a\":\{\"b\":1,\"c\":2\}\}")
    add(var cs, "arith-numbers", ".a + .b, .a - .b, .a * .b, .a / .b, .a % .b, -.a, (.a + .b * 2 - 1), (10 / 4), (7 % 3), (-7 % 3), (7 % -3), (5.9 % 3.2)", "\{\"a\":7,\"b\":2\}")
    add(var cs, "arith-errors", "(try (1 + \"a\") catch .), (try (\{\} - 1) catch .), (try ([] * 2) catch .), (try (\"a\" / 1) catch .), (try (1 / 0) catch .), (try (1 % 0) catch .), (try (null - 1) catch .), (try (-\"a\") catch .), (try (\{\} + []) catch .)", "null")
    add(var cs, "division-precision", "1/3, 2/3, 10/3, 0.1 + 0.2, 1e15 + 1, 3.0, 100 / 8, 1 / 8, 123456789 * 1000, 0.5 / 1000", "null")
    add(var cs, "boolean-logic", "(true and false), (true or false), (null and 1), (0 and \"x\"), (false or null), ((true, false) and (true, false)), ((true, false) or (true, false)), (1 | not), (null | not), (false, 1 | not)", "null")
    add(var cs, "alternative", ".a // \"d\", .b // \"d\", .c // \"d\", (.d // empty), ([.e[] // 5]), (empty // 1), ((null, false) // 2), ((1, null, 2) // 3), (error(\"x\") // 4), (.a // .b // 9)", "\{\"a\":0,\"b\":null,\"c\":false,\"e\":[null,false]\}")
    add(var cs, "if-then-else", ".[] | if . > 2 then \"big\" elif . > 1 then \"mid\" else \"small\" end", "[1,2,3]")
    add(var cs, "select-map", "map(select(.age >= 30) | .name), (map(.age) | add / length), [.[] | select(.tags | length > 0) | .name]", PEOPLE)
    add(var cs, "map-values", "map_values(. + 1), map(. * 2), (map_values(empty)), (map(select(. > 1)))", "\{\"a\":1,\"b\":2,\"c\":3\}")
    add(var cs, "keys-has", "keys, keys_unsorted, has(\"b\"), has(\"z\"), (.b | keys), (.b | has(1), has(2), has(-1)), length, (.b | length), (.s | length), (.n | length), (null | length), (.t | try length catch .)", "\{\"b\":[5,6],\"a\":1,\"s\":\"héllo\",\"n\":-4.5,\"t\":true\}")
    add(var cs, "any-all", "any, all, (map(. > 1) | any, all), any(. > 2), all(. > 0), any(.[]; . == 2), all(.[]; . < 3), ([] | any, all), (any(empty; .)), (all(empty; .))", "[1,2,3]")
    add(var cs, "flatten-range", "flatten, flatten(1), flatten(0), (try flatten(-1) catch .), [range(5)], [range(2;5)], [range(0;10;3)], [range(5;0;-2)], [range(0;1;0.25)], [range(-1)], [range(3;1)], [range(2.5)]", "[1,[2,[3,[4]]],[]]")
    add(var cs, "math-funcs", ".[] | [floor, ceil, round, (abs), (if . >= 0 then sqrt else null end)]", "[0, 1.5, -1.5, 2.5, -2.5, 16, 0.4]")
    add(var cs, "type-selectors", "[.[] | type], [.[] | numbers], [.[] | strings], [.[] | arrays], [.[] | objects], [.[] | booleans], [.[] | nulls], [.[] | values], [.[] | iterables], [.[] | scalars]", "[1,\"a\",[2],\{\"b\":3\},true,null,false]")
    add(var cs, "string-funcs", "(ascii_downcase), (ascii_upcase), (explode), (explode | implode), ltrimstr(\"He\"), rtrimstr(\"lo\"), ltrimstr(\"x\"), startswith(\"He\"), endswith(\"lo\"), split(\"l\"), split(\"\"), (split(\"l\") | join(\"-\")), index(\"l\"), rindex(\"l\"), indices(\"l\"), indices(\"ll\"), (try (1 | ascii_downcase) catch .), (1 | ltrimstr(\"a\"))", "\"Hello\"")
    add(var cs, "split-join", "(\"a,b,,c\" | split(\",\")), (\"\" | split(\",\")), (\"abc\" | split(\"\")), ([\"a\",1,null,true] | join(\"/\")), ([] | join(\",\")), ([\"x\"] | join(\",\")), (try ([[1]] | join(\",\")) catch .), (try ([\"a\"] | join(1)) catch .), (\"a--b\" | split(\"--\")), (\"ab\" | split(\"ab\"))", "null")
    add(var cs, "sort-group-unique", "sort, (map(.n) | sort), sort_by(.n), sort_by(.n, .s), sort_by(.s | length), group_by(.g), unique_by(.g), (map(.g) | unique), min_by(.n), max_by(.n), (map(.n) | min, max), ([] | min, max, sort, unique), min_by(.z)", "[\{\"n\":3,\"s\":\"cc\",\"g\":\"x\"\},\{\"n\":1,\"s\":\"a\",\"g\":\"y\"\},\{\"n\":3,\"s\":\"b\",\"g\":\"x\"\},\{\"n\":2,\"s\":\"dd\",\"g\":\"z\"\}]")
    add(var cs, "sort-errors", "try (\{\} | sort) catch ., try (1 | sort_by(.)) catch ., try (\"a\" | min) catch ., try (null | unique) catch .", "null")
    add(var cs, "to-from-entries", "to_entries, (to_entries | from_entries), with_entries(.value += 1), with_entries(select(.value > 1)), with_entries(.key |= ascii_upcase), ([\{\"name\":\"a\",\"value\":1\},\{\"k\":\"b\",\"v\":2\},\{\"Key\":\"c\",\"Value\":3\},\{\"key\":1,\"value\":4\},\{\"key\":null,\"value\":5\},\{\"key\":false\},\{\"name\":\"z\"\}] | from_entries), ([] | from_entries), (try (1 | to_entries) catch .)", "\{\"a\":1,\"b\":2,\"c\":3\}")
    add(var cs, "paths-getpath", "[paths], [paths(type == \"number\")], [leaf_paths], getpath([\"a\",\"b\"]), getpath([\"a\",\"x\",\"y\"]), getpath([\"z\"]), [getpath([\"a\",\"b\"], [\"c\"])], (try getpath([\"c\",\"d\"]) catch .), path(.a.b), [path(..)], [path(.c[])], (try path(1) catch .), (try path(.a | tostring) catch .), [path(.a, .c[0])], (path(.a | select(.b))), [path(.a | if .b then .b else empty end)], [path(.z // .a)], [path(first(.c[]))], [path(limit(1; .c[]))], [path(.c | last)]", "\{\"a\":\{\"b\":1\},\"c\":[true,null]\}")
    add(var cs, "setpath-delpaths", "setpath([\"a\",\"b\"]; 9), setpath([\"n\"]; 1), setpath([\"l\",2]; \"x\"), setpath([]; 5), (try setpath([\"a\",\"b\",\"c\"]; 1) catch .), (try setpath([0]; 1) catch .), delpaths([[\"a\",\"b\"]]), delpaths([[\"l\",0],[\"l\",1]]), delpaths([[\"zz\"]]), delpaths([[\"l\",-1]]), delpaths([[]]), delpaths([]), (try delpaths(1) catch .), (try delpaths([[\"a\",\"b\",\"c\"]]) catch .), (null | setpath([\"x\",1,\"y\"]; 1)), (try setpath([\"l\",-5]; 1) catch .)", "\{\"a\":\{\"b\":1\},\"l\":[1,2,3]\}")
    add(var cs, "del", "del(.a), del(.l[0]), del(.l[]), del(.a, .l), del(.l[] | select(. > 1)), del(.[]), del(.nope), del(.l[5]), del(.l[0,2]), del(.a.b), del(.. | select(. == 1))", "\{\"a\":\{\"b\":1\},\"l\":[1,2,3]\}")
    add(var cs, "assign-simple", ".a = 1, (.b.c = 2), (.l[1] = \"x\"), (.l[5] = 0), (.[] = 0), (.a = (.l | length)), (.l[] = (1,2)), (.n = .a), (.z.y.x = 1), (.l[-1] = 9)", "\{\"a\":10,\"l\":[1,2,3],\"b\":null\}")
    add(var cs, "assign-update", ".a |= . + 1, (.l[] |= . * 2), (.l |= map(. + 1)), (.a |= empty), (.l[] |= empty), (.l[] |= select(. > 1)), (.b |= 5), (.s |= ascii_upcase), (.l |= sort_by(-.)), ((.a, .l[0]) |= 0), (.l[] |= (., .)), (.a |= (1, 2))", "\{\"a\":1,\"l\":[1,2,3],\"b\":null,\"s\":\"hi\"\}")
    add(var cs, "assign-precedence", ".a = 1 | .b = 2, (.a = 1, .b = 2), (.a = .b + 1), (.a = 1 // 2), (.n = (.a | . + 1)), ((.a = 5) | .a), (.a = .b | .a)", "\{\"a\":null,\"b\":10,\"n\":0\}")
    add(var cs, "variables-as", "(. as $x | $x[0] + 1), (1 as $a | 2 as $b | [$a, $b, $a + $b]), (.[0] as $first | $first), ([.[] as $v | $v * $v]), (. as [$a, $b] | \{$a, $b\}), (. as [$a] | $a), ([.[] as $x | $x | . as $y | $y + 1])", "[5,6]")
    add(var cs, "destructuring", ". as \{a: $x, b: [$y, \{c: $z\}]\} | [$x, $y, $z], (. as \{$a\} | $a), (. as \{\"a\": $q\} | $q), (. as \{(\"a\",\"b\"): $k\} | $k), (. as \{b: [$p]\} | $p), ([.b] | .[] as [$m, \{c: $n\}] | [$m, $n])", "\{\"a\":1,\"b\":[2,\{\"c\":3\}]\}")
    add(var cs, "reduce", "reduce .[] as $x (0; . + $x), (reduce .[] as $x ([]; [$x] + .)), (reduce range(5) as $i (1; . * 2)), (reduce empty as $x (7; . + 1)), (reduce .[] as $x (0; empty)), (reduce .[] as $x (0; ., 100)), (reduce (1,2) as $x (0, 10; . + $x)), (reduce .[] as $x (\{\}; .[\"k\\($x)\"] = $x)), (reduce .[] as $x (null; . + $x)), ([reduce .[] as $x (0; . + 1, . + 2)])", "[1,2,3]")
    add(var cs, "limit-first", "[limit(3; .[])], [limit(0; .[])], [limit(-1; .[])], first(.[]), [first(empty)], [limit(2; range(1000000000))], first(range(10; 0; -1)), [limit(1; 1, error(\"x\"))], [limit(3; 1, 2)], [limit(2,3; .[])], (try first(error(\"e\")) catch .), [first(.[] | select(. > 2))], isempty(empty), isempty(1), isempty(.[] | select(. > 100)), isempty(1, error(\"x\"))", "[1,2,3,4,5]")
    add(var cs, "until-while-repeat", "[.[] | until(. > 100; . * 2)], [1 | while(. < 50; . * 3)], [limit(5; 1 | repeat(. * 2))], [2 | recurse(if . < 20 then . * . else empty end)], [.[0] | recurse(if . < 3 then . + 1 else empty end)], ([\{\"c\":[\{\"c\":[]\}]\}] | [recurse(.[]?.c?) ] | length)", "[1,5,50]")
    add(var cs, "walk", "walk(if type == \"number\" then . + 1 else . end), walk(if type == \"array\" then sort else . end), walk(if type == \"object\" then del(.x) else . end), walk(select(. != null)), walk(.)", "[3,\{\"x\":1,\"y\":[2,1]\},null,[5,4]]")
    add(var cs, "def-closures", "def apply(f): f | f; def twice(f): f | f; def mk($n): . + $n; def comp(f; g): f | g; 3 | apply(. * 2), twice(mk(1)), comp(. + 1; . * 10), (def inner: . * 3; inner), ([1,2] | map(mk(10)))", "null")
    add(var cs, "def-recursion", "def fac: if . <= 1 then 1 else . * (. - 1 | fac) end; def fib: if . < 2 then . else (. - 1 | fib) + (. - 2 | fib) end; def sum: if length == 0 then 0 else .[0] + (.[1:] | sum) end; def count(f): reduce .[] as $x (0; if ($x | f) then . + 1 else . end); [(10 | fac), (15 | fib), ([1,2,3,4] | sum), ([1,2,3,4,5] | count(. % 2 == 1))]", "null")
    add(var cs, "try-catch", "[.[] | try (if . == 2 then error(\"two\") else . end) catch \"caught\"], (try error(\"x\") catch .), (try error(\{a:1\}) catch .a), (try error(null) catch .), [.[] | (if . == 2 then error(\"e\") else . end)?], (try (1, error(\"x\"), 3) catch \"c\"), ([.[] | try error catch .]), (try (try error(\"in\") catch error(\"out\")) catch .), (try error catch .)", "[1,2,3]")
    add(var cs, "try-nested-pass", "try ((try (1, 2) catch \"inner\") | if . == 2 then error(\"down\") else . end) catch \"outer:\\(.)\"", "null")
    add(var cs, "error-uncaught-string", ".[] | if . < 0 then error(\"negative: \\(.)\") else . end", "[1,-2,3]")
    add(var cs, "error-builtin-types", ".[] | try length catch .", "[true, \{\}, [], \"\", 0]")
    add(var cs, "error-messages", ".[] | try (.a) catch ., try (.[0]) catch ., try (.[]) catch ., try (keys) catch ., try has(\"a\") catch ., try has(0) catch .", "[1,\"s\",true,[1],\{\"a\":1\}]")
    add(var cs, "error-compile", ".a | nosuch(1)", "\{\"a\":1\}")
    add(var cs, "error-compile-var", ".a as $x | $y", "\{\"a\":1\}")
    add(var cs, "compile-before-input", ".a | missing", "\{\"a\":1\} \{\"a\":2\}")
    add(var cs, "error-syntax-1", ".a +", "1")
    add(var cs, "error-syntax-5", "if 1 then 2", "1")
    add(var cs, "object-value-expr", "\{a:1 + 2\}", "1")
    add(var cs, "error-syntax-20", "", "1")
    add(var cs, "error-invalid-json", ".", "\{\"a\":1\} \{bad\} 3")
    add(var cs, "json-numbers-strings", ".", "0 -0 1.50 2e3 1E-2 123456789012 -0.5 \"\\u0041\\u00e9\\u4e2d\" \"\\ud83d\\ude00\" \"tab\\there\" \"\\/ \\b\\f\" \"\\u0000\\u001f\\u007f\"")
    add(var cs, "json-empty-input-n", "1, 2", "", opts: "-n")
    add(var cs, "opt-raw", ".[]", "[\"a\\nb\", 1, null, \{\"a\":\"x\"\}, [\"s\"], \"é\", \"\"]", opts: "-r")
    add(var cs, "opt-slurp", "., length, map(. * 2)", "1 2 3", opts: "-s")
    add(var cs, "opt-slurp-raw", ".[] | strings", "\"a\" 1 \"b\"", opts: "-r -s")
    add(var cs, "opt-null-input", "[1,2] | add", "ignored \{bad json", opts: "-n")
    add(var cs, "multi-input-errors", "if type == \"number\" then . * 2 else error(\"not a number: \\(.)\") end", "1 \"a\" 3 null 5")
    add(var cs, "string-interp", "\"a\\(.x)b\", \"\\(.x)\", \"\\(.x + 1) and \\(.y)\", \"\\(.l)\", \"\\(\"nested \\(.x)\")\", \"\\(.x, .x + 1)-\\(10, 20)\", \"\\(null)\", \"no interp\", \"\", \"\\(.s)\", \"q\\\"uote\", \"t\\tb\\nn\\\\\"", "\{\"x\":1,\"y\":\"two\",\"l\":[1,\{\"a\":null\}],\"s\":\"str\"\}")
    add(var cs, "formats", "(.l | @csv), (.l | @tsv), (.s | @html), (.s | @uri), (.s | @base64), (.s | @base64 | @base64d), (.o | @json), (.l | @text), (.s | @json), (.l | @json), @json \"v=\\(.l)\", @csv \"r:\\(.l)\", @html \"<b>\\(.s)</b>\", @uri \"q=\\(.s)\", @base64 \"\\(.s)\", @text \"\\(.o)\", (.n | @text, @json)", "\{\"l\":[1,\"a,b\",\"q\\\"r\",\"t\\tx\",null,true,2.5],\"s\":\"<a&b> 'x' \\\"y\\\" ~z-_.é\",\"o\":\{\"k\":[1]\},\"n\":12\}")
    add(var cs, "format-errors", "(try ([\{\}] | @csv) catch .), (try (\{\} | @csv) catch .), (try (\"a\" | @tsv) catch .), (try ([[1]] | @tsv) catch .), (try (\"!!\" | @base64d) catch .), (1 | @html), (null | @uri), ([1,[2]] | @html), (true | @base64)", "null")
    add(var cs, "complex-orders", "(.orders | map(select(.status == \"paid\") | \{id, total: (.items | map(.qty * .price) | add // 0)\})), ([.orders[].items[]] | group_by(.sku) | map(\{sku: .[0].sku, qty: (map(.qty) | add)\})), (.orders | map(.items | length) | max), ([.orders[] | select(.items | length > 0) | .id]), (.orders | map(\{(.id | tostring): .status\}) | add), ([.orders[] | .items[] | select(.price > 5) | .sku] | unique)", ORDERS)
    add(var cs, "complex-transform", "to_entries | map(select(.value | type == \"number\")) | sort_by(-.value) | map(\"\\(.key): \\(.value)\") | .[]", "\{\"a\":3,\"b\":\"x\",\"c\":10,\"d\":1.5,\"e\":null\}")
    add(var cs, "complex-matrix", "[range(3) as $i | [range(3) as $j | $i * 3 + $j]] | ., transpose, (map(add)), (transpose | map(add)), ([.[][]] | add), (map(reverse)), (. as $m | [range(3) | $m[.][.]])", "null")
    add(var cs, "complex-flatten-paths", "[paths(scalars) as $p | \{path: ($p | map(tostring) | join(\".\")), value: getpath($p)\}]", "\{\"a\":\{\"b\":[1,\{\"c\":2\}],\"d\":\"x\"\},\"e\":null\}")
    add(var cs, "complex-pivot", "group_by(.region) | map(\{region: .[0].region, total: (map(.amt) | add), items: map(.item) | sort\}) | sort_by(.region)", "[\{\"region\":\"n\",\"item\":\"b\",\"amt\":5\},\{\"region\":\"s\",\"item\":\"a\",\"amt\":2\},\{\"region\":\"n\",\"item\":\"a\",\"amt\":7\},\{\"region\":\"s\",\"item\":\"c\",\"amt\":1.5\}]")
    add(var cs, "complex-stats", "(add / length) as $mean | (map(. - $mean | . * .) | add / length) as $var | \{mean: $mean, variance: $var, sorted: sort, median: (sort | if length % 2 == 1 then .[length / 2 | floor] else (.[length / 2 - 1] + .[length / 2]) / 2 end)\}", "[2,4,4,4,5,5,7,9]")
    add(var cs, "generator-cartesian", "[(1,2) * (10,20)], [(1,2) - (10,20)], [[(1,2), 3] | .[]], [\"\\(1,2)\\(3,4)\"], [(1,2) as $x | (10,20) as $y | $x + $y], [.[(0,1)]], [(1,2) | tostring], [(1,2) < (2,1)], [(true,false) and (true,false)], [range(1,2; 3,4)]", "[5,6,7,8]")
    add(var cs, "deep-nesting", "[recurse(.[0]?; type == \"array\")] | length", "[".repeat(150).get("") + "1" + "]".repeat(150).get(""))
    let examples = [
        cs.make("basic", ".users | map(select(.age >= 18) | \{name, adult: true\})\n\{\"users\":[\{\"name\":\"A\",\"age\":20\},\{\"name\":\"B\",\"age\":10\},\{\"name\":\"C\",\"age\":33\}]\}\n"),
        cs.make("reduce-and-format", "reduce .[] as $x (\{\}; .[$x.k] += $x.v) | to_entries[] | \"\\(.key)=\\(.value)\"\n[\{\"k\":\"a\",\"v\":1\},\{\"k\":\"b\",\"v\":2\},\{\"k\":\"a\",\"v\":3\}]\n"),
        cs.make("errors", "-r .[] | if type == \"string\" then ascii_upcase else error(\"bad: \\(. | tojson)\") end\n[\"x\",\"y\"] [1] [\"z\"]\n")
    ]
    write_cases("c55-jq-lite", examples, examples.concat(cs.list))
