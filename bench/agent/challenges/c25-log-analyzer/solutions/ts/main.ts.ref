import readFileSync from "node:fs";

const LEVELS = ["DEBUG", "INFO", "WARN", "ERROR"];
const METHODS = ["GET", "POST", "PUT", "DELETE"];
const digits = (s: string) => /^[0-9]+$/.test(s);

let valid = 0, malformed = 0;
const classes: Record<string, number> = { "2": 0, "3": 0, "4": 0, "5": 0, o: 0 };
const latencies: number[] = [];
let slowest: { lat: number; text: string } | null = null;
const levels: Record<string, number> = { DEBUG: 0, INFO: 0, WARN: 0, ERROR: 0 };
const count = new Map<string, number>();
const total = new Map<string, number>();

for (const line of readFileSync(0, "utf8").split("\n")) {
  if (line.trim() === "") continue;
  const f = line.split(" ");
  if (
    f.length !== 6 || f[0] === "" || !LEVELS.includes(f[1]) || !METHODS.includes(f[2]) ||
    !f[3].startsWith("/") || f[4].length !== 3 || !digits(f[4]) || !digits(f[5]) || f[5].length > 9
  ) {
    malformed++;
    continue;
  }
  valid++;
  levels[f[1]]++;
  classes["2345".includes(f[4][0]) ? f[4][0] : "o"]++;
  const lat = parseInt(f[5], 10);
  latencies.push(lat);
  if (slowest === null || lat > slowest.lat) slowest = { lat, text: `${lat} ${f[2]} ${f[3]} ${f[0]}` };
  count.set(f[3], (count.get(f[3]) ?? 0) + 1);
  total.set(f[3], (total.get(f[3]) ?? 0) + parseInt(f[5], 10));
}

const out = [`valid: ${valid}`, `malformed: ${malformed}`];
for (const l of LEVELS) out.push(`${l}: ${levels[l]}`);
latencies.sort((a, b) => a - b);
out.push(`status: 2xx=${classes["2"]} 3xx=${classes["3"]} 4xx=${classes["4"]} 5xx=${classes["5"]} other=${classes.o}`);
out.push(`p95: ${latencies.length ? latencies[Math.floor((95 * latencies.length + 99) / 100) - 1] : 0}`);
if (slowest) out.push(`slowest: ${slowest.text}`);
out.push("top:");
const ranked = [...count.keys()].sort((a, b) => count.get(b)! - count.get(a)! || (a < b ? -1 : a > b ? 1 : 0));
for (const p of ranked.slice(0, 3)) {
  out.push(`${p} ${count.get(p)} avg=${Math.floor(total.get(p)! / count.get(p)!)}`);
}
process.stdout.write(out.map((l) => l + "\n").join(""));
