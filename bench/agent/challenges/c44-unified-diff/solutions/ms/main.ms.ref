from "@std/io.ms" import stdin, stdout, read_line
from "@std/string.ms" import StringBuilder

def fields(line: String) -> List[String]:
    let spaced = line.replace(old: "\t", new: " ")
    return (
        spaced
        .split(" ")
        .filter(lambda (part: String) -> Bool: return not part.is_empty())
    )

def range_text(start: Int, len: Int) -> String:
    var s = start
    if len > 0:
        s = s + 1
    if len == 1:
        return f"{s}"

    return f"{s},{len}"

def marker(kind: Int) -> String:
    if kind == 0:
        return " "
    if kind == 1:
        return "-"

    return "+"

def count_before(kinds: List[Int], end: Int, skip: Int) -> Int:
    var total = 0
    var k = 0

    while k < end:
        if kinds.get(k) != skip:
            total = total + 1
        k = k + 1

    return total

def count_between(kinds: List[Int], start: Int, end: Int, skip: Int) -> Int:
    var total = 0
    var k = start

    while k < end:
        if kinds.get(k) != skip:
            total = total + 1
        k = k + 1

    return total

def run() -> Result[Unit, Error]:
    let first = try read_line(input: stdin(), max_bytes: 1048576)
    if first.is_none():
        return ok(())

    let h = fields(first.get())
    let name_a = h.get(0)
    let name_b = h.get(1)
    let ctx = h.get(2).parse_int().get()
    let n = h.get(3).parse_int().get()
    let m = h.get(4).parse_int().get()
    var a = List[String]()
    var b = List[String]()
    var count = 0

    while count < n + m:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break

        if count < n:
            a.append(next.get().clone())
        else:
            b.append(next.get().clone())

        count = count + 1

    let w = m + 1
    var table = List[Int]()
    var cells = (n + 1) * w

    while cells > 0:
        table.append(0)
        cells = cells - 1

    var i = n - 1

    while i >= 0:
        var j = m - 1

        while j >= 0:
            var v = 0

            if a.get(i) == b.get(j):
                v = table.get((i + 1) * w + j + 1) + 1
            else:
                let down = table.get((i + 1) * w + j)
                let right = table.get(i * w + j + 1)

                if down >= right:
                    v = down
                else:
                    v = right

            table.set(i * w + j, v)
            j = j - 1

        i = i - 1

    var kinds = List[Int]()
    var texts = List[String]()
    i = 0

    var j = 0

    while i < n or j < m:
        if i < n and j < m and a.get(i) == b.get(j):
            kinds.append(0)
            texts.append(a.get(i).clone())
            i = i + 1
            j = j + 1
        elif (
            j == m
            or (
                i < n
                and table.get((i + 1) * w + j) >= table.get(
                    (i * w + j + 1)
                )
            )
        ):
            kinds.append(1)
            texts.append(a.get(i).clone())
            i = i + 1
        else:
            kinds.append(2)
            texts.append(b.get(j).clone())
            j = j + 1

    var changes = List[Int]()
    var k = 0

    while k < kinds.length():
        if kinds.get(k) != 0:
            changes.append(k)
        k = k + 1

    if changes.is_empty():
        return ok(())

    var out = StringBuilder()
    out.append(f"--- {name_a}\n+++ {name_b}\n")

    var lo_change = changes.get(0)
    var prev = lo_change
    var idx = 1

    while idx <= changes.length():
        var split = idx == changes.length()

        if not split:
            let cur = changes.get(idx)
            split = cur - prev - 1 > 2 * ctx
            if not split:
                prev = cur

        if split:
            var lo = lo_change - ctx
            if lo < 0:
                lo = 0

            var hi = prev + 1 + ctx
            if hi > kinds.length():
                hi = kinds.length()

            let sa = count_before(kinds, lo, 2)
            let sb = count_before(kinds, lo, 1)
            let la = count_between(kinds, lo, hi, 2)
            let lb = count_between(kinds, lo, hi, 1)
            out.append(f"@@ -{range_text(sa, la)} +{range_text(sb, lb)} @@\n")

            var q = lo

            while q < hi:
                out.append(marker(kinds.get(q)))
                out.append(texts.get(q))
                out.append("\n")
                q = q + 1

            if idx < changes.length():
                lo_change = changes.get(idx)
                prev = lo_change

        idx = idx + 1

    try stdout().write(out.build())
    return stdout().flush()

export def main() -> Int:
    match run():
        case ok(_): return 0
        case error(_): return 1
