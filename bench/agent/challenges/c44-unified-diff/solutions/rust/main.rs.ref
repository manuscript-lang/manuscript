use std::io::{self, Read, Write};

fn rng(start: usize, len: usize) -> String {
    let s = start + if len > 0 { 1 } else { 0 };
    if len == 1 {
        format!("{}", s)
    } else {
        format!("{},{}", s, len)
    }
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let lines: Vec<&str> = input.split('\n').collect();
    let h: Vec<&str> = lines[0].split_whitespace().collect();
    let (name_a, name_b) = (h[0], h[1]);
    let ctx: usize = h[2].parse().unwrap();
    let n: usize = h[3].parse().unwrap();
    let m: usize = h[4].parse().unwrap();
    let a = &lines[1..1 + n];
    let b = &lines[1 + n..1 + n + m];

    let w = m + 1;
    let mut l = vec![0i32; (n + 1) * w];
    for i in (0..n).rev() {
        for j in (0..m).rev() {
            l[i * w + j] = if a[i] == b[j] {
                l[(i + 1) * w + j + 1] + 1
            } else {
                l[(i + 1) * w + j].max(l[i * w + j + 1])
            };
        }
    }
    let mut ops: Vec<(char, &str)> = Vec::new();
    let (mut i, mut j) = (0, 0);
    while i < n || j < m {
        if i < n && j < m && a[i] == b[j] {
            ops.push((' ', a[i]));
            i += 1;
            j += 1;
        } else if j == m || (i < n && l[(i + 1) * w + j] >= l[i * w + j + 1]) {
            ops.push(('-', a[i]));
            i += 1;
        } else {
            ops.push(('+', b[j]));
            j += 1;
        }
    }

    let changes: Vec<usize> = ops.iter().enumerate().filter(|(_, o)| o.0 != ' ').map(|(k, _)| k).collect();
    let mut out = String::new();
    if !changes.is_empty() {
        out.push_str(&format!("--- {}\n+++ {}\n", name_a, name_b));
        let mut groups: Vec<Vec<usize>> = vec![vec![changes[0]]];
        for &k in &changes[1..] {
            let g = groups.last_mut().unwrap();
            if k - g[g.len() - 1] - 1 <= 2 * ctx {
                g.push(k);
            } else {
                groups.push(vec![k]);
            }
        }
        for g in &groups {
            let lo = g[0].saturating_sub(ctx);
            let hi = (g[g.len() - 1] + 1 + ctx).min(ops.len());
            let sa = ops[..lo].iter().filter(|o| o.0 != '+').count();
            let sb = ops[..lo].iter().filter(|o| o.0 != '-').count();
            let la = ops[lo..hi].iter().filter(|o| o.0 != '+').count();
            let lb = ops[lo..hi].iter().filter(|o| o.0 != '-').count();
            out.push_str(&format!("@@ -{} +{} @@\n", rng(sa, la), rng(sb, lb)));
            for o in &ops[lo..hi] {
                out.push(o.0);
                out.push_str(o.1);
                out.push('\n');
            }
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
