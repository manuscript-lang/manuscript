from "@std/io.ms" import stdin, stdout, read_line
from "@std/string.ms" import StringBuilder

type Account:
    bal: Int
    lim: Int
    ops: Int
    rej: Int
    frozen: Bool

type Ledger:
    accounts: Map[String, Account]
    out: StringBuilder
    fees: Int

def fields(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").get()
    return (
        spaced
        .split(" ")
        .filter(lambda (part: String) -> Bool: return not part.is_empty())
    )

def all_digits(s: String) -> Bool:
    if s.is_empty():
        return False

    for c in s.scalar_values():
        if c < 48 or c > 57:
            return False
    return True

def emit(var l: Ledger, text: String) -> Unit:
    l.out.append(text)
    l.out.append("\n")

def reject(var l: Ledger, id: String, msg: String) -> Unit:
    var a = l.accounts.get(id).get()
    a.rej = a.rej + 1
    l.accounts.add(key: id, value: a)
    emit(var l, msg)

def report(var l: Ledger) -> Unit:
    let ids = (
        l
        .accounts
        .keys()
        .sorted(
            compare: lambda (x: String, y: String) -> Int: return x.compare(
                y
            )
        )
    )
    var total = 0

    for id in ids:
        var a = l.accounts.get(id).get()
        total = total + a.bal

        var fz = "no"
        if a.frozen:
            fz = "yes"
        emit(
            var l,
            f"{id} balance={a.bal} limit={a.lim} ops={a.ops} rejected={a.rej} frozen={fz}"
        )

    emit(var l, f"total balance={total} fees={l.fees}")

def arity(cmd: String) -> Int:
    if cmd == "open" or cmd == "deposit" or cmd == "withdraw":
        return 3
    if cmd == "transfer":
        return 4
    if cmd == "freeze" or cmd == "unfreeze":
        return 2
    if cmd == "report":
        return 1

    return 0

def money(var l: Ledger, cmd: String, t: List[String]) -> Unit:
    var ids = [t.get(1).clone()]
    if cmd == "transfer":
        ids.append(t.get(2).clone())

    let amount_text = t.get(t.length() - 1)
    for id in ids:
        if not l.accounts.contains(id):
            return emit(var l, f"error: unknown account {id}")

    let first = ids.get(0)
    if cmd == "transfer" and first == ids.get(1):
        return reject(var l, first.clone(), "error: same account")
    if not all_digits(amount_text) or amount_text.parse_int().get(0) <= 0:
        return reject(var l, first.clone(), "error: invalid amount")

    for id in ids:
        if l.accounts.get(id).get().frozen:
            return reject(var l, id.clone(), f"error: account frozen {id}")

    let n = amount_text.parse_int().get()
    var a = l.accounts.get(first).get()

    if cmd == "deposit":
        a.bal = a.bal + n
        a.ops = a.ops + 1
        l.accounts.add(key: first.clone(), value: a)
        return emit(var l, f"ok {a.bal}")

    var next = a.bal - n
    var fee = 0

    if a.bal >= 0 and next < 0:
        next = next - 5
        fee = 5

    if next < 0 - a.lim:
        return reject(var l, first.clone(), f"error: overdraft limit exceeded {first}")

    a.bal = next
    a.ops = a.ops + 1
    l.accounts.add(key: first.clone(), value: a)
    l.fees = l.fees + fee

    var sfx = ""
    if fee > 0:
        sfx = f" fee={fee}"
    if cmd == "withdraw":
        return emit(var l, f"ok {next}{sfx}")

    var b = l.accounts.get(ids.get(1)).get()
    b.bal = b.bal + n
    b.ops = b.ops + 1
    l.accounts.add(key: ids.get(1).clone(), value: b)
    emit(var l, f"ok {next} {b.bal}{sfx}")

def step(var l: Ledger, t: List[String]) -> Unit:
    let cmd = t.get(0)
    if arity(cmd) != t.length():
        return emit(var l, "error: bad command")
    if cmd == "report":
        return report(var l)

    if cmd == "open":
        let id = t.get(1)
        let lim = t.get(2)
        if not all_digits(lim):
            return emit(var l, "error: invalid limit")
        if l.accounts.contains(id):
            return emit(var l, f"error: account exists {id}")

        (
            l.accounts.add(
                key: id.clone(),
                value: Account(
                    bal: 0, lim: lim.parse_int().get(), ops: 0, rej: 0, frozen: False
                )
            )
        )
        return emit(var l, "ok")

    if cmd == "freeze" or cmd == "unfreeze":
        let id = t.get(1)
        let found = l.accounts.get(id)
        if found.is_none():
            return emit(var l, f"error: unknown account {id}")

        var a = found.get().clone()
        a.frozen = cmd == "freeze"
        l.accounts.add(key: id.clone(), value: a)
        return emit(var l, "ok")

    money(var l, cmd, t)

def run() -> Result[Unit, Error]:
    var l = Ledger(accounts: Map[String, Account](), out: StringBuilder(), fees: 0)

    while True:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break

        let t = fields(next.get())
        if t.is_empty():
            continue

        step(var l, t)

    try stdout().write(l.out.build())
    return stdout().flush()

export def main() -> Int:
    match run():
        case ok(_): return 0
        case error(_): return 1
