    cs.push("symbols", "(define a-b? 1) (define +x 2) (define 1+ 3) (define - -) (define <=> 4)\n(display (list a-b? +x 1+ <=> (- 5 2))) (newline)\n(display (quote (-5 - -x 5- +5 +))) (newline)\n(define Foo 1) (define foo 2) (display (list Foo foo)) (newline)\n")
