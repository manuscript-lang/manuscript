# Generator for c51-lisp-interpreter. The expected outputs come from the Go oracle in oracle/*.ref (built with the
# local Go toolchain); this file only supplies the inputs. Deterministic; run: ms run bench/agent/gen.ms -- c51
import Cases, GenCase, build_oracle, write_cases from "../../lib/gen.ms"

export fn gen_c51() Unit:
    var cs = Cases(build_oracle("c51-lisp-interpreter"))
    cs.push("arith", "(display (+ 1 2 3)) (newline)\n(display (- 10)) (newline)\n(display (- 10 3 2)) (newline)\n(display (* 2 3 4)) (newline)\n(display (+)) (newline)\n(display (*)) (newline)\n(display (quotient 17 5)) (display \" \") (display (quotient -17 5)) (display \" \") (display (quotient 17 -5)) (newline)\n(display (remainder -17 5)) (display \" \") (display (modulo -17 5)) (display \" \") (display (modulo 17 -5)) (display \" \") (display (remainder 17 -5)) (newline)\n(display (list (abs -5) (min 3 1 2) (max 3 1 2) (abs 7)))\n(newline)\n(display (list (= 1 1 1) (< 1 2 3) (< 1 3 2) (>= 3 3 2) (<= 1 1 2) (> 3 2 2)))\n")
    cs.push("define-lambda", "(define x 10)\n(define (square n) (* n n))\n(define cube (lambda (n) (* n n n)))\n(display (square x)) (newline)\n(display (cube 3)) (newline)\n(display square) (newline)\n(display cube) (newline)\n(display (lambda (a) a)) (newline)\n(display car) (newline)\n(define (add . xs) (apply + xs))\n(display (add 1 2 3 4)) (newline)\n(define (f a . rest) (list a rest))\n(display (f 1)) (display (f 1 2 3)) (newline)\n(display ((lambda args args) 1 2 3)) (newline)\n(display ((lambda (x) (* x 2)) 21)) (newline)\n")
    cs.push("closures", "(define (make-counter)\n  (let ((n 0))\n    (lambda () (set! n (+ n 1)) n)))\n(define c1 (make-counter))\n(define c2 (make-counter))\n(c1) (c1)\n(display (c1)) (display \" \") (display (c2)) (newline)\n(define (adder n) (lambda (x) (+ x n)))\n(define add5 (adder 5))\n(display (add5 10)) (newline)\n(define (compose f g) (lambda (x) (f (g x))))\n(display ((compose add5 (adder 1)) 0)) (newline)\n(define (make-acc total)\n  (lambda (amt) (set! total (+ total amt)) total))\n(define acc (make-acc 100))\n(acc 10)\n(display (acc 10)) (newline)\n")
    cs.push("lists", "(display (cons 1 2)) (newline)\n(display (cons 1 (cons 2 '()))) (newline)\n(display (list 1 2 3)) (newline)\n(display '(1 (2 3) . 4)) (newline)\n(display (car '(a b c))) (display (cdr '(a b c))) (display (cadr '(a b c))) (display (cddr '(a b c))) (display (caddr '(a b c))) (newline)\n(display (length '(1 2 3))) (display (length '())) (newline)\n(display (append '(1 2) '(3) '() '(4 5))) (newline)\n(display (append)) (display (append '(1) 2)) (newline)\n(display (reverse '(1 2 3))) (newline)\n(display (list-ref '(a b c) 2)) (display (list-tail '(a b c d) 2)) (display (list-tail '(a) 1)) (newline)\n(display (list (null? '()) (null? '(1)) (pair? '(1)) (pair? '()) (list? '(1 2)) (list? (cons 1 2)))) (newline)\n(display (range 3 7)) (display (range 5 5)) (newline)\n(define p (cons 1 2))\n(set-car! p 10) (set-cdr! p '(20))\n(display p) (newline)\n(display (member 2 '(1 2 3))) (display (member 9 '(1 2 3))) (newline)\n(display (assoc \"b\" '((\"a\" . 1) (\"b\" . 2)))) (display (assoc 'z '((a . 1)))) (newline)\n")
    cs.push("higher-order", "(display (map (lambda (x) (* x x)) '(1 2 3 4))) (newline)\n(display (map + '(1 2 3) '(10 20 30 40))) (newline)\n(display (filter odd? '(1 2 3 4 5))) (newline)\n(display (fold + 0 '(1 2 3 4))) (newline)\n(display (fold (lambda (acc x) (cons x acc)) '() '(1 2 3))) (newline)\n(display (foldr cons '() '(1 2 3))) (newline)\n(display (foldr (lambda (x acc) (- x acc)) 0 '(10 4 1))) (newline)\n(for-each (lambda (x y) (display (+ x y)) (display \",\")) '(1 2) '(10 20)) (newline)\n(display (apply max '(3 9 2))) (display (apply + 1 2 '(3 4))) (newline)\n(display (sort '(3 1 2 5 4) <)) (display (sort '(\"pear\" \"apple\" \"fig\") string<?)) (newline)\n(display (sort '((1 . b) (0 . a) (1 . a) (0 . b)) (lambda (x y) (< (car x) (car y))))) (newline)\n(display (map (lambda (p) (car p)) '((a . 1) (b . 2)))) (newline)\n")
    cs.push("tail-calls", "(define (loop i acc) (if (= i 0) acc (loop (- i 1) (+ acc i))))\n(display (loop 200000 0)) (newline)\n(define (even2? n) (if (= n 0) #t (odd2? (- n 1))))\n(define (odd2? n) (if (= n 0) #f (even2? (- n 1))))\n(display (even2? 100001)) (newline)\n(define (count n) (cond ((= n 0) 'done) (else (count (- n 1)))))\n(display (count 100000)) (newline)\n(define (w n) (when (> n 0) (w (- n 1))))\n(w 100000) (display \"ok\") (newline)\n(define (a n) (and #t (or #f (if (= n 0) 'fin (a (- n 1))))))\n(display (a 100000)) (newline)\n(define (b n) (begin 1 (let ((m n)) (let* ((k m)) (if (= k 0) 'b (b (- k 1)))))))\n(display (b 100000)) (newline)\n(display (let lp ((i 0) (s 0)) (if (> i 100000) s (lp (+ i 1) (+ s i))))) (newline)\n")
    cs.push("deep-recursion", "(define (sum n) (if (= n 0) 0 (+ n (sum (- n 1)))))\n(display (sum 3000)) (newline)\n(define (build n) (if (= n 0) '() (cons n (build (- n 1)))))\n(display (length (build 5000))) (newline)\n(define (inf n) (+ 1 (inf n)))\n(display \"before\") (newline)\n(inf 1)\n(display \"never\")\n")
    cs.push("recursion-limit-caught", "(define (inf n) (+ 1 (inf n)))\n(display (try (inf 1) (lambda (m) m))) (newline)\n(display (try (inf 1) (lambda (m) (string-append \"caught: \" m)))) (newline)\n(define (ok n) (if (= n 0) 0 (+ 1 (ok (- n 1)))))\n(display (ok 9000)) (newline)\n")
    cs.push("let-forms", "(display (let ((a 1) (b 2)) (+ a b))) (newline)\n(define a 100)\n(display (let ((a 1) (b a)) (list a b))) (newline)\n(display (let* ((a 1) (b (+ a 1)) (c (* b 2))) (list a b c))) (newline)\n(display (letrec ((ev? (lambda (n) (if (= n 0) #t (od? (- n 1))))) (od? (lambda (n) (if (= n 0) #f (ev? (- n 1)))))) (ev? 10))) (newline)\n(display (let loop ((i 0) (acc '())) (if (= i 5) (reverse acc) (loop (+ i 1) (cons (* i i) acc))))) (newline)\n(define (f)\n  (define x 1)\n  (define (g) (+ x 1))\n  (g))\n(display (f)) (newline)\n(display (let () 5)) (newline)\n")
    cs.push("conditionals", "(display (if #t 'yes 'no)) (display (if #f 'yes 'no)) (display (if 0 'zero-true 'zero-false)) (display (if '() 'nil-true 'nil-false)) (newline)\n(display (if #f 1)) (newline)\n(display (cond ((= 1 2) 'a) ((= 1 1) 'b) (else 'c))) (newline)\n(display (cond (#f 1))) (newline)\n(display (cond ((assoc 'b '((a . 1) (b . 2))) => 1) (else 'x))) (newline)\n")
    cs.push("cond-test-only", "(display (cond (5) (else 6))) (display (cond (#f) (7))) (newline)\n(display (list (and) (or) (and 1 2 3) (and 1 #f 3) (or #f #f) (or #f 4 5) (and 1 (or #f 2)))) (newline)\n(display (list (when #t 1 2 3) (when #f 1) (unless #f 4) (unless #t 4))) (newline)\n(define x 0)\n(or #t (set! x 1))\n(and #f (set! x 2))\n(display x) (newline)\n(display (not 0)) (display (not #f)) (display (not '())) (newline)\n")
    cs.push("equality", "(display (list (eq? 'a 'a) (eq? 1 1) (eq? '() '()) (eq? \"a\" \"a\") (eq? '(1) '(1)) (eq? #t #t) (eq? 1 #t))) (newline)\n(display (list (equal? '(1 (2 \"x\")) '(1 (2 \"x\"))) (equal? \"a\" \"a\") (equal? 1 \"1\") (equal? '(1 2) '(1 2 3)) (equal? 'a 'a) (equal? (cons 1 2) (cons 1 2)) (equal? car car))) (newline)\n")
    cs.push("strings", "(display (string-length \"hello\")) (newline)\n(display (string-append \"a\" \"b\" \"c\")) (display (string-append)) (newline)\n(display (substring \"hello world\" 6 11)) (display \"|\") (display (substring \"abc\" 1 1)) (newline)\n(display (string-ref \"abc\" 1)) (newline)\n(display (list (string=? \"a\" \"a\") (string=? \"a\" \"b\") (string<? \"apple\" \"banana\") (string<? \"b\" \"a\") (string<? \"a\" \"ab\"))) (newline)\n(display (string-upcase \"Hello\")) (display (string-downcase \"HeLLo\")) (newline)\n(display (list (string->number \"42\") (string->number \"-7\") (string->number \"x1\") (string->number \"\") (string->number \"-\") (string->number \"99999999999999999999\"))) (newline)\n(display (number->string -15)) (newline)\n(display (list (string->symbol \"foo\") (symbol->string (quote bar)))) (newline)\n(write (string->list \"abc\")) (newline)\n(display (list->string (list \"x\" \"y\" \"z\"))) (newline)\n(write (string-join (list \"a\" \"b\" \"c\") \", \")) (newline)\n(write (string-split \"a,b,,c\" \",\")) (write (string-split \"\" \",\")) (write (string-split \"abc\" \",\")) (newline)\n(display (list (string-contains? \"hello\" \"ell\") (string-contains? \"hello\" \"xyz\") (string-contains? \"hello\" \"\"))) (newline)\n")
    cs.push("write-display", "(write \"he said \\\"hi\\\"\\n\\ttab\\\\\") (newline)\n(display \"he said \\\"hi\\\"\") (newline)\n(write (list \"a\" 1 (quote b) #t \"c d\")) (newline)\n(display (list \"a\" 1 (quote b) #t \"c d\")) (newline)\n(write (quote (1 . (2 . (3 . 4))))) (newline)\n(write (quote ((a . b) (c) ()))) (newline)\n(display (if #f #f)) (newline)\n(display (void)) (newline)\n(write (list (void) car)) (newline)\n(display '(quote x)) (newline)\n(display \"no newline at end\")\n")
    cs.push("quote-forms", "(display 'abc) (display '(a . b)) (display ''x) (display '(1 'y)) (display '#t) (display '5) (display '\"s\") (newline)\n(display (quote (+ 1 2))) (display (eval-free)) \n")
