    cs.push("string-escapes-read", "(write \"tab\\there\") (newline)\n(display (string-length \"a\\nb\")) (newline)\n(write (string-append \"q\\\"\" \"\\\\\")) (newline)\n")
    cs.push("symbols-as-data", "(define env '((x . 1) (y . 2)))\n(define (lookup k) (let ((p (assoc k env))) (if p (cdr p) 'missing)))\n(display (list (lookup 'x) (lookup 'y) (lookup 'z))) (newline)\n(display (map symbol? (list 'a \"a\" 1))) (newline)\n(display (list (number? 5) (number? \"5\") (string? \"s\") (boolean? #f) (boolean? 0) (procedure? car) (procedure? (lambda () 1)) (procedure? 'car))) (newline)\n(display (list (zero? 0) (zero? 1) (even? 4) (even? -3) (odd? -3) (odd? 4)))\n")
    cs.push("prog-fib-memo", "(define memo '())\n(define (fib n)\n  (if (< n 2) n\n      (let ((hit (assoc n memo)))\n        (if hit (cdr hit)\n            (let ((v (+ (fib (- n 1)) (fib (- n 2)))))\n              (set! memo (cons (cons n v) memo))\n              v)))))\n(display (fib 80)) (newline)\n(display (fib 90)) (newline)\n(display (fib 92)) (newline)\n(display (fib 93)) (newline)\n")
    cs.push("prog-primes", "(define (divisible? n d) (= (remainder n d) 0))\n(define (prime? n)\n  (and (> n 1)\n       (let loop ((d 2))\n         (cond ((> (* d d) n) #t)\n               ((divisible? n d) #f)\n               (else (loop (+ d 1)))))))\n(display (filter prime? (range 1 100))) (newline)\n(display (length (filter prime? (range 1 3000)))) (newline)\n")
    cs.push("prog-quicksort", "(define (qs l)\n  (if (null? l) '()\n      (let ((p (car l)) (rest (cdr l)))\n        (append (qs (filter (lambda (x) (< x p)) rest))\n                (list p)\n                (qs (filter (lambda (x) (>= x p)) rest))))))\n(display (qs '(5 3 8 1 9 2 7 3 5 0 -4 12))) (newline)\n(define (lcg s) (modulo (+ (* s 1103515245) 12345) 2147483648))\n(define (gen n s) (if (= n 0) '() (cons (modulo s 1000) (gen (- n 1) (lcg s)))))\n(define xs (gen 300 42))\n(display (equal? (qs xs) (sort xs <))) (newline)\n(display (list-tail (qs xs) 295)) (newline)\n")
    cs.push("prog-queens", "(define (safe? q qs)\n  (let loop ((qs qs) (d 1))\n    (cond ((null? qs) #t)\n          ((or (= (car qs) q) (= (abs (- (car qs) q)) d)) #f)\n          (else (loop (cdr qs) (+ d 1))))))\n(define (place k n)\n  (if (= k 0) '(())\n      (apply append\n        (map (lambda (qs)\n               (apply append (map (lambda (q) (if (safe? q qs) (list (cons q qs)) '())) (range 0 n))))\n             (place (- k 1) n)))))\n(display (length (place 6 6))) (newline)\n(display (car (place 6 6))) (newline)\n(display (length (place 7 7))) (newline)\n")
    cs.push("prog-meta-eval", "(define (lookup-var name env)\n  (let ((p (assoc name env)))\n    (if p (cdr p) (error \"meta: unbound\" name))))\n(define (meval e env)\n  (cond ((number? e) e)\n        ((symbol? e) (lookup-var e env))\n        ((eq? (car e) 'add) (+ (meval (cadr e) env) (meval (caddr e) env)))\n        ((eq? (car e) 'mul) (* (meval (cadr e) env) (meval (caddr e) env)))\n        ((eq? (car e) 'let1)\n         (meval (caddr e) (cons (cons (car (cadr e)) (meval (cadr (cadr e)) env)) env)))\n        (else (error \"meta: bad expr\" e))))\n(display (meval '(add 1 (mul 2 3)) '())) (newline)\n(display (meval '(let1 (x 5) (mul x (add x 1))) '())) (newline)\n(display (try (meval '(add y 1) '()) (lambda (m) m))) (newline)\n(meval '(sub 1 2) '())\n")
    cs.push("prog-strings-words", "(define text \"the quick brown fox jumps over the lazy dog the end\")\n(define words (string-split text \" \"))\n(define (count-word w ws) (length (filter (lambda (x) (string=? x w)) ws)))\n(define (uniq ws) (fold (lambda (acc w) (if (member w acc) acc (append acc (list w)))) '() ws))\n(for-each (lambda (w) (display w) (display \"=\") (display (count-word w words)) (display \" \")) (uniq words))\n(newline)\n(define (caps w) (string-append (string-upcase (substring w 0 1)) (substring w 1 (string-length w))))\n(display (string-join (map caps words) \" \")) (newline)\n(define (rev-str s) (list->string (reverse (string->list s))))\n(display (map rev-str (list \"abc\" \"hello\" \"\"))) (newline)\n(define (palin? s) (string=? s (rev-str s)))\n(display (filter palin? (list \"racecar\" \"abc\" \"noon\" \"a\"))) (newline)\n")
    cs.push("prog-bank-closures", "(define (make-account balance)\n  (define (withdraw amt)\n    (if (> amt balance) (error \"insufficient funds:\" balance amt)\n        (begin (set! balance (- balance amt)) balance)))\n  (define (deposit amt) (set! balance (+ balance amt)) balance)\n  (lambda (msg . args)\n    (cond ((eq? msg 'withdraw) (apply withdraw args))\n          ((eq? msg 'deposit) (apply deposit args))\n          ((eq? msg 'balance) balance)\n          (else (error \"unknown message\" msg)))))\n(define acc (make-account 100))\n(display (acc 'deposit 50)) (newline)\n(display (acc 'withdraw 30)) (newline)\n(display (try (acc 'withdraw 500) (lambda (m) m))) (newline)\n(display (acc 'balance)) (newline)\n(acc 'transfer 1)\n")
    cs.push("prog-ycomb-hanoi", "(define (hanoi n from to via)\n  (if (= n 0) 0\n      (+ (hanoi (- n 1) from via to) 1 (hanoi (- n 1) via to from))))\n(display (hanoi 12 'a 'c 'b)) (newline)\n(define Y (lambda (f) ((lambda (x) (f (lambda (v) ((x x) v)))) (lambda (x) (f (lambda (v) ((x x) v)))))))\n(define fact (Y (lambda (self) (lambda (n) (if (= n 0) 1 (* n (self (- n 1))))))))\n(display (fact 20)) (newline)\n(display (fact 21)) (newline)\n")
    cs.push("prog-assoc-update", "(define (update al k f default)\n  (cond ((null? al) (list (cons k (f default))))\n        ((equal? (caar-ish al) k) (cons (cons k (f (cdr (car al)))) (cdr al)))\n        (else (cons (car al) (update (cdr al) k f default)))))\n(define (caar-ish l) (car (car l)))\n(define counts (fold (lambda (al w) (update al w (lambda (n) (+ n 1)) 0)) '() '(a b a c b a)))\n(display counts) (newline)\n(display (sort counts (lambda (x y) (> (cdr x) (cdr y))))) (newline)\n")
    cs.push("prog-collatz", "(define (collatz n steps) (cond ((= n 1) steps) ((even? n) (collatz (quotient n 2) (+ steps 1))) (else (collatz (+ (* 3 n) 1) (+ steps 1)))))\n(define (best n best-n best-s)\n  (if (> n 3000) (list best-n best-s)\n      (let ((s (collatz n 0))) (if (> s best-s) (best (+ n 1) n s) (best (+ n 1) best-n best-s)))))\n(display (best 1 1 0)) (newline)\n")
    cs.push("big-list", "(define (build i acc) (if (= i 0) acc (build (- i 1) (cons i acc))))\n(define l (build 50000 '()))\n(display (length l)) (newline)\n(display (fold + 0 l)) (newline)\n(display (length (map (lambda (x) (* x 2)) l))) (newline)\n(display (car (reverse l))) (newline)\n(display (list-ref l 49999)) (newline)\n(display (length (filter even? l))) (newline)\n")
    let examples = [
        cs.make("basic", "(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))\n(display (fact 10)) (newline)\n(display (map fact (list 1 2 3 4 5)))\n(newline)\n"),
        cs.make("closure-counter", cs.list[2].stdin.clone()),
        cs.make("error-report", "(display \"start\")\n(newline)\n(display (try (quotient 1 0) (lambda (m) m)))\n(newline)\n(display (+ 1 (car 5)))\n(display \"never\")\n"),
        cs.make("tail-loop", "(define (loop i acc) (if (= i 0) acc (loop (- i 1) (+ acc i))))\n(display (loop 100000 0))\n(newline)\n")
    ]
    write_cases("c51-lisp-interpreter", examples, examples.concat(cs.list))
