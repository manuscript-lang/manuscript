    cs.push("try-basic", "(define (safe-div a b) (try (quotient a b) (lambda (m) (string-append \"oops(\" m \")\"))))\n(display (safe-div 10 2)) (newline)\n(display (safe-div 1 0)) (newline)\n(display (try (car 5) (lambda (m) m))) (newline)\n(display (try (undefined-var) (lambda (m) m))) (newline)\n(display (try (error \"custom\" 1 2) (lambda (m) (list m (string-length m))))) (newline)\n(display (try 42 (lambda (m) m))) (newline)\n(display (try (try (error \"inner\") (lambda (m) (error \"outer from\" m))) (lambda (m) m))) (newline)\n(display (try (\"notproc\" 1) (lambda (m) m))) (newline)\n(display (try ((lambda (x) x)) (lambda (m) m))) (newline)\n(display (try (+ 1 \"a\") (lambda (m) m))) (newline)\n(display (try (+ 9223372036854775807 1) (lambda (m) m))) (newline)\n(display (try (list-ref (list 1 2) 5) (lambda (m) m))) (newline)\n")
    cs.push("try-side-effects", "(define log (quote ()))\n(define (note x) (set! log (cons x log)))\n(try (begin (note 1) (error \"x\") (note 2)) (lambda (m) (note 3)))\n(display (reverse log)) (newline)\n(display (try (map (lambda (x) (if (= x 2) (error \"bad elem\" x) x)) (list 1 2 3)) (lambda (m) m))) (newline)\n")
