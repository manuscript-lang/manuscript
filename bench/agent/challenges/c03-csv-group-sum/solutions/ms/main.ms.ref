import stdin, stdout, read_line from "@std/io.ms"

# True when s is a non-empty run of ASCII digits.
fn all_digits(s: String) Bool:
    if s.is_empty():
        return false

    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

# Parses digits with an optional one- or two-digit fraction into cents.
fn parse_amount(s: String) Optional[Int]:
    let parts = s.split(".")
    if parts.length() > 2:
        return none

    let whole = parts.get(0)
    if not all_digits(whole):
        return none

    var cents = whole.parse_int().get() * 100

    if parts.length() == 2:
        let frac = parts.get(1)
        if not all_digits(frac) or frac.length() > 2:
            return none

        let digits = frac.parse_int().get()

        if frac.length() == 1:
            cents = cents + digits * 10
        else:
            cents = cents + digits

    return some(cents)

type Record:
    category: String
    cents: Int

fn parse_line(line: String) Optional[Record]:
    var category = ""
    var amount = ""

    if line.starts_with("\""):
        let rest = line.slice(1, line.length()).get()
        let close = rest.index_of("\"")
        if close.is_none():
            return none

        let at = close.get()
        category = rest.slice(0, at).get()

        let after = rest.slice(at + 1, rest.length()).get()
        if not after.starts_with(","):
            return none

        amount = after.slice(1, after.length()).get()
    else:
        let parts = line.split(",")
        if parts.length() != 2:
            return none

        category = parts.get(0).clone()
        amount = parts.get(1).clone()

    if category.is_empty() or category.contains("\"") or amount.contains(","):
        return none

    let cents = parse_amount(amount)
    if cents.is_none():
        return none

    return some(Record(category: category, cents: cents.get()))

fn two_digits(n: Int) String:
    if n < 10:
        return "0{n}"

    return "{n}"

fn run() Result[Unit, Error]:
    var totals = Map[String, Int]()
    var bad = 0

    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break

        let line = next.get().replace(old: "\r", new: "")
        if line.trim().is_empty():
            continue

        let rec = parse_line(line)

        if rec.is_none():
            bad = bad + 1
        else:
            let r = rec.get()
            totals.add(
                key: r.category.clone(),
                value: (
                    totals.get_or(key: r.category, fallback: 0)
                    + r.cents
                )
            )

    let rows = (
        totals
        .entries()
        .sorted(
            compare: fn(
                left: MapEntry[String, Int],
                right: MapEntry[String, Int]
            ) Int: return left.key.compare(right.key)
        )
    )
    for e in rows:
        try stdout().write("{e.key}: {e.value / 100}.{two_digits(e.value % 100)}\n")
    if bad > 0:
        try stdout().write("skipped: {bad}\n")
    return stdout().flush()

export fn main() Int:
    match run():
        ok(_): return 0
        error(_): return 1
