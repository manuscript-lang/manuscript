import { readFileSync } from "node:fs";

const AMT = /^[0-9]+(\.[0-9]{1,2})?$/;

function parse(line: string): [string, bigint] | null {
  let cat: string, amt: string;
  if (line.startsWith('"')) {
    const end = line.indexOf('"', 1);
    if (end < 0 || line[end + 1] !== ",") return null;
    cat = line.slice(1, end);
    amt = line.slice(end + 2);
  } else {
    const parts = line.split(",");
    if (parts.length !== 2) return null;
    [cat, amt] = parts;
  }
  if (cat === "" || cat.includes('"') || amt.includes(",") || !AMT.test(amt)) return null;
  const [w, f = ""] = amt.split(".");
  return [cat, BigInt(w) * 100n + BigInt((f + "0").slice(0, 2))];
}

const totals = new Map<string, bigint>();
let bad = 0;
for (const raw of readFileSync(0, "utf8").split("\n")) {
  const line = raw.replace(/\r$/, "");
  if (line.trim() === "") continue;
  const r = parse(line);
  if (!r) { bad++; continue; }
  totals.set(r[0], (totals.get(r[0]) ?? 0n) + r[1]);
}
const keys = [...totals.keys()].sort((a, b) => Buffer.compare(Buffer.from(a), Buffer.from(b)));
let out = "";
for (const k of keys) {
  const v = totals.get(k)!;
  out += `${k}: ${v / 100n}.${(v % 100n).toString().padStart(2, "0")}\n`;
}
if (bad > 0) out += `skipped: ${bad}\n`;
process.stdout.write(out);
