from "@std/io.ms" import stdin, stdout, read_line

type Item:
    sku: String
    qty: Int

type Order:
    items: List[Item]
    status: String
    total: Int

type Warehouse:
    stock: Map[String, Int]
    price: Map[String, Int]
    orders: Map[String, Order]

def money(c: Int) -> String:
    let cents = c % 100
    if cents < 10:
        return f"{c / 100}.0{cents}"

    return f"{c / 100}.{cents}"

def is_sku_char(c: Int) -> Bool:
    return (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 45

def is_oid_char(c: Int) -> Bool:
    return (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45

def valid_sku(s: String) -> Bool:
    let codes = s.scalar_values()
    if codes.is_empty():
        return False

    for c in codes:
        if not is_sku_char(c):
            return False
    return True

def valid_oid(s: String) -> Bool:
    let codes = s.scalar_values()
    if codes.is_empty():
        return False

    for c in codes:
        if not is_oid_char(c):
            return False
    return True

# 1 to 7 ASCII digits.
def number(s: String) -> Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() < 1 or codes.length() > 7:
        return none

    var n = 0

    for c in codes:
        if c < 48 or c > 57:
            return none

        n = n * 10 + (c - 48)

    return some(n)

def quantity(s: String) -> Optional[Int]:
    let n = number(s)
    if n.is_none() or n.get() < 1 or n.get() > 100000:
        return none

    return n

def arity(name: String) -> Int:
    if name == "stock" or name == "price":
        return 3
    if name == "cancel" or name == "ship":
        return 2
    if name == "report":
        return 1

    return 0

def place_order(var w: Warehouse, t: List[String]) -> List[String]:
    let id = t.get(1)
    if not valid_oid(id):
        return ["error: bad order id"]
    if w.orders.contains(id):
        return [f"error: order {id} already exists"]

    var items = List[Item]()
    var i = 2

    while i < t.length():
        let token = t.get(i)
        i = i + 1

        let p = token.split(":")
        if p.length() != 2 or not valid_sku(p.get(0)):
            return [f"error: bad item {token}"]

        let q = quantity(p.get(1))
        if q.is_none():
            return [f"error: bad item {token}"]

        items.append(Item(sku: p.get(0).clone(), qty: q.get()))

    var seen = Set[String]()

    for it in items:
        if seen.contains(it.sku):
            return [f"error: duplicate sku {it.sku}"]

        let have = w.stock.get(it.sku)
        if have.is_none():
            return [f"error: unknown sku {it.sku}"]
        if it.qty > have.get():
            return [
                f"error: insufficient stock for {it.sku} (have {have.get()}, need {it.qty})"
            ]

        seen.add(it.sku.clone())

    var total = 0

    for it in items:
        if var n = w.stock.get(it.sku):
            n -= it.qty

        let unit_price = w.price.get(it.sku).get()

        if it.qty >= 10:
            total = total + (it.qty * unit_price * 90 + 50) / 100
        else:
            total = total + it.qty * unit_price

    (
        w.orders.add(
            key: id.clone(), value: Order(items: items, status: "placed", total: total)
        )
    )
    return [f"ok {id} total={money(total)}"]

def report(w: Warehouse) -> List[String]:
    var reserved = Map[String, Int]()
    var placed = 0
    var shipped = 0
    var cancelled = 0
    var revenue = 0

    for e in w.orders.entries():
        let o = e.value

        if o.status == "placed":
            placed = placed + 1

            for it in o.items:
                if var n = reserved.get(it.sku):
                    n += it.qty
                else:
                    reserved.add(key: it.sku.clone(), value: it.qty)
        elif o.status == "shipped":
            shipped = shipped + 1
            revenue = revenue + o.total
        else:
            cancelled = cancelled + 1

    var out = List[String]()
    let skus = (
        w
        .stock
        .keys()
        .sorted(
            compare: lambda (left: String, right: String) -> Int: return left.compare(
                right
            )
        )
    )
    for sku in skus:
        out.append(
            f"{sku} stock={w.stock.get(sku).get()} price={money(w.price.get(sku).get())} reserved={reserved.get_or(key: sku, fallback: 0)}"
        )
    out.append(f"orders placed={placed} shipped={shipped} cancelled={cancelled}")
    out.append(f"revenue={money(revenue)}")
    return out

def run_command(var w: Warehouse, line: String) -> List[String]:
    let t = line.split(" ")
    let name = t.get(0)
    let want = arity(name)
    if want == 0 and name != "order":
        return ["error: unknown command"]
    if (name == "order" and t.length() < 3) or (name != "order" and t.length() != want):
        return ["error: usage"]

    if name == "stock":
        let sku = t.get(1)
        if not valid_sku(sku):
            return ["error: bad sku"]

        let q = quantity(t.get(2))
        if q.is_none():
            return ["error: bad quantity"]

        let now = w.stock.get_or(key: sku, fallback: 0) + q.get()
        w.stock.add(key: sku.clone(), value: now)
        w.price.add_default(key: sku.clone(), value: 0)
        return [f"ok {sku} stock={now}"]

    if name == "price":
        let p = number(t.get(2))
        if p.is_none() or p.get() > 10000000:
            return ["error: bad price"]

        let sku = t.get(1)
        if not w.stock.contains(sku):
            return [f"error: unknown sku {sku}"]

        w.price.add(key: sku.clone(), value: p.get())
        return ["ok"]

    if name == "order":
        return place_order(var w, t)
    if name == "report":
        return report(w)

    let id = t.get(1)
    let found = w.orders.get(id)
    if found.is_none():
        return [f"error: unknown order {id}"]

    let o = found.get()

    if name == "cancel":
        if o.status != "placed":
            return [f"error: order {id} already {o.status}"]

        for it in o.items:
            if var n = w.stock.get(it.sku):
                n += it.qty
        if var u = w.orders.get(id):
            u.status = "cancelled"
        return ["ok"]

    if o.status == "shipped":
        return [f"error: order {id} already shipped"]
    if o.status == "cancelled":
        return [f"error: order {id} is cancelled"]

    if var u = w.orders.get(id):
        u.status = "shipped"
    return ["ok"]

def run() -> Result[Unit, Error]:
    var w = Warehouse(
        stock: Map[String, Int](), price: Map[String, Int](),
        orders: Map[String, Order]()
    )

    while True:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break

        let line = next.get()
        if line.replace_all(old: " ", new: "").get().is_empty():
            continue

        for out in run_command(var w, line):
            try stdout().write(f"{out}\n")

    return stdout().flush()

export def main() -> Int:
    match run():
        case ok(_): return 0
        case error(_): return 1
