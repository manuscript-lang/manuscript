@@ -118,0 +119,95 @@ fn result_only_substitution_keeps_concrete_arguments_and_parameters() {
+
+fn shared_concrete(depth: usize) -> Ty {
+    let syms = ms_syntax::Names::global();
+    let mut t = int();
+    for _ in 0..depth {
+        let mut pair = Type::new(syms, n("Pair"), n("substitution/Pair"), Kind::Record);
+        pair.args = vec![t.clone(), t];
+        t = Rc::new(pair);
+    }
+    t
+}
+
+#[test]
+fn substitution_preserves_shared_concrete_callable_graphs() {
+    let graph = shared_concrete(28);
+    let mut ty = (*signature(&[graph.clone(), graph.clone()], graph.clone())).clone();
+    ty.args = vec![graph];
+    let ty = Rc::new(ty);
+    for bindings in [Subst::new(), Subst::from([(n("unused"), string())])] {
+        assert!(Rc::ptr_eq(&ty, &sub(&ty, &bindings)));
+    }
+}
+
+#[test]
+fn substitution_keeps_nonvariable_bindings_after_shared_prefixes() {
+    let syms = ms_syntax::Names::global();
+    let marker = Rc::new(Type::new(
+        syms,
+        n("Marker"),
+        n("substitution/Marker"),
+        Kind::Record,
+    ));
+    let graph = shared_concrete(20);
+    let mut ty = (*signature(&[graph.clone(), marker.clone()], marker.clone())).clone();
+    ty.args = vec![graph.clone(), marker.clone()];
+    ty.params[1].mutable = true;
+    ty.params[1].positional = true;
+    // Substitution has always traversed all edges, even on nonfunction types.
+    ty.kind = Kind::Record;
+    let ty = Rc::new(ty);
+    let replacement = string();
+    let got = sub(&ty, &Subst::from([(marker.id, replacement.clone())]));
+    assert!(Rc::ptr_eq(&got.args[0], &graph));
+    assert!(Rc::ptr_eq(&got.params[0].ty, &graph));
+    assert!(Rc::ptr_eq(&got.args[1], &replacement));
+    assert!(Rc::ptr_eq(&got.params[1].ty, &replacement));
+    assert!(Rc::ptr_eq(&got.result_ty(), &replacement));
+    assert!(got.params[1].mutable && got.params[1].positional);
+    assert_eq!(got.params[1].name, ty.params[1].name);
+    assert!(Rc::ptr_eq(
+        got.defaults.as_ref().unwrap(),
+        ty.defaults.as_ref().unwrap()
+    ));
+    assert!(Rc::ptr_eq(&sub(&ty, &Subst::new()), &ty));
+    assert!(Rc::ptr_eq(
+        &sub(&ty, &Subst::from([(ty.id, replacement.clone())])),
+        &replacement
+    ));
+    // A binding to the same object is returned directly; its children are not rewritten.
+    assert!(Rc::ptr_eq(
+        &sub(
+            &ty,
+            &Subst::from([(ty.id, ty.clone()), (marker.id, replacement)])
+        ),
+        &ty
+    ));
+}
+
+#[test]
+fn shared_prefix_reuse_keeps_changed_snapshots_independent() {
+    let var = variable();
+    let child = signature(std::slice::from_ref(&var), var.clone());
+    let graph = shared_concrete(20);
+    let ty = signature(&[graph.clone(), child.clone(), child], var.clone());
+    let before = sub(&ty, &Subst::new());
+    assert!(Rc::ptr_eq(&before.params[0].ty, &graph));
+    assert!(!Rc::ptr_eq(&before.params[1].ty, &before.params[2].ty));
+    let left = &before.params[1].ty.params[0].ty;
+    let right = &before.params[2].ty.params[0].ty;
+    assert!(!Rc::ptr_eq(left, right));
+    left.bounds.borrow_mut().push(string());
+    *left.default.borrow_mut() = Some(string());
+    assert!(right.bounds().is_empty() && right.default_ty().is_none());
+    assert!(var.bounds().is_empty() && var.default_ty().is_none());
+    assert!(before.result_ty().bounds().is_empty());
+    var.bounds.borrow_mut().push(int());
+    *var.default.borrow_mut() = Some(int());
+    let after = sub(&ty, &Subst::new());
+    assert_eq!(after.params[2].ty.params[0].ty.bounds()[0].id, int().id);
+    assert_eq!(after.result_ty().default_ty().unwrap().id, int().id);
+    let bound = sub(&ty, &Subst::from([(var.id, string())]));
+    assert_eq!(bound.params[1].ty.params[0].ty.id, string().id);
+    assert_eq!(bound.result_ty().id, string().id);
+    assert!(bound.params[1].ty.is_default(n("p0")));
+}
