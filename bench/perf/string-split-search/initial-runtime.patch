+/// Keep the stack searcher out of split's byte, short-input, and single-part paths.
+#[inline(never)]
+unsafe fn split_with_finder(
+    text: &[u8],
+    sep: &[u8],
+    limit: usize,
+    piece: &impl Fn(&[u8]) -> StrVal,
+) -> VecVal {
+    let finder = memchr::memmem::Finder::new(sep);
+    // SAFETY: the caller supplies a nonempty separator and a valid piece constructor.
+    unsafe {
+        split_nonempty(text, sep, limit, piece, |hay| {
+            if hay.len() < 64 {
+                find(hay, sep)
+            } else {
+                finder.find(hay)
+            }
+        })
+    }
+}
