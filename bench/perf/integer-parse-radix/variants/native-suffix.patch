+/// ASCII digit value, or a sentinel greater than every supported radix.
+fn radix_digit(byte: u8) -> u64 {
+    match byte {
+        b'0'..=b'9' => (byte - b'0') as u64,
+        b'a'..=b'z' => (byte - b'a') as u64 + 10,
+        b'A'..=b'Z' => (byte - b'A') as u64 + 10,
+        _ => u64::MAX,
+    }
+}
