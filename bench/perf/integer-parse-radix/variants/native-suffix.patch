+    #[test]
+    fn radix_parsing_preserves_range_and_invalid_digit_precedence() {
+        let reference = |text: &[u8], radix: i64| {
+            if !(2..=36).contains(&radix) {
+                return Err(STATUS_INVALID_INPUT);
+            }
+            let digits = text
+                .strip_prefix(b"+")
+                .or_else(|| text.strip_prefix(b"-"))
+                .unwrap_or(text);
+            if digits.is_empty()
+                || digits
+                    .iter()
+                    .any(|&byte| char::from(byte).to_digit(radix as u32).is_none())
+            {
+                return Err(STATUS_INVALID_DATA);
+            }
+            i64::from_str_radix(core::str::from_utf8(text).unwrap(), radix as u32)
+                .map_err(|_| STATUS_OUT_OF_RANGE)
+        };
+        let check = |text: &[u8], radix| {
+            assert_eq!(
+                parse_int_radix(text, radix),
+                reference(text, radix),
+                "{text:?} base {radix}"
+            );
+        };
+        for radix in 2..=36 {
+            for value in [
+                (1u128 << 63) - 1,
+                1u128 << 63,
+                (1u128 << 63) + 1,
+                (1u128 << 64) - 1,
+                1u128 << 64,
+                (1u128 << 64) + 1,
+            ] {
+                let mut magnitude = value;
+                let mut text = Vec::new();
+                while magnitude != 0 {
+                    text.push(
+                        b"0123456789abcdefghijklmnopqrstuvwxyz"
+                            [(magnitude % radix as u128) as usize],
+                    );
+                    magnitude /= radix as u128;
+                }
+                text.reverse();
+                for sign in [b"".as_slice(), b"+", b"-"] {
+                    let mut input = sign.to_vec();
+                    input.extend_from_slice(&text);
+                    check(&input, radix);
+                }
+            }
+            for text in [
+                b"".as_slice(),
+                b"+",
+                b"-",
+                b"++1",
+                b"--1",
+                b"+-1",
+                b" 1",
+                b"1 ",
+                b"1_0",
+                b"\xff",
+            ] {
+                check(text, radix);
+            }
+            for digit in [
+                b'0',
+                b'1',
+                b"0123456789abcdefghijklmnopqrstuvwxyz"[radix as usize - 1],
+            ] {
+                for len in [1, 18, 19, 20, 63, 64, 65, 129, 1024] {
+                    let text = vec![digit; len];
+                    for sign in [b"".as_slice(), b"+", b"-"] {
+                        let mut input = sign.to_vec();
+                        input.extend_from_slice(&text);
+                        check(&input, radix);
+                        input.push(b'!');
+                        check(&input, radix);
+                    }
+                }
+            }
+            let mut bits = 0x9e37_79b9_7f4a_7c15u64;
+            for index in 0..256 {
+                bits = bits.wrapping_mul(6364136223846793005).wrapping_add(1);
+                let value = match index {
+                    0 => i64::MIN,
+                    1 => i64::MIN + 1,
+                    2 => i64::MAX,
+                    3 => i64::MAX - 1,
+                    _ => bits as i64,
+                };
+                let mut text = Vec::new();
+                format_radix(value, radix as u32, &mut text);
+                check(&text, radix);
+                assert_eq!(parse_int_radix(&text, radix), Ok(value));
+                check(&text.to_ascii_uppercase(), radix);
+                if value >= 0 {
+                    let mut signed = b"+000".to_vec();
+                    signed.extend_from_slice(&text);
+                    check(&signed, radix);
+                }
+            }
+        }
+        for radix in [i64::MIN, -1, 0, 1, 37, i64::MAX] {
+            for text in [b"1".as_slice(), b"", b"-", b"!", b"18446744073709551616"] {
+                check(text, radix);
+            }
+        }
+    }
