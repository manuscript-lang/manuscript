fn layouts(flag: Bool) Int:
    callbacks := [
        (
            fn(value: Int) Int:
                return value + 1
        ),
        (
            fn(value: Int) Int:
                return value - 1
        )
    ]
    values := [
        match flag:
            true: 1
            false: 2
    ]
    return callbacks[0](values[0])
