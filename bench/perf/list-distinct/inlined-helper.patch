index f6cf62b2d..ddbbd31af 100644
--- a/crates/ms-rt/src/map.rs
+++ b/crates/ms-rt/src/map.rs
@@ -1272,0 +1273,10 @@ unsafe fn add_copy(m: &mut MapVal, kd: &TypeDesc, p: *const u8) {
+        add_copy_absent(m, kd, p);
+    }
+}
+
+/// Copies a key that the caller has already checked is absent. Keeping the membership check
+/// in the caller lets a duplicate-heavy distinct loop use its existing small lookup path.
+#[inline]
+pub(crate) unsafe fn add_copy_absent(m: &mut MapVal, kd: &TypeDesc, p: *const u8) {
+    // SAFETY: `p` is a live key slot; insert consumes the fresh copy.
+    unsafe {
@@ -1351 +1361,2 @@ unsafe fn filter_into(
-                add_copy(&mut *out, kd, k);
+                // A is already unique, and this output starts empty.
+                add_copy_absent(&mut *out, kd, k);
@@ -1503,0 +1515,90 @@ mod tests {
+    #[test]
+    fn distinct_checks_membership_only_once_before_inserting() {
+        let _g = testutil::lock();
+        // SAFETY: every list and set slot holds an i64 described by COUNTED_KEY.
+        unsafe {
+            let before = alloc::live_blocks();
+            for len in [0usize, 1, 16, 17, 64] {
+                let mut source = VecVal {
+                    ptr: core::ptr::null_mut(),
+                    len: 0,
+                    cap: 0,
+                };
+                for i in 0..len {
+                    let value = (i % 32) as i64;
+                    crate::vec::msrt_list_push(
+                        &mut source,
+                        &COUNTED_KEY,
+                        (&value as *const i64).cast(),
+                    );
+                }
+                HASH_CALLS.store(0, Ordering::Relaxed);
+                let mut output = core::mem::MaybeUninit::<VecVal>::uninit();
+                crate::vec::msrt_list_distinct(&source, &COUNTED_KEY, output.as_mut_ptr());
+                let mut output = output.assume_init();
+                let unique = len.min(32);
+                // Distinct checks once per visit, then inserts each absent key. The
+                // empty set skips hashing its first check; the copy helper never rechecks.
+                let expected_hashes = if len <= 16 { 0 } else { len + unique - 1 };
+                assert_eq!(HASH_CALLS.load(Ordering::Relaxed), expected_hashes);
+                assert_eq!(source.len, len);
+                assert_eq!(output.len, unique);
+                for i in 0..output.len {
+                    assert_eq!(*output.ptr.cast::<i64>().add(i), i as i64);
+                }
+                crate::vec::drop_list(&mut output, &COUNTED_KEY);
+                crate::vec::drop_list(&mut source, &COUNTED_KEY);
+            }
+            assert_eq!(alloc::live_blocks(), before);
+        }
+    }
+
+    #[test]
+    fn set_algebra_does_not_recheck_unique_output_keys() {
+        let _g = testutil::lock();
+        // SAFETY: sets contain live i64 keys of the counted descriptor.
+        unsafe {
+            let before = alloc::live_blocks();
+            let kd = &COUNTED_KEY;
+            let mut a = empty();
+            let mut b = empty();
+            for i in 0..32i64 {
+                let mut x = i;
+                let mut y = i + 32;
+                insert(
+                    &mut a,
+                    kd,
+                    None,
+                    (&mut x as *mut i64).cast(),
+                    core::ptr::null_mut(),
+                );
+                insert(
+                    &mut b,
+                    kd,
+                    None,
+                    (&mut y as *mut i64).cast(),
+                    core::ptr::null_mut(),
+                );
+            }
+            let mut output = empty();
+            HASH_CALLS.store(0, Ordering::Relaxed);
+            msrt_set_intersection(&a, &a, kd, &mut output);
+            assert_eq!(output.len, 32);
+            assert_eq!(HASH_CALLS.load(Ordering::Relaxed), 64);
+            drop_map(&mut output, kd, None);
+            HASH_CALLS.store(0, Ordering::Relaxed);
+            msrt_set_difference(&a, &b, kd, &mut output);
+            assert_eq!(output.len, 32);
+            assert_eq!(HASH_CALLS.load(Ordering::Relaxed), 64);
+            drop_map(&mut output, kd, None);
+            HASH_CALLS.store(0, Ordering::Relaxed);
+            msrt_set_symmetric_difference(&a, &b, kd, &mut output);
+            assert_eq!(output.len, 64);
+            assert_eq!(HASH_CALLS.load(Ordering::Relaxed), 160);
+            drop_map(&mut output, kd, None);
+            drop_map(&mut a, kd, None);
+            drop_map(&mut b, kd, None);
+            assert_eq!(alloc::live_blocks(), before);
+        }
+    }
+
