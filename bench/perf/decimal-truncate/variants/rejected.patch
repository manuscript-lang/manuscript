index 000000000..c961f7f8a
--- /dev/null
+++ b/tests/e2e/testdata/stdlib/decimal-truncation-boundaries.ms
@@ -0,0 +1,25 @@
+import Decimal from "@std/decimal.ms"
+import expect_equal from "@std/test.ms"
+
+test "decimal truncation keeps signed Int boundaries after discarding fractions":
+    let maximum: Int = 9223372036854775807
+    let minimum: Int = -9223372036854775808
+    try expect_equal(9223372036854775807.9d.truncate_to_int(), maximum)
+    try expect_equal((-9223372036854775808.9d).truncate_to_int(), minimum)
+    try expect_equal(9223372036854775808d.truncate_to_int(), none)
+    try expect_equal((-9223372036854775809d).truncate_to_int(), none)
+    try expect_equal(1e19d.truncate_to_int(), none)
+    try expect_equal((-1e19d).truncate_to_int(), none)
+    try expect_equal(9e18d.truncate_to_int(), 9000000000000000000)
+    try expect_equal((-9e18d).truncate_to_int(), -9000000000000000000)
+
+test "decimal truncation scales full precision and extreme exponents exactly":
+    try expect_equal(9999999999999999999999999999999999e-33d.truncate_to_int(), 9)
+    try expect_equal((-9999999999999999999999999999999999e-33d).truncate_to_int(), -9)
+    try expect_equal(9999999999999999999999999999999999e-34d.truncate_to_int(), 0)
+    try expect_equal((-9999999999999999999999999999999999e-34d).truncate_to_int(), 0)
+    try expect_equal(1e-6176d.truncate_to_int(), 0)
+    try expect_equal((-1e-6176d).truncate_to_int(), 0)
+    try expect_equal(1e6144d.truncate_to_int(), none)
+    try expect_equal((-1e6144d).truncate_to_int(), none)
+    try expect_equal(0d.truncate_to_int(), 0)
