+/// Whether `2 * abs / 10^power` is an odd integer: exactly halfway between decimals.
+fn decimal_midpoint(abs: f64, power: i32) -> bool {
+    let bits = abs.to_bits();
+    let encoded_exp = ((bits >> 52) & 0x7ff) as i32;
+    let fraction = bits & ((1u64 << 52) - 1);
+    let (significand, exp) = if encoded_exp == 0 {
+        (fraction, -1074)
+    } else {
+        (fraction | (1u64 << 52), encoded_exp - 1075)
+    };
+    let binary_power = exp + significand.trailing_zeros() as i32;
+    if binary_power != power - 1 {
+        return false;
+    }
+    if power <= 0 {
+        return true;
+    }
+    // A nonzero f64 significand has at most 53 bits; 5^23 is larger than that.
+    power <= 22 && significand % 5u64.pow(power as u32) == 0
+}
