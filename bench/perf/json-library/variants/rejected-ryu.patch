+/// The shortest round-trip digits of finite positive `abs`, normalized from Ryū's fixed or
+/// exponent form into the digits and exponent consumed by the existing JSON layout.
+fn sci_digits(abs: f64, buf: &mut [u8; 24]) -> Option<(usize, i32)> {
+    let mut ryu = ryu::Buffer::new();
+    let text = ryu.format_finite(abs);
+    let e_at = text.bytes().position(|c| c == b'e').unwrap_or(text.len());
+    let mantissa = &text[..e_at];
+    let mut exp: i32 = if e_at < text.len() {
+        text[e_at + 1..].parse().ok()?
+    } else {
+        0
+    };
+    let point = mantissa
+        .bytes()
+        .position(|c| c == b'.')
+        .unwrap_or(mantissa.len());
+    exp += point as i32 - 1;
+    let mut n = 0;
+    for c in mantissa.bytes() {
+        if c == b'.' {
+            continue;
+        }
+        if n == 0 && c == b'0' {
+            exp -= 1;
+            continue;
+        }
+        *buf.get_mut(n)? = c;
+        n += 1;
+    }
+    while n > 1 && buf[n - 1] == b'0' {
+        n -= 1;
+    }
+    if n == 0 {
+        return None;
+    }
+    // Both printers choose shortest nearest decimals, but disagree on exact halfway ties.
+    // Keep the established scientific formatter's tie choice without paying for it otherwise.
+    if decimal_midpoint(abs, exp + 1 - n as i32) {
+        return std_sci_digits(abs, buf);
+    }
+    Some((n, exp))
+}
