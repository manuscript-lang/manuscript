{
  "name": "manuscript",
  "version": "0.1.0",
  "description": "A minimal language for building agents",
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "manuscript": "./bin/manuscript.ts",
    "ms": "./bin/manuscript.ts"
  },
  "scripts": {
    "lint": "node_modules/.bin/eslint src tests bin --max-warnings 0",
    "build": "bun build --compile bin/manuscript.ts ./src/stdlib/** --asset-naming=\"[name].[ext]\" --outfile ms",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "check": "tsc --noEmit",
    "ms": "bun run bin/manuscript.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "8",
    "typescript": "^5",
    "typescript-eslint": "^8.54.0"
  }
}
