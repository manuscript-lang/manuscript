import (
	Bytes from "@std/bytes.ms",
	base64_decode from "@std/data/encoding.ms",

	msstd_time_system_zone, msstd_time_system_zone_file from "@std/internal/time.ms",
	TZDATA from "@std/internal/tzdata.ms",
	WINDOWS_ZONES from "@std/internal/windows_zones.ms",
)

/*
Time zones for `@std/time`: UTC, fixed offsets such as `+05:30`, the host's local zone and IANA names.
Named zones are read from bundled TZif data (`@std/internal/tzdata.ms`, generated by `tools/tzdata.ms`) with the rules of RFC 8536 and the POSIX TZ footer, so no operating-system zone database is needed.
*/

// The offset east of UTC in seconds and the abbreviation in force at one instant.
export type ZoneInfo:
	offset: Int
	abbr: String

// One side of a POSIX daylight-saving rule: `Mm.w.d` (kind 0), `Jn` (kind 1) or `n`
// (kind 2), at `time` seconds after local midnight.
export type PosixDay:
	kind: Int
	month: Int
	week: Int
	day: Int
	time: Int

// A POSIX TZ rule such as `CET-1CEST,M3.5.0,M10.5.0/3`. Offsets are seconds east of
// UTC. Without daylight saving, `start` and `end` are unused.
export type PosixRule:
	std_abbr: String
	std_offset: Int
	has_dst: Bool
	dst_abbr: String
	dst_offset: Int
	start: PosixDay
	end: PosixDay

// A zone: fixed (no `data`) or TZif data. The counts and positions locate the parts of
// a validated version 2 or later data block.
export type Zone:
	// The IANA name, or empty for an unnamed zone.
	name: String
	// Offset east of UTC and abbreviation of a fixed zone.
	fixed_offset: Int
	fixed_abbr: String
	data: Bytes
	transition_count: Int
	type_count: Int
	transitions_at: Int
	indexes_at: Int
	types_at: Int
	chars_at: Int
	chars_end: Int
	// The rule after the last transition, when the data has one.
	rule: PosixRule?

SECONDS_PER_DAY := 86400

// The zone for `UTC` and the empty name.
export fn utc_zone() Zone:
	return fixed_zone("UTC", 0, "UTC")

// A zone that always has one offset; `name` is its IANA name or empty, `abbr` the
// abbreviation it reports.
fn fixed_zone(name: String, offset: Int, abbr: String) Zone:
	return Zone(
		name: name.clone(),
		fixed_offset: offset,
		fixed_abbr: abbr,
		data: Bytes([]),
		transition_count: 0,
		type_count: 0,
		transitions_at: 0,
		indexes_at: 0,
		types_at: 0,
		chars_at: 0,
		chars_end: 0,
		rule: none,
	)

/*
Resolves `UTC`, the empty string, `Local`, a fixed offset such as `+05:30` or an IANA name; none for anything else.
Names are case-sensitive.
*/
export fn load_zone(name: String) Zone?:
	if name == "UTC" or name == "": return utc_zone()
	if name == "Local": return host_zone()
	if offset := fixed_offset(name): return fixed_zone("", offset, name)

	return named_zone(name)

// Parses `^[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]$` into seconds east of UTC.
fn fixed_offset(text: String) Int?:
	if text.length() != 6: return none

	bytes := text.to_bytes()
	sign := bytes.get_or(0).to_int()
	if (sign != 43 and sign != 45) or bytes.get(3).to_int() != 58: return none

	hours := two_digits(bytes, 1)
	minutes := two_digits(bytes, 4)
	if hours < 0 or hours > 23 or minutes < 0 or minutes > 59: return none

	seconds := hours * 3600 + minutes * 60
	if sign == 45: return -seconds

	return seconds

// The two ASCII digits at `at` as a number, or -1.
fn two_digits(bytes: Bytes, at: Int) Int:
	tens := bytes.get(at).to_int() - 48
	ones := bytes.get(at + 1).to_int() - 48
	if tens < 0 or tens > 9 or ones < 0 or ones > 9: return -1

	return tens * 10 + ones

// The longest group header in the bundled data, which the lookup window must cover.
GROUP_WINDOW := 1200

// Finds a bundled zone by its exact IANA name. Each line of the data is
// ` name name ... :LENGTH:BASE64`, one line per distinct zone with every name that
// shares it.
fn named_zone(name: String) Zone?:
	if name.contains("..") or name.starts_with("/") or name.starts_with("\\"): return none
	if name.contains(" ") or name.contains(":") or name.contains("\n"): return none

	at := TZDATA.index_of(f" {name} ")?
	total := TZDATA.length()
	head := TZDATA.slice(
		at,
		if at + GROUP_WINDOW < total: at + GROUP_WINDOW else: total,
	)
	first := head.index_of(":")?
	rest := head.slice(first + 1, head.length())
	second := rest.index_of(":")?
	size := rest.slice(0, second).parse_int()?
	start := at + first + 1 + second + 1
	encoded := TZDATA.slice(start, start + size)
	bytes := base64_decode(encoded).get_or(Bytes([]))
	return parse_tzif(name, bytes)

// The host's local zone: the `TZ` setting, else the system zone file, else UTC.
export fn host_zone() Zone:
	spec := msstd_time_system_zone()

	if spec.starts_with("windows:"):
		if zone := windows_zone(spec.slice(8, spec.length())): return zone
		return utc_zone()

	if spec.starts_with("tz:"):
		if zone := zone_from_setting(spec.slice(3, spec.length())): return zone
		return utc_zone()

	if spec.starts_with("link:"):
		if zone := named_zone(spec.slice(5, spec.length())): return zone
	if zone := parse_tzif("", msstd_time_system_zone_file().get_or(Bytes([]))): return zone

	return utc_zone()

// A `TZ` value: an IANA name, a POSIX rule, or `UTC`.
fn zone_from_setting(value: String) Zone?:
	if value == "" or value == "UTC": return utc_zone()
	if zone := named_zone(value): return zone
	if rule := parse_posix(value): return rule_zone(rule)

	return none

// A zone that follows one POSIX rule.
fn rule_zone(rule: PosixRule) Zone:
	zone := fixed_zone("", rule.std_offset, rule.std_abbr.clone())
	return Zone(
		name: "",
		fixed_offset: zone.fixed_offset,
		fixed_abbr: zone.fixed_abbr,
		data: Bytes([]),
		transition_count: 0,
		type_count: 0,
		transitions_at: 0,
		indexes_at: 0,
		types_at: 0,
		chars_at: 0,
		chars_end: 0,
		rule: rule,
	)

// Maps a Windows time-zone key such as `Pacific Standard Time` to its IANA zone.
fn windows_zone(key: String) Zone?:
	at := WINDOWS_ZONES.index_of(f"\n{key}=")?
	start := at + key.length() + 2
	rest := WINDOWS_ZONES.slice(start, WINDOWS_ZONES.length())
	end := rest.index_of("\n")?
	return named_zone(rest.slice(0, end))

/*
The name of a zone for `time.host_zone()`: its IANA name, or `UTC` when it has none.
*/
export fn zone_name(zone: Zone) String:
	if zone.name == "": return "UTC"
	return zone.name.clone()

// Reads a big-endian 32-bit signed integer; the caller has checked the bounds.
fn int32_at(data: Bytes, at: Int) Int:
	var value = 0
	for index in 0..4:
		value = value * 256 + data.get(at + index).to_int()
	if value >= 2147483648: return value - 4294967296

	return value

// Reads a big-endian 64-bit signed integer.
fn int64_at(data: Bytes, at: Int) Int:
	var value = 0

	for index in 0..8:
		byte := data.get(at + index).to_int()

		if index == 0 and byte >= 128: value = byte - 256
		else: value = value * 256 + byte

	return value

/*
Validates TZif data of version 2 or later and locates its 64-bit block.
Data that is truncated, inconsistent, or lacks a time type returns none.
*/
fn parse_tzif(name: String, data: Bytes) Zone?:
	if data.length() < 44 or not data.starts_with("TZif".to_bytes()): return none

	version := data.get(4).to_int()
	if version < 50: return none

	first_size := block_size(data, 0, 4)
	second := 44 + first_size
	if (
		data.length() < second + 44
		or not data.slice(second, second + 4).get_or(Bytes([])).starts_with(
			"TZif".to_bytes()
		)
	): return none

	transition_count := int32_at(data, second + 32)
	type_count := int32_at(data, second + 36)
	chars := int32_at(data, second + 40)
	body := second + 44
	size := block_size(data, second, 8)
	if type_count < 1 or transition_count < 0 or chars < 1 or size < 0: return none
	if data.length() < body + size: return none

	transitions_at := body
	indexes_at := transitions_at + transition_count * 8
	types_at := indexes_at + transition_count
	chars_at := types_at + type_count * 6
	chars_end := chars_at + chars
	footer_at := body + size
	for index in 0..transition_count:
		if data.get(indexes_at + index).to_int() >= type_count: return none
	for index in 0..type_count:
		if data.get(types_at + index * 6 + 5).to_int() >= chars: return none

	var rule: PosixRule? = none

	if footer_at < data.length() and data.get(footer_at).to_int() == 10:
		end := data.index_of_byte(10, footer_at + 1).get_or(data.length())
		text := data.decode_utf8_range(footer_at + 1, end).get_or("")
		if text != "": rule = parse_posix(text)

	return Zone(
		name: name.clone(),
		fixed_offset: 0,
		fixed_abbr: "",
		data: data,
		transition_count: transition_count,
		type_count: type_count,
		transitions_at: transitions_at,
		indexes_at: indexes_at,
		types_at: types_at,
		chars_at: chars_at,
		chars_end: chars_end,
		rule: rule,
	)

// The byte size of the data block whose header starts at `header`, with `width` bytes
// per transition time (4 in the first block, 8 in the second), or -1 if a count is
// negative.
fn block_size(data: Bytes, header: Int, width: Int) Int:
	utc_count := int32_at(data, header + 20)
	standard_count := int32_at(data, header + 24)
	leap_count := int32_at(data, header + 28)
	transition_count := int32_at(data, header + 32)
	type_count := int32_at(data, header + 36)
	chars := int32_at(data, header + 40)
	if utc_count < 0 or standard_count < 0 or leap_count < 0 or transition_count < 0:
		return -1
	if type_count < 0 or chars < 0: return -1

	return (
		transition_count * (width + 1)
		+ type_count * 6
		+ chars
		+ leap_count * (width + 4)
		+ standard_count
		+ utc_count
	)

/*
The offset and abbreviation in force at Unix time `unix`.
Before the first transition the first time type applies; after the last, the footer rule when the data has one.
*/
export fn zone_at(zone: Zone, unix: Int) ZoneInfo:
	if zone.type_count == 0:
		if rule := zone.rule: return rule_at(rule, unix)
		return ZoneInfo(offset: zone.fixed_offset, abbr: zone.fixed_abbr.clone())

	count := zone.transition_count

	if count == 0 or unix < int64_at(zone.data, zone.transitions_at):
		if count == 0:
			if rule := zone.rule: return rule_at(rule, unix)
		return type_info(zone, 0)

	var low = 0
	var high = count

	while high - low > 1:
		middle := (low + high) / 2

		if int64_at(zone.data, zone.transitions_at + middle * 8) <= unix:
			low = middle
		else:
			high = middle

	if low == count - 1:
		if rule := zone.rule: return rule_at(rule, unix)
	return type_info(zone, zone.data.get(zone.indexes_at + low).to_int())

// The offset and abbreviation of time type `index`.
fn type_info(zone: Zone, index: Int) ZoneInfo:
	at := zone.types_at + index * 6
	start := zone.chars_at + zone.data.get(at + 5).to_int()
	stop := zone.data.index_of_byte(0, start).get_or(zone.chars_end)
	abbr := zone.data.decode_utf8_range(start, stop).get_or("")
	return ZoneInfo(offset: int32_at(zone.data, at), abbr: abbr)

// How far from a local time the offsets that could apply to it are looked for: past the
// largest offset (14 hours) in both directions.
LOCAL_WINDOW := 64800

/*
The offset that applies to local time `local` (seconds since 1970-01-01 as read on the wall clock).
A time that a transition repeats gets the offset before it (the earlier instant), and a time that a transition skips gets the offset in force before the gap.
*/
export fn offset_for_local(zone: Zone, local: Int) Int:
	if zone.type_count == 0 and zone.rule.is_none(): return zone.fixed_offset

	low := local - LOCAL_WINDOW
	high := local + LOCAL_WINDOW
	var candidates = [zone_at(zone, low).offset]
	for moment in transitions_between(zone, low, high):
		candidates.append(zone_at(zone, moment).offset)

	var valid = false
	var best = candidates[0]
	var smallest = candidates[0]

	for offset in candidates:
		if offset < smallest: smallest = offset

		if zone_at(zone, local - offset).offset == offset:
			if not valid or offset > best: best = offset
			valid = true

	if valid: return best

	return smallest

// The instants in (low, high] at which the zone's offset or abbreviation may change.
fn transitions_between(zone: Zone, low: Int, high: Int) List[Int]:
	var found = List[Int]()
	count := zone.transition_count
	var index = 0
	var last = low

	if count > 0:
		var first = 0
		var stop = count

		while first < stop:
			middle := (first + stop) / 2

			if int64_at(zone.data, zone.transitions_at + middle * 8) <= low: first = (
				middle
				+ 1
			)
			else: stop = middle

		index = first

		while index < count:
			moment := int64_at(zone.data, zone.transitions_at + index * 8)
			if moment > high: break

			found.append(moment)
			index += 1

		last = int64_at(zone.data, zone.transitions_at + (count - 1) * 8)
		if last < low: last = low

	if rule := zone.rule:
		if rule.has_dst and high > last:
			from_year := year_of_days(
				floor_div(last + rule.std_offset, SECONDS_PER_DAY)
			)
			to_year := year_of_days(floor_div(high + rule.std_offset, SECONDS_PER_DAY))

			for year in from_year..(to_year + 1):
				start := rule_instant(rule.start, year, rule.std_offset)
				end := rule_instant(rule.end, year, rule.dst_offset)
				if start > last and start <= high: found.append(start)
				if end > last and end <= high: found.append(end)

	return found

// The offset and abbreviation a POSIX rule gives at `unix`.
fn rule_at(rule: PosixRule, unix: Int) ZoneInfo:
	if not rule.has_dst: return ZoneInfo(
		offset: rule.std_offset,
		abbr: rule.std_abbr.clone(),
	)

	year := year_of_days(floor_div(unix + rule.std_offset, SECONDS_PER_DAY))
	start := rule_instant(rule.start, year, rule.std_offset)
	end := rule_instant(rule.end, year, rule.dst_offset)
	dst := if start < end: unix >= start and unix < end else: unix >= start or unix < end
	if dst: return ZoneInfo(offset: rule.dst_offset, abbr: rule.dst_abbr.clone())

	return ZoneInfo(offset: rule.std_offset, abbr: rule.std_abbr.clone())

// The UTC instant at which `day` happens in `year`, where the clock then runs `offset`
// seconds east of UTC.
fn rule_instant(day: PosixDay, year: Int, offset: Int) Int:
	var days = 0

	if day.kind == 0:
		first := days_from_civil(year, day.month, 1)
		weekday := floor_mod(first + 4, 7)
		var of_month = 1 + floor_mod(day.day - weekday, 7) + (day.week - 1) * 7
		if of_month > days_in_month(year, day.month): of_month -= 7
		days = first + of_month - 1
	else if day.kind == 1:
		leap_shift := if is_leap(year) and day.day >= 60: 1 else: 0
		days = days_from_civil(year, 1, 1) + day.day - 1 + leap_shift
	else:
		days = days_from_civil(year, 1, 1) + day.day

	return days * SECONDS_PER_DAY + day.time - offset

// Parses a POSIX TZ string (`EST5EDT,M3.2.0,M11.1.0`, `<+03>-3`); none if malformed.
fn parse_posix(text: String) PosixRule?:
	bytes := text.to_bytes()
	var at = 0
	std := posix_abbr(bytes, at)?
	at = std.next

	std_west := posix_offset(bytes, at)?
	at = std_west.next

	std_offset := -std_west.value
	if at >= bytes.length():
		return PosixRule(
			std_abbr: std.text,
			std_offset: std_offset,
			has_dst: false,
			dst_abbr: "",
			dst_offset: std_offset,
			start: no_day(),
			end: no_day(),
		)

	dst := posix_abbr(bytes, at)?
	at = dst.next

	var dst_offset = std_offset + 3600

	if at < bytes.length() and bytes.get(at).to_int() != 44:
		dst_west := posix_offset(bytes, at)?
		at = dst_west.next
		dst_offset = -dst_west.value

	if at >= bytes.length() or bytes.get(at).to_int() != 44: return none

	start := posix_day(bytes, at + 1)?
	at = start.next
	if at >= bytes.length() or bytes.get(at).to_int() != 44: return none

	end := posix_day(bytes, at + 1)?
	if end.next != bytes.length(): return none

	return PosixRule(
		std_abbr: std.text,
		std_offset: std_offset,
		has_dst: true,
		dst_abbr: dst.text,
		dst_offset: dst_offset,
		start: start.day,
		end: end.day,
	)

fn no_day() PosixDay:
	return PosixDay(kind: 0, month: 1, week: 1, day: 0, time: 0)

// A parsed piece of a POSIX string and where the next piece begins.
type PosixText:
	text: String
	next: Int

type PosixNumber:
	value: Int
	next: Int

type PosixDayAt:
	day: PosixDay
	next: Int

// An abbreviation: three or more letters, or any characters between `<` and `>`.
fn posix_abbr(bytes: Bytes, at: Int) PosixText?:
	if at >= bytes.length(): return none

	if bytes.get(at).to_int() == 60:
		close := bytes.index_of_byte(62, at + 1)?
		text := bytes.decode_utf8_range(at + 1, close)?
		if text == "": return none

		return PosixText(text: text, next: close + 1)

	var end = at
	while end < bytes.length() and is_letter(bytes.get(end).to_int()): end += 1
	if end - at < 3: return none

	return PosixText(text: bytes.decode_utf8_range(at, end)?, next: end)

fn is_letter(byte: Int) Bool:
	return (byte >= 65 and byte <= 90) or (byte >= 97 and byte <= 122)

// `[+-]hh[:mm[:ss]]` as seconds, with hours up to 167 to cover the extended forms.
fn posix_offset(bytes: Bytes, at: Int) PosixNumber?:
	var cursor = at
	var sign = 1

	if cursor < bytes.length():
		byte := bytes.get(cursor).to_int()

		if byte == 45:
			sign = -1
			cursor += 1
		else if byte == 43:
			cursor += 1

	hours := posix_digits(bytes, cursor)?
	cursor = hours.next

	var seconds = hours.value * 3600

	if cursor < bytes.length() and bytes.get(cursor).to_int() == 58:
		minutes := posix_digits(bytes, cursor + 1)?
		cursor = minutes.next
		seconds += minutes.value * 60

		if cursor < bytes.length() and bytes.get(cursor).to_int() == 58:
			secs := posix_digits(bytes, cursor + 1)?
			cursor = secs.next
			seconds += secs.value

	return PosixNumber(value: sign * seconds, next: cursor)

// One or more ASCII digits.
fn posix_digits(bytes: Bytes, at: Int) PosixNumber?:
	var cursor = at
	var value = 0

	while cursor < bytes.length():
		digit := bytes.get(cursor).to_int() - 48
		if digit < 0 or digit > 9: break

		value = value * 10 + digit
		cursor += 1
		if value > 100000: return none

	if cursor == at: return none

	return PosixNumber(value: value, next: cursor)

// `Mm.w.d`, `Jn` or `n`, then an optional `/time`.
fn posix_day(bytes: Bytes, at: Int) PosixDayAt?:
	if at >= bytes.length(): return none

	var cursor = at
	var day = PosixDay(kind: 2, month: 1, week: 1, day: 0, time: 7200)
	lead := bytes.get(cursor).to_int()

	if lead == 77:
		month := posix_digits(bytes, cursor + 1)?
		if bytes.get_or(month.next, 0).to_int() != 46: return none

		week := posix_digits(bytes, month.next + 1)?
		if bytes.get_or(week.next, 0).to_int() != 46: return none

		weekday := posix_digits(bytes, week.next + 1)?
		if month.value < 1 or month.value > 12 or week.value < 1 or week.value > 5:
			return none
		if weekday.value > 6: return none

		cursor = weekday.next
		day = PosixDay(
			kind: 0,
			month: month.value,
			week: week.value,
			day: weekday.value,
			time: 7200,
		)
	else if lead == 74:
		number := posix_digits(bytes, cursor + 1)?
		if number.value < 1 or number.value > 365: return none

		cursor = number.next
		day = PosixDay(kind: 1, month: 1, week: 1, day: number.value, time: 7200)
	else:
		number := posix_digits(bytes, cursor)?
		if number.value > 365: return none

		cursor = number.next
		day = PosixDay(kind: 2, month: 1, week: 1, day: number.value, time: 7200)

	if cursor < bytes.length() and bytes.get(cursor).to_int() == 47:
		time := posix_offset(bytes, cursor + 1)?
		cursor = time.next
		day = PosixDay(
			kind: day.kind,
			month: day.month,
			week: day.week,
			day: day.day,
			time: time.value,
		)

	return PosixDayAt(day: day, next: cursor)

// Floor division and modulo, which differ from `/` and `%` for negative operands.
fn floor_div(value: Int, divisor: Int) Int:
	quotient := value / divisor
	if value % divisor != 0 and (value < 0) != (divisor < 0): return quotient - 1

	return quotient

fn floor_mod(value: Int, divisor: Int) Int:
	remainder := value % divisor
	if remainder != 0 and (remainder < 0) != (divisor < 0): return remainder + divisor

	return remainder

fn is_leap(year: Int) Bool:
	return year % 4 == 0 and (year % 100 != 0 or year % 400 == 0)

fn days_in_month(year: Int, month: Int) Int:
	if month == 2:
		if is_leap(year): return 29
		return 28

	if month == 4 or month == 6 or month == 9 or month == 11: return 30

	return 31

// Days since 1970-01-01 of a civil date.
fn days_from_civil(year: Int, month: Int, day: Int) Int:
	y := if month <= 2: year - 1 else: year
	era := floor_div(y, 400)
	year_of_era := y - era * 400
	shifted := (month + 9) % 12
	day_of_year := (153 * shifted + 2) / 5 + day - 1
	day_of_era := year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year
	return era * 146097 + day_of_era - 719468

// The civil year of a day number since 1970-01-01.
fn year_of_days(days: Int) Int:
	z := days + 719468
	era := floor_div(z, 146097)
	day_of_era := z - era * 146097
	year_of_era := (
		(
			day_of_era
			- day_of_era / 1460
			+ day_of_era / 36524
			- day_of_era / 146096
		)
		/ 365
	)
	day_of_year := (
		day_of_era
		- (365 * year_of_era + year_of_era / 4 - year_of_era / 100)
	)
	shifted := (5 * day_of_year + 2) / 153
	month := if shifted < 10: shifted + 3 else: shifted - 9
	if month <= 2: return year_of_era + era * 400 + 1

	return year_of_era + era * 400
