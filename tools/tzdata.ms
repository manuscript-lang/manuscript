// Writes src/stdlib/internal/tzdata.ms, the IANA time-zone data that `@std/time` reads:
//   ms run tools/tzdata.ms -- /usr/share/zoneinfo/tzdata.zi > src/stdlib/internal/tzdata.ms
// The argument is the compact source that the `tzdata` package installs (`tzdata.zi`,
// Homebrew and MSYS2 ship the same file); `zic` from the same package compiles it. Each
// distinct zone is compiled in the slim TZif form, so zones that share data are stored
// once under all their names.
// `make repo-check` does not run it; run it when the IANA release changes and commit the result.
import (
	base64_encode from "@std/data/encoding.ms",
	arguments from "@std/os/env.ms",
	read_file, remove, temporary_directory from "@std/os/fs.ms",
	host_tree, walk from "@std/os/tree.ms",

	capture, note, run_program from "./lib.ms",
)

fn main() Int:
	args := arguments()

	if args.length() != 1:
		note("usage: ms run tools/tzdata.ms -- <tzdata.zi>")
		return 2

	source := args[0].clone()
	version := capture("head", ["-n", "1", source.clone()]).trim()
	work := temporary_directory("tzdata").get()
	code := run_program("zic", ["-b", "slim", "-d", work.clone(), source])

	if code != 0:
		note("zic failed")
		return 1

	var names = List[String]()
	for entry in walk(host_tree(work.clone())).get():
		if not entry.directory: names.append(entry.path.clone())
	names.sort()

	var groups = Map[String, List[String]]()

	for name in names:
		data := read_file(f"{work}/{name}").wait().get()
		text := base64_encode(data)

		if groups.contains(text): groups[text].append(name.clone())
		else: groups[text] = [name.clone()]

	remove(work, recursive: true).get()
	print("// Generated by tools/tzdata.ms; do not edit.")
	print(f"// Source: IANA tz database, {version.replace("# ", "")}.")
	print("")
	print("export TZDATA := r\"\"\"")
	for entry in groups:
		print(f" {entry.value.join(" ")} :{entry.key.length()}:{entry.key}")
	print("\"\"\"")
	return 0
