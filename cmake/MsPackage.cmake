# Assembles the distribution archive for this host: `ms`, the runtime archives, the startup files and the pinned
# LLVM tools it links programs with, in the layout src/cli/install_layout.h describes.
#   -DMS_EXE=<ms> -DFILES=<startup-files dir> -DLIST=<generated/ms_runtime_list.cmake> -DSOURCE_DIR=<repo>
#   -DBINARY_DIR=<build dir> -DOS=<Linux|Darwin|Windows> -DARCH=<processor> -DOUT=<directory for the archive>
# Writes <OUT>/manuscript-<os>-<arch>.tar.gz (.zip on Windows) and its .sha256. The tools are downloaded once into <BINARY_DIR>/llvm-bundle
# and checked against the digests in toolchain/lld.lock.
cmake_minimum_required(VERSION 3.25)
include("${LIST}") # MS_RUNTIME_ARCHIVES, MS_RUNTIME_STATIC_ARCHIVES

string(TOLOWER "${OS}" os)
if(os STREQUAL "darwin")
  set(os darwin)
endif()
if(ARCH MATCHES "^(aarch64|arm64|ARM64)$")
  set(arch arm64)
else()
  set(arch amd64)
endif()
set(name "manuscript-${os}-${arch}")
set(stage "${BINARY_DIR}/package/${name}")
set(lib "${stage}/lib/ms")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/bin" "${lib}/bin" "${lib}/lib" "${lib}/runtime" "${lib}/runtime-static")

get_filename_component(exe_name "${MS_EXE}" NAME)
file(COPY "${MS_EXE}" DESTINATION "${stage}/bin")
file(COPY "${FILES}/" DESTINATION "${lib}/files")

# The runtime archives keep their link order in `archives`, one name per line.
foreach(variant runtime runtime-static)
  if(variant STREQUAL runtime)
    set(archives ${MS_RUNTIME_ARCHIVES})
  else()
    set(archives ${MS_RUNTIME_STATIC_ARCHIVES})
  endif()
  set(order "")
  foreach(archive IN LISTS archives)
    get_filename_component(file "${archive}" NAME)
    file(COPY "${archive}" DESTINATION "${lib}/${variant}")
    string(APPEND order "${file}\n")
  endforeach()
  file(WRITE "${lib}/${variant}/archives" "${order}")
endforeach()

# The pinned lld and llc (it makes the glibc stubs), per toolchain/lld.lock, and the shared LLVM library ms optimizes and
# generates code with in-process, per toolchain/llvm-lib.lock.
file(STRINGS "${SOURCE_DIR}/toolchain/lld.lock" lock)
foreach(line IN LISTS lock)
  if(line MATCHES "^tag +(.+)$")
    set(tag "${CMAKE_MATCH_1}")
  elseif(line MATCHES "^version +(.+)$")
    set(version "${CMAKE_MATCH_1}")
  elseif(line MATCHES "^([0-9a-f]+) +([^ ]+)$")
    set(digest_of_${CMAKE_MATCH_2} "${CMAKE_MATCH_1}")
  endif()
endforeach()
set(cache "${BINARY_DIR}/llvm-bundle")
file(MAKE_DIRECTORY "${cache}")
foreach(bundle lld llvm-tools)
  set(asset "${bundle}-${version}-${os}-${arch}.tar.gz")
  if(NOT DEFINED digest_of_${asset})
    message(FATAL_ERROR "toolchain/lld.lock has no ${asset}")
  endif()
  file(DOWNLOAD "https://github.com/manuscript-lang/llvm-bundle/releases/download/${tag}/${asset}" "${cache}/${asset}"
    EXPECTED_HASH SHA256=${digest_of_${asset}} STATUS result)
  list(GET result 0 code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "cannot fetch ${asset}: ${result}")
  endif()
  file(ARCHIVE_EXTRACT INPUT "${cache}/${asset}" DESTINATION "${cache}/${bundle}-${os}-${arch}")
endforeach()
set(suffix "")
if(os STREQUAL "windows")
  set(suffix ".exe")
endif()
file(COPY "${cache}/llvm-tools-${os}-${arch}/bin/llc${suffix}" DESTINATION "${lib}/bin")
file(COPY "${cache}/lld-${os}-${arch}/bin/lld${suffix}" DESTINATION "${lib}/bin")

file(STRINGS "${SOURCE_DIR}/toolchain/llvm-lib.lock" lib_lock)
foreach(line IN LISTS lib_lock)
  if(line MATCHES "^tag +(.+)$")
    set(lib_tag "${CMAKE_MATCH_1}")
  elseif(line MATCHES "^version +(.+)$")
    set(lib_version "${CMAKE_MATCH_1}")
  elseif(line MATCHES "^([0-9a-f]+) +([^ ]+)$")
    set(lib_digest_of_${CMAKE_MATCH_2} "${CMAKE_MATCH_1}")
  endif()
endforeach()
set(lib_asset "llvm-lib-${lib_version}-${os}-${arch}.tar.gz")
if(NOT DEFINED lib_digest_of_${lib_asset})
  message(FATAL_ERROR "toolchain/llvm-lib.lock has no ${lib_asset}")
endif()
file(DOWNLOAD "https://github.com/manuscript-lang/llvm-bundle/releases/download/${lib_tag}/${lib_asset}" "${cache}/${lib_asset}"
  EXPECTED_HASH SHA256=${lib_digest_of_${lib_asset}} STATUS result)
list(GET result 0 code)
if(NOT code EQUAL 0)
  message(FATAL_ERROR "cannot fetch ${lib_asset}: ${result}")
endif()
file(ARCHIVE_EXTRACT INPUT "${cache}/${lib_asset}" DESTINATION "${cache}/llvm-lib-${os}-${arch}")
if(os STREQUAL "windows")
  file(COPY "${cache}/llvm-lib-${os}-${arch}/bin/LLVM-C.dll" DESTINATION "${lib}/bin")
elseif(os STREQUAL "darwin")
  file(COPY "${cache}/llvm-lib-${os}-${arch}/lib/libLLVM.dylib" DESTINATION "${lib}/lib")
else()
  file(COPY "${cache}/llvm-lib-${os}-${arch}/lib/libLLVM.so" DESTINATION "${lib}/lib")
endif()

file(COPY "${SOURCE_DIR}/LICENSE" DESTINATION "${stage}")
file(COPY "${SOURCE_DIR}/examples/hello" DESTINATION "${stage}/examples")

file(MAKE_DIRECTORY "${OUT}")
if(os STREQUAL "windows")
  set(archive "${name}.zip")
  set(tar_args cf "${OUT}/${archive}" --format=zip "${name}")
else()
  set(archive "${name}.tar.gz")
  set(tar_args czf "${OUT}/${archive}" "${name}")
endif()
file(REMOVE "${OUT}/${archive}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar ${tar_args} WORKING_DIRECTORY "${BINARY_DIR}/package" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "cannot write ${OUT}/${archive}")
endif()
file(SHA256 "${OUT}/${archive}" sum)
file(WRITE "${OUT}/${archive}.sha256" "${sum}  ${archive}\n")
message(STATUS "${OUT}/${archive}")
