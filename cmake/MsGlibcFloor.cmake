# Compiles Linux code against glibc 2.28's headers, so the objects name only symbols glibc 2.28 exports and the
# runtime links against the stubs made from toolchain/glibc/<arch>.symbols (proposals/glibc-2-28-floor.md).
# The host's headers bind newer symbols (`__isoc23_strtol`, the `fstat64` family), which a 2.28 system lacks.
#
# The headers come from Debian 10's pinned `libc6-dev` and `linux-libc-dev` packages, fetched once at configure time
# and verified by hash. `-D__NO_INLINE__` keeps the headers from inlining `stat` and friends over `__xstat`, which
# a modern libc no longer exports; the runtime defines the family for program links (src/runtime/sys/glibc_stat.c).
# Sets MS_GLIBC_FLOOR_FLAGS (a list) and appends it to CMAKE_C_FLAGS. Off with -DMS_GLIBC_FLOOR=OFF.
option(MS_GLIBC_FLOOR "Compile Linux code against glibc 2.28 headers" ON)
set(MS_GLIBC_FLOOR_FLAGS "")
# MS_LIBC=musl is the inner build of the `--static` runtime (MsRuntimePackage.cmake): musl headers instead.
set(MS_LIBC "glibc" CACHE STRING "The C library the Linux code is built for: glibc or musl")
set(MS_BUILD_MUSL ON CACHE BOOL "Also build the musl runtime that `--static` links (Linux)")
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
  return()
endif()
include(MsMusl)
if(MS_LIBC STREQUAL "musl")
  set(MS_GLIBC_FLOOR_FLAGS ${MS_MUSL_FLOOR_FLAGS})
  string(REPLACE ";" " " ms_flags_text "${MS_GLIBC_FLOOR_FLAGS}")
  string(APPEND CMAKE_C_FLAGS " ${ms_flags_text}")
  return()
endif()
if(NOT MS_GLIBC_FLOOR)
  return()
endif()

if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
  set(ms_deb_arch arm64)
  set(ms_triple aarch64-linux-gnu)
  set(ms_libc_hash 04097716018288cef8b82339faa1a9847838b89f39574b5b169f4657da8bf269)
  set(ms_linux_hash e9a92d71d62655f673433c345a03fecaa4292f93c6572b28fd3d16dcfd1cc7f6)
else()
  set(ms_deb_arch amd64)
  set(ms_triple x86_64-linux-gnu)
  set(ms_libc_hash 76b8413920d91a9a4289f99839933d0d30095e0ec12b05bb4f1a7f27e5ef4a55)
  set(ms_linux_hash c512f30f5abe413464b79ed23b54958df8cc104446c3ae93d83d28e23728a571)
endif()
set(ms_deb_base "https://archive.debian.org/debian/pool/main")
set(ms_libc_deb "libc6-dev_2.28-10+deb10u1_${ms_deb_arch}.deb")
set(ms_linux_deb "linux-libc-dev_4.19.249-2_${ms_deb_arch}.deb")
set(MS_GLIBC_SYSROOT "${CMAKE_BINARY_DIR}/glibc-floor-${ms_deb_arch}")

if(NOT EXISTS "${MS_GLIBC_SYSROOT}/.ready")
  file(REMOVE_RECURSE "${MS_GLIBC_SYSROOT}")
  foreach(item "g/glibc|${ms_libc_deb}|${ms_libc_hash}" "l/linux|${ms_linux_deb}|${ms_linux_hash}")
    string(REPLACE "|" ";" item "${item}")
    list(GET item 0 dir)
    list(GET item 1 deb)
    list(GET item 2 hash)
    set(work "${MS_GLIBC_SYSROOT}/work")
    file(MAKE_DIRECTORY "${work}")
    file(DOWNLOAD "${ms_deb_base}/${dir}/${deb}" "${work}/${deb}" EXPECTED_HASH SHA256=${hash} STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "glibc floor: cannot fetch ${deb}: ${status} (configure with -DMS_GLIBC_FLOOR=OFF to use the host headers)")
    endif()
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar xf "${work}/${deb}" WORKING_DIRECTORY "${work}" RESULT_VARIABLE code)
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar xf "${work}/data.tar.xz" WORKING_DIRECTORY "${work}" RESULT_VARIABLE code2)
    if(NOT code EQUAL 0 OR NOT code2 EQUAL 0)
      message(FATAL_ERROR "glibc floor: cannot unpack ${deb}")
    endif()
    file(COPY "${work}/usr/include" DESTINATION "${MS_GLIBC_SYSROOT}/usr")
    file(REMOVE_RECURSE "${work}")
  endforeach()
  file(WRITE "${MS_GLIBC_SYSROOT}/.ready" "ok\n")
endif()

if(CMAKE_C_COMPILER_ID MATCHES "Clang")
  execute_process(COMMAND ${CMAKE_C_COMPILER} -print-resource-dir OUTPUT_VARIABLE ms_resource OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(ms_builtin_headers "${ms_resource}/include")
else()
  execute_process(COMMAND ${CMAKE_C_COMPILER} -print-file-name=include OUTPUT_VARIABLE ms_builtin_headers OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
set(MS_GLIBC_FLOOR_FLAGS -nostdinc -isystem "${ms_builtin_headers}" -isystem "${MS_GLIBC_SYSROOT}/usr/include/${ms_triple}"
  -isystem "${MS_GLIBC_SYSROOT}/usr/include" -D__NO_INLINE__)
string(REPLACE ";" " " ms_flags_text "${MS_GLIBC_FLOOR_FLAGS}")
string(APPEND CMAKE_C_FLAGS " ${ms_flags_text}")
