# The C libraries the runtime links: libuv, llhttp, nghttp2, OpenSSL, PCRE2, zlib, libcurl.
# llhttp is vendored and compiled here. The others come from pkg-config (MS_C_LIBS=system) or from the folder
# MS_LIBS_PREFIX (pinned builds of runtime/third_party/build.sh, the MSYS2 packages on Windows).
# Each library gets MS_LIB_<NAME>_INCLUDES (a list), MS_LIB_<NAME>_ARCHIVES (static archives, folded into the
# runtime archive) and MS_LIB_<NAME>_LINK (what a test links).
set(MS_LIB_NAMES uv nghttp2 ssl crypto pcre2 z curl)
set(_pkg_uv libuv)
set(_pkg_nghttp2 libnghttp2)
set(_pkg_ssl libssl)
set(_pkg_crypto libcrypto)
set(_pkg_pcre2 libpcre2-8)
set(_pkg_z zlib)
set(_pkg_curl libcurl)
set(_archive_uv libuv.a)
set(_archive_nghttp2 libnghttp2.a)
set(_archive_ssl libssl.a)
set(_archive_crypto libcrypto.a)
set(_archive_pcre2 libpcre2-8.a)
set(_archive_z libz.a)
set(_archive_curl libcurl.a)

set(MS_LIBS_AVAILABLE ON)
if(NOT MS_LIBS_WIRED)
  foreach(name ${MS_LIB_NAMES})
    set(MS_LIB_${name}_INCLUDES "")
    set(MS_LIB_${name}_ARCHIVES "")
    set(MS_LIB_${name}_LINK "")
  endforeach()
  # A target whose libraries are not wired can still have zlib (MS_LIBS_ONLY=z): the in-memory deflate and inflate
  # code is plain C, compiled here from the vendored sources like llhttp (no build system, no prefix).
  if("z" IN_LIST MS_LIBS_ONLY)
    set(MS_ZLIB_DIR "${CMAKE_SOURCE_DIR}/runtime/third_party/zlib")
    add_library(ms_zlib STATIC)
    foreach(_f adler32 compress crc32 deflate infback inffast inflate inftrees trees uncompr zutil)
      target_sources(ms_zlib PRIVATE "${MS_ZLIB_DIR}/${_f}.c")
    endforeach()
    target_include_directories(ms_zlib PUBLIC "${MS_ZLIB_DIR}")
    target_compile_options(ms_zlib PRIVATE -O2 -w ${MS_C_FLAGS})
    set(MS_LIB_z_INCLUDES "${MS_ZLIB_DIR}")
    set(MS_LIB_z_ARCHIVES "$<TARGET_FILE:ms_zlib>")
    set(MS_LIB_z_LINK "$<TARGET_FILE:ms_zlib>")
  endif()
elseif(MS_C_LIBS STREQUAL "system")
  # Homebrew keeps OpenSSL and zlib out of the default pkg-config path (keg-only formulae).
  if(CMAKE_HOST_APPLE)
    find_program(_brew brew)
    if(_brew)
      foreach(keg openssl@3 zlib)
        execute_process(COMMAND ${_brew} --prefix ${keg} OUTPUT_VARIABLE _prefix OUTPUT_STRIP_TRAILING_WHITESPACE
                        ERROR_QUIET RESULT_VARIABLE _status)
        if(_status EQUAL 0)
          set(ENV{PKG_CONFIG_PATH} "${_prefix}/lib/pkgconfig:$ENV{PKG_CONFIG_PATH}")
        endif()
      endforeach()
    endif()
  endif()
  find_package(PkgConfig REQUIRED)
  foreach(name ${MS_LIB_NAMES})
    pkg_check_modules(MS_PKG_${name} REQUIRED ${_pkg_${name}})
    set(MS_LIB_${name}_INCLUDES ${MS_PKG_${name}_INCLUDE_DIRS})
    set(MS_LIB_${name}_LINK ${MS_PKG_${name}_LINK_LIBRARIES} ${MS_PKG_${name}_LDFLAGS_OTHER})
    pkg_get_variable(_libdir ${_pkg_${name}} libdir)
    if(EXISTS "${_libdir}/${_archive_${name}}")
      set(MS_LIB_${name}_ARCHIVES "${_libdir}/${_archive_${name}}")
    else()
      set(MS_LIB_${name}_ARCHIVES "")
      message(WARNING "${_libdir}/${_archive_${name}} is missing (Alpine: install the *-static package); "
                      "the runtime archive cannot fold ${name}")
    endif()
  endforeach()
elseif(MS_C_LIBS STREQUAL "prefix")
  if(MS_LIBS_PREFIX STREQUAL "")
    message(FATAL_ERROR "MS_C_LIBS=prefix needs MS_LIBS_PREFIX")
  endif()
  foreach(name ${MS_LIB_NAMES})
    set(_file "${MS_LIBS_PREFIX}/lib/${_archive_${name}}")
    if(NOT EXISTS "${_file}")
      message(FATAL_ERROR "${_file} is missing; run: sh runtime/third_party/libs.sh install")
    endif()
    if(MS_LIBS_IDIRAFTER)
      set(MS_LIB_${name}_INCLUDES "")
    else()
      set(MS_LIB_${name}_INCLUDES "${MS_LIBS_PREFIX}/include")
    endif()
    set(MS_LIB_${name}_ARCHIVES "${_file}")
    set(MS_LIB_${name}_LINK "${_file}")
  endforeach()
else()
  message(FATAL_ERROR "MS_C_LIBS must be system or prefix, not ${MS_C_LIBS}")
endif()

# llhttp: three vendored sources, compiled with the runtime's flags.
set(MS_LLHTTP_DIR "${CMAKE_SOURCE_DIR}/runtime/third_party/llhttp")
add_library(ms_llhttp STATIC "${MS_LLHTTP_DIR}/src/api.c" "${MS_LLHTTP_DIR}/src/http.c"
                             "${MS_LLHTTP_DIR}/src/llhttp.c")
target_include_directories(ms_llhttp PUBLIC "${MS_LLHTTP_DIR}/include")
target_compile_options(ms_llhttp PRIVATE -O2 -w ${MS_C_FLAGS})
