# The musl sysroot for `--static` links on Linux: Alpine 3.20's pinned `musl-dev` (headers, startup objects,
# libc.a), `linux-headers` and `llvm-libunwind-static`, fetched once at configure time and verified by hash.
# Sets MS_MUSL_SYSROOT (a directory with usr/include and usr/lib) and MS_MUSL_FLOOR_FLAGS, the compile flags that
# build code against those headers. Included on Linux only.
if(CMAKE_SYSTEM_PROCESSOR MATCHES "aarch64|arm64")
  set(ms_alpine_arch aarch64)
  set(ms_musl_triple aarch64-linux-musl)
  set(ms_musl_hash 54c60103a486d0d54263289fd0bf89b490514e04b74d5228c346c78089d587e4)
  set(ms_kernel_hash bc25332bdecc5327393b7cdb626d81250e17bcb387005ec6d52d3fa09b6cac1b)
  set(ms_unwind_hash ebebd67c43a8b090c28d1ecfe36868f9747db260488e10b326386ba10323b4d5)
else()
  set(ms_alpine_arch x86_64)
  set(ms_musl_triple x86_64-linux-musl)
  set(ms_musl_hash e9cca1709f3a740976f22cc27b825261de062d97e7de2d08c41243017c389338)
  set(ms_kernel_hash eac03f9d5ac52a86734f73bb444272aebf323e6dc03e9b69f87545f9da122f8a)
  set(ms_unwind_hash 821296243994f5ae4824db2bc2f09f860b10b044357d05e0582bdac017832a51)
endif()
set(MS_MUSL_SYSROOT "${CMAKE_BINARY_DIR}/musl-sysroot-${ms_alpine_arch}")

if(NOT EXISTS "${MS_MUSL_SYSROOT}/.ready")
  file(REMOVE_RECURSE "${MS_MUSL_SYSROOT}")
  set(ms_alpine "https://dl-cdn.alpinelinux.org/alpine/v3.20/main/${ms_alpine_arch}")
  foreach(item "musl-dev-1.2.5-r4|${ms_musl_hash}" "linux-headers-6.6-r0|${ms_kernel_hash}"
               "llvm-libunwind-static-17.0.6-r1|${ms_unwind_hash}")
    string(REPLACE "|" ";" item "${item}")
    list(GET item 0 name)
    list(GET item 1 hash)
    set(work "${MS_MUSL_SYSROOT}/work")
    file(MAKE_DIRECTORY "${work}")
    file(DOWNLOAD "${ms_alpine}/${name}.apk" "${work}/${name}.apk" EXPECTED_HASH SHA256=${hash} STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "musl: cannot fetch ${name}.apk: ${status} (configure with -DMS_BUILD_MUSL=OFF to skip)")
    endif()
    execute_process(COMMAND ${CMAKE_COMMAND} -E tar xf "${work}/${name}.apk" WORKING_DIRECTORY "${work}" RESULT_VARIABLE code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "musl: cannot unpack ${name}.apk")
    endif()
    file(COPY "${work}/usr" DESTINATION "${MS_MUSL_SYSROOT}")
    file(REMOVE_RECURSE "${work}")
  endforeach()
  file(WRITE "${MS_MUSL_SYSROOT}/.ready" "ok\n")
endif()

if(CMAKE_C_COMPILER_ID MATCHES "Clang")
  execute_process(COMMAND ${CMAKE_C_COMPILER} -print-resource-dir OUTPUT_VARIABLE ms_resource OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(ms_builtin_headers "${ms_resource}/include")
else()
  execute_process(COMMAND ${CMAKE_C_COMPILER} -print-file-name=include OUTPUT_VARIABLE ms_builtin_headers OUTPUT_STRIP_TRAILING_WHITESPACE)
endif()
set(MS_MUSL_FLOOR_FLAGS -nostdinc -isystem "${ms_builtin_headers}" -isystem "${MS_MUSL_SYSROOT}/usr/include")
