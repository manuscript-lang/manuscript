# cmake -DAR=<ar> -DOBJECTS=<list> -DLIBRARIES=<list> -DWORK=<dir> -DOUT=<file> -P FoldArchives.cmake
# Writes OUT: the objects, then every member of each library archive, one path per line.
# Each library's members are extracted under a prefix naming the library, so equal member names in two libraries
# stay apart (`ar rcs` replaces by name). A library with equal names inside itself cannot be extracted whole; that
# is reported, not folded wrong.
file(STRINGS "${OBJECTS}" _files)
file(STRINGS "${LIBRARIES}" _libraries)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/objects")
# `ar` keeps member base names only, so two sources of one name in different folders would replace each other:
# the objects are copied under a number.
set(_objects "")
set(_i 0)
foreach(object ${_files})
  get_filename_component(_base "${object}" NAME)
  file(COPY_FILE "${object}" "${WORK}/objects/${_i}-${_base}")
  list(APPEND _objects "${WORK}/objects/${_i}-${_base}")
  math(EXPR _i "${_i} + 1")
endforeach()
set(_files ${_objects})
set(_n 0)
foreach(library ${_libraries})
  if(library STREQUAL "")
    continue()
  endif()
  set(_dir "${WORK}/lib${_n}")
  math(EXPR _n "${_n} + 1")
  file(MAKE_DIRECTORY "${_dir}")
  execute_process(COMMAND ${AR} t "${library}" WORKING_DIRECTORY "${_dir}" OUTPUT_VARIABLE _listing
                  RESULT_VARIABLE _status)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "listing ${library} failed")
  endif()
  string(REPLACE "\n" ";" _lines "${_listing}")
  set(_members "")
  foreach(line ${_lines})
    string(STRIP "${line}" line)
    if(line MATCHES "\\.(o|obj)$")
      list(APPEND _members "${line}")
    endif()
  endforeach()
  set(_unique ${_members})
  list(REMOVE_DUPLICATES _unique)
  list(LENGTH _members _count)
  list(LENGTH _unique _unique_count)
  if(NOT _count EQUAL _unique_count)
    message(FATAL_ERROR "${library} has members with equal names")
  endif()
  execute_process(COMMAND ${AR} x "${library}" WORKING_DIRECTORY "${_dir}" RESULT_VARIABLE _status)
  if(NOT _status EQUAL 0)
    message(FATAL_ERROR "extracting ${library} failed")
  endif()
  get_filename_component(_stem "${library}" NAME_WE)
  foreach(member ${_members})
    file(RENAME "${_dir}/${member}" "${_dir}/${_stem}.${member}")
    list(APPEND _files "${_dir}/${_stem}.${member}")
  endforeach()
endforeach()
string(REPLACE ";" "\n" _text "${_files}")
file(WRITE "${OUT}" "${_text}\n")
