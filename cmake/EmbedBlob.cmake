# Generates a C file that carries one binary file as `const uint8_t <SYMBOL>[]` and `const size_t <SYMBOL>_size`.
# Run as: cmake -DINPUT=<file> -DOUTPUT=<file> -DSYMBOL=<name> -P EmbedBlob.cmake
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE "${OUTPUT}" "/* Generated by cmake/EmbedBlob.cmake from ${INPUT}. Do not edit. */\n#include <stddef.h>\n#include <stdint.h>\n\nconst uint8_t ${SYMBOL}[] = {${bytes}0};\nconst size_t ${SYMBOL}_size = ${size};\n")
