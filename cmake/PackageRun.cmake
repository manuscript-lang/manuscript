# `ms add`, `ms install` and `ms remove` end to end against a local git repository, on this platform: a package is
# committed and tagged, added to a project, installed again from the lock and removed again:
# `cmake -DMS_C=<ms> -DWORK=<scratch dir> -P cmake/PackageRun.cmake`.
cmake_minimum_required(VERSION 3.25)
if(WIN32)
  # Git for Windows, which reads `file:///D:/...` URLs; the MSYS2 shell's PATH has no git, and an MSYS git would take
  # that path for a POSIX one. `ms add` finds the same git through PATH.
  find_program(GIT git PATHS "$ENV{ProgramFiles}/Git/cmd" NO_DEFAULT_PATH)
  if(GIT)
    get_filename_component(git_dir "${GIT}" DIRECTORY)
    set(ENV{PATH} "${git_dir};$ENV{PATH}")
  endif()
else()
  find_program(GIT git)
endif()
if(NOT GIT)
  message(FATAL_ERROR "git is needed to build the package repository")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/pkg/src" "${WORK}/proj")
set(ENV{MANUSCRIPT_CACHE_DIR} "${WORK}/cache")
file(WRITE "${WORK}/pkg/ms.toml" "[project]\nname = \"greet\"\nsource = \"src\"\n")
file(WRITE "${WORK}/pkg/src/greet.ms" "export fn hello() String {\n    return \"hi\"\n}\n")

function(run directory)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${directory}" RESULT_VARIABLE status OUTPUT_VARIABLE out
    ERROR_VARIABLE err)
  set(status "${status}" PARENT_SCOPE)
  set(out "${out}" PARENT_SCOPE)
  set(err "${err}" PARENT_SCOPE)
endfunction()

function(must directory)
  run("${directory}" ${ARGN})
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${ARGN} exited with '${status}'\n${out}${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

function(expect_contains text needle what)
  string(FIND "${text}" "${needle}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "${what}: expected '${needle}' in:\n${text}")
  endif()
endfunction()

must("${WORK}/pkg" "${GIT}" init -q .)
must("${WORK}/pkg" "${GIT}" add -A)
must("${WORK}/pkg" "${GIT}" -c user.name=ms -c user.email=ms@example.invalid -c commit.gpgsign=false commit -q -m package)
must("${WORK}/pkg" "${GIT}" -c user.name=ms -c user.email=ms@example.invalid tag v1.0.0)

string(REPLACE "\\" "/" package_path "${WORK}/pkg")
if(package_path MATCHES "^/")
  set(url "file://${package_path}")
else()
  set(url "file:///${package_path}")
endif()

must("${WORK}/proj" "${MS_C}" init .)
must("${WORK}/proj" "${MS_C}" add "${url}" --tag v1.0.0 --as @greet)
expect_contains("${out}" "@greet" "add output")
file(READ "${WORK}/proj/ms.toml" manifest)
expect_contains("${manifest}" "[dependencies]" "manifest")
expect_contains("${manifest}" "\"@greet\"" "manifest")
if(NOT EXISTS "${WORK}/proj/ms.lock")
  message(FATAL_ERROR "ms add wrote no ms.lock")
endif()
file(READ "${WORK}/proj/ms.lock" lock)
expect_contains("${lock}" "v1.0.0" "lock")

must("${WORK}/proj" "${MS_C}" install)

must("${WORK}/proj" "${MS_C}" remove @greet)
file(READ "${WORK}/proj/ms.toml" manifest)
string(FIND "${manifest}" "@greet" at)
if(NOT at EQUAL -1)
  message(FATAL_ERROR "ms remove left the dependency in ms.toml:\n${manifest}")
endif()
