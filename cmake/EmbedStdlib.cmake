# Generates a C file that carries the bundled standard library: every src/stdlib/*.ms and src/stdlib/<dir>/*.ms, the
# files of src/stdlib/core/ under their flat names (they are the implicit prelude), in name order.
# Run as: cmake -DSTDLIB_DIR=<dir> -DOUTPUT=<file> -P EmbedStdlib.cmake
file(GLOB top RELATIVE "${STDLIB_DIR}" "${STDLIB_DIR}/*.ms")
file(GLOB nested RELATIVE "${STDLIB_DIR}" "${STDLIB_DIR}/*/*.ms")
set(entries "")
foreach(path IN LISTS top nested)
  get_filename_component(dir "${path}" DIRECTORY)
  if(dir STREQUAL "core")
    get_filename_component(name "${path}" NAME)
  else()
    set(name "${path}")
  endif()
  list(APPEND entries "${name}|${path}")
endforeach()
list(SORT entries)

set(body "/* Generated by cmake/EmbedStdlib.cmake from src/stdlib/. Do not edit. */\n#include \"compiler/project/project.h\"\n\n")
set(table "")
set(list "")
set(externs "")
set(index 0)
foreach(entry IN LISTS entries)
  string(REPLACE "|" ";" parts "${entry}")
  list(GET parts 0 name)
  list(GET parts 1 path)
  file(READ "${STDLIB_DIR}/${path}" hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "static const uint8_t text_${index}[] = {${bytes}0};\n")
  string(APPEND table "    {{(const uint8_t *)\"${name}\", sizeof(\"${name}\") - 1}, {text_${index}, sizeof(text_${index}) - 1}, std_bodies_${index}, &std_nbodies_${index}},\n")
  string(APPEND externs "extern const MsBodyRange std_bodies_${index}[];\nextern const size_t std_nbodies_${index};\n")
  string(APPEND list "${name}\t${path}\n")
  math(EXPR index "${index} + 1")
endforeach()
string(APPEND body "${externs}")
string(APPEND body "\nstatic const MsStdSource sources[] = {\n${table}};\n")
string(APPEND body "\nconst MsStdSource *ms_std_sources(size_t *count) {\n  *count = sizeof(sources) / sizeof(sources[0]);\n  return sources;\n}\n")
file(WRITE "${OUTPUT}" "${body}")
file(WRITE "${OUTPUT}.list" "${list}")
