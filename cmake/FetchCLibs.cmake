# Vendors and verifies the C libraries pinned in src/third_party/c-libs.lock (plan section 5).
# Fetch:  cmake -DSOURCE_DIR=<repo> -DMODE=fetch  -P cmake/FetchCLibs.cmake   (needs git and network)
# Verify: cmake -DSOURCE_DIR=<repo> -DMODE=verify -P cmake/FetchCLibs.cmake   (default; offline)
# Fetch one library only: add -DONLY=<name>.
# Each lock line is `<name> key=value ...` with version, tag, url, commit, paths (comma separated) and
# sha256. The sha256 covers the vendored files: the SHA-256 of the sorted lines "<file sha256>  <path>"
# of every file under the library directory, so any edit to vendored code fails the check.
cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED SOURCE_DIR)
  message(FATAL_ERROR "FetchCLibs: pass -DSOURCE_DIR=<repository root>")
endif()
if(NOT DEFINED MODE)
  set(MODE verify)
endif()
set(THIRD_PARTY "${SOURCE_DIR}/src/third_party")
set(LOCK "${THIRD_PARTY}/c-libs.lock")

# Sets <out> to the digest of every file under <dir> except the comma separated generated= files, which a
# library's own configure step writes into its source tree.
function(ms_tree_digest dir generated out)
  file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
  string(REPLACE "," ";" skip "${generated}")
  list(REMOVE_ITEM files ${skip})
  list(SORT files)
  set(manifest "")
  foreach(file IN LISTS files)
    file(SHA256 "${dir}/${file}" hash)
    string(APPEND manifest "${hash}  ${file}\n")
  endforeach()
  string(SHA256 digest "${manifest}")
  set(${out} "${digest}" PARENT_SCOPE)
endfunction()

# Parses one lock line into <prefix>_<key> variables.
function(ms_parse_lock_line line prefix)
  string(REPLACE " " ";" words "${line}")
  list(POP_FRONT words name)
  set(${prefix}_name "${name}" PARENT_SCOPE)
  foreach(word IN LISTS words)
    string(REGEX MATCH "^([a-z0-9]+)=(.*)$" matched "${word}")
    if(NOT matched)
      message(FATAL_ERROR "c-libs.lock: bad field '${word}' for ${name}")
    endif()
    set(${prefix}_${CMAKE_MATCH_1} "${CMAKE_MATCH_2}" PARENT_SCOPE)
  endforeach()
endfunction()

# Puts the library's source in <work> and returns its root directory in <root_out>. A lock line with
# `tarball=<sha256>` downloads that release tarball (url is the tarball's URL) and checks its digest; a line
# with `commit=` clones the tag instead, for libraries that publish no release tarball.
function(ms_get_source work root_out)
  file(REMOVE_RECURSE "${work}")
  if(DEFINED lib_tarball)
    file(DOWNLOAD "${lib_url}" "${work}.tar.gz" EXPECTED_HASH "SHA256=${lib_tarball}" STATUS status)
    list(GET status 0 code)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "${lib_name}: cannot download ${lib_url} with sha256 ${lib_tarball}: ${status}")
    endif()
    file(ARCHIVE_EXTRACT INPUT "${work}.tar.gz" DESTINATION "${work}")
    file(REMOVE "${work}.tar.gz")
    file(GLOB tops "${work}/*")
    list(LENGTH tops count)
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "${lib_name}: the tarball must hold one top directory, found ${count}")
    endif()
    list(GET tops 0 root)
    set(${root_out} "${root}" PARENT_SCOPE)
    return()
  endif()
  find_program(GIT git REQUIRED)
  execute_process(COMMAND "${GIT}" clone --quiet --depth 1 --branch "${lib_tag}" "${lib_url}" "${work}"
    RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${lib_name}: cannot clone ${lib_url} at ${lib_tag}")
  endif()
  execute_process(COMMAND "${GIT}" -C "${work}" rev-parse HEAD OUTPUT_VARIABLE commit
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(NOT commit STREQUAL lib_commit)
    file(REMOVE_RECURSE "${work}")
    message(FATAL_ERROR "${lib_name}: ${lib_tag} is commit ${commit}, the lock pins ${lib_commit}")
  endif()
  set(${root_out} "${work}" PARENT_SCOPE)
endfunction()

function(ms_fetch_lib)
  set(work "${SOURCE_DIR}/build/fetch-${lib_name}")
  ms_get_source("${work}" root)
  set(target "${THIRD_PARTY}/${lib_name}")
  file(REMOVE_RECURSE "${target}")
  string(REPLACE "," ";" paths "${lib_paths}")
  foreach(path IN LISTS paths)
    get_filename_component(parent "${path}" DIRECTORY)
    file(COPY "${root}/${path}" DESTINATION "${target}/${parent}")
  endforeach()
  file(REMOVE_RECURSE "${work}")
endfunction()

file(STRINGS "${LOCK}" lines)
set(failed FALSE)
foreach(line IN LISTS lines)
  if(line STREQUAL "" OR line MATCHES "^#")
    continue()
  endif()
  unset(lib_tarball)
  unset(lib_generated)
  ms_parse_lock_line("${line}" lib)
  if(DEFINED ONLY AND NOT lib_name STREQUAL ONLY)
    continue()
  endif()
  if(MODE STREQUAL "fetch")
    ms_fetch_lib()
  endif()
  ms_tree_digest("${THIRD_PARTY}/${lib_name}" "${lib_generated}" actual)
  if(NOT actual STREQUAL lib_sha256)
    message(SEND_ERROR "${lib_name}: vendored files hash to ${actual}, the lock has ${lib_sha256}")
    set(failed TRUE)
  else()
    message(STATUS "${lib_name} ${lib_version}: ok")
  endif()
endforeach()
if(failed)
  message(FATAL_ERROR "c-libs.lock check failed")
endif()
