# libpsl 0.23.3: the public suffix list lookup curl uses to refuse cookies for names like `co.uk`. Only the library is built, static,
# with the list compiled in (src/third_party/libpsl_data/suffixes_dafsa.h, generated by the vendored psl-make-dafsa; see the README
# there) and without a runtime IDNA library: curl hands it lower-case ASCII host names.
set(PSL_DIR ${MS_TP}/libpsl)
set(PSL_GEN ${MS_TP_BIN}/libpsl_include)
file(STRINGS ${PSL_DIR}/version.txt PSL_VERSION LIMIT_COUNT 1)
string(REPLACE "." ";" PSL_PARTS "${PSL_VERSION}")
list(GET PSL_PARTS 0 PSL_MAJOR)
list(GET PSL_PARTS 1 PSL_MINOR)
list(GET PSL_PARTS 2 PSL_PATCH)
math(EXPR PSL_NUMBER "(${PSL_MAJOR} << 16) | (${PSL_MINOR} << 8) | ${PSL_PATCH}" OUTPUT_FORMAT HEXADECIMAL)
set(LIBPSL_VERSION ${PSL_VERSION})
set(LIBPSL_VERSION_MAJOR ${PSL_MAJOR})
set(LIBPSL_VERSION_MINOR ${PSL_MINOR})
set(LIBPSL_VERSION_PATCH ${PSL_PATCH})
set(LIBPSL_VERSION_NUMBER ${PSL_NUMBER})
set(COPYRIGHT_YEAR 2026)
configure_file(${PSL_DIR}/include/libpsl.h.in ${PSL_GEN}/libpsl.h @ONLY)

add_library(psl_static STATIC ${PSL_DIR}/src/psl.c ${PSL_DIR}/src/lookup_string_in_fixed_set.c)
target_include_directories(psl_static PUBLIC ${PSL_GEN} PRIVATE ${MS_TP}/libpsl_data)
target_compile_definitions(psl_static PUBLIC PSL_STATIC PRIVATE ENABLE_BUILTIN "PACKAGE_VERSION=\"${PSL_VERSION}\"")
set_target_properties(psl_static PROPERTIES SYSTEM ON POSITION_INDEPENDENT_CODE ON C_VISIBILITY_PRESET default)
add_library(psl ALIAS psl_static)
