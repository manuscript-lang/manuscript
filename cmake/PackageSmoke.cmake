# Unpacks the distribution archive into an empty directory and builds, runs and tests the packaged hello example with
# nothing else: PATH holds no compiler or LLVM tool and no MS_* variable is set, so ms must find the runtime, the
# startup files, opt, llc and lld inside the package.
#   cmake -DDIST=<directory holding manuscript-*.tar.gz or .zip> -DWORK=<scratch dir> -P cmake/PackageSmoke.cmake
cmake_minimum_required(VERSION 3.25)
file(GLOB archives "${DIST}/manuscript-*.tar.gz" "${DIST}/manuscript-*.zip")
list(LENGTH archives archive_count)
if(NOT archive_count EQUAL 1)
  message(FATAL_ERROR "expected one archive in ${DIST}, found: ${archives}")
endif()
list(GET archives 0 ARCHIVE)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/unpacked" "${WORK}/empty")
file(ARCHIVE_EXTRACT INPUT "${ARCHIVE}" DESTINATION "${WORK}/unpacked")
file(GLOB roots LIST_DIRECTORIES true "${WORK}/unpacked/manuscript-*")
list(GET roots 0 root)
set(suffix "")
if(WIN32)
  set(suffix ".exe")
endif()
set(ms "${root}/bin/ms${suffix}")
foreach(variable MS_OPT MS_LLC MS_LLD MS_FILES MS_RUNTIME)
  unset(ENV{${variable}})
endforeach()
if(WIN32)
  set(ENV{PATH} "$ENV{SystemRoot}/System32")
else()
  set(ENV{PATH} "${WORK}/empty")
endif()

function(must)
  execute_process(COMMAND ${ARGN} WORKING_DIRECTORY "${root}/examples/hello" RESULT_VARIABLE status OUTPUT_VARIABLE out
    ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${ARGN} exited with '${status}'\n${out}${err}")
  endif()
  set(out "${out}" PARENT_SCOPE)
endfunction()

must("${ms}" run src/main.ms)
message(STATUS "ms run: ${out}")
must("${ms}" build src/main.ms -o "${WORK}/hello${suffix}")
must("${WORK}/hello${suffix}")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  must("${ms}" build --static src/main.ms -o "${WORK}/hello-static")
  must("${WORK}/hello-static")
endif()
must("${ms}" test)
message(STATUS "packaged ms builds, runs and tests the hello example")
