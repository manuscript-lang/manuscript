# Generates the table of runtime native signatures that lowering calls them by (compiler/lower/native_sigs.h).
# Input: SRC_DIR (the runtime's source tree) and OUTPUT. Each `ms-sig:` comment of a header names the C
# parameters of one `msrt_` function; the table keeps only what lowering needs: which parameters are
# type descriptors, which are the trailing results, and which are values passed through.
file(GLOB_RECURSE headers ${SRC_DIR}/*.h)
set(rows "")
set(pairs "")
foreach(header ${headers})
  file(READ ${header} text)
  string(REGEX REPLACE "\n[ ]*\\*[ ]*" " " text "${text}")
  string(REGEX MATCHALL "ms-sig: msrt_[a-z0-9_]+\\([^@]*@" sigs "${text}")
  string(REGEX MATCHALL "ms-sig: msrt_[a-z0-9_]+\\([^)]*\\)[^/]*@method=[A-Za-z_.]+" methods "${text}")
  foreach(entry ${methods})
    string(REGEX REPLACE "^ms-sig: (msrt_[a-z0-9_]+).*@method=([A-Za-z_.]+)$" "\\1=\\2" pair "${entry}")
    list(APPEND pairs "${pair}")
  endforeach()
  foreach(sig ${sigs})
    if(NOT sig MATCHES "^ms-sig: (msrt_[a-z0-9_]+)\\((.*)\\)[ ]*(->[ ]*[a-z0-9]+)?[ ]*@$")
      continue()
    endif()
    set(name ${CMAKE_MATCH_1})
    set(params "${CMAKE_MATCH_2}")
    if(params MATCHES "fn\\(" OR params MATCHES "extern")
      continue()
    endif()
    set(kinds "")
    set(count 0)
    string(REPLACE ", " ";" list "${params}")
    foreach(param ${list})
      string(REGEX REPLACE "^handle " "" param "${param}")
      string(REGEX REPLACE "^[a-z_0-9]+: " "" type "${param}")
      string(STRIP "${type}" type)
      if(type STREQUAL "*const VecVal")
        set(kind NS_VEC_IN)
      elseif(type STREQUAL "*mut VecVal")
        set(kind NS_VEC_MUT)
      elseif(type STREQUAL "*const StrVal")
        set(kind NS_STR_IN)
      elseif(type STREQUAL "*mut StrVal")
        set(kind NS_STR_MUT)
      elseif(type STREQUAL "*const MapVal")
        set(kind NS_MAP_IN)
      elseif(type STREQUAL "*mut MapVal")
        set(kind NS_MAP_MUT)
      elseif(type STREQUAL "ElemDesc")
        set(kind NS_ELEM_DESC)
      elseif(type STREQUAL "KeyDesc")
        set(kind NS_KEY_DESC)
      elseif(type STREQUAL "ValDesc")
        set(kind NS_VAL_DESC)
      elseif(type STREQUAL "*const u8")
        set(kind NS_ADDR_IN)
      elseif(type STREQUAL "*mut u8")
        set(kind NS_ADDR_MUT)
      elseif(type MATCHES "^\\*mut ")
        set(kind NS_OUT_SCALAR)
      else()
        set(kind NS_VALUE)
      endif()
      string(APPEND kinds "${kind}, ")
      math(EXPR count "${count} + 1")
    endforeach()
    if(count EQUAL 0)
      set(kinds "NS_VALUE, ")
    endif()
    set(method "NULL")
    foreach(pair ${pairs})
      if(pair MATCHES "^${name}=(.*)$")
        set(method "\"${CMAKE_MATCH_1}\"")
      endif()
    endforeach()
    list(APPEND rows "${name}|  {\"${name}\", ${count}, {${kinds}}, ${method}},\n")
  endforeach()
endforeach()
set(body "")
foreach(row ${rows})
  string(REGEX REPLACE "^[^|]*\\|" "" row "${row}")
  string(APPEND body "${row}")
endforeach()
list(LENGTH rows total)
file(WRITE ${OUTPUT}.tmp "/* Generated by cmake/EmbedNativeSigs.cmake from the ms-sig comments of src/runtime; do not edit. */\n#include \"compiler/lower/native_sigs.h\"\n\nconst MsNativeSig ms_native_sigs[] = {\n${body}};\n\nconst unsigned ms_native_sig_count = ${total};\n")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUTPUT}.tmp ${OUTPUT})
