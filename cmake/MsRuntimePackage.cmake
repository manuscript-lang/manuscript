# Packages the runtime for `ms` so linking needs no environment variables (pipeline.h).
#
#   ms_package_runtime(<ms target> <runtime target>)
#
# Finds every static library the runtime target links, makes the executable depend on them, and generates
# `ms_runtime_paths.h` with MS_BUILD_RUNTIME (their paths, separated like MS_RUNTIME) and MS_BUILD_FILES (the
# `files` directory next to the executable, filled after each build by cmake/MsFiles.cmake). The environment
# variables still override both.

# Appends the static libraries reachable from <target> to the list variable <out> in the caller's scope.
function(ms_collect_archives target out)
  set(seen ${${out}})
  set(todo ${target})
  while(todo)
    list(POP_FRONT todo current)
    string(REGEX REPLACE "^\\$<(LINK_ONLY|BUILD_INTERFACE):(.*)>$" "\\2" current "${current}")
    if(NOT TARGET "${current}" OR "${current}" IN_LIST seen)
      continue()
    endif()
    get_target_property(type ${current} TYPE)
    if(type STREQUAL "STATIC_LIBRARY")
      list(APPEND seen ${current})
    endif()
    foreach(property INTERFACE_LINK_LIBRARIES LINK_LIBRARIES)
      if(NOT type STREQUAL "INTERFACE_LIBRARY" OR property STREQUAL "INTERFACE_LINK_LIBRARIES")
        get_target_property(deps ${current} ${property})
        if(deps)
          list(APPEND todo ${deps})
        endif()
      endif()
    endforeach()
    if(NOT type STREQUAL "STATIC_LIBRARY")
      list(APPEND seen ${current}) # visited, filtered out below
    endif()
  endwhile()
  set(archives "")
  foreach(item IN LISTS seen)
    get_target_property(type ${item} TYPE)
    if(type STREQUAL "STATIC_LIBRARY")
      list(APPEND archives ${item})
    endif()
  endforeach()
  set(${out} "${archives}" PARENT_SCOPE)
endfunction()

function(ms_package_runtime executable runtime)
  set(archives "")
  ms_collect_archives(${runtime} archives)
  add_dependencies(${executable} ${archives})
  if(WIN32)
    set(separator ";")
  else()
    set(separator ":")
  endif()
  set(paths "")
  foreach(archive IN LISTS archives)
    list(APPEND paths "$<TARGET_FILE:${archive}>")
  endforeach()
  list(JOIN paths "${separator}" joined)
  set(files "$<TARGET_FILE_DIR:${executable}>/files")
  # On Windows the toolchain is the compiler's own MSYS2 prefix (`<msys64>/clang64`) unless MS_MINGW_DIR says otherwise.
  set(mingw_dir "${MS_MINGW_DIR}")
  if(WIN32 AND NOT mingw_dir)
    get_filename_component(compiler_bin "${CMAKE_C_COMPILER}" DIRECTORY)
    get_filename_component(mingw_dir "${compiler_bin}/.." ABSOLUTE)
  endif()
  # The `--static` runtime is the same archives built by the inner musl build, at the same place under its tree.
  set(musl_joined "")
  set(musl_paths "")
  if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
    foreach(archive IN LISTS archives)
      if(archive STREQUAL "ms_glibc_compat")
        continue() # glibc's entry and stat family; musl brings its own
      endif()
      list(APPEND musl_paths "${MS_MUSL_BUILD_DIR}/$<PATH:RELATIVE_PATH,$<TARGET_FILE:${archive}>,${CMAKE_BINARY_DIR}>")
    endforeach()
    list(JOIN musl_paths "${separator}" musl_joined)
    add_dependencies(${executable} runtime_musl)
  endif()
  # Where cmake/FetchLlvmLib.cmake puts the pinned shared LLVM library for this host (`make build` runs it), so a build
  # tree loads it in-process as an install does; MS_LLVM still overrides, and `none` selects the child processes.
  file(STRINGS "${CMAKE_SOURCE_DIR}/cmake/toolchain/llvm-lib.lock" llvm_tag_line REGEX "^tag ")
  string(REGEX REPLACE "^tag +" "" llvm_tag "${llvm_tag_line}")
  string(TOLOWER "${CMAKE_SYSTEM_NAME}" llvm_os)
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" llvm_processor)
  if(llvm_processor MATCHES "^(aarch64|arm64)")
    set(llvm_arch arm64)
  else()
    set(llvm_arch amd64)
  endif()
  if(llvm_os STREQUAL "darwin")
    set(llvm_file "lib/libLLVM.dylib")
  elseif(llvm_os STREQUAL "windows")
    set(llvm_file "bin/LLVM-C.dll")
  else()
    set(llvm_file "lib/libLLVM.so")
  endif()
  set(llvm_work "$ENV{LLVM_LIB_WORK}")
  if(NOT llvm_work)
    set(llvm_work "${CMAKE_SOURCE_DIR}/.artifacts/llvm-lib")
  endif()
  set(llvm_library "${llvm_work}/${llvm_tag}-${llvm_os}-${llvm_arch}/${llvm_file}")
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/generated/ms_runtime_paths.h" CONTENT
"/* Generated by cmake/MsRuntimePackage.cmake. */
#define MS_BUILD_LLVM \"${llvm_library}\"
#define MS_BUILD_RUNTIME \"${joined}\"
#define MS_BUILD_RUNTIME_STATIC \"${musl_joined}\"
#define MS_BUILD_FILES \"${files}\"
")
  # The same archives for cmake/MsPackage.cmake, as lists it can read at package time.
  list(JOIN paths "\;" archive_list)
  list(JOIN musl_paths "\;" musl_archive_list)
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/generated/ms_runtime_list.cmake" CONTENT
"set(MS_RUNTIME_ARCHIVES \"${archive_list}\")
set(MS_RUNTIME_STATIC_ARCHIVES \"${musl_archive_list}\")
")
  add_custom_target(dist
    COMMAND ${CMAKE_COMMAND}
      "-DMS_EXE=$<TARGET_FILE:${executable}>" "-DFILES=${files}" "-DLIST=${CMAKE_BINARY_DIR}/generated/ms_runtime_list.cmake"
      "-DSOURCE_DIR=${CMAKE_SOURCE_DIR}" "-DBINARY_DIR=${CMAKE_BINARY_DIR}" "-DOS=${CMAKE_SYSTEM_NAME}"
      "-DARCH=${CMAKE_SYSTEM_PROCESSOR}" "-DOUT=${CMAKE_BINARY_DIR}/dist"
      -P "${CMAKE_SOURCE_DIR}/cmake/MsPackage.cmake"
    DEPENDS ${executable} COMMENT "Assembling the distribution archive" VERBATIM)
  add_custom_target(dist-smoke
    COMMAND ${CMAKE_COMMAND} "-DDIST=${CMAKE_BINARY_DIR}/dist" "-DWORK=${CMAKE_BINARY_DIR}/dist-smoke"
      -P "${CMAKE_SOURCE_DIR}/cmake/PackageSmoke.cmake"
    DEPENDS dist COMMENT "Building the hello example with the unpacked archive alone" VERBATIM)
  target_include_directories(${executable} PRIVATE "${CMAKE_BINARY_DIR}/generated")
  add_custom_command(TARGET ${executable} POST_BUILD
    COMMAND ${CMAKE_COMMAND}
      "-DFILES=${files}"
      "-DSOURCE_DIR=${CMAKE_SOURCE_DIR}"
      "-DOS=${CMAKE_SYSTEM_NAME}"
      "-DARCH=${CMAKE_SYSTEM_PROCESSOR}"
      "-DMUSL_SYSROOT=${MS_MUSL_SYSROOT}"
      "-DMINGW_DIR=${mingw_dir}"
      "-DCOMPILER=${CMAKE_C_COMPILER}"
      -P "${CMAKE_SOURCE_DIR}/cmake/MsFiles.cmake"
    COMMENT "Filling the startup-files directory")
endfunction()

# The inner build that compiles the runtime against musl (MS_LIBC=musl), for `ms build --static`.
function(ms_add_musl_runtime)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR MS_LIBC STREQUAL "musl")
    return()
  endif()
  include(ExternalProject)
  ExternalProject_Add(runtime_musl
    SOURCE_DIR "${CMAKE_SOURCE_DIR}"
    BINARY_DIR "${MS_MUSL_BUILD_DIR}"
    CMAKE_ARGS -DMS_LIBC=musl -DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE} -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}
      -DCMAKE_C_COMPILER_LAUNCHER=${CMAKE_C_COMPILER_LAUNCHER} -DCMAKE_GENERATOR=${CMAKE_GENERATOR}
    INSTALL_COMMAND ""
    BUILD_ALWAYS 1
    USES_TERMINAL_BUILD OFF)
endfunction()
