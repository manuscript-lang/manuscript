# Packages the runtime for `ms-c` so linking needs no environment variables (pipeline.h).
#
#   ms_package_runtime(<ms-c target> <runtime target>)
#
# Finds every static library the runtime target links, makes the executable depend on them, and generates
# `ms_runtime_paths.h` with MS_BUILD_RUNTIME (their paths, separated like MS_RUNTIME) and MS_BUILD_FILES (the
# `files` directory next to the executable, filled after each build by cmake/MsFiles.cmake). The environment
# variables still override both.

# Appends the static libraries reachable from <target> to the list variable <out> in the caller's scope.
function(ms_collect_archives target out)
  set(seen ${${out}})
  set(todo ${target})
  while(todo)
    list(POP_FRONT todo current)
    string(REGEX REPLACE "^\\$<(LINK_ONLY|BUILD_INTERFACE):(.*)>$" "\\2" current "${current}")
    if(NOT TARGET "${current}" OR "${current}" IN_LIST seen)
      continue()
    endif()
    get_target_property(type ${current} TYPE)
    if(type STREQUAL "STATIC_LIBRARY")
      list(APPEND seen ${current})
    endif()
    foreach(property INTERFACE_LINK_LIBRARIES LINK_LIBRARIES)
      if(NOT type STREQUAL "INTERFACE_LIBRARY" OR property STREQUAL "INTERFACE_LINK_LIBRARIES")
        get_target_property(deps ${current} ${property})
        if(deps)
          list(APPEND todo ${deps})
        endif()
      endif()
    endforeach()
    if(NOT type STREQUAL "STATIC_LIBRARY")
      list(APPEND seen ${current}) # visited, filtered out below
    endif()
  endwhile()
  set(archives "")
  foreach(item IN LISTS seen)
    get_target_property(type ${item} TYPE)
    if(type STREQUAL "STATIC_LIBRARY")
      list(APPEND archives ${item})
    endif()
  endforeach()
  set(${out} "${archives}" PARENT_SCOPE)
endfunction()

function(ms_package_runtime executable runtime)
  set(archives "")
  ms_collect_archives(${runtime} archives)
  add_dependencies(${executable} ${archives})
  if(WIN32)
    set(separator ";")
  else()
    set(separator ":")
  endif()
  set(paths "")
  foreach(archive IN LISTS archives)
    list(APPEND paths "$<TARGET_FILE:${archive}>")
  endforeach()
  list(JOIN paths "${separator}" joined)
  set(files "$<TARGET_FILE_DIR:${executable}>/files")
  file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/generated/ms_runtime_paths.h" CONTENT
"/* Generated by cmake/MsRuntimePackage.cmake. */
#define MS_BUILD_RUNTIME \"${joined}\"
#define MS_BUILD_FILES \"${files}\"
")
  target_include_directories(${executable} PRIVATE "${CMAKE_BINARY_DIR}/generated")
  add_custom_command(TARGET ${executable} POST_BUILD
    COMMAND ${CMAKE_COMMAND}
      "-DFILES=${files}"
      "-DSOURCE_DIR=${CMAKE_SOURCE_DIR}"
      "-DOS=${CMAKE_SYSTEM_NAME}"
      "-DARCH=${CMAKE_SYSTEM_PROCESSOR}"
      "-DMUSL_DIR=${MS_MUSL_DIR}"
      "-DMINGW_DIR=${MS_MINGW_DIR}"
      -P "${CMAKE_SOURCE_DIR}/cmake/MsFiles.cmake"
    COMMENT "Filling the startup-files directory")
endfunction()
