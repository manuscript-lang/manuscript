yen;............................000A500000
yfr;............................1D53600000
yicy;...........................0045700000
yopf;...........................1D56A00000
yscr;...........................1D4CE00000
yucy;...........................0044E00000
yuml............................000FF00000
yuml;...........................000FF00000
zacute;.........................0017A00000
zcaron;.........................0017E00000
zcy;............................0043700000
zdot;...........................0017C00000
zeetrf;.........................0212800000
zeta;...........................003B600000
zfr;............................1D53700000
zhcy;...........................0043600000
zigrarr;........................021DD00000
zopf;...........................1D56B00000
zscr;...........................1D4CF00000
zwj;............................0200D00000
zwnj;...........................0200C00000
"""
// Windows-1252 replacements for the numeric references 0x80 to 0x9F.
CP1252 := [
	0x20AC, 0x0081, 0x201A, 0x0192, 0x201E, 0x2026, 0x2020, 0x2021, 0x02C6, 0x2030,
	0x0160, 0x2039, 0x0152, 0x008D, 0x017D, 0x008F, 0x0090, 0x2018, 0x2019, 0x201C,
	0x201D, 0x2022, 0x2013, 0x2014, 0x02DC, 0x2122, 0x0161, 0x203A, 0x0153, 0x009D,
	0x017E, 0x0178
]
// All entity names that do not end with `;` are at most this long.
LONGEST_WITHOUT_SEMICOLON := 6
SATURATED := 0x110000
// A table line is the name, the two code points and a newline.
ENTITY_STRIDE := ENTITY_NAME_WIDTH + 11

fn append_scalar(var out BytesBuilder, rune Int) Void {
	c := if rune > 0x10FFFF or (rune >= 0xD800 and rune <= 0xDFFF) { 0xFFFD } else { rune }

	if c < 0x80 {
		out.append(c.to_uint8() or 0)
	} else if c < 0x800 {
		out.append((0xC0 + c / 64).to_uint8() or 0)
		out.append((0x80 + c % 64).to_uint8() or 0)
	} else if c < 0x10000 {
		out.append((0xE0 + c / 4096).to_uint8() or 0)
		out.append((0x80 + c / 64 % 64).to_uint8() or 0)
		out.append((0x80 + c % 64).to_uint8() or 0)
	} else {
		out.append((0xF0 + c / 262144).to_uint8() or 0)
		out.append((0x80 + c / 4096 % 64).to_uint8() or 0)
		out.append((0x80 + c / 64 % 64).to_uint8() or 0)
		out.append((0x80 + c % 64).to_uint8() or 0)
	}
}

fn is_alnum(c Int) Bool {
	return (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
}

// The value of `c` as a digit in `radix`, or -1.
fn digit_value(c, radix Int) Int {
	var value = 99

	if c >= 48 and c <= 57 {
		value = c - 48
	} else if c >= 97 and c <= 102 {
		value = c - 87
	} else if c >= 65 and c <= 70 {
		value = c - 55
	}

	return if value < radix { value } else { - 1 }
}

// The first 8 bytes of `data[at..stop]`, padded with `.` (which sorts before every name
// byte), as a big-endian integer, so names order as integers.
fn name_key(data Bytes, at, stop Int) Int {
	var key = 0

	for j in 0..8 {
		c := if at + j < stop {
			data.get(at + j).to_int()
		} else {
			46
		}
		key = key * 256 + c
	}

	return key
}

// Orders the bytes of `data[at..at + size]` after the 8th against table row `row`,
// whose first 8 bytes equal the name's key.
fn compare_tail(table Bytes, row Int, data Bytes, at, size Int) Int {
	base := row * ENTITY_STRIDE

	for j in 8..size {
		left := data.get(at + j).to_int()
		right := table.get(base + j).to_int()
		if left != right { return if left < right { - 1 } else { 1 } }
	}

	return if size < ENTITY_NAME_WIDTH and table.get(
		base + size
	).to_int() != 46 { - 1 } else { 0 }
}

// The table row of the entity called `data[at..stop]`, or -1.
fn find_entity(table, data Bytes, at, stop Int) Int {
	size := stop - at
	if size > ENTITY_NAME_WIDTH or size <= 0 { return -1 }

	lead := data.get(at).to_int()
	letter := if lead >= 97 and lead <= 122 { lead - 71 } else if lead >= 65 and lead <= 90 { lead - 65 } else { - 1 }
	if letter < 0 { return -1 }

	key := name_key(data, at, stop)
	var low = ENTITY_BOUNDS[letter]
	var high = ENTITY_BOUNDS[letter + 1]

	while low < high {
		middle := low + (high - low) / 2
		row_key := ENTITY_KEYS[middle]
		order := if key < row_key {
			-1
		} else if key > row_key {
			1
		} else {
			compare_tail(table, middle, data, at, size)
		}
		if order == 0 { return middle }

		if order < 0 { high = middle } else { low = middle + 1 }
	}

	return -1
}

// The code point of table row `row`: the first, or the second when `second` is set (0
// when absent).
fn entity_code(table Bytes, row Int, second Bool) Int {
	var at = row * ENTITY_STRIDE + ENTITY_NAME_WIDTH
	if second { at += 5 }

	var value = 0
	for j in 0..5 {
		value = value * 16 + digit_value(table.get(at + j).to_int(), 16)
	}
	return value
}

fn append_entity(var out BytesBuilder, table Bytes, row Int) Void {
	append_scalar(out, entity_code(table, row, false))

	second := entity_code(table, row, true)
	if second != 0 { append_scalar(out, second) }
}

// A numeric reference at `data[at]` (`&#`): appends its code point and returns the
// bytes consumed, or 0 for a reference without digits (the `&` stays literal).
fn numeric_reference(data Bytes, at Int, var out BytesBuilder) Int {
	size := data.length()
	var i = at + 2
	hex := i < size and (data.get(i).to_int() == 120 or data.get(i).to_int() == 88)
	if hex { i += 1 }

	radix := if hex { 16 } else { 10 }
	digits_start := i

	// Saturates above U+10FFFF so a long run of digits maps to U+FFFD.
	var x = 0

	while i < size and digit_value(data.get(i).to_int(), radix) >= 0 {
		x = x * radix + digit_value(data.get(i).to_int(), radix)
		if x > SATURATED { x = SATURATED }
		i += 1
	}

	terminated := i < size and data.get(i).to_int() == 59

	// The tokenizer decodes a digitless `&#x;` as U+FFFD; the string form keeps it
	// literal.
	if i == digits_start and not (hex and terminated) { return 0 }

	if terminated { i += 1 }

	var rune = x

	if x >= 0x80 and x <= 0x9F {
		rune = CP1252[x - 0x80]
	} else if x == 0 or (x >= 0xD800 and x <= 0xDFFF) or x > 0x10FFFF {
		rune = 0xFFFD
	}

	append_scalar(out, rune)
	return i - at
}

// The longest prefix of `name` without `;` that is an entity, for text outside
// attributes: appends it and returns the bytes it consumed after the `&`, plus one, or
// 0.
fn legacy_prefix(table, data Bytes, at, stop Int, var out BytesBuilder) Int {
	var j = stop - at - 1
	if j > LONGEST_WITHOUT_SEMICOLON { j = LONGEST_WITHOUT_SEMICOLON }

	while j >= 2 {
		row := find_entity(table, data, at, at + j)

		if row >= 0 {
			append_scalar(out, entity_code(table, row, false))
			return j + 1
		}

		j -= 1
	}

	return 0
}

// A reference at `data[at]` (`&`): appends its replacement, or the bytes unchanged, and
// returns the bytes consumed.
fn reference(table, data Bytes, at Int, var out BytesBuilder, attribute Bool) Int {
	size := data.length()

	if at + 1 >= size {
		out.append(38)
		return 1
	}

	if data.get(at + 1).to_int() == 35 {
		used := numeric_reference(data, at, out)

		if used == 0 {
			out.append(38)
			return 1
		}

		return used
	}

	var i = at + 1

	while i < size {
		c := data.get(i).to_int()
		i += 1
		if is_alnum(c) { continue }

		if c != 59 { i -= 1 }
		break
	}

	length := i - at - 1
	semicolon := length > 0 and data.get(i - 1).to_int() == 59

	if (
		length > 0
		and not (
			attribute
			and not semicolon
			and i < size
			and data.get(i).to_int() == 61
		)
	) {
		row := find_entity(table, data, at + 1, i)

		if row >= 0 {
			append_entity(out, table, row)
			return i - at
		}

		used := if attribute { 0 } else { legacy_prefix(table, data, at + 1, i, out) }
		if used != 0 { return used }
	}

	out.append_bytes(data.view(at, i))
	return i - at
}

// `text` with its character references decoded. `literal_empty_hex` keeps `&#x;` literal (the string form).
export fn decode_references(text String, attribute, literal_empty_hex Bool) String {
	data := text.view_bytes()
	size := data.length()
	first := data.index_of_byte(38, 0)
	if first == null { return text.clone() }

	table := ENTITY_TABLE.view_bytes()
	var out = BytesBuilder()
	var i = 0

	while i < size {
		amp := data.index_of_byte(38, i) or size
		out.append_bytes(data.view(i, amp))
		i = amp
		if i == size { break }

		empty_hex := (
			literal_empty_hex
			and size - i >= 4
			and data.get(i + 1).to_int() == 35
			and (
				data.get(i + 2).to_int() == 120
				or data.get(i + 2).to_int() == 88
			)
			and data.get(i + 3).to_int() == 59
		)

		if empty_hex {
			out.append_bytes(data.view(i, i + 4))
			i += 4
		} else {
			i += reference(table, data, i, out, attribute)
		}
	}

	return out.build().decode_utf8() or ""
}

// The replacement for one of the five bytes escaped in an HTML text or quoted attribute
// context, else "".
fn replacement(c Int) String {
	if c == 38 { return "&amp;" }
	if c == 39 { return "&#39;" }
	if c == 60 { return "&lt;" }
	if c == 62 { return "&gt;" }
	if c == 34 { return "&#34;" }

	return ""
}

// `text` safe for an HTML text or quoted attribute context.
export fn escape_text(text String) String {
	data := text.view_bytes()
	var out = BytesBuilder()
	var start = 0

	for i in 0..data.length() {
		c := data.get(i).to_int()
		if c < 34 or c > 62 { continue }

		text_for := replacement(c)
		if text_for.is_empty() { continue }

		out.append_bytes(data.view(start, i))
		out.append_bytes(text_for.view_bytes())
		start = i + 1
	}

	if start == 0 { return text.clone() }

	out.append_bytes(data.view(start, data.length()))
	return out.build().decode_utf8() or ""
}
