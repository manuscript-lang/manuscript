/* The built-in types the compiler gives a native meaning: one row each, read by the enum, the name table and
 * the three lookups in types.c. MS_BUILTIN(id, origin, module, text):
 *   PRIMITIVE  a primitive spelled `text`;
 *   STD        the standard type whose type id is `@std/<text>`;
 *   SOURCE     a type `text` declared by the bundled module `module`;
 *   MARKER     no spelling (a closed type set and the implicit `Self` of an interface).
 * The order of the rows is the order of the enum and part of the checker's contract. */
MS_BUILTIN(Optional, STD, NULL, "Optional")
MS_BUILTIN(Result, STD, NULL, "Result")
MS_BUILTIN(List, STD, NULL, "List")
MS_BUILTIN(Map, STD, NULL, "Map")
MS_BUILTIN(Set, STD, NULL, "Set")
MS_BUILTIN(Bytes, STD, NULL, "Bytes")
MS_BUILTIN(BigInt, STD, NULL, "BigInt")
MS_BUILTIN(Decimal, STD, NULL, "Decimal")
MS_BUILTIN(Error, STD, NULL, "Error")
MS_BUILTIN(Closeable, STD, NULL, "Closeable")
MS_BUILTIN(Hashable, STD, NULL, "Hashable")
MS_BUILTIN(Stringable, STD, NULL, "Stringable")
MS_BUILTIN(Comparable, STD, NULL, "Comparable")
MS_BUILTIN(Equal, STD, NULL, "Equal")
MS_BUILTIN(Data, STD, NULL, "Data")
MS_BUILTIN(Clonable, STD, NULL, "Clonable")
MS_BUILTIN(Iterator, STD, NULL, "Iterator")
MS_BUILTIN(BytesBuilder, STD, NULL, "BytesBuilder")
MS_BUILTIN(Regex, STD, NULL, "Regex")
MS_BUILTIN(TypeSet, MARKER, NULL, "TypeSet")
MS_BUILTIN(SelfType, MARKER, NULL, "Self")
MS_BUILTIN(Int, PRIMITIVE, NULL, "Int")
MS_BUILTIN(Int8, PRIMITIVE, NULL, "Int8")
MS_BUILTIN(Int16, PRIMITIVE, NULL, "Int16")
MS_BUILTIN(Int32, PRIMITIVE, NULL, "Int32")
MS_BUILTIN(Int64, PRIMITIVE, NULL, "Int64")
MS_BUILTIN(UInt8, PRIMITIVE, NULL, "UInt8")
MS_BUILTIN(UInt16, PRIMITIVE, NULL, "UInt16")
MS_BUILTIN(UInt32, PRIMITIVE, NULL, "UInt32")
MS_BUILTIN(UInt64, PRIMITIVE, NULL, "UInt64")
MS_BUILTIN(Float, PRIMITIVE, NULL, "Float")
MS_BUILTIN(Float32, PRIMITIVE, NULL, "Float32")
MS_BUILTIN(Float64, PRIMITIVE, NULL, "Float64")
MS_BUILTIN(Bool, PRIMITIVE, NULL, "Bool")
MS_BUILTIN(String, PRIMITIVE, NULL, "String")
MS_BUILTIN(Void, PRIMITIVE, NULL, "Void")
MS_BUILTIN(Never, PRIMITIVE, NULL, "Never")
MS_BUILTIN(Timestamp, SOURCE, "@std/time.ms", "Timestamp")
MS_BUILTIN(Instant, SOURCE, "@std/time.ms", "Instant")
MS_BUILTIN(Duration, SOURCE, "@std/time.ms", "Duration")
MS_BUILTIN(Url, SOURCE, "@std/net/url.ms", "Url")
MS_BUILTIN(IpAddress, SOURCE, "@std/net/ip.ms", "IpAddress")
MS_BUILTIN(Cidr, SOURCE, "@std/net/ip.ms", "Cidr")
MS_BUILTIN(JsonValue, SOURCE, "@std/data/json.ms", "JsonValue")
MS_BUILTIN(JsonEncode, SOURCE, "@std/data/json.ms", "JsonEncode")
MS_BUILTIN(Promise, SOURCE, "@std/concurrency/promise.ms", "Promise")
MS_BUILTIN(TaskGroup, SOURCE, "@std/concurrency/tasks.ms", "TaskGroup")
MS_BUILTIN(TestHooks, SOURCE, "@std/test/test.ms", "TestHooks")
