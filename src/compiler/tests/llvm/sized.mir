module "t"
file 0 "t.ms"
type P { a: int8, b: uint16, f: float32, ok: bool }
entry @msmain

fn @msmain() -> int {
b0:
  %slot: ptr = slot P
  %a: int8 = iconst -3
  %b: uint16 = iconst 300
  %f: float32 = fconst 1.5
  %t: bool = bconst true
  %p: P = type.new P %a, %b, %f, %t
  store %slot, %p
  %q: P = load P %slot
  %qa: int8 = type.get P.a %q
  %qb: uint16 = type.get P.b %q
  %ok: bool = type.get P.ok %q
  %n: int = b2i %ok
  %x: int = iadd %qa, %qb
  %r: int = iadd %x, %n
  %s: int = iconst 5
  %sh: int = shl %r, %s
  ret %sh
}
