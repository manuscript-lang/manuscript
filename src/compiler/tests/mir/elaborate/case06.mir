module "raw"
close @close
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @lp(%0: int) -> int {
b0:
  %1: int = iconst 0
  scope.begin 1 0
  %2: list<int> = call @mk (%1)
  scope.own 1 1 %2
  br b1(%1)
b1(%3: int):
  %4: int = iconst 3
  %5: bool = icmp.lt %3, %4
  br_if %5, b2(), b5()
b2():
  scope.begin 2 2
  %6: list<int> = call @mk (%1)
  scope.own 2 1 %6
  %7: bool = icmp.eq %3, %0
  br_if %7, b3(), b4()
b3():
  scope.end 2 0
  br b5()
b4():
  scope.end 2 0
  %8: int = iconst 1
  %9: int = iadd %3, %8
  br b1(%9)
b5():
  %10: int = iconst 9
  scope.end 1 0
  ret %10
}

fn @main() -> int {
b0:
  %0: int = iconst 0
  %1: int = call @lp (%0)
  ret %1
}
