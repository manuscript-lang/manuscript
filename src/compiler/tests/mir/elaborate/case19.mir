module "raw"
close @close
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @g(%0: int) -> int {
b0:
  %1: int = iconst 0
  %2: int = iconst 1
  scope.begin 1 0
  %3: list<int> = call @mk (%0)
  scope.own 1 1 %3
  %4: bool = icmp.eq %0, %1
  br_if %4, b1(), b2()
b1():
  %5: list<int> = list.push %3, %2
  drop %5
  %6: int = iconst 10
  scope.end 1 0
  ret %6
b2():
  %7: int = iconst 20
  scope.end 1 0
  ret %7
}

fn @main() -> int {
b0:
  %0: int = iconst 5
  %1: int = call @g (%0)
  ret %1
}
