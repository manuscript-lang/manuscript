module "raw"
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @h() -> int {
b0:
  %0: int = iconst 4
  scope.begin 1 0
  %1: list<int> = call @mk (%0)
  scope.own 1 0 %1
  %2: int = iconst 0
  %3: int = list.get %1, %2
  scope.disown %1
  drop %1
  scope.end 1 0
  ret %3
}

fn @main() -> int {
b0:
  %0: int = call @h ()
  ret %0
}
