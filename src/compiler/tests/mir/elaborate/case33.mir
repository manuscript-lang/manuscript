module "raw"
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @h(%0: int) -> int {
b0:
  %1: int = iconst 0
  scope.begin 1 0
  %2: list<int> = call @mk (%0)
  scope.own 1 0 %2
  %3: bool = icmp.eq %0, %1
  br_if %3, b1(), b2()
b1():
  scope.disown %2
  scope.begin 2 2
  scope.own 2 0 %2
  drop %2
  scope.end 2 0
  br b3()
b2():
  br b3()
b3():
  %4: int = iconst 10
  scope.end 1 0
  ret %4
}

fn @main() -> int {
b0:
  %0: int = iconst 5
  %1: int = call @h (%0)
  ret %1
}
