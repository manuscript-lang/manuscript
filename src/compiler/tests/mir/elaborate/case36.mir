module "raw"
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @main() -> int {
b0:
  %0: int = iconst 0
  %1: list<int> = call @mk (%0)
  br b1(%0, %1)
b1(%2: int, %3: move list<int>):
  %4: int = iconst 2
  %5: bool = icmp.lt %2, %4
  br_if %5, b2(), b4()
b2():
  %6: int = iconst 7
  %7: list<int> = call @mk (%6)
  scope.begin 0 0
  scope.own 0 0 %7
  scope.disown %7
  drop %3
  scope.end 0 0
  br b3()
b3():
  %8: int = iconst 1
  %9: int = iadd %2, %8
  br b1(%9, %7)
b4():
  drop %3
  %10: int = iconst 0
  ret %10
}
