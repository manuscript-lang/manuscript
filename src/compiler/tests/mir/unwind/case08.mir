module "t"
entry @main
extern @msrt_promise_start(int) -> int spawns_task
extern @msrt_task_sleep(int) -> int
extern @msrt_string_eq(str, str) -> bool string_eq

fn @main() -> int {
b0:
  %zero: int = iconst 0
  br b1(%zero)
b1(%i: int):
  %ten: int = iconst 10
  %more: bool = icmp.lt %i, %ten
  br_if %more, b2(), b3()
b2():
  %s: str = str "held"
  %t: str = clone %s
  %one: int = iconst 1
  %next: int = iadd.chk %i, %one
  drop %t
  br b1(%next)
b3():
  ret %i
}
