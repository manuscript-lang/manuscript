module "t"
entry @main
extern @msrt_promise_start(int) -> int spawns_task
extern @msrt_task_sleep(int) -> int
extern @msrt_string_eq(str, str) -> bool string_eq

type Src { items: list<int>, label: str }

fn @next(%slot: ptr) -> int {
b0:
  %s: Src = take Src %slot
  %l: list<int> = type.get Src.items %s
  %m: list<int> = move.out %l
  %f: Src = type.fill Src.items %s, %m
  %n: int = iconst 5
  %r: int = call.rt @msrt_task_sleep (%n)
  put %slot, %f
  ret %r
}

fn @main() -> int {
b0:
  %z: int = iconst 0
  ret %z
}
