module "t"
entry @main
extern @msrt_promise_start(int) -> int spawns_task
extern @msrt_task_sleep(int) -> int
extern @msrt_string_eq(str, str) -> bool string_eq

fn @walk(%n: int, %s: move str) -> int {
b0:
  %z: int = iconst 0
  %done: bool = icmp.eq %n, %z
  br_if %done, b1(), b2()
b1():
  drop %s
  ret %z
b2():
  %one: int = iconst 1
  %m: int = isub %n, %one
  %r: int = call @walk (%m, %s)
  %t: int = call.rt @msrt_task_sleep (%r)
  ret %t
}

fn @main() -> int {
b0:
  %h: str = str "held"
  %s: str = clone %h
  %n: int = iconst 3
  %r: int = call @walk (%n, %s)
  ret %r
}
