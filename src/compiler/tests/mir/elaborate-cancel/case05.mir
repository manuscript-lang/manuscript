module "t"
extern @msrt_promise_start(int) -> int spawns_task
extern @msrt_task_pause(int) -> int
entry @main

fn @main() -> int {
b0:
  scope.begin 1 0
  %0: str = str "held"
  %1: str = clone %0
  %2: ptr = slot str
  put %2, %1
  %3: str = take str %2
  %4: int = iconst 5
  %5: int = call.rt @msrt_task_pause (%4)
  drop %3
  scope.end 1 0
  ret %5
}
