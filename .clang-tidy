# Checks for the C runtime and compiler (documentation/contributing/c-style.md). Run with `make c-lint`.
# A check is switched off here only with the reason beside it.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  concurrency-mt-unsafe,
  android-cloexec-*,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -cert-err33-c,
  -cert-dcl37-c,
  -cert-dcl51-cpp,
  -bugprone-easily-swappable-parameters,
  -bugprone-multi-level-implicit-pointer-conversion,
  -bugprone-suspicious-include,
  -misc-no-recursion,
  -misc-include-cleaner,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-braces-around-statements,
  -readability-isolate-declaration,
  -readability-uppercase-literal-suffix
# Reasons, in order: Annex K (memcpy_s) does not exist on our targets, sizes are checked with ms_rt/safe.h instead;
# an ignored fprintf result is not a bug, and our own fallible functions carry MS_NODISCARD;
# the two cert-dcl checks repeat bugprone-reserved-identifier without its list of feature-test macros;
# two size_t parameters are normal for (pointer, length) ABI calls; allocation helpers take void **;
# generated tables are .inc files; the parser and tree walkers recurse by design, with a depth limit;
# freestanding sources use compiler builtins that have no header; constants are named where they carry meaning,
# not by rule; short names are fine in short scopes; complexity is reviewed, not counted; one-line early
# returns stay unbraced; `a, b` declarations of one type are allowed; lowercase suffixes are allowed.
WarningsAsErrors: '*'
HeaderFilterRegex: '(src/runtime/(include|core|sys|io|net|std)|src/compiler/(include|src))/'
CheckOptions:
  - key: bugprone-reserved-identifier.AllowedIdentifiers
    value: '_GNU_SOURCE;_DEFAULT_SOURCE;_POSIX_C_SOURCE;_XOPEN_SOURCE;_DARWIN_C_SOURCE'
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.UnionCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefIgnoredRegexp
    value: '.*_t$'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(__|LLVMFuzzer).*'
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionIgnoredRegexp
    value: '^_.*'
  - key: readability-function-size.LineThreshold
    value: '80'
  - key: readability-function-size.StatementThreshold
    value: '-1'
