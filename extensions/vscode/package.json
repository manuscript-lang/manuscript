{
  "name": "manuscript",
  "displayName": "Manuscript",
  "description": "Manuscript diagnostics, formatting, symbols and language intelligence",
  "version": "0.1.0",
  "publisher": "manuscript-lang",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/manuscript-lang/manuscript#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/manuscript-lang/manuscript",
    "directory": "extensions/vscode"
  },
  "bugs": {
    "url": "https://github.com/manuscript-lang/manuscript/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "main": "./dist/extension.js",
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:manuscript"
  ],
  "contributes": {
    "languages": [
      {
        "id": "manuscript",
        "aliases": [
          "Manuscript"
        ],
        "extensions": [
          ".ms"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "manuscript",
        "scopeName": "source.manuscript",
        "path": "./syntaxes/manuscript.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Manuscript",
      "properties": {
        "manuscript.serverPath": {
          "type": "string",
          "default": "ms",
          "description": "Path to the Manuscript compiler and language server."
        }
      }
    },
    "commands": [
      {
        "command": "manuscript.profile",
        "title": "Manuscript: Capture sampling profile"
      },
      {
        "command": "manuscript.restartServer",
        "title": "Manuscript: Restart language server"
      }
    ],
    "taskDefinitions": [
      {
        "type": "manuscript",
        "required": [
          "command",
          "project"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "project": {
            "type": "string"
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "manuscript",
        "owner": "manuscript",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (?:parse|resolution|type|lowering|MSL\\d+): (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "configurationDefaults": {
      "[manuscript]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.inlayHints.enabled": "off",
        "editor.defaultFormatter": "manuscript-lang.manuscript"
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && npm test",
    "package": "vsce package --no-dependencies",
    "bundle": "esbuild extension.js --bundle --platform=node --external:vscode --outdir=dist --minify",
    "vscode:prepublish": "npm run check && npm run bundle",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.0"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The configured compiler executable runs locally."
    },
    "virtualWorkspaces": false
  }
}
