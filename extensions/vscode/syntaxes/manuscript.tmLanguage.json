{
  "scopeName": "source.manuscript",
  "patterns": [
    {
      "name": "comment.line.number-sign.manuscript",
      "match": "#.*$"
    },
    {
      "include": "#fstring"
    },
    {
      "include": "#string"
    },
    {
      "match": "^\\s*(from)\\b[^#\"\\n]*?\\b(import)\\b|^\\s*(from)\\s+(?=\")|\\b(with)\\b[^#\\n]*?\\b(as)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.manuscript"
        },
        "2": {
          "name": "keyword.control.manuscript"
        },
        "3": {
          "name": "keyword.control.manuscript"
        },
        "4": {
          "name": "keyword.control.manuscript"
        },
        "5": {
          "name": "keyword.control.manuscript"
        }
      }
    },
    {
      "name": "keyword.control.manuscript",
      "match": "\\b(def|lambda|type|interface|impl|import|from|as|export|extern|ref|let|var|if|elif|else|for|in|while|match|case|return|with|try|break|continue|test|fixture|and|or|not|self)\\b"
    },
    {
      "name": "constant.language.manuscript",
      "match": "\\b(True|False)\\b"
    },
    {
      "name": "constant.numeric.manuscript",
      "match": "\\b[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?d?\\b"
    },
    {
      "name": "entity.name.type.manuscript",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "name": "entity.name.function.manuscript",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\s*(?:\\[[^\\]\\n]*\\])?\\s*\\()"
    }
  ],
  "repository": {
    "fstring": {
      "name": "string.quoted.double.fstring.manuscript",
      "begin": "\\bf\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.manuscript",
          "match": "\\\\(?:u\\{[0-9A-Fa-f]{1,6}\\}|[\"\\\\nrt{}])"
        },
        {
          "name": "meta.interpolation.manuscript",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.manuscript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.manuscript"
            }
          },
          "patterns": [
            {
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "string": {
      "name": "string.quoted.double.manuscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.manuscript",
          "match": "\\\\(?:u\\{[0-9A-Fa-f]{1,6}\\}|[\"\\\\nrt])"
        }
      ]
    }
  }
}
