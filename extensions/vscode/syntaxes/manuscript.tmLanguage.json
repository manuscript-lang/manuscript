{
  "scopeName": "source.manuscript",
  "patterns": [
    {
      "name": "comment.line.number-sign.manuscript",
      "match": "#.*$"
    },
    {
      "include": "#string"
    },
    {
      "name": "keyword.control.manuscript",
      "match": "\\bfrom\\b(?=[ \\t]*\")"
    },
    {
      "match": "\\b(fn)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.manuscript"
        },
        "2": {
          "name": "entity.name.function.manuscript"
        }
      }
    },
    {
      "match": "\\b(type|interface)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": {
          "name": "keyword.control.manuscript"
        },
        "2": {
          "name": "entity.name.type.manuscript"
        }
      }
    },
    {
      "name": "keyword.control.manuscript",
      "match": "^bench(?=\\s+\")"
    },
    {
      "name": "keyword.control.manuscript",
      "match": "\\bopaque(?=[ \\t]+type\\b)"
    },
    {
      "name": "keyword.control.manuscript",
      "match": "\\b(fn|type|interface|impl|import|export|extern|ref|let|var|if|else|for|in|while|match|case|return|try|break|continue|test|fixture|and|or|not|self)\\b"
    },
    {
      "name": "constant.language.manuscript",
      "match": "\\b(true|false|unit)\\b"
    },
    {
      "name": "constant.numeric.manuscript",
      "match": "\\b(?:0x[0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0b[01](?:_?[01])*|(?:0|[1-9](?:_?[0-9])*)(?:\\.[0-9](?:_?[0-9])*)?(?:[eE][+-]?[0-9]+)?d?)\\b"
    },
    {
      "name": "entity.name.type.manuscript",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    {
      "name": "entity.name.function.manuscript",
      "match": "\\b[a-z_][A-Za-z0-9_]*(?=[ \\t]*(?:\\[[A-Za-z0-9_.,?\\[\\] \\t]+\\])?[ \\t]*\\()"
    },
    {
      "name": "constant.language.placeholder.manuscript",
      "match": "\\b_\\b"
    },
    {
      "name": "keyword.operator.manuscript",
      "match": "\\.\\.\\.|\\.\\.|->|==|!=|<=|>=|[+*/%=-]=?|[<>&|?]"
    },
    {
      "name": "punctuation.manuscript",
      "match": "[()\\[\\]{}:,.]"
    }
  ],
  "repository": {
    "string": {
      "name": "string.quoted.double.manuscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.manuscript",
          "match": "\\\\(?:u\\{[0-9A-Fa-f]{1,6}\\}|[\"\\\\nrt{}])"
        },
        {
          "name": "meta.interpolation.manuscript",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.begin.manuscript"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.section.interpolation.end.manuscript"
            }
          },
          "patterns": [
            {
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    }
  }
}
