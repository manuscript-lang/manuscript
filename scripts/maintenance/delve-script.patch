+	conn := &gdbConn{conn: local, rdr: bufio.NewReader(local), inbuf: make([]byte, 2), log: logflags.GdbWireLogger(), direction: proc.Forward, goos: "darwin"}
+	conn.session = &scriptSessionControl{conn: local}
+	return conn, remote
+}
