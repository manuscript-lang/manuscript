module "lastuse"
entry @main
type P { a: str, b: str }
fn @straight() -> int {
b0:
  %0: str = str "ab"
  %1: str = clone %0
  %2: int = str.len %1
  %3: int = iadd %2, %2
  %4: int = iadd %3, %2
  drop %1
  ret %4
}
fn @loop(%0: int) -> int {
b0:
  %1: str = str "xyz"
  %2: str = clone %1
  %3: int = iconst 0
  br b1(%3)
b1(%4: int):
  %5: int = str.len %2
  %6: int = iadd %4, %5
  %7: bool = icmp lt %6, %0
  condbr %7, b1(%6), b2(%6)
b2(%8: int):
  %9: int = iadd %8, %8
  drop %2
  ret %9
}
fn @branch(%0: bool) -> int {
b0:
  %1: str = str "q"
  %2: str = clone %1
  condbr %0, b1, b2
b1:
  %3: int = str.len %2
  %4: int = iadd %3, %3
  drop %2
  ret %4
b2:
  %5: int = iconst 7
  %6: int = iadd %5, %5
  drop %2
  ret %6
}
fn @field() -> int {
b0:
  %0: str = str "x"
  %1: str = str "yy"
  %2: str = clone %0
  %3: str = clone %1
  %4: P = type.new P %2, %3
  %5: str = type.get P.a %4
  %6: int = str.len %5
  %7: int = iadd %6, %6
  %8: int = iadd %7, %6
  drop %4
  ret %8
}
fn @main() -> int {
b0:
  %0: int = call @straight ()
  %1: int = iconst 3
  %2: int = call @loop (%1)
  %3: bool = bconst true
  %4: int = call @branch (%3)
  %5: int = call @field ()
  %6: int = iadd %0, %2
  %7: int = iadd %4, %5
  %8: int = iadd %6, %7
  ret %8
}
