module "copyelim"
entry @main
type P { a: str, b: str }
fn @take(%0: P) -> int {
b0:
  %1: str = type.get P.a %0
  %2: str = clone %1
  %3: int = str.len %2
  drop %2
  %4: str = type.get P.b %0
  %5: int = str.len %4
  %6: int = iadd %3, %5
  ret %6
}
fn @main() -> int {
b0:
  %0: str = str "x"
  %1: str = str "yy"
  %2: str = clone %0
  %3: str = clone %1
  %4: P = type.new P %2, %3
  %5: str = type.get P.a %4
  %6: str = clone %5
  drop %4
  %7: int = str.len %6
  drop %6
  %8: str = clone %0
  %9: opt<str> = opt.some %8
  %10: str = opt.get %9
  %11: str = clone %10
  drop %9
  %12: int = str.len %11
  drop %11
  %13: str = clone %0
  %14: str = clone %13
  drop %13
  %15: int = str.len %14
  drop %14
  %16: int = iadd %7, %12
  ret %16
}
