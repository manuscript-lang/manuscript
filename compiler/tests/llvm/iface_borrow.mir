module "iface_borrow"
extern @msrt_alloc(int) -> ptr
extern @msrt_free(ptr)
iface Area { area(int) -> int }
vtable @v_int: Area for int { @area_int }
entry @msmain
fn @area_int(%self: ptr, %k: int) -> int method {
b0:
  %n: int = load int %self
  %r: int = iadd %n, %k
  ret %r
}
fn @msmain() -> int {
b0:
  %i: int = iconst 20
  %k: int = iconst 22
  %s: dyn Area = iface.borrow @v_int %i
  %a: int = call.method Area.area (%s, %k)
  %tg: int = iface.tag %s
  %r: int = iadd %a, %tg
  ret %r
}
