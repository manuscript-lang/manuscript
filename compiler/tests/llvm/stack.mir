module "stack"
extern @msrt_test_cancel()
entry @msmain
fn @msmain() -> int {
b0:
  %low: bool = stack.low
  %near: bool = stack.near 100
  %huge: bool = stack.near 100000000
  poll
  %u: int = undef
  br_if %low, b3(), b1(%huge)
b1(%h: bool):
  br_if %near, b3(), b2(%h)
b2(%h2: bool):
  br_if %h2, b4(), b3()
b3:
  %bad: int = iconst 99
  ret %bad
b4:
  %c: void = call.rt @msrt_test_cancel ()
  poll
  %ok: int = iconst 1
  ret %ok
}
