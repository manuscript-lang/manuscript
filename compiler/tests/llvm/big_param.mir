module "big_param"
type T { a: int, b: int, c: int }
entry @msmain
fn @rot(%t: T, %k: int) -> T {
b0:
  %a: int = type.get T.a %t
  %b: int = type.get T.b %t
  %c: int = type.get T.c %t
  %ka: int = iadd %a, %k
  %r: T = type.new T %b, %c, %ka
  ret %r
}
fn @msmain() -> int {
b0:
  %a: int = iconst 1
  %b: int = iconst 2
  %c: int = iconst 3
  %k: int = iconst 10
  %t: T = type.new T %a, %b, %c
  %u: T = call @rot(%t, %k)
  %x: int = type.get T.a %u
  %y: int = type.get T.c %u
  %s: int = imul %x, %y
  ret %s
}
