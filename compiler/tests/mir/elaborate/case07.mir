module "raw"
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @main() -> int {
b0:
  %0: int = iconst 7
  %1: list<int> = call @mk (%0)
  scope.begin 0 0
  scope.own 0 0 %1
  %2: int = iconst 0
  %3: int = iconst 0
  %4: bool = icmp.eq %2, %3
  br_if %4, b1(), b2()
b1():
  scope.disown %1
  %5: int = call @close (%1)
  %6: bool = icmp.eq %5, %0
  br_if %6, b3(), b4()
b2():
  %7: int = list.len %1
  br b4()
b3():
  scope.end 0 0
  ret %5
b4():
  scope.end 0 0
  %8: int = iconst 0
  ret %8
}
