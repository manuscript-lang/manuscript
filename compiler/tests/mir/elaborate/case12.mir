module "raw"
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @shut(%0: ptr) -> void {
b0:
  %1: list<int> = load list<int> %0
  %2: int = iconst 0
  %3: int = list.get %1, %2
  %4: void = call.rt @msrt_print_int (%3)
  ret %4
}

fn @main() -> int {
b0:
  scope.begin 1 0
  %0: int = iconst 7
  %1: list<int> = call @mk (%0)
  %2: ptr = slot list<int>
  put %2, %1
  scope.own 1 4 %2
  %3: int = iconst 0
  %4: int = iconst 1
  %5: bool = icmp.eq %3, %4
  br_if %5, b1(), b2()
b1():
  %6: void = call @shut (%2)
  scope.mark 1 %2
  br b3()
b2():
  br b3()
b3():
  scope.end 1 0
  %7: int = iconst 0
  ret %7
}
