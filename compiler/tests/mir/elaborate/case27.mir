module "raw"
alt Msg { Pair(a: list<int>, b: list<int>), Empty }
extern @msrt_print_int(int) -> void
entry @main

fn @mk(%0: int) -> list<int> {
b0:
  %1: int = iconst 0
  %2: list<int> = list.new %1
  %3: list<int> = list.push %2, %0
  ret %3
}

fn @close(%0: move list<int>) -> int {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  drop %0
  ret %2
}

fn @shut(%0: list<int>) -> void {
b0:
  %1: int = iconst 0
  %2: int = list.get %0, %1
  %3: void = call.rt @msrt_print_int (%2)
  ret %3
}

fn @sink(%0: move list<int>) -> void {
b0:
  drop %0
  %1: void = void
  ret %1
}

fn @main() -> int {
b0:
  scope.begin 1 0
  %0: int = iconst 7
  %1: list<int> = call @mk (%0)
  scope.own 1 4 %1
  %2: bool = bconst false
  br_if %2, b1(), b2()
b1():
  br b3()
b2():
  %3: void = call @sink (%1)
  br b3()
b3():
  scope.end 1 0
  %4: int = iconst 0
  ret %4
}
