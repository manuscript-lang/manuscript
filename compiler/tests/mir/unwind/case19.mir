module "t"
entry @main
extern @msrt_promise_start(int) -> int spawns_task
extern @msrt_task_sleep(int) -> int
extern @msrt_string_eq(str, str) -> bool string_eq

fn @hold(%slot: ptr) -> int {
b0:
  %s: str = take str %slot
  %lit: str = str "x"
  %other: str = clone %lit
  %local: ptr = slot str
  put %local, %other
  put %local, %s
  %n: int = iconst 5
  %r: int = call.rt @msrt_task_sleep (%n)
  %back: str = take str %local
  put %slot, %back
  ret %r
}

fn @main() -> int {
b0:
  %s: str = str "held"
  %t: str = clone %s
  %slot: ptr = slot str
  put %slot, %t
  %r: int = call @hold (%slot)
  %back: str = take str %slot
  drop %back
  ret %r
}
