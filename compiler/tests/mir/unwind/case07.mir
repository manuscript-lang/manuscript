module "t"
entry @main
extern @msrt_promise_start(int) -> int spawns_task
extern @msrt_task_sleep(int) -> int
extern @msrt_string_eq(str, str) -> bool string_eq

fn @close(%s: str) -> void {
b0:
  %u: void = void
  ret %u
}

fn @main() -> int {
b0:
  %s: str = str "held"
  %t: str = clone %s
  %w: str = str "with"
  %v: str = clone %w
  %a: int = iconst 2
  %b: int = iadd.chk %a, %a
  %h: int = cleanup.push @close %v
  %c: int = iadd.chk %b, %a
  cleanup.run %h
  drop %v
  drop %t
  ret %c
}
