module "t"
entry @main
extern @msrt_promise_start(int) -> int spawns_task
extern @msrt_task_sleep(int) -> int
extern @msrt_string_eq(str, str) -> bool string_eq

type Src { items: list<int>, label: str }

fn @main() -> int {
b0:
  %e: list<int> = list.lit
  %l0: str = str "label"
  %l: str = clone %l0
  %s: Src = type.new Src %e, %l
  %f: list<int> = type.get Src.items %s
  %m: list<int> = move.out %f
  type.release Src.items %s
  %h: str = str "held"
  %h2: str = clone %h
  %n: int = iconst 5
  %r: int = call.rt @msrt_task_sleep (%n)
  drop %h2
  drop %m
  ret %r
}
