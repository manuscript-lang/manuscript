module "t"
file 0 "t.ms"
type P { x: int, y: int }
entry @msmain

fn @swap(%p: P) -> P {
b0:
  %x: int = type.get P.x %p
  %y: int = type.get P.y %p
  %q: P = type.new P %y, %x
  ret %q
}

fn @msmain() -> int {
b0:
  %a: int = iconst 3
  %b: int = iconst 4
  %p: P = type.new P %a, %b
  %s: P = call @swap(%p)
  %nine: int = iconst 9
  %t: P = type.set P.x %s, %nine
  %x: int = type.get P.x %t
  %y: int = type.get P.y %t
  %r: int = imul %x, %y
  ret %r
}
