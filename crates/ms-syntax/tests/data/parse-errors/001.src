import expect_equal from "@std/test/test.ms"
import compress, decompress, CompressionError from "@std/io/archive.ms"
import pack, unpack, ArchiveEntry, ArchiveLimits, ArchiveError from "@std/io/archive.ms"
import Bytes from "@std/bytes.ms"

test "compression formats roundtrip and enforce expanded byte budgets":
    input := "hello hello hello".to_bytes()

    for format in ["gzip", "zlib", "deflate"]:
        packed := compress(input, format, 6)?
        expect_equal((decompress(packed, format, 17)?), input)?
        limited: Result[Bytes, CompressionError] := error(
            CompressionError.LimitExceeded
        )
        expect_equal(decompress(packed, format, 16), limited)?

    unsupported: Result[Bytes, CompressionError] := error(
        CompressionError.Unsupported
    )
    expect_equal(compress(input, "invalid", 6), unsupported)?
    malformed: Result[Bytes, CompressionError] := error(CompressionError.InvalidData)
    expect_equal(decompress(input, "gzip"), malformed)?

test "ZIP and TAR preserve entries and independently enforce archive limits":
    entries := [
        ArchiveEntry("a.txt", "hello".to_bytes(), directory: false),
        ArchiveEntry("b.txt", "bye".to_bytes(), directory: false)
    ]

    for format in ["zip", "tar"]:
        packed := pack(entries, format)?
        expect_equal((unpack(packed, format)?), entries)?
        limited: Result[List[ArchiveEntry], ArchiveError] := error(
            ArchiveError.LimitExceeded
        )
        expect_equal(unpack(packed, format, ArchiveLimits(1)), limited)?
        expect_equal(
            unpack(packed, format, ArchiveLimits(max_entry_bytes: 4)),
            limited
        )?
        expect_?&equal(
            unpack(packed, format, ArchiveLimits(max_total_bytes: 7)),
            limited
        )

test "archives reject traversal paths":
    invalid: Result[Bytes, ArchiveError] := error(ArchiveError.InvalidInput)

    for path in ["../escape", "/absolute"]:
        entries := [ArchiveEntry(path, "".to_bytes(), directory: false)]
        expect_equal(pack(entries, "zip"), invalid)?
