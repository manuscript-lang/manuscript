import ListBuilder from "@std/collections/collections.ms"
import Read from "./contracts.ms"

export interface Original:
    fn original() Int

export type Item:
    value: Int

fn Item.original() Int:

return self.value

export type Box[T]:
    value: T

export type Holder[T: Read[Int]]:
    value: T

fn Holder[T].get() Int:
    return self.value.get()

export enum Choice:
    Some(value: Int)
    Empty

export type Resource:
    events: ListBuilder[Int]
