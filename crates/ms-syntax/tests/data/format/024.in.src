from "@std/core.ms" import TextError
from "@std/io.ms" import stdout, stdin, read_line, ReadStream
from "@std/time.ms" import clock, Instant
from "@std/string.ms" import StringBuilder

interface Counter:
    def bump(by: Int) -> Int

type Acc:
    total: Int

impl Counter for Acc:
    def bump(by: Int) -> Int:
        self.total += by
        