def helper(left: Int, right: Int) -> Int:
    return left + right

export def defaults(
    first: Int = -3,
    second: Int = helper(left: first, right: 2),
    text: String = "literal, )",
    callback: Callable[[Int], Int] = (
        lambda (value: Int) -> Int:
            return value + 1
    )
) -> Int:
    return callback(second)

def answer(
    value: Int = (
        lambda () -> Int:
            var current = 0
            current = current + 1
            return current
    )()
) -> Int:
    return value
