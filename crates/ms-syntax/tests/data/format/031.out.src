import (
	Bytes from "@std/bytes.ms",
	IoError, ReadStream from "@std/io/io.ms",
	Connection,
	DatagramSocket,
	DnsRecord,
	Listener,
	NetworkError,
	TlsOptions,
	WebSocket,
	WebSocketError,
	WebSocketOptions from "@std/net/net.ms",
	Duration from "@std/time.ms",
)

// Errors returned for invalid requests, transport failures, timeouts, and limits.
export enum HttpError:
	// The URL is not an `http` or `https` URL with a host, valid port, and no user
	// info; a method, header name, or value is malformed or host-managed; or a limit or
	// timeout is negative.
	InvalidInput
	// The response headers are not valid UTF-8, so they cannot become Strings.
	InvalidData
	// A buffered response body is larger than `max_response_bytes`.
	LimitExceeded
	// The network's restrictions disallow the host, a resolved address, or a redirect
	// destination.
	PermissionDenied
	// The client or network was closed before or during the request.
	Closed
	// The request timeout elapsed before the response completed.
	Timeout
	// Transport, TLS,
