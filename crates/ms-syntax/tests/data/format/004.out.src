import (
	stdout from "@std/io/io.ms",
	HttpRequest, HttpResponse, headers from "@std/net/http.ms",
	network from "@std/net/net.ms",
)

fn handle(request: HttpRequest) HttpResponse:
	return HttpResponse(200, headers(), "hello \{request.path\}".to_bytes())

export fn main() Int:
	serve := network().serve

	if acquired := serve(
		address: "127.0.0.1:0",
		handler: handle,
		max_requests: 2,
		max_body_bytes: 1024,
		max_response_bytes: 1024,
		timeout: 2.seconds,
		grace: 0.seconds,
	):
		server := acquired
		if stdout().write("{server.address()}\n").is_error(): return 1

		_ignored := server.wait()
		return 0

	return 1
