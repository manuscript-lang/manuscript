from "@std/test.ms" import expect_true

interface Shape:
    def area(scale: Int) -> Int

type Sq:
    side: Int

type Rect:
    w: Int
    h: Int

type Tri:
    b: Int
    h: Int

impl Shape for Sq:
    def area(scale: Int) -> Int: self.side * self.side * scale

impl Shape for Rect:
    def area(scale: Int) -> Int: self.w * self.h * scale

impl Shape for Tri:
    def area(scale: Int) -> Int: self.b * self.h * scale / 2

def measure(shape: Shape, scale: Int) -> Int: shape.area(scale: scale)

test "three receiver types alternate at one site":
    let shapes: List[Shape] = [
        Shape(value: Sq(side: 3)), Shape(value: Rect(w: 2, h: 5)),
        Shape(value: Tri(b: 4, h: 5))
    ]
    var total = 0
    var round = 0

    while round < 4:
        var i = 0

        while i < 3:
            total = total + measure(shape: shapes[i], scale: 2)
            i = i + 1

        round = round + 1

    try expect_true((total == 4 * (18 + 20 + 20)))
