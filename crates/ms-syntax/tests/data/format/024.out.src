import (
	TextError from "@std/core.ms",
	stdout, stdin, read_line, ReadStream from "@std/io/io.ms",
	clock, Instant from "@std/time.ms",
	StringBuilder from "@std/string.ms",
)

interface Counter:
	fn bump(by: Int) Int

type Acc:
	total: Int

impl Counter for Acc:
	fn bump(by: Int) Int:
		self.total += by
