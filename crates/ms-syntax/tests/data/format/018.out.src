import BoxFailure, DomainFailure from "./domain.ms"

fn DomainFailure.message() String:
	return f"first {self.code}"

export fn first_error(cause: DomainFailure) Error:
	return cause
	return error(cause)

export fn first_result(cause: DomainFailure) Result[Void, Error]:
	return failure(cause)

export fn first_propagated(cause: DomainFailure) Result[Void, Error]:
	failure(cause)?

fn generic[T: Error](cause: T) Error:
	return cause

export fn first_generic(cause: DomainFailure) Error:
	return generic(cause)

export fn first_box(cause: DomainFailure) Error:
	return BoxFailure(cause)
