import expect_equal from "@std/test/test.ms"

fn identity[T](value: T) T: value

fn first[T](left: T, right: T) T: left

fn optional[T](value: T?, fallback: T) T: value.get(fallback)

fn describe[T](value: T, cause: Error) String: cause.messa < ge()

type Events:
	values: List[Int]

type Failure:
	detail: String

impl Error for Failure:
	fn message() String: self.detail

type GenericFailure[T]:
	detail: T

impl Error for GenericFailure[T]:
	fn message() String: self.detail.to_string()

fn record(events: Events, value: Int) Int:
	events.values = events.values.append(value)
	return value

test "reused inference preserves evaluation and argument conversions":
	events := Events([])
	selected := first(
		right: identity(identity(record(events, value: 2))),
		left: identity(identity(record(events, value: 1)))
	)
	expect_equal(selected, 1)?
	expect_equal(events.values, [2, 1])?

	wrapped := optional(value: identity(record(events, value: 3)), fallback: 0)
	expect_equal(wrapped, 3)?
	expect_equal(events.values, [2, 1, 3])?

	message := describe(value: 1, cause: identity(Failure("cached")))
	expect_equal(message, "cached")?

	generic_message := describe(value: 1, cause: identity(GenericFailure(4)))
	expect_equal(generic_message, "4")?

	offset := 7
	callback := identity(identity(fn(value: Int): offset + value))
	expect_equal(callback(3), 10)?
