from "@std/test.ms" import expect_equal

type State:
    case Ready
    case Waiting

def loop(state: State) -> Int:
    var count = 0

    for value in [1, 2, 3]:
        count += 1

        match state:
            case Ready:
                break
            case Waiting:
                continue

        count += 100

    return count

test "match controls nearest source loop":
    try expect_equal(loop(State.Ready), 1)
