from "@std/collections.ms" import filled, range
from "@std/core.ms" import panic

def make_cells() -> List[Int]:
    if let values = filled(0, 16384): return values

    return panic("fill failure")

export def main() -> Int:
    var cells = make_cells()
    var next = make_cells()

    for i in range(0, 16384):
        var value = 0
        if (i * 17 + i / 128 * 13) % 7 < 3: value = 1
        cells.set(i, value)

    for generation in range(0, 50):
        for y in range(0, 128):
            for x in range(0, 128):
                var neighbors = 0

                for dy in range(-1, 2):
                    for dx in range(-1, 2):
                        if dx != 0 or dy != 0:
                            let index = (
                                (
                                    y
                                    + dy
                                    + 128
                                ) % 128 * 128
                                + (x + dx + 128) % 128
                            )
                            neighbors += cells.get(index)
                let index = y * 128 + x
                let alive = (
                    neighbors == 3
                    or (neighbors == 2 and cells.get(index) == 1)
                )
                var value = 0
                if alive: value = 1
                next.set(index, value)

        let old = cells
        cells = next
        next = old

    var sum = 0
    for i in range(0, 16384):
        sum += cells.get(i)
    if sum != 3914: return panic("life checksum")

    return 0
