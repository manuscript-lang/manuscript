from "./domain.ms" import Key
from "./helper.ms" import insert, insert_bound
from "@std/test.ms" import expect_equal

impl Equal for Key:
    def equals(other: Equal) -> Bool:
        match other:
            case Key(other): return (self.code == other.code or self.code == -other.code)
            case _: return False

impl Hashable for Key:
    def hash() -> Int: 0

export def first() -> Result[Int, Error]:
    let m = Map[Key, Int]()
    let original = Key(1.0)
    m.add(original, 1)
    insert(m, Key(-1.0), 2)
    insert_bound(m, Key(1.0), 3)
    let add = m.add
    add(4, 2.0)
    m.get(Key(1.0)).get() | try expect_equal(expected: 3)
    original.c
