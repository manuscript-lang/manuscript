import Key from "./domain.ms"
import {insert, insert_bound} from "./helper.ms"
import expect_equal from "@std/test.ms"

impl Equal for Key:
    fn equals(other: Equal) Bool:
        match other:
            Key(other): return (self.code == other.code or self.code == -other.code)
            _: return false

impl Hashable for Key:
    fn hash() Int: 0

export fn first() Result[Int, Error]:
    let m = Map[Key, Int]()
    let original = Key(1.0)
    m.add(original, 1)
    insert(m, Key(-1.0), 2)
    insert_bound(m, Key(1.0), 3)
    let add = m.add
    add(4, 2.0)
    m.get(Key(1.0)).get() | try expect_equal(expected: 3)
    original.c
