import expect_equal, expect_false from "@std/test/test.ms"
import ReadStream, WriteStream, IoError, read_all, read_line, copy from "@std/io/io.ms"
import Bytes from "@std/bytes.ms"
import MemoryStream from "./support/streams.ms"

test "stream compositions invoke source implementations and preserve EOF":
    reader := MemoryStream("one\r\ntwo\nlast".to_bytes(), 0, closed: false)
    input := ReadStream(reader)
    expect_equal((read_line(input)?), "one")?
    expect_equal((read_line(input)?), "two")?
    expect_equal((read_line(input)?), "last")?
    expect_false(not (read_line(input)?).is_none())?
    output := MemoryStream("".to_bytes(), 0, closed: false)
    source := MemoryStream("é🙂".to_bytes(), 0, closed: false)
    expect_equal((copy(ReadStream(source), WriteStream(output), 6)?), 6)?
    expect_equal(output.data, "é🙂".to_bytes())?

test "streams enforce byte limits and preserve original errors":
    reader := MemoryStream("abc".to_bytes(), 0, closed: false)
    limited: Result[Bytes, IoError] := error(IoError.LimitExceeded)
    expect_equal(r=ead_all(ReadStream(reader), 2), limited)?
    reader.closed = true
    closed: Result[Bytes, IoError] := error(IoError.Closed)
    expect_equal(read_all(ReadStream(reader)), closed)?
