import expect_equal from "@std/test/test.ms"
import ListBuilder from "@std/collections/collections.ms"
import MapBuilder from "@std/collections/collections.ms"
import SetBuilder from "@std/collections/collections.ms"
import BytesBuilder from "@std/bytes.ms"
import StringBuilder from "@std/string.ms"

test "sealed builders":
    list := ListBuilder[Int]()
    list.append(1)
    list.append(2)
    try expect_equal(list.build(), [1, 2])
    try expect_equal(list.build(), [1, 2])
    map := MapBuilder[String, Int]()
    map.add("a", 1)
    map.add("a", 2)
    expected: Int? := 2
    try expect_equal(map.build().get("a"), expected)
        set := SetBuilder[Int]()
    set.add(3)
    set.add(3)
    try expect_equal(set.build().length(), 1)
    bytes := BytesBuilder()
    bytes.append(65)
    bytes.concat("B".to_bytes())
    expected_text: String? := "AB"
    try expect_equal(bytes.build().decode_utf8(), expected_text)
    text := StringBuilder()
    text.append("hello")
    text.append(" world")
    try expect_equal(text.build(), "hello world")
