import expect_equal, expect_false from "@std/test/test.ms"

test "omitted none defaults":
    if v := "ab".repeat(count: 2):
       expect_equal(v, "abab")?
    else:
        expect_false(not (false))?

    if v := "ab".pad_start(target_length: 4, padding: "-"):
        expect_equal(v, "--ab")?
    else:
        expect_false(not (false))?
