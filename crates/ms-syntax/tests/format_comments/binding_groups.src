test "top":
    var (
// top-level bindings
        first = 1
            // A comment may be deeper than its neighbors.
        second = 2
    )

    var (
            // The first comment can be deeper than the binding.
        third = 3
    )

test "group":
    var (
// mutable bindings
        total = 0
            // Keep this explanation.
        count = 1
    )
    var (
// immutable bindings
        label = "café"
        // Keep the next binding attached.
        suffix = "!"
    )
