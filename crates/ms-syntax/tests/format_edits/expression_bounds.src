fn total(flag: Bool, a_very_long_identifier_that_will_make_the_line_exceed_its_available_width: Int) Int:
    return a_very_long_identifier_that_will_make_the_line_exceed_its_available_width + if flag: 1 else: 2

let initial = 1111111111111111111 + 2222222222222222222 + 3333333333333333333 + if true: 1 else: 2

fn test_condition(flag: Bool, a_very_long_identifier_that_will_make_the_line_exceed_its_available_width: Bool) Int:
    if a_very_long_identifier_that_will_make_the_line_exceed_its_available_width and if flag: true else: false: return 1
    return 0

fn run(flag: Bool, a_very_long_identifier_that_will_make_the_line_exceed_its_available_width: Int) Int:
    let value = a_very_long_identifier_that_will_make_the_line_exceed_its_available_width + if flag: 1 else: 2
    var other = 0
    other = a_very_long_identifier_that_will_make_the_line_exceed_its_available_width + if flag: 3 else: 4
    return value + other

fn choose(flag: Bool, other: Bool, a_very_long_identifier_that_will_make_the_line_exceed_its_available_width: Int) Int:
    return a_very_long_identifier_that_will_make_the_line_exceed_its_available_width + if flag: 1 else if other: 2 else: 3  # keep the complete conditional

fn match_value(flag: Bool, a_very_long_identifier_that_will_make_the_line_exceed_its_available_width: Int) Int:
    return a_very_long_identifier_that_will_make_the_line_exceed_its_available_width + match flag:
        true: 1
        false: 2
