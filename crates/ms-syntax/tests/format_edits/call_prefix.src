fn chain_1() Int:
    return x.m(1, 2, 3).next(4, 5, 6).last(7, 8, 9)

fn chain_72() Int:
    return xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.m(1, 2, 3).next(4, 5, 6).last(7, 8, 9)

fn chain_74() Int:
    return xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.m(1, 2, 3).next(4, 5, 6).last(7, 8, 9)

fn chain_75() Int:
    return xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.m(1, 2, 3).next(4, 5, 6).last(7, 8, 9)

fn chain_100() Int:
    return xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.m(1, 2, 3).next(4, 5, 6).last(7, 8, 9)

fn trivial_then_nested() Int:
    return seed.m(1).next(other(1, 2), [3, 4], 5).last(6, 7, 8)

fn unicode_arguments() Int:
    return seed.m("λ😀", 1, 2).next("δ", 3, 4).last(5, 6, 7)

fn clause_boundary() Int:
    if seed.m(1, 2, 3).next(4, 5, 6).last(7, 8, 9) > 0:
        return 1
    return 0
