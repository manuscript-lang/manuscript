fn grind(a: Float, b: Float, up: Bool) Float:
    var x = a
    var y = b
    if up:
        x = x + 1.0
    x = x * 1.0001 + 0.5
    y = y - x / 3.0
    x = x * 1.0001 + 1.5
    y = y - x / 3.0
