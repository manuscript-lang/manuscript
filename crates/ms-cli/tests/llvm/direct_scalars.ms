    return x + y

fn mix(a: Int, b: Int, up: Bool) Int:
    if up:
        return a + b * 3
    return a - b

fn main() Int:
    print(grind(2.0, 3.0, true))
    print(grind(5.0, 1.0, false))
    print(mix(5, 7, true) + mix(5, 7, false))
    return 0
