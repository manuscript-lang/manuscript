        x = x * 1.0003 + 37.75
        x = x * 1.0003 + 38.75
        x = x * 1.0003 + 39.75
    return x

fn mix(a: Int, b: Int, up: Bool) Int:
    if up:
        return a + b * 3
    return a - b

fn main() Int:
    print(grind(2.0, 3.0, true))
    print(grind(5.0, 1.0, false))
    print(wander(1.0, 100.0))
    print(wander(2.0, 50.0))
    print(grind_list([1, 2, 3], 2.0))
    print(total_floats([1.5, 2.5, 3.5], 2.0))
    print(mix(5, 7, true) + mix(5, 7, false))
    return 0
