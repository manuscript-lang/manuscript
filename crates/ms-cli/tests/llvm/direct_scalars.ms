    x = x * 1.0001 + 58.5
    y = y - x / 3.0
    x = x * 1.0001 + 59.5
    y = y - x / 3.0
    return x + y

fn wander(a: Float, steps: Float) Float:
    var x = a
    var n = 0.0
    while n < steps:
        x = x * 1.01 + n
        x = x - n / 1.5
        x = x - n / 2.5
        x = x - n / 3.5
        x = x - n / 4.5
        x = x - n / 5.5
        x = x - n / 6.5
        x = x - n / 7.5
        x = x - n / 8.5
        x = x - n / 9.5
        x = x - n / 10.5
        x = x - n / 11.5
        x = x - n / 12.5
        x = x - n / 13.5
        x = x - n / 14.5
        x = x - n / 15.5
        x = x - n / 16.5
        x = x - n / 17.5
        x = x - n / 18.5
        x = x - n / 19.5
        x = x - n / 20.5
        x = x - n / 21.5
        x = x - n / 22.5
        x = x - n / 23.5
        x = x - n / 24.5
        x = x - n / 25.5
        x = x - n / 26.5
        x = x - n / 27.5
        x = x - n / 28.5
        x = x - n / 29.5
        x = x - n / 30.5
        x = x - n / 31.5
        x = x - n / 32.5
        x = x - n / 33.5
        x = x - n / 34.5
        x = x - n / 35.5
        x = x - n / 36.5
        x = x - n / 37.5
        x = x - n / 38.5
        x = x - n / 39.5
        n = n + 1.0
    return x

