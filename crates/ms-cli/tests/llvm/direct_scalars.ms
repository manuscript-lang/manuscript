    if xs.length() > 2:
        x = x + 1.0
    return x

fn total_floats(xs: List[Float], a: Float) Float:
    var x = a
    for v in xs:
        x = x + v
        x = x * 1.0003 + 0.75
        x = x * 1.0003 + 1.75
        x = x * 1.0003 + 2.75
        x = x * 1.0003 + 3.75
        x = x * 1.0003 + 4.75
        x = x * 1.0003 + 5.75
