import Closeable from "@std/core.ms"
import Bytes from "@std/bytes.ms"
import promise, PromiseOptions from "@std/concurrency/promise.ms"
import stdout, WriteStream from "@std/io/io.ms"
import listen, Listener, Connection from "@std/net/net.ms"
import watch_signals from "@std/os/process.ms"
import Duration, sleep from "@std/time.ms"

fn flush_within(var out: WriteStream[Bytes], limit: Duration) Void!:
    return promise(fn: out.flush()).with(options: PromiseOptions(timeout: limit)).wait()

fn say(text: String) Void:
    _written := stdout().write(text)

    // Piped stdout is buffered until exit; flush so a parent sees each line when it is printed.
    _flushed := stdout().flush()

type WorkerCleanup:
    label: String

fn var WorkerCleanup.close() Void!:
    say(f"{self.label} stopped\n")
    return ok()

type Server:
    listener: Listener
    client: Connection
    closed: Bool = false

fn var Server.close() Void!:
    if self.closed:
        return ok()

    self.closed = true
    self.listener.close()?
    void sleep(10.milliseconds()).wait()

    var farewell = self.client.output.write("farewell\n".to_bytes())
    if farewell.is_ok():
        drained := flush_within(var self.client.output, 1.seconds())
        farewell = drained

    if farewell.is_error():
        say(f"farewell failed: {farewell.err().message}\n")
    else:
        say("farewell sent\n")

    self.client.close()?
    return ok()

fn serve() Result[Void, Error]:
    var signals = watch_signals([2, 15])?
    listener := listen("127.0.0.1:0")?
    say(f"{listener.address()}\n")

    client := listener.accept().wait()?
    _server := Server(listener: listener, client: client)
    _cleanup := WorkerCleanup(label: "worker")
    say("ready\n")

    _observed := signals.next()
    return ok()

export fn main() Int:
    served := serve()

    if served.is_error():
        say(f"{served.err().message}\n")
        return 1

    return 0
