module "block_window"
entry @main
fn @main() -> int {
b0:
  %a: int = iconst 1
  %b: int = iconst 2
  %c: int = iconst 3
  %d: int = iconst 4
  %e: int = iconst 5
  %f: int = iconst 6
  %g: int = iconst 7
  %z: int = iconst 0
  %l0: list<int> = list.lit %a, %b, %c, %d, %e, %f, %g
  %l1: list<int> = list.lit %a, %b, %c, %d, %e, %f, %g, %a
  %x: int = list.get %l0, %z
  %cond: bool = icmp.lt %x, %c
  br_if %cond, ta(), tb()
ta:
  drop %l1
  br join(%l0)
tb:
  drop %l0
  br join(%l1)
join(%l: move list<int>):
  %n: int = list.len %l
  br outer(%z, %z, %l)
outer(%at: int, %sum: int, %h: move list<int>):
  %w: int = iconst 4
  %end: int = iadd %at, %w
  %fits: bool = icmp.le %end, %n
  br_if %fits, window(), done()
window:
  br inner(%z, %sum)
inner(%j: int, %acc: int):
  %more: bool = icmp.lt %j, %w
  br_if %more, step(), next()
step:
  %idx: int = iadd %at, %j
  %v: int = list.get %h, %idx
  %acc2: int = iadd.chk %acc, %v
  %one: int = iconst 1
  %j2: int = iadd %j, %one
  br inner(%j2, %acc2)
next:
  br outer(%end, %acc, %h)
done:
  drop %h
  ret %sum
}
