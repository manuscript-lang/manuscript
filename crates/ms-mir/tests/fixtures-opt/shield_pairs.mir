module "shield_pairs"
extern @msrt_print_int(int)
extern @msrt_shield_enter() -> void leaf shield_enter
extern @msrt_shield_exit() -> void leaf shield_exit
extern @msrt_wait() -> void
entry @main
fn @empty(%x: int) -> int {
b0:
  %a: void = call.rt @msrt_shield_enter ()
  %b: void = call.rt @msrt_shield_exit ()
  %y: int = iadd %x, %x
  ret %y
}
fn @parks(%x: int) -> int {
b0:
  %a: void = call.rt @msrt_shield_enter ()
  %w: void = call.rt @msrt_wait ()
  %b: void = call.rt @msrt_shield_exit ()
  ret %x
}
fn @main() -> int {
b0:
  %one: int = iconst 1
  %r: int = call @empty (%one)
  %p: void = call.rt @msrt_print_int (%r)
  %zero: int = iconst 0
  ret %zero
}
