module "narrow_through_offset"
entry @main
fn @probe(%l: list<int>, %n: int, %x: int) -> int {
b0:
  %one: int = iconst 1
  %low: bool = icmp.ge %x, %one
  br_if %low, b1(), out()
b1:
  %m: int = isub.chk %n, %one
  %c: bool = icmp.lt %x, %m
  br_if %c, b2(), out()
b2:
  %p: int = imul.chk %x, %n
  %v: int = list.get %l, %p
  ret %v
out:
  %z: int = iconst 0
  ret %z
}
fn @main() -> int {
b0:
  %a: int = iconst 1
  %b: int = iconst 2
  %l: list<int> = list.lit %a, %b
  %n: int = iconst 1
  %x: int = iconst 1
  %r: int = call @probe (%l, %n, %x)
  drop %l
  ret %r
}
