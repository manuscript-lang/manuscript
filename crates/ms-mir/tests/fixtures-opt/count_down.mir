module "count_down"
entry @main
fn @main() -> int {
b0:
  %n: int = iconst 50
  %one: int = iconst 1
  %z: int = iconst 0
  br loop(%n, %z)
loop(%i: int, %acc: int):
  %c: bool = icmp.gt %i, %z
  br_if %c, body(), done()
body:
  %i1: int = isub.chk %i, %one
  %a: int = iadd.chk %acc, %i
  br loop(%i1, %a)
done:
  ret %acc
}
