module "list_join_walk"
entry @main
fn @main() -> int {
b0:
  %a: int = iconst 1
  %b: int = iconst 2
  %c: int = iconst 3
  %d: int = iconst 4
  %e: int = iconst 5
  %f: int = iconst 6
  %g: int = iconst 7
  %z: int = iconst 0
  %l0: list<int> = list.lit %a, %b, %c, %d, %e, %f, %g
  %l1: list<int> = list.lit %a, %b, %c, %d, %e, %f, %g, %a
  %x: int = list.get %l0, %z
  %cond: bool = icmp.lt %x, %c
  br_if %cond, ta(), tb()
ta:
  drop %l1
  br join(%l0)
tb:
  drop %l0
  br join(%l1)
join(%l: move list<int>):
  br loop(%a, %l)
loop(%at: int, %h: move list<int>):
  %m: int = list.len %h
  %two: int = iconst 2
  %lim: int = isub %m, %two
  %go: bool = icmp.le %at, %lim
  br_if %go, body(), done()
body:
  %one: int = iconst 1
  %next1: int = iadd %at, %one
  %y: int = list.get %h, %next1
  %v: int = list.get %h, %at
  %w: int = iadd.chk %y, %v
  %h2: list<int> = list.set %h, %at, %w
  %s: int = shl %at, %one
  %next: int = iadd %s, %one
  br loop(%next, %h2)
done:
  drop %h
  ret %at
}
