module "recrec"
type Node { v: int, next: opt<Node> }
entry @main
fn @main() -> int {
b0:
  %one: int = iconst 1
  %b: opt<Node> = opt.none
  %none: opt<Node> = clone %b
  %n1: Node = type.new Node %one, %none
  %s1: opt<Node> = opt.some %n1
  %two: int = iconst 2
  %n2: Node = type.new Node %two, %s1
  %s2: opt<Node> = opt.some %n2
  %three: int = iconst 3
  %n3: Node = type.new Node %three, %s2
  %c: Node = clone %n3
  %nx: opt<Node> = type.get Node.next %c
  %has: bool = opt.is_some %nx
  %m: Node = opt.unwrap %nx
  %v: int = type.get Node.v %m
  %w: int = type.get Node.v %c
  %r: int = imul %v, %w
  %ten: int = iconst 10
  %r2: int = iadd.chk %r, %ten
  drop %m
  drop %c
  drop %n3
  ret %r2
}
