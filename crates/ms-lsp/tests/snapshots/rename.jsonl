{"id":302,"jsonrpc":"2.0","result":[{"edit":{"documentChanges":[{"edits":[{"newText":"import (\n\tIterator from \"@std/core.ms\",\n\tstdout from \"@std/io/io.ms\",\n\texpect_equal from \"@std/test/test.ms\",\n)\n\n// A point in the plane.\ntype Point:\n\tx: Int\n\ty: Int = 0\n\nenum Shape:\n\tCircle(radius: Int)\n\tSquare(side: Int)\n\tEmpty\n\ninterface Named:\n\tfn label() String\n\nfn Point.norm() Int:\n\treturn self.x * self.x + self.y * self.y\n\nfn Point.label() String:\n\treturn \"point\"\n\ntype Counter:\n\tn: Int\n\nfn var Counter.next() Int?:\n\tif self.n == 0: return none\n\n\tself.n -= 1\n\treturn self.n\n\nfn add(a: Int, b: Int) Int:\n\ttotal := a + b\n\treturn total\n\nfn area(shape: Shape) Int:\n\tmatch shape:\n\t\tCircle(r):\n\t\t\treturn r * r * 3\n\t\tSquare(s):\n\t\t\treturn s * s\n\t\t_:\n\t\t\treturn 0\n\nfn describe(p: Point) String:\n\tn := p.norm()\n\treturn \"norm is {n} at {p.x}\"\n\nexport fn main() Int:\n\t_p := Point(x: 1, y: 2)\n\tvalues := [1, 2, 3]\n\tfor v in values:\n\t\t_ := say(\"{v}\")\n\tfor tick in Counter(n: 2):\n\t\t_ := say(\"{tick}\")\n\n\tresult := add(1, 2)\n\treturn result\n\nfn say(text: String) Result[Unit, Error]:\n\tstdout().write(\"{text}\\n\")?\n\treturn stdout().flush()\n\ntest \"addition\":\n\texpect_equal(add(1, 2), 3)?\n","range":{"end":{"character":0,"line":66},"start":{"character":0,"line":0}}}],"textDocument":{"uri":"file://$TMP/ms-lsp-rename-PID/main.ms","version":1}}]},"kind":"source.fixAll.manuscript","title":"Format Manuscript document"},{"diagnostics":[{"code":"MSL102","message":"Import Iterator is never used","range":{"end":{"character":0,"line":0},"start":{"character":0,"line":0}},"source":"manuscript-lint"}],"edit":{"documentChanges":[{"edits":[{"newText":"","range":{"end":{"character":0,"line":1},"start":{"character":0,"line":0}}}],"textDocument":{"uri":"file://$TMP/ms-lsp-rename-PID/main.ms","version":1}}]},"isPreferred":true,"kind":"quickfix","title":"Remove unused import"}]}
