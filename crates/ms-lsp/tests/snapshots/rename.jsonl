{"id":270,"jsonrpc":"2.0","result":[{"edit":{"documentChanges":[{"edits":[{"newText":"import stdout from \"@std/io.ms\"\nimport {expect_equal} from \"@std/testing.ms\"\n\n# A point in the plane.\ntype Point:\n    x: Int\n    y: Int = 0\n\ntype Shape:\n    case Circle(radius: Int)\n    case Square(side: Int)\n    case Empty\n\ninterface Named:\n    fn label() String\n\nimpl Point:\n    fn norm() Int:\n        return self.x * self.x + self.y * self.y\n\nimpl Named for Point:\n    fn label() String:\n        return \"point\"\n\nfn add(a: Int, b: Int) Int:\n    let total = a + b\n\n    return total\n\nfn area(shape: Shape) Int:\n    match shape:\n        Circle(r):\n            return r * r * 3\n        Square(s):\n            return s * s\n        _:\n            return 0\n\nfn describe(p: Point) String:\n    let n = p.norm()\n\n    return \"norm is {n} at {p.x}\"\n\nexport fn main() Int:\n    let p = Point(x: 1, y: 2)\n    let values = [1, 2, 3]\n\n    for v in values:\n        say(\"{v}\")\n\n    let result = add(1, 2)\n\n    return result\n\nfn say(text: String) Result[Unit, Error]:\n    try stdout().write(\"{text}\\n\")\n    return stdout().flush()\n\ntest \"addition\":\n    try expect_equal(add(1, 2), 3)\n","range":{"end":{"character":0,"line":55},"start":{"character":0,"line":0}}}],"textDocument":{"uri":"file://$TMP/ms-lsp-rename-PID/main.ms","version":1}}]},"kind":"source.fixAll.manuscript","title":"Format Manuscript document"}]}
{"id":271,"jsonrpc":"2.0","result":[{"newText":"import stdout from \"@std/io.ms\"\nimport {expect_equal} from \"@std/testing.ms\"\n\n# A point in the plane.\ntype Point:\n    x: Int\n    y: Int = 0\n\ntype Shape:\n    case Circle(radius: Int)\n    case Square(side: Int)\n    case Empty\n\ninterface Named:\n    fn label() String\n\nimpl Point:\n    fn norm() Int:\n        return self.x * self.x + self.y * self.y\n\nimpl Named for Point:\n    fn label() String:\n        return \"point\"\n\nfn add(a: Int, b: Int) Int:\n    let total = a + b\n\n    return total\n\nfn area(shape: Shape) Int:\n    match shape:\n        Circle(r):\n            return r * r * 3\n        Square(s):\n            return s * s\n        _:\n            return 0\n\nfn describe(p: Point) String:\n    let n = p.norm()\n\n    return \"norm is {n} at {p.x}\"\n\nexport fn main() Int:\n    let p = Point(x: 1, y: 2)\n    let values = [1, 2, 3]\n\n    for v in values:\n        say(\"{v}\")\n\n    let result = add(1, 2)\n\n    return result\n\nfn say(text: String) Result[Unit, Error]:\n    try stdout().write(\"{text}\\n\")\n    return stdout().flush()\n\ntest \"addition\":\n    try expect_equal(add(1, 2), 3)\n","range":{"end":{"character":0,"line":55},"start":{"character":0,"line":0}}}]}
