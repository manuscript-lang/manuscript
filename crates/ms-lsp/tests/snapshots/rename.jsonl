{"id":340,"jsonrpc":"2.0","result":[{"newText":"import Iterator from \"@std/core.ms\"\nimport stdout from \"@std/io.ms\"\nimport expect_equal from \"@std/test.ms\"\n\n# A point in the plane.\ntype Point:\n    x: Int\n    y: Int = 0\n\ntype Shape:\n    case Circle(radius: Int)\n    case Square(side: Int)\n    case Empty\n\ninterface Named:\n    fn label() String\n\nimpl Point:\n    fn norm() Int:\n        return self.x * self.x + self.y * self.y\n\nimpl Named for Point:\n    fn label() String:\n        return \"point\"\n\ntype Counter:\n    n: Int\n\nimpl Iterator[Int] for Counter:\n    var fn next() Int?:\n        if self.n == 0: return none\n\n        self.n -= 1\n        return self.n\n\nfn add(a: Int, b: Int) Int:\n    let total = a + b\n    return total\n\nfn area(shape: Shape) Int:\n    match shape:\n        Circle(r):\n            return r * r * 3\n        Square(s):\n            return s * s\n        _:\n            return 0\n\nfn describe(p: Point) String:\n    let n = p.norm()\n    return \"norm is {n} at {p.x}\"\n\nexport fn main() Int:\n    let _p = Point(x: 1, y: 2)\n    let values = [1, 2, 3]\n    for v in values:\n        let _ = say(\"{v}\")\n    for tick in Counter(n: 2):\n        let _ = say(\"{tick}\")\n\n    let result = add(1, 2)\n    return result\n\nfn say(text: String) Result[Unit, Error]:\n    try stdout().write(\"{text}\\n\")\n    return stdout().flush()\n\ntest \"addition\":\n    try expect_equal(add(1, 2), 3)\n","range":{"end":{"character":0,"line":69},"start":{"character":0,"line":0}}}]}
