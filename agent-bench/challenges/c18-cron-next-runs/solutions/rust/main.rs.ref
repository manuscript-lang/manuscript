use std::io::{BufRead, Write};

const RANGES: [(&str, usize, usize); 5] = [("minute", 0, 59), ("hour", 0, 23), ("day-of-month", 1, 31), ("month", 1, 12), ("day-of-week", 0, 6)];

fn days_from_civil(mut y: i64, m: i64, d: i64) -> i64 {
    if m <= 2 {
        y -= 1;
    }
    let era = y / 400;
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z: i64) -> (i64, i64, i64) {
    let z = z + 719468;
    let era = z / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let mut y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    if m <= 2 {
        y += 1;
    }
    (y, m, d)
}

fn digits(s: &str, lo: usize, hi: usize) -> Option<usize> {
    if s.len() < lo || s.len() > hi || !s.bytes().all(|b| b.is_ascii_digit()) {
        return None;
    }
    s.parse().ok()
}

fn parse_field(text: &str, lo: usize, hi: usize) -> Option<Vec<bool>> {
    let mut set = vec![false; hi + 1];
    for item in text.split(',') {
        let parts: Vec<&str> = item.split('/').collect();
        if parts.len() > 2 {
            return None;
        }
        let body = parts[0];
        let mut step = 1;
        if parts.len() == 2 {
            step = digits(parts[1], 1, 2)?;
            if step < 1 {
                return None;
            }
        }
        let (a, b);
        if body == "*" {
            a = lo;
            b = hi;
        } else if let Some(v) = digits(body, 1, 2) {
            if parts.len() == 2 {
                return None;
            }
            a = v;
            b = v;
        } else {
            let r: Vec<&str> = body.split('-').collect();
            if r.len() != 2 {
                return None;
            }
            a = digits(r[0], 1, 2)?;
            b = digits(r[1], 1, 2)?;
            if a > b {
                return None;
            }
        }
        if a < lo || b > hi {
            return None;
        }
        let mut v = a;
        while v <= b {
            set[v] = true;
            v += step;
        }
    }
    Some(set)
}

fn parse_start(s: &str) -> Option<(i64, usize)> {
    let b = s.as_bytes();
    if b.len() != 16 || b[4] != b'-' || b[7] != b'-' || b[10] != b'T' || b[13] != b':' {
        return None;
    }
    let y = digits(&s[0..4], 4, 4)?;
    let mo = digits(&s[5..7], 2, 2)?;
    let d = digits(&s[8..10], 2, 2)?;
    let h = digits(&s[11..13], 2, 2)?;
    let mi = digits(&s[14..16], 2, 2)?;
    if !(1970..=2099).contains(&y) || !(1..=12).contains(&mo) || d < 1 || h > 23 || mi > 59 {
        return None;
    }
    let leap = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
    let lens = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if d > lens[mo - 1] {
        return None;
    }
    Some((days_from_civil(y as i64, mo as i64, d as i64), h * 60 + mi))
}

fn main() {
    let stdin = std::io::stdin();
    let mut out = String::new();
    for (idx, line) in stdin.lock().lines().enumerate() {
        let l = line.unwrap();
        if l.trim_matches(' ').is_empty() {
            continue;
        }
        let pre = format!("line {}:", idx + 1);
        let t: Vec<&str> = l.split(' ').collect();
        if t.len() != 7 {
            out.push_str(&format!("{} error: bad line\n", pre));
            continue;
        }
        let (start_day, start_min) = match parse_start(t[0]) {
            Some(v) => v,
            None => {
                out.push_str(&format!("{} error: bad start\n", pre));
                continue;
            }
        };
        let count = match digits(t[1], 1, 2) {
            Some(c) if (1..=20).contains(&c) => c,
            _ => {
                out.push_str(&format!("{} error: bad count\n", pre));
                continue;
            }
        };
        let mut sets: Vec<Vec<bool>> = Vec::new();
        let mut bad = None;
        for i in 0..5 {
            match parse_field(t[2 + i], RANGES[i].1, RANGES[i].2) {
                Some(s) => sets.push(s),
                None => {
                    bad = Some(RANGES[i].0);
                    break;
                }
            }
        }
        if let Some(name) = bad {
            out.push_str(&format!("{} error: bad {}\n", pre, name));
            continue;
        }
        let mut runs: Vec<String> = Vec::new();
        'search: for k in 0..=3000i64 {
            let day = start_day + k;
            let (y, m, d) = civil_from_days(day);
            if !sets[3][m as usize] || !sets[2][d as usize] || !sets[4][((day + 4) % 7) as usize] {
                continue;
            }
            for h in 0..24 {
                if !sets[1][h] {
                    continue;
                }
                for mn in 0..60 {
                    if !sets[0][mn] || (k == 0 && h * 60 + mn <= start_min) {
                        continue;
                    }
                    runs.push(format!("{:04}-{:02}-{:02} {:02}:{:02}", y, m, d, h, mn));
                    if runs.len() == count {
                        break 'search;
                    }
                }
            }
        }
        if runs.is_empty() {
            out.push_str(&format!("{} never\n", pre));
        } else {
            out.push_str(&format!("{} {} runs\n", pre, runs.len()));
            for r in runs {
                out.push_str(&r);
                out.push('\n');
            }
        }
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
