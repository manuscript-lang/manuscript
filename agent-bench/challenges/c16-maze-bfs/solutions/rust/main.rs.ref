use std::collections::VecDeque;
use std::io::BufRead;

fn solve(rows: &[Vec<char>]) -> String {
    for (r, row) in rows.iter().enumerate() {
        for (c, &ch) in row.iter().enumerate() {
            if !"#.SE".contains(ch) {
                return format!("error: bad character at {},{}", r + 1, c + 1);
            }
        }
    }
    if rows.iter().any(|r| r.len() != rows[0].len()) {
        return "error: ragged grid".into();
    }
    let flat: Vec<char> = rows.iter().flatten().copied().collect();
    let count = |x: char| flat.iter().filter(|&&c| c == x).count();
    if count('S') == 0 {
        return "error: no start".into();
    }
    if count('S') > 1 {
        return "error: multiple starts".into();
    }
    if count('E') == 0 {
        return "error: no end".into();
    }
    if count('E') > 1 {
        return "error: multiple ends".into();
    }
    let (h, w) = (rows.len() as i32, rows[0].len() as i32);
    let mut dist = vec![-1i32; flat.len()];
    let start = flat.iter().position(|&c| c == 'S').unwrap();
    dist[start] = 0;
    let mut queue = VecDeque::from([start]);
    while let Some(cur) = queue.pop_front() {
        if flat[cur] == 'E' {
            return dist[cur].to_string();
        }
        let (r, c) = (cur as i32 / w, cur as i32 % w);
        for (dr, dc) in [(1, 0), (-1, 0), (0, 1), (0, -1)] {
            let (nr, nc) = (r + dr, c + dc);
            if nr < 0 || nr >= h || nc < 0 || nc >= w {
                continue;
            }
            let ni = (nr * w + nc) as usize;
            if flat[ni] != '#' && dist[ni] < 0 {
                dist[ni] = dist[cur] + 1;
                queue.push_back(ni);
            }
        }
    }
    "no path".into()
}

fn main() {
    let stdin = std::io::stdin();
    let mut rows: Vec<Vec<char>> = stdin.lock().lines().map(|l| l.unwrap().chars().collect()).collect();
    while rows.last().map_or(false, |r| r.is_empty()) {
        rows.pop();
    }
    println!("{}", solve(&rows));
}
