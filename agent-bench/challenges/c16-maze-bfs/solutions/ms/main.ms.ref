import {stdin, stdout, read_line} from "@std/io.ms"

# Returns an error message for an invalid grid, or "" when the grid is valid.
fn validate(rows: List[List[Int]]) -> String:
    var r = 0
    while r < rows.length():
        let row = rows.at(r).unwrap()
        var c = 0
        while c < row.length():
            let ch = row.at(c).unwrap()
            # '#' 35, '.' 46, 'S' 83, 'E' 69
            if ch != 35 and ch != 46 and ch != 83 and ch != 69:
                return "error: bad character at {r + 1},{c + 1}"
            c = c + 1
        r = r + 1
    for row in rows:
        if row.length() != rows.at(0).unwrap().length():
            return "error: ragged grid"
    var starts = 0
    var ends = 0
    for row in rows:
        for ch in row:
            if ch == 83:
                starts = starts + 1
            if ch == 69:
                ends = ends + 1
    if starts == 0:
        return "error: no start"
    if starts > 1:
        return "error: multiple starts"
    if ends == 0:
        return "error: no end"
    if ends > 1:
        return "error: multiple ends"
    return ""

fn solve(rows: List[List[Int]]) -> String:
    let problem = validate(rows)
    if not problem.is_empty():
        return problem
    let height = rows.length()
    let width = rows.at(0).unwrap().length()
    let flat = List[Int]()
    let dist = List[Int]()
    var start = 0
    for row in rows:
        for ch in row:
            if ch == 83:
                start = flat.length()
            flat.append(ch)
            dist.append(-1)
    dist.set(start, 0)
    let queue = List[Int]()
    queue.append(start)
    var head = 0
    let dr = [1, -1, 0, 0]
    let dc = [0, 0, 1, -1]
    while head < queue.length():
        let cur = queue.at(head).unwrap()
        head = head + 1
        if flat.at(cur).unwrap() == 69:
            return "{dist.at(cur).unwrap()}"
        let r = cur / width
        let c = cur % width
        var d = 0
        while d < 4:
            let nr = r + dr.at(d).unwrap()
            let nc = c + dc.at(d).unwrap()
            d = d + 1
            if nr < 0 or nr >= height or nc < 0 or nc >= width:
                continue
            let ni = nr * width + nc
            if flat.at(ni).unwrap() != 35 and dist.at(ni).unwrap() < 0:
                dist.set(ni, dist.at(cur).unwrap() + 1)
                queue.append(ni)
    return "no path"

fn run() -> Result[Unit, Error]:
    let rows = List[List[Int]]()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        rows.append(next.unwrap().scalar_values())
    while rows.length() > 0 and rows.at(rows.length() - 1).unwrap().is_empty():
        rows.remove(rows.length() - 1)
    try stdout().write("{solve(rows)}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
