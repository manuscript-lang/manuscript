// Oracle for c52-sql-engine.
package main

import (
	"bufio"
	"fmt"
	"io"
	"os"
	"sort"
	"strconv"
	"strings"
)

// ---- values ----
type Kind int

const (
	KNull Kind = iota
	KInt
	KText
	KBool
)

type Val struct {
	k Kind
	i int64
	s string
	b bool
}

var null = Val{k: KNull}

func vint(i int64) Val   { return Val{k: KInt, i: i} }
func vtext(s string) Val { return Val{k: KText, s: s} }
func vbool(b bool) Val   { return Val{k: KBool, b: b} }
func (v Val) String() string {
	switch v.k {
	case KNull:
		return "NULL"
	case KInt:
		return strconv.FormatInt(v.i, 10)
	case KText:
		return v.s
	}
	if v.b {
		return "true"
	}
	return "false"
}

type SQLErr struct{ msg string }

func fail(f string, a ...interface{}) { panic(SQLErr{fmt.Sprintf(f, a...)}) }

// ---- lexer ----
type Tok struct {
	k string // "id", "int", "str", "op", "eof"
	s string
	i int64
}

var keywords = map[string]bool{}

func init() {
	for _, w := range strings.Fields("SELECT FROM WHERE GROUP BY HAVING ORDER LIMIT OFFSET JOIN LEFT INNER ON AS AND OR NOT NULL IS LIKE IN BETWEEN INSERT INTO VALUES UPDATE SET DELETE CREATE TABLE DROP PRIMARY KEY DISTINCT ASC DESC") {
		keywords[w] = true
	}
}

func lex(s string) []Tok {
	var toks []Tok
	i := 0
	for i < len(s) {
		c := s[i]
		switch {
		case c == ' ' || c == '\t' || c == '\n' || c == '\r':
			i++
		case c == '-' && i+1 < len(s) && s[i+1] == '-':
			for i < len(s) && s[i] != '\n' {
				i++
			}
		case c >= '0' && c <= '9':
			j := i
			for j < len(s) && s[j] >= '0' && s[j] <= '9' {
				j++
			}
			n, err := strconv.ParseInt(s[i:j], 10, 64)
			if err != nil {
				fail("syntax error")
			}
			toks = append(toks, Tok{k: "int", i: n})
			i = j
		case c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'):
			j := i
			for j < len(s) && (s[j] == '_' || (s[j] >= 'a' && s[j] <= 'z') || (s[j] >= 'A' && s[j] <= 'Z') || (s[j] >= '0' && s[j] <= '9')) {
				j++
			}
			toks = append(toks, Tok{k: "id", s: s[i:j]})
			i = j
		case c == '\'':
			var b []byte
			j := i + 1
			for {
				if j >= len(s) {
					fail("syntax error")
				}
				if s[j] == '\'' {
					if j+1 < len(s) && s[j+1] == '\'' {
						b = append(b, '\'')
						j += 2
						continue
					}
					j++
					break
				}
				b = append(b, s[j])
				j++
			}
			toks = append(toks, Tok{k: "str", s: string(b)})
			i = j
		default:
			two := ""
			if i+1 < len(s) {
				two = s[i : i+2]
			}
			if two == "<=" || two == ">=" || two == "<>" || two == "!=" || two == "||" {
				toks = append(toks, Tok{k: "op", s: two})
				i += 2
			} else if strings.IndexByte("=<>+-*/%(),.", c) >= 0 {
				toks = append(toks, Tok{k: "op", s: string(c)})
				i++
			} else {
				fail("syntax error")
			}
		}
	}
	return append(toks, Tok{k: "eof"})
}

// split statements on ; outside strings and comments
func split(src string) []string {
	var out []string
	start := 0
	i := 0
	for i < len(src) {
		c := src[i]
		if c == '\'' {
			i++
			for i < len(src) && src[i] != '\'' {
				i++
			}
			i++
		} else if c == '-' && i+1 < len(src) && src[i+1] == '-' {
			for i < len(src) && src[i] != '\n' {
				i++
			}
		} else if c == ';' {
			out = append(out, src[start:i])
			i++
			start = i
		} else {
			i++
		}
	}
	if start < len(src) {
		out = append(out, src[start:])
	}
	return out
}

// ---- AST ----
type Expr struct {
	kind  string // lit, col, un, bin, isnull, like, in, between, call, star
	val   Val
	tbl   string
	name  string
	op    string
	args  []*Expr
	neg   bool
	dist  bool
	idx   int // resolved column index
	agg   bool
	inAgg bool
}

type Item struct {
	star  bool
	tbl   string // for t.*
	e     *Expr
	alias string
}
type TRef struct{ name, alias string }
type Join struct {
	left bool
	t    TRef
	on   *Expr
}
type OItem struct {
	e    *Expr
	desc bool
}
type Select struct {
	distinct bool
	items    []Item
	from     *TRef
	joins    []Join
	where    *Expr
	group    []*Expr
	having   *Expr
	order    []OItem
	limit    int64
	offset   int64
	hasLimit bool
}

// ---- parser ----
type Parser struct {
	t []Tok
	p int
}

func (p *Parser) peek() Tok { return p.t[p.p] }
func (p *Parser) next() Tok { t := p.t[p.p]; p.p++; return t }
func (p *Parser) isKw(w string) bool {
	t := p.peek()
	return t.k == "id" && strings.EqualFold(t.s, w)
}
func (p *Parser) isOp(o string) bool { t := p.peek(); return t.k == "op" && t.s == o }
func (p *Parser) acceptKw(w string) bool {
	if p.isKw(w) {
		p.p++
		return true
	}
	return false
}
func (p *Parser) acceptOp(o string) bool {
	if p.isOp(o) {
		p.p++
		return true
	}
	return false
}
func (p *Parser) expectKw(w string) {
	if !p.acceptKw(w) {
		fail("syntax error")
	}
}
func (p *Parser) expectOp(o string) {
	if !p.acceptOp(o) {
		fail("syntax error")
	}
}
func (p *Parser) ident() string {
	t := p.peek()
	if t.k != "id" || keywords[strings.ToUpper(t.s)] {
		fail("syntax error")
	}
	p.p++
	return t.s
}
func (p *Parser) intLit() int64 {
	t := p.peek()
	if t.k != "int" {
		fail("syntax error")
	}
	p.p++
	return t.i
}

func (p *Parser) expr() *Expr { return p.or() }
func (p *Parser) or() *Expr {
	l := p.and()
	for p.acceptKw("OR") {
		l = &Expr{kind: "bin", op: "OR", args: []*Expr{l, p.and()}}
	}
	return l
}
func (p *Parser) and() *Expr {
	l := p.not()
	for p.acceptKw("AND") {
		l = &Expr{kind: "bin", op: "AND", args: []*Expr{l, p.not()}}
	}
	return l
}
func (p *Parser) not() *Expr {
	if p.acceptKw("NOT") {
		return &Expr{kind: "un", op: "NOT", args: []*Expr{p.not()}}
	}
	return p.cmp()
}
func (p *Parser) cmp() *Expr {
	l := p.add()
	t := p.peek()
	if t.k == "op" {
		switch t.s {
		case "=", "<>", "!=", "<", "<=", ">", ">=":
			p.p++
			op := t.s
			if op == "!=" {
				op = "<>"
			}
			return &Expr{kind: "bin", op: op, args: []*Expr{l, p.add()}}
		}
		return l
	}
	if p.acceptKw("IS") {
		neg := p.acceptKw("NOT")
		p.expectKw("NULL")
		return &Expr{kind: "isnull", neg: neg, args: []*Expr{l}}
	}
	neg := false
	if p.isKw("NOT") {
		n := p.t[p.p+1]
		if n.k == "id" && (strings.EqualFold(n.s, "LIKE") || strings.EqualFold(n.s, "IN") || strings.EqualFold(n.s, "BETWEEN")) {
			p.p++
			neg = true
		}
	}
	if p.acceptKw("LIKE") {
		return &Expr{kind: "like", neg: neg, args: []*Expr{l, p.add()}}
	}
	if p.acceptKw("IN") {
		p.expectOp("(")
		args := []*Expr{l, p.expr()}
		for p.acceptOp(",") {
			args = append(args, p.expr())
		}
		p.expectOp(")")
		return &Expr{kind: "in", neg: neg, args: args}
	}
	if p.acceptKw("BETWEEN") {
		lo := p.add()
		p.expectKw("AND")
		hi := p.add()
		return &Expr{kind: "between", neg: neg, args: []*Expr{l, lo, hi}}
	}
	return l
}
func (p *Parser) add() *Expr {
	l := p.mul()
	for p.isOp("+") || p.isOp("-") || p.isOp("||") {
		op := p.next().s
		l = &Expr{kind: "bin", op: op, args: []*Expr{l, p.mul()}}
	}
	return l
}
func (p *Parser) mul() *Expr {
	l := p.unary()
	for p.isOp("*") || p.isOp("/") || p.isOp("%") {
		op := p.next().s
		l = &Expr{kind: "bin", op: op, args: []*Expr{l, p.unary()}}
	}
	return l
}
func (p *Parser) unary() *Expr {
	if p.acceptOp("-") {
		return &Expr{kind: "un", op: "-", args: []*Expr{p.unary()}}
	}
	return p.primary()
}
func (p *Parser) primary() *Expr {
	t := p.peek()
	switch t.k {
	case "int":
		p.p++
		return &Expr{kind: "lit", val: vint(t.i)}
	case "str":
		p.p++
		return &Expr{kind: "lit", val: vtext(t.s)}
	case "op":
		if t.s == "(" {
			p.p++
			e := p.expr()
			p.expectOp(")")
			return e
		}
		fail("syntax error")
	case "id":
		if strings.EqualFold(t.s, "NULL") {
			p.p++
			return &Expr{kind: "lit", val: null}
		}
		name := p.ident()
		if p.acceptOp("(") {
			e := &Expr{kind: "call", name: strings.ToUpper(name)}
			if p.acceptOp(")") {
				return e
			}
			if p.isOp("*") {
				if e.name != "COUNT" {
					fail("syntax error")
				}
				p.p++
				p.expectOp(")")
				e.args = []*Expr{{kind: "star"}}
				return e
			}
			if p.acceptKw("DISTINCT") {
				e.dist = true
			}
			e.args = append(e.args, p.expr())
			for !e.dist && p.acceptOp(",") {
				e.args = append(e.args, p.expr())
			}
			p.expectOp(")")
			return e
		}
		if p.acceptOp(".") {
			return &Expr{kind: "col", tbl: name, name: p.ident()}
		}
		return &Expr{kind: "col", name: name}
	}
	fail("syntax error")
	return nil
}

func (p *Parser) tref() TRef {
	t := TRef{name: p.ident()}
	if p.acceptKw("AS") {
		t.alias = p.ident()
	} else if p.peek().k == "id" && !keywords[strings.ToUpper(p.peek().s)] {
		t.alias = p.ident()
	} else {
		t.alias = t.name
	}
	return t
}

func (p *Parser) selectStmt() *Select {
	s := &Select{}
	s.distinct = p.acceptKw("DISTINCT")
	for {
		var it Item
		if p.acceptOp("*") {
			it.star = true
		} else if p.peek().k == "id" && !keywords[strings.ToUpper(p.peek().s)] && p.t[p.p+1].k == "op" && p.t[p.p+1].s == "." && p.t[p.p+2].k == "op" && p.t[p.p+2].s == "*" {
			it.star = true
			it.tbl = p.ident()
			p.p += 2
		} else {
			it.e = p.expr()
			if p.acceptKw("AS") {
				it.alias = p.ident()
			}
		}
		s.items = append(s.items, it)
		if !p.acceptOp(",") {
			break
		}
	}
	if p.acceptKw("FROM") {
		t := p.tref()
		s.from = &t
		for {
			left := false
			if p.acceptKw("LEFT") {
				left = true
			} else if p.acceptKw("INNER") {
			} else if !p.isKw("JOIN") {
				break
			}
			p.expectKw("JOIN")
			j := Join{left: left, t: p.tref()}
			p.expectKw("ON")
			j.on = p.expr()
			s.joins = append(s.joins, j)
		}
	}
	if p.acceptKw("WHERE") {
		s.where = p.expr()
	}
	if p.acceptKw("GROUP") {
		p.expectKw("BY")
		for {
			name := p.ident()
			if p.acceptOp(".") {
				s.group = append(s.group, &Expr{kind: "col", tbl: name, name: p.ident()})
			} else {
				s.group = append(s.group, &Expr{kind: "col", name: name})
			}
			if !p.acceptOp(",") {
				break
			}
		}
	}
	if p.acceptKw("HAVING") {
		s.having = p.expr()
	}
	if p.acceptKw("ORDER") {
		p.expectKw("BY")
		for {
			o := OItem{e: p.expr()}
			if p.acceptKw("DESC") {
				o.desc = true
			} else {
				p.acceptKw("ASC")
			}
			s.order = append(s.order, o)
			if !p.acceptOp(",") {
				break
			}
		}
	}
	if p.acceptKw("LIMIT") {
		s.hasLimit = true
		s.limit = p.intLit()
		if p.acceptKw("OFFSET") {
			s.offset = p.intLit()
		}
	}
	return s
}

// ---- database ----
type Col struct {
	name    string
	typ     string // INT or TEXT
	pk      bool
	notnull bool
}
type Table struct {
	name string
	cols []Col
	rows [][]Val
}

var tables = map[string]*Table{}
var out strings.Builder

type ScopeCol struct{ tbl, name string }

func resolve(e *Expr, scope []ScopeCol, groupIdx map[int]bool, aggMode bool, inAgg bool, allowAgg bool) {
	switch e.kind {
	case "col":
		found := -1
		for i, c := range scope {
			if c.name == e.name && (e.tbl == "" || c.tbl == e.tbl) {
				if found >= 0 {
					fail("ambiguous column: %s", e.name)
				}
				found = i
			}
		}
		if found < 0 {
			if e.tbl != "" {
				fail("no such column: %s.%s", e.tbl, e.name)
			}
			fail("no such column: %s", e.name)
		}
		e.idx = found
		if aggMode && !inAgg && !groupIdx[found] {
			fail("column %s must appear in GROUP BY", e.name)
		}
	case "call":
		switch e.name {
		case "COUNT", "SUM", "MIN", "MAX":
			if !allowAgg || inAgg {
				fail("misuse of aggregate")
			}
			e.agg = true
			n := len(e.args)
			if n != 1 {
				fail("wrong number of arguments to %s", e.name)
			}
			if e.args[0].kind == "star" {
				return
			}
			resolve(e.args[0], scope, groupIdx, aggMode, true, allowAgg)
			return
		case "UPPER", "LOWER", "LENGTH", "ABS":
			if len(e.args) != 1 {
				fail("wrong number of arguments to %s", e.name)
			}
		case "SUBSTR":
			if len(e.args) != 3 {
				fail("wrong number of arguments to %s", e.name)
			}
		case "COALESCE":
			if len(e.args) < 1 {
				fail("wrong number of arguments to %s", e.name)
			}
		default:
			fail("no such function: %s", e.name)
		}
	}
	for _, a := range e.args {
		resolve(a, scope, groupIdx, aggMode, inAgg, allowAgg)
	}
}

func hasAgg(e *Expr) bool {
	if e.kind == "call" {
		switch e.name {
		case "COUNT", "SUM", "MIN", "MAX":
			return true
		}
	}
	for _, a := range e.args {
		if hasAgg(a) {
			return true
		}
	}
	return false
}

func cmpVals(a, b Val) int {
	if a.k != b.k {
		fail("type error")
	}
	switch a.k {
	case KInt:
		if a.i < b.i {
			return -1
		} else if a.i > b.i {
			return 1
		}
		return 0
	case KText:
		return strings.Compare(a.s, b.s)
	}
	fail("type error")
	return 0
}

// tri-state: returns (value, isNull)
func asBool(v Val) (bool, bool) {
	if v.k == KNull {
		return false, true
	}
	if v.k != KBool {
		fail("type error")
	}
	return v.b, false
}

func like(s, p string) bool {
	if p == "" {
		return s == ""
	}
	if p[0] == '%' {
		for i := 0; i <= len(s); i++ {
			if like(s[i:], p[1:]) {
				return true
			}
		}
		return false
	}
	if s == "" {
		return false
	}
	if p[0] == '_' || p[0] == s[0] {
		return like(s[1:], p[1:])
	}
	return false
}

// eval: row is the current row; group is non-nil in aggregate mode
func eval(e *Expr, row []Val, group [][]Val) Val {
	switch e.kind {
	case "lit":
		return e.val
	case "col":
		return row[e.idx]
	case "un":
		v := eval(e.args[0], row, group)
		if e.op == "NOT" {
			b, n := asBool(v)
			if n {
				return null
			}
			return vbool(!b)
		}
		if v.k == KNull {
			return null
		}
		if v.k != KInt {
			fail("type error")
		}
		return vint(-v.i)
	case "bin":
		switch e.op {
		case "AND", "OR":
			lb, ln := asBool(eval(e.args[0], row, group))
			if e.op == "AND" && !ln && !lb {
				return vbool(false)
			}
			if e.op == "OR" && !ln && lb {
				return vbool(true)
			}
			rb, rn := asBool(eval(e.args[1], row, group))
			if e.op == "AND" {
				if !rn && !rb {
					return vbool(false)
				}
				if ln || rn {
					return null
				}
				return vbool(true)
			}
			if !rn && rb {
				return vbool(true)
			}
			if ln || rn {
				return null
			}
			return vbool(false)
		}
		l := eval(e.args[0], row, group)
		r := eval(e.args[1], row, group)
		switch e.op {
		case "=", "<>", "<", "<=", ">", ">=":
			if l.k == KNull || r.k == KNull {
				return null
			}
			c := cmpVals(l, r)
			switch e.op {
			case "=":
				return vbool(c == 0)
			case "<>":
				return vbool(c != 0)
			case "<":
				return vbool(c < 0)
			case "<=":
				return vbool(c <= 0)
			case ">":
				return vbool(c > 0)
			}
			return vbool(c >= 0)
		case "||":
			if l.k == KNull || r.k == KNull {
				return null
			}
			if l.k != KText || r.k != KText {
				fail("type error")
			}
			return vtext(l.s + r.s)
		}
		if l.k == KNull || r.k == KNull {
			return null
		}
		if l.k != KInt || r.k != KInt {
			fail("type error")
		}
		switch e.op {
		case "+":
			return vint(l.i + r.i)
		case "-":
			return vint(l.i - r.i)
		case "*":
			return vint(l.i * r.i)
		case "/":
			if r.i == 0 {
				fail("division by zero")
			}
			return vint(l.i / r.i)
		}
		if r.i == 0 {
			fail("division by zero")
		}
		return vint(l.i % r.i)
	case "isnull":
		v := eval(e.args[0], row, group)
		return vbool((v.k == KNull) != e.neg)
	case "like":
		l := eval(e.args[0], row, group)
		r := eval(e.args[1], row, group)
		if l.k == KNull || r.k == KNull {
			return null
		}
		if l.k != KText || r.k != KText {
			fail("type error")
		}
		return vbool(like(l.s, r.s) != e.neg)
	case "in":
		l := eval(e.args[0], row, group)
		sawNull := l.k == KNull
		found := false
		for _, a := range e.args[1:] {
			v := eval(a, row, group)
			if l.k == KNull || v.k == KNull {
				sawNull = true
				continue
			}
			if cmpVals(l, v) == 0 {
				found = true
			}
		}
		if found {
			return vbool(!e.neg)
		}
		if sawNull {
			return null
		}
		return vbool(e.neg)
	case "between":
		v := eval(e.args[0], row, group)
		lo := eval(e.args[1], row, group)
		hi := eval(e.args[2], row, group)
		var a, b Val
		if v.k == KNull || lo.k == KNull {
			a = null
		} else {
			a = vbool(cmpVals(v, lo) >= 0)
		}
		if v.k == KNull || hi.k == KNull {
			b = null
		} else {
			b = vbool(cmpVals(v, hi) <= 0)
		}
		var res Val
		switch {
		case a.k == KBool && !a.b, b.k == KBool && !b.b:
			res = vbool(false)
		case a.k == KNull || b.k == KNull:
			res = null
		default:
			res = vbool(true)
		}
		if res.k == KBool && e.neg {
			res = vbool(!res.b)
		}
		return res
	case "call":
		if e.agg {
			return aggregate(e, group)
		}
		var args []Val
		for _, a := range e.args {
			args = append(args, eval(a, row, group))
		}
		switch e.name {
		case "COALESCE":
			for _, a := range args {
				if a.k != KNull {
					return a
				}
			}
			return null
		case "UPPER", "LOWER", "LENGTH":
			if args[0].k == KNull {
				return null
			}
			if args[0].k != KText {
				fail("type error")
			}
			switch e.name {
			case "UPPER":
				return vtext(strings.ToUpper(args[0].s))
			case "LOWER":
				return vtext(strings.ToLower(args[0].s))
			}
			return vint(int64(len(args[0].s)))
		case "ABS":
			if args[0].k == KNull {
				return null
			}
			if args[0].k != KInt {
				fail("type error")
			}
			if args[0].i < 0 {
				return vint(-args[0].i)
			}
			return args[0]
		case "SUBSTR":
			for _, a := range args {
				if a.k == KNull {
					return null
				}
			}
			if args[0].k != KText || args[1].k != KInt || args[2].k != KInt {
				fail("type error")
			}
			s := args[0].s
			st, n := args[1].i, args[2].i
			if st < 1 {
				n += st - 1
				st = 1
			}
			if n <= 0 || st > int64(len(s)) {
				return vtext("")
			}
			end := st - 1 + n
			if end > int64(len(s)) {
				end = int64(len(s))
			}
			return vtext(s[st-1 : end])
		}
	}
	fail("internal")
	return null
}

func aggregate(e *Expr, group [][]Val) Val {
	if e.args[0].kind == "star" {
		return vint(int64(len(group)))
	}
	var vals []Val
	seen := map[string]bool{}
	for _, r := range group {
		v := eval(e.args[0], r, nil)
		if v.k == KNull {
			continue
		}
		if e.dist {
			key := strconv.Itoa(int(v.k)) + ":" + v.String()
			if seen[key] {
				continue
			}
			seen[key] = true
		}
		vals = append(vals, v)
	}
	switch e.name {
	case "COUNT":
		return vint(int64(len(vals)))
	case "SUM":
		if len(vals) == 0 {
			return null
		}
		var s int64
		for _, v := range vals {
			if v.k != KInt {
				fail("type error")
			}
			s += v.i
		}
		return vint(s)
	}
	if len(vals) == 0 {
		return null
	}
	best := vals[0]
	for _, v := range vals[1:] {
		c := cmpVals(v, best)
		if (e.name == "MIN" && c < 0) || (e.name == "MAX" && c > 0) {
			best = v
		}
	}
	return best
}

func exprName(it Item) string {
	if it.alias != "" {
		return it.alias
	}
	if it.e.kind == "col" {
		return it.e.name
	}
	return "?column?"
}

func ordKey(v Val) int { return int(v.k) } // NULL < INT < TEXT (bool never stored)
func ordCmp(a, b Val) int {
	if a.k != b.k {
		if ordKey(a) < ordKey(b) {
			return -1
		}
		return 1
	}
	switch a.k {
	case KInt:
		return cmpVals(a, b)
	case KText:
		return strings.Compare(a.s, b.s)
	case KBool:
		if a.b == b.b {
			return 0
		}
		if !a.b {
			return -1
		}
		return 1
	}
	return 0
}

func runSelect(s *Select) {
	var scope []ScopeCol
	var base [][]Val = [][]Val{{}}
	type tinfo struct {
		t     *Table
		alias string
	}
	var tis []tinfo
	if s.from != nil {
		refs := []TRef{*s.from}
		for _, j := range s.joins {
			refs = append(refs, j.t)
		}
		aliases := map[string]bool{}
		for _, r := range refs {
			t, ok := tables[r.name]
			if !ok {
				fail("no such table: %s", r.name)
			}
			if aliases[r.alias] {
				fail("duplicate alias: %s", r.alias)
			}
			aliases[r.alias] = true
			tis = append(tis, tinfo{t, r.alias})
		}
	}
	// scope per table incrementally for ON resolution
	var starts []int
	for _, ti := range tis {
		starts = append(starts, len(scope))
		for _, c := range ti.t.cols {
			scope = append(scope, ScopeCol{ti.alias, c.name})
		}
	}
	for ji, j := range s.joins {
		upto := starts[ji+1] + len(tis[ji+1].t.cols)
		resolve(j.on, scope[:upto], nil, false, false, false)
	}
	// expand stars
	var items []Item
	for _, it := range s.items {
		if !it.star {
			items = append(items, it)
			continue
		}
		matched := false
		for i, c := range scope {
			if it.tbl == "" || c.tbl == it.tbl {
				matched = true
				items = append(items, Item{e: &Expr{kind: "col", tbl: c.tbl, name: c.name, idx: i}, alias: ""})
			}
		}
		if it.tbl != "" && !matched {
			fail("no such table: %s", it.tbl)
		}
	}
	// star expansions already resolved; mark by idx>=0 with a flag using tbl non-empty -> still resolve normally (same result)
	agg := len(s.group) > 0
	for _, it := range items {
		if hasAgg(it.e) {
			agg = true
		}
	}
	if s.having != nil && hasAgg(s.having) {
		agg = true
	}
	for _, o := range s.order {
		if hasAgg(o.e) {
			agg = true
		}
	}
	if s.having != nil {
		agg = true
	}
	groupIdx := map[int]bool{}
	var gcols []int
	for _, g := range s.group {
		resolve(g, scope, nil, false, false, false)
		groupIdx[g.idx] = true
		gcols = append(gcols, g.idx)
	}
	if s.where != nil {
		resolve(s.where, scope, nil, false, false, false)
	}
	for _, it := range items {
		resolve(it.e, scope, groupIdx, agg, false, true)
	}
	if s.having != nil {
		resolve(s.having, scope, groupIdx, agg, false, true)
	}
	names := make([]string, len(items))
	for i, it := range items {
		names[i] = exprName(it)
	}
	// order by resolution: position / output name / expression
	type okey struct {
		pos  int // output column or -1
		e    *Expr
		desc bool
	}
	var oks []okey
	for _, o := range s.order {
		k := okey{pos: -1, desc: o.desc}
		if o.e.kind == "lit" && o.e.val.k == KInt {
			if o.e.val.i < 1 || o.e.val.i > int64(len(items)) {
				fail("bad ORDER BY position")
			}
			k.pos = int(o.e.val.i) - 1
		} else if o.e.kind == "col" && o.e.tbl == "" {
			for i, n := range names {
				if n == o.e.name {
					k.pos = i
					break
				}
			}
		}
		if k.pos < 0 {
			resolve(o.e, scope, groupIdx, agg, false, true)
			k.e = o.e
		}
		oks = append(oks, k)
	}
	// FROM + JOIN
	rows := [][]Val{{}}
	if len(tis) > 0 {
		rows = nil
		for _, r := range tis[0].t.rows {
			rows = append(rows, append([]Val{}, r...))
		}
		for ji, j := range s.joins {
			rt := tis[ji+1].t
			var nrows [][]Val
			for _, l := range rows {
				matched := false
				for _, r := range rt.rows {
					cand := append(append([]Val{}, l...), r...)
					v := eval(j.on, cand, nil)
					b, n := asBool(v)
					if !n && b {
						matched = true
						nrows = append(nrows, cand)
					}
				}
				if !matched && j.left {
					cand := append([]Val{}, l...)
					for range rt.cols {
						cand = append(cand, null)
					}
					nrows = append(nrows, cand)
				}
			}
			rows = nrows
		}
	}
	_ = base
	if s.where != nil {
		var kept [][]Val
		for _, r := range rows {
			b, n := asBool(eval(s.where, r, nil))
			if !n && b {
				kept = append(kept, r)
			}
		}
		rows = kept
	}
	type orow struct {
		vals []Val
		keys []Val
	}
	var res []orow
	emit := func(row []Val, group [][]Val) {
		o := orow{}
		for _, it := range items {
			o.vals = append(o.vals, eval(it.e, row, group))
		}
		for _, k := range oks {
			if k.pos >= 0 {
				o.keys = append(o.keys, o.vals[k.pos])
			} else {
				o.keys = append(o.keys, eval(k.e, row, group))
			}
		}
		res = append(res, o)
	}
	if agg {
		var order []string
		groups := map[string][][]Val{}
		if len(gcols) == 0 {
			order = []string{""}
			groups[""] = rows
		} else {
			for _, r := range rows {
				var kb strings.Builder
				for _, gi := range gcols {
					kb.WriteString(strconv.Itoa(int(r[gi].k)) + ":" + strconv.Itoa(len(r[gi].String())) + ":" + r[gi].String() + "|")
				}
				k := kb.String()
				if _, ok := groups[k]; !ok {
					order = append(order, k)
				}
				groups[k] = append(groups[k], r)
			}
		}
		for _, k := range order {
			g := groups[k]
			var first []Val
			if len(g) > 0 {
				first = g[0]
			} else {
				first = make([]Val, len(scope))
			}
			if s.having != nil {
				b, n := asBool(eval(s.having, first, g))
				if n || !b {
					continue
				}
			}
			emit(first, g)
		}
	} else {
		for _, r := range rows {
			emit(r, nil)
		}
	}
	if s.distinct {
		seen := map[string]bool{}
		var d []orow
		for _, r := range res {
			var kb strings.Builder
			for _, v := range r.vals {
				kb.WriteString(strconv.Itoa(int(v.k)) + ":" + strconv.Itoa(len(v.String())) + ":" + v.String() + "|")
			}
			if !seen[kb.String()] {
				seen[kb.String()] = true
				d = append(d, r)
			}
		}
		res = d
	}
	if len(oks) > 0 {
		sort.SliceStable(res, func(a, b int) bool {
			for i, k := range oks {
				c := ordCmp(res[a].keys[i], res[b].keys[i])
				if c == 0 {
					continue
				}
				if k.desc {
					return c > 0
				}
				return c < 0
			}
			return false
		})
	}
	if s.offset > 0 {
		if s.offset >= int64(len(res)) {
			res = nil
		} else {
			res = res[s.offset:]
		}
	}
	if s.hasLimit && s.limit < int64(len(res)) {
		res = res[:s.limit]
	}
	out.WriteString(strings.Join(names, "|") + "\n")
	for _, r := range res {
		parts := make([]string, len(r.vals))
		for i, v := range r.vals {
			parts[i] = v.String()
		}
		out.WriteString(strings.Join(parts, "|") + "\n")
	}
	fmt.Fprintf(&out, "(%d rows)\n", len(res))
}

func checkRow(t *Table, row []Val, skip int) {
	for i, c := range t.cols {
		v := row[i]
		if v.k == KNull {
			if c.pk || c.notnull {
				fail("NOT NULL constraint failed: %s", c.name)
			}
			continue
		}
		if (c.typ == "INT" && v.k != KInt) || (c.typ == "TEXT" && v.k != KText) {
			fail("type mismatch in column %s", c.name)
		}
	}
}
func checkPK(t *Table, rows [][]Val) {
	for i, c := range t.cols {
		if !c.pk {
			continue
		}
		seen := map[string]bool{}
		for _, r := range rows {
			k := r[i].String()
			if seen[k] {
				fail("duplicate primary key: %s", k)
			}
			seen[k] = true
		}
	}
}

func execute(stmt string) {
	toks := lex(stmt)
	if len(toks) == 1 {
		return
	}
	p := &Parser{t: toks}
	switch {
	case p.acceptKw("CREATE"):
		p.expectKw("TABLE")
		name := p.ident()
		p.expectOp("(")
		var cols []Col
		for {
			c := Col{name: p.ident()}
			ty := strings.ToUpper(p.ident())
			if ty != "INT" && ty != "TEXT" {
				fail("syntax error")
			}
			c.typ = ty
			for {
				if p.acceptKw("PRIMARY") {
					p.expectKw("KEY")
					c.pk = true
				} else if p.acceptKw("NOT") {
					p.expectKw("NULL")
					c.notnull = true
				} else {
					break
				}
			}
			cols = append(cols, c)
			if !p.acceptOp(",") {
				break
			}
		}
		p.expectOp(")")
		if p.peek().k != "eof" {
			fail("syntax error")
		}
		if _, ok := tables[name]; ok {
			fail("table %s already exists", name)
		}
		seen := map[string]bool{}
		npk := 0
		for _, c := range cols {
			if seen[c.name] {
				fail("duplicate column: %s", c.name)
			}
			seen[c.name] = true
			if c.pk {
				npk++
			}
		}
		if npk > 1 {
			fail("multiple primary keys")
		}
		tables[name] = &Table{name: name, cols: cols}
		out.WriteString("ok\n")
	case p.acceptKw("DROP"):
		p.expectKw("TABLE")
		name := p.ident()
		if p.peek().k != "eof" {
			fail("syntax error")
		}
		if _, ok := tables[name]; !ok {
			fail("no such table: %s", name)
		}
		delete(tables, name)
		out.WriteString("ok\n")
	case p.acceptKw("INSERT"):
		p.expectKw("INTO")
		name := p.ident()
		var cn []string
		if p.acceptOp("(") {
			for {
				cn = append(cn, p.ident())
				if !p.acceptOp(",") {
					break
				}
			}
			p.expectOp(")")
		}
		p.expectKw("VALUES")
		var vrows [][]*Expr
		for {
			p.expectOp("(")
			var r []*Expr
			for {
				r = append(r, p.expr())
				if !p.acceptOp(",") {
					break
				}
			}
			p.expectOp(")")
			vrows = append(vrows, r)
			if !p.acceptOp(",") {
				break
			}
		}
		if p.peek().k != "eof" {
			fail("syntax error")
		}
		t, ok := tables[name]
		if !ok {
			fail("no such table: %s", name)
		}
		idx := make([]int, 0)
		if cn == nil {
			for i := range t.cols {
				idx = append(idx, i)
			}
		} else {
			seen := map[string]bool{}
			for _, n := range cn {
				found := -1
				for i, c := range t.cols {
					if c.name == n {
						found = i
					}
				}
				if found < 0 {
					fail("no such column: %s", n)
				}
				if seen[n] {
					fail("duplicate column: %s", n)
				}
				seen[n] = true
				idx = append(idx, found)
			}
		}
		var newRows [][]Val
		for _, r := range vrows {
			if len(r) != len(idx) {
				fail("wrong number of values")
			}
			row := make([]Val, len(t.cols))
			for k, e := range r {
				resolve(e, nil, nil, false, false, false)
				row[idx[k]] = eval(e, nil, nil)
			}
			checkRow(t, row, -1)
			newRows = append(newRows, row)
		}
		all := append(append([][]Val{}, t.rows...), newRows...)
		checkPK(t, all)
		t.rows = all
		fmt.Fprintf(&out, "inserted %d\n", len(newRows))
	case p.acceptKw("UPDATE"):
		name := p.ident()
		p.expectKw("SET")
		type asg struct {
			col string
			e   *Expr
		}
		var as []asg
		for {
			c := p.ident()
			p.expectOp("=")
			as = append(as, asg{c, p.expr()})
			if !p.acceptOp(",") {
				break
			}
		}
		var where *Expr
		if p.acceptKw("WHERE") {
			where = p.expr()
		}
		if p.peek().k != "eof" {
			fail("syntax error")
		}
		t, ok := tables[name]
		if !ok {
			fail("no such table: %s", name)
		}
		var scope []ScopeCol
		for _, c := range t.cols {
			scope = append(scope, ScopeCol{name, c.name})
		}
		cidx := make([]int, len(as))
		for i, a := range as {
			cidx[i] = -1
			for j, c := range t.cols {
				if c.name == a.col {
					cidx[i] = j
				}
			}
			if cidx[i] < 0 {
				fail("no such column: %s", a.col)
			}
		}
		for _, a := range as {
			resolve(a.e, scope, nil, false, false, false)
		}
		if where != nil {
			resolve(where, scope, nil, false, false, false)
		}
		newRows := make([][]Val, len(t.rows))
		n := 0
		for ri, r := range t.rows {
			nr := append([]Val{}, r...)
			newRows[ri] = nr
			if where != nil {
				b, nl := asBool(eval(where, r, nil))
				if nl || !b {
					continue
				}
			}
			n++
			for i, a := range as {
				nr[cidx[i]] = eval(a.e, r, nil)
			}
			checkRow(t, nr, -1)
		}
		checkPK(t, newRows)
		t.rows = newRows
		fmt.Fprintf(&out, "updated %d\n", n)
	case p.acceptKw("DELETE"):
		p.expectKw("FROM")
		name := p.ident()
		var where *Expr
		if p.acceptKw("WHERE") {
			where = p.expr()
		}
		if p.peek().k != "eof" {
			fail("syntax error")
		}
		t, ok := tables[name]
		if !ok {
			fail("no such table: %s", name)
		}
		var scope []ScopeCol
		for _, c := range t.cols {
			scope = append(scope, ScopeCol{name, c.name})
		}
		if where != nil {
			resolve(where, scope, nil, false, false, false)
		}
		var kept [][]Val
		n := 0
		for _, r := range t.rows {
			del := true
			if where != nil {
				b, nl := asBool(eval(where, r, nil))
				del = !nl && b
			}
			if del {
				n++
			} else {
				kept = append(kept, r)
			}
		}
		t.rows = kept
		fmt.Fprintf(&out, "deleted %d\n", n)
	case p.acceptKw("SELECT"):
		s := p.selectStmt()
		if p.peek().k != "eof" {
			fail("syntax error")
		}
		runSelect(s)
	default:
		fail("syntax error")
	}
}

func main() {
	data, _ := io.ReadAll(bufio.NewReader(os.Stdin))
	for _, st := range split(string(data)) {
		func() {
			defer func() {
				if r := recover(); r != nil {
					e, ok := r.(SQLErr)
					if !ok {
						panic(r)
					}
					out.WriteString("error: " + e.msg + "\n")
				}
			}()
			execute(st)
		}()
	}
	os.Stdout.Write([]byte(out.String()))
}
