import {stdin, stdout, read_line} from "@std/io.ms"

fn parse_num(s: String) Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() < 1 or codes.length() > 6:
        return none

    var n = 0

    for c in codes:
        if c < 48 or c > 57:
            return none

        n = n * 10 + (c - 48)

    return some(n)

fn min_int(a: Int, b: Int) Int:
    if a < b:
        return a

    return b

fn max_int(a: Int, b: Int) Int:
    if a > b:
        return a

    return b

fn lcs(a: String, b: String) Int:
    let x = a.scalar_values()
    let y = b.scalar_values()
    var prev = List[Int]()
    var j = 0

    while j <= y.length():
        prev.append(0)
        j = j + 1

    for ch in x:
        let cur = List[Int]()
        cur.append(0)
        j = 0

        while j < y.length():
            if ch == y.at(j).get():
                cur.append(prev.at(j).get() + 1)
            else:
                cur.append(max_int(prev.at(j + 1).get(), cur.at(j).get()))

            j = j + 1

        prev = cur

    return prev.at(y.length()).get()

fn edit(a: String, b: String) Int:
    let x = a.scalar_values()
    let y = b.scalar_values()
    var prev = List[Int]()
    var j = 0

    while j <= y.length():
        prev.append(j)
        j = j + 1

    var i = 1

    while i <= x.length():
        let cur = List[Int]()
        cur.append(i)
        j = 1

        while j <= y.length():
            var sub = 1
            if x.at(i - 1).get() == y.at(j - 1).get():
                sub = 0
            let best = min_int(
                min_int(
                    prev.at(j).get() + 1,
                    (cur.at(j - 1).get() + 1)
                ),
                (prev.at((j - 1)).get() + sub)
            )
            cur.append(best)
            j = j + 1

        prev = cur
        i = i + 1

    return prev.at(y.length()).get()

fn knap(t: List[String]) String:
    if t.length() < 2:
        return "error: bad command"

    let cap_opt = parse_num(t.at(1).get())
    if cap_opt.is_none():
        return "error: bad command"

    let capacity = cap_opt.get()
    let best = List[Int]()
    var c = 0

    while c <= capacity:
        best.append(0)
        c = c + 1

    var i = 2

    while i < t.length():
        let p = t.at(i).get().split(":")
        if p.length() != 2:
            return "error: bad command"

        let w_opt = parse_num(p.at(0).get())
        let v_opt = parse_num(p.at(1).get())
        if w_opt.is_none() or v_opt.is_none() or w_opt.get() < 1:
            return "error: bad command"

        let w = w_opt.get()
        let v = v_opt.get()
        c = capacity

        while c >= w:
            let candidate = best.at(c - w).get() + v
            if candidate > best.at(c).get():
                best.set(c, candidate)
            c = c - 1

        i = i + 1

    return "{best.at(capacity).get()}"

fn coins(t: List[String]) String:
    if t.length() < 3:
        return "error: bad command"

    let amount_opt = parse_num(t.at(1).get())
    if amount_opt.is_none():
        return "error: bad command"

    let amount = amount_opt.get()
    let cs = List[Int]()
    var i = 2

    while i < t.length():
        let c = parse_num(t.at(i).get())
        if c.is_none() or c.get() < 1:
            return "error: bad command"

        cs.append(c.get())
        i = i + 1

    let inf = 1000000000
    let best = List[Int]()
    best.append(0)
    var a = 1

    while a <= amount:
        var here = inf
        for c in cs:
            if c <= a and best.at(a - c).get() + 1 < here:
                here = best.at(a - c).get() + 1
        best.append(here)
        a = a + 1

    let answer = best.at(amount).get()
    if answer >= inf:
        return "impossible"

    return "{answer}"

fn solve_line(line: String) String:
    let t = line.split(" ")
    let name = t.at(0).get()

    if name == "lcs" or name == "edit":
        if (
            t.length() != 3
            or t.at(1).get().is_empty()
            or t.at(2).get().is_empty()
        ):
            return "error: bad command"
        if name == "lcs":
            return "{lcs(t.at(1).get(), t.at(2).get())}"

        return "{edit(t.at(1).get(), t.at(2).get())}"

    if name == "knap":
        return knap(t)
    if name == "coins":
        return coins(t)

    return "error: bad command"

fn run() Result[Unit, Error]:
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break

        let line = next.get()
        if line.replace_all(old: " ", new: "").get().is_empty():
            continue

        try stdout().write("{solve_line(line)}\n".to_bytes())

    return stdout().flush()

export fn main() Int:
    match run():
        ok(_): return 0
        error(_): return 1
