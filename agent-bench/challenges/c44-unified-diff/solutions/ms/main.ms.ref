import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

fn fields(line: String) List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").get()
    return spaced.split(" ").filter(
        fn(part: String) Bool:
            return not part.is_empty()
    )

fn range_text(start: Int, len: Int) String:
    var s = start
    if len > 0:
        s = s + 1
    if len == 1:
        return "{s}"

    return "{s},{len}"

fn marker(kind: Int) String:
    if kind == 0:
        return " "
    if kind == 1:
        return "-"

    return "+"

fn count_before(kinds: List[Int], end: Int, skip: Int) Int:
    var total = 0
    var k = 0

    while k < end:
        if kinds.at(k).get() != skip:
            total = total + 1
        k = k + 1

    return total

fn count_between(kinds: List[Int], start: Int, end: Int, skip: Int) Int:
    var total = 0
    var k = start

    while k < end:
        if kinds.at(k).get() != skip:
            total = total + 1
        k = k + 1

    return total

fn run() Result[Unit, Error]:
    let first = try read_line(input: stdin(), max_bytes: 1048576)
    if first.is_none():
        return ok(unit)

    let h = fields(first.get())
    let name_a = h.at(0).get()
    let name_b = h.at(1).get()
    let ctx = h.at(2).get().parse_int().get()
    let n = h.at(3).get().parse_int().get()
    let m = h.at(4).get().parse_int().get()
    let a = List[String]()
    let b = List[String]()
    var count = 0

    while count < n + m:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break

        if count < n:
            a.append(next.get())
        else:
            b.append(next.get())

        count = count + 1

    let w = m + 1
    let table = List[Int]()
    var cells = (n + 1) * w

    while cells > 0:
        table.append(0)
        cells = cells - 1

    var i = n - 1

    while i >= 0:
        var j = m - 1

        while j >= 0:
            var v = 0

            if a.at(i).get() == b.at(j).get():
                v = table.at((i + 1) * w + j + 1).get() + 1
            else:
                let down = table.at((i + 1) * w + j).get()
                let right = table.at(i * w + j + 1).get()

                if down >= right:
                    v = down
                else:
                    v = right

            table.set(i * w + j, v)
            j = j - 1

        i = i - 1

    let kinds = List[Int]()
    let texts = List[String]()
    i = 0
    var j = 0

    while i < n or j < m:
        if i < n and j < m and a.at(i).get() == b.at(j).get():
            kinds.append(0)
            texts.append(a.at(i).get())
            i = i + 1
            j = j + 1
        else if (
            j == m
            or (
                i < n
                and table.at((i + 1) * w + j).get() >= table.at(
                    (i * w + j + 1)
                ).get()
            )
        ):
            kinds.append(1)
            texts.append(a.at(i).get())
            i = i + 1
        else:
            kinds.append(2)
            texts.append(b.at(j).get())
            j = j + 1

    let changes = List[Int]()
    var k = 0

    while k < kinds.length():
        if kinds.at(k).get() != 0:
            changes.append(k)
        k = k + 1

    if changes.is_empty():
        return ok(unit)

    let out = StringBuilder()
    out.append("--- {name_a}\n+++ {name_b}\n")
    var lo_change = changes.at(0).get()
    var prev = lo_change
    var idx = 1

    while idx <= changes.length():
        var split = idx == changes.length()

        if not split:
            let cur = changes.at(idx).get()
            split = cur - prev - 1 > 2 * ctx
            if not split:
                prev = cur

        if split:
            var lo = lo_change - ctx
            if lo < 0:
                lo = 0
            var hi = prev + 1 + ctx
            if hi > kinds.length():
                hi = kinds.length()
            let sa = count_before(kinds, lo, 2)
            let sb = count_before(kinds, lo, 1)
            let la = count_between(kinds, lo, hi, 2)
            let lb = count_between(kinds, lo, hi, 1)
            out.append("@@ -{range_text(sa, la)} +{range_text(sb, lb)} @@\n")
            var q = lo

            while q < hi:
                out.append(marker(kinds.at(q).get()))
                out.append(texts.at(q).get())
                out.append("\n")
                q = q + 1

            if idx < changes.length():
                lo_change = changes.at(idx).get()
                prev = lo_change

        idx = idx + 1

    try stdout().write(out.freeze().to_bytes())
    return stdout().flush()

export fn main() Int:
    match run():
        ok(_): return 0
        error(_): return 1
