// conform: tags=functions,tier-core
// conform: phase=run
import BigInt, parse_big_int from "@std/math/math.ms"

fn parse(text String) BigInt {
	return parse_big_int(text, 10, null).get()
}

// Seven hundred calls in one function. Every call that can fail leaves through an exit
// that drops what is owned there, so the exits once repeated every earlier owner: the
// compiler needed memory in proportion to the square of the length.
fn main() Void {
	a := parse("123456789012345678901234567890")
	b := parse("987654321")
	var total = 0
	total += a.add(b).to_string().length()
	total += a.add(b).to_string().length()
