import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	s1 := "emoji 😀".upper().lower()
	say(f"s1 = [{s1}]")
	say(f"collatz(1275) = {collatz(1275)}")

	i2 := ((((-26) * (-405936271935)) - (-944831251255)) + (-((-47) * (-710768722292))))
	say(f"i2 = {i2}")

	i3 := (((i2 - 35) - (i2 + (-25))) % (i2 / (-(-14))))
	say(f"i3 = {i3}")

	s4 := "naïve"
	say(f"s4 = [{s4}]")

	i5 := i2
	say(f"i5 = {i5}")

	s6 := (s4.lower() + s1)
	say(f"s6 = [{s6}]")

	b7 := (i3 < ((895859 + i5) + s6.scalar_length()))
	say(f"b7 = {b7}")

	l8 := [2, 12]
	say(f"l8 = {l8} len {l8.length()}")

	var acc9 = 0

	for x in l8 {
		if x % 2 == 0 {
			acc9 += x
		} else {
			acc9 -= 1
		}
	}

	say(f"acc9 = {acc9}")

	b10 := (
		(s4.is_empty() and "  padded  ".is_empty())
		or ("line\nbreak" + "delta").starts_with("alpha")
	)
	say(f"b10 = {b10}")

	i11 := s6.scalar_length()
	say(f"i11 = {i11}")

	l12 := [9]
	say(f"l12 = {l12} len {l12.length()}")
	say(
		f"{9223372036854775806} {(-903656)} {(9223372036854775806 < (-903656))} sum {9223372036854775806 + (-903656)}"
	)
	return 0
}
