import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	say(
		f"{(254479 * 0)} {((11 * 198962485691) * (-(-7)))} {((254479 * 0) < ((11 * 198962485691) * (-(-7))))} sum {(254479 * 0) + ((11 * 198962485691) * (-(-7)))}"
	)

	b1 := false
	say(f"b1 = {b1}")

	i2 := (((39 - 567034) - 20) - ((812287999387 - (-105088025967)) - (43 + 32)))
	say(f"i2 = {i2}")

	b3 := b1
	say(f"b3 = {b3}")

	s4 := "emoji 😀"
	say(f"s4 = [{s4}]")

	i5 := (-50)
	say(f"i5 = {i5}")

	s6 := ("日本語" + "日本語").trim()
	say(f"s6 = [{s6}]")

	l7 := [(-19), (-24), 17, (-8)]
	say(f"l7 = {l7} len {l7.length()}")

	i8 := (46 * (-41))
	say(f"i8 = {i8}")

	f9 := 3.0e-1
	say(f"f9 = {f9}")
	say(f"fib(31) = {fib(31)}")

	b10 := b1
	say(f"b10 = {b10}")
	say(f"gcd(925, 2241) = {gcd(925, 2241)}")

	l11 := [8]
	say(f"l11 = {l11} len {l11.length()}")

	l12 := l11.sorted((a, b) => a.compare(b))
	say(f"l12 = {l12} len {l12.length()}")
	return 0
}
