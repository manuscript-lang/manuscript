	)

	b1 := false
	say(f"b1 = {b1}")

	i2 := (((39 - 567034) - 20) - ((812287999387 - (-105088025967)) - (43 + 32)))
	say(f"i2 = {i2}")

	b3 := b1
	say(f"b3 = {b3}")

	s4 := "emoji 😀"
	say(f"s4 = [{s4}]")

	i5 := (-50)
	say(f"i5 = {i5}")

	s6 := ("日本語" + "日本語").trim()
	say(f"s6 = [{s6}]")

	l7 := [(-19), (-24), 17, (-8)]
	say(f"l7 = {l7} len {l7.length()}")

