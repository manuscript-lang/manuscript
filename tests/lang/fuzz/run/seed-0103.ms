import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	l1 := [(-27), 10, 27, (-25), 12]
	say(f"l1 = {l1} len {l1.length()}")
	say(f"fib(35) = {fib(35)}")

	i2 := (-40)
	say(f"i2 = {i2}")

	f3 := ((409.433 * (638.343 + 5.5)) / (0.0 * (373.098 * 253.371)))
	say(f"f3 = {f3}")

	i4 := ((i2 - ((-856867984659) / i2)) * ((i2 % i2) % (i2 + 35)))
	say(f"i4 = {i4}")

	i5 := (-4)
	say(f"i5 = {i5}")

	s6 := (f"{(-(-808402999828))}:" + "日本語")
	say(f"s6 = [{s6}]")
	say(f"gcd(4058, 3244) = {gcd(4058, 3244)}")

	s7 := ((f"{(i2 + i2)}:" + (f"{(-12)}:" + "")) + s6.trim())
	say(f"s7 = [{s7}]")

	i8 := (10 - l1[1])
	say(f"i8 = {i8}")

	i9 := ((97925 * (i4 * i5)) * (((-43) + (-161369)) + (-49)))
	say(f"i9 = {i9}")

	var acc10 = 0

	for x in l1 {
		if x % 2 == 0 {
			acc10 += x
		} else {
			acc10 -= 1
		}
	}

	say(f"acc10 = {acc10}")

	i11 := i8
	say(f"i11 = {i11}")

	s12 := s6.trim()
	say(f"s12 = [{s12}]")
	say(f"gcd(3384, 4220) = {gcd(3384, 4220)}")

	i13 := 529666518520
	say(f"i13 = {i13}")
	return 0
}
