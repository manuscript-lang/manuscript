import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	i1 := 18
	say(f"i1 = {i1}")

	l2 := [2, 14, (-12), 29, 21]
	say(f"l2 = {l2} len {l2.length()}")

	s3 := "日本語".reverse()
	say(f"s3 = [{s3}]")

	l4 := l2.concat(l2)
	say(f"l4 = {l4} len {l4.length()}")

	var acc5 = 0
	var stepacc5 = 0

	while stepacc5 < 3 {
		stepacc5 += 1
		acc5 += stepacc5 * stepacc5 + 3
	}

	say(f"acc5 = {acc5}")
	say(
		f"{18} {(i1 * (i1 + i1))} {(18 < (i1 * (i1 + i1)))} sum {18 + (i1 * (i1 + i1))}"
	)

	i6 := (((-i1) * (i1 + i1)) + ((i1 - i1) * (-29)))
	say(f"i6 = {i6}")

	if true {
		say(s3.trim())
	} else {
		say("héllo")
	}

	var acc7 = 0

	for x in l2 {
		if x % 2 == 0 {
			acc7 += x
		} else {
			acc7 -= 1
		}
	}

	say(f"acc7 = {acc7}")

	var acc8 = 0
	var stepacc8 = 0

	while stepacc8 < 1 {
		stepacc8 += 1
		acc8 += stepacc8 * stepacc8 + (-4)
	}

	say(f"acc8 = {acc8}")

	b9 := "Tab\there".is_empty()
	say(f"b9 = {b9}")
	say(
		f"{s3.scalar_length()} {((i6 - i6) / (i6 * (-41)))} {(s3.scalar_length() < ((i6 - i6) / (i6 * (-41))))} sum {s3.scalar_length() + ((i6 - i6) / (i6 * (-41)))}"
	)

	big10 := 9223372036854775807
	say(f"{big10 * 2}")
	return 0
}
