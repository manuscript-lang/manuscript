import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	s1 := "line\nbreak"
	say(f"s1 = [{s1}]")

	i2 := ((-150258) + ((26 - 314536088144) * (39 * 414346)))
	say(f"i2 = {i2}")

	s3 := s1
	say(f"s3 = [{s3}]")

	i4 := i2
	say(f"i4 = {i4}")
	say(
		f"{((i2 % i4) + (-i2))} {(((-3) + i4) / ((-225053) + i4))} {(((i2 % i4) + (-i2)) < (((-3) + i4) / ((-225053) + i4)))} sum {((i2 % i4) + (-i2)) + (((-3) + i4) / ((-225053) + i4))}"
	)

	f5 := (((783.259 + 603.966) + (908.031 + 945.536)) - 199.409)
	say(f"f5 = {f5}")

	l6 := [(-15), (-2)]
	say(f"l6 = {l6} len {l6.length()}")

	s7 := ((s3 + "quote\"d").upper() + s3)
	say(f"s7 = [{s7}]")

	b8 := (f5 > f5)
	say(f"b8 = {b8}")
	return 0
}
