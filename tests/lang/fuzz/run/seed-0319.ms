import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	l1 := [1]
	say(f"l1 = {l1} len {l1.length()}")

	i2 := (49 + (33 + (-35)))
	say(f"i2 = {i2}")

	s3 := (
		(f"{(i2 * 8)}:" + (f"{(-24)}:" + "alpha"))
		+ (("line\nbreak" + "beta") + "back\\slash")
	)
	say(f"s3 = [{s3}]")

	l4 := [(-26), (-26), (-21), (-26), 16]
	say(f"l4 = {l4} len {l4.length()}")

	b5 := (i2 <= (-(-(-793245))))
	say(f"b5 = {b5}")

	i6 := ((-11) + ((41 % i2) % (-28)))
	say(f"i6 = {i6}")
	say(
		f"{i6} {((i6 % i6) - (i2 % i2))} {(i6 < ((i6 % i6) - (i2 % i2)))} sum {i6 + ((i6 % i6) - (i2 % i2))}"
	)

	b7 := ("back\\slash".lower() + "").contains(s3)
	say(f"b7 = {b7}")

	b8 := true
	say(f"b8 = {b8}")
	say(f"collatz(815) = {collatz(815)}")
	return 0
}
