import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	b2 := (("MiXeD CaSe" + "delta").is_empty() and true)
	say(f"b2 = {b2}")

	s3 := "MiXeD CaSe"
	say(f"s3 = [{s3}]")

	var acc4 = 0
	var stepacc4 = 0

	while stepacc4 < 0 {
		stepacc4 += 1
		acc4 += stepacc4 * stepacc4 + (-5)
	}

	say(f"acc4 = {acc4}")
	say(f"fact(2) = {fact(2)}")

	f5 := 186.396
	say(f"f5 = {f5}")
	return 0
}
// expect-exit: 0
// expect-stdout: b2 = false
// expect-stdout: s3 = [MiXeD CaSe]
// expect-stdout: acc4 = 0
// expect-stdout: fact(2) = 2
// expect-stdout: f5 = 186.396
