import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	say(f"fact(18) = {fact(18)}")

	i1 := ((-575426) / (-(-17)))
	say(f"i1 = {i1}")

	f2 := (2.0e5 + ((0.0 * 60.240) * (141.538 - 535.25)))
	say(f"f2 = {f2}")
	say(
		f"{(i1 + (-42))} {((i1 % 747839) / (316128 - 34))} {((i1 + (-42)) < ((i1 % 747839) / (316128 - 34)))} sum {(i1 + (-42)) + ((i1 % 747839) / (316128 - 34))}"
	)

	i3 := i1
	say(f"i3 = {i3}")

	s4 := "naïve".upper()
	say(f"s4 = [{s4}]")

	i5 := ((269204 + i3) - ((i1 + i3) % (i1 + i1)))
	say(f"i5 = {i5}")
	say(f"fib(16) = {fib(16)}")
	say(f"fib(10) = {fib(10)}")
	return 0
}
