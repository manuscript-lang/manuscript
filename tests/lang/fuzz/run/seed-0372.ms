	)

	var l8 = l7.clone()
	l8.append(83)
	say(f"l8 = {l8} len {l8.length()}")

	l9 := l8.concat(l8)
	say(f"l9 = {l9} len {l9.length()}")

	b10 := b3
	say(f"b10 = {b10}")

	f11 := (
		((4.0e-4 + 0.0) / (195.617 - 507.790))
		* ((163.020 * 36.185) / (653.25 * 481.504))
	)
	say(f"f11 = {f11}")

	i12 := 3
	say(f"i12 = {i12}")

	s13 := ("hello world" + (s2 + (f"{(i12 * i4)}:" + "ms")))
	say(f"s13 = [{s13}]")

	f14 := ((f11 * (f11 / f11)) / ((f11 / 635.578) * f11))
	say(f"f14 = {f14}")

	var acc15 = 0

	for x in l9 {
		if x % 2 == 0 {
			acc15 += x
		} else {
			acc15 -= 1
		}
	}

	say(f"acc15 = {acc15}")

	i16 := (((i4 / i12) + 914532) + i12)
	say(f"i16 = {i16}")

	f17 := f11
	say(f"f17 = {f17}")

	l18 := l7.map(x => x + 2).filter(x => x % 2 == 0)
	say(f"l18 = {l18} len {l18.length()}")
	return 0
}
