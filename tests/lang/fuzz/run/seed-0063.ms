import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	i1 := 20
	say(f"i1 = {i1}")

	i2 := (((i1 + i1) / 488514) * i1)
	say(f"i2 = {i2}")

	b3 := ((true or (false or true)) or (not (not true)))
	say(f"b3 = {b3}")

	s4 := (f"{(i1 + 24)}:" + "日本語")
	say(f"s4 = [{s4}]")

	i5 := i2
	say(f"i5 = {i5}")

	i6 := 47
	say(f"i6 = {i6}")

	i8 := i6
	say(f"i8 = {i8}")

	l9 := [22, 9]
	say(f"l9 = {l9} len {l9.length()}")

	if ((true or b3) and ("back\\slash" == "quote\"d")) {
		say(s4.lower())
	} else {
		say("brace{s}")
	}

	return 0
}
// expect-exit: 0
