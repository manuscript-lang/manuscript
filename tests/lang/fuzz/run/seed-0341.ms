// expect-stdout: i4 = 211567
// expect-stdout: b5 = true
// expect-stdout: b6 = true
// expect-stdout: f7 = 70000000000056.11
// expect-stdout: s8 = [quote"d]
// expect-stdout: f9 = 70000000000056.11
