import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	say(
		f"{((-37) - ((-9) + 30949623862))} {123806} {(((-37) - ((-9) + 30949623862)) < 123806)} sum {((-37) - ((-9) + 30949623862)) + 123806}"
	)

	s1 := (f"{(-790589256237)}:" + "")
	say(f"s1 = [{s1}]")

	i2 := (-44)
	say(f"i2 = {i2}")

	if (not s1.is_empty()) {
		say("  padded  ".trim())
	} else {
		say(s1.lower())
	}

	l3 := [(-2)]
	say(f"l3 = {l3} len {l3.length()}")
	say(f"fact(2) = {fact(2)}")

	i4 := ((-11) + ((18 * i2) * (i2 + (-23))))
	say(f"i4 = {i4}")

	i5 := i2
	say(f"i5 = {i5}")

	var acc6 = 0

	for x in l3 {
		if x % 2 == 0 {
			acc6 += x
		} else {
			acc6 -= 1
		}
	}

	say(f"acc6 = {acc6}")

	f7 := (
		((1.0e14 + 373.362) + (3.5 / 9.0e21))
		- ((176.741 - 0.0) / (246.779 * 291.25))
	)
	say(f"f7 = {f7}")

	i8 := i2
	say(f"i8 = {i8}")

	var l9 = l3.clone()
	l9.append(92)
	say(f"l9 = {l9} len {l9.length()}")

	s10 := s1
	say(f"s10 = [{s10}]")

	i11 := i8
	say(f"i11 = {i11}")

	var acc12 = 0
	for i in 0..8 {
		acc12 += i * 5
	}
	say(f"acc12 = {acc12}")
	return 0
}
