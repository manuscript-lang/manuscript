	say(f"l7 = {l7} len {l7.length()}")

	b8 := ((-(i1 * i5)) == ((i3 / i5) - ((-9) + (-8))))
	say(f"b8 = {b8}")

	i9 := (((i3 - 32) - ((-48) * i1)) % i1)
	say(f"i9 = {i9}")

	l10 := [21, 5]
	say(f"l10 = {l10} len {l10.length()}")

	i11 := (i5 / (((-39) * i5) - (-211509)))
	say(f"i11 = {i11}")

	i12 := s4.scalar_length()
	say(f"i12 = {i12}")
	say(
		f"{(s4.scalar_length() + (i1 * i5))} {(-5)} {((s4.scalar_length() + (i1 * i5)) < (-5))} sum {(s4.scalar_length() + (i1 * i5)) + (-5)}"
	)

	i13 := (-26)
	say(f"i13 = {i13}")

	f14 := ((f6 + (f2 + f2)) + ((133.398 / f2) + f2))
	say(f"f14 = {f14}")
