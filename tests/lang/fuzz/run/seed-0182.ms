import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	i1 := (-37)
	say(f"i1 = {i1}")
	say(f"collatz(522) = {collatz(522)}")
	say(f"{(i1 / 25)} {42} {((i1 / 25) < 42)} sum {(i1 / 25) + 42}")

	s3 := "x".replace("naïve", "").lower()
	say(f"s3 = [{s3}]")

	i4 := i1
	say(f"i4 = {i4}")
	return 0
}
