import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	f1 := ((228.023 * (154.682 * 184.169)) + (517.609 * 696.722))
	say(f"f1 = {f1}")

	l2 := [7, (-26), (-27), 5]
	say(f"l2 = {l2} len {l2.length()}")

	var acc3 = 0

	for x in l2 {
		if x % 2 == 0 {
			acc3 += x
		} else {
			acc3 -= 1
		}
	}

	say(f"acc3 = {acc3}")

	s4 := "gamma"
	say(f"s4 = [{s4}]")

	i5 := (-4)
	say(f"i5 = {i5}")

	b6 := (s4 == "line\nbreak")
	say(f"b6 = {b6}")
	say(f"fib(47) = {fib(47)}")

	b7 := ("hello world".replace(s4, "back\\slash") + (s4 + "MiXeD CaSe")).starts_with(
		"brace{s}"
	)
	say(f"b7 = {b7}")

	f8 := (f1 + ((552.993 * 92.811) + (76.026 * 964.25)))
	say(f"f8 = {f8}")
	return 0
}
