import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	f1 := (
		((508.299 / 254.218) + (197.077 / 774.188))
		* ((7.5 * 4.0e22) + (278.587 * 1.0e5))
	)
	say(f"f1 = {f1}")

	l2 := [2, 4, 29]
	say(f"l2 = {l2} len {l2.length()}")

	l3 := l2.drop(4)
	say(f"l3 = {l3} len {l3.length()}")

	i4 := (-25)
	say(f"i4 = {i4}")

	b5 := "  padded  ".is_empty()
	say(f"b5 = {b5}")
	say(f"fib(45) = {fib(45)}")

	l6 := l2.concat(l2)
	say(f"l6 = {l6} len {l6.length()}")

	var acc7 = 0

	for x in l2 {
		if x % 2 == 0 {
			acc7 += x
		} else {
			acc7 -= 1
		}
	}

	say(f"acc7 = {acc7}")

	f8 := (992.987 + ((f1 + f1) + (f1 * f1)))
	say(f"f8 = {f8}")

	f9 := (((f8 + 8.0e21) * f8) + ((f1 * 4.5) + 3.0e-4))
	say(f"f9 = {f9}")
	say(f"fib(44) = {fib(44)}")
	return 0
}
