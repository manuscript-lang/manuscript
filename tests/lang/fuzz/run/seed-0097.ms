import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	l1 := [3, (-14)]
	say(f"l1 = {l1} len {l1.length()}")

	i2 := l1.length()
	say(f"i2 = {i2}")
	say(
		f"{((34 % i2) / i2)} {i2} {(((34 % i2) / i2) < i2)} sum {((34 % i2) / i2) + i2}"
	)

	b3 := (((i2 - (-15)) * l1.length()) > ((i2 + 36) + 16))
	say(f"b3 = {b3}")

	s4 := (
		"ms".replace("line\nbreak", "")
		+ (f"{(i2 + (-15))}:" + ("42" + "hello world"))
	)
	say(f"s4 = [{s4}]")

	f5 := ((164.571 + (968.132 + 4.5)) / ((6.0e4 * 867.806) * 5.5))
	say(f"f5 = {f5}")
	say(f"fact(17) = {fact(17)}")

	b6 := (not b3)
	say(f"b6 = {b6}")

	s7 := ((f"{44}:" + s4).upper() + "hello world")
	say(f"s7 = [{s7}]")

	l8 := l1.map(x => x + 1).filter(x => x % 2 == 0)
	say(f"l8 = {l8} len {l8.length()}")

	b9 := "back\\slash".upper().is_empty()
	say(f"b9 = {b9}")

	f10 := (((33.607 / f5) + f5) * ((f5 + 860.720) + (2.5 * 0.5)))
	say(f"f10 = {f10}")

	i11 := i2
	say(f"i11 = {i11}")

	f12 := (((6.5 - f10) - (859.449 - f5)) + ((f5 - 383.540) + (138.046 * f10)))
	say(f"f12 = {f12}")

	s13 := (("a" + s4).trim() + (f"{42}:" + (s7 + "Tab\there")))
	say(f"s13 = [{s13}]")

	l14 := [(-16), 18]
	say(f"l14 = {l14} len {l14.length()}")

	l15 := l8.map(x => x + 3).filter(x => x % 2 == 0)
	say(f"l15 = {l15} len {l15.length()}")

	l16 := l1.concat(l1)
	say(f"l16 = {l16} len {l16.length()}")

	i17 := (((159343 * i2) + (-27)) - 43)
	say(f"i17 = {i17}")
	return 0
}
