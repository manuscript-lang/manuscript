import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	s1 := "alpha".upper().lower().lower()
	say(f"s1 = [{s1}]")

	b2 := (56.191 < 3.5)
	say(f"b2 = {b2}")

	i3 := s1.scalar_length()
	say(f"i3 = {i3}")
	say(
		f"{(21 - (i3 / i3))} {(-((-884288) + (-43)))} {((21 - (i3 / i3)) < (-((-884288) + (-43))))} sum {(21 - (i3 / i3)) + (-((-884288) + (-43)))}"
	)

	s4 := (s1.replace("back\\slash", s1).reverse() + "42".lower())
	say(f"s4 = [{s4}]")

	b5 := "brace{s}".contains("back\\slash")
	say(f"b5 = {b5}")

	f6 := (5.5 / 896.126)
	say(f"f6 = {f6}")

	f7 := (((f6 + f6) + 0.0) + (0.0 + (582.599 + f6)))
	say(f"f7 = {f7}")

	f8 := (((f6 * 564.389) - (f6 - f6)) * (f6 * 959.287))
	say(f"f8 = {f8}")

	var acc9 = 0
	var stepacc9 = 0

	while stepacc9 < 5 {
		stepacc9 += 1
		acc9 += stepacc9 * stepacc9 + (-3)
	}

	say(f"acc9 = {acc9}")
	say(f"gcd(3028, 2461) = {gcd(3028, 2461)}")
	say(f"fib(7) = {fib(7)}")

	b10 := not "42".replace(s4, s1).is_empty()
	say(f"b10 = {b10}")

	b11 := (not ((not true) and (not b2)))
	say(f"b11 = {b11}")
	return 0
}
