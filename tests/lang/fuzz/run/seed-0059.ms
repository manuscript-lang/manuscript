import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	s1 := "日本語"
	say(f"s1 = [{s1}]")

	i2 := (((-21) * (45 + (-22))) + ((818656 - 41) + (-562737689021)))
	say(f"i2 = {i2}")

	s3 := "emoji 😀"
