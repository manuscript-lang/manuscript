import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	l1 := [(-9), (-17), (-20), (-13), 26]
	say(f"l1 = {l1} len {l1.length()}")

	s2 := (
		("delta".lower() + "emoji 😀".lower())
		+ (f"{(330982 + 40)}:" + ("delta" + "x"))
	)
	say(f"s2 = [{s2}]")
	say(
		f"{(((-22) / (-45)) - 8)} {755473} {((((-22) / (-45)) - 8) < 755473)} sum {(((-22) / (-45)) - 8) + 755473}"
	)

	var acc3 = 0
	var stepacc3 = 0

	while stepacc3 < 8 {
		stepacc3 += 1
		acc3 += stepacc3 * stepacc3 + 6
	}

	say(f"acc3 = {acc3}")

	f4 := (0.0 + ((6.5 + 534.693) * (0.0 + 129.670)))
	say(f"f4 = {f4}")

	f5 := (134.121 * (185.25 + (825.398 * 244.004)))
	say(f"f5 = {f5}")

	l6 := [(-27), (-2)]
	say(f"l6 = {l6} len {l6.length()}")
	return 0
}
