import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	say(f"gcd(440, 4081) = {gcd(440, 4081)}")

	l1 := [1, 2, 3].take(0)
	say(f"l1 = {l1} len {l1.length()}")
	say(f"{(-21)} {((-4) * 40)} {((-21) < ((-4) * 40))} sum {(-21) + ((-4) * 40)}")

	f2 := (3.0e9 * ((0.0 - 404.283) + (960.620 * 455.994)))
	say(f"f2 = {f2}")
	say(
		f"{((-8) / ((-20) % 15))} {47} {(((-8) / ((-20) % 15)) < 47)} sum {((-8) / ((-20) % 15)) + 47}"
	)

	f3 := (((f2 * f2) * (f2 * f2)) + ((f2 * 248.904) + (0.0 + f2)))
	say(f"f3 = {f3}")

	i4 := (((38 % (-36)) + (-47)) * (-47))
	say(f"i4 = {i4}")

	l5 := l1.map(x => x * 9)
	say(f"l5 = {l5} len {l5.length()}")

	s6 := ("héllo" + "emoji 😀".trim())
	say(f"s6 = [{s6}]")

	big7 := (833471 * (i4 * i4)) - (833471 * (i4 * i4))
	say(f"{(833471 * (i4 * i4)) % big7}")
	return 0
}
