import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	l1 := [(-3), (-16)]
	say(f"l1 = {l1} len {l1.length()}")

	s2 := (f"{208107077528}:" + "ms")
	say(f"s2 = [{s2}]")

	if (s2 == "MiXeD CaSe") {
		say("a".lower())
	} else {
		say("gamma".lower())
	}

	s3 := s2
	say(f"s3 = [{s3}]")

	i4 := (-17)
	say(f"i4 = {i4}")

	i5 := (((i4 * (-217896)) / i4) / (((-45) + i4) % (i4 + i4)))
	say(f"i5 = {i5}")

	i6 := (-(-12))
	say(f"i6 = {i6}")

	i7 := (-((i6 * i5) * (i5 + i6)))
	say(f"i7 = {i7}")

	l8 := [6, (-12), 15, (-17), (-29)]
	say(f"l8 = {l8} len {l8.length()}")

	var acc9 = 0
	var stepacc9 = 0

	while stepacc9 < 1 {
		stepacc9 += 1
		acc9 += stepacc9 * stepacc9 + 1
	}

	say(f"acc9 = {acc9}")
	return 0
}
