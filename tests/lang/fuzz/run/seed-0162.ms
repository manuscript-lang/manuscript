import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	l1 := [(-17), 2, (-29)]
	say(f"l1 = {l1} len {l1.length()}")

	b2 := false
	say(f"b2 = {b2}")

	i3 := 44
	say(f"i3 = {i3}")

	l4 := l1.drop(1)
	say(f"l4 = {l4} len {l4.length()}")

	var l5 = l4.clone()
	l5.append(83)
	say(f"l5 = {l5} len {l5.length()}")

	i6 := ((-(i3 + 34)) * i3)
	say(f"i6 = {i6}")

	s7 := "x".reverse().replace("a", "brace{s}").lower()
	say(f"s7 = [{s7}]")

	s8 := s7.upper().trim().lower()
	say(f"s8 = [{s8}]")

	f9 := ((985.092 / (0.0 + 163.524)) + (258.25 * 996.698))
	say(f"f9 = {f9}")

	i10 := (((-22) - 9) - ((36 / i6) % (21 % i6)))
	say(f"i10 = {i10}")

	if s7.reverse().ends_with(s8) {
		say("hello world".replace(s7, s7))
	} else {
		say(s7)
	}

	s11 := (("delta" + s8) + "naïve".trim()).trim()
	say(f"s11 = [{s11}]")

	b12 := true
	say(f"b12 = {b12}")
	say(f"fact(6) = {fact(6)}")

	if (not (b12 or true)) {
		say(("ms" + s7))
	} else {
		say("line\nbreak")
	}

	say(f"{l4[4]}")
	return 0
}
