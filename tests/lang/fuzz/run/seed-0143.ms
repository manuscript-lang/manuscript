import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	say(f"fib(52) = {fib(52)}")

	s1 := ("naïve" + "beta".trim().upper())
	say(f"s1 = [{s1}]")

	if (f"{22}:" + "quote\"d").starts_with("x") {
		say(s1.reverse())
	} else {
		say("")
	}

	l2 := [19, 7, 29, 26, (-5)]
	say(f"l2 = {l2} len {l2.length()}")

	s3 := "MiXeD CaSe".upper().reverse()
	say(f"s3 = [{s3}]")

	i4 := s3.scalar_length()
	say(f"i4 = {i4}")

	i5 := (19 * 27)
	say(f"i5 = {i5}")

	i6 := (((i5 / i4) + ((-466166) / i5)) + ((43 * i4) - (i5 * i5)))
	say(f"i6 = {i6}")

	i7 := i6
	say(f"i7 = {i7}")

	var acc8 = 0
	for i in 0..2 {
		acc8 += i * 5
	}
	say(f"acc8 = {acc8}")

	s9 := s1
	say(f"s9 = [{s9}]")

	b10 := ((298.997 + 5.0e2) == 811.908)
	say(f"b10 = {b10}")

	var acc11 = 0
	var stepacc11 = 0

	while stepacc11 < 8 {
		stepacc11 += 1
		acc11 += stepacc11 * stepacc11 + 3
	}

	say(f"acc11 = {acc11}")

	var acc12 = 0
	var stepacc12 = 0

	while stepacc12 < 3 {
		stepacc12 += 1
		acc12 += stepacc12 * stepacc12 + 0
	}

	say(f"acc12 = {acc12}")

	var acc13 = 0
	for i in 0..2 {
		acc13 += i * 9
	}
	say(f"acc13 = {acc13}")

	l14 := [(-19)]
	say(f"l14 = {l14} len {l14.length()}")

	f15 := 219.25
	say(f"f15 = {f15}")

	s16 := ((f"{i7}:" + "日本語".reverse()) + (f"{(-36)}:" + "  padded  "))
	say(f"s16 = [{s16}]")
	say(f"{l14[3]}")
	return 0
}
