import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	if ((-16) >= 39) {
		say(("Tab\there" + "beta"))
	} else {
		say(("  padded  " + ""))
	}

	l1 := [3, 10, 21]
	say(f"l1 = {l1} len {l1.length()}")

	if (false and (false or true)) {
		say("beta")
	} else {
		say("alpha".upper())
	}

	s2 := (f"{((-23) + (-46))}:" + "  padded  ")
	say(f"s2 = [{s2}]")
	say(f"{8} {66907} {(8 < 66907)} sum {8 + 66907}")

	i3 := (((16 * (-39)) % l1[0]) + ((-49) + ((-22) % 838420)))
	say(f"i3 = {i3}")
	return 0
}
