import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	s1 := (f"{((-322511095751) / (-5))}:" + "  padded  ").replace(
		"x",
		"brace{s}",
	).trim()
	say(f"s1 = [{s1}]")

	var acc2 = 0
	for i in 0..2 {
		acc2 += i * 7
	}
	say(f"acc2 = {acc2}")

	s3 := "gamma".lower().lower()
	say(f"s3 = [{s3}]")

	s4 := "naïve"
	say(f"s4 = [{s4}]")
	say(
		f"{(-(30 - 32))} {(4 - (-38))} {((-(30 - 32)) < (4 - (-38)))} sum {(-(30 - 32)) + (4 - (-38))}"
	)

	b6 := true
	say(f"b6 = {b6}")

	s7 := s4.clone()
	say(f"s7 = [{s7}]")

	f8 := (
		((3.0e21 * 854.955) * (665.241 - 29.807))
		/ ((637.878 + 8.5) + (357.830 + 8.0e21))
	)
	say(f"f8 = {f8}")

	i9 := (16550 + (998056 * (-12)))
	say(f"i9 = {i9}")

	s10 := s3.replace(s4, "beta").lower()
	say(f"s10 = [{s10}]")

	f11 := 156.551
	say(f"f11 = {f11}")

	i12 := (((-i9) / i9) / i9)
	say(f"i12 = {i12}")

	s14 := (("brace{s}".reverse() + (s3 + "Tab\there")) + (s1 + "x".lower()))
	say(f"s14 = [{s14}]")

	big15 := [1, 2, 3]
	say(f"{big15[8]}")
	return 0
}
