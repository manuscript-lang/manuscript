import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	b1 := (829.865 < ((541.717 - 732.202) + 777.840))
	say(f"b1 = {b1}")

	s2 := "42"
	say(f"s2 = [{s2}]")

	s3 := (("42" + s2) + "MiXeD CaSe").replace("héllo", "ms")
	say(f"s3 = [{s3}]")

	f4 := (
		((194.949 - 564.425) * (643.511 / 37.440))
		- ((395.462 * 9.0e20) + (526.25 + 413.769))
	)
	say(f"f4 = {f4}")

	l5 := [1, 2, 3].take(0)
	say(f"l5 = {l5} len {l5.length()}")
	say(f"collatz(2371) = {collatz(2371)}")
	say(f"fib(37) = {fib(37)}")

	big6 := (
		((763003567524 - (-11)) - ((-38) + (-38)))
		- ((763003567524 - (-11)) - ((-38) + (-38)))
	)
	say(f"{((763003567524 - (-11)) - ((-38) + (-38))) / big6}")
	return 0
}
