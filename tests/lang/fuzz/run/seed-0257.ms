// expect-stdout: l5 = [] len 0
// expect-stdout: s6 = [x]
// expect-stdout: i7 = -11983950
// expect-stdout: l8 = [-5] len 1
// expect-stdout: s9 = [-11983950:  padded  alphabrace{s}😀 ijome]
