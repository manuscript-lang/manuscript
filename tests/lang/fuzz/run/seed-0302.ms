import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	f1 := (
		((803.719 + 0.0) * (454.657 - 990.152))
		- ((502.442 * 172.343) + (311.770 + 160.463))
	)
	say(f"f1 = {f1}")

	i2 := (21 * ((35 / 31) / ((-42) - (-8))))
	say(f"i2 = {i2}")

	b3 := ((-325657337052) != 38)
	say(f"b3 = {b3}")
	say(f"fib(54) = {fib(54)}")

	i5 := i2
	say(f"i5 = {i5}")

	b6 := true
	say(f"b6 = {b6}")

	l7 := [(-6), (-26), (-9), 21, 25]
	say(f"l7 = {l7} len {l7.length()}")

	s8 := "MiXeD CaSe"
	say(f"s8 = [{s8}]")

	l9 := [(-15), 10, 13]
	say(f"l9 = {l9} len {l9.length()}")

	if (s8 + "quote\"d").is_empty() {
		say(s8)
	} else {
		say("42")
	}

	b10 := ((s8 != s8) or false)
	say(f"b10 = {b10}")

	l11 := l7.map(x => x + 1).filter(x => x % 2 == 0)
	say(f"l11 = {l11} len {l11.length()}")

	if ((-44) >= (48 * i2)) {
		say("beta")
	} else {
		say("42".replace(s8, s8))
	}

	i12 := (i2 + (-826947))
	say(f"i12 = {i12}")
	return 0
}
