	say(f"s1 = [{s1}]")

	f2 := (((8.0e18 + 0.0) * 391.207) * (0.0 + (7.0e6 + 629.311)))
	say(f"f2 = {f2}")

	l3 := [28, (-7)]
	say(f"l3 = {l3} len {l3.length()}")

	f4 := (((3.0e18 + f2) + (325.796 / 0.0)) - ((492.181 / f2) * (975.873 * f2)))
	say(f"f4 = {f4}")

	f5 := f2
	say(f"f5 = {f5}")

	s6 := (s1 + (s1 + "delta")).replace("brace{s}", s1)
	say(f"s6 = [{s6}]")
	return 0
}
