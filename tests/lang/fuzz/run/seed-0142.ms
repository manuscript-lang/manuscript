	say(f"fib(7) = {fib(7)}")

	l8 := [1, 2, 3].take(0)
	say(f"l8 = {l8} len {l8.length()}")

	i9 := (327863 - (i3 - (i3 / 172308)))
	say(f"i9 = {i9}")
	say(f"collatz(906) = {collatz(906)}")

	f10 := (f4 - ((f4 - f1) * (f4 + f1)))
