import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	s1 := "back\\slash"
	say(f"s1 = [{s1}]")

	i2 := s1.scalar_length()
	say(f"i2 = {i2}")

	l3 := [(-7)]
	say(f"l3 = {l3} len {l3.length()}")

	if ((i2 <= i2) and (true and false)) {
		say((s1 + "naïve"))
	} else {
		say("  padded  ")
	}

	b4 := ((false or true) and (620.691 < (0.0 + 991.089)))
	say(f"b4 = {b4}")

	i5 := (-543844684734)
	say(f"i5 = {i5}")

	b6 := (
		(18 <= (i2 * (-8)))
		or (
			"  padded  ".replace("brace{s}", "quote\"d") != (
				f"{(354932 + i2)}:"
				+ s1
			)
		)
	)
	say(f"b6 = {b6}")

	b7 := true
	say(f"b7 = {b7}")

	s8 := "x"
	say(f"s8 = [{s8}]")
	say(
		f"{(l3[0] + i2)} {i2} {((l3[0] + i2) < i2)} sum {(l3[0] + i2) + i2}"
	)

	b9 := (("42" == "gamma".replace("ms", s1)) or false)
	say(f"b9 = {b9}")
	return 0
}
