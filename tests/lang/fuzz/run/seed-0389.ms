import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	b1 := ("MiXeD CaSe".reverse() + "naïve".trim()).is_empty()
	say(f"b1 = {b1}")

	f2 := (((8.5 + 345.731) + (0.0 + 502.25)) + 633.362)
	say(f"f2 = {f2}")

	b3 := true
	say(f"b3 = {b3}")

	b4 := (7.5 < (f2 / (f2 + 198.671)))
	say(f"b4 = {b4}")

	s5 := "x"
	say(f"s5 = [{s5}]")

	b6 := (
		("brace{s}" + s5).reverse() != (
			f"{((-33) + 10)}:"
			+ "beta".replace(s5, "alpha")
		)
	)
	say(f"b6 = {b6}")

	l7 := [1, 2, 3].take(0)
	say(f"l7 = {l7} len {l7.length()}")

	i8 := ((((-17) + (-22)) + (-43)) / (-15))
	say(f"i8 = {i8}")
	say(f"fact(10) = {fact(10)}")

	s9 := (("back\\slash".lower() + s5.lower()) + "beta".trim())
	say(f"s9 = [{s9}]")

	l10 := l7.sorted((a, b) => a.compare(b))
	say(f"l10 = {l10} len {l10.length()}")

	s11 := s5.clone()
	say(f"s11 = [{s11}]")

	i12 := (i8 % (((-50) - 23) + l10.length()))
	say(f"i12 = {i12}")

	if b6 {
		say(s5.lower())
	} else {
		say((s5 + "hello world"))
	}

	say(f"fact(11) = {fact(11)}")

	s13 := ("x" + "42")
	say(f"s13 = [{s13}]")

	i14 := ((-26) / (44 - (i12 - i12)))
	say(f"i14 = {i14}")
	say(f"collatz(1509) = {collatz(1509)}")
	return 0
}
