import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	var acc1 = 0
	var stepacc1 = 0

	while stepacc1 < 4 {
		stepacc1 += 1
		acc1 += stepacc1 * stepacc1 + 7
	}

	say(f"acc1 = {acc1}")

	b2 := ((41 > (30 + 489897)) and ((6 + (-397106)) == ((-32) + 383670)))
	say(f"b2 = {b2}")

	var acc3 = 0
	for i in 0..4 {
		acc3 += i * 9
	}
	say(f"acc3 = {acc3}")

	i4 := 13
	say(f"i4 = {i4}")

	i5 := (-15)
	say(f"i5 = {i5}")

	i6 := ((i4 + (i5 + i4)) % (-((-7) % i5)))
	say(f"i6 = {i6}")

	s7 := "  padded  "
	say(f"s7 = [{s7}]")

	if (((-91783) - i4) == 125600275152) {
		say("naïve".lower())
	} else {
		say("brace{s}")
	}

	b8 := ((s7.lower() != (s7 + "quote\"d")) or ((134.385 * 5.0e15) < 370.033))
	say(f"b8 = {b8}")

	b9 := (("x" + "a".replace("back\\slash", "Tab\there")) == "héllo")
	say(f"b9 = {b9}")

	var acc10 = 0
	for i in 0..7 {
		acc10 += i * 7
	}
	say(f"acc10 = {acc10}")

	i11 := ((-729850) * (i4 + (22 - (-501379))))
	say(f"i11 = {i11}")

	i12 := s7.scalar_length()
	say(f"i12 = {i12}")
	say(
		f"{((i4 + 508476) % (-i11))} {17} {(((i4 + 508476) % (-i11)) < 17)} sum {((i4 + 508476) % (-i11)) + 17}"
	)
	return 0
}
