import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	b1 := (("a" + "delta").is_empty() and ((-23) >= (-18211295)))
	say(f"b1 = {b1}")

	s3 := (("line\nbreak" + "gamma") + "  padded  ").replace("x", "quote\"d")
	say(f"s3 = [{s3}]")

	s4 := s3.lower()
	say(f"s4 = [{s4}]")

	l5 := [(-7), 19, (-29), 9, 1]
	say(f"l5 = {l5} len {l5.length()}")

	i6 := 607888385042
	say(f"i6 = {i6}")

	if s4.ends_with(s4) {
		say(s4.lower())
	} else {
		say(("" + "delta"))
	}

	i7 := (((-i6) + (-4)) + 21)
	say(f"i7 = {i7}")

	if (b1 and (5 != 26)) {
		say(("naïve" + ""))
	} else {
		say("gamma".reverse())
	}

	return 0
}
