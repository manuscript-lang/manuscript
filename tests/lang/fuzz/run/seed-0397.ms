import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	if ("x".replace("Tab\there", "back\\slash") == "naïve") {
		say(("naïve" + "delta"))
	} else {
		say("日本語".reverse())
	}

	f1 := 220.298
	say(f"f1 = {f1}")
	say(f"fib(9) = {fib(9)}")

	f2 := (((f1 + f1) + (f1 + 0.0)) * (6.0e11 / 561.411))
	say(f"f2 = {f2}")

	var acc3 = 0
	for i in 0..7 {
		acc3 += i * 4
	}
	say(f"acc3 = {acc3}")

	var acc4 = 0
	var stepacc4 = 0

	while stepacc4 < 4 {
		stepacc4 += 1
		acc4 += stepacc4 * stepacc4 + (-3)
	}

	say(f"acc4 = {acc4}")

	s5 := "brace{s}".lower().upper()
	say(f"s5 = [{s5}]")

	big6 := -9223372036854775808
	say(f"{-big6}")
	return 0
}
