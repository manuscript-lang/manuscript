import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	i1 := 31
	say(f"i1 = {i1}")

	b2 := (
		(("a" + "alpha") + ("héllo" + "a")) != (
			"Tab\there".replace("Tab\there", "42")
			+ "a"
		)
	)
	say(f"b2 = {b2}")

	i3 := i1
	say(f"i3 = {i3}")
	say(
		f"{(((-15) * (-393159)) * (57735672287 + i1))} {(-(-481878))} {((((-15) * (-393159)) * (57735672287 + i1)) < (-(-481878)))} sum {(((-15) * (-393159)) * (57735672287 + i1)) + (-(-481878))}"
	)

	i4 := ((((-641461) * i1) + i3) + ((i1 + i3) + (i3 * i1)))
	say(f"i4 = {i4}")

	s5 := (f"{(i1 * 9)}:" + "42".reverse()).upper()
	say(f"s5 = [{s5}]")

	l6 := [21, (-2), 11, 7]
	say(f"l6 = {l6} len {l6.length()}")

	b7 := (s5.reverse().lower() == "gamma".upper())
	say(f"b7 = {b7}")

	i8 := 22
	say(f"i8 = {i8}")
	say(f"gcd(2375, 3184) = {gcd(2375, 3184)}")

	i9 := ((i3 - (i3 * (-1))) - i3)
	say(f"i9 = {i9}")

	i10 := i8
	say(f"i10 = {i10}")
	say(f"fib(51) = {fib(51)}")

	f11 := (324.25 * 537.417)
	say(f"f11 = {f11}")

	l12 := l6.sorted((a, b) => a.compare(b))
	say(f"l12 = {l12} len {l12.length()}")
	return 0
}
