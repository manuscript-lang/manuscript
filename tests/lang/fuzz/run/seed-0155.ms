import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	l1 := [(-16), (-18), (-30)]
	say(f"l1 = {l1} len {l1.length()}")

	b2 := ((40 + (44 + 859973)) != (((-601437) / (-779777)) * (-47)))
	say(f"b2 = {b2}")

	l3 := l1.drop(1)
	say(f"l3 = {l3} len {l3.length()}")

	l4 := [(-3), 4, (-21), 20]
	say(f"l4 = {l4} len {l4.length()}")

	var l5 = l1.clone()
	l5.append(87)
	say(f"l5 = {l5} len {l5.length()}")
	say(f"fib(52) = {fib(52)}")

	i6 := ((((-17) + 50) + 40) + (((-419679) * 50) + 33))
	say(f"i6 = {i6}")
	say(f"fib(21) = {fib(21)}")

	l7 := [(-18), 5, 12, 19]
	say(f"l7 = {l7} len {l7.length()}")

	big8 := 9223372036854775807
	say(f"{big8 * 5}")
	return 0
}
