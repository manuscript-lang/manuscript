import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	if ((255.182 + 841.163) != (126.751 / 1.5)) {
		say("gamma")
	} else {
		say("line\nbreak")
	}

	b1 := "line\nbreak".is_empty()
	say(f"b1 = {b1}")
	say(f"fib(43) = {fib(43)}")

	f2 := (325.916 + (0.0 * (23.800 + 330.587)))
	say(f"f2 = {f2}")

	s3 := (f"{(10 % 22984204386)}:" + "x")
	say(f"s3 = [{s3}]")

	l4 := [(-28), 5, 2, 4]
	say(f"l4 = {l4} len {l4.length()}")
	say(f"collatz(739) = {collatz(739)}")

	i5 := (-(31 * 48))
	say(f"i5 = {i5}")

	f6 := f2
	say(f"f6 = {f6}")

	i7 := (-((i5 / i5) * ((-19) / i5)))
	say(f"i7 = {i7}")

	b8 := ((l4.length() + l4.length()) <= ((i5 + 46) % i5))
	say(f"b8 = {b8}")

	s9 := ((f"{l4.length()}:" + s3) + (f"{(i7 * (-30))}:" + "brace{s}").lower())
	say(f"s9 = [{s9}]")

	f10 := f2
	say(f"f10 = {f10}")

	s11 := ("Tab\there" + s9).replace("日本語", s9).upper()
	say(f"s11 = [{s11}]")
	return 0
}
