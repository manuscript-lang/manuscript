import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	i1 := (448293377376 * (((-687045) + 43) + 96095))
	say(f"i1 = {i1}")

	b2 := ((not (true and true)) and false)
	say(f"b2 = {b2}")

	b3 := "Tab\there".lower().is_empty()
	say(f"b3 = {b3}")

	f4 := 6.0e23
	say(f"f4 = {f4}")

	b5 := b3
	say(f"b5 = {b5}")

	i6 := 18
	say(f"i6 = {i6}")

	if ((not b2) or (b5 or true)) {
		say("MiXeD CaSe")
	} else {
		say("line\nbreak")
	}

	l7 := [1, 2, 3].take(0)
	say(f"l7 = {l7} len {l7.length()}")

	b8 := b3
	say(f"b8 = {b8}")

	s9 := ("naïve".trim() + ("emoji 😀".upper() + "42".reverse()))
	say(f"s9 = [{s9}]")

	i10 := (631593751202 % (i6 * (i6 + i6)))
	say(f"i10 = {i10}")

	b11 := (((1.0e4 * f4) + (f4 + 482.515)) < ((520.207 / f4) * (f4 + 417.719)))
	say(f"b11 = {b11}")

	if (not (0 > 24)) {
		say("brace{s}")
	} else {
		say((s9 + s9))
	}

	var acc12 = 0
	for i in 0..6 {
		acc12 += i * (-3)
	}
	say(f"acc12 = {acc12}")
	say(f"fact(0) = {fact(0)}")

	b13 := true
	say(f"b13 = {b13}")

	f14 := f4
	say(f"f14 = {f14}")

	b15 := ("MiXeD CaSe" == "beta".upper())
	say(f"b15 = {b15}")

	s16 := ("42".lower() + s9.lower()).reverse()
	say(f"s16 = [{s16}]")
	return 0
}
