import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	say(
		f"{((-9223372036854775808) + (0 + 11))} {((32 + 61447447333) - 6)} {(((-9223372036854775808) + (0 + 11)) < ((32 + 61447447333) - 6))} sum {((-9223372036854775808) + (0 + 11)) + ((32 + 61447447333) - 6)}"
	)

	l1 := [(-30), 30, (-20), 22, 21]
	say(f"l1 = {l1} len {l1.length()}")
	say(
		f"{(l1.length() - (-42))} {((25 + 181723) - 43)} {((l1.length() - (-42)) < ((25 + 181723) - 43))} sum {(l1.length() - (-42)) + ((25 + 181723) - 43)}"
	)

	if "brace{s}".is_empty() {
		say(("hello world" + "x"))
	} else {
		say("日本語")
	}

	say(
		f"{(((-14) + 530572056574) - ((-853186) * 34))} {(429612298836 + (-21))} {((((-14) + 530572056574) - ((-853186) * 34)) < (429612298836 + (-21)))} sum {(((-14) + 530572056574) - ((-853186) * 34)) + (429612298836 + (-21))}"
	)

	f2 := 626.779
	say(f"f2 = {f2}")

	big3 := 9223372036854775807
	say(f"{big3 + 5}")
	return 0
}
