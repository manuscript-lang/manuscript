import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	i1 := ((21 - (-6)) - ((39 * 31) - (38 + (-962380))))
	say(f"i1 = {i1}")

	i2 := (i1 % i1)
	say(f"i2 = {i2}")

	f3 := (957.220 + 0.0)
	say(f"f3 = {f3}")

	i4 := i1
	say(f"i4 = {i4}")
	say(
		f"{(-(i2 * i4))} {(i2 % (-37))} {((-(i2 * i4)) < (i2 % (-37)))} sum {(-(i2 * i4)) + (i2 % (-37))}"
	)
	say(
		f"{((-15) + (i2 + i2))} {i1} {(((-15) + (i2 + i2)) < i1)} sum {((-15) + (i2 + i2)) + i1}"
	)

	b5 := ("ms" == "".lower().trim())
	say(f"b5 = {b5}")

	l6 := [26, 12, 28, (-1)]
	say(f"l6 = {l6} len {l6.length()}")

	s7 := "delta"
	say(f"s7 = [{s7}]")
	say(f"collatz(6) = {collatz(6)}")

	var acc8 = 0
	for i in 0..8 {
		acc8 += i * 0
	}
	say(f"acc8 = {acc8}")

	i9 := (((-11) - (i4 / i4)) * i4)
	say(f"i9 = {i9}")

	s10 := ("42" + "MiXeD CaSe")
	say(f"s10 = [{s10}]")
	return 0
}
