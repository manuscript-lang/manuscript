import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	b1 := ((("emoji 😀" + "alpha") == "a") and (false and false))
	say(f"b1 = {b1}")

	i2 := 36
	say(f"i2 = {i2}")

	i3 := ((((-308407168774) + (-9)) - (i2 / i2)) + (i2 % (i2 + i2)))
	say(f"i3 = {i3}")

	l4 := [3, 2, (-29), 11]
	say(f"l4 = {l4} len {l4.length()}")

	if "a".is_empty() {
		say("brace{s}")
	} else {
		say("  padded  ".upper())
	}

	var acc5 = 0

	for x in l4 {
		if x % 2 == 0 {
			acc5 += x
		} else {
			acc5 -= 1
		}
	}

	say(f"acc5 = {acc5}")

	i6 := 8
	say(f"i6 = {i6}")

	s7 := "naïve"
	say(f"s7 = [{s7}]")

	i8 := ((((-81656) % (-15)) % (i6 - (-344296))) * (-((-23) % 21)))
	say(f"i8 = {i8}")
	say(f"fib(11) = {fib(11)}")
	say(f"{i3} {i3} {(i3 < i3)} sum {i3 + i3}")

	l9 := [(-6), 18, 13]
	say(f"l9 = {l9} len {l9.length()}")

	i10 := (-l9.length())
	say(f"i10 = {i10}")
	say(f"{l4[0]} {5} {(l4[0] < 5)} sum {l4[0] + 5}")
	return 0
}
