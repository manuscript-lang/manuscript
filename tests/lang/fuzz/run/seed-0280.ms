import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	say(f"gcd(4107, 1264) = {gcd(4107, 1264)}")

	i1 := (188761 - (-23))
	say(f"i1 = {i1}")

	s2 := ("42" + "hello world").replace("emoji 😀", "hello world").reverse()
	say(f"s2 = [{s2}]")

	f3 := (
		((44.132 / 63.344) - (66.985 * 222.102))
		/ ((449.168 * 4.0e16) * (178.541 * 931.662))
	)
	say(f"f3 = {f3}")

	i4 := (-i1)
	say(f"i4 = {i4}")

	f5 := 688.25
	say(f"f5 = {f5}")

	b6 := ("delta" != ("gamma".lower() + s2.replace("emoji 😀", "ms")))
	say(f"b6 = {b6}")

	s7 := (
		("back\\slash".reverse() + s2.reverse())
		+ (f"{(i4 + (-15))}:" + s2).reverse()
	)
	say(f"s7 = [{s7}]")

	s8 := (s7.lower() + "ms")
	say(f"s8 = [{s8}]")
	say(
		f"{((i1 - i1) * (i1 - i1))} {((i4 + i1) + i1)} {(((i1 - i1) * (i1 - i1)) < ((i4 + i1) + i1))} sum {((i1 - i1) * (i1 - i1)) + ((i4 + i1) + i1)}"
	)

	i9 := (((i1 / i1) % ((-40) * (-31))) % (i4 / 9))
	say(f"i9 = {i9}")

	if ((b6 and false) and (false and b6)) {
		say(s7.replace("brace{s}", s2))
	} else {
		say("42")
	}

	return 0
}
