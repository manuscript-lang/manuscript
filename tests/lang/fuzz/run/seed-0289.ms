	f5 := (271.695 - ((f3 + 84.723) - (f1 + 876.154)))
	say(f"f5 = {f5}")

	l6 := l2.reversed()
	say(f"l6 = {l6} len {l6.length()}")

	l7 := [13, (-2), (-18), 29, (-20)]
	say(f"l7 = {l7} len {l7.length()}")
	say(f"fib(40) = {fib(40)}")

	i8 := 22
	say(f"i8 = {i8}")

	if "héllo".upper().is_empty() {
		say("gamma")
	} else {
		say("quote\"d".reverse())
	}

	i9 := (-i8)
	say(f"i9 = {i9}")
	say(f"collatz(2162) = {collatz(2162)}")

	if true {
		say("  padded  ")
	} else {
		say("  padded  ")
	}

	var acc10 = 0

	for x in l2 {
		if x % 2 == 0 {
			acc10 += x
		} else {
			acc10 -= 1
		}
	}

	say(f"acc10 = {acc10}")
	return 0
}
