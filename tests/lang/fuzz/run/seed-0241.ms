import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	b1 := "  padded  ".ends_with("42")
	say(f"b1 = {b1}")

	l2 := [0]
	say(f"l2 = {l2} len {l2.length()}")

	b3 := b1
	say(f"b3 = {b3}")
	say(f"fib(48) = {fib(48)}")

	l4 := [(-19)]
	say(f"l4 = {l4} len {l4.length()}")

	i5 := 19
	say(f"i5 = {i5}")
	return 0
}
