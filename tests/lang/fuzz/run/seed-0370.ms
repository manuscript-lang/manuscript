import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	say(f"gcd(300, 2662) = {gcd(300, 2662)}")

	f1 := 280.25
	say(f"f1 = {f1}")

	b2 := ((((-32761) + 671260) + (-321328478303)) > ((-41) + 22))
	say(f"b2 = {b2}")

	l3 := [(-15), 24]
	say(f"l3 = {l3} len {l3.length()}")

	s4 := "héllo".trim().reverse()
	say(f"s4 = [{s4}]")

	b5 := "".reverse().contains(s4)
	say(f"b5 = {b5}")

	f6 := 6.5
	say(f"f6 = {f6}")

	i7 := l3.length()
	say(f"i7 = {i7}")

	i8 := i7
	say(f"i8 = {i8}")

	l9 := [5, (-15)]
	say(f"l9 = {l9} len {l9.length()}")

	if "42".is_empty() {
		say(s4)
	} else {
		say(s4.replace("emoji 😀", s4))
	}

	i10 := (((i7 + i7) % l3.length()) - ((-25) - (i8 * (-34))))
	say(f"i10 = {i10}")

	l11 := l9.map(x => x + 1).filter(x => x % 2 == 0)
	say(f"l11 = {l11} len {l11.length()}")

	i12 := ((34 - i8) % ((-12) * l9.length()))
	say(f"i12 = {i12}")

	big13 := -9223372036854775808
	say(f"{-big13}")
	return 0
}
