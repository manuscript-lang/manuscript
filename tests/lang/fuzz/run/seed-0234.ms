import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	i1 := (-468677643685)
	say(f"i1 = {i1}")

	b2 := "brace{s}".starts_with("line\nbreak")
	say(f"b2 = {b2}")

	i3 := (i1 + ((i1 + i1) / i1))
	say(f"i3 = {i3}")

	i4 := (-195335)
	say(f"i4 = {i4}")
	say(f"gcd(4170, 4670) = {gcd(4170, 4670)}")

	i5 := 11
	say(f"i5 = {i5}")

	b6 := b2
	say(f"b6 = {b6}")

	l7 := [(-7), 14, (-9)]
	say(f"l7 = {l7} len {l7.length()}")

	var acc8 = 0

	for x in l7 {
		if x % 2 == 0 {
			acc8 += x
		} else {
			acc8 -= 1
		}
	}

	say(f"acc8 = {acc8}")

	i9 := ((((-41) * i4) % ((-446961410644) + i5)) - i5)
	say(f"i9 = {i9}")

	f10 := 491.348
	say(f"f10 = {f10}")
	return 0
}
