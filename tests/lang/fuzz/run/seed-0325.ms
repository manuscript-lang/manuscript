import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	b1 := "Tab\there".upper().is_empty()
	say(f"b1 = {b1}")
	say(f"collatz(1706) = {collatz(1706)}")

	f2 := ((5.0e3 + 477.078) + ((416.077 + 0.0) + 9.5))
	say(f"f2 = {f2}")
	say(f"fact(0) = {fact(0)}")

	l3 := [(-22), 22, 19, (-28), 4]
	say(f"l3 = {l3} len {l3.length()}")

	s4 := "delta"
	say(f"s4 = [{s4}]")

	s5 := "  padded  ".reverse()
	say(f"s5 = [{s5}]")

	i6 := (-640393364026)
	say(f"i6 = {i6}")

	i7 := ((l3[3] * (-16)) * (s5.scalar_length() - (547996 % 47)))
	say(f"i7 = {i7}")

	f8 := f2
	say(f"f8 = {f8}")

	s9 := s5
	say(f"s9 = [{s9}]")

	l10 := [(-26), (-1), 9, 26]
	say(f"l10 = {l10} len {l10.length()}")
	return 0
}
