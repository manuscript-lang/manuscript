import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	say(
		f"{(45 + ((-12) - 871629575250))} {(-((-35) * (-155366)))} {((45 + ((-12) - 871629575250)) < (-((-35) * (-155366))))} sum {(45 + ((-12) - 871629575250)) + (-((-35) * (-155366)))}"
	)

	b1 := (not ((813.075 * 7.0e24) != (875.489 / 745.509)))
	say(f"b1 = {b1}")

	b2 := "".reverse().upper().starts_with("naïve")
	say(f"b2 = {b2}")

	b3 := (((b1 and true) and false) and (b2 and b2))
	say(f"b3 = {b3}")

	i4 := (-15)
	say(f"i4 = {i4}")

	s5 := "MiXeD CaSe".trim()
	say(f"s5 = [{s5}]")

	b6 := (f"{(i4 * i4)}:" + s5).trim().starts_with(s5)
	say(f"b6 = {b6}")

	if (true and (false and b1)) {
		say("".reverse())
	} else {
		say((s5 + s5))
	}

	i7 := 42
	say(f"i7 = {i7}")

	i8 := (42 + (725427 + (20 + 19)))
	say(f"i8 = {i8}")
	return 0
}
