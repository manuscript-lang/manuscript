// conform: deterministic=true
// Generated by ms-conform fuzz, seed 64.
import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	b1 := false
	say(f"b1 = {b1}")

	s2 := ("ms" + "beta")
	say(f"s2 = [{s2}]")

	var acc4 = 0
	for i in 0..1 {
		acc4 += i * 9
	}
	say(f"acc4 = {acc4}")

	s5 := s2.upper().trim()
	say(f"s5 = [{s5}]")

	f6 := 9.5
	say(f"f6 = {f6}")
	say(f"fib(12) = {fib(12)}")

	l7 := [21, (-30), (-19), (-7), 9]
	say(f"l7 = {l7} len {l7.length()}")

	if (s5.replace(s2, "x") != ("hello world" + "gamma")) {
		say(s2)
	} else {
		say(s5.upper())
	}

	return 0
}
// expect-exit: 0
// expect-stdout: b1 = false
// expect-stdout: s2 = [msbeta]
// expect-stdout: acc4 = 0
// expect-stdout: s5 = [MSBETA]
// expect-stdout: f6 = 9.5
// expect-stdout: fib(12) = 144
// expect-stdout: l7 = [21, -30, -19, -7, 9] len 5
