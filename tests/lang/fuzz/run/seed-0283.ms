import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	b1 := false
	say(f"b1 = {b1}")

	f2 := 878.264
	say(f"f2 = {f2}")

	s3 := "quote\"d"
	say(f"s3 = [{s3}]")

	b4 := ((312.427 * (105.854 - f2)) < f2)
	say(f"b4 = {b4}")

	s5 := ("日本語".trim() + "x").replace(s3, "")
	say(f"s5 = [{s5}]")

	i6 := ((-50) + ((-33) * 27))
	say(f"i6 = {i6}")

	if (6 > (i6 * i6)) {
		say("42")
	} else {
		say("back\\slash")
	}

	s7 := "beta"
	say(f"s7 = [{s7}]")

	f8 := 441.462
	say(f"f8 = {f8}")

	i9 := i6
	say(f"i9 = {i9}")
	say(f"gcd(4287, 140) = {gcd(4287, 140)}")

	s10 := "gamma"
	say(f"s10 = [{s10}]")

	var acc11 = 0
	var stepacc11 = 0

	while stepacc11 < 3 {
		stepacc11 += 1
		acc11 += stepacc11 * stepacc11 + 6
	}

	say(f"acc11 = {acc11}")

	s12 := (s3 + "naïve")
	say(f"s12 = [{s12}]")

	i13 := (i6 + (s12.scalar_length() - ((-22) * i9)))
	say(f"i13 = {i13}")

	f14 := 746.927
	say(f"f14 = {f14}")

	b15 := (((-i6) + (i13 - i13)) >= (i6 - 940638))
	say(f"b15 = {b15}")
	say(
		f"{i6} {((i9 + i13) + i6)} {(i6 < ((i9 + i13) + i6))} sum {i6 + ((i9 + i13) + i6)}"
	)
	return 0
}
