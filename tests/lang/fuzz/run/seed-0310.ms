import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

