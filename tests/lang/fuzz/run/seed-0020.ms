import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	l1 := [(-18), 7]
	say(f"l1 = {l1} len {l1.length()}")

	i2 := 39
	say(f"i2 = {i2}")

	if (i2 >= i2) {
		say("hello world")
	} else {
		say((f"{l1.length()}:" + "MiXeD CaSe"))
	}

	l3 := [(-11), (-14), (-4)]
	say(f"l3 = {l3} len {l3.length()}")

	l4 := l3.take(1)
	say(f"l4 = {l4} len {l4.length()}")

	i5 := (((i2 / i2) + (i2 - 0)) / (-49))
	say(f"i5 = {i5}")

	i6 := (i2 + (i5 + (i2 % (-908553))))
	say(f"i6 = {i6}")

	f7 := (((711.25 - 840.545) * 168.208) / (291.806 - (624.319 / 691.074)))
	say(f"f7 = {f7}")

	i8 := i2
	say(f"i8 = {i8}")

	f9 := (((241.627 * f7) + (9.0e4 / f7)) * ((700.901 + 161.689) / (815.654 * f7)))
	say(f"f9 = {f9}")

	i10 := (i6 + i8)
	say(f"i10 = {i10}")

	l11 := [(-20), 3, 5]
	say(f"l11 = {l11} len {l11.length()}")
	say(f"{14} {l3.length()} {(14 < l3.length())} sum {14 + l3.length()}")

	i12 := (((i5 - 957557) / (i8 + (-21))) * i10)
	say(f"i12 = {i12}")
	say(f"collatz(1376) = {collatz(1376)}")

	i13 := i6
	say(f"i13 = {i13}")

	b14 := not "back\\slash".lower().is_empty()
	say(f"b14 = {b14}")

	i15 := 39
	say(f"i15 = {i15}")
	return 0
}
