import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	i1 := ((((-12) + 769634) * (7 * 47)) % (((-45) + 16) * ((-5) + 26)))
	say(f"i1 = {i1}")

	if ("gamma".reverse() == ("hello world" + "hello world")) {
		say("naïve")
	} else {
		say("beta".replace("Tab\there", "delta"))
	}

	say(f"fact(4) = {fact(4)}")

	b2 := true
	say(f"b2 = {b2}")

	f3 := 629.25
	say(f"f3 = {f3}")

	i4 := i1
	say(f"i4 = {i4}")

	i5 := (-534406)
	say(f"i5 = {i5}")

	s6 := (f"{(i1 * 937528459882)}:" + "gamma")
	say(f"s6 = [{s6}]")
	say(f"collatz(1420) = {collatz(1420)}")

	b7 := b2
	say(f"b7 = {b7}")

	l8 := [(-24)]
	say(f"l8 = {l8} len {l8.length()}")
	say(
		f"{((i4 / i4) + (-7))} {((i4 % 22) - (11 % i1))} {(((i4 / i4) + (-7)) < ((i4 % 22) - (11 % i1)))} sum {((i4 / i4) + (-7)) + ((i4 % 22) - (11 % i1))}"
	)
	return 0
}
