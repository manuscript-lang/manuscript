import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	i1 := 241521
	say(f"i1 = {i1}")
	say(
		f"{(((-50) + i1) - (-i1))} {((i1 - i1) * (-i1))} {((((-50) + i1) - (-i1)) < ((i1 - i1) * (-i1)))} sum {(((-50) + i1) - (-i1)) + ((i1 - i1) * (-i1))}"
	)

	l2 := [30, 28, 15]
	say(f"l2 = {l2} len {l2.length()}")

	i3 := (l2[1] + (((-41) + i1) - (i1 + (-42))))
	say(f"i3 = {i3}")
	say(f"collatz(1871) = {collatz(1871)}")

	if (not "日本語".contains("Tab\there")) {
		say("naïve")
	} else {
		say("42")
	}

	f4 := (((109.25 * 343.486) * (4.5 / 890.372)) * ((117.194 / 232.041) * 825.251))
	say(f"f4 = {f4}")

	if false {
		say("日本語")
	} else {
		say(("  padded  " + "x"))
	}

	say(
		f"{((i3 / i1) * (i1 + 392835))} {i1} {(((i3 / i1) * (i1 + 392835)) < i1)} sum {((i3 / i1) * (i1 + 392835)) + i1}"
	)

	s5 := (f"{i1}:" + "x".replace("hello world", "hello world").reverse())
	say(f"s5 = [{s5}]")

	f6 := 216.875
	say(f"f6 = {f6}")

	if true {
		say("back\\slash".replace(s5, "Tab\there"))
	} else {
		say(s5.replace("a", s5))
	}

	say(f"{(-24)} {l2[0]} {((-24) < l2[0])} sum {(-24) + l2[0]}")

	if ("gamma".is_empty() or s5.is_empty()) {
		say("Tab\there".upper())
	} else {
		say(s5.trim())
	}

	f7 := ((170.569 * (533.216 * f4)) / ((f6 - f6) - (218.275 * 327.558)))
