	say(
		f"{(l3.length() + ((-740109) * i4))} {((i6 + i6) + (-11))} {((l3.length() + ((-740109) * i4)) < ((i6 + i6) + (-11)))} sum {(l3.length() + ((-740109) * i4)) + ((i6 + i6) + (-11))}"
	)

	i12 := ((l3[1] + (i6 + i6)) * (((-22) + i8) + l3.length()))
