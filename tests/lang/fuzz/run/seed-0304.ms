import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	say(
		f"{((48 * 621989) * ((-14) % 48))} {((-14) + (0 + (-501581)))} {(((48 * 621989) * ((-14) % 48)) < ((-14) + (0 + (-501581))))} sum {((48 * 621989) * ((-14) % 48)) + ((-14) + (0 + (-501581)))}"
	)

	l1 := [30, (-28), (-17)]
	say(f"l1 = {l1} len {l1.length()}")
	say(
		f"{((-50) * (730954 * 1))} {(4 / (-561741))} {(((-50) * (730954 * 1)) < (4 / (-561741)))} sum {((-50) * (730954 * 1)) + (4 / (-561741))}"
	)

	b2 := ((f"{(27 + (-41))}:" + "  padded  ") + "日本語".lower()).is_empty()
	say(f"b2 = {b2}")

	b3 := b2
	say(f"b3 = {b3}")

	i4 := (((32 - (-647678)) / (43 * (-715237275172))) * l1[1])
	say(f"i4 = {i4}")

	s5 := "gamma".trim().replace("  padded  ", "quote\"d").upper()
	say(f"s5 = [{s5}]")

	if "".ends_with(s5) {
		say("héllo".upper())
	} else {
		say("héllo")
	}

	s6 := ("a" + "  padded  ").lower().reverse()
	say(f"s6 = [{s6}]")

	s7 := ("quote\"d" + "").reverse().upper()
	say(f"s7 = [{s7}]")

	var acc8 = 0
	for i in 0..3 {
		acc8 += i * (-2)
	}
	say(f"acc8 = {acc8}")

	b9 := false
	say(f"b9 = {b9}")

	l10 := l1.filter(x => x > 5)
	say(f"l10 = {l10} len {l10.length()}")

	f11 := (((177.946 + 645.599) - 0.0) - ((9.5 / 0.0) * (3.5 + 661.610)))
	say(f"f11 = {f11}")

	i12 := 45
	say(f"i12 = {i12}")
	return 0
}
