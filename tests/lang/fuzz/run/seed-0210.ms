import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	s1 := (f"{20}:" + "  padded  ".trim())
	say(f"s1 = [{s1}]")

	i2 := 45
	say(f"i2 = {i2}")

	b3 := (((i2 - i2) + 434072) >= i2)
	say(f"b3 = {b3}")
	say(f"collatz(1092) = {collatz(1092)}")

	i4 := i2
	say(f"i4 = {i4}")

	l5 := [(-13), 7, 22]
	say(f"l5 = {l5} len {l5.length()}")

	f6 := (745.589 * ((234.160 + 0.0) / 791.592))
	say(f"f6 = {f6}")

	f7 := 0.0
	say(f"f7 = {f7}")

	i8 := (-566148)
	say(f"i8 = {i8}")

	big9 := ((i2 - i4) / (i4 * i4)) - ((i2 - i4) / (i4 * i4))
	say(f"{((i2 - i4) / (i4 * i4)) % big9}")
	return 0
}
