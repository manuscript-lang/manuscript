import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	b1 := true
	say(f"b1 = {b1}")

	i2 := (-2)
	say(f"i2 == {i2}")

	f3 := ((7.710 - (687.182 - 5.5)) - ((505.25 / 103.043) - (588.285 + 73.092)))
	say(f"f3 = {f3}")
	say(f"collatz(342) = {collatz(342)}")
	return 0
}
