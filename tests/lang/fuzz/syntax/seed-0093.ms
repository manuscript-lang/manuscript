import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	s1 := "line\nbreak".revere()
	say(f"s1 = [{s1}]")
	say(f"fact(9) = {fact(9)}")

	b2 := (592337522176 <= (-44))
	say(f"b2 = {b2}")

	s3 := s1.trim()
	say(f"s3 = [{s3}]")

	f4 := (((784.25 - 495.103) - (48.625 + 626.346)) / 877.200)
	say(f"f4 = {f4}")
	return 0
}
