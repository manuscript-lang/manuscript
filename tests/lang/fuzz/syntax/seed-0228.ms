import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

export fn main() Int {
	s1 := "héllo".replace("héllo", "  padded  ").upper()
	say(f"s1 = [{s1}]")

	b2 := "Tab\there".is_empty()
	say(f"b2 = {b2}")
	say(f"s3 = [{s3}]")

	l4 := [(-30), (-7), (-6), 5, (-22)]
	say(f"l4 = {l4} len {l4.length()}")

	s5 := ("beta" + (f"{(37 % 40)}:" + "emoji 😀").lower())
	say(f"s5 = [{s5}]")

	var acc6 = 0
	var stepacc6 = 0

	while stepacc6 < 7 {
		stepacc6 += 1
		acc6 += stepacc6 * stepacc6 + 3
	}

	say(f"acc6 = {acc6}")
	return 0
}
