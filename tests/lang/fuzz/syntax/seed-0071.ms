import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	b1 := (not ((0.0 * 0.5) == (908.392 + 7.5)))
	say(f"b1 = {b1}")
	say(f"f2 = {f2}")
	say(f"gcd(1112, 4840) = {gcd(1112, 4840)}")

	l3 := [1, 2, 3].take(0)
	say(f"l3 = {l3} len {l3.length()}")

	s4 := "x"
	say(f"s4 = [{s4}]")
	return 0
}
