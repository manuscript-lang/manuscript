import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	b1 := not (f"{28}:" + "emoji 😀").ends_with("beta")
	say(f"b1 = {b1}")
	say(f"gcd(1030, 2740) = {gcd(1030, 2740)}")

	l2 := [(-25), (-16), (-22), 22]
	say(f"l2 = {l2} len {l2.length()}")
	return 0
}
