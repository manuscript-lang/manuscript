import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	say(f"fact(19) = {fact(19)}")

	s1 := "42".reverse().replace("  padded  ", "gamma").upper()
	say(f"s1 = [{s1}]")

	bad Int := "text"
	return 0
}
