import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

export fn main() Int {
	l1 := [28]
	say(f"l1 = {l1} len {l1.length()}")

	i2 := (253476 - ((-48) - (-46)))
	say(f"i2 = {i2}")

	if "".is_empty() {
		say("line\nbreak".replace("42", "naïve"))
	} else {
		say("brace{s}")
	}

	s3 := ("gamma".upper().upper() + "gamma".replace("emoji 😀", "back\\slash").trim())
	say(f"s3 = [{s3}]")

	fixed := 1
	fixed = 2

	i4 := (-50)
	say(f"i4 = {i4}")
	return 0
}
