import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn gcd(a Int, b Int) Int {
	if b == 0 {
		return a
	}
	return gcd(b, a % b)
}

export fn main() Int {
	say(f"gcd(4843, 3727) = {gcd(4843, 3727)}")
	return "not an int"

	l1 := [8, 12]
	say(f"l1 = {l1} len {l1.length()}")
	return 0
}
