import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	i1 := 12
	say(f"i1 = {i1}")

	s2 := "42"
	say(f"s2 = [{s2}]")

	f3 := (444.078 - (864.349 * (834.219 + 708.268)))
	say(f"f3 = {f3}")

	bad := missing_function(3)
	s4 := ("".trim() + ("brace{s}" + "naïve").trim())
	say(f"s4 = [{s4}]")
	say(f"fib(58) = {fib(58)}")
	return 0
}
