import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

export fn main() Int {
	b1 := false
	say(f"b1 = {b1}")

	s2 := "beta".upper().upper().replace("quote\"d", "Tab\there")
	say(f"s2 = [{s2}]")

	f3 := (((208.25 - 700.588) * (0.5 - 407.714)) + (278.416 + (8.0e16 * 7.5)))
	say(f"f3 = {f3}")

	bad := say(1, 2)
	return 0
}
