import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	f1 := 811.170
	say(f"f1 = {f1}")

	b2 := false
	say(f"b2 = {b2}")

	bad Int := "text"
	f3 := 530.812
	say(f"f3 = {f3}")

	f4 := 0.0
	say(f"f4 = {f4}")
	say(f"fib(56) = {fib(56)}")

	l5 := [6, (-7), 5]
	say(f"l5 = {l5} len {l5.length()}")
	return 0
}
