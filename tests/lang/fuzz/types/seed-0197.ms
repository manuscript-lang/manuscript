import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	l1 := [1, 2, 3].take(0)
	say(f"l1 = {l1} len {l1.length()}")

	i2 := ((((-34) * (-838221)) * (652801 + 35)) + (-539361979686))
	say(f"i2 = {i2}")
	say(f"fib(18) = {fib(18)}")

	bad := not 5
	return 0
}
