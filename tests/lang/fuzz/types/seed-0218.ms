import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	say(
		f"{624131} {(-(7 - (-46)))} {(624131 < (-(7 - (-46))))} sum {624131 + (-(7 - (-46)))}"
	)

	s1 := "brace{s}".lower().reverse()
	say(f"s1 = [{s1}]")
	say(f"fact(4) = {fact(4)}")

	s2 := "delta"
	say(f"s2 = [{s2}]")

	bad := [1, "two"]
	i3 := 10
	say(f"i3 = {i3}")

	b4 := s2.replace(s2, s1).ends_with(s1)
	say(f"b4 = {b4}")

	i5 := i3
	say(f"i5 = {i5}")
	return 0
}
