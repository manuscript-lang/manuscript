import stdout from "@std/io.ms"
import control from "@std/process.ms"
import sleep from "@std/time.ms"

fn say(text: String) Unit:
    let _ignored = stdout().write(text)

export fn main() Int:
    if let watched = control().watch_signals([2, 15]):
        with signals = watched:
            say("waiting\n")
            let _observed = signals.next()
            say("got signal\n")
            sleep(100.milliseconds)
            say("after sleep\n")
            return 0
    else:
        return 1
