import stdout from "@std/io/io.ms"
import watch_signals from "@std/os/process.ms"
import sleep from "@std/time.ms"

fn say(text: String) Unit:
    _written := stdout().write(text)

    // Piped stdout is buffered until exit; flush so a parent sees each line when it is printed.
    _flushed := stdout().flush()

export fn main() Int:
    if watched := watch_signals([2, 15]):
        var signals = watched
        say("waiting\n")

        _observed := signals.next()
        say("got signal\n")
        _ := sleep(100.milliseconds()).wait()
        say("after sleep\n")
        return 0
    else:
        return 1
