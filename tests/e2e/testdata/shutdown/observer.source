import stdout from "@std/io/io.ms"
import watch_signals from "@std/os/process.ms"
import sleep from "@std/os/time.ms"

fn say(text: String) Unit:
    let _written = stdout().write(text)

    # Piped stdout is buffered until exit; flush so a parent sees each line when it is printed.
    let _flushed = stdout().flush()

export fn main() Int:
    if let watched = watch_signals([2, 15]):
        let signals = watched
        say("waiting\n")

        let _observed = signals.next()
        say("got signal\n")
        sleep(100.milliseconds)
        say("after sleep\n")
        return 0
    else:
        return 1
