import Closeable from "@std/core.ms"
import Bytes from "@std/bytes.ms"
import promise, PromiseOptions from "@std/concurrency/promise.ms"
import stdout, WriteStream from "@std/io/io.ms"
import listen, Listener, Connection from "@std/net/net.ms"
import watch_signals from "@std/os/process.ms"
import Duration, sleep from "@std/time.ms"

fn flush_within(var out: WriteStream[Bytes], limit: Duration) Unit!:
    return promise(fn: out.flush()).with(options: PromiseOptions(timeout: limit)).wait()

fn say(text: String) Unit:
    _written := stdout().write(text)

    // Piped stdout is buffered until exit; flush so a parent sees each line when it is printed.
    _flushed := stdout().flush()

type WorkerCleanup:
    label: String

impl Closeable for WorkerCleanup:
    fn close() Unit!:
        say("{self.label} stopped\n")
        return ok(unit)

type Server:
    listener: Listener
    client: Connection
    closed: Bool = false

impl Closeable for Server:
    var fn close() Unit!:
        if self.closed:
            return ok(unit)

        self.closed = true
        try self.listener.close()
        _ := sleep(10.milliseconds()).wait()

        var farewell = self.client.output.write("farewell\n".to_bytes())
        if farewell.is_ok():
            drained := flush_within(var self.client.output, 1.seconds())
            farewell = drained

        if farewell.is_error():
            say("farewell failed: {farewell.err().message}\n")
        else:
            say("farewell sent\n")

        try self.client.close()
        return ok(unit)

fn serve() Result[Unit, Error]:
    var signals = try watch_signals([2, 15])
    listener := try listen("127.0.0.1:0")
    say("{listener.address()}\n")

    client := try listener.accept().wait()
    _server := Server(listener: listener, client: client)
    _cleanup := WorkerCleanup(label: "worker")
    say("ready\n")

    _observed := signals.next()
    return ok(unit)

export fn main() Int:
    served := serve()

    if served.is_error():
        say("{served.err().message}\n")
        return 1

    return 0
