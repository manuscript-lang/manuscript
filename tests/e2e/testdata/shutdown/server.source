import Closeable from "@std/core.ms"
import stdout from "@std/io.ms"
import listen, Listener, Connection from "@std/net.ms"
import watch_signals from "@std/process.ms"
import sleep from "@std/time.ms"

fn say(text: String) Unit:
    let _written = stdout().write(text)

    # Piped stdout is buffered until exit; flush so a parent sees each line when it is printed.
    let _flushed = stdout().flush()

type WorkerCleanup:
    label: String

impl Closeable for WorkerCleanup:
    fn close() Unit!:
        say("{self.label} stopped\n")
        return ok(unit)

type Server:
    listener: Listener
    client: Connection
    closed: Bool = false

impl Closeable for Server:
    var fn close() Unit!:
        if self.closed:
            return ok(unit)

        self.closed = true
        try self.listener.close()
        sleep(10.milliseconds)

        let farewell = self.client.write("farewell\n", timeout: 1.seconds)

        if farewell.is_error():
            say("farewell failed: {farewell.err().message()}\n")
        else:
            say("farewell sent\n")

        try self.client.close()
        return ok(unit)

fn serve() Result[Unit, Error]:
    let signals = try watch_signals([2, 15])
    let listener = try listen("127.0.0.1:0")
    say("{listener.address()}\n")

    let client = try listener.accept()
    let _server = Server(listener: listener, client: client)
    let _cleanup = WorkerCleanup(label: "worker")
    say("ready\n")

    let _observed = signals.next()
    return ok(unit)

export fn main() Int:
    let served = serve()

    if served.is_error():
        say("{served.err().message()}\n")
        return 1

    return 0
