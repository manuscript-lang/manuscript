// Serves /line, whose handler reads one line of standard input, and /health. A handler waiting
// for input must not stop the server answering other requests.
import headers, HttpRequest, HttpResponse, buffered from "@std/net/http.ms"
import stdin, stdout from "@std/io/io.ms"
import lines from "@std/io/streams.ms"
import serve from "@std/net/net.ms"

fn handle(request: HttpRequest) HttpResponse:
    if request.path == "/line":
        var input = lines(stdin())
        if step := input.next():
            return HttpResponse(200, headers(), "{step.get("eof")}\n".to_bytes())

        return HttpResponse(500, headers(), "read failed\n".to_bytes())

    return HttpResponse(200, headers(), "ok\n".to_bytes())

export fn main() Int:
    if acquired := serve(address: "127.0.0.1:0", handler: buffered(handle)):
        server := acquired
        _said := stdout().write("{server.address()}\n")
        _flushed := stdout().flush()
        _ignored := server.wait()
        return 0

    return 1
