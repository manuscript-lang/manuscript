import stdout from "@std/io.ms"
import {WorkerGroup, worker_channel} from "@std/workers.ms"

export fn waits() Unit:
    var ch = worker_channel[Int, Int]()
    let v = ch.receive()
    ch.send(1)

export fn main() Int:
    with let workers = WorkerGroup[Int, Int]():
        var w = workers.spawn(waits).get()
        let v = w.channel.receive()
        stdout().write("main got {v.is_ok()}\n").get()
    return 0
