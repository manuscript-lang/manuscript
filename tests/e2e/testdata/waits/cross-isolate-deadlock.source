import stdout from "@std/io/io.ms"
import WorkerGroup, worker_channel from "@std/concurrency/workers.ms"

export fn waits() Unit:
    var ch = worker_channel[Int, Int]()
    let v = ch.receive()
    ch.send(1)

export fn main() Int:
    var workers = WorkerGroup[Int, Int]()
    var w = workers.spawn(waits).get()
    let v = w.channel.receive()
    stdout().write("main got {v.is_ok()}\n").get()
    workers.close()
    return 0
