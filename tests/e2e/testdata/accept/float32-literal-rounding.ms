import expect_equal from "@std/test/test.ms"

fn largest() Float32:
	return 340282356779733661637539395458142568447.0

fn smallest() Float32:
	return -340282356779733661637539395458142568447.0

fn above_one() Float32:
	return 1.0000000596046448

fn below_two_steps() Float32:
	return 1.0000001788139343

fn tiny() Float32:
	return 7.0064923216240854e-46

test "Float32 literals round once to binary32":
	try expect_equal(largest().to_float64(), 340282346638528859811704183484516925440.0)
	try expect_equal(
		smallest().to_float64(), -340282346638528859811704183484516925440.0
	)
	try expect_equal(above_one().to_float64(), 1.0000001192092896)
	try expect_equal(below_two_steps().to_float64(), 1.0000001192092896)
	try expect_equal(tiny().to_float64(), 1.401298464324817e-45)

test "a long list of Float32 literals rounds the same way":
	list: List[Float32] = [
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448, 1.0000000596046448, 1.0000000596046448, 1.0000000596046448,
		1.0000000596046448
	]
	try expect_equal(list.length() >= 65, true)
	try expect_equal(list[64].to_float64(), 1.0000001192092896)
