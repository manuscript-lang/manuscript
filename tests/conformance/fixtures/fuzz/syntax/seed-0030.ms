from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    if ("brace{s}".trim() != (f"{(8 % 47)}:" + "brace{s}")):
        say(("42" + "naïve"))
    else:
        say("".reverse())

    if ("quote\"d" == "Tab\there"):
        say("emoji 😀".reverse())
    else:
        say("quote\"d".lower())

    let f1 = (8.0e20 * 7.5)
    say(f"f1 = {f1}")
    return 0
