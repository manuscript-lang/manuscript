import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

export fn main() Int:
    if ("brace\{s\}".trim() != ("{(8 % 47)}:" + "brace\{s\}")):
        say(("42" + "naïve"))
    else:
        say("".reverse())

    if ("quote\"d" == "Tab\there"):
        say("emoji 😀".reverse())
    else:
        say("quote\"d".lower())

    let f1 = (8.0e20 * 7.5)
    say("f1 = {f1}")
    return 0
