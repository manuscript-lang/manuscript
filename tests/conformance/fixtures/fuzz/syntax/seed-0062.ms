import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1
    return a

export fn main() Int:
    let l1 = [28]
    say("l1 = {l1} len {l1.length()}")
    say("fib(38) = {fib(38)}"))
    return 0
