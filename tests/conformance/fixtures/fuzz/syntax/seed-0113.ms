from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    let l1 = [(-4)]
    say(f"l1 = {l1} len {l1.length()}")

    let b2 = True
    say(f"b2 = {b2}")

    let b3 = (
        "emoji 😀".reverse().reverse() == (
            (f"{(9 * (-30))}:" + "naïve")
            + ("héllo" + "quote\"d")
        )
    )
    say(f"b3 = {b3}")

    var acc4 = 0

    for x in l1:
        if x % 2 == 0:
            acc4 += x
        else:
            acc4 -= 1

    say(f"acc4 = {acc4}")

    let f5 = ((9.5 / 4.0e-5) * 294.074)
    say(f"f5 = {f5}")

    var acc6 = 0
    for i in 0..6:
        acc6 += i * 4
    say(f"acc6 = {acc6}")
    return 0
