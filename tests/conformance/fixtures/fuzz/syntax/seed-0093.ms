import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    written := stdout().write("{text}\n")

fn fact(n: Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    s1 := "line\nbreak".revere()
    say("s1 = [{s1}]")
    say("fact(9) = {fact(9)}")

