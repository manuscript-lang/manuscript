from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    say(f"collatz(1384) = {collatz(1384)}")
    say(f"f2 = {f2}")
    return 0
