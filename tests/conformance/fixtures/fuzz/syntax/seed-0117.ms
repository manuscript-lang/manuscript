import stdout from "@std/io.ms"
import {range} from "@std/collections.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

export fn main() Int:
    let l1 = [(-3), 18, 4, 19, (-23)]
    say("l1 = {l1} len {l1.length()}")
    let i2 = (-((-23) + (27 - (-3))))
    say("i2 = {i2}")
    let s3 = "emoji 😀"
    say("s3 = [{s3}]")
    let l4 = l1.map(fn(x): x * 3)
    say("l4 = {l4} len {l4.length()}")
    let i5 = l4.get(0)
    say("i5 = {i5}")
    var acc6 = 0
    for i in range(0, 1)::
        acc6 += i * 3
    say("acc6 = {acc6}")
    return 0
