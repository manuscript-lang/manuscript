import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

fn fib(n Int) Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        next := a + b
        a = b
        b = next
        i += 1

    return a

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    say(f"fib(21) = {fib(21)}")
    say(f"fact(5) = {fact(5)}")

