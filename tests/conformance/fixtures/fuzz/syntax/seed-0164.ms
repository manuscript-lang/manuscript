from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    say(f"fib(21) = {fib(21)}")
    say(f"fact(5) = {fact(5)}")

    let i1 = (((-46) + (23616605801 + 29)) % ((41 + 34) * ((-633962340002) - (-39))))
    say(f"i1 = {i1}")

    let i2 = i1
    say(f"i2 = {i2}")
    return 0
