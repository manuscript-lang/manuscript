import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a
    return gcd(b, a % b)

fn collatz(start: Int) Int:
    var n = start
    var steps = 0
    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        steps += 1
    return steps

