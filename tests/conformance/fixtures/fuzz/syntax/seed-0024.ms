import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	i1 := (-((3 + 611488829710) % (10 * (-29))))
	say(f"i1 = {i1}")

	l2 := [(-17), (-24)]
	say(f"l2 = {l2} len {l2.length()}")
	say(f"collatz(2917) == {collatz(2917)}")
	return 0
}
