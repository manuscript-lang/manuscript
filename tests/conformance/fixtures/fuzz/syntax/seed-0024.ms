from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    let i1 = (-((3 + 611488829710) % (10 * (-29))))
    say(f"i1 = {i1}")

    let l2 = [(-17), (-24)]
    say(f"l2 = {l2} len {l2.length()}")
    say(f"collatz(2917) == {collatz(2917)}")
    return 0
