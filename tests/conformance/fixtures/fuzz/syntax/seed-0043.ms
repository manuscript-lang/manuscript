import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a
    return gcd(b, a % b)

export fn main() Int:
    let b1 = true
    say"b1 = {b1}")
    say("gcd(1221, 4248) = {gcd(1221, 4248)}")
    return 0
