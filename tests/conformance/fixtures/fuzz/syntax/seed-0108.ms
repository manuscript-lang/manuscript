import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1
    return a

export fn main() Int:
    say("fib(14) = {fib(14)}")
    let l1 = [(-1), (-7), (-23), 1]
    say("l1 = {l1} len {l1.length()}")
    let s2 = (("x" + "alpha").reverse() + "emoji 😀")
