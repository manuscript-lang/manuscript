import stdout from "@std/io.ms"
import {range} from "@std/collections.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a
    return gcd(b, a % b)

export fn main() Int:
    say("gcd(835, 859) = {gcd(835, 859)}")
    var acc1 = 0
    for i in range(0, 5):
        acc1 += i * 9)
    say("acc1 = {acc1}")
    let b2 = true
    say("b2 = {b2}")
    return 0
