from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    let s1 = "naïve"
    say(f"s1 = [{s1}]")

    let i2 = 11
    let i3 = (42472865360 / (i2 + (i2 * 623891)))
    say(f"i3 = {i3}")
    return 0
