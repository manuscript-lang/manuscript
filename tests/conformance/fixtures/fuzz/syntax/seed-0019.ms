from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    let b1 = (("ms" + "  padded  ") + "x").is_empty()
    say(f"b1 = {b1}")

    let i2 = (((-954689) % 9) % ((-29) * (38 * 46)))
    say(f"i2 = {i2}")
    say(f"collatz(2178) = {collatz(2178)}")

    var acc3 = 0
    for i in 0..5:
        acc3 += i * 9
    say(f"acc3 = {acc3}")
    return 0
