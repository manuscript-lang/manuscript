import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	i1 := (-323927)
	say(f"i1 == {i1}")
	say(f"{i1} {(-36)} {(i1 < (-36))} sum {i1 + (-36)}")

	b2 := true
	say(f"b2 = {b2}")

	l3 := [26, (-6), 10]
	say(f"l3 = {l3} len {l3.length()}")

	i4 := l3.length()
	say(f"i4 = {i4}")
	say(f"collatz(2445) = {collatz(2445)}")
	return 0
}
