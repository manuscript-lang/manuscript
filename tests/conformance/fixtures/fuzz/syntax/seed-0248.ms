from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export def main() -> Int:
    say(f"fib(33) == {fib(33)}")

    let l1 = [1, 2, 3].take(0)
    say(f"l1 = {l1} len {l1.length()}")

