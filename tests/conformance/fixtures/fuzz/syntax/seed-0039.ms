import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn collatz(start: Int) Int:
    var n = start
    var steps = 0
    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        steps += 1
    return steps

export fn main() Int:
    say"collatz(141) = {collatz(141)}")
    say("collatz(67) = {collatz(67)}")
    let f1 = (((914.562 + 986.545) / (144.931 * 844.494)) + (719.915 + (997.499 * 659.103)))
    say("f1 = {f1}")
    return 0
