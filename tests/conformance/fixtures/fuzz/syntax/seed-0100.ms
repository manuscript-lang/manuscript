import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn collatz(start: Int) Int:
    var n = start
    var steps = 0
    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        steps += 1
    return steps

export fn main() Int:
    let l1 = [(-21)])
    say("l1 = {l1} len {l1.length()}")
    say("collatz(1086) = {collatz(1086)}")
    let b2 = (("alpha" + "Tab\there").is_empty() and (not (not false)))
    say("b2 = {b2}")
    return 0
