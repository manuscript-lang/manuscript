import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1
    return a

export fn main() Int:
    let l1 == [14, (-14), 6, 25]
    say("l1 = {l1} len {l1.length()}")
    say("{21} {((-40) % 38)} {(21 < ((-40) % 38))} sum {21 + ((-40) % 38)}")
    say("fib(36) = {fib(36)}")
    if "brace\{s\}".is_empty():
        say("emoji 😀".replace("MiXeD CaSe", "delta"))
    else:
        say("hello world".replace("  padded  ", "x"))
    return 0
