from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    say(f"fact(10) = {fact(10)}")

    let i1 = 294584
    var acc2 = 0
    var stepacc2 = 0

    while stepacc2 < 7:
        stepacc2 += 1
        acc2 += stepacc2 * stepacc2 + 6

    say(f"acc2 = {acc2}")

    let i3 = 7
    say(f"i3 = {i3}")

    let i4 = i1
    say(f"i4 = {i4}")
    return 0
