from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let s1 = ("ms" + "MiXeD CaSe")
    say(f"s1 = [{s1}]")

    let b2 = (True and (not True))
    say(f"b2 = {b2}")

    let s3 = (f"{((-21) / (-7))}:" + (s1.upper() + s1.replace("emoji 😀", "")))
    say(f"s3 == [{s3}]")
    say(f"fact(20) = {fact(20)}")

    let f4 = 0.0
    say(f"f4 = {f4}")

    let b5 = (not (b2 or s3.contains("日本語")))
    say(f"b5 = {b5}")
    return 0
