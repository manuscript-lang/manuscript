from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    let i1 = (-40)
    say(f"i1 = {i1}")
    say(f"gcd(4782, 2951) = {gcd(4782, 2951)}")
    say(f"gcd(165, 4348) = {gcd(165, 4348)}")
    return 0
