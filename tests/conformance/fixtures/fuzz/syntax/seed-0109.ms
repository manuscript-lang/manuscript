import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    b1 := false
    say(f"b1 = {b1}")

    var acc2 = 0
    for i in 0..8:
        acc2 += i * (-5)
    say(f"acc2 = {acc2}")

    b3 := ("a" == "hello world".reverse())
    say(f"b3 = {b3}")

    l4 := [(-21), (-1), (-27), (-13), (-4)]
    say(f"l4 = {l4} len {l4.length()}")

    s5 := "gamma".trim()
    say(f"s5 = [{s5}]")
    say(f"fact(4) = {fact(4)}")
    return 0
