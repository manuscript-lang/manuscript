from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let b1 = False
    say(f"b1 = {b1}")

    var acc2 = 0
    for i in 0..8:
        acc2 += i * (-5)
    say(f"acc2 = {acc2}")

    let b3 = ("a" == "hello world".reverse())
    say(f"b3 = {b3}")

    let l4 = [(-21), (-1), (-27), (-13), (-4)]
    say(f"l4 = {l4} len {l4.length()}")

    let s5 = "gamma".trim()
    say(f"s5 = [{s5}]")
    say(f"fact(4) = {fact(4)}")
    return 0
