from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    say(f"fct(1) = {fact(1)}")

    let l1 = [28, (-23), (-11), 0]
    say(f"l1 = {l1} len {l1.length()}")
    return 0
