from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    if False:
        say((f"{(-35)}:" + "alpha"))
    else:
        say(("MiXeD CaSe" + "ms"))

    say(f"collatz(2228) = {collatz(2228)}")

    let bad = [1, "two"]
    let s1 = ("".upper() + ("x" + "delta")).trim()
    say(f"s1 = [{s1}]")
    return 0
