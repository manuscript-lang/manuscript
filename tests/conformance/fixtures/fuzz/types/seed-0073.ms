import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	if false {
		say((f"{(-35)}:" + "alpha"))
	} else {
		say(("MiXeD CaSe" + "ms"))
	}

	say(f"collatz(2228) = {collatz(2228)}")

	bad := [1, "two"]
	s1 := ("".upper() + ("x" + "delta")).trim()
	say(f"s1 = [{s1}]")
	return 0
}
