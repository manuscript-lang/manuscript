from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    say(f"fact(16) = {fact(16)}")

    var acc1 = 0
    var stepacc1 = 0

