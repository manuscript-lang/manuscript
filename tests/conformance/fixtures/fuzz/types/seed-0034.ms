from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    say(f"gcd(1261, 2434) = {gcd(1261, 2434)}")

    let s1 = "back\\slash"
    say(f"s1 = [{s1}]")

    if ((49 == (-7)) or False):
        say("delta")
    else:
        say("MiXeD CaSe")

    let _bad = say
    return 0
