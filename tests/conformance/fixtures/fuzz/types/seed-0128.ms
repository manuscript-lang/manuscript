from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    say(f"gcd(4843, 3727) = {gcd(4843, 3727)}")
    return "not an int"

    let l1 = [8, 12]
    say(f"l1 = {l1} len {l1.length()}")
    return 0
