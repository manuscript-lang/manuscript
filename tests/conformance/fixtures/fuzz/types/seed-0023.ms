import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	say(f"fib(17) = {fib(17)}")

	bad := say(1, 2)
	i2 := (((-46) - 0) + (-674414))
	say(f"i2 = {i2}")

	l3 := [17, (-30), (-6)]
	say(f"l3 = {l3} len {l3.length()}")

	i4 := (-i2)
	say(f"i4 = {i4}")
	return 0
}
