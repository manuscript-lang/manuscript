from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    let s1 = (("gamma" + "brace{s}") + "emoji 😀".trim()).lower()
    say(f"s1 = [{s1}]")

    let l2 = [19, 8, (-12), 30]
    say(f"l2 = {l2} len {l2.length()}")

    let bad: String = 5
    say(f"gcd(4299, 4413) = {gcd(4299, 4413)}")

    let i3 = ((-((-23) - (-46))) + (-15))
    say(f"i3 = {i3}")

    var acc4 = 0

    for x in l2:
        if x % 2 == 0:
            acc4 += x
        else:
            acc4 -= 1

    say(f"acc4 = {acc4}")
    return 0
