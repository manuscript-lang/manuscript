import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	say(f"fact(11) = {fact(11)}")
	say(
		f"{((31 % (-23)) - ((-94368) + (-751008)))} {(-28)} {(((31 % (-23)) - ((-94368) + (-751008))) < (-28))} sum {((31 % (-23)) - ((-94368) + (-751008))) + (-28)}"
	)

	b1 := false
	say(f"b1 = {b1}")

	bad := (1 < 2) < 3
	return 0
}
