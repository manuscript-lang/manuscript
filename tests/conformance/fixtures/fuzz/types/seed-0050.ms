from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let i1 = ((-(-13)) - 42)
    say(f"i1 = {i1}")

    let bad = Map[Int, Int]().get(1, 2, 3)
    let s2 = "quote\"d"
    say(f"s2 = [{s2}]")
    say(f"fact(11) = {fact(11)}")
    return 0
