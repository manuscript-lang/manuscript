import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	i1 := ((-(-13)) - 42)
	say(f"i1 = {i1}")

	bad := Map[Int, Int]().get_or(1, 2, 3)
	s2 := "quote\"d"
	say(f"s2 = [{s2}]")
	say(f"fact(11) = {fact(11)}")
	return 0
}
