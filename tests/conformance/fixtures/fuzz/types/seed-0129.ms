import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	if false {
		say("hello world".trim())
	} else {
		say((f"{((-41734) / 46)}:" + ""))
	}

	say(f"collatz(1025) = {collatz(1025)}")

