import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export fn main() Int:
    let s1 = "42"
    say("s1 = [{s1}]")
    return "not an int"
    say("fib(2) = {fib(2)}")
    return 0
