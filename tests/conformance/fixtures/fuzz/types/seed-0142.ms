from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export def main() -> Int:
    let s1 = "42"
    say(f"s1 = [{s1}]")
    return "not an int"
    say(f"fib(2) = {fib(2)}")
    return 0
