import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

export fn main() Int:
    let s1 = "MiXeD CaSe".replace("x", "hello world")
    say("s1 = [{s1}]")

    let s2 = "42".lower().replace("emoji 😀", "MiXeD CaSe")
    say("s2 = [{s2}]")

    let s3 = ("{((-12) - 44)}:" + (s1 + "x")).trim()
    say("s3 = [{s3}]")

    let bad: Bool = 1
    let b4 = s1.is_empty()
    say("b4 = {b4}")
    return 0
