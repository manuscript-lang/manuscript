from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let s1 = "MiXeD CaSe".replace("x", "hello world")
    say(f"s1 = [{s1}]")

    let s2 = "42".lower().replace("emoji 😀", "MiXeD CaSe")
    say(f"s2 = [{s2}]")

    let s3 = (f"{((-12) - 44)}:" + (s1 + "x")).trim()
    say(f"s3 = [{s3}]")

    let bad: Bool = 1
    let b4 = s1.is_empty()
    say(f"b4 = {b4}")
    return 0
