import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	f1 := 182.678
	say(f"f1 = {f1}")

	bad Int := "text"
	say(f"collatz(2195) = {collatz(2195)}")

	i2 := (-938389)
	say(f"i2 = {i2}")
	return 0
}
