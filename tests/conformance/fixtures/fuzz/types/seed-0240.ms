from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    if False:
        say("日本語")
    else:
        say(("ms" + "héllo"))

    let bad = True + 1
    let l1 = [1, 2, 3].take(0)
    say(f"l1 = {l1} len {l1.length()}")

    let s2 = ((("x" + "quote\"d") + "ms") + ("" + "alpha".replace("beta", "42")))
    say(f"s2 = [{s2}]")

    let s3 = s2
    say(f"s3 = [{s3}]")
    return 0
