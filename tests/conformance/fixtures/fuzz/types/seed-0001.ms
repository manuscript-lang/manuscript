    say(f"i1 = {i1}")

    let s2 = "back\\slash"
    say(f"s2 = [{s2}]")

    let i3 = ((i1 * s2.length()) + i1)
    say(f"i3 = {i3}")

    let f4 = (6.0e4 + ((812.525 * 600.051) / (56.182 / 131.920)))
    say(f"f4 = {f4}")

    let fixed = 1
