    l5 := [(-29), (-19), 25, 9, 11]
    say("l5 = {l5} len {l5.length()}")

    if ((not false) or ((-11) < (-26))):
        say(("brace\{s\}" + s1))
    else:
        say("gamma")

    i6 := (s4.length() + s1.length())
    say("i6 = {i6}")
    return 0
