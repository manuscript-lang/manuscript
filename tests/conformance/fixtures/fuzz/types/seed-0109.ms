from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let f1 = 954.25
    say(f"f1 = {f1}")
    return "not an int"

    let l2 = [23, 10, 19, 28, (-1)]
    say(f"l2 = {l2} len {l2.length()}")

    if ("  padded  ".replace("quote\"d", "line\nbreak") != "alpha".trim()):
        say("line\nbreak")
    else:
        say(("ms" + "brace{s}"))

    return 0
