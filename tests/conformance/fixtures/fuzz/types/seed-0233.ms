from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    say(f"collatz(1787) = {collatz(1787)}")

    let l1 = [0, 5, 25, (-20), 2]
    say(f"l1 = {l1} len {l1.length()}")
    return "not an int"
    say(f"{((-43) % 860307)} {7} {(((-43) % 860307) < 7)} sum {((-43) % 860307) + 7}")
    return 0
