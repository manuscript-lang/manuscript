import stdout from "@std/io/io.ms"

fn say(text String) Void:
    written := stdout().write(f"{text}\n")

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    i1 := (((-4) - (-5)) % ((32 / 20) - (1 - 50)))
    say(f"i1 = {i1}")
    return "not an int"
    say(f"fact(10) = {fact(10)}")
    return 0
