import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fact(n: Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    let i1 = (((-4) - (-5)) % ((32 / 20) - (1 - 50)))
    say("i1 = {i1}")
    return "not an int"
    say("fact(10) = {fact(10)}")
    return 0
