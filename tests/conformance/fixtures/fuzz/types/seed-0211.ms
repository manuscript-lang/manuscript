import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	i1 := 19
	say(f"i1 = {i1}")

	bad Bool := 1
	say(f"fib(22) = {fib(22)}")

	i2 := (i1 + (-138927))
	say(f"i2 = {i2}")

	i3 := (((i1 - i2) + (-24)) * (i2 - (44 % i1)))
	say(f"i3 = {i3}")

	i4 := i3
	say(f"i4 = {i4}")

	s5 := (f"{(-22)}:" + "ms".replace("naïve", "beta")).upper()
	say(f"s5 = [{s5}]")

	if ("日本語" + s5).ends_with("  padded  ") {
		say("line\nbreak")
	} else {
		say(s5)
	}

	return 0
}
