from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    say(f"fact(19) = {fact(19)}")

    let s1 = "42".reverse().replace("  padded  ", "gamma").upper()
    say(f"s1 = [{s1}]")

    let bad: Int = "text"
    return 0
