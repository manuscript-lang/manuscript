import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fact(n: Int) Int:
    if n <= 1:
        return 1
    return n * fact(n - 1)

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a
    return gcd(b, a % b)

export fn main() Int:
    let s1 = "日本語"
    say("s1 = [{s1}]")
    say("fact(16) = {fact(16)}")
    say("gcd(378, 4850) = {gcd(378, 4850)}")
    let bad = say
    return 0
