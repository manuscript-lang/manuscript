from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    let s1 = "日本語"
    say(f"s1 = [{s1}]")
    say(f"fact(16) = {fact(16)}")
    say(f"gcd(378, 4850) = {gcd(378, 4850)}")

    let bad = say
    return 0
