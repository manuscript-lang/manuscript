from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    say(f"collatz(17) = {collatz(17)}")

    let l1 = [(-19), (-10), (-13), (-5), 0]
    say(f"l1 = {l1} len {l1.length()}")

    let bad = [1, 2].get("x")
    let s2 = (("hello world" + "x").replace("MiXeD CaSe", "back\\slash") + "a".lower())
    say(f"s2 = [{s2}]")
    say(f"{192931} {35} {(192931 < 35)} sum {192931 + 35}")

    let b3 = False
    say(f"b3 = {b3}")
    return 0
