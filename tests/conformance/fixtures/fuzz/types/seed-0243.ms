import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn collatz(start: Int) Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export fn main() Int:
    say("collatz(2035) = {collatz(2035)}")

    let i1 = ((400300 - (7 - (-37))) * 17)
    say("i1 = {i1}")

