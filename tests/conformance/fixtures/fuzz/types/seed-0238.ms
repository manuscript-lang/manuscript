from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    if ("emoji 😀" + "brace{s}").is_empty():
        say("back\\slash".lower())
    else:
        say(("brace{s}" + ""))

    say(f"gcd(3181, 1800) = {gcd(3181, 1800)}")
    return "not an int"

    let f1 = ((772.25 - 0.0) * 277.25)
    say(f"f1 = {f1}")
    return 0
