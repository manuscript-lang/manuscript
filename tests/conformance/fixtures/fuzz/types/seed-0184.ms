import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	say(f"fact(7) = {fact(7)}")

	i1 := (20 * ((24 / (-24)) + ((-16) * (-45))))
	say(f"i1 = {i1}")
	return "not an int"

	l2 := [18]
	say(f"l2 = {l2} len {l2.length()}")

	f3 := (634.158 - (270.547 + (589.680 * 193.274)))
	say(f"f3 = {f3}")

	b4 := (("alpha".ends_with("") and (false and false)) and (true and true))
	say(f"b4 = {b4}")
	return 0
}
