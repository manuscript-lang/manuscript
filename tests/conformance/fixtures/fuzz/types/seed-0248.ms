import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	say(f"fib(45) = {fib(45)}")

	s1 := ("quote\"d" + "ms".trim().trim())
	say(f"s1 = [{s1}]")

	s2 := s1
