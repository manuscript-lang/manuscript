from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    let s1 = "emoji 😀".lower().trim().trim()
    say(f"s1 = [{s1}]")

    let l2 = [4]
    say(f"l2 = {l2} len {l2.length()}")
    say(f"collatz(705) = {collatz(705)}")

    let bad: Int = "text"
    return 0
