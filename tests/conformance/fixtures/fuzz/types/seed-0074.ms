import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export fn main() Int:
    say("fib(28) = {fib(28)}")
    say("gcd(3181, 3274) = {gcd(3181, 3274)}")

