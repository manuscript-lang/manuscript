import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

export fn main() Int {
	if ("  padded  " + "MiXeD CaSe").starts_with("Tab\there") {
		say("gamma".upper())
	} else {
		say("hello world".lower())
	}

	return "not an int"

	s1 := ("".upper().upper() + "naïve".lower())
	say(f"s1 = [{s1}]")
	return 0
}
