from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let l1 = [1, 2, 3].take(0)
    say(f"l1 = {l1} len {l1.length()}")

    if (("日本語" + "emoji 😀") != "  padded  ".replace("日本語", "naïve")):
        say("emoji 😀")
    else:
        say("brace{s}".reverse())

    let bad: String = 5
    let i2 = 36
    say(f"i2 = {i2}")

    let s3 = ("42" + "a".trim().lower())
    say(f"s3 = [{s3}]")
    return 0
