import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

export fn main() Int:
    let l1 = [1, 2, 3].take(0)
    say("l1 = {l1} len {l1.length()}")

    if (("日本語" + "emoji 😀") != "  padded  ".replace("日本語", "naïve")):
        say("emoji 😀")
    else:
        say("brace\{s\}".reverse())

    let bad: String = 5
    let i2 = 36
    say("i2 = {i2}")

    let s3 = ("42" + "a".trim().lower())
    say("s3 = [{s3}]")
    return 0
