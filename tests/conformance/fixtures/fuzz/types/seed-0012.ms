def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let b1 = "日本語".trim().upper().contains("42")
    say(f"b1 = {b1}")

    let f2 = 3.5
    say(f"f2 = {f2}")

    let bad = True + 1
