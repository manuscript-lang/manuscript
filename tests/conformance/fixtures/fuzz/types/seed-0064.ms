def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let i1 = (-545243)
    say(f"i1 = {i1}")

    let bad = 1 + "one"
    let f2 = 6.0e5
    say(f"f2 = {f2}")

    let l3 = [(-9), 17]
    say(f"l3 = {l3} len {l3.length()}")

    let b4 = ("back\\slash".upper().lower() == "a")
    say(f"b4 = {b4}")
