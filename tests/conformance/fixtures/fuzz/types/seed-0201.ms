    say(f"l1 = {l1} len {l1.length()}")

    let f2 = ((0.0 + (37.124 + 2.5)) + ((535.732 - 9.0e3) * 162.472))
    say(f"f2 = {f2}")
    say(f"collatz(1628) = {collatz(1628)}")

    let l3 = l1.drop(2)
    say(f"l3 = {l3} len {l3.length()}")

    let f4 = (0.0 * ((f2 * 2.0e2) / 57.761))
    say(f"f4 = {f4}")

    let i5 = (((-42) / (22 % (-32))) * 35)
    say(f"i5 = {i5}")

    let bad = True + 1
