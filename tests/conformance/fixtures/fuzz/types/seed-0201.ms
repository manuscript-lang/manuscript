import stdout from "@std/io/io.ms"

fn say(text String) Void {
	written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	l1 := [7, 7, (-5), (-10)]
	say(f"l1 = {l1} len {l1.length()}")

	f2 := ((0.0 + (37.124 + 2.5)) + ((535.732 - 9.0e3) * 162.472))
	say(f"f2 = {f2}")
	say(f"collatz(1628) = {collatz(1628)}")

	l3 := l1.drop(2)
	say(f"l3 = {l3} len {l3.length()}")

	f4 := (0.0 * ((f2 * 2.0e2) / 57.761))
	say(f"f4 = {f4}")

	i5 := (((-42) / (22 % (-32))) * 35)
	say(f"i5 = {i5}")

	bad := true + 1
	i6 := (5 / i5)
	say(f"i6 = {i6}")
	return 0
}
