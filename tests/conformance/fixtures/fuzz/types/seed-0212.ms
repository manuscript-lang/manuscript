from "@std/io.ms" import stdout
from "@std/collections.ms" import range

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    var acc1 = 0
    for i in range(0, 7):
        acc1 += i * 9
    say(f"acc1 = {acc1}")

    let s2 = "MiXeD CaSe".lower()
    say(f"s2 = [{s2}]")

    var acc3 = 0
    for i in range(0, 7):
        acc3 += i * 7
    say(f"acc3 = {acc3}")

    let bad: Bool = 1
    say(f"gcd(2021, 3909) = {gcd(2021, 3909)}")
    return 0
