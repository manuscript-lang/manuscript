from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export def main() -> Int:
    say(f"gcd(1637, 325) = {gcd(1637, 325)}")

    let f1 = (9.0e11 * 3.5)
    say(f"f1 = {f1}")

    let i2 = (7 * 4)
    say(f"i2 = {i2}")
    say(f"fib(36) = {fib(36)}")

    let s3 = "hello world".replace("delta", "MiXeD CaSe")
    say(f"s3 = [{s3}]")
    return "not an int"

    let b4 = (f"{i2}:" + s3.trim()).is_empty()
    say(f"b4 = {b4}")
    say(f"fib(28) = {fib(28)}")
    return 0
