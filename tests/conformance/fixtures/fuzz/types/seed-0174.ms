from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let l1 = [12, (-23), (-4), 26, 21]
    say(f"l1 = {l1} len {l1.length()}")

    let i2 = 527241
    say(f"i2 = {i2}")

    let i3 = 23
    say(f"i3 = {i3}")
    say(f"fact(20) = {fact(20)}")

    let s4 = ("hello world" + "日本語")
    say(f"s4 = [{s4}]")

    let fixed = 1
    fixed = 2
    return 0
