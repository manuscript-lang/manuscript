import stdout from "@std/io/io.ms"

fn say(text String) Void:
    written := stdout().write(f"{text}\n")

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    l1 := [12, (-23), (-4), 26, 21]
    say(f"l1 = {l1} len {l1.length()}")

    i2 := 527241
    say(f"i2 = {i2}")

    i3 := 23
    say(f"i3 = {i3}")
    say(f"fact(20) = {fact(20)}")

    s4 := ("hello world" + "日本語")
    say(f"s4 = [{s4}]")

    fixed := 1
    fixed = 2
    return 0
