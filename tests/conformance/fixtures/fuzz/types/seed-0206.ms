import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

export fn main() Int:
    var acc2 = 0
    var stepacc2 = 0

    while stepacc2 < 4:
        stepacc2 += 1
        acc2 += stepacc2 * stepacc2 + (-1)

    say("acc2 = {acc2}")

    var acc3 = 0
    for i in 0..6:
        acc3 += i * 1
    say("acc3 = {acc3}")

    let s4 = "Tab\there"
    say("s4 = [{s4}]")

    let i5 = 23
    say("i5 = {i5}")

    let s6 = "x".reverse()
    say("s6 = [{s6}]")
