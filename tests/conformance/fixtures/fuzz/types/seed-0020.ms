    say("b1 = {b1}")

    var acc2 = 0
    for i in 0..0:
        acc2 += i * 8
    say("acc2 = {acc2}")

    let bad = [1, "two"]
    let l3 = [(-23), 28]
    say("l3 = {l3} len {l3.length()}")
