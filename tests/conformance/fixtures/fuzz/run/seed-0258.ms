from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    let i1 = ((-((-5) * (-42))) * ((-43) * ((-825982) + (-26))))
    say(f"i1 = {i1}")

    let s2 = "日本語"
    say(f"s2 = [{s2}]")

    let s3 = (f"{(243873 / (-8))}:" + "Tab\there")
    say(f"s3 = [{s3}]")

    if (20 != (i1 / 46)):
        say("quote\"d")
    else:
        say(s2.reverse())

    let l4 = [19, (-11)]
    say(f"l4 = {l4} len {l4.length()}")

    let i5 = s2.length()
    say(f"i5 = {i5}")

    let l6 = l4.reversed()
    say(f"l6 = {l6} len {l6.length()}")
    say(f"collatz(1262) = {collatz(1262)}")
    return 0
