from "@std/io.ms" import stdout
from "@std/collections.ms" import range

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    var acc1 = 0
    for i in range(0, 2):
        acc1 += i * 4
    say(f"acc1 = {acc1}")

    let f2 = (1.0e19 * (2.5 + 708.836))
    say(f"f2 = {f2}")

    let f3 = 7.0e4
    say(f"f3 = {f3}")
    say(f"fact(11) = {fact(11)}")

    let b4 = False
    say(f"b4 = {b4}")

    let b5 = (((not False) and "日本語".is_empty()) and ((not b4) and b4))
    say(f"b5 = {b5}")

    let i6 = 40
    say(f"i6 = {i6}")
    return 0
