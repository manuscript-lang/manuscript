    say(f"f4 = {f4}")

    let f5 = (((f4 + f4) * f4) + ((f4 + f4) + (f4 * 861.975)))
    say(f"f5 = {f5}")

    let i6 = i2
    say(f"i6 = {i6}")

    let s7 = (
        ("brace{s}" + "emoji 😀").replace("  padded  ", "brace{s}")
        + "line\nbreak"
    )
    say(f"s7 = [{s7}]")

    let s8 = (s7 + (f"{37}:" + "Tab\there"))
