    let b3 = (((i2 - i2) + 434072) >= i2)
    say("b3 = {b3}")
    say("collatz(1092) = {collatz(1092)}")

    let i4 = i2
    say("i4 = {i4}")

    let l5 = [(-13), 7, 22]
    say("l5 = {l5} len {l5.length()}")

    let f6 = (745.589 * ((234.160 + 0.0) / 791.592))
