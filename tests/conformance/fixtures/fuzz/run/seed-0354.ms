    say(f"f1 = {f1}")

    let s2 = ("alpha" + (("MiXeD CaSe" + "naïve") + "alpha".trim()))
    say(f"s2 = [{s2}]")

    if True:
        say("42".reverse())
    else:
        say("emoji 😀".reverse())

    let l3 = [(-24), (-10), 10, (-28), (-27)]
    say(f"l3 = {l3} len {l3.length()}")

    let i4 = (33 / (-46))
    say(f"i4 = {i4}")

    let i5 = (-28)
    say(f"i5 = {i5}")

    let b6 = (((i4 + i4) - ((-6) % 267480)) <= 2)
    say(f"b6 = {b6}")

    let i7 = ((-(i5 % (-15))) + (-23))
    say(f"i7 = {i7}")
    return 0
