import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

export fn main() Int:
    f1 := 3.5
    say(f"f1 = {f1}")

    s2 := ("alpha" + (("MiXeD CaSe" + "naïve") + "alpha".trim()))
    say(f"s2 = [{s2}]")

    if true:
        say("42".reverse())
    else:
        say("emoji 😀".reverse())

    l3 := [(-24), (-10), 10, (-28), (-27)]
    say(f"l3 = {l3} len {l3.length()}")

    i4 := (33 / (-46))
    say(f"i4 = {i4}")

    i5 := (-28)
    say(f"i5 = {i5}")

    b6 := (((i4 + i4) - ((-6) % 267480)) <= 2)
    say(f"b6 = {b6}")

    i7 := ((-(i5 % (-15))) + (-23))
    say(f"i7 = {i7}")
    return 0
