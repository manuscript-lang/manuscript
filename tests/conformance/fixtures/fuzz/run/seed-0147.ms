import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

fn collatz(start Int) Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export fn main() Int:
    say(f"collatz(373) = {collatz(373)}")

    l1 := [(-6), 21, (-22), 19]
    say(f"l1 = {l1} len {l1.length()}")

    var acc2 = 0

    for x in l1:
        if x % 2 == 0:
            acc2 += x
        else:
            acc2 -= 1

    say(f"acc2 = {acc2}")

    l3 := [(-10), 13, (-25), 13]
    say(f"l3 = {l3} len {l3.length()}")

    b4 := false
    say(f"b4 = {b4}")
    say(f"collatz(1467) = {collatz(1467)}")

    i5 := 33
    say(f"i5 = {i5}")

    s6 := (
        ("héllo" + ("back\\slash" + "delta"))
        + ("".lower() + ("a" + "  padded  "))
    )
    say(f"s6 = [{s6}]")

    s7 := (s6 + s6.upper()).replace("ms", "alpha")
    say(f"s7 = [{s7}]")
    say(
        f"{i5} {(i5 * (i5 - (-42)))} {(i5 < (i5 * (i5 - (-42))))} sum {i5 + (i5 * (i5 - (-42)))}"
    )

    i8 := ((l3.length() * s6.scalar_length()) + (-25))
    say(f"i8 = {i8}")

    i9 := i5
    say(f"i9 = {i9}")

    f10 := 1.5
    say(f"f10 = {f10}")

    l11 := [1, 2, 3].take(0)
    say(f"l11 = {l11} len {l11.length()}")

    big12 := 9223372036854775807
    say(f"{big12 * 6}")
    return 0
