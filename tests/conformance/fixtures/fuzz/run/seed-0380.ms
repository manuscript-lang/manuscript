from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    if (True and True):
        say("brace{s}".replace("brace{s}", "delta"))
    else:
        say("a")

    let b1 = False
    say(f"b1 = {b1}")

    let i2 = (-40)
    say(f"i2 = {i2}")

    let l3 = [1, 2, 3].take(0)
    say(f"l3 = {l3} len {l3.length()}")

    let b4 = (not (not "quote\"d".ends_with("beta")))
    say(f"b4 = {b4}")

    let i5 = ((-(i2 + i2)) * (i2 + i2))
    say(f"i5 = {i5}")

    let i6 = (l3.length() + 3)
    say(f"i6 = {i6}")

    let big7 = -9223372036854775808
    say(f"{big7 - 2}")
    return 0
