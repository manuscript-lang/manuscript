    say("b4 = {b4}")

    i5 := ((i2 - ((-433651) + i2)) - (-296182655034))
    say("i5 = {i5}")

    f6 := 912.234
    say("f6 = {f6}")

    s7 := "back\\slash".upper().lower().replace("line\nbreak", "line\nbreak")
    say("s7 = [{s7}]")
    say("collatz(985) = {collatz(985)}")

