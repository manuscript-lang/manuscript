from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let s1 = (f"{(-709125)}:" + "x").replace("héllo", "  padded  ")
    say(f"s1 = [{s1}]")

    let l2 = [6, 0]
    say(f"l2 = {l2} len {l2.length()}")

    let f3 = (8.0e4 * 142.25)
    say(f"f3 = {f3}")

    let f4 = ((f3 * (f3 * 979.285)) - (f3 - (f3 * f3)))
    say(f"f4 = {f4}")

    let l5 = l2.filter(lambda x: x > 5)
    say(f"l5 = {l5} len {l5.length()}")

    let f6 = 264.284
    say(f"f6 = {f6}")
    return 0
