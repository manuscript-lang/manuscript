from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    let l1 = [29, (-21), 22, 6, (-6)]
    say(f"l1 = {l1} len {l1.length()}")

    let i2 = (5 - (20 - ((-838189) / (-17))))
    say(f"i2 = {i2}")
    say(f"gcd(3521, 2958) = {gcd(3521, 2958)}")

    let f3 = (((516.312 + 580.928) + 950.923) * ((715.456 + 4.5) / (567.896 + 0.0)))
    say(f"f3 = {f3}")

    let l4 = l1.concat(l1)
    say(f"l4 = {l4} len {l4.length()}")

    let l5 = l4.map(lambda x: x + 3).filter(lambda x: x % 2 == 0)
    say(f"l5 = {l5} len {l5.length()}")

    let l6 = l4.drop(3)
    say(f"l6 = {l6} len {l6.length()}")
    return 0
