from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let s1 = (
        "alpha".trim().upper()
        + (f"{(-969468989409)}:" + ("back\\slash" + "  padded  "))
    )
    say(f"s1 = [{s1}]")

    let i2 = ((((-30) + (-845579)) * (45 / 25)) / ((-4) % (-25)))
    say(f"i2 = {i2}")

    let i3 = ((12 / i2) * i2)
    say(f"i3 = {i3}")

    let l4 = [2]
    say(f"l4 = {l4} len {l4.length()}")

    let l5 = l4.map(lambda x: x + 3).filter(lambda x: x % 2 == 0)
    say(f"l5 = {l5} len {l5.length()}")

    let b6 = s1.is_empty()
    say(f"b6 = {b6}")
    return 0
