from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let b1 = ("brace{s}" + "x".upper()).starts_with("MiXeD CaSe")
    say(f"b1 = {b1}")

    let l2 = [21, (-23)]
    say(f"l2 = {l2} len {l2.length()}")

    let s3 = "alpha".reverse().reverse().trim()
    say(f"s3 = [{s3}]")

    let l4 = l2.sorted(lambda a, b: a.compare(b))
    say(f"l4 = {l4} len {l4.length()}")

    let i5 = ((-((-8) - (-14))) + (22 / (47 + 15)))
    say(f"i5 = {i5}")

    let f6 = ((332.238 * 0.0) / (712.866 * 287.565))
    say(f"f6 = {f6}")
    say(
        f"{(((-37) + i5) * (i5 * 22))} {(26 + (i5 + 50))} {((((-37) + i5) * (i5 * 22)) < (26 + (i5 + 50)))} sum {(((-37) + i5) * (i5 * 22)) + (26 + (i5 + 50))}"
    )

    var acc7 = 0
    for i in 0..5:
        acc7 += i * 9
    say(f"acc7 = {acc7}")
    say(f"fact(19) = {fact(19)}")

    let l8 = l4.sorted(lambda a, b: a.compare(b))
    say(f"l8 = {l8} len {l8.length()}")

    let b9 = (
        (f"{(i5 + i5)}:" + "hello world").ends_with("42")
        or ((s3 != s3) and (b1 or b1))
    )
    say(f"b9 = {b9}")

    let i10 = (((i5 * 29) * (-i5)) - ((i5 % 14) % (-19)))
    say(f"i10 = {i10}")

    let l11 = l4.sorted(lambda a, b: a.compare(b))
    say(f"l11 = {l11} len {l11.length()}")
    return 0
