from "@std/io.ms" import stdout
from "@std/collections.ms" import range

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    say(f"collatz(1597) = {collatz(1597)}")

    let s1 = ("héllo" + ("alpha" + "gamma")).lower()
    say(f"s1 = [{s1}]")

    let f2 = (((289.064 / 477.073) * 1.0e22) + (193.963 / (31.449 - 9.5)))
    say(f"f2 = {f2}")

    var acc3 = 0
    for i in range(0, 4):
        acc3 += i * 2
    say(f"acc3 = {acc3}")
    say(f"gcd(1432, 1558) = {gcd(1432, 1558)}")

    let l4 = [1, 2, 3].take(0)
    say(f"l4 = {l4} len {l4.length()}")

    let l5 = l4.sorted(lambda a, b: a.compare(b))
    say(f"l5 = {l5} len {l5.length()}")

    var acc6 = 0
    var stepacc6 = 0

    while stepacc6 < 2:
        stepacc6 += 1
        acc6 += stepacc6 * stepacc6 + (-4)

    say(f"acc6 = {acc6}")
    return 0
