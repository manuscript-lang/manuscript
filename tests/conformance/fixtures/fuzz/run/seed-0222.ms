from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    var acc1 = 0
    var stepacc1 = 0

    while stepacc1 < 7:
        stepacc1 += 1
        acc1 += stepacc1 * stepacc1 + 4

    say(f"acc1 = {acc1}")

    let l2 = [(-17), 21, 4, 14]
    say(f"l2 = {l2} len {l2.length()}")

    let l3 = l2.sorted(lambda a, b: a.compare(b))
    say(f"l3 = {l3} len {l3.length()}")

    let i4 = 35
    say(f"i4 = {i4}")

    let i5 = i4
    say(f"i5 = {i5}")

    let f6 = (((4.5 - 221.370) - (935.047 + 307.25)) * 245.25)
    say(f"f6 = {f6}")
    return 0
