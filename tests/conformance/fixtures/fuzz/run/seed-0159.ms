    let i4 = (((99587 / 909334710051) / 592453) * (((-21) / 38) + (757980046587 % 43)))
    say("i4 = {i4}")

    let s5 = ("ms" + s1.lower().replace(s1, s1))
    say("s5 = [{s5}]")
    say("fib(48) = {fib(48)}")

    var acc6 = 0
