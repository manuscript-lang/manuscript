from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    let s1 = "naïve"
    say(f"s1 = [{s1}]")

    let i2 = (-36)
    say(f"i2 = {i2}")

    let i3 = (((-6) + (25 + (-22))) / (-41))
    say(f"i3 = {i3}")

    let f4 = ((970.25 - (433.194 - 362.523)) - (5.0e-9 * (0.0 / 666.818)))
    say(f"f4 = {f4}")

    let i5 = s1.length()
    say(f"i5 = {i5}")

    let s6 = ((f"{s1.length()}:" + s1) + s1)
    say(f"s6 = [{s6}]")

    let f7 = ((709.084 + (f4 / f4)) + ((f4 / f4) + (f4 * f4)))
    say(f"f7 = {f7}")

    let l8 = [1, 2, 3].take(0)
    say(f"l8 = {l8} len {l8.length()}")
    return 0
