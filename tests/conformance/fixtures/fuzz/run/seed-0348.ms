}

export fn main() Int {
	s1 := "naïve"
	say(f"s1 = [{s1}]")

	i2 := (-36)
	say(f"i2 = {i2}")

	i3 := (((-6) + (25 + (-22))) / (-41))
	say(f"i3 = {i3}")

	f4 := ((970.25 - (433.194 - 362.523)) - (5.0e-9 * (0.0 / 666.818)))
	say(f"f4 = {f4}")

	i5 := s1.scalar_length()
	say(f"i5 = {i5}")

	s6 := ((f"{s1.scalar_length()}:" + s1) + s1)
	say(f"s6 = [{s6}]")

	f7 := ((709.084 + (f4 / f4)) + ((f4 / f4) + (f4 * f4)))
	say(f"f7 = {f7}")

	l8 := [1, 2, 3].take(0)
	say(f"l8 = {l8} len {l8.length()}")
	return 0
}
