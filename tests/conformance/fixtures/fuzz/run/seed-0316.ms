import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

export fn main() Int {
	f1 := 898.425
	say(f"f1 = {f1}")

	f2 := 0.0
	say(f"f2 = {f2}")

	var acc3 = 0
	for i in 0..0 {
		acc3 += i * (-5)
	}
	say(f"acc3 = {acc3}")

	f4 := 0.0
	say(f"f4 = {f4}")

	i5 := (22 * 836288)
	say(f"i5 = {i5}")

	s7 := ("日本語" + "")
	say(f"s7 = [{s7}]")

	i8 := i5
	say(f"i8 = {i8}")

	b9 := s7.contains(s7)
	say(f"b9 = {b9}")
	return 0
}
