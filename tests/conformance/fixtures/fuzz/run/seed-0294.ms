from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    say(f"fact(16) = {fact(16)}")

    let s1 = "  padded  ".lower()
    say(f"s1 = [{s1}]")

    let s2 = s1.trim()
    say(f"s2 = [{s2}]")

    let b3 = (
        (f"{((-35) / (-626112))}:" + ("42" + "quote\"d")) == (
            s2.trim()
            + "ms".lower()
        )
    )
    say(f"b3 = {b3}")

    let i4 = ((-30) * (-279449))
    say(f"i4 = {i4}")
    say(f"gcd(184, 3086) = {gcd(184, 3086)}")

    if ((232.294 / 557.25) < 9.0e-9):
        say((s2 + "delta"))
    else:
        say(("42" + "  padded  "))

    let s5 = (f"{(-16)}:" + "alpha")
    say(f"s5 = [{s5}]")
    return 0
