import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

fn gcd(a Int, b Int) Int:
    if b == 0:
        return a

    return gcd(b, a % b)

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    f1 := 8.5
    say(f"f1 = {f1}")
    say(f"gcd(1893, 4201) = {gcd(1893, 4201)}")
    say(f"{(-7)} {(-1)} {((-7) < (-1))} sum {(-7) + (-1)}")

    l2 := [9, (-19)]
    say(f"l2 = {l2} len {l2.length()}")

    b3 := false
    say(f"b3 = {b3}")
    say(f"{(-(-26))} {43} {((-(-26)) < 43)} sum {(-(-26)) + 43}")

    i4 := ((24 / (49 * (-15))) + 916130)
    say(f"i4 = {i4}")
    say(
        f"{i4} {((31 * i4) % l2.length())} {(i4 < ((31 * i4) % l2.length()))} sum {i4 + ((31 * i4) % l2.length())}"
    )
    say(f"fact(11) = {fact(11)}")

    b5 := (false and ((true and false) and "x".is_empty()))
    say(f"b5 = {b5}")
    return 0
