from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let f1 = 8.5
    say(f"f1 = {f1}")
    say(f"gcd(1893, 4201) = {gcd(1893, 4201)}")
    say(f"{(-7)} {(-1)} {((-7) < (-1))} sum {(-7) + (-1)}")

    let l2 = [9, (-19)]
    say(f"l2 = {l2} len {l2.length()}")

    let b3 = False
    say(f"b3 = {b3}")
    say(f"{(-(-26))} {43} {((-(-26)) < 43)} sum {(-(-26)) + 43}")

    let i4 = ((24 / (49 * (-15))) + 916130)
    say(f"i4 = {i4}")
    say(
        f"{i4} {((31 * i4) % l2.length())} {(i4 < ((31 * i4) % l2.length()))} sum {i4 + ((31 * i4) % l2.length())}"
    )
    say(f"fact(11) = {fact(11)}")

    let b5 = (False and ((True and False) and "x".is_empty()))
