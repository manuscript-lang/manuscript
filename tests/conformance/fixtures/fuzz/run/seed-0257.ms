from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    let i1 = (-704938)
    say(f"i1 = {i1}")

    let l2 = [(-5)]
    say(f"l2 = {l2} len {l2.length()}")

    let l3 = [(-17), (-28), 15, (-20)]
    say(f"l3 = {l3} len {l3.length()}")

    let s4 = (
        ("  padded  ".replace("ms", "42") + ("alpha" + "brace{s}"))
        + "emoji 😀".reverse().lower()
    )
    say(f"s4 = [{s4}]")
    say(f"collatz(2631) = {collatz(2631)}")

    let l5 = l2.filter(lambda x: x > (-4))
    say(f"l5 = {l5} len {l5.length()}")

    let s6 = "x"
    say(f"s6 = [{s6}]")

    let i7 = (((i1 / i1) + (16 * i1)) + (l2.get(0) + i1))
    say(f"i7 = {i7}")

    let l8 = l2.drop(0)
    say(f"l8 = {l8} len {l8.length()}")

    let s9 = (f"{i7}:" + s4)
    say(f"s9 = [{s9}]")

    let b10 = (not ("ms" != ("back\\slash" + s9)))
    say(f"b10 = {b10}")
    return 0
