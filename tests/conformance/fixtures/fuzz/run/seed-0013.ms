from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    var acc1 = 0
    for i in 0..5:
        acc1 += i * 6
    say(f"acc1 = {acc1}")

    let i2 = 195125
    say(f"i2 = {i2}")

    let l3 = [1, 2, 3].take(0)
    say(f"l3 = {l3} len {l3.length()}")
    say(f"fact(10) = {fact(10)}")

    let s4 = "  padded  ".reverse()
    say(f"s4 = [{s4}]")

    let b5 = (
        (not "emoji 😀".ends_with(s4))
        and ("line\nbreak".trim() == s4.replace("héllo", "x"))
    )
    say(f"b5 = {b5}")

    let s6 = (
        "  padded  "
        .replace(s4, "日本語")
        .replace(s4, "MiXeD CaSe")
        .replace("back\\slash", "naïve")
    )
    say(f"s6 = [{s6}]")

    let b7 = (s4.length() >= i2)
    say(f"b7 = {b7}")

    let l8 = l3.filter(lambda x: x > (-4))
    say(f"l8 = {l8} len {l8.length()}")

    let i9 = ((i2 * (-i2)) % ((i2 - i2) - i2))
    say(f"i9 = {i9}")

    let i10 = 26
    say(f"i10 = {i10}")

    let i11 = l8.length()
    say(f"i11 = {i11}")

    let i12 = (i2 + 50)
    say(f"i12 = {i12}")

    if ((914.132 - 81.111) == (595.25 + 786.106)):
        say(s6.upper())
    else:
        say(s4.trim())

    let i13 = (-86388573707)
    say(f"i13 = {i13}")

    var acc14 = 0
    for i in 0..0:
        acc14 += i * 6
    say(f"acc14 = {acc14}")
    return 0
