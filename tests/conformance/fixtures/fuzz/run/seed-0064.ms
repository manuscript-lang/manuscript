import stdout from "@std/io.ms"
import {range} from "@std/collections.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export fn main() Int:
    let b1 = false
    say("b1 = {b1}")

    let s2 = ("ms" + "beta")
    say("s2 = [{s2}]")

    var acc4 = 0
    for i in range(0, 1):
        acc4 += i * 9
    say("acc4 = {acc4}")

    let s5 = s2.upper().trim()
    say("s5 = [{s5}]")

    let f6 = 9.5
    say("f6 = {f6}")
    say("fib(12) = {fib(12)}")

    let l7 = [21, (-30), (-19), (-7), 9]
    say("l7 = {l7} len {l7.length()}")

    if (s5.replace(s2, "x") != ("hello world" + "gamma")):
        say(s2)
    else:
        say(s5.upper())

    return 0
