from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export def main() -> Int:
    let b1 = False
    say(f"b1 = {b1}")

    let s2 = ("ms" + "beta")
    say(f"s2 = [{s2}]")

    var acc4 = 0
    for i in 0..1:
        acc4 += i * 9
    say(f"acc4 = {acc4}")

    let s5 = s2.upper().trim()
    say(f"s5 = [{s5}]")

    let f6 = 9.5
    say(f"f6 = {f6}")
    say(f"fib(12) = {fib(12)}")

    let l7 = [21, (-30), (-19), (-7), 9]
    say(f"l7 = {l7} len {l7.length()}")

    if (s5.replace(s2, "x") != ("hello world" + "gamma")):
        say(s2)
    else:
        say(s5.upper())

    return 0
