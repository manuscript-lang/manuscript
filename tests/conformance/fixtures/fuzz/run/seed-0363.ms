import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	i1 := (14 * 691615)
	say(f"i1 = {i1}")

	b2 := ((not (not false)) or ((34 * (-24)) >= (-i1)))
	say(f"b2 = {b2}")

	b3 := ("beta" + "delta".upper()).is_empty()
	say(f"b3 = {b3}")

	if "brace{s}".starts_with("back\\slash") {
		say(("line\nbreak" + "héllo"))
	} else {
		say("ms".replace("alpha", "42"))
	}

	say(f"fib(37) = {fib(37)}")

	s4 := (f"{i1}:" + (f"{i1}:" + "x")).replace("line\nbreak", "ms")
	say(f"s4 = [{s4}]")

	var acc5 = 0
	for i in 0..2 {
		acc5 += i * 3
	}
	say(f"acc5 = {acc5}")

	f7 := (
		((230.000 * 825.25) * (643.463 + 6.0e9))
		* ((16.712 + 8.5) * (621.944 * 0.0))
	)
	say(f"f7 = {f7}")
	return 0
}
