    l4.append(50)
    say("l4 = {l4} len {l4.length()}")

    let i5 = (-9223372036854775808)
    say("i5 = {i5}")

    let i6 = l1.length()
    say("i6 = {i6}")

    let s7 = "gamma"
    say("s7 = [{s7}]")

    let l8 = l4.take(2)
    say("l8 = {l8} len {l8.length()}")

    let l9 = l4.concat(l4)
