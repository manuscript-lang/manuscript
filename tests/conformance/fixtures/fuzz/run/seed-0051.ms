import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export fn main() Int:
    let l1 = [9, (-4), 29, (-15)]
    say("l1 = {l1} len {l1.length()}")
    say("fib(2) = {fib(2)}")

    let i2 = (-20)
    say("i2 = {i2}")

    let i3 = (i2 * (-46))
    say("i3 = {i3}")

    let i4 = (((i3 * i2) + i3) + i2)
    say("i4 = {i4}")

    var acc5 = 0

    for x in l1:
        if x % 2 == 0:
            acc5 += x
        else:
            acc5 -= 1

    say("acc5 = {acc5}")
    return 0
