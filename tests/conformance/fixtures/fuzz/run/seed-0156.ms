import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    let _written = stdout().write("{text}\n")

fn fact(n: Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export fn main() Int:
    let b2 = true
    say("b2 = {b2}")
    say("fact(5) = {fact(5)}")

    let l3 = [9, 10, 0]
    say("l3 = {l3} len {l3.length()}")
    say(
        "{((13 + 20) + 30)} {(-5)} {(((13 + 20) + 30) < (-5))} sum {((13 + 20) + 30) + (-5)}"
    )
    say("gcd(110, 3342) = {gcd(110, 3342)}")

    let f4 = ((202.733 + (112.645 * 758.485)) / (870.849 * 993.25))
    say("f4 = {f4}")

    let i5 = (((-(-46)) + (-148327)) / (((-40) + 37) + 31))
    say("i5 = {i5}")

    let i6 = (((-818867286454) * (i5 + i5)) + ((i5 % 671574654047) - (36 * i5)))
    say("i6 = {i6}")

    let b7 = ("日本語" + "back\\slash".lower()).starts_with("42")
    say("b7 = {b7}")

    let l8 = l3.map(fn x: x * 7)
    say("l8 = {l8} len {l8.length()}")

    let i9 = i6
