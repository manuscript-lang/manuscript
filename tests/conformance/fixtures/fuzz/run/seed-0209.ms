import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

fn gcd(a Int, b Int) Int:
    if b == 0:
        return a

    return gcd(b, a % b)

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    f1 := (((9.5 * 538.144) + (996.25 * 950.431)) - 30.197)
    say(f"f1 = {f1}")

    b2 := true
    say(f"b2 = {b2}")

    l3 := [(-16), (-24)]
    say(f"l3 = {l3} len {l3.length()}")
    say(f"gcd(3568, 322) = {gcd(3568, 322)}")

    f4 := ((47.576 * 804.318) + 298.136)
    say(f"f4 = {f4}")

    l5 := l3.concat(l3)
    say(f"l5 = {l5} len {l5.length()}")
    say(f"{33} {(-232734280815)} {(33 < (-232734280815))} sum {33 + (-232734280815)}")

    i6 := (-(348011 * ((-37) * 10)))
    say(f"i6 = {i6}")
    say(f"{i6} {i6} {(i6 < i6)} sum {i6 + i6}")

    i7 := ((-20) + i6)
    say(f"i7 = {i7}")

    s8 := ""
    say(f"s8 = [{s8}]")

    s9 := ("hello world".trim() + s8.trim())
    say(f"s9 = [{s9}]")

    b10 := false
    say(f"b10 = {b10}")

    l11 := l3.concat(l3)
    say(f"l11 = {l11} len {l11.length()}")
    say(f"fact(7) = {fact(7)}")
    return 0
