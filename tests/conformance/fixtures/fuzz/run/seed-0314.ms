    b14 := "back\\slash".starts_with("")
    say("b14 = {b14}")

    f15 := (f12 * 545.480)
    say("f15 = {f15}")

    s16 := ("{i10}:" + ("  padded  " + "".upper()))
    say("s16 = [{s16}]")
    return 0
