import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    _written := stdout().write("{text}\n")

export fn main() Int:
    f1 := 2.0e8
    say("f1 = {f1}")

    i2 := 0
    say("i2 = {i2}")

    i3 := (527843 + 37)
    say("i3 = {i3}")

    b4 := "x".upper().is_empty()
    say("b4 = {b4}")

    f5 := (f1 * (f1 / f1))
    say("f5 = {f5}")

    s6 := ""
    say("s6 = [{s6}]")

    if ((s6 == s6) and b4):
        say(("{(i2 + 18)}:" + "delta"))
    else:
        say((s6 + s6))

    return 0
