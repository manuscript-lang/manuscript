from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

export def main() -> Int:
    let b1 = (("a" + "delta").is_empty() and ((-23) >= (-18211295)))
    say(f"b1 = {b1}")

    let s3 = (("line\nbreak" + "gamma") + "  padded  ").replace("x", "quote\"d")
    say(f"s3 = [{s3}]")

    let s4 = s3.lower()
    say(f"s4 = [{s4}]")

    let l5 = [(-7), 19, (-29), 9, 1]
    say(f"l5 = {l5} len {l5.length()}")

    let i6 = 607888385042
    say(f"i6 = {i6}")

    if s4.ends_with(s4):
        say(s4.lower())
    else:
        say(("" + "delta"))

    let i7 = (((-i6) + (-4)) + 21)
    say(f"i7 = {i7}")

    if (b1 and (5 != 26)):
        say(("naïve" + ""))
    else:
        say("gamma".reverse())

    return 0
