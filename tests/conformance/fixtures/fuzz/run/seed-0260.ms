from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    let l1 = [1, 15]
    say(f"l1 = {l1} len {l1.length()}")

    let s2 = ("gamma".lower().reverse() + "beta")
    say(f"s2 = [{s2}]")

    var acc3 = 0

    for x in l1:
        if x % 2 == 0:
            acc3 += x
        else:
            acc3 -= 1

    say(f"acc3 = {acc3}")

    let i4 = 18
    say(f"i4 = {i4}")

    let i5 = i4
    say(f"i5 = {i5}")

    let i6 = (468648 * 31)
    say(f"i6 = {i6}")

    let i7 = (s2.length() * (i6 * i6))
    say(f"i7 = {i7}")

    let i8 = i6
    say(f"i8 = {i8}")

    let b9 = (s2 == ("Tab\there" + s2).lower())
    say(f"b9 = {b9}")

    let b10 = ((l1.get(1) + 963306) < ((50 * i4) + (i6 + i4)))
    say(f"b10 = {b10}")
    return 0
