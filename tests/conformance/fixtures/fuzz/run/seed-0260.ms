// conform: tags=control-flow,fuzz,interpolation,lists,numbers,stdlib-io,strings,tier-core
// conform: phase=run
// conform: origin=ms-conform fuzz-gen --kind run seed 260
// conform: deterministic=true
// Generated by ms-conform fuzz, seed 260.
import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    _written := stdout().write("{text}\n")

export fn main() Int:
    l1 := [1, 15]
    say("l1 = {l1} len {l1.length()}")

    s2 := ("gamma".lower().reverse() + "beta")
    say("s2 = [{s2}]")

    var acc3 = 0

    for x in l1:
        if x % 2 == 0:
            acc3 += x
        else:
            acc3 -= 1

    say("acc3 = {acc3}")

    i4 := 18
    say("i4 = {i4}")

    i5 := i4
    say("i5 = {i5}")

    i6 := (468648 * 31)
    say("i6 = {i6}")

    i7 := (s2.length() * (i6 * i6))
    say("i7 = {i7}")

    i8 := i6
    say("i8 = {i8}")

    b9 := (s2 == ("Tab\there" + s2).lower())
    say("b9 = {b9}")

    b10 := ((l1.get(1) + 963306) < ((50 * i4) + (i6 + i4)))
    say("b10 = {b10}")
    return 0
