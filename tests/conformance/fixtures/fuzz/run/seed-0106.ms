from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    let i1 = (((42 + (-490526)) - (12 / 770015)) * (-712776))
    say(f"i1 = {i1}")

    let i2 = (-((-i1) - (20 + (-9))))
    say(f"i2 = {i2}")

    let l3 = [(-3), (-15), (-18), 27, (-30)]
    say(f"l3 = {l3} len {l3.length()}")

    let b4 = (True and False)
    say(f"b4 = {b4}")

    let s5 = (f"{i2}:" + "x".lower())
    say(f"s5 = [{s5}]")

    if (f"{i1}:" + s5).is_empty():
        say(s5.lower())
    else:
        say("naïve")

    let l6 = l3.sorted(lambda a, b: a.compare(b))
    say(f"l6 = {l6} len {l6.length()}")

    let b7 = "delta".replace(s5, s5).is_empty()
    say(f"b7 = {b7}")

    let l8 = l3.reversed()
    say(f"l8 = {l8} len {l8.length()}")

    let f9 = (513.711 / (4.0e-8 + 258.842))
    say(f"f9 = {f9}")

    var acc10 = 0
    for i in 0..1:
        acc10 += i * 2
    say(f"acc10 = {acc10}")

    let b11 = False
    say(f"b11 = {b11}")

    let f12 = ((581.464 * (420.789 + f9)) / 3.5)
    say(f"f12 = {f12}")

    let b13 = True
    say(f"b13 = {b13}")

    let i14 = i1
    say(f"i14 = {i14}")
    return 0
