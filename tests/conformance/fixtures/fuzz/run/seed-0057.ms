    say(f"{(i2 + i3)} {(-i3)} {((i2 + i3) < (-i3))} sum {(i2 + i3) + (-i3)}")

    let s4 = "Tab\there"
    say(f"s4 = [{s4}]")

    let b5 = False
    say(f"b5 = {b5}")

    let l6 = [1, 2, 3].take(0)
