from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let b1 = False
    say(f"b1 = {b1}")

    if b1:
        say(("beta" + "back\\slash"))
    else:
        say("Tab\there".trim())

    let i2 = (108000 % (-318606))
    say(f"i2 = {i2}")
    say(f"fib(32) = {fib(32)}")
    say(f"fact(14) = {fact(14)}")

