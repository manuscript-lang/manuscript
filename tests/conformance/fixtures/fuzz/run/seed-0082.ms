}

export fn main() Int {
	i1 := ((24 - (-(-982348))) * 21)
	say(f"i1 = {i1}")

	f2 := (0.0 * (671.442 + (659.393 * 0.0)))
	say(f"f2 = {f2}")

	i3 := (-((34 + (-24)) - (i1 + 63061333053)))
	say(f"i3 = {i3}")

	l4 := [(-14), (-17), 28, 1]
	say(f"l4 = {l4} len {l4.length()}")

	s5 := ("brace{s}" + ("a" + "")).lower()
	say(f"s5 = [{s5}]")

	i6 := 30
	say(f"i6 = {i6}")
	return 0
}
