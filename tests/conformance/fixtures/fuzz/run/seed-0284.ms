from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export def main() -> Int:
    say(f"gcd(1595, 4472) = {gcd(1595, 4472)}")

    let f1 = (0.0 + (853.128 + (722.595 * 325.494)))
    say(f"f1 = {f1}")

    let s2 = ("héllo".reverse() + "42").reverse()
    say(f"s2 = [{s2}]")

    let i3 = ((-18) + (s2.length() % (41 - (-3))))
    say(f"i3 = {i3}")

    let s4 = s2.upper()
    say(f"s4 = [{s4}]")

    let s5 = (("line\nbreak" + "  padded  ").trim() + s4)
    say(f"s5 = [{s5}]")

    let s6 = (s5 + "hello world").lower().reverse()
    say(f"s6 = [{s6}]")

    let l7 = [(-17), (-19), (-3), (-25), (-26)]
    say(f"l7 = {l7} len {l7.length()}")
    return 0
