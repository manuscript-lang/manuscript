	say(f"{14} {l3.length()} {(14 < l3.length())} sum {14 + l3.length()}")

	i12 := (((i5 - 957557) / (i8 + (-21))) * i10)
	say(f"i12 = {i12}")
	say(f"collatz(1376) = {collatz(1376)}")

	i13 := i6
