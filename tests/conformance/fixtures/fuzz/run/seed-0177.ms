	say(f"fib(31) = {fib(31)}")
	say(f"collatz(2205) = {collatz(2205)}")

	i7 := i4
	say(f"i7 = {i7}")

	i8 := (24 + (i7 - i7))
	say(f"i8 = {i8}")

	s9 := (f"{(i8 - (-27))}:" + s3)
	say(f"s9 = [{s9}]")

	s10 := (f"{i8}:" + s5).reverse().lower()
	say(f"s10 = [{s10}]")

	s11 := (f"{((-5) / i8)}:" + ("ms" + "").lower())
	say(f"s11 = [{s11}]")

	b12 := true
	say(f"b12 = {b12}")

	i13 := ((-2) + l6[4])
	say(f"i13 = {i13}")

	i14 := (((i4 + i4) - (i4 - i8)) * l6[0])
	say(f"i14 = {i14}")

	s15 := "gamma"
	say(f"s15 = [{s15}]")
	return 0
}
