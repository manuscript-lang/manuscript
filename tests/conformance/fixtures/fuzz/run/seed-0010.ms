import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    b1 := (
        (
            f"{((-10) * 46)}:"
            + (f"{(5 / (-16))}:" + "héllo")
        ) == "  padded  ".lower().trim()
    )
    say(f"b1 = {b1}")
    say(f"fact(19) = {fact(19)}")

    s2 := "alpha".upper()
    say(f"s2 = [{s2}]")

    i3 := (-241601)
    say(f"i3 = {i3}")

    if "".contains("delta"):
        say("")
    else:
        say(s2.lower())

    if (not (true and true)):
        say("ms".reverse())
    else:
        say("line\nbreak".trim())

    return 0
