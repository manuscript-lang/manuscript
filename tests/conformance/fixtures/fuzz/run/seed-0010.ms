from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let b1 = (
        (
            f"{((-10) * 46)}:"
            + (f"{(5 / (-16))}:" + "héllo")
        ) == "  padded  ".lower().trim()
    )
    say(f"b1 = {b1}")
    say(f"fact(19) = {fact(19)}")

    let s2 = "alpha".upper()
    say(f"s2 = [{s2}]")

    let i3 = (-241601)
    say(f"i3 = {i3}")

    if "".contains("delta"):
        say("")
    else:
        say(s2.lower())

    if (not (True and True)):
        say("ms".reverse())
    else:
        say("line\nbreak".trim())

    return 0
