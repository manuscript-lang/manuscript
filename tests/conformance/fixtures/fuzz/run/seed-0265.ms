import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    let _written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export fn main() Int:
    say("fib(37) = {fib(37)}")

    if ((11 * 827271) > (-740776192594)):
        say("quote\"d".upper())
    else:
        say(("Tab\there" + "quote\"d"))

    let s1 = "héllo"
    say("s1 = [{s1}]")

    let l2 = [(-21), (-9), 10, 0, 17]
    say("l2 = {l2} len {l2.length()}")

    let s3 = "héllo".reverse()
    say("s3 = [{s3}]")

    let i4 = ((-2) % l2.get(2))
    say("i4 = {i4}")

    let s5 = (s1 + "x").trim().replace("quote\"d", s1)
    say("s5 = [{s5}]")

    let f6 = (
        (1.0e25 - (238.574 * 614.272))
        - ((547.25 - 715.296) * (745.541 - 19.324))
    )
    say("f6 = {f6}")

    if ((f6 + f6) != (f6 + 646.957)):
        say("x")
    else:
        say(s1.lower())

    let s7 = ("{i4}:" + s1)
    say("s7 = [{s7}]")
    return 0
