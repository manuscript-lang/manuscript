import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn collatz(start Int) Int {
	var n = start
	var steps = 0

	while n != 1 {
		if n % 2 == 0 {
			n /= 2
		} else {
			n = 3 * n + 1
		}

		steps += 1
	}

	return steps
}

export fn main() Int {
	s1 := (("line\nbreak" + "naïve".trim()) + "alpha")
	say(f"s1 = [{s1}]")

	b2 := (true and true)
	say(f"b2 = {b2}")

	f3 := 103.367
	say(f"f3 = {f3}")

	l4 := [1, 2, 3].take(0)
	say(f"l4 = {l4} len {l4.length()}")

	var acc5 = 0
	for i in 0..8 {
		acc5 += i * 3
	}
	say(f"acc5 = {acc5}")
	say(f"collatz(1676) = {collatz(1676)}")
	say(f"{l4.get(2)}")
	return 0
}
