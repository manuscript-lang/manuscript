from "@std/io.ms" import stdout
from "@std/collections.ms" import range

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def collatz(start: Int) -> Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export def main() -> Int:
    let s1 = (("line\nbreak" + "naïve".trim()) + "alpha")
    say(f"s1 = [{s1}]")

    let b2 = (True and True)
    say(f"b2 = {b2}")

    let f3 = 103.367
    say(f"f3 = {f3}")

    let l4 = [1, 2, 3].take(0)
    say(f"l4 = {l4} len {l4.length()}")

    var acc5 = 0
    for i in range(0, 8):
        acc5 += i * 3
    say(f"acc5 = {acc5}")
    say(f"collatz(1676) = {collatz(1676)}")
    say(f"{l4.get(2)}")
    return 0
