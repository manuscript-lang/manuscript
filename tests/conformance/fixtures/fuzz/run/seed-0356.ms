    s3 := ("hello world".upper() + ("quote\"d" + "  padded  ")).upper()
    say(f"s3 = [{s3}]")

    i4 := (s3.scalar_length() % (50 - ((-34) % 12)))
    say(f"i4 = {i4}")

    i5 := (i4 + (27 - s3.scalar_length()))
