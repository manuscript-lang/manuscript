import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	i1 := (331950 * (453029 * (29 * (-49))))
	say(f"i1 = {i1}")

	b2 := (f"{i1}:" + "emoji 😀".lower()).starts_with("日本語")
	say(f"b2 = {b2}")

	f3 := (131.700 + ((330.793 * 548.636) + (781.25 * 519.651)))
	say(f"f3 = {f3}")

	s4 := "ms".upper().lower().lower()
	say(f"s4 = [{s4}]")
	say(
		f"{(49 * (37 + i1))} {(((-49) - (-227636)) + (i1 + i1))} {((49 * (37 + i1)) < (((-49) - (-227636)) + (i1 + i1)))} sum {(49 * (37 + i1)) + (((-49) - (-227636)) + (i1 + i1))}"
	)

	i6 := (-17)
	say(f"i6 = {i6}")

	l7 := [(-14), (-13)]
	say(f"l7 = {l7} len {l7.length()}")

	l8 := l7.map(x => x + 2).filter(x => x % 2 == 0)
	say(f"l8 = {l8} len {l8.length()}")
	say(f"fib(48) = {fib(48)}")

	i9 := ((-41) + (l8[0] * i1))
	say(f"i9 = {i9}")

	s10 := ("brace{s}" + s4.trim())
	say(f"s10 = [{s10}]")

	i11 := l7.length()
	say(f"i11 = {i11}")

	s12 := "alpha".replace("日本語", "MiXeD CaSe")
	say(f"s12 = [{s12}]")

	big13 := 9223372036854775807
	say(f"{big13 + 3}")
	return 0
}
