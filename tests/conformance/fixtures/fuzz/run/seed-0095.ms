import stdout from "@std/io.ms"
import {range} from "@std/collections.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn collatz(start: Int) Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

export fn main() Int:
    var acc1 = 0
    for i in range(0, 1):
        acc1 += i * 4
    say("acc1 = {acc1}")

    let f2 = (((314.048 - 617.959) * (559.336 / 418.25)) / 0.0)
    say("f2 = {f2}")

