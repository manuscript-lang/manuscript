import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    _written := stdout().write("{text}\n")

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a

    return gcd(b, a % b)

fn fact(n: Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

