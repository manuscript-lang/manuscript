import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fact(n Int) Int {
	if n <= 1 {
		return 1
	}
	return n * fact(n - 1)
}

export fn main() Int {
	f1 := ((216.084 - (8.339 - 724.515)) - ((2.0e16 - 519.575) / (200.030 + 434.452)))
	say(f"f1 = {f1}")

	s3 := ("日本語" + (f"{(-22)}:" + "a".trim()))
	say(f"s3 = [{s3}]")

	f4 := (473.849 + ((3.0e11 + f1) + 800.406))
	say(f"f4 = {f4}")

	l5 := [14]
	say(f"l5 = {l5} len {l5.length()}")

	s6 := (s3.trim() + s3.replace(s3, s3)).replace(s3, s3)
	say(f"s6 = [{s6}]")
	say(f"fact(17) = {fact(17)}")

	s7 := (f"{(753806 * 29)}:" + (("gamma" + "ms") + s6))
	say(f"s7 = [{s7}]")

	f8 := (((241.655 + 207.716) * 586.609) / ((f4 / f1) * f1))
	say(f"f8 = {f8}")
	say(f"{0} {3} {(0 < 3)} sum {0 + 3}")

	i9 := 47
	say(f"i9 = {i9}")
	say(
		f"{((i9 * i9) / 44)} {35} {(((i9 * i9) / 44) < 35)} sum {((i9 * i9) / 44) + 35}"
	)

	s10 := s6
	say(f"s10 = [{s10}]")

	l11 := l5.map(x => x * 7)
	say(f"l11 = {l11} len {l11.length()}")

	i12 := ((18 % (i9 % 48)) + i9)
	say(f"i12 = {i12}")

	l13 := l5.sorted((a, b) => a.compare(b))
	say(f"l13 = {l13} len {l13.length()}")

	l14 := l11.reversed()
	say(f"l14 = {l14} len {l14.length()}")

	s15 := "brace{s}"
	say(f"s15 = [{s15}]")

	big16 := 9223372036854775807
	say(f"{big16 * 3}")
	return 0
}
