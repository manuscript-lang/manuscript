import stdout from "@std/io/io.ms"

fn say(text: String) Unit:
    let _written = stdout().write("{text}\n")

fn gcd(a: Int, b: Int) Int:
    if b == 0:
        return a

    return gcd(b, a % b)

export fn main() Int:
    let l2 = [(-23), (-22)]
    say("l2 = {l2} len {l2.length()}")

    var acc3 = 0
    var stepacc3 = 0

    while stepacc3 < 6:
        stepacc3 += 1
        acc3 += stepacc3 * stepacc3 + 4

    say("acc3 = {acc3}")

    if false:
        say("naïve")
    else:
        say("beta")

    let i4 = ((-39) + ((-741486) - (-46)))
    say("i4 = {i4}")
    say("gcd(2368, 28) = {gcd(2368, 28)}")

    let b5 = (((-(-5)) - (47 % 48)) <= (-((-36) % i4)))
    say("b5 = {b5}")

    let l6 = l2.map(fn x: x + 2).filter(fn x: x % 2 == 0)
    say("l6 = {l6} len {l6.length()}")

    let s7 = "delta".upper()
    say("s7 = [{s7}]")

    var acc8 = 0

    for x in l6:
        if x % 2 == 0:
            acc8 += x
        else:
            acc8 -= 1

    say("acc8 = {acc8}")

    let l9 = [8, (-2)]
    say("l9 = {l9} len {l9.length()}")
    return 0
