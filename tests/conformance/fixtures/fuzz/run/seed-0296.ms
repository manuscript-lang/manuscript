fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1
    return a

