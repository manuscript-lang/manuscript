from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fact(n: Int) -> Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export def main() -> Int:
    let b2 = (("MiXeD CaSe" + "delta").is_empty() and True)
    say(f"b2 = {b2}")

    let s3 = "MiXeD CaSe"
    say(f"s3 = [{s3}]")

    var acc4 = 0
    var stepacc4 = 0

    while stepacc4 < 0:
        stepacc4 += 1
        acc4 += stepacc4 * stepacc4 + (-5)

    say(f"acc4 = {acc4}")
    say(f"fact(2) = {fact(2)}")

    let f5 = 186.396
    say(f"f5 = {f5}")
    return 0
