import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

fn fact(n Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

fn fib(n Int) Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        next := a + b
        a = b
        b = next
        i += 1

    return a

export fn main() Int:
