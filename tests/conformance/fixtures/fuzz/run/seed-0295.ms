from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

export def main() -> Int:
    let i1 = (-34)
    say(f"i1 = {i1}")

    let i2 = (i1 + 42)
    say(f"i2 = {i2}")

    let s3 = "quote\"d"
    say(f"s3 = [{s3}]")

    let s4 = "  padded  "
    say(f"s4 = [{s4}]")

    if True:
        say("beta".upper())
    else:
        say(s4.upper())

    let s5 = "beta"
    say(f"s5 = [{s5}]")

    let b6 = False
    say(f"b6 = {b6}")

    var acc7 = 0
    for i in 0..4:
        acc7 += i * 7
    say(f"acc7 = {acc7}")

    let b8 = (not b6)
    say(f"b8 = {b8}")
    say(f"fib(28) = {fib(28)}")

    let i9 = ((((-50) - (-27)) + ((-40) * (-13))) - (s3.length() - i1))
