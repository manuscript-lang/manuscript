from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    let i1 = 20
    say(f"i1 = {i1}")

    let i2 = (((i1 + i1) / 488514) * i1)
    say(f"i2 = {i2}")

    let b3 = ((True or (False or True)) or (not (not True)))
    say(f"b3 = {b3}")

    let s4 = (f"{(i1 + 24)}:" + "日本語")
    say(f"s4 = [{s4}]")

    let i5 = i2
    say(f"i5 = {i5}")

    let i6 = 47
    say(f"i6 = {i6}")

    let i8 = i6
    say(f"i8 = {i8}")

    let l9 = [22, 9]
    say(f"l9 = {l9} len {l9.length()}")

    if ((True or b3) and ("back\\slash" == "quote\"d")):
        say(s4.lower())
    else:
        say("brace{s}")

    return 0
