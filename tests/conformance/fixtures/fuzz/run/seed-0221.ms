    say(f"i2 = {i2}")

    if "42".trim().ends_with("back\\slash"):
        say(("delta" + "gamma"))
    else:
        say("".trim())

    let l3 = [13, 11]
    say(f"l3 = {l3} len {l3.length()}")

    let i4 = (((i2 - (-42)) * ((-41) * i2)) * 23)
    say(f"i4 = {i4}")

