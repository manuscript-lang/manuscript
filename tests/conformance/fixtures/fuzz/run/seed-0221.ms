import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let _written = stdout().write("{text}\n")

fn collatz(start: Int) Int:
    var n = start
    var steps = 0

    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1

        steps += 1

    return steps

fn fact(n: Int) Int:
    if n <= 1:
        return 1

    return n * fact(n - 1)

export fn main() Int:
    say("collatz(1402) = {collatz(1402)}")

