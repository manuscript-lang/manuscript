import stdout from "@std/io/io.ms"

fn say(text String) Void {
	_written := stdout().write(f"{text}\n")
}

fn fib(n Int) Int {
	var a = 0
	var b = 1
	var i = 0

	while i < n {
		next := a + b
		a = b
		b = next
		i += 1
	}

	return a
}

export fn main() Int {
	i1 := (-(9 + (935188 * 9)))
	say(f"i1 = {i1}")

	i2 := (-963035)
	say(f"i2 = {i2}")

	i3 := (((40 + i1) + (i1 + (-31))) % (6 + (i2 % (-29))))
	say(f"i3 = {i3}")

	s4 := "brace{s}"
	say(f"s4 = [{s4}]")

	s5 := "quote\"d"
	say(f"s5 = [{s5}]")

	i6 := (-4)
	say(f"i6 = {i6}")

	f7 := (((30.261 + 9.0e19) - (0.0 + 2.0e15)) / (0.0 * 239.826))
	say(f"f7 = {f7}")
	say(f"fib(34) = {fib(34)}")

	i8 := (9 * i6)
	say(f"i8 = {i8}")

	l9 := [(-18), (-17), (-16)]
	say(f"l9 = {l9} len {l9.length()}")

	f10 := 581.004
