from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let _written = stdout().write(f"{text}\n")

export def main() -> Int:
    let l1 = [17]
    say(f"l1 = {l1} len {l1.length()}")

    let f2 = (
        ((355.715 / 0.0) - (0.0 * 558.789))
        / ((558.25 * 2.5) * (235.552 * 801.347))
    )
    say(f"f2 = {f2}")

    let b3 = (
        "  padded  ".upper().starts_with("brace{s}")
        and "héllo".trim().starts_with("quote\"d")
    )
    say(f"b3 = {b3}")

    let f4 = f2
    say(f"f4 = {f4}")

    let i5 = (31 * (75780 * l1.length()))
    say(f"i5 = {i5}")

    let i6 = l1.get(0)
    say(f"i6 = {i6}")

    let s7 = (f"{(50 * i5)}:" + "日本語".reverse().upper())
    say(f"s7 = [{s7}]")

    let s8 = (("Tab\there" + s7).upper() + ("quote\"d" + s7).lower())
    say(f"s8 = [{s8}]")
    return 0
