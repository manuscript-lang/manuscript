import stdout from "@std/io.ms"

fn say(text: String) Unit:
    let written = stdout().write("{text}\n")

fn collatz(start: Int) Int:
    var n = start
    var steps = 0
    while n != 1:
        if n % 2 == 0:
            n = n / 2
        else:
            n = 3 * n + 1
        steps += 1
    return steps

fn fib(n: Int) Int:
    var a = 0
    var b = 1
    var i = 0
    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1
    return a

