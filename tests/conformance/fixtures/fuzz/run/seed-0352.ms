from "@std/io.ms" import stdout

def say(text: String) -> Unit:
    let written = stdout().write(f"{text}\n")

def gcd(a: Int, b: Int) -> Int:
    if b == 0:
        return a

    return gcd(b, a % b)

def fib(n: Int) -> Int:
    var a = 0
    var b = 1
    var i = 0

    while i < n:
        let next = a + b
        a = b
        b = next
        i += 1

    return a

