import stdout from "@std/io/io.ms"

fn say(text String) Void:
    _written := stdout().write(f"{text}\n")

export fn main() Int:
    i1 := (10 * (-27))
    say(f"i1 = {i1}")

    i2 := (((10 + i1) + (i1 % (-805412))) + (-40))
    say(f"i2 = {i2}")

    b3 := ("quote\"d" + "MiXeD CaSe").reverse().is_empty()
    say(f"b3 = {b3}")

    i4 := i2
    say(f"i4 = {i4}")
    say(
        f"{((-i2) % i1)} {((-416352) % ((-14) + i1))} {(((-i2) % i1) < ((-416352) % ((-14) + i1)))} sum {((-i2) % i1) + ((-416352) % ((-14) + i1))}"
    )

    l5 := [9, 29]
    say(f"l5 = {l5} len {l5.length()}")

    l6 := l5.map(x => x + 4).filter(x => x % 2 == 0)
    say(f"l6 = {l6} len {l6.length()}")

    b7 := b3
    say(f"b7 = {b7}")

    s8 := "back\\slash".replace("ms", "beta").trim().upper()
    say(f"s8 = [{s8}]")

    var acc9 = 0

    for x in l6:
        if x % 2 == 0:
            acc9 += x
        else:
            acc9 -= 1

    say(f"acc9 = {acc9}")

    s10 := s8
    say(f"s10 = [{s10}]")
    return 0
