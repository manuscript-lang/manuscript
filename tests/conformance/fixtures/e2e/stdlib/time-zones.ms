test "named zones match the Go time package":
	var checked = 0

	for line in GOLDEN.split("\n"):
		sides := line.split(" => ")
		f := sides[0].split(" ")
		want := sides[1].clone()
		var got = ""

		if f[0] == "cal":
			t := timestamp(f[1].parse_int().get(), f[2].parse_int().get())?
			c := t.calendar(f[3].clone())?
			got = f"{c.year} {c.month} {c.day} {c.hour} {c.minute} {c.second} {c.nanosecond} {c.weekday} {c.day_of_year} {c.offset_seconds} {c.zone.replace(" ", "_")}"
		else:
			r := from_calendar(
				f[1].parse_int().get(),
				f[2].parse_int().get(),
				f[3].parse_int().get(),
				f[4].parse_int().get(),
				f[5].parse_int().get(),
				f[6].parse_int().get(),
				f[7].parse_int().get(),
				f[8].clone(),
			)
			got = if r.is_error(): "ERR" else: f"{r.get().unix_seconds()}"

		expect_equal(got, want)?
		checked += 1

	expect_equal(checked, 488)?

test "zone names are exact and unknown names are rejected":
	t := parse_timestamp("2024-07-04T16:05:09.123456789Z")?
	expect_equal((t.calendar("America/New_York")?).zone, "EDT")?
	expect_equal((t.calendar("US/Pacific")?).offset_seconds, -25200)?
	expect_equal(
		(t.format("YYYY-MM-DD HH:mm:ss.SSS ZZ [zone] SS", "Europe/Berlin")?),
		"2024-07-04 18:05:09.123 +02:00 [CEST] SS",
	)?

	for name in [
		"Nowhere/City", "america/new_york", "AMERICA/NEW_YORK", "utc", "Utc", "local",
		"../UTC", "/UTC", "Europe", "Europe/", " UTC", "Europe/Berlin ", "+5:30",
		"+24:00", "+05:60"
	]:
		r := t.calendar(name.clone())
		expect_true(r.is_error())?
		expect_equal(r.err().kind, "EINVAL")?

test "daylight-saving gaps and folds resolve to the earlier offset":
	f := fn(y: Int, mo: Int, d: Int, h: Int, zone: String) Timestamp!: from_calendar(
		y,
		mo,
		d,
		h,
		30,
		0,
		0,
		zone,
	)
	expect_equal(
		f(2024, 7, 4, 12, "America/New_York")?.to_string(),
		"2024-07-04T16:30:00Z",
	)?

	// Spring forward: 02:30 does not exist; the offset before the gap applies.
	expect_equal(
		f(2024, 3, 10, 2, "America/New_York")?.to_string(),
		"2024-03-10T07:30:00Z",
	)?

	// A midnight gap in Santiago resolves instead of failing.
	expect_equal(
		from_calendar(2024, 9, 8, 0, 30, 0, 0, "America/Santiago")?.to_string(),
		"2024-09-08T04:30:00Z",
	)?

	// A repeated hour east of UTC: the earlier instant (BST).
	expect_equal(
		f(2024, 10, 27, 1, "Europe/London")?.to_string(),
		"2024-10-27T00:30:00Z",
	)?

	// Fall back: 01:30 occurs twice; the first (EDT) wins.
	expect_equal(
		f(2024, 11, 3, 1, "America/New_York")?.to_string(),
		"2024-11-03T05:30:00Z",
	)?

	// Apia skipped an entire date when it crossed the date line.
	expect_equal(
		from_calendar(2011, 12, 30, 12, 0, 0, 0, "Pacific/Apia")?.to_string(),
		"2011-12-30T22:00:00Z",
	)?

	// Lord Howe's overlap is half an hour, not an hour.
	expect_equal(
		from_calendar(
			2024,
			4,
			7,
			1,
			45,
			0,
			0,
			"Australia/Lord_Howe",
		)?.to_string(),
		"2024-04-06T14:45:00Z",
	)?

	// The last local second of year 9999 in London is a valid instant.
	expect_equal(
		from_calendar(
			9999,
			12,
			31,
			23,
			59,
			59,
			999999999,
			"Europe/London",
		)?.unix_seconds(),
		253402300799,
	)?

test "zones round trip across the supported range":
	for zone in ["Europe/Berlin", "America/New_York", "Asia/Kolkata"]:
		for text in ["0001-01-02T12:00:00Z", "9999-12-30T12:00:00Z"]:
			original := parse_timestamp(text)?
			c := original.calendar(zone.clone())?
			back := from_calendar(
				c.year,
				c.month,
				c.day,
				c.hour,
				c.minute,
				c.second,
				c.nanosecond,
				zone.clone(),
			)?
			expect_equal(back, original)?

test "the TZ setting selects the local zone":
	set_environment("TZ", "America/New_York")?

	moment := parse_timestamp("2024-07-04T16:05:09Z")?
	c := moment.calendar("Local")?
	expect_equal(c.offset_seconds, -14400)?
	expect_equal(c.zone, "EDT")?
	expect_equal(local_zone(), "America/New_York")?

	// A path into a zoneinfo directory names the zone after `zoneinfo/`.
	set_environment("TZ", ":/usr/share/zoneinfo/Asia/Tokyo")?
	expect_equal(local_zone(), "Asia/Tokyo")?
	expect_equal((moment.calendar("Local")?).hour, 1)?

	// A POSIX rule has no IANA name: UTC is reported, the rule still applies.
	set_environment("TZ", "CET-1CEST,M3.5.0,M10.5.0/3")?
	expect_equal(local_zone(), "UTC")?
	expect_equal((moment.calendar("Local")?).zone, "CEST")?

	// Empty and unknown settings mean UTC.
	set_environment("TZ", "")?
	expect_equal((moment.calendar("Local")?).offset_seconds, 0)?
	set_environment("TZ", "Not/AZone")?
	expect_equal((moment.calendar("Local")?).zone, "UTC")?
	set_environment("TZ", none)?

test "the host zone resolves Local when TZ is unset":
	set_environment("TZ", none)?

	// The host supplies the zone: /etc/localtime on Unix, the registry on Windows.
	// Whatever it is, `Local` must agree with the IANA name it resolves to.
	moment := parse_timestamp("2024-07-04T16:05:09Z")?
	name := local_zone()
	local := moment.calendar("Local")?
	named := moment.calendar(name)?
	expect_equal(local.offset_seconds, named.offset_seconds)?
	expect_equal(local.zone, named.zone)?

test "a POSIX rule with a short daylight-saving interval resolves gaps and folds":
	set_environment("TZ", "STD0DST,M3.2.0/0,M3.2.0/4")?

	// The whole interval lies between the former one-day probes: the unique interval,
	// the skipped hour, the repeated hour and both sides.
	for row in [
		"9 2 2024-03-09T02:00:00Z", "10 0 2024-03-10T00:00:00Z",
		"10 1 2024-03-10T00:00:00Z", "10 2 2024-03-10T01:00:00Z",
		"10 3 2024-03-10T02:00:00Z", "10 4 2024-03-10T04:00:00Z",
		"11 2 2024-03-11T02:00:00Z"
	]:
		p := row.split(" ")
		day := p[0].parse_int().get()
		hour := p[1].parse_int().get()
		expect_equal(
			from_calendar(2024, 3, day, hour, 0, 0, 0, "Local")?,
			parse_timestamp(p[2].clone())?,
		)?

	stamp := parse_timestamp("2024-03-10T01:00:00Z")?
	c := stamp.calendar("Local")?
	expect_equal(c.hour, 2)?
	expect_equal(c.offset_seconds, 3600)?
	set_environment("TZ", none)?
