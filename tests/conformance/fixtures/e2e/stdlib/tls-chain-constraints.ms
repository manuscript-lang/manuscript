	// IP outside the permitted range
	void verify("-----BEGIN CERTIFICATE-----\nMIH1MIGooAMCAQICBgCKJO3mpTAFBgMrZXAwEDEOMAwGA1UEAwwFSW50ZXIwIBcN\nMjAwMTAxMDAwMDAwWhgPMjEwMDAxMDEwMDAwMDBaMA8xDTALBgNVBAMMBGxlYWYw\nKjAFBgMrZXADIQB4HPpXBfkytR3tEifeBmmLadxFjgJSHVIPNKMCqDv7TqMhMB8w\nDAYDVR0TAQH/BAIwADAPBgNVHREECDAGhwTAAAIBMAUGAytlcANBANR3pPGt/SrF\n1djj5gv721O4eU/DMZ95YtcDPnrxkFTLWXduiVo7LX+KLRcJn3F/UJ5Z5kZz6frh\neTVyZJ4d8gg=\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nMIIBAjCBtaADAgECAgVrSiPVlzAFBgMrZXAwDzENMAsGA1UEAwwEUm9vdDAgFw0y\nMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowEDEOMAwGA1UEAwwFSW50ZXIw\nKjAFBgMrZXADIQDJSSB2B3d/oEZw1XQNmr2ic8SkrBaXj0WzKJODHZTAa6MvMC0w\nDwYDVR0TAQH/BAUwAwEB/zAaBgNVHR4BAf8EEDAOoAwwCocICgAAAP8AAAAwBQYD\nK2VwA0EANIuD4H35ncqQ5S1ElgJNWlFqIkZ0jy4/oMWoNyfeiMMgyjhaL7KMCdKd\nwWKD7UskJu6TQEUNAIxP8BTA+TLuDg==\n-----END CERTIFICATE-----\n", "-----BEGIN CERTIFICATE-----\nMIHlMIGYoAMCAQICBSLbxJbMMAUGAytlcDAPMQ0wCwYDVQQDDARSb290MCAXDTIw\nMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAPMQ0wCwYDVQQDDARSb290MCow\nBQYDK2VwAyEALRAeQzFz9gTab2yes1Oa8zYw9CX032D0h/etQ0cXKEKjEzARMA8G\nA1UdEwEB/wQFMAMBAf8wBQYDK2VwA0EA48k8fXjXCB6t2lG0lk8lMND9MaQ/XX6s\nlDJj3ENOPsDInw1cLPb+5nx54GllDqjr2BPW3b8O5U9cMvYGXWo1Cg==\n-----END CERTIFICATE-----\n", "192.0.2.1") | expect_error?
	// constraint on the trust anchor
