	void verify("-----BEGIN CERTIFICATE-----\nMIIBATCBtKADAgECAgYAoTkmMFowBQYDK2VwMBAxDjAMBgNVBAMMBUludGVyMCAX\nDTIwMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAPMQ0wCwYDVQQDDARsZWFm\nMCowBQYDK2VwAyEAkj3SDXR5DnKyiPLMlGJlDB6Ot8+HyhNyDDmXwVUbVKOjLTAr\nMAwGA1UdEwEB/wQCMAAwGwYDVR0RBBQwEoIQaG9zdC5leGFtcGxlLmNvbTAFBgMr\nZXADQQDV6S3e5MNQVRR+MOtt2h7XseQt9wQjlAygx+gcE2hOYWBtyzRKwAyrm4cT\n3w2d5LFFeKnQZ1uJvh3vlTvzbVUE\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nMIIBBTCBuKADAgECAgYA8h+xfCQwBQYDK2VwMA8xDTALBgNVBAMMBFJvb3QwIBcN\nMjAwMTAxMDAwMDAwWhgPMjEwMDAxMDEwMDAwMDBaMBAxDjAMBgNVBAMMBUludGVy\nMCowBQYDK2VwAyEAzowFPZw5zl4e+Bt2lUD/X8pmlXXX/8aUqNspDWT4402jMTAv\nMA8GA1UdEwEB/wQFMAMBAf8wHAYDVR0eAQH/BBIwEKAOMAyCCm90aGVyLnRlc3Qw\nBQYDK2VwA0EALkYFiz97bEPtzVDdYxcSU8MgpN08Rb2bMyFf+QQQE2E/hhLz4Qpc\nAV7RVuLn3RL8xF63Y0zkpDGC9Zv52jnnAQ==\n-----END CERTIFICATE-----\n", "-----BEGIN CERTIFICATE-----\nMIHmMIGZoAMCAQICBgCQ06yUsDAFBgMrZXAwDzENMAsGA1UEAwwEUm9vdDAgFw0y\nMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowDzENMAsGA1UEAwwEUm9vdDAq\nMAUGAytlcAMhAIwtRNNtFLtiiC8nWvl+sVl8hiJU76Mrdz1A70Udr/wxoxMwETAP\nBgNVHRMBAf8EBTADAQH/MAUGAytlcANBACQylrYMT/ffPPS0UwVFfR+EBdNOCR0Y\n6g5r9cAEXkCOvHdXPpRXkCxsPU5Av1vYds6Se8q8TGKngt2YlDwbcAc=\n-----END CERTIFICATE-----\n", "host.example.com") | expect_error?
