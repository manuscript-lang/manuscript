// conform: tags=testing,tier-io
// conform: phase=test
import (

	verify_certificates from "@std/net/tls.ms",
	expect_error, expect_ok from "@std/test/test.ms",
	timestamp from "@std/time.ms",
)

// Chains made with Ed25519 keys, valid 2020 to 2100: a root, an intermediate that may carry
// a CA constraint, and a leaf. Each is checked at 2030-01-01 for the name it was made for.
fn verify(chain String, root String, name String) Void!:
	now := timestamp(seconds: 1893456000, nanoseconds: 0)?
	return verify_certificates(chain, root, name, now)

test "TLS chains that keep to their CA constraints verify":
	// valid
	void verify("-----BEGIN CERTIFICATE-----\nMIIBADCBs6ADAgECAgUMpqOkUTAFBgMrZXAwEDEOMAwGA1UEAwwFSW50ZXIwIBcN\nMjAwMTAxMDAwMDAwWhgPMjEwMDAxMDEwMDAwMDBaMA8xDTALBgNVBAMMBGxlYWYw\nKjAFBgMrZXADIQD/ZSd7fS64qOY3QgaquVpcxHHqnXNJpTu8c6AdIgia56MtMCsw\nDAYDVR0TAQH/BAIwADAbBgNVHREEFDASghBob3N0LmV4YW1wbGUuY29tMAUGAytl\ncANBALqb9cDwdyOQp0SrJCXA/wBbci91M9xx/13N8TJLEjXXz2chmx59VHuyz7th\n+0d1UO3iT0pwL15fcQ3oElFyNAk=\n-----END CERTIFICATE-----\n-----BEGIN CERTIFICATE-----\nMIHmMIGZoAMCAQICBWUmng04MAUGAytlcDAPMQ0wCwYDVQQDDARSb290MCAXDTIw\nMDEwMTAwMDAwMFoYDzIxMDAwMTAxMDAwMDAwWjAQMQ4wDAYDVQQDDAVJbnRlcjAq\nMAUGAytlcAMhANZMNEfBKiGy7CrIK8RB3wlzcrh7GlEWzmvXUbLl6f+moxMwETAP\nBgNVHRMBAf8EBTADAQH/MAUGAytlcANBAAicFhmBWoA7G1v+xLJC1WqYbQylfwyn\n04qSQvD+4csAEnTnC3A3YkY6P+s4MwN3PqSu8x6lccbY7O09CAI3yAo=\n-----END CERTIFICATE-----\n", "-----BEGIN CERTIFICATE-----\nMIHmMIGZoAMCAQICBgDyUua0OTAFBgMrZXAwDzENMAsGA1UEAwwEUm9vdDAgFw0y\nMDAxMDEwMDAwMDBaGA8yMTAwMDEwMTAwMDAwMFowDzENMAsGA1UEAwwEUm9vdDAq\nMAUGAytlcAMhAETJaPAxor0po5fPt98tLO56rrGtgZyk6tl5O+SoV8DioxMwETAP\nBgNVHRMBAf8EBTADAQH/MAUGAytlcANBAK21mIyx+z++fy4SAUtyDu3qr9iBFV3y\nQEPiBDDwW8xV91Zjs3RNItW+24hdpNyZzBNZeCF8cPK0sV4Se5zwwgM=\n-----END CERTIFICATE-----\n", "host.example.com") | expect_ok?
