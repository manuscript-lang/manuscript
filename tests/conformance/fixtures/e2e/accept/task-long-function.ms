import (
	Placement, PromiseOptions, promise from "@std/concurrency/promise.ms",
	expect_equal from "@std/test/test.ms",
)

// A task runs on a 512 KiB stack slot. In a program that starts tasks every owned value live at a
// place that can fault gets a cleanup, so a long function whose lists all lived to scope end
// needed code and a frame that grew with the square of its length and overflowed the slot.
fn long_function() Int:
	var a = 1
	var v0 = [0, a]
	v0[0] += a
	a = (a + v0[1] + v0[0] % 7) % 1000003
	var v1 = [1, a]
	v1[0] += a
	a = (a + v1[1] + v1[0] % 7) % 1000003
	var v2 = [2, a]
	v2[0] += a
	a = (a + v2[1] + v2[0] % 7) % 1000003
