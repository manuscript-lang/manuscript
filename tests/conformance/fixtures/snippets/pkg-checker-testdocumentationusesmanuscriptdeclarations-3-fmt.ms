# conform: tags=alternatives,closures,formatter,generics,interfaces,optional,parser,records,tier-core,try-result
# conform: phase=parse
# conform: origin=pkg/checker/documentation_test.go:89 TestDocumentationUsesManuscriptDeclarations
type Optional[T]:
    case some(value: T)
    case none

impl Optional[T]:
    def is_some() -> Bool: ...

    def is_none() -> Bool: ...

    def get(default: Optional[T] = none) -> T: ...

    def map[U](transform: Callable[[T], U]) -> Optional[U]: ...

    def and_then[U](transform: Callable[[T], Optional[U]]) -> Optional[U]: ...

    def or_else(create: Callable[[], Optional[T]]) -> Optional[T]: ...

    def ok_or[E: Error = MissingValue](cause: Optional[E] = none) -> Result[T, E]: ...

    def ok_or_else[E: Error](create: Callable[[], E]) -> Result[T, E]: ...
