import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Product:
    name: String
    cls: String
    price: Int

type Order:
    customer: String
    sku: String
    qty: Int
    pct: Int

type Line:
    sku: String
    name: String
    qty: Int
    price: Int
    net: Int
    disc: Int
    tax: Int

fn is_blank(c: Int) -> Bool:
    return c == 32 or c == 9

# Removes spaces and tabs (only) from both ends.
fn trim_st(s: String) -> String:
    let codes = s.scalar_values()
    var a = 0
    var b = codes.length()
    while a < b and is_blank(codes.at(a).unwrap()):
        a = a + 1
    while b > a and is_blank(codes.at(b - 1).unwrap()):
        b = b - 1
    return s.slice(a, b)

fn pad2(n: Int) -> String:
    if n < 10:
        return "0{n}"
    return "{n}"

fn fmt_money(c: Int) -> String:
    return "{c / 100}.{pad2(c % 100)}"

fn round_div(a: Int, b: Int) -> Int:
    return (a + b / 2) / b

# Parses s when it is 1 to max_len ASCII digits.
fn digits(s: String, max_len: Int) -> Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() < 1 or codes.length() > max_len:
        return none
    var n = 0
    for c in codes:
        if c < 48 or c > 57:
            return none
        n = n * 10 + (c - 48)
    return some(n)

# "D" or "D.d" / "D.dd" with up to max_int integer digits, as hundredths.
fn decimal(s: String, max_int: Int) -> Optional[Int]:
    let parts = s.split(".")
    if parts.length() > 2:
        return none
    let whole = digits(parts.at(0).unwrap(), max_int)
    if whole.is_none():
        return none
    var frac = 0
    if parts.length() == 2:
        let f = parts.at(1).unwrap()
        let value = digits(f, 2)
        if value.is_none():
            return none
        frac = value.unwrap()
        if f.length() == 1:
            frac = frac * 10
    return some(whole.unwrap() * 100 + frac)

fn money(s: String) -> Optional[Int]:
    return decimal(s, 5)

fn basis_points(s: String) -> Optional[Int]:
    let bp = decimal(s, 3)
    if bp.is_none() or bp.unwrap() > 10000:
        return none
    return bp

fn trimmed_parts(l: String) -> List[String]:
    let out = List[String]()
    for p in l.split("|"):
        out.append(trim_st(p))
    return out

fn by_name(left: String, right: String) -> Int:
    return left.compare(right)

fn run() -> Result[Unit, Error]:
    let lines = List[String]()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        lines.append(next.unwrap())
    var section = ""
    let rates = Map[String, Int]()
    var ship_fee = 0
    var ship_free = 0
    var has_ship = false
    let catalog = Map[String, Product]()
    let orders = List[Order]()
    let problems = List[String]()
    var n = 0
    for raw in lines:
        n = n + 1
        let l = trim_st(raw)
        if l.is_empty() or l.starts_with("#"):
            continue
        if l.starts_with("["):
            if l == "[config]":
                section = "c"
            else if l == "[catalog]":
                section = "p"
            else if l == "[orders]":
                section = "o"
            else:
                section = ""
                problems.append("line {n}: unknown section")
            continue
        if section == "c":
            let t = l.replace_all(old: "\t", new: " ").unwrap().split(" ").filter(fn(part: String) -> Bool:
                return not part.is_empty()
            )
            let head = t.at(0).unwrap()
            var done = false
            if head == "tax" and t.length() == 3:
                let bp = basis_points(t.at(2).unwrap())
                if bp.is_some():
                    rates.add(key: t.at(1).unwrap(), value: bp.unwrap())
                    done = true
            else if head == "shipping" and t.length() == 3:
                let fee = money(t.at(1).unwrap())
                let free = money(t.at(2).unwrap())
                if fee.is_some() and free.is_some():
                    ship_fee = fee.unwrap()
                    ship_free = free.unwrap()
                    has_ship = true
                    done = true
            if not done:
                problems.append("line {n}: bad config")
        else if section == "p":
            let p = trimmed_parts(l)
            var ok = p.length() == 4
            var price = 0
            if ok:
                let m = money(p.at(2).unwrap())
                if m.is_none():
                    ok = false
                else:
                    price = m.unwrap()
            if ok:
                let sku = p.at(0).unwrap()
                if sku.is_empty() or sku.contains(" ") or sku.contains("\t") or p.at(1).unwrap().is_empty() or p.at(3).unwrap().is_empty():
                    ok = false
            if not ok:
                problems.append("line {n}: bad product")
            else if catalog.contains(p.at(0).unwrap()):
                problems.append("line {n}: duplicate sku")
            else:
                catalog.add(key: p.at(0).unwrap(), value: Product(name: p.at(1).unwrap(), cls: p.at(3).unwrap(), price: price))
        else if section == "o":
            let p = trimmed_parts(l)
            if (p.length() != 3 and p.length() != 4) or p.at(0).unwrap().is_empty():
                problems.append("line {n}: bad order")
                continue
            let qty = digits(p.at(2).unwrap(), 4)
            if qty.is_none() or qty.unwrap() < 1:
                problems.append("line {n}: bad quantity")
                continue
            var pct = 0
            if p.length() == 4:
                let d = digits(p.at(3).unwrap(), 3)
                if d.is_none() or d.unwrap() > 100:
                    problems.append("line {n}: bad discount")
                    continue
                pct = d.unwrap()
            if not catalog.contains(p.at(1).unwrap()):
                problems.append("line {n}: unknown sku")
                continue
            orders.append(Order(customer: p.at(0).unwrap(), sku: p.at(1).unwrap(), qty: qty.unwrap(), pct: pct))
    let invoices = Map[String, List[Line]]()
    for o in orders:
        let prod = catalog.get(o.sku).unwrap()
        let gross = prod.price * o.qty
        let disc = round_div(gross * o.pct, 100)
        let net = gross - disc
        let tax = round_div(net * rates.get(prod.cls).unwrap_or(0), 10000)
        let line = Line(sku: o.sku, name: prod.name, qty: o.qty, price: prod.price, net: net, disc: disc, tax: tax)
        let existing = invoices.get(o.customer)
        if existing.is_none():
            let fresh = List[Line]()
            fresh.append(line)
            invoices.add(key: o.customer, value: fresh)
        else:
            existing.unwrap().append(line)
    let out = StringBuilder()
    let customers = invoices.keys().sorted(compare: by_name)
    var grand = 0
    for c in customers:
        out.append("INVOICE {c}\n")
        var subtotal = 0
        var tax = 0
        for it in invoices.get(c).unwrap():
            out.append("  {it.sku} {it.name} x{it.qty} @ {fmt_money(it.price)} = {fmt_money(it.net)}")
            if it.disc > 0:
                out.append(" (-{fmt_money(it.disc)} discount)")
            out.append("\n")
            subtotal = subtotal + it.net
            tax = tax + it.tax
        var shipping = 0
        if has_ship and subtotal < ship_free:
            shipping = ship_fee
        let total = subtotal + tax + shipping
        grand = grand + total
        out.append("  subtotal {fmt_money(subtotal)}\n  tax {fmt_money(tax)}\n  shipping {fmt_money(shipping)}\n  total {fmt_money(total)}\n")
    out.append("summary: invoices={customers.length()} grand_total={fmt_money(grand)} problems={problems.length()}\n")
    if problems.length() > 0:
        out.append("problems:\n")
        for p in problems:
            out.append("  {p}\n")
    try stdout().write(out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
