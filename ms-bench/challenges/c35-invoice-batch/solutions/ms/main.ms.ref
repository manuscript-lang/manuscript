import {stdin, stdout, read_all} from "@std/io.ms"

type Product:
    name: String
    cls: String
    price: Int

type Order:
    customer: String
    sku: String
    qty: Int
    pct: Int

type Item:
    sku: String
    name: String
    qty: Int
    price: Int
    net: Int
    disc: Int
    tax: Int

fn is_blank(c: Int) -> Bool:
    return c == 32 or c == 9

fn trim_blanks(s: String) -> String:
    let codes = s.scalar_values()
    var start = 0
    var end = codes.length()
    while start < end and is_blank(codes.at(start).unwrap()):
        start = start + 1
    while end > start and is_blank(codes.at(end - 1).unwrap()):
        end = end - 1
    return s.slice(start, end).unwrap()

# Splits on runs of spaces and tabs, dropping empty pieces.
fn words(s: String) -> List[String]:
    let out = List[String]()
    var cur = List[String]()
    for ch in s.chars():
        if is_blank(ch.scalar_values().at(0).unwrap()):
            if not cur.is_empty():
                out.append(cur.join(""))
                cur = List[String]()
        else:
            cur.append(ch)
    if not cur.is_empty():
        out.append(cur.join(""))
    return out

fn digits(s: String, max: Int) -> Bool:
    if s.is_empty() or s.length() > max:
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn has_blank(s: String) -> Bool:
    for c in s.scalar_values():
        if is_blank(c):
            return true
    return false

# "D" or "D.d" / "D.dd" with at most `max_int` integer digits, as hundredths.
fn decimal(s: String, max_int: Int) -> Optional[Int]:
    var whole = s
    var frac = ""
    let dot = s.index_of(".")
    if dot.is_some():
        whole = s.slice(0, dot.unwrap()).unwrap()
        frac = s.slice(dot.unwrap() + 1, s.length()).unwrap()
        if not digits(frac, 2):
            return none
    if not digits(whole, max_int):
        return none
    var cents = whole.parse_int().unwrap() * 100
    if frac.length() == 1:
        cents = cents + frac.parse_int().unwrap() * 10
    else if frac.length() == 2:
        cents = cents + frac.parse_int().unwrap()
    return some(cents)

fn money(s: String) -> Optional[Int]:
    return decimal(s, 5)

fn basis_points(s: String) -> Optional[Int]:
    let bp = decimal(s, 3)
    if bp.is_some() and bp.unwrap() <= 10000:
        return bp
    return none

fn pad_two(n: Int) -> String:
    if n < 10:
        return "0{n}"
    return "{n}"

fn fmt_money(c: Int) -> String:
    return "{c / 100}.{pad_two(c % 100)}"

fn round_div(a: Int, b: Int) -> Int:
    return (a + b / 2) / b

fn by_text(left: String, right: String) -> Int:
    return left.compare(right)

fn split_trimmed(l: String) -> List[String]:
    let out = List[String]()
    for part in l.split("|"):
        out.append(trim_blanks(part))
    return out

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let lines = data.to_text().unwrap_or("").split("\n")
    if lines.length() > 0 and lines.at(lines.length() - 1).unwrap().is_empty():
        lines.remove(lines.length() - 1)
    var section = ""
    let rates = Map[String, Int]()
    var has_ship = false
    var ship_fee = 0
    var ship_free = 0
    let catalog = Map[String, Product]()
    let orders = List[Order]()
    let problems = List[String]()
    var idx = 0
    while idx < lines.length():
        let l = trim_blanks(lines.at(idx).unwrap())
        idx = idx + 1
        let n = idx
        if l.is_empty() or l.starts_with("#"):
            continue
        if l.starts_with("["):
            if l == "[config]":
                section = "c"
            else if l == "[catalog]":
                section = "p"
            else if l == "[orders]":
                section = "o"
            else:
                section = ""
                problems.append("line {n}: unknown section")
            continue
        if section == "c":
            let t = words(l)
            let head = t.at(0).unwrap()
            if head == "tax" and t.length() == 3 and basis_points(t.at(2).unwrap()).is_some():
                rates.add(key: t.at(1).unwrap(), value: basis_points(t.at(2).unwrap()).unwrap())
            else if head == "shipping" and t.length() == 3 and money(t.at(1).unwrap()).is_some() and money(t.at(2).unwrap()).is_some():
                ship_fee = money(t.at(1).unwrap()).unwrap()
                ship_free = money(t.at(2).unwrap()).unwrap()
                has_ship = true
            else:
                problems.append("line {n}: bad config")
        else if section == "p":
            let p = split_trimmed(l)
            var price: Optional[Int] = none
            if p.length() == 4:
                price = money(p.at(2).unwrap())
            if price.is_none() or p.at(0).unwrap().is_empty() or has_blank(p.at(0).unwrap()) or p.at(1).unwrap().is_empty() or p.at(3).unwrap().is_empty():
                problems.append("line {n}: bad product")
                continue
            if catalog.contains(p.at(0).unwrap()):
                problems.append("line {n}: duplicate sku")
                continue
            catalog.add(key: p.at(0).unwrap(), value: Product(name: p.at(1).unwrap(), cls: p.at(3).unwrap(), price: price.unwrap()))
        else if section == "o":
            let p = split_trimmed(l)
            if (p.length() != 3 and p.length() != 4) or p.at(0).unwrap().is_empty():
                problems.append("line {n}: bad order")
                continue
            if not digits(p.at(2).unwrap(), 4) or p.at(2).unwrap().parse_int().unwrap() < 1:
                problems.append("line {n}: bad quantity")
                continue
            var pct = 0
            if p.length() == 4:
                if not digits(p.at(3).unwrap(), 3) or p.at(3).unwrap().parse_int().unwrap() > 100:
                    problems.append("line {n}: bad discount")
                    continue
                pct = p.at(3).unwrap().parse_int().unwrap()
            if not catalog.contains(p.at(1).unwrap()):
                problems.append("line {n}: unknown sku")
                continue
            orders.append(Order(customer: p.at(0).unwrap(), sku: p.at(1).unwrap(), qty: p.at(2).unwrap().parse_int().unwrap(), pct: pct))
    let invoices = Map[String, List[Item]]()
    for o in orders:
        let prod = catalog.get(o.sku).unwrap()
        let gross = prod.price * o.qty
        let disc = round_div(gross * o.pct, 100)
        let net = gross - disc
        let tax = round_div(net * rates.get_or(key: prod.cls, fallback: 0), 10000)
        if not invoices.contains(o.customer):
            invoices.add(key: o.customer, value: List[Item]())
        invoices.get(o.customer).unwrap().append(Item(sku: o.sku, name: prod.name, qty: o.qty, price: prod.price, net: net, disc: disc, tax: tax))
    let out = List[String]()
    var grand = 0
    let customers = invoices.keys().sorted(compare: by_text)
    for c in customers:
        out.append("INVOICE {c}")
        var subtotal = 0
        var tax = 0
        for it in invoices.get(c).unwrap():
            var note = ""
            if it.disc > 0:
                note = " (-{fmt_money(it.disc)} discount)"
            out.append("  {it.sku} {it.name} x{it.qty} @ {fmt_money(it.price)} = {fmt_money(it.net)}{note}")
            subtotal = subtotal + it.net
            tax = tax + it.tax
        var shipping = 0
        if has_ship and subtotal < ship_free:
            shipping = ship_fee
        let total = subtotal + tax + shipping
        grand = grand + total
        out.append("  subtotal {fmt_money(subtotal)}")
        out.append("  tax {fmt_money(tax)}")
        out.append("  shipping {fmt_money(shipping)}")
        out.append("  total {fmt_money(total)}")
    out.append("summary: invoices={customers.length()} grand_total={fmt_money(grand)} problems={problems.length()}")
    if problems.length() > 0:
        out.append("problems:")
        for p in problems:
            out.append("  {p}")
    try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
