package main

import (
	"bufio"
	"fmt"
	"io"
	"os"
	"sort"
	"strconv"
	"strings"
)

func trim(s string) string { return strings.Trim(s, " \t") }

func isBlank(r rune) bool { return r == ' ' || r == '\t' }

func digits(s string, max int) bool {
	if s == "" || len(s) > max {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

func fmtMoney(c int64) string { return fmt.Sprintf("%d.%02d", c/100, c%100) }

func roundDiv(a, b int64) int64 { return (a + b/2) / b }

// decimal parses "D" or "D.d" / "D.dd" with up to maxInt integer digits into hundredths.
func decimal(s string, maxInt int) (int64, bool) {
	whole, frac, hasDot := strings.Cut(s, ".")
	if !digits(whole, maxInt) {
		return 0, false
	}
	if hasDot && !digits(frac, 2) {
		return 0, false
	}
	for len(frac) < 2 {
		frac += "0"
	}
	w, _ := strconv.ParseInt(whole, 10, 64)
	f, _ := strconv.ParseInt(frac, 10, 64)
	return w*100 + f, true
}

func money(s string) (int64, bool) { return decimal(s, 5) }

func basisPoints(s string) (int64, bool) {
	bp, ok := decimal(s, 3)
	return bp, ok && bp <= 10000
}

type product struct {
	name, cls string
	price     int64
}

type order struct {
	customer, sku string
	qty, pct      int64
}

type item struct {
	sku, name                 string
	qty, price, net, disc, tax int64
}

func main() {
	data, _ := io.ReadAll(os.Stdin)
	lines := strings.Split(string(data), "\n")
	if lines[len(lines)-1] == "" {
		lines = lines[:len(lines)-1]
	}
	section := byte(0)
	rates := map[string]int64{}
	var shipFee, shipFree int64
	hasShip := false
	catalog := map[string]product{}
	var orders []order
	var problems []string
	bad := func(n int, msg string) { problems = append(problems, fmt.Sprintf("line %d: %s", n, msg)) }
	for idx, raw := range lines {
		n := idx + 1
		l := trim(raw)
		if l == "" || l[0] == '#' {
			continue
		}
		if l[0] == '[' {
			switch l {
			case "[config]":
				section = 'c'
			case "[catalog]":
				section = 'p'
			case "[orders]":
				section = 'o'
			default:
				section = 0
				bad(n, "unknown section")
			}
			continue
		}
		switch section {
		case 'c':
			t := strings.FieldsFunc(l, isBlank)
			if bp, ok := basisPoints(t[len(t)-1]); t[0] == "tax" && len(t) == 3 && ok {
				rates[t[1]] = bp
			} else if t[0] == "shipping" && len(t) == 3 {
				fee, ok1 := money(t[1])
				free, ok2 := money(t[2])
				if ok1 && ok2 {
					shipFee, shipFree, hasShip = fee, free, true
				} else {
					bad(n, "bad config")
				}
			} else {
				bad(n, "bad config")
			}
		case 'p':
			p := strings.Split(l, "|")
			for i := range p {
				p[i] = trim(p[i])
			}
			var price int64
			ok := len(p) == 4
			if ok {
				price, ok = money(p[2])
			}
			if !ok || p[0] == "" || strings.ContainsAny(p[0], " \t") || p[1] == "" || p[3] == "" {
				bad(n, "bad product")
				continue
			}
			if _, dup := catalog[p[0]]; dup {
				bad(n, "duplicate sku")
				continue
			}
			catalog[p[0]] = product{p[1], p[3], price}
		case 'o':
			p := strings.Split(l, "|")
			for i := range p {
				p[i] = trim(p[i])
			}
			if (len(p) != 3 && len(p) != 4) || p[0] == "" {
				bad(n, "bad order")
				continue
			}
			qty, _ := strconv.ParseInt(p[2], 10, 64)
			if !digits(p[2], 4) || qty < 1 {
				bad(n, "bad quantity")
				continue
			}
			var pct int64
			if len(p) == 4 {
				pct, _ = strconv.ParseInt(p[3], 10, 64)
				if !digits(p[3], 3) || pct > 100 {
					bad(n, "bad discount")
					continue
				}
			}
			if _, ok := catalog[p[1]]; !ok {
				bad(n, "unknown sku")
				continue
			}
			orders = append(orders, order{p[0], p[1], qty, pct})
		}
	}
	invoices := map[string][]item{}
	for _, o := range orders {
		prod := catalog[o.sku]
		gross := prod.price * o.qty
		disc := roundDiv(gross*o.pct, 100)
		net := gross - disc
		tax := roundDiv(net*rates[prod.cls], 10000)
		invoices[o.customer] = append(invoices[o.customer], item{o.sku, prod.name, o.qty, prod.price, net, disc, tax})
	}
	customers := make([]string, 0, len(invoices))
	for c := range invoices {
		customers = append(customers, c)
	}
	sort.Strings(customers)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	var grand int64
	for _, c := range customers {
		fmt.Fprintf(out, "INVOICE %s\n", c)
		var subtotal, tax int64
		for _, it := range invoices[c] {
			fmt.Fprintf(out, "  %s %s x%d @ %s = %s", it.sku, it.name, it.qty, fmtMoney(it.price), fmtMoney(it.net))
			if it.disc > 0 {
				fmt.Fprintf(out, " (-%s discount)", fmtMoney(it.disc))
			}
			fmt.Fprintln(out)
			subtotal += it.net
			tax += it.tax
		}
		var shipping int64
		if hasShip && subtotal < shipFree {
			shipping = shipFee
		}
		total := subtotal + tax + shipping
		grand += total
		fmt.Fprintf(out, "  subtotal %s\n  tax %s\n  shipping %s\n  total %s\n", fmtMoney(subtotal), fmtMoney(tax), fmtMoney(shipping), fmtMoney(total))
	}
	fmt.Fprintf(out, "summary: invoices=%d grand_total=%s problems=%d\n", len(customers), fmtMoney(grand), len(problems))
	if len(problems) > 0 {
		fmt.Fprintln(out, "problems:")
		for _, p := range problems {
			fmt.Fprintln(out, "  "+p)
		}
	}
}
