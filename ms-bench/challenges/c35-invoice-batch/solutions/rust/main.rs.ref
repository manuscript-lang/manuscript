use std::collections::{BTreeMap, HashMap};
use std::io::{self, Read, Write};

fn trim(s: &str) -> &str {
    s.trim_matches(|c| c == ' ' || c == '\t')
}

fn is_blank(c: char) -> bool {
    c == ' ' || c == '\t'
}

fn digits(s: &str, max: usize) -> bool {
    !s.is_empty() && s.len() <= max && s.bytes().all(|c| c.is_ascii_digit())
}

fn fmt_money(c: i64) -> String {
    format!("{}.{:02}", c / 100, c % 100)
}

fn round_div(a: i64, b: i64) -> i64 {
    (a + b / 2) / b
}

// Parses "D" or "D.d" / "D.dd" with at most `max_int` integer digits into hundredths.
fn decimal(s: &str, max_int: usize) -> Option<i64> {
    let (whole, frac) = match s.split_once('.') {
        Some((w, f)) => (w, f),
        None => (s, ""),
    };
    if !digits(whole, max_int) {
        return None;
    }
    if s.contains('.') && !digits(frac, 2) {
        return None;
    }
    let f = format!("{:0<2}", frac);
    Some(whole.parse::<i64>().unwrap() * 100 + f.parse::<i64>().unwrap())
}

fn money(s: &str) -> Option<i64> {
    decimal(s, 5)
}

fn basis_points(s: &str) -> Option<i64> {
    decimal(s, 3).filter(|&bp| bp <= 10000)
}

struct Product {
    name: String,
    cls: String,
    price: i64,
}

struct Order {
    customer: String,
    sku: String,
    qty: i64,
    pct: i64,
}

struct Item {
    sku: String,
    name: String,
    qty: i64,
    price: i64,
    net: i64,
    disc: i64,
    tax: i64,
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut lines: Vec<&str> = input.split('\n').collect();
    if lines.last() == Some(&"") {
        lines.pop();
    }
    let mut section = ' ';
    let mut rates: HashMap<String, i64> = HashMap::new();
    let mut ship: Option<(i64, i64)> = None;
    let mut catalog: HashMap<String, Product> = HashMap::new();
    let mut orders: Vec<Order> = Vec::new();
    let mut problems: Vec<String> = Vec::new();
    for (idx, raw) in lines.iter().enumerate() {
        let n = idx + 1;
        let l = trim(raw);
        if l.is_empty() || l.starts_with('#') {
            continue;
        }
        if l.starts_with('[') {
            section = match l {
                "[config]" => 'c',
                "[catalog]" => 'p',
                "[orders]" => 'o',
                _ => {
                    problems.push(format!("line {}: unknown section", n));
                    ' '
                }
            };
            continue;
        }
        match section {
            'c' => {
                let t: Vec<&str> = l.split(is_blank).filter(|x| !x.is_empty()).collect();
                if t[0] == "tax" && t.len() == 3 && basis_points(t[2]).is_some() {
                    rates.insert(t[1].to_string(), basis_points(t[2]).unwrap());
                } else if t[0] == "shipping" && t.len() == 3 && money(t[1]).is_some() && money(t[2]).is_some() {
                    ship = Some((money(t[1]).unwrap(), money(t[2]).unwrap()));
                } else {
                    problems.push(format!("line {}: bad config", n));
                }
            }
            'p' => {
                let p: Vec<&str> = l.split('|').map(trim).collect();
                let price = if p.len() == 4 { money(p[2]) } else { None };
                if price.is_none() || p[0].is_empty() || p[0].contains(is_blank) || p[1].is_empty() || p[3].is_empty() {
                    problems.push(format!("line {}: bad product", n));
                    continue;
                }
                if catalog.contains_key(p[0]) {
                    problems.push(format!("line {}: duplicate sku", n));
                    continue;
                }
                catalog.insert(p[0].to_string(), Product { name: p[1].to_string(), cls: p[3].to_string(), price: price.unwrap() });
            }
            'o' => {
                let p: Vec<&str> = l.split('|').map(trim).collect();
                if (p.len() != 3 && p.len() != 4) || p[0].is_empty() {
                    problems.push(format!("line {}: bad order", n));
                    continue;
                }
                if !digits(p[2], 4) || p[2].parse::<i64>().unwrap() < 1 {
                    problems.push(format!("line {}: bad quantity", n));
                    continue;
                }
                let mut pct = 0;
                if p.len() == 4 {
                    if !digits(p[3], 3) || p[3].parse::<i64>().unwrap() > 100 {
                        problems.push(format!("line {}: bad discount", n));
                        continue;
                    }
                    pct = p[3].parse().unwrap();
                }
                if !catalog.contains_key(p[1]) {
                    problems.push(format!("line {}: unknown sku", n));
                    continue;
                }
                orders.push(Order { customer: p[0].to_string(), sku: p[1].to_string(), qty: p[2].parse().unwrap(), pct });
            }
            _ => {}
        }
    }
    let mut invoices: BTreeMap<String, Vec<Item>> = BTreeMap::new();
    for o in &orders {
        let prod = &catalog[&o.sku];
        let gross = prod.price * o.qty;
        let disc = round_div(gross * o.pct, 100);
        let net = gross - disc;
        let tax = round_div(net * rates.get(&prod.cls).copied().unwrap_or(0), 10000);
        invoices.entry(o.customer.clone()).or_default().push(Item {
            sku: o.sku.clone(),
            name: prod.name.clone(),
            qty: o.qty,
            price: prod.price,
            net,
            disc,
            tax,
        });
    }
    let mut out = String::new();
    let mut grand = 0;
    for (customer, items) in &invoices {
        out.push_str(&format!("INVOICE {}\n", customer));
        let (mut subtotal, mut tax) = (0, 0);
        for it in items {
            out.push_str(&format!("  {} {} x{} @ {} = {}", it.sku, it.name, it.qty, fmt_money(it.price), fmt_money(it.net)));
            if it.disc > 0 {
                out.push_str(&format!(" (-{} discount)", fmt_money(it.disc)));
            }
            out.push('\n');
            subtotal += it.net;
            tax += it.tax;
        }
        let shipping = match ship {
            Some((fee, free_over)) if subtotal < free_over => fee,
            _ => 0,
        };
        let total = subtotal + tax + shipping;
        grand += total;
        out.push_str(&format!(
            "  subtotal {}\n  tax {}\n  shipping {}\n  total {}\n",
            fmt_money(subtotal),
            fmt_money(tax),
            fmt_money(shipping),
            fmt_money(total)
        ));
    }
    out.push_str(&format!("summary: invoices={} grand_total={} problems={}\n", invoices.len(), fmt_money(grand), problems.len()));
    if !problems.is_empty() {
        out.push_str("problems:\n");
        for p in &problems {
            out.push_str(&format!("  {}\n", p));
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
