import {stdin, stdout, read_all} from "@std/io.ms"

# Spaces and tabs only, like the specification.
fn trim_blanks(s: String) -> String:
    let codes = s.scalar_values()
    var start = 0
    var end = codes.length()
    while start < end and (codes.at(start).unwrap() == 32 or codes.at(start).unwrap() == 9):
        start = start + 1
    while end > start and (codes.at(end - 1).unwrap() == 32 or codes.at(end - 1).unwrap() == 9):
        end = end - 1
    return s.slice(start, end)

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let text = data.to_text().unwrap_or("")
    let lines = text.split("\n")
    var sep = -1
    var i = 0
    while i < lines.length():
        if lines.at(i).unwrap() == "---":
            sep = i
            break
        i = i + 1
    var doc_end = lines.length()
    if sep >= 0:
        doc_end = sep
    # Settings are stored under "section.key"; the global section is the empty name.
    let values = Map[String, String]()
    var section = ""
    var n = 0
    while n < doc_end:
        let line = trim_blanks(lines.at(n).unwrap())
        n = n + 1
        if line.is_empty() or line.starts_with(";") or line.starts_with("#"):
            continue
        if line.starts_with("[") and line.ends_with("]"):
            section = trim_blanks(line.slice(1, line.length() - 1))
            continue
        let eq = line.index_of("=")
        if eq.is_none():
            continue
        let at = eq.unwrap()
        let key = trim_blanks(line.slice(0, at))
        var value = trim_blanks(line.slice(at + 1, line.length()))
        if value.length() >= 2 and value.starts_with("\"") and value.ends_with("\""):
            value = value.slice(1, value.length() - 1)
        if not key.is_empty():
            values.add(key: "{section}.{key}", value: value)
    let out = List[String]()
    if sep >= 0:
        var q = sep + 1
        while q < lines.length():
            var query = trim_blanks(lines.at(q).unwrap())
            q = q + 1
            if query.is_empty():
                continue
            if not query.contains("."):
                query = ".{query}"
            out.append(values.get_or(key: query, fallback: "<missing>"))
    if not out.is_empty():
        try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
