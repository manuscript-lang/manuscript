use std::collections::HashMap;
use std::io::{self, Read, Write};

fn trim(s: &str) -> &str {
    s.trim_matches(|c| c == ' ' || c == '\t')
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let lines: Vec<&str> = input.split('\n').collect();
    let sep = lines.iter().position(|l| *l == "---");
    let (doc, queries): (&[&str], &[&str]) = match sep {
        Some(i) => (&lines[..i], &lines[i + 1..]),
        None => (&lines[..], &[]),
    };
    let mut values: HashMap<String, String> = HashMap::new();
    let mut section = String::new();
    for raw in doc {
        let line = trim(raw);
        if line.is_empty() || line.starts_with(';') || line.starts_with('#') {
            continue;
        }
        if line.starts_with('[') && line.ends_with(']') {
            section = trim(&line[1..line.len() - 1]).to_string();
            continue;
        }
        if let Some(eq) = line.find('=') {
            let key = trim(&line[..eq]);
            let mut value = trim(&line[eq + 1..]);
            if value.len() >= 2 && value.starts_with('"') && value.ends_with('"') {
                value = &value[1..value.len() - 1];
            }
            if !key.is_empty() {
                values.insert(format!("{}.{}", section, key), value.to_string());
            }
        }
    }
    let mut out = String::new();
    for raw in queries {
        let q = trim(raw);
        if q.is_empty() {
            continue;
        }
        let full = if q.contains('.') { q.to_string() } else { format!(".{}", q) };
        out.push_str(values.get(&full).map(|s| s.as_str()).unwrap_or("<missing>"));
        out.push('\n');
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
