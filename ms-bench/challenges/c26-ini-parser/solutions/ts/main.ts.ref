import { readFileSync } from "node:fs";

const trim = (s: string) => s.replace(/^[ \t]+|[ \t]+$/g, "");
const lines = readFileSync(0, "utf8").split("\n");
const sep = lines.indexOf("---");
const doc = sep < 0 ? lines : lines.slice(0, sep);
const queries = sep < 0 ? [] : lines.slice(sep + 1);

const values = new Map<string, string>(); // "section.key" -> value; the global section is ""
let section = "";
for (const raw of doc) {
  const line = trim(raw);
  if (line === "" || line[0] === ";" || line[0] === "#") continue;
  if (line[0] === "[" && line[line.length - 1] === "]") {
    section = trim(line.slice(1, -1));
    continue;
  }
  const eq = line.indexOf("=");
  if (eq < 0) continue;
  const key = trim(line.slice(0, eq));
  let value = trim(line.slice(eq + 1));
  if (value.length >= 2 && value[0] === '"' && value[value.length - 1] === '"') value = value.slice(1, -1);
  if (key !== "") values.set(`${section}.${key}`, value);
}

const out: string[] = [];
for (const raw of queries) {
  const q = trim(raw);
  if (q === "") continue;
  const full = q.includes(".") ? q : "." + q;
  out.push(values.get(full) ?? "<missing>");
}
process.stdout.write(out.map((l) => l + "\n").join(""));
