package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strings"
)

func validName(s string) bool {
	if s == "" || s[0] < 'a' || s[0] > 'z' {
		return false
	}
	for i := 1; i < len(s); i++ {
		c := s[i]
		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') {
			return false
		}
	}
	return true
}

// parse returns the task and its dependencies, or ok=false when the line is malformed.
func parse(l string) (string, []string, bool) {
	i := strings.IndexByte(l, ':')
	if i < 0 || !validName(l[:i]) {
		return "", nil, false
	}
	rest := l[i+1:]
	if rest == "" {
		return l[:i], nil, true
	}
	if rest[0] != ' ' {
		return "", nil, false
	}
	ds := strings.Split(rest[1:], " ")
	for _, d := range ds {
		if !validName(d) {
			return "", nil, false
		}
	}
	return l[:i], ds, true
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	deps := map[string]map[string]bool{}
	touch := func(n string) map[string]bool {
		if deps[n] == nil {
			deps[n] = map[string]bool{}
		}
		return deps[n]
	}
	for ln := 1; sc.Scan(); ln++ {
		l := sc.Text()
		if strings.Trim(l, " ") == "" {
			continue
		}
		name, ds, ok := parse(l)
		if !ok {
			fmt.Printf("error: line %d\n", ln)
			return
		}
		set := touch(name)
		for _, d := range ds {
			set[d] = true
			touch(d)
		}
	}
	indeg := map[string]int{}
	rev := map[string][]string{}
	var ready []string
	for n, ds := range deps {
		indeg[n] = len(ds)
		for d := range ds {
			rev[d] = append(rev[d], n)
		}
		if len(ds) == 0 {
			ready = append(ready, n)
		}
	}
	var out []string
	for len(ready) > 0 {
		sort.Strings(ready)
		n := ready[0]
		ready = ready[1:]
		out = append(out, n)
		for _, m := range rev[n] {
			indeg[m]--
			if indeg[m] == 0 {
				ready = append(ready, m)
			}
		}
	}
	if len(out) < len(deps) {
		fmt.Println("cycle")
		return
	}
	for _, n := range out {
		fmt.Println(n)
	}
}
