package main

import (
	"bufio"
	"fmt"
	"os"
	"strings"
)

type cleaned struct {
	abs bool
	st  []string
}

func clean(p string) cleaned {
	r := cleaned{abs: strings.HasPrefix(p, "/")}
	for _, s := range strings.Split(p, "/") {
		if s == "" || s == "." {
			continue
		}
		if s == ".." {
			if n := len(r.st); n > 0 && r.st[n-1] != ".." {
				r.st = r.st[:n-1]
			} else if !r.abs {
				r.st = append(r.st, "..")
			}
		} else {
			r.st = append(r.st, s)
		}
	}
	return r
}

func show(abs bool, st []string) string {
	if abs {
		return "/" + strings.Join(st, "/")
	}
	if len(st) == 0 {
		return "."
	}
	return strings.Join(st, "/")
}

func base(p string) string {
	q := strings.TrimRight(p, "/")
	if q == "" {
		return "/"
	}
	return q[strings.LastIndex(q, "/")+1:]
}

func commonPrefix(a, b []string) int {
	k := 0
	for k < len(a) && k < len(b) && a[k] == b[k] {
		k++
	}
	return k
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<26)
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	for sc.Scan() {
		t := strings.Fields(strings.ReplaceAll(sc.Text(), "\t", " "))
		if len(t) == 0 {
			continue
		}
		c, a := t[0], t[1:]
		n := len(a)
		switch {
		case c == "clean" && n == 1:
			r := clean(a[0])
			fmt.Fprintln(w, show(r.abs, r.st))
		case c == "join" && n >= 1:
			r := clean(strings.Join(a, "/"))
			fmt.Fprintln(w, show(r.abs, r.st))
		case c == "resolve" && n == 2:
			if !strings.HasPrefix(a[0], "/") {
				fmt.Fprintln(w, "error: cwd not absolute")
			} else {
				p := a[1]
				if !strings.HasPrefix(p, "/") {
					p = a[0] + "/" + p
				}
				r := clean(p)
				fmt.Fprintln(w, show(r.abs, r.st))
			}
		case c == "rel" && n == 2:
			x, y := clean(a[0]), clean(a[1])
			if x.abs != y.abs {
				fmt.Fprintln(w, "error: cannot relativize")
				continue
			}
			k := commonPrefix(x.st, y.st)
			rest := x.st[k:]
			bad := false
			for _, s := range rest {
				if s == ".." {
					bad = true
				}
			}
			if bad {
				fmt.Fprintln(w, "error: cannot relativize")
				continue
			}
			var r []string
			for range rest {
				r = append(r, "..")
			}
			r = append(r, y.st[k:]...)
			if len(r) == 0 {
				fmt.Fprintln(w, ".")
			} else {
				fmt.Fprintln(w, strings.Join(r, "/"))
			}
		case c == "base" && n == 1:
			fmt.Fprintln(w, base(a[0]))
		case c == "dir" && n == 1:
			i := strings.LastIndex(a[0], "/")
			if i < 0 {
				fmt.Fprintln(w, ".")
			} else {
				r := clean(a[0][:i+1])
				fmt.Fprintln(w, show(r.abs, r.st))
			}
		case c == "ext" && n == 1:
			b := base(a[0])
			if i := strings.LastIndex(b, "."); i > 0 {
				fmt.Fprintln(w, b[i:])
			} else {
				fmt.Fprintln(w, "(none)")
			}
		case c == "common" && n >= 1:
			cs := make([]cleaned, n)
			mixed := false
			for i, x := range a {
				cs[i] = clean(x)
				if cs[i].abs != cs[0].abs {
					mixed = true
				}
			}
			if mixed {
				fmt.Fprintln(w, "error: mixed")
				continue
			}
			pre := cs[0].st
			for _, x := range cs[1:] {
				pre = pre[:commonPrefix(pre, x.st)]
			}
			fmt.Fprintln(w, show(cs[0].abs, pre))
		default:
			fmt.Fprintln(w, "error: bad command")
		}
	}
}
