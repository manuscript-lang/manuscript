use std::io::{self, Read, Write};

struct Cleaned {
    abs: bool,
    st: Vec<String>,
}

fn clean(p: &str) -> Cleaned {
    let abs = p.starts_with('/');
    let mut st: Vec<String> = Vec::new();
    for s in p.split('/') {
        if s.is_empty() || s == "." {
            continue;
        }
        if s == ".." {
            if !st.is_empty() && st[st.len() - 1] != ".." {
                st.pop();
            } else if !abs {
                st.push("..".to_string());
            }
        } else {
            st.push(s.to_string());
        }
    }
    Cleaned { abs, st }
}

fn show(abs: bool, st: &[String]) -> String {
    if abs {
        return format!("/{}", st.join("/"));
    }
    if st.is_empty() {
        ".".to_string()
    } else {
        st.join("/")
    }
}

fn base(p: &str) -> String {
    let q = p.trim_end_matches('/');
    if q.is_empty() {
        return "/".to_string();
    }
    match q.rfind('/') {
        Some(i) => q[i + 1..].to_string(),
        None => q.to_string(),
    }
}

fn common_prefix(a: &[String], b: &[String]) -> usize {
    let mut k = 0;
    while k < a.len() && k < b.len() && a[k] == b[k] {
        k += 1;
    }
    k
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut out = String::new();
    for line in input.split('\n') {
        let t: Vec<&str> = line.split(|c| c == ' ' || c == '\t').filter(|x| !x.is_empty()).collect();
        if t.is_empty() {
            continue;
        }
        let c = t[0];
        let a = &t[1..];
        let n = a.len();
        let res: String = if c == "clean" && n == 1 {
            let r = clean(a[0]);
            show(r.abs, &r.st)
        } else if c == "join" && n >= 1 {
            let r = clean(&a.join("/"));
            show(r.abs, &r.st)
        } else if c == "resolve" && n == 2 {
            if !a[0].starts_with('/') {
                "error: cwd not absolute".to_string()
            } else {
                let p = if a[1].starts_with('/') { a[1].to_string() } else { format!("{}/{}", a[0], a[1]) };
                let r = clean(&p);
                show(r.abs, &r.st)
            }
        } else if c == "rel" && n == 2 {
            let x = clean(a[0]);
            let y = clean(a[1]);
            if x.abs != y.abs {
                "error: cannot relativize".to_string()
            } else {
                let k = common_prefix(&x.st, &y.st);
                let rest = &x.st[k..];
                if rest.iter().any(|s| s == "..") {
                    "error: cannot relativize".to_string()
                } else {
                    let mut r: Vec<String> = rest.iter().map(|_| "..".to_string()).collect();
                    r.extend(y.st[k..].iter().cloned());
                    if r.is_empty() { ".".to_string() } else { r.join("/") }
                }
            }
        } else if c == "base" && n == 1 {
            base(a[0])
        } else if c == "dir" && n == 1 {
            match a[0].rfind('/') {
                None => ".".to_string(),
                Some(i) => {
                    let r = clean(&a[0][..i + 1]);
                    show(r.abs, &r.st)
                }
            }
        } else if c == "ext" && n == 1 {
            let b = base(a[0]);
            match b.rfind('.') {
                Some(i) if i > 0 => b[i..].to_string(),
                _ => "(none)".to_string(),
            }
        } else if c == "common" && n >= 1 {
            let cs: Vec<Cleaned> = a.iter().map(|x| clean(x)).collect();
            if cs.iter().any(|x| x.abs != cs[0].abs) {
                "error: mixed".to_string()
            } else {
                let mut pre: Vec<String> = cs[0].st.clone();
                for x in &cs[1..] {
                    let k = common_prefix(&pre, &x.st);
                    pre.truncate(k);
                }
                show(cs[0].abs, &pre)
            }
        } else {
            "error: bad command".to_string()
        };
        out.push_str(&res);
        out.push('\n');
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
