import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Cleaned:
    abs: Bool
    st: List[String]

fn fields(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").unwrap()
    return spaced.split(" ").filter(fn(part: String) -> Bool:
        return not part.is_empty()
    )

fn clean(p: String) -> Cleaned:
    let abs = p.starts_with("/")
    let st = List[String]()
    for s in p.split("/"):
        if s.is_empty() or s == ".":
            continue
        if s == "..":
            if not st.is_empty() and st.last().unwrap() != "..":
                st.remove(st.length() - 1)
            else if not abs:
                st.append("..")
        else:
            st.append(s)
    return Cleaned(abs: abs, st: st)

fn show(abs: Bool, st: List[String]) -> String:
    if abs:
        return "/" + st.join("/")
    if st.is_empty():
        return "."
    return st.join("/")

fn show_cleaned(c: Cleaned) -> String:
    return show(c.abs, c.st)

fn base(p: String) -> String:
    var end = p.length()
    while end > 0 and p.slice(end - 1, end) == "/":
        end = end - 1
    if end == 0:
        return "/"
    let q = p.slice(0, end)
    let idx = q.last_index_of("/")
    if idx.is_none():
        return q
    return q.slice(idx.unwrap() + 1, q.length())

fn common_prefix(a: List[String], b: List[String]) -> Int:
    var k = 0
    while k < a.length() and k < b.length() and a.at(k).unwrap() == b.at(k).unwrap():
        k = k + 1
    return k

fn rel(a: String, b: String) -> String:
    let x = clean(a)
    let y = clean(b)
    if x.abs != y.abs:
        return "error: cannot relativize"
    let k = common_prefix(x.st, y.st)
    let rest = x.st.slice(k, x.st.length())
    if rest.contains(".."):
        return "error: cannot relativize"
    let r = List[String]()
    for item in rest:
        r.append("..")
    for s in y.st.slice(k, y.st.length()):
        r.append(s)
    if r.is_empty():
        return "."
    return r.join("/")

fn common(a: List[String]) -> String:
    let cs = a.map(fn(p: String) -> Cleaned:
        return clean(p)
    )
    let first = cs.at(0).unwrap()
    for c in cs:
        if c.abs != first.abs:
            return "error: mixed"
    var pre = first.st.clone()
    for c in cs:
        pre = pre.slice(0, common_prefix(pre, c.st))
    return show(first.abs, pre)

fn step(t: List[String]) -> String:
    let c = t.at(0).unwrap()
    let a = t.slice(1, t.length())
    let n = a.length()
    if c == "clean" and n == 1:
        return show_cleaned(clean(a.at(0).unwrap()))
    if c == "join" and n >= 1:
        return show_cleaned(clean(a.join("/")))
    if c == "resolve" and n == 2:
        let cwd = a.at(0).unwrap()
        let p = a.at(1).unwrap()
        if not cwd.starts_with("/"):
            return "error: cwd not absolute"
        if p.starts_with("/"):
            return show_cleaned(clean(p))
        return show_cleaned(clean(cwd + "/" + p))
    if c == "rel" and n == 2:
        return rel(a.at(0).unwrap(), a.at(1).unwrap())
    if c == "base" and n == 1:
        return base(a.at(0).unwrap())
    if c == "dir" and n == 1:
        let p = a.at(0).unwrap()
        let i = p.last_index_of("/")
        if i.is_none():
            return "."
        return show_cleaned(clean(p.slice(0, i.unwrap() + 1)))
    if c == "ext" and n == 1:
        let b = base(a.at(0).unwrap())
        let i = b.last_index_of(".")
        if i.is_some() and i.unwrap() > 0:
            return b.slice(i.unwrap(), b.length())
        return "(none)"
    if c == "common" and n >= 1:
        return common(a)
    return "error: bad command"

fn run() -> Result[Unit, Error]:
    let out = StringBuilder()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let t = fields(next.unwrap())
        if t.is_empty():
            continue
        out.append(step(t))
        out.append("\n")
    try stdout().write(out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
