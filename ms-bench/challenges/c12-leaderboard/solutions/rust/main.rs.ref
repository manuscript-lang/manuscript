use std::io::{BufRead, Write};

fn valid_score(s: &str) -> bool {
    let d = s.strip_prefix('-').unwrap_or(s);
    !d.is_empty() && d.len() <= 9 && d.bytes().all(|b| b.is_ascii_digit())
}

fn main() {
    let stdin = std::io::stdin();
    let mut lines = stdin.lock().lines().map(|l| l.unwrap());
    let mode = lines.next().unwrap_or_default();
    if mode != "rank" && mode != "dense" && mode != "stable" {
        println!("error: bad mode");
        return;
    }
    let mut ents: Vec<(String, i64)> = Vec::new();
    let mut bad = 0;
    for l in lines {
        if l.trim_matches(' ').is_empty() {
            continue;
        }
        let t: Vec<&str> = l.split(' ').collect();
        if t.len() != 2 || t[0].is_empty() || !valid_score(t[1]) {
            bad += 1;
            continue;
        }
        ents.push((t[0].to_string(), t[1].parse().unwrap()));
    }
    if mode == "stable" {
        ents.sort_by(|a, b| b.1.cmp(&a.1));
    } else {
        ents.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
    }
    let mut out = String::new();
    let (mut rank, mut prev) = (0usize, 0i64);
    for (i, (name, score)) in ents.iter().enumerate() {
        if mode == "stable" {
            out.push_str(&format!("{} {}\n", name, score));
            continue;
        }
        if i == 0 || *score != prev {
            rank = if mode == "rank" { i + 1 } else { rank + 1 };
            prev = *score;
        }
        out.push_str(&format!("{} {} {}\n", rank, name, score));
    }
    if bad > 0 {
        out.push_str(&format!("skipped: {}\n", bad));
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
