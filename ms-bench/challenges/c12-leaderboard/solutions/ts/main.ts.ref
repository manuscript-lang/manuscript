import { readFileSync } from "node:fs";

const lines = readFileSync(0, "utf8").split("\n");
if (lines[lines.length - 1] === "") lines.pop();
const mode = lines[0] ?? "";
if (mode !== "rank" && mode !== "dense" && mode !== "stable") {
  process.stdout.write("error: bad mode\n");
  process.exit(0);
}
type Entry = { name: string; score: number; idx: number };
const ents: Entry[] = [];
let bad = 0;
for (const l of lines.slice(1)) {
  if (l.replace(/ /g, "") === "") continue;
  const t = l.split(" ");
  if (t.length !== 2 || t[0] === "" || !/^-?[0-9]{1,9}$/.test(t[1])) { bad++; continue; }
  ents.push({ name: t[0], score: Number(t[1]) + 0, idx: ents.length });
}
const cmpStr = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
if (mode === "stable") ents.sort((a, b) => b.score - a.score || a.idx - b.idx);
else ents.sort((a, b) => b.score - a.score || cmpStr(a.name, b.name));
const out: string[] = [];
let rank = 0;
let prev: number | null = null;
ents.forEach((e, i) => {
  if (mode === "stable") { out.push(`${e.name} ${e.score}`); return; }
  if (e.score !== prev) { rank = mode === "rank" ? i + 1 : rank + 1; prev = e.score; }
  out.push(`${rank} ${e.name} ${e.score}`);
});
if (bad > 0) out.push(`skipped: ${bad}`);
process.stdout.write(out.map((x) => x + "\n").join(""));
