import {stdin, stdout, read_all} from "@std/io.ms"

# Recursive-descent parser over Unicode scalar codes. Pieces of the pretty-printed result are collected in
# `out`; every parse function returns false when the input is invalid.
type Parser:
    text: String
    codes: List[Int]
    pos: Int
    out: List[String]

# The code at the cursor, or -1 at the end of the input.
fn peek(p: Parser) -> Int:
    return p.codes.at(p.pos).unwrap_or(-1)

fn skip_ws(p: Parser) -> Unit:
    while true:
        let c = peek(p)
        if c == 32 or c == 9 or c == 10 or c == 13:
            p.pos = p.pos + 1
        else:
            break

fn is_digit(c: Int) -> Bool:
    return c >= 48 and c <= 57

fn is_hex(c: Int) -> Bool:
    return is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)

fn word(p: Parser, w: String) -> Bool:
    if p.pos + w.length() > p.codes.length():
        return false
    if p.text.slice(p.pos, p.pos + w.length()).unwrap() != w:
        return false
    p.pos = p.pos + w.length()
    p.out.append(w)
    return true

fn parse_string(p: Parser) -> Bool:
    let start = p.pos
    if peek(p) != 34:
        return false
    p.pos = p.pos + 1
    while true:
        let c = peek(p)
        if c == -1 or c < 32:
            return false
        if c == 34:
            p.pos = p.pos + 1
            p.out.append(p.text.slice(start, p.pos).unwrap())
            return true
        if c == 92:
            p.pos = p.pos + 1
            let e = peek(p)
            # " \ / b f n r t
            if e == 34 or e == 92 or e == 47 or e == 98 or e == 102 or e == 110 or e == 114 or e == 116:
                p.pos = p.pos + 1
            else if e == 117:
                var k = 1
                while k <= 4:
                    if not is_hex(p.codes.at(p.pos + k).unwrap_or(-1)):
                        return false
                    k = k + 1
                p.pos = p.pos + 5
            else:
                return false
        else:
            p.pos = p.pos + 1
    return false

fn digits(p: Parser) -> Bool:
    if not is_digit(peek(p)):
        return false
    while is_digit(peek(p)):
        p.pos = p.pos + 1
    return true

fn parse_number(p: Parser) -> Bool:
    let start = p.pos
    if peek(p) == 45:
        p.pos = p.pos + 1
    let first = peek(p)
    if first == 48:
        p.pos = p.pos + 1
    else if first >= 49 and first <= 57:
        if not digits(p):
            return false
    else:
        return false
    if peek(p) == 46:
        p.pos = p.pos + 1
        if not digits(p):
            return false
    if peek(p) == 101 or peek(p) == 69:
        p.pos = p.pos + 1
        if peek(p) == 43 or peek(p) == 45:
            p.pos = p.pos + 1
        if not digits(p):
            return false
    p.out.append(p.text.slice(start, p.pos).unwrap())
    return true

fn indent(p: Parser, n: Int) -> Unit:
    p.out.append("  ".repeat(n).unwrap())

# Parses an object (open = 123) or an array (open = 91).
fn container(p: Parser, depth: Int, open: Int, close: Int) -> Bool:
    p.pos = p.pos + 1
    skip_ws(p)
    var is_object = true
    var open_s = "\{"
    var close_s = "\}"
    if open == 91:
        is_object = false
        open_s = "["
        close_s = "]"
    if peek(p) == close:
        p.pos = p.pos + 1
        p.out.append(open_s)
        p.out.append(close_s)
        return true
    p.out.append(open_s)
    p.out.append("\n")
    var first = true
    while true:
        if not first:
            p.out.append(",\n")
        first = false
        skip_ws(p)
        indent(p, depth + 1)
        if is_object:
            if not parse_string(p):
                return false
            skip_ws(p)
            if peek(p) != 58:
                return false
            p.pos = p.pos + 1
            skip_ws(p)
            p.out.append(": ")
        if not value(p, depth + 1):
            return false
        skip_ws(p)
        let c = peek(p)
        if c == 44:
            p.pos = p.pos + 1
        else if c == close:
            p.pos = p.pos + 1
            break
        else:
            return false
    p.out.append("\n")
    indent(p, depth)
    p.out.append(close_s)
    return true

fn value(p: Parser, depth: Int) -> Bool:
    let c = peek(p)
    if c == 123:
        return container(p, depth, 123, 125)
    if c == 91:
        return container(p, depth, 91, 93)
    if c == 34:
        return parse_string(p)
    if c == 116:
        return word(p, "true")
    if c == 102:
        return word(p, "false")
    if c == 110:
        return word(p, "null")
    return parse_number(p)

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let text = data.to_text().unwrap_or("")
    let p = Parser(text: text, codes: text.scalar_values(), pos: 0, out: List[String]())
    skip_ws(p)
    var ok = value(p, 0)
    if ok:
        skip_ws(p)
        ok = p.pos == p.codes.length()
    if ok:
        try stdout().write("{p.out.join("")}\n".to_bytes())
    else:
        try stdout().write("invalid\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
