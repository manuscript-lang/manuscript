import { readFileSync } from "node:fs";

function money(c: number): string {
  return `${Math.floor(c / 100)}.${String(c % 100).padStart(2, "0")}`;
}

function daysFromCivil(y: number, m: number, d: number): number {
  y -= m <= 2 ? 1 : 0;
  const era = Math.floor(y / 400);
  const yoe = y - era * 400;
  const doy = Math.floor((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1;
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy;
  return era * 146097 + doe - 719468;
}

function leap(y: number): boolean {
  return (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
}

function dayNumber(s: string): number | null {
  if (!/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/.test(s)) return null;
  const y = Number(s.slice(0, 4)), m = Number(s.slice(5, 7)), d = Number(s.slice(8, 10));
  if (y < 1970 || y > 2099 || m < 1 || m > 12 || d < 1) return null;
  const dim = [31, leap(y) ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][m - 1];
  if (d > dim) return null;
  return daysFromCivil(y, m, d);
}

function hm(s: string): number | null {
  if (!/^[0-9]{2}:[0-9]{2}$/.test(s)) return null;
  const h = Number(s.slice(0, 2)), m = Number(s.slice(3, 5));
  if (h > 23 || m > 59) return null;
  return h * 60 + m;
}

const lines = readFileSync(0, "utf8").split("\n");
if (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();
const rates = new Map<string, number>();
const days = new Map<string, Array<[number, number]>>();
const weeks = new Map<string, Map<number, number>>();
const out: string[] = [];
let section = "";
let accepted = 0, rejected = 0;
lines.forEach((l, i) => {
  if (l.replace(/ /g, "") === "") return;
  if (l === "[rates]") { section = "rates"; return; }
  if (l === "[shifts]") { section = "shifts"; return; }
  let why = "";
  if (l.startsWith("[")) { section = ""; why = "unknown section"; }
  else if (section === "") why = "outside section";
  else if (section === "rates") {
    const m = /^([a-z]+)=([0-9]{1,6})$/.exec(l);
    if (!m || Number(m[2]) < 1 || Number(m[2]) > 100000) why = "bad rate";
    else if (rates.has(m[1])) why = "duplicate employee";
    else rates.set(m[1], Number(m[2]));
  } else {
    const f = l.split(",");
    if (f.length !== 5) why = "malformed row";
    else {
      const [emp, date, st, en, br] = f;
      const day = dayNumber(date), a = hm(st), b = hm(en);
      if (!rates.has(emp)) why = "unknown employee";
      else if (day === null) why = "bad date";
      else if (a === null || b === null) why = "bad time";
      else if (b <= a) why = "end not after start";
      else if (!/^[0-9]{1,3}$/.test(br)) why = "bad break";
      else if (Number(br) >= b - a) why = "break too long";
      else {
        const key = emp + "|" + date;
        const list = days.get(key) ?? [];
        if (list.some(([s2, e2]) => a < e2 && s2 < b)) why = "overlapping shift";
        else {
          list.push([a, b]);
          days.set(key, list);
          const week = day - ((day + 3) % 7);
          const w = weeks.get(emp) ?? new Map<number, number>();
          w.set(week, (w.get(week) ?? 0) + (b - a - Number(br)));
          weeks.set(emp, w);
          accepted++;
        }
      }
    }
  }
  if (why) { out.push(`line ${i + 1}: rejected: ${why}`); rejected++; }
});
let grand = 0;
const names = [...weeks.keys()].sort((x, y) => (x < y ? -1 : x > y ? 1 : 0));
for (const emp of names) {
  const r = rates.get(emp)!;
  let reg = 0, ot = 0, tot = 0;
  const w = weeks.get(emp)!;
  for (const M of w.values()) {
    const rm = Math.min(M, 2400), om = M - rm;
    reg += Math.floor((rm * r + 30) / 60);
    ot += Math.floor((om * r * 3 + 60) / 120);
    tot += M;
  }
  grand += reg + ot;
  out.push(`${emp} | weeks=${w.size} | worked=${Math.floor(tot / 60)}:${String(tot % 60).padStart(2, "0")} | regular=${money(reg)} | overtime=${money(ot)} | total=${money(reg + ot)}`);
}
out.push(`payroll employees=${names.length} shifts=${accepted} rejected=${rejected} total=${money(grand)}`);
process.stdout.write(out.map((x) => x + "\n").join(""));
