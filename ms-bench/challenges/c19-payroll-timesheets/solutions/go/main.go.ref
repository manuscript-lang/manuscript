package main

import (
	"bufio"
	"fmt"
	"os"
	"regexp"
	"sort"
	"strconv"
	"strings"
)

func money(c int) string { return fmt.Sprintf("%d.%02d", c/100, c%100) }

func leap(y int) bool { return (y%4 == 0 && y%100 != 0) || y%400 == 0 }

func daysFromCivil(y, m, d int) int {
	if m <= 2 {
		y--
	}
	era := y / 400
	yoe := y - era*400
	mp := m - 3
	if m <= 2 {
		mp = m + 9
	}
	doy := (153*mp+2)/5 + d - 1
	doe := yoe*365 + yoe/4 - yoe/100 + doy
	return era*146097 + doe - 719468
}

var reDate = regexp.MustCompile(`^[0-9]{4}-[0-9]{2}-[0-9]{2}$`)
var reTime = regexp.MustCompile(`^[0-9]{2}:[0-9]{2}$`)
var reRate = regexp.MustCompile(`^([a-z]+)=([0-9]{1,6})$`)
var reBreak = regexp.MustCompile(`^[0-9]{1,3}$`)

func dayNumber(s string) (int, bool) {
	if !reDate.MatchString(s) {
		return 0, false
	}
	y, _ := strconv.Atoi(s[0:4])
	m, _ := strconv.Atoi(s[5:7])
	d, _ := strconv.Atoi(s[8:10])
	if y < 1970 || y > 2099 || m < 1 || m > 12 || d < 1 {
		return 0, false
	}
	f := 28
	if leap(y) {
		f = 29
	}
	dim := []int{31, f, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}[m-1]
	if d > dim {
		return 0, false
	}
	return daysFromCivil(y, m, d), true
}

func hm(s string) (int, bool) {
	if !reTime.MatchString(s) {
		return 0, false
	}
	h, _ := strconv.Atoi(s[0:2])
	m, _ := strconv.Atoi(s[3:5])
	if h > 23 || m > 59 {
		return 0, false
	}
	return h*60 + m, true
}

func main() {
	var lines []string
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	for sc.Scan() {
		lines = append(lines, sc.Text())
	}
	rates := map[string]int{}
	days := map[string][][2]int{}
	weeks := map[string]map[int]int{}
	var out []string
	section := ""
	accepted, rejected := 0, 0
	for i, l := range lines {
		if strings.ReplaceAll(l, " ", "") == "" {
			continue
		}
		if l == "[rates]" {
			section = "rates"
			continue
		}
		if l == "[shifts]" {
			section = "shifts"
			continue
		}
		why := ""
		if strings.HasPrefix(l, "[") {
			section = ""
			why = "unknown section"
		} else if section == "" {
			why = "outside section"
		} else if section == "rates" {
			m := reRate.FindStringSubmatch(l)
			if m == nil {
				why = "bad rate"
			} else if v, _ := strconv.Atoi(m[2]); v < 1 || v > 100000 {
				why = "bad rate"
			} else if _, ok := rates[m[1]]; ok {
				why = "duplicate employee"
			} else {
				rates[m[1]] = v
			}
		} else {
			f := strings.Split(l, ",")
			if len(f) != 5 {
				why = "malformed row"
			} else {
				emp, date, br := f[0], f[1], f[4]
				day, dok := dayNumber(date)
				a, aok := hm(f[2])
				b, bok := hm(f[3])
				if _, ok := rates[emp]; !ok {
					why = "unknown employee"
				} else if !dok {
					why = "bad date"
				} else if !aok || !bok {
					why = "bad time"
				} else if b <= a {
					why = "end not after start"
				} else if !reBreak.MatchString(br) {
					why = "bad break"
				} else if bn, _ := strconv.Atoi(br); bn >= b-a {
					why = "break too long"
				} else {
					key := emp + "|" + date
					overlap := false
					for _, p := range days[key] {
						if a < p[1] && p[0] < b {
							overlap = true
						}
					}
					if overlap {
						why = "overlapping shift"
					} else {
						days[key] = append(days[key], [2]int{a, b})
						week := day - (day+3)%7
						if weeks[emp] == nil {
							weeks[emp] = map[int]int{}
						}
						weeks[emp][week] += b - a - bn
						accepted++
					}
				}
			}
		}
		if why != "" {
			out = append(out, fmt.Sprintf("line %d: rejected: %s", i+1, why))
			rejected++
		}
	}
	names := make([]string, 0, len(weeks))
	for k := range weeks {
		names = append(names, k)
	}
	sort.Strings(names)
	grand := 0
	for _, emp := range names {
		r := rates[emp]
		reg, ot, tot := 0, 0, 0
		for _, M := range weeks[emp] {
			rm := M
			if rm > 2400 {
				rm = 2400
			}
			om := M - rm
			reg += (rm*r + 30) / 60
			ot += (om*r*3 + 60) / 120
			tot += M
		}
		grand += reg + ot
		out = append(out, fmt.Sprintf("%s | weeks=%d | worked=%d:%02d | regular=%s | overtime=%s | total=%s", emp, len(weeks[emp]), tot/60, tot%60, money(reg), money(ot), money(reg+ot)))
	}
	out = append(out, fmt.Sprintf("payroll employees=%d shifts=%d rejected=%d total=%s", len(names), accepted, rejected, money(grand)))
	w := bufio.NewWriter(os.Stdout)
	for _, s := range out {
		w.WriteString(s + "\n")
	}
	w.Flush()
}
