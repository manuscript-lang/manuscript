import {stdin, stdout, read_line} from "@std/io.ms"

fn money(c: Int) -> String:
    let cents = c % 100
    if cents < 10:
        return "{c / 100}.0{cents}"
    return "{c / 100}.{cents}"

fn is_digit(c: Int) -> Bool:
    return c >= 48 and c <= 57

# Value of codes[lo..hi) when all are digits, else -1.
fn digits(codes: List[Int], lo: Int, hi: Int) -> Int:
    var n = 0
    var i = lo
    while i < hi:
        let c = codes.at(i).unwrap()
        if not is_digit(c):
            return -1
        n = n * 10 + (c - 48)
        i = i + 1
    return n

fn is_leap(y: Int) -> Bool:
    return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0

fn days_in_month(y: Int, m: Int) -> Int:
    if m == 2:
        if is_leap(y):
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31

fn days_from_civil(year: Int, m: Int, d: Int) -> Int:
    var y = year
    if m <= 2:
        y = y - 1
    let era = y / 400
    let yoe = y - era * 400
    var mp = m - 3
    if m <= 2:
        mp = m + 9
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

# Day number, or -1 for an invalid date.
fn day_number(s: String) -> Int:
    let c = s.scalar_values()
    if c.length() != 10 or c.at(4).unwrap() != 45 or c.at(7).unwrap() != 45:
        return -1
    let y = digits(c, 0, 4)
    let m = digits(c, 5, 7)
    let d = digits(c, 8, 10)
    if y < 1970 or y > 2099 or m < 1 or m > 12 or d < 1:
        return -1
    if d > days_in_month(y, m):
        return -1
    return days_from_civil(y, m, d)

# Minutes since midnight, or -1.
fn hm(s: String) -> Int:
    let c = s.scalar_values()
    if c.length() != 5 or c.at(2).unwrap() != 58:
        return -1
    let h = digits(c, 0, 2)
    let m = digits(c, 3, 5)
    if h < 0 or m < 0 or h > 23 or m > 59:
        return -1
    return h * 60 + m

fn is_lower_name(s: String) -> Bool:
    let codes = s.scalar_values()
    if codes.is_empty():
        return false
    for c in codes:
        if c < 97 or c > 122:
            return false
    return true

fn overlaps(list: List[Int], a: Int, b: Int) -> Bool:
    var i = 0
    while i < list.length():
        if a < list.at(i + 1).unwrap() and list.at(i).unwrap() < b:
            return true
        i = i + 2
    return false

fn run() -> Result[Unit, Error]:
    let rates = Map[String, Int]()
    let days = Map[String, List[Int]]()
    let week_min = Map[String, Int]()
    let out = List[String]()
    var section = 0
    var accepted = 0
    var rejected = 0
    var n = 0
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let l = next.unwrap()
        n = n + 1
        if l.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        if l == "[rates]":
            section = 1
            continue
        if l == "[shifts]":
            section = 2
            continue
        var why = ""
        if l.scalar_values().at(0).unwrap() == 91:
            section = 0
            why = "unknown section"
        else if section == 0:
            why = "outside section"
        else if section == 1:
            let p = l.split("=")
            if p.length() != 2 or not is_lower_name(p.at(0).unwrap()):
                why = "bad rate"
            else:
                let rc = p.at(1).unwrap().scalar_values()
                let v = digits(rc, 0, rc.length())
                if rc.length() < 1 or rc.length() > 6 or v < 1 or v > 100000:
                    why = "bad rate"
                else if rates.contains(p.at(0).unwrap()):
                    why = "duplicate employee"
                else:
                    rates.add(key: p.at(0).unwrap(), value: v)
        else:
            let f = l.split(",")
            if f.length() != 5:
                why = "malformed row"
            else:
                let emp = f.at(0).unwrap()
                let date = f.at(1).unwrap()
                let day = day_number(date)
                let a = hm(f.at(2).unwrap())
                let b = hm(f.at(3).unwrap())
                let bc = f.at(4).unwrap().scalar_values()
                let bn = digits(bc, 0, bc.length())
                if not rates.contains(emp):
                    why = "unknown employee"
                else if day < 0:
                    why = "bad date"
                else if a < 0 or b < 0:
                    why = "bad time"
                else if b <= a:
                    why = "end not after start"
                else if bc.length() < 1 or bc.length() > 3 or bn < 0:
                    why = "bad break"
                else if bn >= b - a:
                    why = "break too long"
                else:
                    let key = "{emp}|{date}"
                    if not days.contains(key):
                        days.add(key: key, value: List[Int]())
                    let list = days.get(key).unwrap()
                    if overlaps(list, a, b):
                        why = "overlapping shift"
                    else:
                        list.append(a)
                        list.append(b)
                        let week = day - (day + 3) % 7
                        let wk = "{emp}|{week}"
                        week_min.add(key: wk, value: week_min.get_or(key: wk, fallback: 0) + (b - a - bn))
                        accepted = accepted + 1
        if not why.is_empty():
            out.append("line {n}: rejected: {why}")
            rejected = rejected + 1
    let reg = Map[String, Int]()
    let ot = Map[String, Int]()
    let tot = Map[String, Int]()
    let wcount = Map[String, Int]()
    for wk in week_min.keys():
        let emp = wk.split("|").at(0).unwrap()
        let m = week_min.get(wk).unwrap()
        let r = rates.get(emp).unwrap()
        var rm = m
        if rm > 2400:
            rm = 2400
        let om = m - rm
        reg.add(key: emp, value: reg.get_or(key: emp, fallback: 0) + (rm * r + 30) / 60)
        ot.add(key: emp, value: ot.get_or(key: emp, fallback: 0) + (om * r * 3 + 60) / 120)
        tot.add(key: emp, value: tot.get_or(key: emp, fallback: 0) + m)
        wcount.add(key: emp, value: wcount.get_or(key: emp, fallback: 0) + 1)
    let names = wcount.keys().sorted(compare: fn(left: String, right: String) -> Int:
        return left.compare(right)
    )
    var grand = 0
    for emp in names:
        let rg = reg.get(emp).unwrap()
        let o = ot.get(emp).unwrap()
        let t = tot.get(emp).unwrap()
        grand = grand + rg + o
        var mm = "{t % 60}"
        if t % 60 < 10:
            mm = "0{t % 60}"
        out.append("{emp} | weeks={wcount.get(emp).unwrap()} | worked={t / 60}:{mm} | regular={money(rg)} | overtime={money(o)} | total={money(rg + o)}")
    out.append("payroll employees={names.length()} shifts={accepted} rejected={rejected} total={money(grand)}")
    for s in out:
        try stdout().write("{s}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
