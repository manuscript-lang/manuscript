use std::collections::{BTreeMap, HashMap};
use std::io::{self, Read, Write};

fn money(c: i64) -> String {
    format!("{}.{:02}", c / 100, c % 100)
}

fn leap(y: i64) -> bool {
    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0
}

fn days_from_civil(mut y: i64, m: i64, d: i64) -> i64 {
    if m <= 2 {
        y -= 1;
    }
    let era = y / 400;
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn all_digits(s: &str, min: usize, max: usize) -> bool {
    s.len() >= min && s.len() <= max && s.bytes().all(|c| c.is_ascii_digit())
}

fn day_number(s: &str) -> Option<i64> {
    let b = s.as_bytes();
    if b.len() != 10 || b[4] != b'-' || b[7] != b'-' {
        return None;
    }
    if !all_digits(&s[0..4], 4, 4) || !all_digits(&s[5..7], 2, 2) || !all_digits(&s[8..10], 2, 2) {
        return None;
    }
    let y: i64 = s[0..4].parse().unwrap();
    let m: i64 = s[5..7].parse().unwrap();
    let d: i64 = s[8..10].parse().unwrap();
    if y < 1970 || y > 2099 || m < 1 || m > 12 || d < 1 {
        return None;
    }
    let dim = [31, if leap(y) { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][(m - 1) as usize];
    if d > dim {
        return None;
    }
    Some(days_from_civil(y, m, d))
}

fn hm(s: &str) -> Option<i64> {
    let b = s.as_bytes();
    if b.len() != 5 || b[2] != b':' || !all_digits(&s[0..2], 2, 2) || !all_digits(&s[3..5], 2, 2) {
        return None;
    }
    let h: i64 = s[0..2].parse().unwrap();
    let m: i64 = s[3..5].parse().unwrap();
    if h > 23 || m > 59 {
        return None;
    }
    Some(h * 60 + m)
}

fn main() {
    let mut text = String::new();
    io::stdin().read_to_string(&mut text).unwrap();
    let mut rates: HashMap<String, i64> = HashMap::new();
    let mut days: HashMap<String, Vec<(i64, i64)>> = HashMap::new();
    let mut weeks: BTreeMap<String, BTreeMap<i64, i64>> = BTreeMap::new();
    let mut out: Vec<String> = Vec::new();
    let mut section = "";
    let (mut accepted, mut rejected) = (0, 0);
    for (i, l) in text.lines().enumerate() {
        if l.replace(' ', "").is_empty() {
            continue;
        }
        if l == "[rates]" {
            section = "rates";
            continue;
        }
        if l == "[shifts]" {
            section = "shifts";
            continue;
        }
        let mut why = "";
        if l.starts_with('[') {
            section = "";
            why = "unknown section";
        } else if section.is_empty() {
            why = "outside section";
        } else if section == "rates" {
            let parts: Vec<&str> = l.split('=').collect();
            let ok = parts.len() == 2
                && !parts[0].is_empty()
                && parts[0].bytes().all(|c| c.is_ascii_lowercase())
                && all_digits(parts[1], 1, 6);
            if !ok {
                why = "bad rate";
            } else {
                let v: i64 = parts[1].parse().unwrap();
                if v < 1 || v > 100000 {
                    why = "bad rate";
                } else if rates.contains_key(parts[0]) {
                    why = "duplicate employee";
                } else {
                    rates.insert(parts[0].to_string(), v);
                }
            }
        } else {
            let f: Vec<&str> = l.split(',').collect();
            if f.len() != 5 {
                why = "malformed row";
            } else {
                let (emp, date, br) = (f[0], f[1], f[4]);
                let day = day_number(date);
                let a = hm(f[2]);
                let b = hm(f[3]);
                if !rates.contains_key(emp) {
                    why = "unknown employee";
                } else if day.is_none() {
                    why = "bad date";
                } else if a.is_none() || b.is_none() {
                    why = "bad time";
                } else if b.unwrap() <= a.unwrap() {
                    why = "end not after start";
                } else if !all_digits(br, 1, 3) {
                    why = "bad break";
                } else {
                    let (a, b, day) = (a.unwrap(), b.unwrap(), day.unwrap());
                    let bn: i64 = br.parse().unwrap();
                    if bn >= b - a {
                        why = "break too long";
                    } else {
                        let key = format!("{}|{}", emp, date);
                        let list = days.entry(key).or_default();
                        if list.iter().any(|&(s2, e2)| a < e2 && s2 < b) {
                            why = "overlapping shift";
                        } else {
                            list.push((a, b));
                            let week = day - (day + 3) % 7;
                            *weeks.entry(emp.to_string()).or_default().entry(week).or_insert(0) += b - a - bn;
                            accepted += 1;
                        }
                    }
                }
            }
        }
        if !why.is_empty() {
            out.push(format!("line {}: rejected: {}", i + 1, why));
            rejected += 1;
        }
    }
    let mut grand = 0;
    for (emp, w) in &weeks {
        let r = rates[emp];
        let (mut reg, mut ot, mut tot) = (0, 0, 0);
        for &m in w.values() {
            let rm = m.min(2400);
            let om = m - rm;
            reg += (rm * r + 30) / 60;
            ot += (om * r * 3 + 60) / 120;
            tot += m;
        }
        grand += reg + ot;
        out.push(format!(
            "{} | weeks={} | worked={}:{:02} | regular={} | overtime={} | total={}",
            emp, w.len(), tot / 60, tot % 60, money(reg), money(ot), money(reg + ot)
        ));
    }
    out.push(format!("payroll employees={} shifts={} rejected={} total={}", weeks.len(), accepted, rejected, money(grand)));
    let so = io::stdout();
    let mut o = so.lock();
    for s in out {
        writeln!(o, "{}", s).unwrap();
    }
}
