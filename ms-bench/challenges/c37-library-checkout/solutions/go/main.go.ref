package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strconv"
	"strings"
)

type loan struct {
	member, book string
	due, renewals int
}

func isDigits(s string) bool {
	if s == "" {
		return false
	}
	for _, c := range s {
		if c < '0' || c > '9' {
			return false
		}
	}
	return true
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	books := map[string]int{}
	holds := map[string][]string{}
	members := map[string]int{}
	var loans []*loan
	arity := map[string]int{"book": 3, "member": 2, "checkout": 4, "return": 4, "renew": 4, "hold": 3, "overdue": 2, "report": 1}
	find := func(m, b string) int {
		for i, l := range loans {
			if l.member == m && l.book == b {
				return i
			}
		}
		return -1
	}
	countBy := func(f func(*loan) bool) int {
		n := 0
		for _, l := range loans {
			if f(l) {
				n++
			}
		}
		return n
	}
	sortedKeys := func(n int, each func(func(string))) []string {
		keys := make([]string, 0, n)
		each(func(k string) { keys = append(keys, k) })
		sort.Strings(keys)
		return keys
	}
	for sc.Scan() {
		t := strings.FieldsFunc(sc.Text(), func(r rune) bool { return r == ' ' || r == '\t' })
		if len(t) == 0 {
			continue
		}
		c := t[0]
		if n, ok := arity[c]; !ok || n != len(t) {
			fmt.Fprintln(out, "error: bad command")
			continue
		}
		switch c {
		case "book":
			n, _ := strconv.Atoi(t[2])
			if !isDigits(t[2]) || n == 0 {
				fmt.Fprintln(out, "error: bad copies")
				continue
			}
			books[t[1]] += n
			if _, ok := holds[t[1]]; !ok {
				holds[t[1]] = nil
			}
			fmt.Fprintln(out, "ok")
			continue
		case "member":
			if _, ok := members[t[1]]; ok {
				fmt.Fprintf(out, "error: member exists %s\n", t[1])
			} else {
				members[t[1]] = 0
				fmt.Fprintln(out, "ok")
			}
			continue
		case "report":
			fmt.Fprintf(out, "members=%d books=%d\n", len(members), len(books))
			for _, m := range sortedKeys(len(members), func(f func(string)) {
				for k := range members {
					f(k)
				}
			}) {
				fmt.Fprintf(out, "%s loans=%d fines=%d\n", m, countBy(func(l *loan) bool { return l.member == m }), members[m])
			}
			for _, b := range sortedKeys(len(books), func(f func(string)) {
				for k := range books {
					f(k)
				}
			}) {
				fmt.Fprintf(out, "%s copies=%d out=%d holds=%d\n", b, books[b], countBy(func(l *loan) bool { return l.book == b }), len(holds[b]))
			}
			continue
		}
		if c != "hold" && !isDigits(t[len(t)-1]) {
			fmt.Fprintln(out, "error: bad day")
			continue
		}
		if c == "overdue" {
			day, _ := strconv.Atoi(t[1])
			var rows []*loan
			for _, l := range loans {
				if day > l.due {
					rows = append(rows, l)
				}
			}
			sort.Slice(rows, func(i, j int) bool {
				if rows[i].member != rows[j].member {
					return rows[i].member < rows[j].member
				}
				return rows[i].book < rows[j].book
			})
			if len(rows) == 0 {
				fmt.Fprintln(out, "none")
			}
			for _, l := range rows {
				fmt.Fprintf(out, "%s %s late=%d\n", l.member, l.book, day-l.due)
			}
			continue
		}
		m, b := t[1], t[2]
		if _, ok := members[m]; !ok {
			fmt.Fprintf(out, "error: unknown member %s\n", m)
			continue
		}
		if _, ok := books[b]; !ok {
			fmt.Fprintf(out, "error: unknown book %s\n", b)
			continue
		}
		avail := books[b] - countBy(func(l *loan) bool { return l.book == b })
		q := holds[b]
		li := find(m, b)
		qpos := -1
		for i, x := range q {
			if x == m {
				qpos = i
			}
		}
		switch c {
		case "checkout":
			day, _ := strconv.Atoi(t[3])
			switch {
			case li >= 0:
				fmt.Fprintln(out, "error: already borrowed")
			case countBy(func(l *loan) bool { return l.member == m }) >= 3:
				fmt.Fprintln(out, "error: loan limit reached")
			case countBy(func(l *loan) bool { return l.member == m && day > l.due }) > 0:
				fmt.Fprintln(out, "error: has overdue loans")
			case avail <= 0:
				fmt.Fprintln(out, "error: no copies available")
			default:
				allowed := avail > len(q)
				if qpos >= 0 {
					allowed = qpos < avail
				}
				if !allowed {
					fmt.Fprintln(out, "error: reserved for holds")
				} else {
					if qpos >= 0 {
						holds[b] = append(q[:qpos:qpos], q[qpos+1:]...)
					}
					loans = append(loans, &loan{member: m, book: b, due: day + 14})
					fmt.Fprintf(out, "ok due=%d\n", day+14)
				}
			}
		case "return":
			day, _ := strconv.Atoi(t[3])
			if li < 0 {
				fmt.Fprintln(out, "error: not borrowed")
			} else {
				fine := 0
				if day > loans[li].due {
					fine = 10 * (day - loans[li].due)
				}
				loans = append(loans[:li], loans[li+1:]...)
				members[m] += fine
				fmt.Fprintf(out, "ok fine=%d\n", fine)
			}
		case "renew":
			day, _ := strconv.Atoi(t[3])
			switch {
			case li < 0:
				fmt.Fprintln(out, "error: not borrowed")
			case day > loans[li].due:
				fmt.Fprintln(out, "error: overdue")
			case loans[li].renewals >= 2:
				fmt.Fprintln(out, "error: renewal limit")
			case len(q) > 0:
				fmt.Fprintln(out, "error: held by others")
			default:
				loans[li].due += 14
				loans[li].renewals++
				fmt.Fprintf(out, "ok due=%d\n", loans[li].due)
			}
		default:
			switch {
			case li >= 0:
				fmt.Fprintln(out, "error: already borrowed")
			case qpos >= 0:
				fmt.Fprintln(out, "error: already on hold")
			case avail > len(q):
				fmt.Fprintln(out, "error: copies available")
			default:
				holds[b] = append(q, m)
				fmt.Fprintf(out, "ok position=%d\n", len(holds[b]))
			}
		}
	}
}
