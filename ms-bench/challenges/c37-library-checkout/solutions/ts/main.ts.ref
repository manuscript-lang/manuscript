import { readFileSync } from "node:fs";

type Loan = { member: string; book: string; due: number; renewals: number };
const books = new Map<string, number>();
const holds = new Map<string, string[]>();
const members = new Map<string, number>();
const loans: Loan[] = [];
const out: string[] = [];
const arity: Record<string, number> = { book: 3, member: 2, checkout: 4, return: 4, renew: 4, hold: 3, overdue: 2, report: 1 };
const digits = (s: string) => /^[0-9]+$/.test(s);
const byteCmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
const findLoan = (m: string, b: string) => loans.findIndex((l) => l.member === m && l.book === b);

for (const line of readFileSync(0, "utf8").split("\n")) {
  const t = line.split(/[ \t]+/).filter((x) => x !== "");
  if (t.length === 0) continue;
  const c = t[0];
  if (!(c in arity) || t.length !== arity[c]) {
    out.push("error: bad command");
    continue;
  }
  if (c === "book") {
    if (!digits(t[2]) || parseInt(t[2], 10) === 0) {
      out.push("error: bad copies");
      continue;
    }
    books.set(t[1], (books.get(t[1]) ?? 0) + parseInt(t[2], 10));
    if (!holds.has(t[1])) holds.set(t[1], []);
    out.push("ok");
    continue;
  }
  if (c === "member") {
    if (members.has(t[1])) out.push(`error: member exists ${t[1]}`);
    else {
      members.set(t[1], 0);
      out.push("ok");
    }
    continue;
  }
  if (c === "report") {
    out.push(`members=${members.size} books=${books.size}`);
    for (const m of [...members.keys()].sort(byteCmp)) {
      out.push(`${m} loans=${loans.filter((l) => l.member === m).length} fines=${members.get(m)}`);
    }
    for (const b of [...books.keys()].sort(byteCmp)) {
      out.push(`${b} copies=${books.get(b)} out=${loans.filter((l) => l.book === b).length} holds=${holds.get(b)!.length}`);
    }
    continue;
  }
  if (!digits(t[t.length - 1])) {
    if (c !== "hold") {
      out.push("error: bad day");
      continue;
    }
  }
  if (c === "overdue") {
    const day = parseInt(t[1], 10);
    const rows = loans
      .filter((l) => day > l.due)
      .sort((x, y) => byteCmp(x.member, y.member) || byteCmp(x.book, y.book));
    if (rows.length === 0) out.push("none");
    for (const l of rows) out.push(`${l.member} ${l.book} late=${day - l.due}`);
    continue;
  }
  const m = t[1];
  const b = t[2];
  if (!members.has(m)) {
    out.push(`error: unknown member ${m}`);
    continue;
  }
  if (!books.has(b)) {
    out.push(`error: unknown book ${b}`);
    continue;
  }
  const avail = books.get(b)! - loans.filter((l) => l.book === b).length;
  const q = holds.get(b)!;
  const li = findLoan(m, b);
  if (c === "checkout") {
    const day = parseInt(t[3], 10);
    if (li >= 0) out.push("error: already borrowed");
    else if (loans.filter((l) => l.member === m).length >= 3) out.push("error: loan limit reached");
    else if (loans.some((l) => l.member === m && day > l.due)) out.push("error: has overdue loans");
    else if (avail <= 0) out.push("error: no copies available");
    else {
      const p = q.indexOf(m);
      const allowed = p >= 0 ? p < avail : avail > q.length;
      if (!allowed) out.push("error: reserved for holds");
      else {
        if (p >= 0) q.splice(p, 1);
        loans.push({ member: m, book: b, due: day + 14, renewals: 0 });
        out.push(`ok due=${day + 14}`);
      }
    }
  } else if (c === "return") {
    const day = parseInt(t[3], 10);
    if (li < 0) out.push("error: not borrowed");
    else {
      const fine = 10 * Math.max(0, day - loans[li].due);
      loans.splice(li, 1);
      members.set(m, members.get(m)! + fine);
      out.push(`ok fine=${fine}`);
    }
  } else if (c === "renew") {
    const day = parseInt(t[3], 10);
    if (li < 0) out.push("error: not borrowed");
    else if (day > loans[li].due) out.push("error: overdue");
    else if (loans[li].renewals >= 2) out.push("error: renewal limit");
    else if (q.length > 0) out.push("error: held by others");
    else {
      loans[li].due += 14;
      loans[li].renewals++;
      out.push(`ok due=${loans[li].due}`);
    }
  } else {
    if (li >= 0) out.push("error: already borrowed");
    else if (q.includes(m)) out.push("error: already on hold");
    else if (avail > q.length) out.push("error: copies available");
    else {
      q.push(m);
      out.push(`ok position=${q.length}`);
    }
  }
}
process.stdout.write(out.map((l) => l + "\n").join(""));
