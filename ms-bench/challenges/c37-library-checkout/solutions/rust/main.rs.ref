use std::collections::BTreeMap;
use std::io::{Read, Write};

struct Loan {
    member: String,
    book: String,
    due: i64,
    renewals: i64,
}

fn is_digits(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|c| c.is_ascii_digit())
}

fn main() {
    let mut input = String::new();
    std::io::stdin().read_to_string(&mut input).unwrap();
    let mut out = String::new();
    let mut books: BTreeMap<String, i64> = BTreeMap::new();
    let mut holds: BTreeMap<String, Vec<String>> = BTreeMap::new();
    let mut members: BTreeMap<String, i64> = BTreeMap::new();
    let mut loans: Vec<Loan> = Vec::new();
    for line in input.split('\n') {
        let t: Vec<&str> = line.split(|c| c == ' ' || c == '\t').filter(|x| !x.is_empty()).collect();
        if t.is_empty() {
            continue;
        }
        let c = t[0];
        let arity = match c {
            "book" | "hold" => 3,
            "member" | "overdue" => 2,
            "checkout" | "return" | "renew" => 4,
            "report" => 1,
            _ => 0,
        };
        if arity == 0 || t.len() != arity {
            out.push_str("error: bad command\n");
            continue;
        }
        match c {
            "book" => {
                let n: i64 = if is_digits(t[2]) { t[2].parse().unwrap_or(0) } else { 0 };
                if n == 0 {
                    out.push_str("error: bad copies\n");
                    continue;
                }
                *books.entry(t[1].to_string()).or_insert(0) += n;
                holds.entry(t[1].to_string()).or_default();
                out.push_str("ok\n");
                continue;
            }
            "member" => {
                if members.contains_key(t[1]) {
                    out.push_str(&format!("error: member exists {}\n", t[1]));
                } else {
                    members.insert(t[1].to_string(), 0);
                    out.push_str("ok\n");
                }
                continue;
            }
            "report" => {
                out.push_str(&format!("members={} books={}\n", members.len(), books.len()));
                for (m, fines) in &members {
                    let n = loans.iter().filter(|l| &l.member == m).count();
                    out.push_str(&format!("{} loans={} fines={}\n", m, n, fines));
                }
                for (b, copies) in &books {
                    let n = loans.iter().filter(|l| &l.book == b).count();
                    out.push_str(&format!("{} copies={} out={} holds={}\n", b, copies, n, holds[b].len()));
                }
                continue;
            }
            _ => {}
        }
        if c != "hold" && !is_digits(t[t.len() - 1]) {
            out.push_str("error: bad day\n");
            continue;
        }
        if c == "overdue" {
            let day: i64 = t[1].parse().unwrap();
            let mut rows: Vec<&Loan> = loans.iter().filter(|l| day > l.due).collect();
            rows.sort_by(|x, y| (&x.member, &x.book).cmp(&(&y.member, &y.book)));
            if rows.is_empty() {
                out.push_str("none\n");
            }
            for l in rows {
                out.push_str(&format!("{} {} late={}\n", l.member, l.book, day - l.due));
            }
            continue;
        }
        let (m, b) = (t[1], t[2]);
        if !members.contains_key(m) {
            out.push_str(&format!("error: unknown member {}\n", m));
            continue;
        }
        if !books.contains_key(b) {
            out.push_str(&format!("error: unknown book {}\n", b));
            continue;
        }
        let avail = books[b] - loans.iter().filter(|l| l.book == b).count() as i64;
        let li = loans.iter().position(|l| l.member == m && l.book == b);
        let q = holds.get_mut(b).unwrap();
        let qpos = q.iter().position(|x| x == m);
        match c {
            "checkout" => {
                let day: i64 = t[3].parse().unwrap();
                if li.is_some() {
                    out.push_str("error: already borrowed\n");
                } else if loans.iter().filter(|l| l.member == m).count() >= 3 {
                    out.push_str("error: loan limit reached\n");
                } else if loans.iter().any(|l| l.member == m && day > l.due) {
                    out.push_str("error: has overdue loans\n");
                } else if avail <= 0 {
                    out.push_str("error: no copies available\n");
                } else {
                    let allowed = match qpos {
                        Some(p) => (p as i64) < avail,
                        None => avail > q.len() as i64,
                    };
                    if !allowed {
                        out.push_str("error: reserved for holds\n");
                    } else {
                        if let Some(p) = qpos {
                            q.remove(p);
                        }
                        loans.push(Loan { member: m.to_string(), book: b.to_string(), due: day + 14, renewals: 0 });
                        out.push_str(&format!("ok due={}\n", day + 14));
                    }
                }
            }
            "return" => {
                let day: i64 = t[3].parse().unwrap();
                match li {
                    None => out.push_str("error: not borrowed\n"),
                    Some(i) => {
                        let fine = 10 * (day - loans[i].due).max(0);
                        loans.remove(i);
                        *members.get_mut(m).unwrap() += fine;
                        out.push_str(&format!("ok fine={}\n", fine));
                    }
                }
            }
            "renew" => {
                let day: i64 = t[3].parse().unwrap();
                match li {
                    None => out.push_str("error: not borrowed\n"),
                    Some(i) => {
                        if day > loans[i].due {
                            out.push_str("error: overdue\n");
                        } else if loans[i].renewals >= 2 {
                            out.push_str("error: renewal limit\n");
                        } else if !q.is_empty() {
                            out.push_str("error: held by others\n");
                        } else {
                            loans[i].due += 14;
                            loans[i].renewals += 1;
                            out.push_str(&format!("ok due={}\n", loans[i].due));
                        }
                    }
                }
            }
            _ => {
                if li.is_some() {
                    out.push_str("error: already borrowed\n");
                } else if qpos.is_some() {
                    out.push_str("error: already on hold\n");
                } else if avail > q.len() as i64 {
                    out.push_str("error: copies available\n");
                } else {
                    q.push(m.to_string());
                    out.push_str(&format!("ok position={}\n", q.len()));
                }
            }
        }
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
