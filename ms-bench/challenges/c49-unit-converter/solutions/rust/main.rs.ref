use std::collections::{HashMap, HashSet};
use std::io::{self, Read, Write};

#[derive(Clone)]
struct Unit {
    dim: &'static str,
    f: i64,
}

struct State {
    units: HashMap<String, Unit>,
    user: HashSet<String>,
}

fn round_div(n: i64, d: i64) -> i64 {
    let q = (2 * n.abs() + d) / (2 * d);
    if n < 0 {
        -q
    } else {
        q
    }
}

fn fmt_milli(m: i64) -> String {
    if m == 0 {
        return "0".to_string();
    }
    let sign = if m < 0 { "-" } else { "" };
    let a = m.abs();
    let (whole, frac) = (a / 1000, a % 1000);
    if frac == 0 {
        return format!("{}{}", sign, whole);
    }
    let f = format!("{:03}", frac);
    format!("{}{}.{}", sign, whole, f.trim_end_matches('0'))
}

fn is_digits(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|c| c.is_ascii_digit())
}

fn parse_num(t: &str) -> Option<i64> {
    let (neg, s) = match t.strip_prefix('-') {
        Some(r) => (true, r),
        None => (false, t),
    };
    let (whole, frac) = match s.find('.') {
        Some(i) => {
            let fr = &s[i + 1..];
            if fr.is_empty() || fr.len() > 3 || !is_digits(fr) {
                return None;
            }
            (&s[..i], fr.to_string())
        }
        None => (s, String::new()),
    };
    if !is_digits(whole) {
        return None;
    }
    let w: i64 = whole.parse().ok()?;
    let mut fr = frac;
    while fr.len() < 3 {
        fr.push('0');
    }
    let f: i64 = fr.parse().ok()?;
    let v = w * 1000 + f;
    Some(if neg { -v } else { v })
}

fn to_c(u: &str, sv: i64) -> (i64, i64) {
    match u {
        "c" => (sv, 1),
        "f" => ((sv - 32000) * 5, 9),
        _ => (sv - 273150, 1),
    }
}

fn from_c(u: &str, cn: i64, cd: i64) -> i64 {
    match u {
        "c" => round_div(cn, cd),
        "f" => round_div(cn * 9 + 32000 * 5 * cd, 5 * cd),
        _ => round_div(cn + 273150 * cd, cd),
    }
}

fn valid_name(s: &str) -> bool {
    let b = s.as_bytes();
    !b.is_empty()
        && b[0].is_ascii_lowercase()
        && b[1..].iter().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || *c == b'_')
}

impl State {
    fn define(&mut self, t: &[&str]) -> String {
        if t.len() != 5 || t[2] != "=" {
            return "error: syntax".into();
        }
        let (name, v, u) = (t[1], t[3], t[4]);
        if !valid_name(name) {
            return format!("error: bad name {}", name);
        }
        if self.units.contains_key(name) {
            return format!("error: unit exists {}", name);
        }
        let n = if is_digits(v) { v.parse::<i64>().unwrap_or(0) } else { 0 };
        if n < 1 || n > 1000 {
            return format!("error: bad number {}", v);
        }
        if self.user.contains(u) {
            return format!("error: not a builtin unit {}", u);
        }
        let base = match self.units.get(u) {
            Some(b) => b.clone(),
            None => return format!("error: unknown unit {}", u),
        };
        if base.dim == "temperature" {
            return "error: cannot define temperature unit".into();
        }
        self.units.insert(name.to_string(), Unit { dim: base.dim, f: n * base.f });
        self.user.insert(name.to_string());
        "ok".into()
    }

    fn two_unit(&self, cmd: &str, t: &[&str]) -> String {
        if t.len() != 5 || (cmd == "convert" && t[3] != "to") {
            return "error: syntax".into();
        }
        let num_toks: Vec<&str> = if cmd == "convert" { vec![t[1]] } else { vec![t[1], t[3]] };
        let unit_toks = [t[2], t[4]];
        let mut vals = Vec::new();
        for x in &num_toks {
            match parse_num(x) {
                Some(v) => vals.push(v),
                None => return format!("error: bad number {}", x),
            }
        }
        for u in &unit_toks {
            if !self.units.contains_key(*u) {
                return format!("error: unknown unit {}", u);
            }
        }
        if vals.iter().any(|v| v.abs() > 100_000_000) {
            return "error: out of range".into();
        }
        let (fu, tu) = (unit_toks[0], unit_toks[1]);
        let (a, b) = (&self.units[fu], &self.units[tu]);
        if a.dim != b.dim {
            return format!("error: dimension mismatch {} vs {}", a.dim, b.dim);
        }
        let temp = a.dim == "temperature";
        let below = |cn: i64, cd: i64| cn < -273150 * cd;
        if cmd == "convert" {
            let v = vals[0];
            let r = if temp {
                let (cn, cd) = to_c(fu, v);
                if below(cn, cd) {
                    return "error: below absolute zero".into();
                }
                from_c(tu, cn, cd)
            } else {
                round_div(v * a.f, b.f)
            };
            return format!("{} {} = {} {}", fmt_milli(v), fu, fmt_milli(r), tu);
        }
        let (v1, v2) = (vals[0], vals[1]);
        let (x, y) = if temp {
            let (an, ad) = to_c(fu, v1);
            let (bn, bd) = to_c(tu, v2);
            if below(an, ad) || below(bn, bd) {
                return "error: below absolute zero".into();
            }
            (an * bd, bn * ad)
        } else {
            (v1 * a.f, v2 * b.f)
        };
        let rel = if x < y {
            "<"
        } else if x > y {
            ">"
        } else {
            "="
        };
        format!("{} {} {} {} {}", fmt_milli(v1), fu, rel, fmt_milli(v2), tu)
    }
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut st = State { units: HashMap::new(), user: HashSet::new() };
    let table: [(&'static str, &[(&str, i64)]); 5] = [
        ("length", &[("mm", 10), ("cm", 100), ("m", 10000), ("km", 10000000), ("in", 254), ("ft", 3048), ("yd", 9144), ("mi", 16093440)]),
        ("mass", &[("mg", 1), ("g", 1000), ("kg", 1000000), ("oz", 28350), ("lb", 453592)]),
        ("time", &[("ms", 1), ("s", 1000), ("min", 60000), ("h", 3600000), ("d", 86400000)]),
        ("volume", &[("ml", 1), ("l", 1000), ("tsp", 5), ("tbsp", 15), ("cup", 240), ("gal", 3785)]),
        ("temperature", &[("c", 0), ("f", 0), ("k", 0)]),
    ];
    for (dim, us) in table.iter() {
        for (n, f) in us.iter() {
            st.units.insert(n.to_string(), Unit { dim, f: *f });
        }
    }
    let mut out = String::new();
    for line in input.split('\n') {
        let t: Vec<&str> = line.split(|c| c == ' ' || c == '\t').filter(|x| !x.is_empty()).collect();
        if t.is_empty() {
            continue;
        }
        let r = match t[0] {
            "define" => st.define(&t),
            "convert" | "compare" => st.two_unit(t[0], &t),
            _ => "error: syntax".to_string(),
        };
        out.push_str(&r);
        out.push('\n');
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
