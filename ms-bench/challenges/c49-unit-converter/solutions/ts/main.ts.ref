import * as fs from "node:fs";

type Unit = { dim: string; f: bigint };

const TABLE: Record<string, [string, number]> = {
  mm: ["length", 10], cm: ["length", 100], m: ["length", 10000], km: ["length", 10000000],
  in: ["length", 254], ft: ["length", 3048], yd: ["length", 9144], mi: ["length", 16093440],
  mg: ["mass", 1], g: ["mass", 1000], kg: ["mass", 1000000], oz: ["mass", 28350], lb: ["mass", 453592],
  ms: ["time", 1], s: ["time", 1000], min: ["time", 60000], h: ["time", 3600000], d: ["time", 86400000],
  ml: ["volume", 1], l: ["volume", 1000], tsp: ["volume", 5], tbsp: ["volume", 15], cup: ["volume", 240], gal: ["volume", 3785],
  c: ["temperature", 0], f: ["temperature", 0], k: ["temperature", 0],
};

const units = new Map<string, Unit>();
for (const [name, [dim, f]] of Object.entries(TABLE)) units.set(name, { dim, f: BigInt(f) });
const user = new Set<string>();

function roundDiv(n: bigint, d: bigint): bigint {
  const a = n < 0n ? -n : n;
  const q = (2n * a + d) / (2n * d);
  return n < 0n ? -q : q;
}

function fmt(m: bigint): string {
  if (m === 0n) return "0";
  const sign = m < 0n ? "-" : "";
  const a = m < 0n ? -m : m;
  const whole = a / 1000n;
  const frac = a % 1000n;
  if (frac === 0n) return `${sign}${whole}`;
  return `${sign}${whole}.${frac.toString().padStart(3, "0").replace(/0+$/, "")}`;
}

function parseNum(t: string): bigint | null {
  const m = /^(-?)([0-9]+)(?:\.([0-9]{1,3}))?$/.exec(t);
  if (!m) return null;
  const frac = m[3] ? m[3].padEnd(3, "0") : "000";
  const v = BigInt(m[2]) * 1000n + BigInt(frac);
  return m[1] ? -v : v;
}

function toC(u: string, sv: bigint): [bigint, bigint] {
  if (u === "c") return [sv, 1n];
  if (u === "f") return [(sv - 32000n) * 5n, 9n];
  return [sv - 273150n, 1n];
}

function fromC(u: string, cn: bigint, cd: bigint): bigint {
  if (u === "c") return roundDiv(cn, cd);
  if (u === "f") return roundDiv(cn * 9n + 32000n * 5n * cd, 5n * cd);
  return roundDiv(cn + 273150n * cd, cd);
}

const LIMIT = 100000000n;

function define(t: string[]): string {
  if (t.length !== 5 || t[2] !== "=") return "error: syntax";
  const [, name, , v, u] = t;
  if (!/^[a-z][a-z0-9_]*$/.test(name)) return `error: bad name ${name}`;
  if (units.has(name)) return `error: unit exists ${name}`;
  if (!/^[0-9]+$/.test(v) || BigInt(v) < 1n || BigInt(v) > 1000n) return `error: bad number ${v}`;
  if (user.has(u)) return `error: not a builtin unit ${u}`;
  const base = units.get(u);
  if (base === undefined) return `error: unknown unit ${u}`;
  if (base.dim === "temperature") return "error: cannot define temperature unit";
  units.set(name, { dim: base.dim, f: BigInt(v) * base.f });
  user.add(name);
  return "ok";
}

function twoUnit(cmd: string, t: string[]): string {
  if (t.length !== 5 || (cmd === "convert" && t[3] !== "to")) return "error: syntax";
  const numToks = cmd === "convert" ? [t[1]] : [t[1], t[3]];
  const unitToks = [t[2], t[4]];
  const vals: bigint[] = [];
  for (const x of numToks) {
    const v = parseNum(x);
    if (v === null) return `error: bad number ${x}`;
    vals.push(v);
  }
  for (const u of unitToks) if (!units.has(u)) return `error: unknown unit ${u}`;
  for (const v of vals) if ((v < 0n ? -v : v) > LIMIT) return "error: out of range";
  const [fu, tu] = unitToks;
  const a = units.get(fu)!;
  const b = units.get(tu)!;
  if (a.dim !== b.dim) return `error: dimension mismatch ${a.dim} vs ${b.dim}`;
  const temp = a.dim === "temperature";
  const below = (cn: bigint, cd: bigint) => cn < -273150n * cd;
  if (cmd === "convert") {
    const v = vals[0];
    let r: bigint;
    if (temp) {
      const [cn, cd] = toC(fu, v);
      if (below(cn, cd)) return "error: below absolute zero";
      r = fromC(tu, cn, cd);
    } else {
      r = roundDiv(v * a.f, b.f);
    }
    return `${fmt(v)} ${fu} = ${fmt(r)} ${tu}`;
  }
  const [v1, v2] = vals;
  let x: bigint;
  let y: bigint;
  if (temp) {
    const [an, ad] = toC(fu, v1);
    const [bn, bd] = toC(tu, v2);
    if (below(an, ad) || below(bn, bd)) return "error: below absolute zero";
    x = an * bd;
    y = bn * ad;
  } else {
    x = v1 * a.f;
    y = v2 * b.f;
  }
  const rel = x < y ? "<" : x > y ? ">" : "=";
  return `${fmt(v1)} ${fu} ${rel} ${fmt(v2)} ${tu}`;
}

const out: string[] = [];
for (const line of fs.readFileSync(0, "utf8").split("\n")) {
  const t = line.split(/[ \t]+/).filter((x) => x !== "");
  if (t.length === 0) continue;
  if (t[0] === "define") out.push(define(t));
  else if (t[0] === "convert" || t[0] === "compare") out.push(twoUnit(t[0], t));
  else out.push("error: syntax");
}
process.stdout.write(out.map((l) => l + "\n").join(""));
