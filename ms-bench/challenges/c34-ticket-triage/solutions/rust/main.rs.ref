use std::collections::{BTreeMap, HashMap, HashSet};
use std::io::{self, Read, Write};

fn trim(s: &str) -> &str {
    s.trim_matches(|c| c == ' ' || c == '\t')
}

fn is_blank(c: char) -> bool {
    c == ' ' || c == '\t'
}

fn digits(s: &str, max: usize) -> bool {
    !s.is_empty() && s.len() <= max && s.bytes().all(|c| c.is_ascii_digit())
}

fn alnum(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit())
}

struct Route {
    word: String,
    queue: String,
    prio: i64,
}

struct Raw {
    id: String,
    reporter: String,
    subject: String,
    body: String,
    created: i64,
}

struct Entry {
    id: String,
    subject: String,
    prio: i64,
    created: i64,
    merged: usize,
}

fn normalise(subject: &str) -> String {
    let mut s = subject.to_lowercase();
    loop {
        s = s.trim_start_matches(is_blank).to_string();
        if let Some(r) = s.strip_prefix("re:") {
            s = r.to_string();
        } else if let Some(r) = s.strip_prefix("fwd:") {
            s = r.to_string();
        } else {
            break;
        }
    }
    s.split(is_blank).filter(|x| !x.is_empty()).collect::<Vec<_>>().join(" ")
}

fn tokens(s: &str) -> HashSet<String> {
    s.split(|c: char| !(c.is_ascii_lowercase() || c.is_ascii_digit()))
        .filter(|x| !x.is_empty())
        .map(|x| x.to_string())
        .collect()
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut lines: Vec<&str> = input.split('\n').collect();
    if lines.last() == Some(&"") {
        lines.pop();
    }
    let mut section = ' ';
    let mut now: i64 = 0;
    let mut vips: HashSet<String> = HashSet::new();
    let mut routes: Vec<Route> = Vec::new();
    let mut problems: Vec<String> = Vec::new();
    let mut ids: HashSet<String> = HashSet::new();
    let mut raws: Vec<Raw> = Vec::new();
    for (idx, line) in lines.iter().enumerate() {
        let n = idx + 1;
        let l = trim(line);
        if l.is_empty() || l.starts_with('#') {
            continue;
        }
        if l.starts_with('[') {
            match l {
                "[rules]" => section = 'r',
                "[tickets]" => section = 't',
                _ => {
                    section = ' ';
                    problems.push(format!("line {}: unknown section", n));
                }
            }
            continue;
        }
        if section == 'r' {
            let t: Vec<&str> = l.split(is_blank).filter(|x| !x.is_empty()).collect();
            if t[0] == "now" && t.len() == 2 && digits(t[1], 9) {
                now = t[1].parse().unwrap();
            } else if t[0] == "vip" && t.len() == 2 {
                vips.insert(t[1].to_lowercase());
            } else if t[0] == "route" && t.len() == 4 && alnum(&t[1].to_lowercase()) && matches!(t[3], "1" | "2" | "3" | "4" | "5") {
                routes.push(Route { word: t[1].to_lowercase(), queue: t[2].to_string(), prio: t[3].parse().unwrap() });
            } else {
                problems.push(format!("line {}: bad rule", n));
            }
        } else if section == 't' {
            let p: Vec<&str> = l.splitn(5, '|').map(trim).collect();
            if p.len() < 5 || p[0].is_empty() || p[0].contains(is_blank) || p[1].is_empty() || !digits(p[2], 9) || p[3].is_empty() {
                problems.push(format!("line {}: bad ticket", n));
                continue;
            }
            if !ids.insert(p[0].to_string()) {
                problems.push(format!("line {}: duplicate id", n));
                continue;
            }
            raws.push(Raw {
                id: p[0].to_string(),
                reporter: p[1].to_string(),
                subject: p[3].to_string(),
                body: p[4].to_string(),
                created: p[2].parse().unwrap(),
            });
        }
    }
    // Entries live in `entries`; queues and the duplicate index refer to them by position.
    let mut entries: Vec<Entry> = Vec::new();
    let mut queues: BTreeMap<String, Vec<usize>> = BTreeMap::new();
    let mut by_key: HashMap<String, usize> = HashMap::new();
    let mut merged = 0;
    for t in &raws {
        let key = format!("{}\u{0}{}", t.reporter.to_lowercase(), normalise(&t.subject));
        if let Some(&i) = by_key.get(&key) {
            entries[i].merged += 1;
            merged += 1;
            continue;
        }
        let toks = tokens(&format!("{} {}", t.subject, t.body).to_lowercase());
        let (mut queue, mut prio) = ("general".to_string(), 3);
        for r in &routes {
            if toks.contains(&r.word) {
                queue = r.queue.clone();
                prio = r.prio;
                break;
            }
        }
        if vips.contains(&t.reporter.to_lowercase()) {
            prio = (prio - 1).max(1);
        }
        if now - t.created >= 1440 {
            prio = (prio - 1).max(1);
        }
        entries.push(Entry { id: t.id.clone(), subject: t.subject.clone(), prio, created: t.created, merged: 0 });
        by_key.insert(key, entries.len() - 1);
        queues.entry(queue).or_default().push(entries.len() - 1);
    }
    let mut out = String::new();
    let mut listed = 0;
    for (q, idxs) in queues.iter_mut() {
        idxs.sort_by(|&a, &b| {
            let (x, y) = (&entries[a], &entries[b]);
            x.prio.cmp(&y.prio).then(x.created.cmp(&y.created)).then(x.id.cmp(&y.id))
        });
        listed += idxs.len();
        out.push_str(&format!("queue {} ({})\n", q, idxs.len()));
        for &i in idxs.iter() {
            let e = &entries[i];
            out.push_str(&format!("  {} P{} {}", e.id, e.prio, e.subject));
            if e.merged > 0 {
                out.push_str(&format!(" (+{} merged)", e.merged));
            }
            out.push('\n');
        }
    }
    out.push_str(&format!("summary: tickets={} merged={} problems={}\n", listed, merged, problems.len()));
    if !problems.is_empty() {
        out.push_str("problems:\n");
        for p in &problems {
            out.push_str(&format!("  {}\n", p));
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
