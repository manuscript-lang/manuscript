import {stdin, stdout, read_all} from "@std/io.ms"
import Set from "@std/collections.ms"

type Route:
    word: String
    queue: String
    prio: Int

type Raw:
    id: String
    reporter: String
    subject: String
    body: String
    created: Int

type Entry:
    id: String
    subject: String
    prio: Int
    created: Int
    merged: Int

fn is_blank(c: Int) -> Bool:
    return c == 32 or c == 9

fn trim_blanks(s: String) -> String:
    let codes = s.scalar_values()
    var start = 0
    var end = codes.length()
    while start < end and is_blank(codes.at(start).unwrap()):
        start = start + 1
    while end > start and is_blank(codes.at(end - 1).unwrap()):
        end = end - 1
    return s.slice(start, end)

# Splits on runs of spaces and tabs, dropping empty pieces.
fn words(s: String) -> List[String]:
    let out = List[String]()
    var cur = List[String]()
    for ch in s.chars():
        let code = ch.scalar_values().at(0).unwrap()
        if is_blank(code):
            if not cur.is_empty():
                out.append(cur.join(""))
                cur = List[String]()
        else:
            cur.append(ch)
    if not cur.is_empty():
        out.append(cur.join(""))
    return out

fn digits(s: String, max: Int) -> Bool:
    if s.is_empty() or s.length() > max:
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn alnum(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        if not ((c >= 97 and c <= 122) or (c >= 48 and c <= 57)):
            return false
    return true

fn has_blank(s: String) -> Bool:
    for c in s.scalar_values():
        if is_blank(c):
            return true
    return false

fn normalise(subject: String) -> String:
    var s = subject.lower()
    while true:
        s = s.trim_start()
        if s.starts_with("re:"):
            s = s.slice(3, s.length())
        else if s.starts_with("fwd:"):
            s = s.slice(4, s.length())
        else:
            break
    return words(s).join(" ")

fn token_set(s: String) -> Set[String]:
    let set = Set[String]()
    var cur = List[String]()
    for ch in "{s} ".chars():
        let code = ch.scalar_values().at(0).unwrap()
        if (code >= 97 and code <= 122) or (code >= 48 and code <= 57):
            cur.append(ch)
        else if not cur.is_empty():
            set.add(cur.join(""))
            cur = List[String]()
    return set

# Splits at most four times so the fifth part keeps any further `|`.
fn split_ticket(l: String) -> List[String]:
    let parts = List[String]()
    var rest = l
    while parts.length() < 4:
        let bar = rest.index_of("|")
        if bar.is_none():
            break
        parts.append(rest.slice(0, bar.unwrap()))
        rest = rest.slice(bar.unwrap() + 1, rest.length())
    parts.append(rest)
    return parts

fn by_text(left: String, right: String) -> Int:
    return left.compare(right)

fn by_urgency(left: Entry, right: Entry) -> Int:
    if left.prio != right.prio:
        return left.prio - right.prio
    if left.created != right.created:
        return left.created - right.created
    return left.id.compare(right.id)

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let lines = data.to_text().unwrap_or("").split("\n")
    if lines.length() > 0 and lines.at(lines.length() - 1).unwrap().is_empty():
        lines.remove(lines.length() - 1)
    var section = ""
    var now = 0
    let vips = Set[String]()
    let routes = List[Route]()
    let problems = List[String]()
    let ids = Set[String]()
    let raws = List[Raw]()
    var idx = 0
    while idx < lines.length():
        let l = trim_blanks(lines.at(idx).unwrap())
        idx = idx + 1
        let n = idx
        if l.is_empty() or l.starts_with("#"):
            continue
        if l.starts_with("["):
            if l == "[rules]":
                section = "r"
            else if l == "[tickets]":
                section = "t"
            else:
                section = ""
                problems.append("line {n}: unknown section")
            continue
        if section == "r":
            let t = words(l)
            let head = t.at(0).unwrap()
            if head == "now" and t.length() == 2 and digits(t.at(1).unwrap(), 9):
                now = t.at(1).unwrap().parse_int().unwrap()
            else if head == "vip" and t.length() == 2:
                vips.add(t.at(1).unwrap().lower())
            else if head == "route" and t.length() == 4 and alnum(t.at(1).unwrap().lower()) and t.at(3).unwrap().length() == 1 and t.at(3).unwrap() >= "1" and t.at(3).unwrap() <= "5":
                routes.append(Route(word: t.at(1).unwrap().lower(), queue: t.at(2).unwrap(), prio: t.at(3).unwrap().parse_int().unwrap()))
            else:
                problems.append("line {n}: bad rule")
        else if section == "t":
            let raw_parts = split_ticket(l)
            let p = List[String]()
            for part in raw_parts:
                p.append(trim_blanks(part))
            if p.length() < 5 or p.at(0).unwrap().is_empty() or has_blank(p.at(0).unwrap()) or p.at(1).unwrap().is_empty() or not digits(p.at(2).unwrap(), 9) or p.at(3).unwrap().is_empty():
                problems.append("line {n}: bad ticket")
                continue
            if ids.contains(p.at(0).unwrap()):
                problems.append("line {n}: duplicate id")
                continue
            ids.add(p.at(0).unwrap())
            raws.append(Raw(id: p.at(0).unwrap(), reporter: p.at(1).unwrap(), subject: p.at(3).unwrap(), body: p.at(4).unwrap(), created: p.at(2).unwrap().parse_int().unwrap()))
    let queues = Map[String, List[Entry]]()
    let by_key = Map[String, Entry]()
    var merged = 0
    for t in raws:
        let key = "{t.reporter.lower()}|{normalise(t.subject)}"
        let existing = by_key.get(key)
        if existing.is_some():
            let e = existing.unwrap()
            e.merged = e.merged + 1
            merged = merged + 1
            continue
        let toks = token_set("{t.subject} {t.body}".lower())
        var queue = "general"
        var prio = 3
        for r in routes:
            if toks.contains(r.word):
                queue = r.queue
                prio = r.prio
                break
        if vips.contains(t.reporter.lower()) and prio > 1:
            prio = prio - 1
        if now - t.created >= 1440 and prio > 1:
            prio = prio - 1
        let e = Entry(id: t.id, subject: t.subject, prio: prio, created: t.created, merged: 0)
        by_key.add(key: key, value: e)
        if not queues.contains(queue):
            queues.add(key: queue, value: List[Entry]())
        queues.get(queue).unwrap().append(e)
    let out = List[String]()
    var listed = 0
    for q in queues.keys().sorted(compare: by_text):
        let es = queues.get(q).unwrap().sorted(compare: by_urgency)
        listed = listed + es.length()
        out.append("queue {q} ({es.length()})")
        for e in es:
            var suffix = ""
            if e.merged > 0:
                suffix = " (+{e.merged} merged)"
            out.append("  {e.id} P{e.prio} {e.subject}{suffix}")
    out.append("summary: tickets={listed} merged={merged} problems={problems.length()}")
    if problems.length() > 0:
        out.append("problems:")
        for p in problems:
            out.append("  {p}")
    try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
