import { readFileSync } from "node:fs";

const trim = (s: string) => s.replace(/^[ \t]+|[ \t]+$/g, "");
const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
const digits = (s: string, max: number) => /^[0-9]+$/.test(s) && s.length <= max;

type Route = { word: string; queue: string; prio: number };
type Raw = { id: string; reporter: string; created: number; subject: string; body: string };
type Entry = { id: string; prio: number; created: number; subject: string; merged: number };

function normalise(subject: string): string {
  let s = subject.toLowerCase();
  for (;;) {
    s = s.replace(/^[ \t]+/, "");
    if (s.startsWith("re:")) s = s.slice(3);
    else if (s.startsWith("fwd:")) s = s.slice(4);
    else break;
  }
  return s.split(/[ \t]+/).filter((x) => x !== "").join(" ");
}

const lines = readFileSync(0, "utf8").split("\n");
if (lines[lines.length - 1] === "") lines.pop();
let section: "r" | "t" | null = null;
let now = 0;
const vips = new Set<string>();
const routes: Route[] = [];
const problems: string[] = [];
const ids = new Set<string>();
const raws: Raw[] = [];
lines.forEach((raw, idx) => {
  const n = idx + 1;
  const l = trim(raw);
  if (l === "" || l[0] === "#") return;
  if (l[0] === "[") {
    if (l === "[rules]") section = "r";
    else if (l === "[tickets]") section = "t";
    else { section = null; problems.push(`line ${n}: unknown section`); }
    return;
  }
  if (section === "r") {
    const t = l.split(/[ \t]+/);
    if (t[0] === "now" && t.length === 2 && digits(t[1], 9)) now = parseInt(t[1], 10);
    else if (t[0] === "vip" && t.length === 2) vips.add(t[1].toLowerCase());
    else if (t[0] === "route" && t.length === 4 && /^[a-z0-9]+$/.test(t[1].toLowerCase()) && /^[1-5]$/.test(t[3])) {
      routes.push({ word: t[1].toLowerCase(), queue: t[2], prio: parseInt(t[3], 10) });
    } else problems.push(`line ${n}: bad rule`);
  } else if (section === "t") {
    const parts: string[] = [];
    let rest = l;
    while (parts.length < 4) {
      const bar = rest.indexOf("|");
      if (bar < 0) break;
      parts.push(rest.slice(0, bar));
      rest = rest.slice(bar + 1);
    }
    parts.push(rest);
    const p = parts.map(trim);
    if (p.length < 5 || p[0] === "" || /[ \t]/.test(p[0]) || p[1] === "" || !digits(p[2], 9) || p[3] === "") {
      problems.push(`line ${n}: bad ticket`);
      return;
    }
    if (ids.has(p[0])) { problems.push(`line ${n}: duplicate id`); return; }
    ids.add(p[0]);
    raws.push({ id: p[0], reporter: p[1], created: parseInt(p[2], 10), subject: p[3], body: p[4] });
  }
});

const queues = new Map<string, Entry[]>();
const byKey = new Map<string, Entry>();
let merged = 0;
for (const t of raws) {
  const key = t.reporter.toLowerCase() + "\u0000" + normalise(t.subject);
  const existing = byKey.get(key);
  if (existing) { existing.merged++; merged++; continue; }
  const tokens = new Set((t.subject + " " + t.body).toLowerCase().match(/[a-z0-9]+/g) ?? []);
  let queue = "general";
  let prio = 3;
  for (const r of routes) if (tokens.has(r.word)) { queue = r.queue; prio = r.prio; break; }
  if (vips.has(t.reporter.toLowerCase())) prio = Math.max(1, prio - 1);
  if (now - t.created >= 1440) prio = Math.max(1, prio - 1);
  const e: Entry = { id: t.id, prio, created: t.created, subject: t.subject, merged: 0 };
  byKey.set(key, e);
  if (!queues.has(queue)) queues.set(queue, []);
  queues.get(queue)!.push(e);
}

const out: string[] = [];
let listed = 0;
for (const q of [...queues.keys()].sort(cmp)) {
  const es = queues.get(q)!.sort((a, b) => a.prio - b.prio || a.created - b.created || cmp(a.id, b.id));
  listed += es.length;
  out.push(`queue ${q} (${es.length})`);
  for (const e of es) out.push(`  ${e.id} P${e.prio} ${e.subject}` + (e.merged > 0 ? ` (+${e.merged} merged)` : ""));
}
out.push(`summary: tickets=${listed} merged=${merged} problems=${problems.length}`);
if (problems.length > 0) out.push("problems:", ...problems.map((p) => "  " + p));
process.stdout.write(out.map((l) => l + "\n").join(""));
