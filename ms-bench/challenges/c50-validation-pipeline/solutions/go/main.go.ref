package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strconv"
	"strings"
)

type step struct {
	w     string
	t     []string
	label string
}

var kinds = map[string]string{
	"trim": "f", "lower": "f", "default": "ft", "required": "f", "int": "fii", "len": "fnn",
	"oneof": "ft", "pattern": "ft", "unique": "f", "less": "ff", "needs": "ftf",
}

func wsSplit(l string) []string {
	return strings.FieldsFunc(l, func(r rune) bool { return r == ' ' || r == '\t' })
}

func isName(s string) bool {
	if s == "" || !(s[0] == '_' || (s[0] >= 'a' && s[0] <= 'z')) {
		return false
	}
	for i := 1; i < len(s); i++ {
		c := s[i]
		if !(c == '_' || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')) {
			return false
		}
	}
	return true
}

func isNonNeg(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

func isInt(s string) bool { return isNonNeg(strings.TrimPrefix(s, "-")) }

func toInt(s string) int64 { v, _ := strconv.ParseInt(s, 10, 64); return v }

func glob(mask, s string) bool {
	m, n := len(mask), len(s)
	prev := make([]bool, n+1)
	prev[0] = true
	for i := 1; i <= m; i++ {
		c := mask[i-1]
		cur := make([]bool, n+1)
		for j := 0; j <= n; j++ {
			switch {
			case c == '*':
				cur[j] = prev[j] || (j > 0 && cur[j-1])
			case j == 0:
				cur[j] = false
			default:
				ch := s[j-1]
				var good bool
				switch c {
				case '9':
					good = ch >= '0' && ch <= '9'
				case 'a':
					good = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z')
				default:
					good = ch == c
				}
				cur[j] = prev[j-1] && good
			}
		}
		prev = cur
	}
	return prev[n]
}

var seen = map[string]map[string]int{}

func runStep(st step, rec map[string]string) string {
	t := st.t
	f := t[1]
	v, has := rec[f]
	switch st.w {
	case "trim":
		if has {
			rec[f] = strings.Trim(v, " \t")
		}
	case "lower":
		if has {
			rec[f] = strings.Map(func(r rune) rune {
				if r >= 'A' && r <= 'Z' {
					return r + 32
				}
				return r
			}, v)
		}
	case "default":
		if !has || v == "" {
			rec[f] = t[2]
		}
	case "required":
		if !has || v == "" {
			return f + " is required"
		}
	case "int":
		if !has {
			return ""
		}
		if !isInt(v) {
			return f + " is not an integer"
		}
		lo, hi := toInt(t[2]), toInt(t[3])
		if x := toInt(v); x < lo || x > hi {
			return fmt.Sprintf("%s out of range %d..%d", f, lo, hi)
		}
	case "len":
		if !has {
			return ""
		}
		lo, hi := toInt(t[2]), toInt(t[3])
		if l := int64(len(v)); l < lo || l > hi {
			return fmt.Sprintf("%s length out of range %d..%d", f, lo, hi)
		}
	case "oneof":
		if !has {
			return ""
		}
		for _, o := range strings.Split(t[2], "|") {
			if o == v {
				return ""
			}
		}
		return fmt.Sprintf("%s not one of %s", f, t[2])
	case "pattern":
		if has && !glob(t[2], v) {
			return fmt.Sprintf("%s does not match %s", f, t[2])
		}
	case "unique":
		if has {
			if k, ok := seen[f][v]; ok {
				return fmt.Sprintf("%s duplicates record %d", f, k)
			}
		}
	case "less":
		a, okA := rec[t[1]]
		b, okB := rec[t[2]]
		if !okA || !okB {
			return ""
		}
		if !isInt(a) {
			return t[1] + " is not an integer"
		}
		if !isInt(b) {
			return t[2] + " is not an integer"
		}
		if !(toInt(a) < toInt(b)) {
			return fmt.Sprintf("%s must be less than %s", t[1], t[2])
		}
	case "needs":
		if !has || v != t[2] {
			return ""
		}
		if o, ok := rec[t[3]]; !ok || o == "" {
			return fmt.Sprintf("%s is required when %s=%s", t[3], f, t[2])
		}
	}
	return ""
}

func parseRecord(line string) (map[string]string, string) {
	rec := map[string]string{}
	for _, piece := range strings.Split(line, ",") {
		i := strings.IndexByte(piece, '=')
		if i < 0 || !isName(piece[:i]) {
			return nil, fmt.Sprintf("bad field '%s'", piece)
		}
		k := piece[:i]
		if _, dup := rec[k]; dup {
			return nil, "duplicate key " + k
		}
		rec[k] = piece[i+1:]
	}
	return rec, ""
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	var lines []string
	for sc.Scan() {
		lines = append(lines, sc.Text())
	}
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	sep := -1
	for i, l := range lines {
		if strings.Trim(l, " \t") == "---" {
			sep = i
			break
		}
	}
	stepLines, recLines := lines, []string(nil)
	if sep >= 0 {
		stepLines, recLines = lines[:sep], lines[sep+1:]
	}
	var steps []step
	for i, l := range stepLines {
		t := wsSplit(l)
		if len(t) == 0 {
			continue
		}
		w := t[0]
		ks, known := kinds[w]
		if !known {
			fmt.Fprintf(out, "pipeline error: line %d: unknown step %s\n", i+1, w)
			return
		}
		ok := len(t) == 1+len(ks)
		if ok {
			for k := 0; k < len(ks); k++ {
				a := t[k+1]
				if (ks[k] == 'f' && !isName(a)) || (ks[k] == 'i' && !isInt(a)) || (ks[k] == 'n' && !isNonNeg(a)) {
					ok = false
				}
			}
			if ok && (w == "int" || w == "len") && toInt(t[2]) > toInt(t[3]) {
				ok = false
			}
		}
		if !ok {
			fmt.Fprintf(out, "pipeline error: line %d: bad arguments for %s\n", i+1, w)
			return
		}
		steps = append(steps, step{w, t, strings.Join(t, " ")})
	}
	fails := make([]int, len(steps))
	var uniq []string
	for _, st := range steps {
		if st.w == "unique" {
			uniq = append(uniq, st.t[1])
		}
	}
	parseFails, okCount, total := 0, 0, 0
	for _, line := range recLines {
		if len(wsSplit(line)) == 0 {
			continue
		}
		total++
		rec, perr := parseRecord(line)
		if perr != "" {
			parseFails++
			fmt.Fprintf(out, "record %d: FAILED parse: %s\n", total, perr)
			continue
		}
		failed := false
		for i, st := range steps {
			if msg := runStep(st, rec); msg != "" {
				fails[i]++
				failed = true
				fmt.Fprintf(out, "record %d: FAILED step %d (%s): %s\n", total, i+1, st.label, msg)
				break
			}
		}
		if failed {
			continue
		}
		okCount++
		for _, f := range uniq {
			if v, ok := rec[f]; ok {
				if seen[f] == nil {
					seen[f] = map[string]int{}
				}
				if _, dup := seen[f][v]; !dup {
					seen[f][v] = total
				}
			}
		}
		keys := make([]string, 0, len(rec))
		for k := range rec {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		parts := make([]string, len(keys))
		for i, k := range keys {
			parts[i] = k + "=" + rec[k]
		}
		fmt.Fprintf(out, "record %d: ok %s\n", total, strings.Join(parts, ","))
	}
	fmt.Fprintf(out, "summary records=%d ok=%d failed=%d\n", total, okCount, total-okCount)
	if parseFails > 0 {
		fmt.Fprintf(out, "failed at parse: %d\n", parseFails)
	}
	for i, st := range steps {
		if fails[i] > 0 {
			fmt.Fprintf(out, "failed at step %d (%s): %d\n", i+1, st.label, fails[i])
		}
	}
}
