import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Step:
    word: String
    toks: List[String]
    label: String

type Parsed:
    rec: Map[String, String]
    problem: String

fn is_space(c: Int) -> Bool:
    return c == 32 or c == 9

fn ws_split(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").unwrap()
    return spaced.split(" ").filter(fn(part: String) -> Bool:
        return not part.is_empty()
    )

fn trim_ws(s: String) -> String:
    let cs = s.scalar_values()
    var a = 0
    var b = cs.length()
    while a < b and is_space(cs.at(a).unwrap()):
        a = a + 1
    while b > a and is_space(cs.at(b - 1).unwrap()):
        b = b - 1
    return s.slice(a, b)

fn all_digits(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn is_int(s: String) -> Bool:
    if s.starts_with("-"):
        return all_digits(s.slice(1, s.length()))
    return all_digits(s)

fn to_int(s: String) -> Int:
    return s.parse_int().unwrap_or(0)

fn is_name(s: String) -> Bool:
    let cs = s.scalar_values()
    if cs.is_empty():
        return false
    let first = cs.at(0).unwrap()
    if not (first == 95 or (first >= 97 and first <= 122)):
        return false
    for c in cs:
        let lower = c >= 97 and c <= 122
        let digit = c >= 48 and c <= 57
        if not (lower or digit or c == 95):
            return false
    return true

fn kinds(word: String) -> Optional[String]:
    if word == "trim" or word == "lower" or word == "required" or word == "unique":
        return some("f")
    if word == "default" or word == "oneof" or word == "pattern":
        return some("ft")
    if word == "int":
        return some("fii")
    if word == "len":
        return some("fnn")
    if word == "less":
        return some("ff")
    if word == "needs":
        return some("ftf")
    return none

fn args_ok(word: String, ks: String, t: List[String]) -> Bool:
    if t.length() != 1 + ks.length():
        return false
    var k = 0
    while k < ks.length():
        let kind = ks.at(k).unwrap()
        let a = t.at(k + 1).unwrap()
        if kind == "f" and not is_name(a):
            return false
        if kind == "i" and not is_int(a):
            return false
        if kind == "n" and not all_digits(a):
            return false
        k = k + 1
    if word == "int" or word == "len":
        if to_int(t.at(2).unwrap()) > to_int(t.at(3).unwrap()):
            return false
    return true

# Returns an error line, or an empty string and fills `steps`.
fn parse_steps(lines: List[String], steps: List[Step]) -> String:
    var i = 0
    while i < lines.length():
        let t = ws_split(lines.at(i).unwrap())
        if not t.is_empty():
            let word = t.at(0).unwrap()
            let ks = kinds(word)
            if ks.is_none():
                return "pipeline error: line {i + 1}: unknown step {word}"
            if not args_ok(word, ks.unwrap(), t):
                return "pipeline error: line {i + 1}: bad arguments for {word}"
            steps.append(Step(word: word, toks: t, label: t.join(" ")))
        i = i + 1
    return ""

fn glob(mask: String, s: String) -> Bool:
    let m = mask.scalar_values()
    let sv = s.scalar_values()
    let n = sv.length()
    var prev = List[Bool]()
    var j = 0
    while j <= n:
        prev.append(false)
        j = j + 1
    prev.set(0, true)
    var i = 1
    while i <= m.length():
        let c = m.at(i - 1).unwrap()
        let cur = List[Bool]()
        j = 0
        while j <= n:
            var value = false
            if c == 42:
                value = prev.at(j).unwrap() or (j > 0 and cur.at(j - 1).unwrap())
            else if j > 0:
                let ch = sv.at(j - 1).unwrap()
                var good = ch == c
                if c == 57:
                    good = ch >= 48 and ch <= 57
                else if c == 97:
                    good = (ch >= 97 and ch <= 122) or (ch >= 65 and ch <= 90)
                value = prev.at(j - 1).unwrap() and good
            cur.append(value)
            j = j + 1
        prev = cur
        i = i + 1
    return prev.at(n).unwrap()

fn is_blank_value(rec: Map[String, String], f: String) -> Bool:
    let v = rec.get(f)
    return v.is_none() or v.unwrap().is_empty()

fn check_int(f: String, v: String, t: List[String]) -> Optional[String]:
    if not is_int(v):
        return some("{f} is not an integer")
    let lo = to_int(t.at(2).unwrap())
    let hi = to_int(t.at(3).unwrap())
    let x = to_int(v)
    if x < lo or x > hi:
        return some("{f} out of range {lo}..{hi}")
    return none

fn check_len(f: String, v: String, t: List[String]) -> Optional[String]:
    let lo = to_int(t.at(2).unwrap())
    let hi = to_int(t.at(3).unwrap())
    if v.length() < lo or v.length() > hi:
        return some("{f} length out of range {lo}..{hi}")
    return none

fn check_less(rec: Map[String, String], a: String, b: String) -> Optional[String]:
    let av = rec.get(a)
    let bv = rec.get(b)
    if av.is_none() or bv.is_none():
        return none
    if not is_int(av.unwrap()):
        return some("{a} is not an integer")
    if not is_int(bv.unwrap()):
        return some("{b} is not an integer")
    if not (to_int(av.unwrap()) < to_int(bv.unwrap())):
        return some("{a} must be less than {b}")
    return none

fn check_needs(rec: Map[String, String], f: String, value: String, other: String) -> Optional[String]:
    let v = rec.get(f)
    if v.is_none() or v.unwrap() != value:
        return none
    if is_blank_value(rec, other):
        return some("{other} is required when {f}={value}")
    return none

fn run_step(st: Step, rec: Map[String, String], seen: Map[String, Int]) -> Optional[String]:
    let t = st.toks
    let w = st.word
    let f = t.at(1).unwrap()
    let found = rec.get(f)
    if w == "trim":
        if found.is_some():
            rec.add(key: f, value: trim_ws(found.unwrap()))
        return none
    if w == "lower":
        if found.is_some():
            rec.add(key: f, value: found.unwrap().lower())
        return none
    if w == "default":
        if is_blank_value(rec, f):
            rec.add(key: f, value: t.at(2).unwrap())
        return none
    if w == "required":
        if is_blank_value(rec, f):
            return some("{f} is required")
        return none
    if w == "less":
        return check_less(rec, f, t.at(2).unwrap())
    if w == "needs":
        return check_needs(rec, f, t.at(2).unwrap(), t.at(3).unwrap())
    if found.is_none():
        return none
    let v = found.unwrap()
    if w == "int":
        return check_int(f, v, t)
    if w == "len":
        return check_len(f, v, t)
    if w == "oneof":
        if t.at(2).unwrap().split("|").contains(v):
            return none
        return some("{f} not one of {t.at(2).unwrap()}")
    if w == "pattern":
        if glob(t.at(2).unwrap(), v):
            return none
        return some("{f} does not match {t.at(2).unwrap()}")
    if w == "unique":
        let k = seen.get("{f}\n{v}")
        if k.is_some():
            return some("{f} duplicates record {k.unwrap()}")
    return none

fn parse_record(line: String) -> Parsed:
    let rec = Map[String, String]()
    for piece in line.split(","):
        let eq = piece.index_of("=")
        if eq.is_none():
            return Parsed(rec: rec, problem: "bad field '{piece}'")
        let key = piece.slice(0, eq.unwrap())
        if not is_name(key):
            return Parsed(rec: rec, problem: "bad field '{piece}'")
        if rec.contains(key):
            return Parsed(rec: rec, problem: "duplicate key {key}")
        rec.add(key: key, value: piece.slice(eq.unwrap() + 1, piece.length()))
    return Parsed(rec: rec, problem: "")

fn ok_line(total: Int, rec: Map[String, String]) -> String:
    let keys = rec.keys().sorted(compare: fn(a: String, b: String) -> Int:
        return a.compare(b)
    )
    let parts = keys.map(fn(k: String) -> String:
        return "{k}={rec.get(k).unwrap()}"
    )
    return "record {total}: ok {parts.join(",")}"

fn run() -> Result[Unit, Error]:
    let lines = List[String]()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        lines.append(next.unwrap())
    var sep = -1
    var i = 0
    while i < lines.length() and sep < 0:
        if trim_ws(lines.at(i).unwrap()) == "---":
            sep = i
        i = i + 1
    var step_lines = lines
    var rec_lines = List[String]()
    if sep >= 0:
        step_lines = lines.slice(0, sep)
        rec_lines = lines.slice(sep + 1, lines.length())
    let steps = List[Step]()
    let problem = parse_steps(step_lines, steps)
    let out = StringBuilder()
    if not problem.is_empty():
        out.append("{problem}\n")
        try stdout().write(out.freeze().to_bytes())
        return stdout().flush()
    let fails = List[Int]()
    let uniq = List[String]()
    for st in steps:
        fails.append(0)
        if st.word == "unique":
            uniq.append(st.toks.at(1).unwrap())
    let seen = Map[String, Int]()
    var parse_fails = 0
    var ok_count = 0
    var total = 0
    for line in rec_lines:
        if ws_split(line).is_empty():
            continue
        total = total + 1
        let parsed = parse_record(line)
        if not parsed.problem.is_empty():
            parse_fails = parse_fails + 1
            out.append("record {total}: FAILED parse: {parsed.problem}\n")
            continue
        let rec = parsed.rec
        var failed = false
        var s = 0
        while s < steps.length() and not failed:
            let st = steps.at(s).unwrap()
            let msg = run_step(st, rec, seen)
            if msg.is_some():
                fails.set(s, fails.at(s).unwrap() + 1)
                failed = true
                out.append("record {total}: FAILED step {s + 1} ({st.label}): {msg.unwrap()}\n")
            s = s + 1
        if failed:
            continue
        ok_count = ok_count + 1
        for f in uniq:
            let v = rec.get(f)
            if v.is_some():
                let key = "{f}\n{v.unwrap()}"
                if not seen.contains(key):
                    seen.add(key: key, value: total)
        out.append("{ok_line(total, rec)}\n")
    out.append("summary records={total} ok={ok_count} failed={total - ok_count}\n")
    if parse_fails > 0:
        out.append("failed at parse: {parse_fails}\n")
    var n = 0
    while n < steps.length():
        let count = fails.at(n).unwrap()
        if count > 0:
            out.append("failed at step {n + 1} ({steps.at(n).unwrap().label}): {count}\n")
        n = n + 1
    try stdout().write(out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
