import * as fs from "node:fs";

type Step = { w: string; t: string[]; label: string };

const NAME = /^[a-z_][a-z0-9_]*$/;
const INT = /^-?[0-9]+$/;
const NONNEG = /^[0-9]+$/;
const KINDS: Record<string, string> = {
  trim: "f", lower: "f", default: "ft", required: "f", int: "fii", len: "fnn",
  oneof: "ft", pattern: "ft", unique: "f", less: "ff", needs: "ftf",
};

const wsSplit = (l: string): string[] => l.split(/[ \t]+/).filter((x) => x !== "");
const blank = (l: string): boolean => wsSplit(l).length === 0;
const isInt = (s: string): boolean => INT.test(s);

let lines = fs.readFileSync(0, "utf8").split("\n");
if (lines.length > 0 && lines[lines.length - 1] === "") lines.pop();
let sep = lines.findIndex((l) => l.replace(/^[ \t]+|[ \t]+$/g, "") === "---");
const stepLines = sep >= 0 ? lines.slice(0, sep) : lines;
const recLines = sep >= 0 ? lines.slice(sep + 1) : [];

const steps: Step[] = [];
for (let i = 0; i < stepLines.length; i++) {
  const t = wsSplit(stepLines[i]);
  if (t.length === 0) continue;
  const w = t[0];
  const kinds = Object.prototype.hasOwnProperty.call(KINDS, w) ? KINDS[w] : undefined;
  if (kinds === undefined) {
    process.stdout.write(`pipeline error: line ${i + 1}: unknown step ${w}\n`);
    process.exit(0);
  }
  let ok = t.length === 1 + kinds.length;
  if (ok) {
    for (let k = 0; k < kinds.length; k++) {
      const a = t[k + 1];
      if (kinds[k] === "f" && !NAME.test(a)) ok = false;
      if (kinds[k] === "i" && !INT.test(a)) ok = false;
      if (kinds[k] === "n" && !NONNEG.test(a)) ok = false;
    }
    if (ok && (w === "int" || w === "len") && BigInt(t[2]) > BigInt(t[3])) ok = false;
  }
  if (!ok) {
    process.stdout.write(`pipeline error: line ${i + 1}: bad arguments for ${w}\n`);
    process.exit(0);
  }
  steps.push({ w, t, label: t.join(" ") });
}

function glob(mask: string, s: string): boolean {
  const m = mask.length;
  const n = s.length;
  let prev: boolean[] = new Array(n + 1).fill(false);
  prev[0] = true;
  for (let i = 1; i <= m; i++) {
    const c = mask[i - 1];
    const cur: boolean[] = new Array(n + 1).fill(false);
    for (let j = 0; j <= n; j++) {
      if (c === "*") cur[j] = prev[j] || (j > 0 && cur[j - 1]);
      else if (j === 0) cur[j] = false;
      else {
        const ch = s[j - 1];
        let good: boolean;
        if (c === "9") good = ch >= "0" && ch <= "9";
        else if (c === "a") good = (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z");
        else good = ch === c;
        cur[j] = prev[j - 1] && good;
      }
    }
    prev = cur;
  }
  return prev[n];
}

const seen = new Map<string, Map<string, number>>();

function runStep(st: Step, rec: Map<string, string>): string | null {
  const { w, t } = st;
  const f = t[1];
  const v = rec.get(f);
  switch (w) {
    case "trim":
      if (v !== undefined) rec.set(f, v.replace(/^[ \t]+|[ \t]+$/g, ""));
      return null;
    case "lower":
      if (v !== undefined) rec.set(f, v.replace(/[A-Z]/g, (c) => c.toLowerCase()));
      return null;
    case "default":
      if (v === undefined || v === "") rec.set(f, t[2]);
      return null;
    case "required":
      return v === undefined || v === "" ? `${f} is required` : null;
    case "int": {
      if (v === undefined) return null;
      if (!isInt(v)) return `${f} is not an integer`;
      const x = BigInt(v);
      if (x < BigInt(t[2]) || x > BigInt(t[3])) return `${f} out of range ${BigInt(t[2])}..${BigInt(t[3])}`;
      return null;
    }
    case "len": {
      if (v === undefined) return null;
      if (v.length < Number(t[2]) || v.length > Number(t[3])) return `${f} length out of range ${BigInt(t[2])}..${BigInt(t[3])}`;
      return null;
    }
    case "oneof":
      if (v === undefined) return null;
      return t[2].split("|").includes(v) ? null : `${f} not one of ${t[2]}`;
    case "pattern":
      if (v === undefined) return null;
      return glob(t[2], v) ? null : `${f} does not match ${t[2]}`;
    case "unique": {
      if (v === undefined) return null;
      const k = seen.get(f)?.get(v);
      return k !== undefined ? `${f} duplicates record ${k}` : null;
    }
    case "less": {
      const a = rec.get(t[1]);
      const b = rec.get(t[2]);
      if (a === undefined || b === undefined) return null;
      if (!isInt(a)) return `${t[1]} is not an integer`;
      if (!isInt(b)) return `${t[2]} is not an integer`;
      return BigInt(a) < BigInt(b) ? null : `${t[1]} must be less than ${t[2]}`;
    }
    case "needs": {
      if (v === undefined || v !== t[2]) return null;
      const o = rec.get(t[3]);
      return o === undefined || o === "" ? `${t[3]} is required when ${f}=${t[2]}` : null;
    }
  }
  return null;
}

function parseRecord(line: string): { rec?: Map<string, string>; err?: string } {
  const rec = new Map<string, string>();
  for (const piece of line.split(",")) {
    const i = piece.indexOf("=");
    if (i < 0 || !NAME.test(piece.slice(0, i))) return { err: `bad field '${piece}'` };
    const k = piece.slice(0, i);
    if (rec.has(k)) return { err: `duplicate key ${k}` };
    rec.set(k, piece.slice(i + 1));
  }
  return { rec };
}

const out: string[] = [];
const fails: number[] = steps.map(() => 0);
let parseFails = 0;
let okCount = 0;
let total = 0;
const uniq = steps.filter((s) => s.w === "unique").map((s) => s.t[1]);
for (const line of recLines) {
  if (blank(line)) continue;
  total++;
  const { rec, err } = parseRecord(line);
  if (err !== undefined || rec === undefined) {
    parseFails++;
    out.push(`record ${total}: FAILED parse: ${err}`);
    continue;
  }
  let failed = false;
  for (let i = 0; i < steps.length; i++) {
    const msg = runStep(steps[i], rec);
    if (msg !== null) {
      fails[i]++;
      failed = true;
      out.push(`record ${total}: FAILED step ${i + 1} (${steps[i].label}): ${msg}`);
      break;
    }
  }
  if (failed) continue;
  okCount++;
  for (const f of uniq) {
    const v = rec.get(f);
    if (v === undefined) continue;
    let m = seen.get(f);
    if (m === undefined) seen.set(f, (m = new Map()));
    if (!m.has(v)) m.set(v, total);
  }
  const keys = [...rec.keys()].sort((a, b) => (a < b ? -1 : a > b ? 1 : 0));
  out.push(`record ${total}: ok ${keys.map((k) => `${k}=${rec.get(k)}`).join(",")}`);
}
out.push(`summary records=${total} ok=${okCount} failed=${total - okCount}`);
if (parseFails > 0) out.push(`failed at parse: ${parseFails}`);
steps.forEach((st, i) => {
  if (fails[i] > 0) out.push(`failed at step ${i + 1} (${st.label}): ${fails[i]}`);
});
process.stdout.write(out.map((l) => l + "\n").join(""));
