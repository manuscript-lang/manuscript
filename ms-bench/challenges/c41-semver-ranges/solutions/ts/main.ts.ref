import { readFileSync } from "node:fs";

type Ver = { n: [number, number, number]; pre: string[] };
type Comp = { op: string; v: Ver };
type Partial = { n: number; M: number; m: number; p: number; pre: string[] };

const NUM = /^(0|[1-9][0-9]{0,8})$/;
const isWild = (s: string) => s === "x" || s === "X" || s === "*";

function parsePre(s: string): string[] | null {
  const ids = s.split(".");
  for (const id of ids) {
    if (!/^[0-9A-Za-z-]+$/.test(id)) return null;
    if (/^[0-9]+$/.test(id) && !NUM.test(id)) return null;
  }
  return ids;
}

function parseVersion(s: string): Ver | null {
  let pre: string[] = [];
  const dash = s.indexOf("-");
  if (dash >= 0) {
    const p = parsePre(s.slice(dash + 1));
    if (p === null) return null;
    pre = p;
    s = s.slice(0, dash);
  }
  const parts = s.split(".");
  if (parts.length !== 3 || !parts.every((x) => NUM.test(x))) return null;
  return { n: [Number(parts[0]), Number(parts[1]), Number(parts[2])], pre };
}

function cmpId(a: string, b: string): number {
  const an = /^[0-9]+$/.test(a);
  const bn = /^[0-9]+$/.test(b);
  if (an && bn) return Math.sign(Number(a) - Number(b));
  if (an) return -1;
  if (bn) return 1;
  return a < b ? -1 : a > b ? 1 : 0;
}

function cmpVer(a: Ver, b: Ver): number {
  for (let i = 0; i < 3; i++) if (a.n[i] !== b.n[i]) return a.n[i] < b.n[i] ? -1 : 1;
  if (a.pre.length === 0 && b.pre.length === 0) return 0;
  if (a.pre.length === 0) return 1;
  if (b.pre.length === 0) return -1;
  const k = Math.min(a.pre.length, b.pre.length);
  for (let i = 0; i < k; i++) {
    const c = cmpId(a.pre[i], b.pre[i]);
    if (c !== 0) return c;
  }
  return Math.sign(a.pre.length - b.pre.length);
}

function parsePartial(tok: string): Partial | null {
  if (isWild(tok)) return { n: 0, M: 0, m: 0, p: 0, pre: [] };
  let pre: string[] = [];
  let base = tok;
  const dash = tok.indexOf("-");
  if (dash >= 0) {
    const p = parsePre(tok.slice(dash + 1));
    if (p === null) return null;
    pre = p;
    base = tok.slice(0, dash);
  }
  const parts = base.split(".");
  if (parts.length > 3) return null;
  const vals: number[] = [];
  let wild = false;
  for (const q of parts) {
    if (isWild(q)) wild = true;
    else {
      if (wild || !NUM.test(q)) return null;
      vals.push(Number(q));
    }
  }
  if (pre.length > 0 && vals.length !== 3) return null;
  const v = [...vals];
  while (v.length < 3) v.push(0);
  return { n: vals.length, M: v[0], m: v[1], p: v[2], pre };
}

const V = (M: number, m: number, p: number, pre: string[] = []): Ver => ({ n: [M, m, p], pre });
const NEVER: Comp = { op: "<", v: V(0, 0, 0) };
const C = (op: string, v: Ver): Comp => ({ op, v });

function termComps(op: string, P: Partial): Comp[] {
  const { n, M, m, p, pre } = P;
  const full = V(M, m, p, pre);
  const fill = V(M, m, p, n === 3 ? pre : []);
  const n1 = V(M + 1, 0, 0);
  const n2 = V(M, m + 1, 0);
  switch (op) {
    case "":
    case "=":
      if (n === 0) return [];
      if (n === 1) return [C(">=", V(M, 0, 0)), C("<", n1)];
      if (n === 2) return [C(">=", V(M, m, 0)), C("<", n2)];
      return [C("==", full)];
    case ">":
      if (n === 0) return [NEVER];
      if (n === 1) return [C(">=", n1)];
      if (n === 2) return [C(">=", n2)];
      return [C(">", full)];
    case ">=":
      return n === 0 ? [] : [C(">=", fill)];
    case "<":
      return n === 0 ? [NEVER] : [C("<", fill)];
    case "<=":
      if (n === 0) return [];
      if (n === 1) return [C("<", n1)];
      if (n === 2) return [C("<", n2)];
      return [C("<=", full)];
    case "~":
      if (n === 0) return [];
      if (n === 1) return [C(">=", V(M, 0, 0)), C("<", n1)];
      if (n === 2) return [C(">=", V(M, m, 0)), C("<", n2)];
      return [C(">=", full), C("<", n2)];
    default: // ^
      if (n === 0) return [];
      if (n === 1) return [C(">=", V(M, 0, 0)), C("<", n1)];
      if (n === 2) return [C(">=", V(M, m, 0)), C("<", M > 0 ? n1 : n2)];
      if (M > 0) return [C(">=", full), C("<", n1)];
      if (m > 0) return [C(">=", full), C("<", n2)];
      return [C(">=", full), C("<", V(0, 0, p + 1))];
  }
}

const OPS = [">=", "<=", ">", "<", "=", "^", "~"];

function parseRange(tokens: string[]): Comp[][] | null {
  const sets: string[][] = [[]];
  for (const t of tokens) {
    if (t === "||") sets.push([]);
    else sets[sets.length - 1].push(t);
  }
  const out: Comp[][] = [];
  for (const st of sets) {
    const comps: Comp[] = [];
    let i = 0;
    while (i < st.length) {
      if (i + 1 < st.length && st[i + 1] === "-") {
        if (i + 2 >= st.length) return null;
        const a = parsePartial(st[i]);
        const b = parsePartial(st[i + 2]);
        if (a === null || b === null) return null;
        if (a.n > 0) comps.push(C(">=", V(a.M, a.m, a.p, a.n === 3 ? a.pre : [])));
        if (b.n === 3) comps.push(C("<=", V(b.M, b.m, b.p, b.pre)));
        else if (b.n === 2) comps.push(C("<", V(b.M, b.m + 1, 0)));
        else if (b.n === 1) comps.push(C("<", V(b.M + 1, 0, 0)));
        i += 3;
        continue;
      }
      const t = st[i];
      if (t === "-") return null;
      let op = "";
      for (const o of OPS) {
        if (t.startsWith(o)) {
          op = o;
          break;
        }
      }
      const P = parsePartial(t.slice(op.length));
      if (P === null) return null;
      comps.push(...termComps(op, P));
      i++;
    }
    out.push(comps);
  }
  return out;
}

function holds(c: Comp, v: Ver): boolean {
  const k = cmpVer(v, c.v);
  switch (c.op) {
    case ">=": return k >= 0;
    case ">": return k > 0;
    case "<": return k < 0;
    case "<=": return k <= 0;
    default: return k === 0;
  }
}

function satisfies(rng: Comp[][], v: Ver): boolean {
  for (const comps of rng) {
    if (!comps.every((c) => holds(c, v))) continue;
    if (v.pre.length > 0 && !comps.some((c) => c.v.pre.length > 0 && c.v.n[0] === v.n[0] && c.v.n[1] === v.n[1] && c.v.n[2] === v.n[2])) continue;
    return true;
  }
  return false;
}

let pool: { text: string; v: Ver }[] = [];
const out: string[] = [];
for (const line of readFileSync(0, "utf8").split("\n")) {
  const t = line.split(/[ \t]+/).filter((x) => x !== "");
  if (t.length === 0) continue;
  const c = t[0];
  if (c === "pool") {
    const seen = new Set<string>();
    pool = [];
    let skipped = 0;
    for (const a of t.slice(1)) {
      const v = parseVersion(a);
      if (v === null) {
        skipped++;
        continue;
      }
      if (seen.has(a)) continue;
      seen.add(a);
      pool.push({ text: a, v });
    }
    pool.sort((x, y) => cmpVer(x.v, y.v));
    out.push(`pool ${pool.length} skipped ${skipped}`);
  } else if (c === "max" || c === "all") {
    const r = parseRange(t.slice(1));
    if (r === null) {
      out.push("invalid range");
      continue;
    }
    const ok = pool.filter((e) => satisfies(r, e.v)).map((e) => e.text);
    if (ok.length === 0) out.push("none");
    else if (c === "max") out.push(ok[ok.length - 1]);
    else out.push(ok.join(" "));
  } else if (c === "test" && t.length >= 2) {
    const v = parseVersion(t[1]);
    if (v === null) {
      out.push("invalid version");
      continue;
    }
    const r = parseRange(t.slice(2));
    if (r === null) {
      out.push("invalid range");
      continue;
    }
    out.push(satisfies(r, v) ? "true" : "false");
  } else {
    out.push("error: bad command");
  }
}
process.stdout.write(out.map((o) => o + "\n").join(""));
