import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Ver:
    a: Int
    b: Int
    c: Int
    pre: List[String]

type Comp:
    op: String
    v: Ver

type Partial:
    n: Int
    a: Int
    b: Int
    c: Int
    pre: List[String]

type Entry:
    text: String
    v: Ver

fn fields(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").unwrap()
    return spaced.split(" ").filter(fn(part: String) -> Bool:
        return not part.is_empty()
    )

fn all_digits(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn is_num(s: String) -> Bool:
    if not all_digits(s) or s.length() > 9:
        return false
    return s == "0" or not s.starts_with("0")

fn is_wild(s: String) -> Bool:
    return s == "x" or s == "X" or s == "*"

fn ident_ok(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        let digit = c >= 48 and c <= 57
        let upper = c >= 65 and c <= 90
        let lower = c >= 97 and c <= 122
        if not (digit or upper or lower or c == 45):
            return false
    if all_digits(s) and not is_num(s):
        return false
    return true

fn parse_pre(s: String) -> Result[List[String], String]:
    let ids = s.split(".")
    for id in ids:
        if not ident_ok(id):
            return error("pre")
    return ok(ids)

fn mk(a: Int, b: Int, c: Int) -> Ver:
    return Ver(a: a, b: b, c: c, pre: List[String]())

fn mkp(a: Int, b: Int, c: Int, pre: List[String]) -> Ver:
    return Ver(a: a, b: b, c: c, pre: pre)

fn parse_version(s: String) -> Result[Ver, String]:
    var base = s
    var pre = List[String]()
    let dash = s.index_of("-")
    if dash.is_some():
        pre = try parse_pre(s.slice(dash.unwrap() + 1, s.length()))
        base = s.slice(0, dash.unwrap())
    let parts = base.split(".")
    if parts.length() != 3:
        return error("version")
    for p in parts:
        if not is_num(p):
            return error("version")
    return ok(mkp(parts.at(0).unwrap().parse_int().unwrap(), parts.at(1).unwrap().parse_int().unwrap(), parts.at(2).unwrap().parse_int().unwrap(), pre))

fn cmp_id(x: String, y: String) -> Int:
    let xn = all_digits(x)
    let yn = all_digits(y)
    if xn and yn:
        let p = x.parse_int().unwrap()
        let q = y.parse_int().unwrap()
        if p < q:
            return -1
        if p > q:
            return 1
        return 0
    if xn:
        return -1
    if yn:
        return 1
    return x.compare(y)

fn cmp_ver(x: Ver, y: Ver) -> Int:
    if x.a != y.a:
        if x.a < y.a:
            return -1
        return 1
    if x.b != y.b:
        if x.b < y.b:
            return -1
        return 1
    if x.c != y.c:
        if x.c < y.c:
            return -1
        return 1
    if x.pre.is_empty() and y.pre.is_empty():
        return 0
    if x.pre.is_empty():
        return 1
    if y.pre.is_empty():
        return -1
    var i = 0
    while i < x.pre.length() and i < y.pre.length():
        let r = cmp_id(x.pre.at(i).unwrap(), y.pre.at(i).unwrap())
        if r != 0:
            return r
        i = i + 1
    if x.pre.length() < y.pre.length():
        return -1
    if x.pre.length() > y.pre.length():
        return 1
    return 0

fn parse_partial(tok: String) -> Result[Partial, String]:
    if is_wild(tok):
        return ok(Partial(n: 0, a: 0, b: 0, c: 0, pre: List[String]()))
    var base = tok
    var pre = List[String]()
    let dash = tok.index_of("-")
    if dash.is_some():
        pre = try parse_pre(tok.slice(dash.unwrap() + 1, tok.length()))
        base = tok.slice(0, dash.unwrap())
    let parts = base.split(".")
    if parts.length() > 3:
        return error("partial")
    let vals = List[Int]()
    var wild = false
    for q in parts:
        if is_wild(q):
            wild = true
        else:
            if wild or not is_num(q):
                return error("partial")
            vals.append(q.parse_int().unwrap())
    if not pre.is_empty() and vals.length() != 3:
        return error("partial")
    let n = vals.length()
    while vals.length() < 3:
        vals.append(0)
    return ok(Partial(n: n, a: vals.at(0).unwrap(), b: vals.at(1).unwrap(), c: vals.at(2).unwrap(), pre: pre))

fn comp(op: String, v: Ver) -> Comp:
    return Comp(op: op, v: v)

fn term_comps(op: String, p: Partial) -> List[Comp]:
    let n = p.n
    let full = mkp(p.a, p.b, p.c, p.pre)
    var fill = mk(p.a, p.b, p.c)
    if n == 3:
        fill = full
    let n1 = mk(p.a + 1, 0, 0)
    let n2 = mk(p.a, p.b + 1, 0)
    let none = List[Comp]()
    let never = [comp("<", mk(0, 0, 0))]
    if op == "" or op == "=":
        if n == 0:
            return none
        if n == 1:
            return [comp(">=", mk(p.a, 0, 0)), comp("<", n1)]
        if n == 2:
            return [comp(">=", mk(p.a, p.b, 0)), comp("<", n2)]
        return [comp("==", full)]
    if op == ">":
        if n == 0:
            return never
        if n == 1:
            return [comp(">=", n1)]
        if n == 2:
            return [comp(">=", n2)]
        return [comp(">", full)]
    if op == ">=":
        if n == 0:
            return none
        return [comp(">=", fill)]
    if op == "<":
        if n == 0:
            return never
        return [comp("<", fill)]
    if op == "<=":
        if n == 0:
            return none
        if n == 1:
            return [comp("<", n1)]
        if n == 2:
            return [comp("<", n2)]
        return [comp("<=", full)]
    if op == "~":
        if n == 0:
            return none
        if n == 1:
            return [comp(">=", mk(p.a, 0, 0)), comp("<", n1)]
        if n == 2:
            return [comp(">=", mk(p.a, p.b, 0)), comp("<", n2)]
        return [comp(">=", full), comp("<", n2)]
    if n == 0:
        return none
    if n == 1:
        return [comp(">=", mk(p.a, 0, 0)), comp("<", n1)]
    if n == 2:
        if p.a > 0:
            return [comp(">=", mk(p.a, p.b, 0)), comp("<", n1)]
        return [comp(">=", mk(p.a, p.b, 0)), comp("<", n2)]
    if p.a > 0:
        return [comp(">=", full), comp("<", n1)]
    if p.b > 0:
        return [comp(">=", full), comp("<", n2)]
    return [comp(">=", full), comp("<", mk(0, 0, p.c + 1))]

fn split_op(t: String) -> String:
    for o in [">=", "<=", ">", "<", "=", "^", "~"]:
        if t.starts_with(o):
            return o
    return ""

fn parse_set(st: List[String]) -> Result[List[Comp], String]:
    let comps = List[Comp]()
    var i = 0
    while i < st.length():
        if i + 1 < st.length() and st.at(i + 1).unwrap() == "-":
            if i + 2 >= st.length():
                return error("range")
            let lo = try parse_partial(st.at(i).unwrap())
            let hi = try parse_partial(st.at(i + 2).unwrap())
            if lo.n > 0:
                var lv = mk(lo.a, lo.b, lo.c)
                if lo.n == 3:
                    lv = mkp(lo.a, lo.b, lo.c, lo.pre)
                comps.append(comp(">=", lv))
            if hi.n == 3:
                comps.append(comp("<=", mkp(hi.a, hi.b, hi.c, hi.pre)))
            else if hi.n == 2:
                comps.append(comp("<", mk(hi.a, hi.b + 1, 0)))
            else if hi.n == 1:
                comps.append(comp("<", mk(hi.a + 1, 0, 0)))
            i = i + 3
            continue
        let t = st.at(i).unwrap()
        if t == "-":
            return error("range")
        let op = split_op(t)
        let p = try parse_partial(t.slice(op.length(), t.length()))
        for c in term_comps(op, p):
            comps.append(c)
        i = i + 1
    return ok(comps)

fn parse_range(tokens: List[String]) -> Result[List[List[Comp]], String]:
    let sets = List[List[String]]()
    var cur = List[String]()
    for t in tokens:
        if t == "||":
            sets.append(cur)
            cur = List[String]()
        else:
            cur.append(t)
    sets.append(cur)
    let out = List[List[Comp]]()
    for st in sets:
        out.append(try parse_set(st))
    return ok(out)

fn holds(c: Comp, v: Ver) -> Bool:
    let k = cmp_ver(v, c.v)
    if c.op == ">=":
        return k >= 0
    if c.op == ">":
        return k > 0
    if c.op == "<":
        return k < 0
    if c.op == "<=":
        return k <= 0
    return k == 0

fn satisfies(rng: List[List[Comp]], v: Ver) -> Bool:
    for comps in rng:
        var good = true
        for c in comps:
            if not holds(c, v):
                good = false
                break
        if not good:
            continue
        if not v.pre.is_empty():
            var found = false
            for c in comps:
                if not c.v.pre.is_empty() and c.v.a == v.a and c.v.b == v.b and c.v.c == v.c:
                    found = true
                    break
            if not found:
                continue
        return true
    return false

type State:
    pool: List[Entry]
    out: StringBuilder

fn emit(s: State, text: String) -> Unit:
    s.out.append(text)
    s.out.append("\n")

fn do_pool(s: State, t: List[String]) -> Unit:
    let seen = Map[String, Bool]()
    let entries = List[Entry]()
    var skipped = 0
    var i = 1
    while i < t.length():
        let a = t.at(i).unwrap()
        i = i + 1
        match parse_version(a):
            ok(v):
                if not seen.contains(a):
                    seen.add(key: a, value: true)
                    entries.append(Entry(text: a, v: v))
            error(_):
                skipped = skipped + 1
    s.pool = entries.sorted(compare: fn(x: Entry, y: Entry) -> Int:
        return cmp_ver(x.v, y.v)
    )
    emit(s, "pool {s.pool.length()} skipped {skipped}")

fn rest(t: List[String], start: Int) -> List[String]:
    return t.slice(start, t.length())

fn step(s: State, t: List[String]) -> Unit:
    let c = t.at(0).unwrap()
    if c == "pool":
        return do_pool(s, t)
    if c == "max" or c == "all":
        match parse_range(rest(t, 1)):
            error(_):
                return emit(s, "invalid range")
            ok(r):
                let res = List[String]()
                for e in s.pool:
                    if satisfies(r, e.v):
                        res.append(e.text)
                if res.is_empty():
                    return emit(s, "none")
                if c == "max":
                    return emit(s, res.last().unwrap())
                return emit(s, res.join(" "))
    if c == "test" and t.length() >= 2:
        match parse_version(t.at(1).unwrap()):
            error(_):
                return emit(s, "invalid version")
            ok(v):
                match parse_range(rest(t, 2)):
                    error(_):
                        return emit(s, "invalid range")
                    ok(r):
                        if satisfies(r, v):
                            return emit(s, "true")
                        return emit(s, "false")
    emit(s, "error: bad command")

fn run() -> Result[Unit, Error]:
    let s = State(pool: List[Entry](), out: StringBuilder())
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let t = fields(next.unwrap())
        if t.is_empty():
            continue
        step(s, t)
    try stdout().write(s.out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
