use std::cmp::Ordering;
use std::collections::HashSet;
use std::io::{self, Read, Write};

#[derive(Clone)]
struct Ver {
    n: [u64; 3],
    pre: Vec<String>,
}

#[derive(Clone)]
struct Comp {
    op: &'static str,
    v: Ver,
}

struct Partial {
    n: usize,
    mj: u64,
    mn: u64,
    p: u64,
    pre: Vec<String>,
}

fn is_digits(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|c| c.is_ascii_digit())
}

fn is_num(s: &str) -> bool {
    is_digits(s) && s.len() <= 9 && (s == "0" || !s.starts_with('0'))
}

fn is_wild(s: &str) -> bool {
    s == "x" || s == "X" || s == "*"
}

fn parse_pre(s: &str) -> Option<Vec<String>> {
    let mut ids = Vec::new();
    for id in s.split('.') {
        if id.is_empty() || !id.bytes().all(|c| c.is_ascii_alphanumeric() || c == b'-') {
            return None;
        }
        if is_digits(id) && !is_num(id) {
            return None;
        }
        ids.push(id.to_string());
    }
    Some(ids)
}

fn parse_version(s: &str) -> Option<Ver> {
    let mut pre = Vec::new();
    let mut base = s;
    if let Some(d) = s.find('-') {
        pre = parse_pre(&s[d + 1..])?;
        base = &s[..d];
    }
    let parts: Vec<&str> = base.split('.').collect();
    if parts.len() != 3 || !parts.iter().all(|p| is_num(p)) {
        return None;
    }
    let n = [parts[0].parse().ok()?, parts[1].parse().ok()?, parts[2].parse().ok()?];
    Some(Ver { n, pre })
}

fn cmp_id(a: &str, b: &str) -> Ordering {
    let (an, bn) = (is_digits(a), is_digits(b));
    if an && bn {
        return a.parse::<u64>().unwrap().cmp(&b.parse::<u64>().unwrap());
    }
    if an {
        return Ordering::Less;
    }
    if bn {
        return Ordering::Greater;
    }
    a.as_bytes().cmp(b.as_bytes())
}

fn cmp_ver(a: &Ver, b: &Ver) -> Ordering {
    for i in 0..3 {
        if a.n[i] != b.n[i] {
            return a.n[i].cmp(&b.n[i]);
        }
    }
    match (a.pre.is_empty(), b.pre.is_empty()) {
        (true, true) => return Ordering::Equal,
        (true, false) => return Ordering::Greater,
        (false, true) => return Ordering::Less,
        _ => {}
    }
    for (x, y) in a.pre.iter().zip(b.pre.iter()) {
        let c = cmp_id(x, y);
        if c != Ordering::Equal {
            return c;
        }
    }
    a.pre.len().cmp(&b.pre.len())
}

fn parse_partial(tok: &str) -> Option<Partial> {
    if is_wild(tok) {
        return Some(Partial { n: 0, mj: 0, mn: 0, p: 0, pre: vec![] });
    }
    let mut pre = Vec::new();
    let mut base = tok;
    if let Some(d) = tok.find('-') {
        pre = parse_pre(&tok[d + 1..])?;
        base = &tok[..d];
    }
    let parts: Vec<&str> = base.split('.').collect();
    if parts.len() > 3 {
        return None;
    }
    let mut vals: Vec<u64> = Vec::new();
    let mut wild = false;
    for q in parts {
        if is_wild(q) {
            wild = true;
        } else {
            if wild || !is_num(q) {
                return None;
            }
            vals.push(q.parse().ok()?);
        }
    }
    if !pre.is_empty() && vals.len() != 3 {
        return None;
    }
    let n = vals.len();
    while vals.len() < 3 {
        vals.push(0);
    }
    Some(Partial { n, mj: vals[0], mn: vals[1], p: vals[2], pre })
}

fn mk(a: u64, b: u64, c: u64, pre: &[String]) -> Ver {
    Ver { n: [a, b, c], pre: pre.to_vec() }
}

fn c(op: &'static str, v: Ver) -> Comp {
    Comp { op, v }
}

fn term_comps(op: &str, p: &Partial) -> Vec<Comp> {
    let (n, mj, mn, pp) = (p.n, p.mj, p.mn, p.p);
    let full = mk(mj, mn, pp, &p.pre);
    let fill = mk(mj, mn, pp, if n == 3 { &p.pre } else { &[] });
    let n1 = mk(mj + 1, 0, 0, &[]);
    let n2 = mk(mj, mn + 1, 0, &[]);
    let never = vec![c("<", mk(0, 0, 0, &[]))];
    match op {
        "" | "=" => match n {
            0 => vec![],
            1 => vec![c(">=", mk(mj, 0, 0, &[])), c("<", n1)],
            2 => vec![c(">=", mk(mj, mn, 0, &[])), c("<", n2)],
            _ => vec![c("==", full)],
        },
        ">" => match n {
            0 => never,
            1 => vec![c(">=", n1)],
            2 => vec![c(">=", n2)],
            _ => vec![c(">", full)],
        },
        ">=" => if n == 0 { vec![] } else { vec![c(">=", fill)] },
        "<" => if n == 0 { never } else { vec![c("<", fill)] },
        "<=" => match n {
            0 => vec![],
            1 => vec![c("<", n1)],
            2 => vec![c("<", n2)],
            _ => vec![c("<=", full)],
        },
        "~" => match n {
            0 => vec![],
            1 => vec![c(">=", mk(mj, 0, 0, &[])), c("<", n1)],
            2 => vec![c(">=", mk(mj, mn, 0, &[])), c("<", n2)],
            _ => vec![c(">=", full), c("<", n2)],
        },
        _ => match n {
            0 => vec![],
            1 => vec![c(">=", mk(mj, 0, 0, &[])), c("<", n1)],
            2 => vec![c(">=", mk(mj, mn, 0, &[])), c("<", if mj > 0 { n1 } else { n2 })],
            _ => {
                if mj > 0 {
                    vec![c(">=", full), c("<", n1)]
                } else if mn > 0 {
                    vec![c(">=", full), c("<", n2)]
                } else {
                    vec![c(">=", full), c("<", mk(0, 0, pp + 1, &[]))]
                }
            }
        },
    }
}

const OPS: [&str; 7] = [">=", "<=", ">", "<", "=", "^", "~"];

fn parse_range(tokens: &[&str]) -> Option<Vec<Vec<Comp>>> {
    let mut sets: Vec<Vec<&str>> = vec![vec![]];
    for t in tokens {
        if *t == "||" {
            sets.push(vec![]);
        } else {
            sets.last_mut().unwrap().push(t);
        }
    }
    let mut out = Vec::new();
    for st in sets {
        let mut comps: Vec<Comp> = Vec::new();
        let mut i = 0;
        while i < st.len() {
            if i + 1 < st.len() && st[i + 1] == "-" {
                if i + 2 >= st.len() {
                    return None;
                }
                let a = parse_partial(st[i])?;
                let b = parse_partial(st[i + 2])?;
                if a.n > 0 {
                    comps.push(c(">=", mk(a.mj, a.mn, a.p, if a.n == 3 { &a.pre } else { &[] })));
                }
                match b.n {
                    3 => comps.push(c("<=", mk(b.mj, b.mn, b.p, &b.pre))),
                    2 => comps.push(c("<", mk(b.mj, b.mn + 1, 0, &[]))),
                    1 => comps.push(c("<", mk(b.mj + 1, 0, 0, &[]))),
                    _ => {}
                }
                i += 3;
                continue;
            }
            let t = st[i];
            if t == "-" {
                return None;
            }
            let op = OPS.iter().find(|o| t.starts_with(**o)).copied().unwrap_or("");
            let p = parse_partial(&t[op.len()..])?;
            comps.extend(term_comps(op, &p));
            i += 1;
        }
        out.push(comps);
    }
    Some(out)
}

fn holds(cm: &Comp, v: &Ver) -> bool {
    let k = cmp_ver(v, &cm.v);
    match cm.op {
        ">=" => k != Ordering::Less,
        ">" => k == Ordering::Greater,
        "<" => k == Ordering::Less,
        "<=" => k != Ordering::Greater,
        _ => k == Ordering::Equal,
    }
}

fn satisfies(rng: &[Vec<Comp>], v: &Ver) -> bool {
    for comps in rng {
        if !comps.iter().all(|cm| holds(cm, v)) {
            continue;
        }
        if !v.pre.is_empty() && !comps.iter().any(|cm| !cm.v.pre.is_empty() && cm.v.n == v.n) {
            continue;
        }
        return true;
    }
    false
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut out = String::new();
    let mut pool: Vec<(String, Ver)> = Vec::new();
    for line in input.split('\n') {
        let t: Vec<&str> = line.split(|ch| ch == ' ' || ch == '\t').filter(|x| !x.is_empty()).collect();
        if t.is_empty() {
            continue;
        }
        let cmd = t[0];
        if cmd == "pool" {
            let mut seen = HashSet::new();
            pool.clear();
            let mut skipped = 0;
            for a in &t[1..] {
                match parse_version(a) {
                    None => skipped += 1,
                    Some(v) => {
                        if seen.insert(a.to_string()) {
                            pool.push((a.to_string(), v));
                        }
                    }
                }
            }
            pool.sort_by(|x, y| cmp_ver(&x.1, &y.1));
            out.push_str(&format!("pool {} skipped {}\n", pool.len(), skipped));
        } else if cmd == "max" || cmd == "all" {
            match parse_range(&t[1..]) {
                None => out.push_str("invalid range\n"),
                Some(r) => {
                    let res: Vec<&str> = pool.iter().filter(|e| satisfies(&r, &e.1)).map(|e| e.0.as_str()).collect();
                    if res.is_empty() {
                        out.push_str("none\n");
                    } else if cmd == "max" {
                        out.push_str(res[res.len() - 1]);
                        out.push('\n');
                    } else {
                        out.push_str(&res.join(" "));
                        out.push('\n');
                    }
                }
            }
        } else if cmd == "test" && t.len() >= 2 {
            match parse_version(t[1]) {
                None => out.push_str("invalid version\n"),
                Some(v) => match parse_range(&t[2..]) {
                    None => out.push_str("invalid range\n"),
                    Some(r) => out.push_str(if satisfies(&r, &v) { "true\n" } else { "false\n" }),
                },
            }
        } else {
            out.push_str("error: bad command\n");
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
