import {stdin, stdout, read_line} from "@std/io.ms"
import {Set, MapEntry} from "@std/collections.ms"

fn is_name(s: String) -> Bool:
    let codes = s.scalar_values()
    if codes.is_empty():
        return false
    var i = 0
    for c in codes:
        let lower = c >= 97 and c <= 122
        let other = (c >= 48 and c <= 57) or c == 95
        if i == 0 and not lower:
            return false
        if not lower and not other:
            return false
        i = i + 1
    return true

# "section.key" with both halves valid names.
fn is_qualified(s: String) -> Bool:
    let parts = s.split(".")
    return parts.length() == 2 and is_name(parts.at(0).unwrap()) and is_name(parts.at(1).unwrap())

type Config:
    values: Map[String, String]
    done: Map[String, String]
    active: Set[String]

fn char_at(chars: List[String], i: Int) -> String:
    let c = chars.at(i)
    if c.is_none():
        return ""
    return c.unwrap()

fn resolve(cfg: Config, key: String) -> Result[String, String]:
    let cached = cfg.done.get(key)
    if cached.is_some():
        return ok(cached.unwrap())
    if cfg.active.contains(key):
        return error("{key}: cycle")
    cfg.active.add(key)
    let chars = cfg.values.get(key).unwrap().chars()
    let out = List[String]()
    var i = 0
    while i < chars.length():
        let c = chars.at(i).unwrap()
        let next = char_at(chars, i + 1)
        if c == "$" and next == "$":
            out.append("$")
            i = i + 2
        else if c == "$" and next == "\{":
            var j = i + 2
            while j < chars.length() and chars.at(j).unwrap() != "\}":
                j = j + 1
            if j >= chars.length():
                return error("{key}: bad reference")
            let reference = chars.slice(i + 2, j).join("")
            if not is_qualified(reference):
                return error("{key}: bad reference")
            if not cfg.values.contains(reference):
                return error("{key}: unknown reference $\{{reference}\}")
            let value = try resolve(cfg, reference)
            out.append(value)
            i = j + 1
        else:
            out.append(c)
            i = i + 1
    cfg.active.remove(key)
    let text = out.join("")
    cfg.done.add(key: key, value: text)
    return ok(text)

fn trim_spaces(s: String) -> String:
    var chars = s.chars()
    var start = 0
    var end = chars.length()
    while start < end and chars.at(start).unwrap() == " ":
        start = start + 1
    while end > start and chars.at(end - 1).unwrap() == " ":
        end = end - 1
    return chars.slice(start, end).join("")

# Applies one trimmed line; returns an error message ("" when fine).
type Parser:
    values: Map[String, String]
    layer: String
    have_layer: Bool
    section: String

fn apply_line(p: Parser, l: String, line_no: Int) -> String:
    var name = p.layer
    if not p.have_layer:
        name = "input"
    let where = "{name}:{line_no}"
    if not p.have_layer:
        return "{where}: expected layer header"
    if l.starts_with("["):
        let inner = l.slice(1, l.length() - 1)
        if not l.ends_with("]") or l.length() < 2 or not is_name(inner):
            return "{where}: bad section name"
        p.section = inner
        return ""
    if l.starts_with("@"):
        if not l.starts_with("@unset "):
            return "{where}: bad directive"
        let target = l.slice(7, l.length())
        if not is_qualified(target):
            return "{where}: bad directive"
        if p.values.contains(target):
            p.values.without(target)
        return ""
    let at = l.index_of("=")
    if at.is_some():
        let key = trim_spaces(l.slice(0, at.unwrap()))
        if not is_name(key):
            return "{where}: bad key"
        p.values.add(key: "{p.section}.{key}", value: trim_spaces(l.slice(at.unwrap() + 1, l.length())))
        return ""
    return "{where}: invalid line"

fn run() -> Result[Unit, Error]:
    let parser = Parser(values: Map[String, String](), layer: "", have_layer: false, section: "global")
    var line_no = 0
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        line_no = line_no + 1
        let l = trim_spaces(next.unwrap())
        if l.starts_with("--- ") and not trim_spaces(l.slice(4, l.length())).is_empty():
            parser.layer = trim_spaces(l.slice(4, l.length()))
            parser.have_layer = true
            parser.section = "global"
            continue
        if l.is_empty() or l.starts_with("#"):
            continue
        let problem = apply_line(parser, l, line_no)
        if not problem.is_empty():
            try stdout().write("error: {problem}\n".to_bytes())
            return stdout().flush()
    let cfg = Config(values: parser.values, done: Map[String, String](), active: Set[String]())
    let keys = cfg.values.keys().sorted(compare: fn(a: String, b: String) -> Int:
        return a.compare(b)
    )
    for k in keys:
        let outcome = resolve(cfg, k)
        if outcome.is_error():
            try stdout().write("error: {outcome.unwrap_error()}\n".to_bytes())
            return stdout().flush()
    var current = ""
    var first = true
    for k in keys:
        let dot = k.index_of(".").unwrap()
        let section = k.slice(0, dot)
        if first or section != current:
            if not first:
                try stdout().write("\n".to_bytes())
            try stdout().write("[{section}]\n".to_bytes())
            current = section
            first = false
        try stdout().write("{k.slice(dot + 1, k.length())} = {cfg.done.get(k).unwrap()}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
