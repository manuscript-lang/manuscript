package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strings"
)

func isName(s string) bool {
	if s == "" || s[0] < 'a' || s[0] > 'z' {
		return false
	}
	for i := 1; i < len(s); i++ {
		c := s[i]
		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') {
			return false
		}
	}
	return true
}

func trim(s string) string { return strings.Trim(s, " ") }

var cfg = map[string]string{}
var done = map[string]string{}
var active = map[string]bool{}

type failure struct{ msg string }

func resolve(key string) string {
	if v, ok := done[key]; ok {
		return v
	}
	if active[key] {
		panic(failure{key + ": cycle"})
	}
	active[key] = true
	raw := []rune(cfg[key])
	var out strings.Builder
	i := 0
	for i < len(raw) {
		switch {
		case raw[i] == '$' && i+1 < len(raw) && raw[i+1] == '$':
			out.WriteRune('$')
			i += 2
		case raw[i] == '$' && i+1 < len(raw) && raw[i+1] == '{':
			j := i + 2
			for j < len(raw) && raw[j] != '}' {
				j++
			}
			if j >= len(raw) {
				panic(failure{key + ": bad reference"})
			}
			ref := string(raw[i+2 : j])
			parts := strings.Split(ref, ".")
			if len(parts) != 2 || !isName(parts[0]) || !isName(parts[1]) {
				panic(failure{key + ": bad reference"})
			}
			if _, ok := cfg[ref]; !ok {
				panic(failure{key + ": unknown reference ${" + ref + "}"})
			}
			out.WriteString(resolve(ref))
			i = j + 1
		default:
			out.WriteRune(raw[i])
			i++
		}
	}
	delete(active, key)
	done[key] = out.String()
	return done[key]
}

func parse(lines []string) string {
	layer, section := "", "global"
	haveLayer := false
	for i, raw := range lines {
		l := trim(raw)
		if strings.HasPrefix(l, "--- ") && trim(l[4:]) != "" {
			layer, section, haveLayer = trim(l[4:]), "global", true
			continue
		}
		if l == "" || strings.HasPrefix(l, "#") {
			continue
		}
		name := layer
		if !haveLayer {
			name = "input"
		}
		where := fmt.Sprintf("%s:%d", name, i+1)
		if !haveLayer {
			return "error: " + where + ": expected layer header"
		}
		switch {
		case strings.HasPrefix(l, "["):
			if !strings.HasSuffix(l, "]") || len(l) < 2 || !isName(l[1:len(l)-1]) {
				return "error: " + where + ": bad section name"
			}
			section = l[1 : len(l)-1]
		case strings.HasPrefix(l, "@"):
			target := strings.TrimPrefix(l, "@unset ")
			parts := strings.Split(target, ".")
			if target == l || len(parts) != 2 || !isName(parts[0]) || !isName(parts[1]) {
				return "error: " + where + ": bad directive"
			}
			delete(cfg, target)
		case strings.Contains(l, "="):
			at := strings.Index(l, "=")
			k := trim(l[:at])
			if !isName(k) {
				return "error: " + where + ": bad key"
			}
			cfg[section+"."+k] = trim(l[at+1:])
		default:
			return "error: " + where + ": invalid line"
		}
	}
	return ""
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	var lines []string
	for sc.Scan() {
		lines = append(lines, sc.Text())
	}
	if msg := parse(lines); msg != "" {
		fmt.Println(msg)
		return
	}
	keys := make([]string, 0, len(cfg))
	for k := range cfg {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	var problem string
	func() {
		defer func() {
			if r := recover(); r != nil {
				f, ok := r.(failure)
				if !ok {
					panic(r)
				}
				problem = f.msg
			}
		}()
		for _, k := range keys {
			resolve(k)
		}
	}()
	if problem != "" {
		fmt.Println("error: " + problem)
		return
	}
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	cur := ""
	first := true
	for _, k := range keys {
		dot := strings.Index(k, ".")
		sec := k[:dot]
		if first || sec != cur {
			if !first {
				fmt.Fprintln(w)
			}
			fmt.Fprintf(w, "[%s]\n", sec)
			cur, first = sec, false
		}
		fmt.Fprintf(w, "%s = %s\n", k[dot+1:], done[k])
	}
}
