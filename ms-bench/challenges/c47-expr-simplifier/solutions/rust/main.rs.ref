use std::io::{self, Read, Write};
use std::rc::Rc;

#[derive(Clone, PartialEq)]
enum E {
    Num(i64),
    Var(String),
    Add(Rc<E>, Rc<E>),
    Sub(Rc<E>, Rc<E>),
    Mul(Rc<E>, Rc<E>),
    Neg(Rc<E>),
    Pow(Rc<E>, i64),
}
use E::*;

type P = Rc<E>;

fn rc(e: E) -> P {
    Rc::new(e)
}

struct Syn;

fn tokenize(line: &str) -> Vec<String> {
    let b = line.as_bytes();
    let mut toks = Vec::new();
    let mut i = 0;
    while i < b.len() {
        let c = b[i];
        if c == b' ' || c == b'\t' {
            i += 1;
        } else if c == b'(' || c == b')' {
            toks.push((c as char).to_string());
            i += 1;
        } else {
            let mut j = i;
            while j < b.len() && !matches!(b[j], b' ' | b'\t' | b'(' | b')') {
                j += 1;
            }
            toks.push(line[i..j].to_string());
            i = j;
        }
    }
    toks
}

fn all_digits(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|c| c.is_ascii_digit())
}

fn is_ident(s: &str) -> bool {
    let b = s.as_bytes();
    !b.is_empty()
        && b[0].is_ascii_lowercase()
        && b[1..].iter().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || *c == b'_')
}

fn atom(t: &str) -> Result<P, Syn> {
    let body = t.strip_prefix('-').unwrap_or(t);
    if all_digits(body) {
        return t.parse::<i64>().map(|v| rc(Num(v))).map_err(|_| Syn);
    }
    if is_ident(t) {
        return Ok(rc(Var(t.to_string())));
    }
    Err(Syn)
}

fn parse(toks: &[String], pos: &mut usize) -> Result<P, Syn> {
    let t = toks.get(*pos).ok_or(Syn)?.clone();
    *pos += 1;
    if t == ")" {
        return Err(Syn);
    }
    if t != "(" {
        return atom(&t);
    }
    let head = toks.get(*pos).ok_or(Syn)?.clone();
    *pos += 1;
    if !matches!(head.as_str(), "+" | "-" | "*" | "neg" | "^") {
        return Err(Syn);
    }
    let mut args: Vec<P> = Vec::new();
    let mut exp: i64 = 0;
    let mut nargs = 0;
    loop {
        let cur = toks.get(*pos).ok_or(Syn)?;
        if cur == ")" {
            break;
        }
        if head == "^" && nargs == 1 {
            if !all_digits(cur) {
                return Err(Syn);
            }
            exp = cur.parse::<i64>().map_err(|_| Syn)?;
            *pos += 1;
        } else {
            args.push(parse(toks, pos)?);
        }
        nargs += 1;
    }
    *pos += 1;
    match (head.as_str(), nargs) {
        ("neg", 1) => Ok(rc(Neg(args[0].clone()))),
        ("^", 2) => Ok(rc(Pow(args[0].clone(), exp))),
        ("+", 2) => Ok(rc(Add(args[0].clone(), args[1].clone()))),
        ("-", 2) => Ok(rc(Sub(args[0].clone(), args[1].clone()))),
        ("*", 2) => Ok(rc(Mul(args[0].clone(), args[1].clone()))),
        _ => Err(Syn),
    }
}

fn is_n(e: &P, v: i64) -> bool {
    matches!(&**e, Num(k) if *k == v)
}

fn ipow(k: i64, n: i64) -> i64 {
    let mut r = 1i64;
    for _ in 0..n {
        r *= k;
    }
    r
}

fn simp(e: &P) -> P {
    match &**e {
        Num(_) | Var(_) => e.clone(),
        Neg(a) => rw(rc(Neg(simp(a)))),
        Pow(a, n) => rw(rc(Pow(simp(a), *n))),
        Add(a, b) => rw(rc(Add(simp(a), simp(b)))),
        Sub(a, b) => rw(rc(Sub(simp(a), simp(b)))),
        Mul(a, b) => rw(rc(Mul(simp(a), simp(b)))),
    }
}

fn rw(e: P) -> P {
    match &*e {
        Add(l, r) => {
            if let (Num(a), Num(b)) = (&**l, &**r) {
                return rc(Num(a + b));
            }
            if is_n(l, 0) {
                return r.clone();
            }
            if is_n(r, 0) {
                return l.clone();
            }
            if l == r {
                return simp(&rc(Mul(rc(Num(2)), l.clone())));
            }
            if let Neg(x) = &**r {
                return simp(&rc(Sub(l.clone(), x.clone())));
            }
            if let Neg(x) = &**l {
                return simp(&rc(Sub(r.clone(), x.clone())));
            }
        }
        Sub(l, r) => {
            if let (Num(a), Num(b)) = (&**l, &**r) {
                return rc(Num(a - b));
            }
            if is_n(r, 0) {
                return l.clone();
            }
            if is_n(l, 0) {
                return simp(&rc(Neg(r.clone())));
            }
            if l == r {
                return rc(Num(0));
            }
            if let Neg(x) = &**r {
                return simp(&rc(Add(l.clone(), x.clone())));
            }
        }
        Mul(l, r) => {
            if let (Num(a), Num(b)) = (&**l, &**r) {
                return rc(Num(a * b));
            }
            if is_n(l, 0) || is_n(r, 0) {
                return rc(Num(0));
            }
            if is_n(l, 1) {
                return r.clone();
            }
            if is_n(r, 1) {
                return l.clone();
            }
            if is_n(l, -1) {
                return simp(&rc(Neg(r.clone())));
            }
            if is_n(r, -1) {
                return simp(&rc(Neg(l.clone())));
            }
            if l == r {
                return simp(&rc(Pow(l.clone(), 2)));
            }
            if let Num(_) = &**r {
                return simp(&rc(Mul(r.clone(), l.clone())));
            }
            if let (Neg(x), Neg(y)) = (&**l, &**r) {
                return simp(&rc(Mul(x.clone(), y.clone())));
            }
            if let Neg(x) = &**l {
                return simp(&rc(Neg(rc(Mul(x.clone(), r.clone())))));
            }
            if let Neg(y) = &**r {
                return simp(&rc(Neg(rc(Mul(l.clone(), y.clone())))));
            }
            if let (Pow(x, a), Pow(y, b)) = (&**l, &**r) {
                if x == y {
                    return simp(&rc(Pow(x.clone(), a + b)));
                }
            }
            if let Pow(x, a) = &**l {
                if x == r {
                    return simp(&rc(Pow(r.clone(), a + 1)));
                }
            }
            if let Pow(y, b) = &**r {
                if y == l {
                    return simp(&rc(Pow(l.clone(), b + 1)));
                }
            }
        }
        Neg(x) => match &**x {
            Num(k) => return rc(Num(-k)),
            Neg(y) => return y.clone(),
            Sub(a, b) => return simp(&rc(Sub(b.clone(), a.clone()))),
            _ => {}
        },
        Pow(b, n) => {
            let n = *n;
            if n == 0 {
                return rc(Num(1));
            }
            if n == 1 {
                return b.clone();
            }
            match &**b {
                Num(k) => return rc(Num(ipow(*k, n))),
                Pow(x, m) => return simp(&rc(Pow(x.clone(), m * n))),
                Neg(x) => {
                    if n % 2 == 0 {
                        return simp(&rc(Pow(x.clone(), n)));
                    }
                    return simp(&rc(Neg(rc(Pow(x.clone(), n)))));
                }
                _ => {}
            }
        }
        _ => {}
    }
    e
}

fn show(e: &E, out: &mut String) {
    match e {
        Num(n) => out.push_str(&n.to_string()),
        Var(v) => out.push_str(v),
        Neg(a) => {
            out.push_str("(neg ");
            show(a, out);
            out.push(')');
        }
        Pow(a, n) => {
            out.push_str("(^ ");
            show(a, out);
            out.push_str(&format!(" {})", n));
        }
        Add(a, b) | Sub(a, b) | Mul(a, b) => {
            let op = match e {
                Add(..) => "+",
                Sub(..) => "-",
                _ => "*",
            };
            out.push_str(&format!("({} ", op));
            show(a, out);
            out.push(' ');
            show(b, out);
            out.push(')');
        }
    }
}

fn run_line(line: &str) -> String {
    let toks = tokenize(line);
    let mut pos = 0;
    let r = parse(&toks, &mut pos).and_then(|e| if pos < toks.len() { Err(Syn) } else { Ok(e) });
    match r {
        Ok(e) => {
            let mut s = String::new();
            show(&simp(&e), &mut s);
            s
        }
        Err(Syn) => "error: syntax".to_string(),
    }
}

fn main() {
    let mut s = String::new();
    io::stdin().read_to_string(&mut s).unwrap();
    let mut out = String::new();
    for line in s.split('\n') {
        if line.trim_matches(|c| c == ' ' || c == '\t').is_empty() {
            continue;
        }
        out.push_str(&run_line(line));
        out.push('\n');
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
