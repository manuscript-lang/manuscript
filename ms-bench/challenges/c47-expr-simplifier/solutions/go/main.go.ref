package main

import (
	"bufio"
	"fmt"
	"os"
	"strconv"
	"strings"
)

type kind int

const (
	kNum kind = iota
	kVar
	kAdd
	kSub
	kMul
	kNeg
	kPow
)

type expr struct {
	k    kind
	n    int64 // number value, or exponent for kPow
	name string
	a, b *expr // operands: a (left / base / operand), b (right)
}

type syntaxError struct{}

func num(n int64) *expr          { return &expr{k: kNum, n: n} }
func bin(k kind, a, b *expr) *expr { return &expr{k: k, a: a, b: b} }
func neg(a *expr) *expr          { return &expr{k: kNeg, a: a} }
func pow(a *expr, n int64) *expr { return &expr{k: kPow, a: a, n: n} }

func eq(x, y *expr) bool {
	if x.k != y.k {
		return false
	}
	switch x.k {
	case kNum:
		return x.n == y.n
	case kVar:
		return x.name == y.name
	case kNeg:
		return eq(x.a, y.a)
	case kPow:
		return x.n == y.n && eq(x.a, y.a)
	}
	return eq(x.a, y.a) && eq(x.b, y.b)
}

func isNum(e *expr, v int64) bool { return e.k == kNum && e.n == v }

func tokenize(line string) []string {
	var toks []string
	i := 0
	for i < len(line) {
		c := line[i]
		switch {
		case c == ' ' || c == '\t':
			i++
		case c == '(' || c == ')':
			toks = append(toks, string(c))
			i++
		default:
			j := i
			for j < len(line) && line[j] != ' ' && line[j] != '\t' && line[j] != '(' && line[j] != ')' {
				j++
			}
			toks = append(toks, line[i:j])
			i = j
		}
	}
	return toks
}

func allDigits(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

func isIdent(s string) bool {
	if s == "" || s[0] < 'a' || s[0] > 'z' {
		return false
	}
	for i := 1; i < len(s); i++ {
		c := s[i]
		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_') {
			return false
		}
	}
	return true
}

type parser struct {
	toks []string
	pos  int
}

func (p *parser) next() string {
	if p.pos >= len(p.toks) {
		panic(syntaxError{})
	}
	t := p.toks[p.pos]
	p.pos++
	return t
}

func atom(t string) *expr {
	body := strings.TrimPrefix(t, "-")
	if allDigits(body) {
		v, err := strconv.ParseInt(t, 10, 64)
		if err != nil {
			panic(syntaxError{})
		}
		return num(v)
	}
	if isIdent(t) {
		return &expr{k: kVar, name: t}
	}
	panic(syntaxError{})
}

func (p *parser) expr() *expr {
	t := p.next()
	if t == ")" {
		panic(syntaxError{})
	}
	if t != "(" {
		return atom(t)
	}
	head := p.next()
	switch head {
	case "+", "-", "*", "neg", "^":
	default:
		panic(syntaxError{})
	}
	var args []*expr
	var exp int64
	nargs := 0
	for {
		if p.pos >= len(p.toks) {
			panic(syntaxError{})
		}
		if p.toks[p.pos] == ")" {
			break
		}
		if head == "^" && nargs == 1 {
			t2 := p.next()
			if !allDigits(t2) {
				panic(syntaxError{})
			}
			v, err := strconv.ParseInt(t2, 10, 64)
			if err != nil {
				panic(syntaxError{})
			}
			exp = v
		} else {
			args = append(args, p.expr())
		}
		nargs++
	}
	p.pos++
	switch {
	case head == "neg" && nargs == 1:
		return neg(args[0])
	case head == "^" && nargs == 2:
		return pow(args[0], exp)
	case nargs == 2 && head == "+":
		return bin(kAdd, args[0], args[1])
	case nargs == 2 && head == "-":
		return bin(kSub, args[0], args[1])
	case nargs == 2 && head == "*":
		return bin(kMul, args[0], args[1])
	}
	panic(syntaxError{})
}

func ipow(k, n int64) int64 {
	r := int64(1)
	for i := int64(0); i < n; i++ {
		r *= k
	}
	return r
}

func simp(e *expr) *expr {
	switch e.k {
	case kNum, kVar:
		return e
	case kNeg:
		return rw(neg(simp(e.a)))
	case kPow:
		return rw(pow(simp(e.a), e.n))
	}
	return rw(bin(e.k, simp(e.a), simp(e.b)))
}

func rw(e *expr) *expr {
	switch e.k {
	case kAdd:
		l, r := e.a, e.b
		switch {
		case l.k == kNum && r.k == kNum:
			return num(l.n + r.n)
		case isNum(l, 0):
			return r
		case isNum(r, 0):
			return l
		case eq(l, r):
			return simp(bin(kMul, num(2), l))
		case r.k == kNeg:
			return simp(bin(kSub, l, r.a))
		case l.k == kNeg:
			return simp(bin(kSub, r, l.a))
		}
	case kSub:
		l, r := e.a, e.b
		switch {
		case l.k == kNum && r.k == kNum:
			return num(l.n - r.n)
		case isNum(r, 0):
			return l
		case isNum(l, 0):
			return simp(neg(r))
		case eq(l, r):
			return num(0)
		case r.k == kNeg:
			return simp(bin(kAdd, l, r.a))
		}
	case kMul:
		l, r := e.a, e.b
		switch {
		case l.k == kNum && r.k == kNum:
			return num(l.n * r.n)
		case isNum(l, 0) || isNum(r, 0):
			return num(0)
		case isNum(l, 1):
			return r
		case isNum(r, 1):
			return l
		case isNum(l, -1):
			return simp(neg(r))
		case isNum(r, -1):
			return simp(neg(l))
		case eq(l, r):
			return simp(pow(l, 2))
		case r.k == kNum:
			return simp(bin(kMul, r, l))
		case l.k == kNeg && r.k == kNeg:
			return simp(bin(kMul, l.a, r.a))
		case l.k == kNeg:
			return simp(neg(bin(kMul, l.a, r)))
		case r.k == kNeg:
			return simp(neg(bin(kMul, l, r.a)))
		case l.k == kPow && r.k == kPow && eq(l.a, r.a):
			return simp(pow(l.a, l.n+r.n))
		case l.k == kPow && eq(l.a, r):
			return simp(pow(r, l.n+1))
		case r.k == kPow && eq(r.a, l):
			return simp(pow(l, r.n+1))
		}
	case kNeg:
		x := e.a
		switch x.k {
		case kNum:
			return num(-x.n)
		case kNeg:
			return x.a
		case kSub:
			return simp(bin(kSub, x.b, x.a))
		}
	case kPow:
		b, n := e.a, e.n
		switch {
		case n == 0:
			return num(1)
		case n == 1:
			return b
		case b.k == kNum:
			return num(ipow(b.n, n))
		case b.k == kPow:
			return simp(pow(b.a, b.n*n))
		case b.k == kNeg:
			if n%2 == 0 {
				return simp(pow(b.a, n))
			}
			return simp(neg(pow(b.a, n)))
		}
	}
	return e
}

func show(e *expr, sb *strings.Builder) {
	switch e.k {
	case kNum:
		sb.WriteString(strconv.FormatInt(e.n, 10))
	case kVar:
		sb.WriteString(e.name)
	case kNeg:
		sb.WriteString("(neg ")
		show(e.a, sb)
		sb.WriteString(")")
	case kPow:
		sb.WriteString("(^ ")
		show(e.a, sb)
		sb.WriteString(" " + strconv.FormatInt(e.n, 10) + ")")
	default:
		op := map[kind]string{kAdd: "+", kSub: "-", kMul: "*"}[e.k]
		sb.WriteString("(" + op + " ")
		show(e.a, sb)
		sb.WriteString(" ")
		show(e.b, sb)
		sb.WriteString(")")
	}
}

func runLine(line string) (res string) {
	defer func() {
		if r := recover(); r != nil {
			if _, ok := r.(syntaxError); ok {
				res = "error: syntax"
				return
			}
			panic(r)
		}
	}()
	p := &parser{toks: tokenize(line)}
	e := p.expr()
	if p.pos < len(p.toks) {
		panic(syntaxError{})
	}
	var sb strings.Builder
	show(simp(e), &sb)
	return sb.String()
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	for sc.Scan() {
		line := sc.Text()
		if strings.Trim(line, " \t") == "" {
			continue
		}
		fmt.Fprintln(out, runLine(line))
	}
}
