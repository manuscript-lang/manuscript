use std::collections::VecDeque;
use std::io::{self, Read, Write};

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut dq: VecDeque<String> = VecDeque::new();
    let mut out = String::new();
    for line in input.split('\n') {
        if line.trim().is_empty() {
            continue;
        }
        let p: Vec<&str> = line.split(' ').collect();
        let show = |v: Option<&String>| v.map(|s| s.as_str()).unwrap_or("empty").to_string();
        match p[0] {
            "push_back" => dq.push_back(p[1].to_string()),
            "push_front" => dq.push_front(p[1].to_string()),
            "pop_back" => {
                let v = dq.pop_back();
                out.push_str(&show(v.as_ref()));
                out.push('\n');
            }
            "pop_front" => {
                let v = dq.pop_front();
                out.push_str(&show(v.as_ref()));
                out.push('\n');
            }
            "back" => {
                out.push_str(&show(dq.back()));
                out.push('\n');
            }
            "front" => {
                out.push_str(&show(dq.front()));
                out.push('\n');
            }
            "size" => out.push_str(&format!("{}\n", dq.len())),
            "dump" => {
                let items: Vec<&str> = dq.iter().map(|s| s.as_str()).collect();
                out.push_str(&format!("[{}]\n", items.join(" ")));
            }
            _ => {}
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
