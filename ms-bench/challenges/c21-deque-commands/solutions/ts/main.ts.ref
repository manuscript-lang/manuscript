import { readFileSync } from "node:fs";

const lines = readFileSync(0, "utf8").split("\n");
// Two stacks would also work; a plain array with an index offset keeps pop_front O(1).
let items: string[] = [];
let head = 0;
const out: string[] = [];
for (const line of lines) {
  if (line.trim() === "") continue;
  const p = line.split(" ");
  const live = items.length - head;
  switch (p[0]) {
    case "push_back": items.push(p[1]); break;
    case "push_front":
      if (head > 0) { head--; items[head] = p[1]; }
      else { items = [p[1], ...items]; }
      break;
    case "pop_back": out.push(live > 0 ? items.pop()! : "empty"); break;
    case "pop_front": out.push(live > 0 ? items[head++] : "empty"); break;
    case "back": out.push(live > 0 ? items[items.length - 1] : "empty"); break;
    case "front": out.push(live > 0 ? items[head] : "empty"); break;
    case "size": out.push(String(live)); break;
    case "dump": out.push("[" + items.slice(head).join(" ") + "]"); break;
  }
}
process.stdout.write(out.map((l) => l + "\n").join(""));
