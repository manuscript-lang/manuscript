import {stdin, stdout, read_line} from "@std/io.ms"

# Parses an optional '-' followed by 1 to 10 ASCII digits.
fn parse_int_field(s: String) -> Optional[Int]:
    let codes = s.scalar_values()
    var start = 0
    if codes.length() > 0 and codes.at(0).unwrap() == 45:
        start = 1
    let count = codes.length() - start
    if count < 1 or count > 10:
        return none
    var n = 0
    var i = start
    while i < codes.length():
        let c = codes.at(i).unwrap()
        if c < 48 or c > 57:
            return none
        n = n * 10 + (c - 48)
        i = i + 1
    if start == 1:
        n = 0 - n
    return some(n)

type Span:
    low: Int
    high: Int

fn fail(message: String) -> Result[Unit, Error]:
    try stdout().write("error: {message}\n".to_bytes())
    return stdout().flush()

fn run() -> Result[Unit, Error]:
    let first = try read_line(input: stdin(), max_bytes: 1048576)
    var mode = ""
    if first.is_some():
        mode = first.unwrap()
    let mt = mode.split(" ")
    var lo = 0
    var hi = 0
    if mode == "merge" or mode == "total":
        lo = 0
    else if mt.length() == 3 and mt.at(0).unwrap() == "gaps":
        let a = parse_int_field(mt.at(1).unwrap())
        let b = parse_int_field(mt.at(2).unwrap())
        if a.is_none() or b.is_none() or a.unwrap() > b.unwrap():
            return fail("bad mode")
        lo = a.unwrap()
        hi = b.unwrap()
    else:
        return fail("bad mode")
    let spans = List[Span]()
    var line_no = 1
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        line_no = line_no + 1
        let line = next.unwrap()
        if line.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        let t = line.split(" ")
        if t.length() != 2:
            return fail("line {line_no}")
        let a = parse_int_field(t.at(0).unwrap())
        let b = parse_int_field(t.at(1).unwrap())
        if a.is_none() or b.is_none() or a.unwrap() > b.unwrap():
            return fail("line {line_no}")
        spans.append(Span(low: a.unwrap(), high: b.unwrap()))
    let ordered = spans.sorted(compare: fn(x: Span, y: Span) -> Int:
        if x.low != y.low:
            if x.low < y.low:
                return -1
            return 1
        if x.high < y.high:
            return -1
        if x.high > y.high:
            return 1
        return 0
    )
    let merged = List[Span]()
    for s in ordered:
        if merged.length() > 0 and s.low <= merged.at(merged.length() - 1).unwrap().high + 1:
            let last = merged.at(merged.length() - 1).unwrap()
            if s.high > last.high:
                last.high = s.high
        else:
            merged.append(Span(low: s.low, high: s.high))
    if mode == "merge":
        for s in merged:
            try stdout().write("{s.low} {s.high}\n".to_bytes())
    else if mode == "total":
        var total = 0
        for s in merged:
            total = total + (s.high - s.low + 1)
        try stdout().write("{total}\n".to_bytes())
    else:
        var cur = lo
        var printed = false
        for s in merged:
            if s.high < cur:
                continue
            if s.low > hi:
                break
            if s.low > cur:
                try stdout().write("{cur} {s.low - 1}\n".to_bytes())
                printed = true
            cur = s.high + 1
            if cur > hi:
                break
        if cur <= hi:
            try stdout().write("{cur} {hi}\n".to_bytes())
            printed = true
        if not printed:
            try stdout().write("none\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
