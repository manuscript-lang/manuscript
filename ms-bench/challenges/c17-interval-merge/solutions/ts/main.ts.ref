import { readFileSync } from "node:fs";

const INT = /^-?[0-9]{1,10}$/;

function fail(msg: string): never {
  process.stdout.write(`error: ${msg}\n`);
  process.exit(0);
}

const lines = readFileSync(0, "utf8").split("\n");
if (lines[lines.length - 1] === "") lines.pop();
const mode = lines[0] ?? "";
const mt = mode.split(" ");
let lo = 0, hi = 0;
if (mode === "merge" || mode === "total") {
  // ok
} else if (mt.length === 3 && mt[0] === "gaps" && INT.test(mt[1]) && INT.test(mt[2]) && Number(mt[1]) <= Number(mt[2])) {
  lo = Number(mt[1]);
  hi = Number(mt[2]);
} else {
  fail("bad mode");
}
const ivs: [number, number][] = [];
for (let i = 1; i < lines.length; i++) {
  const l = lines[i];
  if (l.replace(/ /g, "") === "") continue;
  const t = l.split(" ");
  if (t.length !== 2 || !INT.test(t[0]) || !INT.test(t[1]) || Number(t[0]) > Number(t[1])) fail(`line ${i + 1}`);
  ivs.push([Number(t[0]), Number(t[1])]);
}
ivs.sort((x, y) => x[0] - y[0] || x[1] - y[1]);
const merged: [number, number][] = [];
for (const [a, b] of ivs) {
  const last = merged[merged.length - 1];
  if (last && a <= last[1] + 1) last[1] = Math.max(last[1], b);
  else merged.push([a, b]);
}
let out = "";
if (mode === "merge") {
  out = merged.map(([a, b]) => `${a + 0} ${b + 0}\n`).join("");
} else if (mode === "total") {
  out = `${merged.reduce((s, [a, b]) => s + (b - a + 1), 0)}\n`;
} else {
  let cur = lo;
  const gaps: string[] = [];
  for (const [a, b] of merged) {
    if (b < cur) continue;
    if (a > hi) break;
    if (a > cur) gaps.push(`${cur + 0} ${a - 1 + 0}`);
    cur = b + 1;
    if (cur > hi) break;
  }
  if (cur <= hi) gaps.push(`${cur + 0} ${hi + 0}`);
  out = gaps.length ? gaps.join("\n") + "\n" : "none\n";
}
process.stdout.write(out);
