use std::io::{BufRead, Write};

fn parse_int(s: &str) -> Option<i64> {
    let d = s.strip_prefix('-').unwrap_or(s);
    if d.is_empty() || d.len() > 10 || !d.bytes().all(|b| b.is_ascii_digit()) {
        return None;
    }
    s.parse().ok()
}

fn main() {
    let stdin = std::io::stdin();
    let mut lines = stdin.lock().lines().map(|l| l.unwrap());
    let mode = lines.next().unwrap_or_default();
    let mt: Vec<&str> = mode.split(' ').collect();
    let (mut lo, mut hi) = (0i64, 0i64);
    if mode == "merge" || mode == "total" {
    } else if mt.len() == 3 && mt[0] == "gaps" {
        match (parse_int(mt[1]), parse_int(mt[2])) {
            (Some(a), Some(b)) if a <= b => {
                lo = a;
                hi = b;
            }
            _ => {
                println!("error: bad mode");
                return;
            }
        }
    } else {
        println!("error: bad mode");
        return;
    }
    let mut ivs: Vec<(i64, i64)> = Vec::new();
    for (i, l) in lines.enumerate() {
        if l.trim_matches(' ').is_empty() {
            continue;
        }
        let t: Vec<&str> = l.split(' ').collect();
        let parsed = if t.len() == 2 { (parse_int(t[0]), parse_int(t[1])) } else { (None, None) };
        match parsed {
            (Some(a), Some(b)) if a <= b => ivs.push((a, b)),
            _ => {
                println!("error: line {}", i + 2);
                return;
            }
        }
    }
    ivs.sort();
    let mut merged: Vec<(i64, i64)> = Vec::new();
    for (a, b) in ivs {
        match merged.last_mut() {
            Some(last) if a <= last.1 + 1 => last.1 = last.1.max(b),
            _ => merged.push((a, b)),
        }
    }
    let mut out = String::new();
    if mode == "merge" {
        for (a, b) in &merged {
            out.push_str(&format!("{} {}\n", a, b));
        }
    } else if mode == "total" {
        let total: i64 = merged.iter().map(|(a, b)| b - a + 1).sum();
        out.push_str(&format!("{}\n", total));
    } else {
        let mut cur = lo;
        let mut printed = false;
        for (a, b) in &merged {
            if *b < cur {
                continue;
            }
            if *a > hi {
                break;
            }
            if *a > cur {
                out.push_str(&format!("{} {}\n", cur, a - 1));
                printed = true;
            }
            cur = b + 1;
            if cur > hi {
                break;
            }
        }
        if cur <= hi {
            out.push_str(&format!("{} {}\n", cur, hi));
            printed = true;
        }
        if !printed {
            out.push_str("none\n");
        }
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
