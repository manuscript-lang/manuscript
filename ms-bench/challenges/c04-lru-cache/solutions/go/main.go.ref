package main

import (
	"bufio"
	"container/list"
	"fmt"
	"os"
	"strconv"
	"strings"
)

type entry struct{ key, val string }

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	capacity := -1
	ll := list.New() // front = most recent
	idx := map[string]*list.Element{}
	for sc.Scan() {
		f := strings.Fields(sc.Text())
		if len(f) == 0 {
			continue
		}
		if capacity < 0 {
			capacity, _ = strconv.Atoi(f[0])
			continue
		}
		switch f[0] {
		case "put":
			if e, ok := idx[f[1]]; ok {
				e.Value.(*entry).val = f[2]
				ll.MoveToFront(e)
			} else {
				idx[f[1]] = ll.PushFront(&entry{f[1], f[2]})
				if ll.Len() > capacity {
					last := ll.Back()
					delete(idx, last.Value.(*entry).key)
					ll.Remove(last)
				}
			}
		case "get":
			if e, ok := idx[f[1]]; ok {
				ll.MoveToFront(e)
				fmt.Fprintln(out, e.Value.(*entry).val)
			} else {
				fmt.Fprintln(out, "miss")
			}
		case "keys":
			var ks []string
			for e := ll.Front(); e != nil; e = e.Next() {
				ks = append(ks, e.Value.(*entry).key)
			}
			fmt.Fprintln(out, strings.Join(ks, " "))
		}
	}
}
