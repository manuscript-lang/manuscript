use std::collections::HashMap;
use std::io::{BufRead, Write};

// Recency is a monotonically increasing tick; `order` maps tick -> key so the oldest is the first entry.
fn main() {
    let stdin = std::io::stdin();
    let mut out = std::io::stdout().lock();
    let mut capacity: Option<usize> = None;
    let mut tick: u64 = 0;
    let mut vals: HashMap<String, (String, u64)> = HashMap::new();
    let mut order: std::collections::BTreeMap<u64, String> = std::collections::BTreeMap::new();
    for line in stdin.lock().lines() {
        let line = line.unwrap();
        let f: Vec<&str> = line.split_whitespace().collect();
        if f.is_empty() {
            continue;
        }
        let cap = match capacity {
            None => {
                capacity = Some(f[0].parse().unwrap());
                continue;
            }
            Some(c) => c,
        };
        match f[0] {
            "put" => {
                tick += 1;
                if let Some((_, t)) = vals.get(f[1]) {
                    order.remove(t);
                }
                vals.insert(f[1].to_string(), (f[2].to_string(), tick));
                order.insert(tick, f[1].to_string());
                if vals.len() > cap {
                    let (&t, k) = order.iter().next().unwrap();
                    let k = k.clone();
                    order.remove(&t);
                    vals.remove(&k);
                }
            }
            "get" => match vals.get_mut(f[1]) {
                Some((v, t)) => {
                    order.remove(t);
                    tick += 1;
                    *t = tick;
                    order.insert(tick, f[1].to_string());
                    writeln!(out, "{}", v).unwrap();
                }
                None => writeln!(out, "miss").unwrap(),
            },
            "keys" => {
                let ks: Vec<&str> = order.values().rev().map(|s| s.as_str()).collect();
                writeln!(out, "{}", ks.join(" ")).unwrap();
            }
            _ => {}
        }
    }
}
