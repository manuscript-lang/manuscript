import { readFileSync } from "node:fs";

const lines = readFileSync(0, "utf8").split("\n").filter((l) => l.trim() !== "");
const capacity = parseInt(lines[0], 10);
// A Map iterates in insertion order, so delete+set moves a key to "most recent" (the end).
const cache = new Map<string, string>();
const out: string[] = [];
for (const line of lines.slice(1)) {
  const [cmd, k, v] = line.trim().split(/\s+/);
  if (cmd === "put") {
    cache.delete(k);
    cache.set(k, v);
    if (cache.size > capacity) cache.delete(cache.keys().next().value as string);
  } else if (cmd === "get") {
    if (cache.has(k)) {
      const val = cache.get(k)!;
      cache.delete(k);
      cache.set(k, val);
      out.push(val);
    } else out.push("miss");
  } else if (cmd === "keys") {
    out.push([...cache.keys()].reverse().join(" "));
  }
}
process.stdout.write(out.map((l) => l + "\n").join(""));
