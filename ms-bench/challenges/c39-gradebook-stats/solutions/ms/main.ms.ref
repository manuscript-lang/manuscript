import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Assignment:
    name: String
    max: Int
    w: Int

type Student:
    name: String
    scores: Map[String, Int]
    final: Int

type Book:
    assigns: List[Assignment]
    students: List[Student]
    out: StringBuilder

fn fields(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").unwrap()
    return spaced.split(" ").filter(fn(part: String) -> Bool:
        return not part.is_empty()
    )

fn all_digits(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn emit(b: Book, text: String) -> Unit:
    b.out.append(text)
    b.out.append("\n")

fn tenths(v: Int) -> String:
    return "{v / 10}.{v % 10}"

fn letter(f: Int) -> String:
    if f >= 900:
        return "A"
    if f >= 800:
        return "B"
    if f >= 700:
        return "C"
    if f >= 600:
        return "D"
    return "F"

fn find_assignment(b: Book, name: String) -> Optional[Assignment]:
    for a in b.assigns:
        if a.name == name:
            return some(a)
    return none

fn find_student(b: Book, name: String) -> Optional[Student]:
    for s in b.students:
        if s.name == name:
            return some(s)
    return none

# Assignment score in tenths of a percent; a missing score counts as zero.
fn assignment_tenths(s: Student, a: Assignment) -> Int:
    let p = s.scores.get_or(key: a.name, fallback: 0)
    return (2000 * p + a.max) / (2 * a.max)

fn report(b: Book) -> Unit:
    if b.students.is_empty():
        return emit(b, "no students")
    var total = 0
    for a in b.assigns:
        total = total + a.w
    for s in b.students:
        var weighted = 0
        for a in b.assigns:
            weighted = weighted + a.w * assignment_tenths(s, a)
        s.final = 0
        if total > 0:
            s.final = (2 * weighted + total) / (2 * total)
    let ordered = b.students.sorted(compare: fn(x: Student, y: Student) -> Int:
        if x.final != y.final:
            return y.final - x.final
        return x.name.compare(y.name)
    )
    var sum = 0
    let counts = Map[String, Int]()
    let vals = List[Int]()
    for s in ordered:
        var rank = 1
        for o in ordered:
            if o.final > s.final:
                rank = rank + 1
        emit(b, "{rank} {s.name} {tenths(s.final)} {letter(s.final)}")
        sum = sum + s.final
        vals.append(s.final)
        counts.add(key: letter(s.final), value: counts.get_or(key: letter(s.final), fallback: 0) + 1)
    vals.reverse()
    let n = vals.length()
    var median = vals.at(n / 2).unwrap()
    if n % 2 == 0:
        median = (vals.at(n / 2 - 1).unwrap() + vals.at(n / 2).unwrap() + 1) / 2
    let lo = vals.at(0).unwrap()
    let hi = vals.at(n - 1).unwrap()
    emit(b, "class: n={n} min={tenths(lo)} max={tenths(hi)} mean={tenths((2 * sum + n) / (2 * n))} median={tenths(median)}")
    let g = fn(k: String) -> Int:
        return counts.get_or(key: k, fallback: 0)
    emit(b, "grades: A={g("A")} B={g("B")} C={g("C")} D={g("D")} F={g("F")}")
    let by_name = b.assigns.sorted(compare: fn(x: Assignment, y: Assignment) -> Int:
        return x.name.compare(y.name)
    )
    for a in by_name:
        var sm = 0
        for s in b.students:
            sm = sm + assignment_tenths(s, a)
        emit(b, "assignment {a.name} mean={tenths((2 * sm + n) / (2 * n))}")

fn arity(c: String) -> Int:
    if c == "assign" or c == "score":
        return 4
    if c == "student":
        return 2
    if c == "report":
        return 1
    return 0

fn step(b: Book, t: List[String]) -> Unit:
    let c = t.at(0).unwrap()
    if arity(c) != t.length():
        return emit(b, "error: bad command")
    if c == "report":
        return report(b)
    let name = t.at(1).unwrap()
    if c == "assign":
        let mx = t.at(2).unwrap()
        let w = t.at(3).unwrap()
        if not all_digits(mx) or not all_digits(w) or mx.parse_int().unwrap_or(0) == 0 or w.parse_int().unwrap_or(0) == 0:
            return emit(b, "error: bad number")
        if find_assignment(b, name).is_some():
            return emit(b, "error: assignment exists {name}")
        b.assigns.append(Assignment(name: name, max: mx.parse_int().unwrap(), w: w.parse_int().unwrap()))
        return emit(b, "ok")
    if c == "student":
        if find_student(b, name).is_some():
            return emit(b, "error: student exists {name}")
        b.students.append(Student(name: name, scores: Map[String, Int](), final: 0))
        return emit(b, "ok")
    let student = find_student(b, name)
    if student.is_none():
        return emit(b, "error: unknown student {name}")
    let aname = t.at(2).unwrap()
    let assignment = find_assignment(b, aname)
    if assignment.is_none():
        return emit(b, "error: unknown assignment {aname}")
    let points = t.at(3).unwrap()
    if not all_digits(points) or points.parse_int().unwrap_or(1000000000) > assignment.unwrap().max:
        return emit(b, "error: bad points")
    student.unwrap().scores.add(key: aname, value: points.parse_int().unwrap())
    emit(b, "ok")

fn run() -> Result[Unit, Error]:
    let b = Book(assigns: List[Assignment](), students: List[Student](), out: StringBuilder())
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let t = fields(next.unwrap())
        if t.is_empty():
            continue
        step(b, t)
    try stdout().write(b.out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
