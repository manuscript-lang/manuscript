import { readFileSync } from "node:fs";

const assigns = new Map<string, { max: number; w: number }>();
const students = new Map<string, Map<string, number>>();
const out: string[] = [];
const arity: Record<string, number> = { assign: 4, student: 2, score: 4, report: 1 };
const digits = (s: string) => /^[0-9]+$/.test(s);
const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
const fmt = (v: number) => `${Math.floor(v / 10)}.${v % 10}`;
const letter = (f: number) => (f >= 900 ? "A" : f >= 800 ? "B" : f >= 700 ? "C" : f >= 600 ? "D" : "F");

for (const line of readFileSync(0, "utf8").split("\n")) {
  const t = line.split(/[ \t]+/).filter((x) => x !== "");
  if (t.length === 0) continue;
  const c = t[0];
  if (!(c in arity) || t.length !== arity[c]) {
    out.push("error: bad command");
    continue;
  }
  if (c === "assign") {
    if (!digits(t[2]) || !digits(t[3]) || +t[2] === 0 || +t[3] === 0) out.push("error: bad number");
    else if (assigns.has(t[1])) out.push(`error: assignment exists ${t[1]}`);
    else {
      assigns.set(t[1], { max: +t[2], w: +t[3] });
      out.push("ok");
    }
  } else if (c === "student") {
    if (students.has(t[1])) out.push(`error: student exists ${t[1]}`);
    else {
      students.set(t[1], new Map());
      out.push("ok");
    }
  } else if (c === "score") {
    const a = assigns.get(t[2]);
    if (!students.has(t[1])) out.push(`error: unknown student ${t[1]}`);
    else if (!a) out.push(`error: unknown assignment ${t[2]}`);
    else if (!digits(t[3]) || +t[3] > a.max) out.push("error: bad points");
    else {
      students.get(t[1])!.set(t[2], +t[3]);
      out.push("ok");
    }
  } else {
    if (students.size === 0) {
      out.push("no students");
      continue;
    }
    const total = [...assigns.values()].reduce((s, a) => s + a.w, 0);
    const tenths = (st: string, name: string) => {
      const mx = assigns.get(name)!.max;
      const p = students.get(st)!.get(name) ?? 0;
      return Math.floor((2000 * p + mx) / (2 * mx));
    };
    const fin = new Map<string, number>();
    for (const st of students.keys()) {
      let s = 0;
      for (const [name, a] of assigns) s += a.w * tenths(st, name);
      fin.set(st, total ? Math.floor((2 * s + total) / (2 * total)) : 0);
    }
    const order = [...students.keys()].sort((a, b) => fin.get(b)! - fin.get(a)! || cmp(a, b));
    for (const st of order) {
      const f = fin.get(st)!;
      const rank = 1 + [...fin.values()].filter((o) => o > f).length;
      out.push(`${rank} ${st} ${fmt(f)} ${letter(f)}`);
    }
    const vals = [...fin.values()].sort((a, b) => a - b);
    const n = vals.length;
    const sum = vals.reduce((a, b) => a + b, 0);
    const med = n % 2 ? vals[(n - 1) / 2] : Math.floor((vals[n / 2 - 1] + vals[n / 2] + 1) / 2);
    out.push(`class: n=${n} min=${fmt(vals[0])} max=${fmt(vals[n - 1])} mean=${fmt(Math.floor((2 * sum + n) / (2 * n)))} median=${fmt(med)}`);
    const cnt: Record<string, number> = { A: 0, B: 0, C: 0, D: 0, F: 0 };
    for (const f of vals) cnt[letter(f)]++;
    out.push(`grades: ${["A", "B", "C", "D", "F"].map((k) => `${k}=${cnt[k]}`).join(" ")}`);
    for (const name of [...assigns.keys()].sort(cmp)) {
      let sm = 0;
      for (const st of students.keys()) sm += tenths(st, name);
      out.push(`assignment ${name} mean=${fmt(Math.floor((2 * sm + n) / (2 * n)))}`);
    }
  }
}
process.stdout.write(out.map((l) => l + "\n").join(""));
