package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strings"
)

const header = "invoice,date,customer,sku,qty,unit_price,discount_pct"

func daysFromCivil(y, m, d int) int {
	if m <= 2 {
		y--
	}
	era := y / 400
	yoe := y - era*400
	mp := m - 3
	if m <= 2 {
		mp = m + 9
	}
	doy := (153*mp+2)/5 + d - 1
	doe := yoe*365 + yoe/4 - yoe/100 + doy
	return era*146097 + doe - 719468
}

func civilFromDays(z int) string {
	z += 719468
	era := z / 146097
	doe := z - era*146097
	yoe := (doe - doe/1460 + doe/36524 - doe/146096) / 365
	y := yoe + era*400
	doy := doe - (365*yoe + yoe/4 - yoe/100)
	mp := (5*doy + 2) / 153
	d := doy - (153*mp+2)/5 + 1
	m := mp + 3
	if mp >= 10 {
		m = mp - 9
	}
	if m <= 2 {
		y++
	}
	return fmt.Sprintf("%04d-%02d-%02d", y, m, d)
}

// digits parses s when it is 1..max ASCII digits.
func digits(s string, max int) (int, bool) {
	if len(s) < 1 || len(s) > max {
		return 0, false
	}
	n := 0
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return 0, false
		}
		n = n*10 + int(s[i]-'0')
	}
	return n, true
}

func parseDate(s string) (int, bool) {
	if len(s) != 10 || s[4] != '-' || s[7] != '-' {
		return 0, false
	}
	y, ok1 := digits(s[:4], 4)
	m, ok2 := digits(s[5:7], 2)
	d, ok3 := digits(s[8:], 2)
	if !ok1 || !ok2 || !ok3 || len(s[:4]) != 4 || y < 1900 || y > 2100 || m < 1 || m > 12 || d < 1 {
		return 0, false
	}
	leap := (y%4 == 0 && y%100 != 0) || y%400 == 0
	lens := []int{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}
	if leap {
		lens[1] = 29
	}
	if d > lens[m-1] {
		return 0, false
	}
	return daysFromCivil(y, m, d), true
}

func splitCSV(line string) ([]string, bool) {
	chars := []rune(line)
	n := len(chars)
	var fields []string
	i := 0
	for {
		if i < n && chars[i] == '"' {
			i++
			var buf []rune
			for {
				if i >= n {
					return nil, false
				}
				if chars[i] == '"' {
					if i+1 < n && chars[i+1] == '"' {
						buf = append(buf, '"')
						i += 2
						continue
					}
					i++
					break
				}
				buf = append(buf, chars[i])
				i++
			}
			fields = append(fields, string(buf))
			if i < n && chars[i] != ',' {
				return nil, false
			}
		} else {
			j := i
			for j < n && chars[j] != ',' {
				j++
			}
			f := string(chars[i:j])
			if strings.Contains(f, "\"") {
				return nil, false
			}
			fields = append(fields, f)
			i = j
		}
		if i >= n {
			return fields, true
		}
		i++
		if i >= n {
			return append(fields, ""), true
		}
	}
}

func money(c int64) string { return fmt.Sprintf("%d.%02d", c/100, c%100) }

// toCents parses digits with an optional one or two digit fraction (already validated).
func toCents(s string) int64 {
	whole, frac, _ := strings.Cut(s, ".")
	var w int64
	for _, c := range whole {
		w = w*10 + int64(c-'0')
	}
	var f int64
	for len(frac) < 2 && frac != "" {
		frac += "0"
	}
	for _, c := range frac {
		f = f*10 + int64(c-'0')
	}
	return w*100 + f
}

func validPrice(s string) bool {
	whole, frac, has := strings.Cut(s, ".")
	if _, ok := digits(whole, 7); !ok {
		return false
	}
	if has {
		if _, ok := digits(frac, 2); !ok {
			return false
		}
	}
	return true
}

type invoice struct {
	date, cust string
	day, items int
	sub        int64
}

func run(lines []string) string {
	for len(lines) < 3 {
		lines = append(lines, "")
	}
	var bp int64 = -1
	if rest, ok := strings.CutPrefix(lines[0], "tax_rate="); ok {
		whole, frac, has := strings.Cut(rest, ".")
		w, ok1 := digits(whole, 3)
		valid := ok1
		f := 0
		if has {
			var ok2 bool
			f, ok2 = digits(frac, 2)
			valid = valid && ok2
			if len(frac) == 1 {
				f *= 10
			}
		}
		if valid {
			bp = int64(w*100 + f)
		}
	}
	if bp < 0 || bp > 10000 {
		return "error: bad tax_rate\n"
	}
	asOf, ok := 0, false
	if rest, has := strings.CutPrefix(lines[1], "as_of="); has {
		asOf, ok = parseDate(rest)
	}
	if !ok {
		return "error: bad as_of\n"
	}
	if lines[2] != header {
		return "error: bad header\n"
	}
	var out []string
	invs := map[string]*invoice{}
	rejected := 0
	for i := 3; i < len(lines); i++ {
		l := lines[i]
		if strings.Trim(l, " ") == "" {
			continue
		}
		reject := func(why string) {
			out = append(out, fmt.Sprintf("rejected line %d: %s", i+1, why))
			rejected++
		}
		f, ok := splitCSV(l)
		if !ok || len(f) != 7 {
			reject("malformed row")
			continue
		}
		iid, date, cust, sku, qtyS, price, discS := f[0], f[1], f[2], f[3], f[4], f[5], f[6]
		day, dateOK := parseDate(date)
		qty, qtyOK := digits(qtyS, 5)
		disc, discOK := digits(discS, 3)
		switch {
		case iid == "":
			reject("empty invoice id")
		case !dateOK:
			reject("bad date")
		case cust == "":
			reject("empty customer")
		case sku == "":
			reject("empty sku")
		case !qtyOK || qty < 1 || qty > 10000:
			reject("bad qty")
		case !validPrice(price):
			reject("bad price")
		case !discOK || disc > 100:
			reject("bad discount")
		default:
			prev := invs[iid]
			if prev != nil && (prev.date != date || prev.cust != cust) {
				reject("conflicting invoice header")
				continue
			}
			if prev == nil {
				prev = &invoice{date: date, cust: cust, day: day}
				invs[iid] = prev
			}
			net := (int64(qty)*toCents(price)*int64(100-disc) + 50) / 100
			prev.items++
			prev.sub += net
		}
	}
	ids := make([]string, 0, len(invs))
	for id := range invs {
		ids = append(ids, id)
	}
	sort.Strings(ids)
	type cust struct {
		n     int
		total int64
	}
	custs := map[string]*cust{}
	var grand int64
	for _, id := range ids {
		e := invs[id]
		tax := (e.sub*bp + 5000) / 10000
		total := e.sub + tax
		due := e.day + 30
		status := "OPEN"
		if late := asOf - due; late > 0 {
			status = fmt.Sprintf("OVERDUE %d days", late)
		}
		out = append(out, fmt.Sprintf("invoice %s | %s | %s | items=%d | subtotal=%s | tax=%s | total=%s | due=%s | %s",
			id, e.date, e.cust, e.items, money(e.sub), money(tax), money(total), civilFromDays(due), status))
		c := custs[e.cust]
		if c == nil {
			c = &cust{}
			custs[e.cust] = c
		}
		c.n++
		c.total += total
		grand += total
	}
	names := make([]string, 0, len(custs))
	for n := range custs {
		names = append(names, n)
	}
	sort.Strings(names)
	for _, n := range names {
		out = append(out, fmt.Sprintf("customer %s | invoices=%d | total=%s", n, custs[n].n, money(custs[n].total)))
	}
	out = append(out, fmt.Sprintf("summary | invoices=%d | rejected=%d | total=%s", len(invs), rejected, money(grand)))
	return strings.Join(out, "\n") + "\n"
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	var lines []string
	for sc.Scan() {
		lines = append(lines, sc.Text())
	}
	fmt.Print(run(lines))
}
