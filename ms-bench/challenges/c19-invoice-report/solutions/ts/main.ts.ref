import { readFileSync } from "node:fs";

const HEADER = "invoice,date,customer,sku,qty,unit_price,discount_pct";

function daysFromCivil(y: number, m: number, d: number): number {
  if (m <= 2) y -= 1;
  const era = Math.floor(y / 400);
  const yoe = y - era * 400;
  const doy = Math.floor((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1;
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy;
  return era * 146097 + doe - 719468;
}

function civilFromDays(z: number): string {
  z += 719468;
  const era = Math.floor(z / 146097);
  const doe = z - era * 146097;
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365);
  let y = yoe + era * 400;
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
  const mp = Math.floor((5 * doy + 2) / 153);
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1;
  const m = mp < 10 ? mp + 3 : mp - 9;
  if (m <= 2) y += 1;
  return `${String(y).padStart(4, "0")}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
}

// Returns the day number of a valid date string, or null.
function parseDate(s: string): number | null {
  const m = /^([0-9]{4})-([0-9]{2})-([0-9]{2})$/.exec(s);
  if (!m) return null;
  const y = Number(m[1]), mo = Number(m[2]), d = Number(m[3]);
  if (y < 1900 || y > 2100 || mo < 1 || mo > 12 || d < 1) return null;
  const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
  const len = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][mo - 1];
  return d > len ? null : daysFromCivil(y, mo, d);
}

function splitCsv(line: string): string[] | null {
  const chars = [...line];
  const fields: string[] = [];
  let i = 0;
  const n = chars.length;
  for (;;) {
    if (i < n && chars[i] === '"') {
      i++;
      let buf = "";
      for (;;) {
        if (i >= n) return null;
        if (chars[i] === '"') {
          if (chars[i + 1] === '"') { buf += '"'; i += 2; continue; }
          i++;
          break;
        }
        buf += chars[i++];
      }
      fields.push(buf);
      if (i < n && chars[i] !== ",") return null;
    } else {
      let j = i;
      while (j < n && chars[j] !== ",") j++;
      const f = chars.slice(i, j).join("");
      if (f.includes('"')) return null;
      fields.push(f);
      i = j;
    }
    if (i >= n) return fields;
    i++;
    if (i >= n) { fields.push(""); return fields; }
  }
}

function money(c: bigint): string {
  return `${c / 100n}.${String(c % 100n).padStart(2, "0")}`;
}

function toCents(s: string): bigint {
  const [w, f = ""] = s.split(".");
  return BigInt(w) * 100n + BigInt(f.padEnd(2, "0"));
}

function main(): string {
  const lines = readFileSync(0, "utf8").split("\n");
  if (lines[lines.length - 1] === "") lines.pop();
  while (lines.length < 3) lines.push("");
  const rate = /^tax_rate=([0-9]{1,3})(?:\.([0-9]{1,2}))?$/.exec(lines[0]);
  let bp = -1n;
  if (rate) bp = BigInt(rate[1]) * 100n + BigInt((rate[2] ?? "0").padEnd(2, "0"));
  if (bp < 0n || bp > 10000n) return "error: bad tax_rate\n";
  const asOf = lines[1].startsWith("as_of=") ? parseDate(lines[1].slice(6)) : null;
  if (asOf === null) return "error: bad as_of\n";
  if (lines[2] !== HEADER) return "error: bad header\n";
  const out: string[] = [];
  type Inv = { date: string; day: number; cust: string; items: number; sub: bigint };
  const inv = new Map<string, Inv>();
  let rejected = 0;
  for (let i = 3; i < lines.length; i++) {
    const l = lines[i];
    if (l.replace(/ /g, "") === "") continue;
    const reject = (why: string) => { out.push(`rejected line ${i + 1}: ${why}`); rejected++; };
    const f = splitCsv(l);
    if (f === null || f.length !== 7) { reject("malformed row"); continue; }
    const [iid, date, cust, sku, qty, price, disc] = f;
    const day = parseDate(date);
    if (iid === "") { reject("empty invoice id"); continue; }
    if (day === null) { reject("bad date"); continue; }
    if (cust === "") { reject("empty customer"); continue; }
    if (sku === "") { reject("empty sku"); continue; }
    if (!/^[0-9]{1,5}$/.test(qty) || Number(qty) < 1 || Number(qty) > 10000) { reject("bad qty"); continue; }
    if (!/^[0-9]{1,7}(\.[0-9]{1,2})?$/.test(price)) { reject("bad price"); continue; }
    if (!/^[0-9]{1,3}$/.test(disc) || Number(disc) > 100) { reject("bad discount"); continue; }
    const prev = inv.get(iid);
    if (prev && (prev.date !== date || prev.cust !== cust)) { reject("conflicting invoice header"); continue; }
    const net = (BigInt(qty) * toCents(price) * BigInt(100 - Number(disc)) + 50n) / 100n;
    const e = prev ?? { date, day, cust, items: 0, sub: 0n };
    e.items++;
    e.sub += net;
    inv.set(iid, e);
  }
  const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
  const custs = new Map<string, { n: number; total: bigint }>();
  let grand = 0n;
  for (const id of [...inv.keys()].sort(cmp)) {
    const e = inv.get(id)!;
    const tax = (e.sub * bp + 5000n) / 10000n;
    const total = e.sub + tax;
    const due = e.day + 30;
    const late = asOf - due;
    const status = late > 0 ? `OVERDUE ${late} days` : "OPEN";
    out.push(`invoice ${id} | ${e.date} | ${e.cust} | items=${e.items} | subtotal=${money(e.sub)} | tax=${money(tax)} | total=${money(total)} | due=${civilFromDays(due)} | ${status}`);
    const c = custs.get(e.cust) ?? { n: 0, total: 0n };
    c.n++;
    c.total += total;
    custs.set(e.cust, c);
    grand += total;
  }
  for (const name of [...custs.keys()].sort(cmp)) {
    const c = custs.get(name)!;
    out.push(`customer ${name} | invoices=${c.n} | total=${money(c.total)}`);
  }
  out.push(`summary | invoices=${inv.size} | rejected=${rejected} | total=${money(grand)}`);
  return out.map((x) => x + "\n").join("");
}

process.stdout.write(main());
