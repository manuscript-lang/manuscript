import {stdin, stdout, read_line} from "@std/io.ms"

fn pad2(n: Int) -> String:
    if n < 10:
        return "0{n}"
    return "{n}"

# Parses s when it is 1 to max_len ASCII digits.
fn digits(s: String, max_len: Int) -> Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() < 1 or codes.length() > max_len:
        return none
    var n = 0
    for c in codes:
        if c < 48 or c > 57:
            return none
        n = n * 10 + (c - 48)
    return some(n)

fn days_from_civil(year: Int, m: Int, d: Int) -> Int:
    var y = year
    if m <= 2:
        y = y - 1
    let era = y / 400
    let yoe = y - era * 400
    var mp = m - 3
    if m <= 2:
        mp = m + 9
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

fn civil_from_days(days: Int) -> String:
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    var y = yoe + era * 400
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if mp >= 10:
        m = mp - 9
    if m <= 2:
        y = y + 1
    return "{y}-{pad2(m)}-{pad2(d)}"

fn parse_date(s: String) -> Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() != 10 or codes.at(4).unwrap() != 45 or codes.at(7).unwrap() != 45:
        return none
    let y = digits(s.slice(0, 4), 4)
    let m = digits(s.slice(5, 7), 2)
    let d = digits(s.slice(8, 10), 2)
    if y.is_none() or m.is_none() or d.is_none():
        return none
    let year = y.unwrap()
    let month = m.unwrap()
    let day = d.unwrap()
    if year < 1900 or year > 2100 or month < 1 or month > 12 or day < 1:
        return none
    let leap = (year % 4 == 0 and year % 100 != 0) or year % 400 == 0
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    var limit = lengths.at(month - 1).unwrap()
    if month == 2 and leap:
        limit = 29
    if day > limit:
        return none
    return some(days_from_civil(year, month, day))

fn split_csv(line: String) -> Optional[List[String]]:
    let chars = line.chars()
    let n = chars.length()
    let fields = List[String]()
    var i = 0
    while true:
        if i < n and chars.at(i).unwrap() == "\"":
            i = i + 1
            let buf = List[String]()
            while true:
                if i >= n:
                    return none
                if chars.at(i).unwrap() == "\"":
                    if i + 1 < n and chars.at(i + 1).unwrap() == "\"":
                        buf.append("\"")
                        i = i + 2
                        continue
                    i = i + 1
                    break
                buf.append(chars.at(i).unwrap())
                i = i + 1
            fields.append(buf.join(""))
            if i < n and chars.at(i).unwrap() != ",":
                return none
        else:
            var j = i
            while j < n and chars.at(j).unwrap() != ",":
                j = j + 1
            let field = chars.slice(i, j).join("")
            if field.contains("\""):
                return none
            fields.append(field)
            i = j
        if i >= n:
            return some(fields)
        i = i + 1
        if i >= n:
            fields.append("")
            return some(fields)
    return some(fields)

fn money(c: Int) -> String:
    return "{c / 100}.{pad2(c % 100)}"

fn valid_price(s: String) -> Bool:
    let parts = s.split(".")
    if parts.length() == 1:
        return digits(s, 7).is_some()
    if parts.length() == 2:
        return digits(parts.at(0).unwrap(), 7).is_some() and digits(parts.at(1).unwrap(), 2).is_some()
    return false

# Cents of a validated price.
fn to_cents(s: String) -> Int:
    let parts = s.split(".")
    var cents = digits(parts.at(0).unwrap(), 7).unwrap() * 100
    if parts.length() == 2:
        let frac = parts.at(1).unwrap()
        let value = digits(frac, 2).unwrap()
        if frac.length() == 1:
            cents = cents + value * 10
        else:
            cents = cents + value
    return cents

type Invoice:
    date: String
    cust: String
    day: Int
    items: Int
    sub: Int

type Customer:
    count: Int
    total: Int

# Returns the rejection reason for a split row, or "" when the row is acceptable.
fn row_problem(f: List[String], invs: Map[String, Invoice]) -> String:
    if f.at(0).unwrap().is_empty():
        return "empty invoice id"
    if parse_date(f.at(1).unwrap()).is_none():
        return "bad date"
    if f.at(2).unwrap().is_empty():
        return "empty customer"
    if f.at(3).unwrap().is_empty():
        return "empty sku"
    let qty = digits(f.at(4).unwrap(), 5)
    if qty.is_none() or qty.unwrap() < 1 or qty.unwrap() > 10000:
        return "bad qty"
    if not valid_price(f.at(5).unwrap()):
        return "bad price"
    let disc = digits(f.at(6).unwrap(), 3)
    if disc.is_none() or disc.unwrap() > 100:
        return "bad discount"
    let prev = invs.get(f.at(0).unwrap())
    if prev.is_some():
        if prev.unwrap().date != f.at(1).unwrap() or prev.unwrap().cust != f.at(2).unwrap():
            return "conflicting invoice header"
    return ""

fn by_name(left: String, right: String) -> Int:
    return left.compare(right)

fn run() -> Result[Unit, Error]:
    let lines = List[String]()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        lines.append(next.unwrap())
    while lines.length() < 3:
        lines.append("")
    # tax rate in hundredths of a percent
    var bp = -1
    let rate_line = lines.at(0).unwrap()
    if rate_line.starts_with("tax_rate="):
        let parts = rate_line.slice(9, rate_line.length()).split(".")
        let whole = digits(parts.at(0).unwrap(), 3)
        if whole.is_some() and parts.length() == 1:
            bp = whole.unwrap() * 100
        else if whole.is_some() and parts.length() == 2:
            let frac = digits(parts.at(1).unwrap(), 2)
            if frac.is_some():
                if parts.at(1).unwrap().length() == 1:
                    bp = whole.unwrap() * 100 + frac.unwrap() * 10
                else:
                    bp = whole.unwrap() * 100 + frac.unwrap()
    if bp < 0 or bp > 10000:
        try stdout().write("error: bad tax_rate\n".to_bytes())
        return stdout().flush()
    var as_of = parse_date("x")
    let of_line = lines.at(1).unwrap()
    if of_line.starts_with("as_of="):
        as_of = parse_date(of_line.slice(6, of_line.length()))
    if as_of.is_none():
        try stdout().write("error: bad as_of\n".to_bytes())
        return stdout().flush()
    if lines.at(2).unwrap() != "invoice,date,customer,sku,qty,unit_price,discount_pct":
        try stdout().write("error: bad header\n".to_bytes())
        return stdout().flush()
    let out = List[String]()
    let invs = Map[String, Invoice]()
    var rejected = 0
    var line_no = 3
    while line_no < lines.length():
        let l = lines.at(line_no).unwrap()
        line_no = line_no + 1
        if l.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        let split = split_csv(l)
        if split.is_none() or split.unwrap().length() != 7:
            out.append("rejected line {line_no}: malformed row")
            rejected = rejected + 1
            continue
        let f = split.unwrap()
        let problem = row_problem(f, invs)
        if not problem.is_empty():
            out.append("rejected line {line_no}: {problem}")
            rejected = rejected + 1
            continue
        let qty = digits(f.at(4).unwrap(), 5).unwrap()
        let disc = digits(f.at(6).unwrap(), 3).unwrap()
        let net = (qty * to_cents(f.at(5).unwrap()) * (100 - disc) + 50) / 100
        let id = f.at(0).unwrap()
        let existing = invs.get(id)
        if existing.is_none():
            invs.add(key: id, value: Invoice(date: f.at(1).unwrap(), cust: f.at(2).unwrap(), day: parse_date(f.at(1).unwrap()).unwrap(), items: 1, sub: net))
        else:
            let e = existing.unwrap()
            e.items = e.items + 1
            e.sub = e.sub + net
    let customers = Map[String, Customer]()
    var grand = 0
    for id in invs.keys().sorted(compare: by_name):
        let e = invs.get(id).unwrap()
        let tax = (e.sub * bp + 5000) / 10000
        let total = e.sub + tax
        let due = e.day + 30
        var status = "OPEN"
        let late = as_of.unwrap() - due
        if late > 0:
            status = "OVERDUE {late} days"
        out.append("invoice {id} | {e.date} | {e.cust} | items={e.items} | subtotal={money(e.sub)} | tax={money(tax)} | total={money(total)} | due={civil_from_days(due)} | {status}")
        let c = customers.get(e.cust)
        if c.is_none():
            customers.add(key: e.cust, value: Customer(count: 1, total: total))
        else:
            c.unwrap().count = c.unwrap().count + 1
            c.unwrap().total = c.unwrap().total + total
        grand = grand + total
    for name in customers.keys().sorted(compare: by_name):
        let c = customers.get(name).unwrap()
        out.append("customer {name} | invoices={c.count} | total={money(c.total)}")
    out.append("summary | invoices={invs.length()} | rejected={rejected} | total={money(grand)}")
    for l in out:
        try stdout().write("{l}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
