use std::collections::BTreeMap;
use std::io::{BufRead, Write};

const HEADER: &str = "invoice,date,customer,sku,qty,unit_price,discount_pct";

fn days_from_civil(mut y: i64, m: i64, d: i64) -> i64 {
    if m <= 2 {
        y -= 1;
    }
    let era = y / 400;
    let yoe = y - era * 400;
    let mp = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mp + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn civil_from_days(z: i64) -> String {
    let z = z + 719468;
    let era = z / 146097;
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let mut y = yoe + era * 400;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    if m <= 2 {
        y += 1;
    }
    format!("{:04}-{:02}-{:02}", y, m, d)
}

// Parses s when it is 1..=max ASCII digits.
fn digits(s: &str, max: usize) -> Option<i64> {
    if s.is_empty() || s.len() > max || !s.bytes().all(|b| b.is_ascii_digit()) {
        return None;
    }
    s.parse().ok()
}

fn parse_date(s: &str) -> Option<i64> {
    let b = s.as_bytes();
    if b.len() != 10 || b[4] != b'-' || b[7] != b'-' {
        return None;
    }
    let (y, m, d) = (digits(&s[..4], 4)?, digits(&s[5..7], 2)?, digits(&s[8..], 2)?);
    if s[..4].len() != 4 || !(1900..=2100).contains(&y) || !(1..=12).contains(&m) || d < 1 {
        return None;
    }
    let leap = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
    let lens = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];
    if d > lens[(m - 1) as usize] {
        return None;
    }
    Some(days_from_civil(y, m, d))
}

fn split_csv(line: &str) -> Option<Vec<String>> {
    let chars: Vec<char> = line.chars().collect();
    let n = chars.len();
    let mut fields = Vec::new();
    let mut i = 0;
    loop {
        if i < n && chars[i] == '"' {
            i += 1;
            let mut buf = String::new();
            loop {
                if i >= n {
                    return None;
                }
                if chars[i] == '"' {
                    if i + 1 < n && chars[i + 1] == '"' {
                        buf.push('"');
                        i += 2;
                        continue;
                    }
                    i += 1;
                    break;
                }
                buf.push(chars[i]);
                i += 1;
            }
            fields.push(buf);
            if i < n && chars[i] != ',' {
                return None;
            }
        } else {
            let mut j = i;
            while j < n && chars[j] != ',' {
                j += 1;
            }
            let f: String = chars[i..j].iter().collect();
            if f.contains('"') {
                return None;
            }
            fields.push(f);
            i = j;
        }
        if i >= n {
            return Some(fields);
        }
        i += 1;
        if i >= n {
            fields.push(String::new());
            return Some(fields);
        }
    }
}

fn money(c: i64) -> String {
    format!("{}.{:02}", c / 100, c % 100)
}

fn valid_price(s: &str) -> bool {
    match s.split_once('.') {
        Some((w, f)) => digits(w, 7).is_some() && digits(f, 2).is_some(),
        None => digits(s, 7).is_some(),
    }
}

fn to_cents(s: &str) -> i64 {
    match s.split_once('.') {
        Some((w, f)) => {
            let fv: i64 = f.parse().unwrap();
            w.parse::<i64>().unwrap() * 100 + if f.len() == 1 { fv * 10 } else { fv }
        }
        None => s.parse::<i64>().unwrap() * 100,
    }
}

struct Invoice {
    date: String,
    cust: String,
    day: i64,
    items: usize,
    sub: i64,
}

fn run(mut lines: Vec<String>) -> String {
    while lines.len() < 3 {
        lines.push(String::new());
    }
    let mut bp: i64 = -1;
    if let Some(rest) = lines[0].strip_prefix("tax_rate=") {
        let (whole, frac) = match rest.split_once('.') {
            Some((w, f)) => (w, Some(f)),
            None => (rest, None),
        };
        if let Some(w) = digits(whole, 3) {
            match frac {
                None => bp = w * 100,
                Some(f) => {
                    if let Some(fv) = digits(f, 2) {
                        bp = w * 100 + if f.len() == 1 { fv * 10 } else { fv };
                    }
                }
            }
        }
    }
    if !(0..=10000).contains(&bp) {
        return "error: bad tax_rate\n".into();
    }
    let as_of = lines[1].strip_prefix("as_of=").and_then(parse_date);
    let as_of = match as_of {
        Some(d) => d,
        None => return "error: bad as_of\n".into(),
    };
    if lines[2] != HEADER {
        return "error: bad header\n".into();
    }
    let mut out: Vec<String> = Vec::new();
    let mut invs: BTreeMap<String, Invoice> = BTreeMap::new();
    let mut rejected = 0;
    for i in 3..lines.len() {
        let l = &lines[i];
        if l.trim_matches(' ').is_empty() {
            continue;
        }
        let mut reject = |why: &str| {
            out.push(format!("rejected line {}: {}", i + 1, why));
            rejected += 1;
        };
        let f = match split_csv(l) {
            Some(f) if f.len() == 7 => f,
            _ => {
                reject("malformed row");
                continue;
            }
        };
        let (iid, date, cust, sku) = (&f[0], &f[1], &f[2], &f[3]);
        let day = parse_date(date);
        let qty = digits(&f[4], 5);
        let disc = digits(&f[6], 3);
        if iid.is_empty() {
            reject("empty invoice id");
        } else if day.is_none() {
            reject("bad date");
        } else if cust.is_empty() {
            reject("empty customer");
        } else if sku.is_empty() {
            reject("empty sku");
        } else if !qty.map_or(false, |q| (1..=10000).contains(&q)) {
            reject("bad qty");
        } else if !valid_price(&f[5]) {
            reject("bad price");
        } else if !disc.map_or(false, |d| d <= 100) {
            reject("bad discount");
        } else if invs.get(iid).map_or(false, |p| &p.date != date || &p.cust != cust) {
            reject("conflicting invoice header");
        } else {
            let net = (qty.unwrap() * to_cents(&f[5]) * (100 - disc.unwrap()) + 50) / 100;
            let e = invs.entry(iid.clone()).or_insert(Invoice {
                date: date.clone(),
                cust: cust.clone(),
                day: day.unwrap(),
                items: 0,
                sub: 0,
            });
            e.items += 1;
            e.sub += net;
        }
    }
    let mut custs: BTreeMap<String, (usize, i64)> = BTreeMap::new();
    let mut grand = 0;
    for (id, e) in &invs {
        let tax = (e.sub * bp + 5000) / 10000;
        let total = e.sub + tax;
        let due = e.day + 30;
        let late = as_of - due;
        let status = if late > 0 { format!("OVERDUE {} days", late) } else { "OPEN".to_string() };
        out.push(format!(
            "invoice {} | {} | {} | items={} | subtotal={} | tax={} | total={} | due={} | {}",
            id, e.date, e.cust, e.items, money(e.sub), money(tax), money(total), civil_from_days(due), status
        ));
        let c = custs.entry(e.cust.clone()).or_insert((0, 0));
        c.0 += 1;
        c.1 += total;
        grand += total;
    }
    for (n, (count, total)) in &custs {
        out.push(format!("customer {} | invoices={} | total={}", n, count, money(*total)));
    }
    out.push(format!("summary | invoices={} | rejected={} | total={}", invs.len(), rejected, money(grand)));
    out.iter().map(|x| format!("{}\n", x)).collect()
}

fn main() {
    let stdin = std::io::stdin();
    let lines: Vec<String> = stdin.lock().lines().map(|l| l.unwrap()).collect();
    std::io::stdout().write_all(run(lines).as_bytes()).unwrap();
}
