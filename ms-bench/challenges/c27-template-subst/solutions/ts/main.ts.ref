import { readFileSync } from "node:fs";

const IDENT = /^[A-Za-z_][A-Za-z0-9_]*$/;
const lines = readFileSync(0, "utf8").split("\n");
const sep = lines.indexOf("---");
if (sep >= 0) {
  const vars = new Map<string, string>();
  for (const l of lines.slice(0, sep)) {
    const eq = l.indexOf("=");
    if (eq < 0) continue;
    const name = l.slice(0, eq);
    if (IDENT.test(name)) vars.set(name, l.slice(eq + 1));
  }
  const tpl = lines.slice(sep + 1);
  if (tpl.length > 0 && tpl[tpl.length - 1] === "") tpl.pop();
  const out: string[] = [];
  for (const line of tpl) {
    let res = "";
    let i = 0;
    while (i < line.length) {
      const two = line.slice(i, i + 2);
      if (two === "{{") { res += "{"; i += 2; }
      else if (two === "}}") { res += "}"; i += 2; }
      else if (line[i] === "{") {
        const j = line.indexOf("}", i + 1);
        const name = j >= 0 ? line.slice(i + 1, j) : "";
        if (j >= 0 && IDENT.test(name)) {
          res += vars.has(name) ? vars.get(name)! : `<undefined:${name}>`;
          i = j + 1;
        } else { res += "{"; i++; }
      } else { res += line[i]; i++; }
    }
    out.push(res);
  }
  process.stdout.write(out.map((l) => l + "\n").join(""));
}
