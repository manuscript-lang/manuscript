import {stdin, stdout, read_all} from "@std/io.ms"

# True when s is a letter or underscore followed by letters, digits or underscores.
fn is_ident(s: String) -> Bool:
    let codes = s.scalar_values()
    if codes.is_empty():
        return false
    var i = 0
    for c in codes:
        let letter = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c == 95
        let digit = c >= 48 and c <= 57
        if not letter and not (digit and i > 0):
            return false
        i = i + 1
    return true

fn render(line: String, vars: Map[String, String]) -> String:
    let chars = line.chars()
    let n = chars.length()
    let out = List[String]()
    var i = 0
    while i < n:
        let c = chars.at(i).unwrap()
        let next = chars.at(i + 1).unwrap_or("")
        if c == "\{" and next == "\{":
            out.append("\{")
            i = i + 2
        else if c == "\}" and next == "\}":
            out.append("\}")
            i = i + 2
        else if c == "\{":
            var j = i + 1
            while j < n and chars.at(j).unwrap() != "\}":
                j = j + 1
            var done = false
            if j < n:
                let name = chars.slice(i + 1, j).unwrap().join("")
                if is_ident(name):
                    out.append(vars.get_or(key: name, fallback: "<undefined:{name}>"))
                    i = j + 1
                    done = true
            if not done:
                out.append("\{")
                i = i + 1
        else:
            out.append(c)
            i = i + 1
    return out.join("")

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let text = data.to_text().unwrap_or("")
    let lines = text.split("\n")
    var sep = -1
    var i = 0
    while i < lines.length():
        if lines.at(i).unwrap() == "---":
            sep = i
            break
        i = i + 1
    if sep < 0:
        return stdout().flush()
    let vars = Map[String, String]()
    var d = 0
    while d < sep:
        let l = lines.at(d).unwrap()
        d = d + 1
        let eq = l.index_of("=")
        if eq.is_some():
            let name = l.slice(0, eq.unwrap()).unwrap()
            if is_ident(name):
                vars.add(key: name, value: l.slice(eq.unwrap() + 1, l.length()).unwrap())
    var end = lines.length()
    if lines.at(end - 1).unwrap().is_empty():
        end = end - 1
    let out = List[String]()
    var t = sep + 1
    while t < end:
        out.append(render(lines.at(t).unwrap(), vars))
        t = t + 1
    if not out.is_empty():
        try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
