import { readFileSync } from "node:fs";

const PRI = ["low", "normal", "high", "urgent"];
const STAT = ["new", "assigned", "in_progress", "resolved", "closed"];
const ARITY: Record<string, number> = { assign: 3, start: 2, resolve: 2, close: 2, reopen: 2, escalate: 2, show: 2, report: 1 };

type Ticket = { pri: number; title: string; agent: string | null; status: string; reopened: number };
const tickets = new Map<string, Ticket>();
const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);

function report(): string[] {
  const out: string[] = [];
  const counts: Record<string, number> = {};
  for (const s of STAT) counts[s] = 0;
  for (const t of tickets.values()) counts[t.status]++;
  out.push(STAT.map((s) => `${s}=${counts[s]}`).join(" "));
  const order = (ids: string[]) => ids.sort((a, b) => tickets.get(b)!.pri - tickets.get(a)!.pri || cmp(a, b));
  const byAgent = new Map<string, string[]>();
  const unassigned: string[] = [];
  for (const [id, t] of tickets) {
    if (t.status === "assigned" || t.status === "in_progress") {
      if (!byAgent.has(t.agent!)) byAgent.set(t.agent!, []);
      byAgent.get(t.agent!)!.push(id);
    } else if (t.status === "new") unassigned.push(id);
  }
  for (const a of [...byAgent.keys()].sort(cmp)) out.push(`${a}: ${order(byAgent.get(a)!).join(" ")}`);
  if (unassigned.length) out.push(`unassigned: ${order(unassigned).join(" ")}`);
  return out;
}

function exec(line: string): string[] {
  const t = line.split(" ");
  const c = t[0];
  if (c !== "open" && !(c in ARITY && Object.prototype.hasOwnProperty.call(ARITY, c))) return ["error: unknown command"];
  if (c === "open") {
    const i1 = line.indexOf(" ");
    const i2 = i1 < 0 ? -1 : line.indexOf(" ", i1 + 1);
    const i3 = i2 < 0 ? -1 : line.indexOf(" ", i2 + 1);
    if (i3 < 0 || i3 + 1 >= line.length) return ["error: usage"];
    const id = line.slice(i1 + 1, i2);
    const pri = line.slice(i2 + 1, i3);
    const title = line.slice(i3 + 1);
    if (!/^[A-Z]+-[0-9]+$/.test(id)) return ["error: bad id"];
    if (!PRI.includes(pri)) return ["error: bad priority"];
    if (tickets.has(id)) return [`error: ${id} already exists`];
    tickets.set(id, { pri: PRI.indexOf(pri), title, agent: null, status: "new", reopened: 0 });
    return ["ok"];
  }
  if (t.length !== ARITY[c]) return ["error: usage"];
  if (c === "report") return report();
  const id = t[1];
  if (c === "assign" && !/^[a-z]+$/.test(t[2])) return ["error: bad agent"];
  const v = tickets.get(id);
  if (!v) return [`error: unknown ticket ${id}`];
  const st = v.status;
  switch (c) {
    case "assign":
      if (st === "resolved" || st === "closed") return [`error: ${id} is ${st}`];
      v.agent = t[2];
      if (st === "new") v.status = "assigned";
      return ["ok"];
    case "start":
      if (st === "new") return [`error: ${id} has no assignee`];
      if (st === "assigned") { v.status = "in_progress"; return ["ok"]; }
      if (st === "in_progress") return [`error: ${id} already in progress`];
      return [`error: ${id} is ${st}`];
    case "resolve":
      if (st === "in_progress") { v.status = "resolved"; return ["ok"]; }
      return [`error: ${id} cannot be resolved from ${st}`];
    case "close":
      if (st === "resolved") { v.status = "closed"; return ["ok"]; }
      return [`error: ${id} cannot be closed from ${st}`];
    case "reopen":
      if (st === "resolved" || st === "closed") { v.status = "in_progress"; v.reopened++; return ["ok"]; }
      return [`error: ${id} cannot be reopened from ${st}`];
    case "escalate":
      if (st === "closed") return [`error: ${id} is closed`];
      if (v.pri === 3) return [`error: ${id} is already urgent`];
      v.pri++;
      return ["ok"];
    default:
      return [`${id} [${PRI[v.pri]}] ${st} agent=${v.agent ?? "-"} reopened=${v.reopened}: ${v.title}`];
  }
}

const lines = readFileSync(0, "utf8").split("\n");
if (lines[lines.length - 1] === "") lines.pop();
let out = "";
for (const l of lines) {
  if (l.replace(/ /g, "") === "") continue;
  for (const o of exec(l)) out += o + "\n";
}
process.stdout.write(out);
