use std::collections::BTreeMap;
use std::io::{BufRead, Write};

const PRI: [&str; 4] = ["low", "normal", "high", "urgent"];
const STATUSES: [&str; 5] = ["new", "assigned", "in_progress", "resolved", "closed"];

struct Ticket {
    pri: usize,
    title: String,
    agent: Option<String>,
    status: &'static str,
    reopened: u32,
}

fn well_formed_id(s: &str) -> bool {
    match s.split_once('-') {
        Some((letters, digits)) => {
            !letters.is_empty()
                && letters.bytes().all(|b| b.is_ascii_uppercase())
                && !digits.is_empty()
                && digits.bytes().all(|b| b.is_ascii_digit())
        }
        None => false,
    }
}

fn arity(c: &str) -> Option<usize> {
    match c {
        "assign" => Some(3),
        "start" | "resolve" | "close" | "reopen" | "escalate" | "show" => Some(2),
        "report" => Some(1),
        _ => None,
    }
}

fn order(ids: &mut Vec<&String>, tickets: &BTreeMap<String, Ticket>) {
    ids.sort_by(|a, b| tickets[*b].pri.cmp(&tickets[*a].pri).then(a.cmp(b)));
}

fn report(tickets: &BTreeMap<String, Ticket>) -> Vec<String> {
    let mut counts = [0; 5];
    let mut by_agent: BTreeMap<&String, Vec<&String>> = BTreeMap::new();
    let mut unassigned: Vec<&String> = Vec::new();
    for (id, t) in tickets {
        counts[STATUSES.iter().position(|s| *s == t.status).unwrap()] += 1;
        match t.status {
            "assigned" | "in_progress" => by_agent.entry(t.agent.as_ref().unwrap()).or_default().push(id),
            "new" => unassigned.push(id),
            _ => {}
        }
    }
    let parts: Vec<String> = STATUSES.iter().zip(counts).map(|(s, n)| format!("{}={}", s, n)).collect();
    let mut out = vec![parts.join(" ")];
    for (agent, mut ids) in by_agent {
        order(&mut ids, tickets);
        let names: Vec<&str> = ids.iter().map(|s| s.as_str()).collect();
        out.push(format!("{}: {}", agent, names.join(" ")));
    }
    if !unassigned.is_empty() {
        order(&mut unassigned, tickets);
        let names: Vec<&str> = unassigned.iter().map(|s| s.as_str()).collect();
        out.push(format!("unassigned: {}", names.join(" ")));
    }
    out
}

fn exec(line: &str, tickets: &mut BTreeMap<String, Ticket>) -> Vec<String> {
    let t: Vec<&str> = line.split(' ').collect();
    let c = t[0];
    let one = |s: String| vec![s];
    if c == "open" {
        let p: Vec<&str> = line.splitn(4, ' ').collect();
        if p.len() < 4 || p[3].is_empty() {
            return one("error: usage".into());
        }
        let (id, pr, title) = (p[1], p[2], p[3]);
        if !well_formed_id(id) {
            return one("error: bad id".into());
        }
        let pi = match PRI.iter().position(|x| *x == pr) {
            Some(i) => i,
            None => return one("error: bad priority".into()),
        };
        if tickets.contains_key(id) {
            return one(format!("error: {} already exists", id));
        }
        tickets.insert(id.to_string(), Ticket { pri: pi, title: title.to_string(), agent: None, status: "new", reopened: 0 });
        return one("ok".into());
    }
    let want = match arity(c) {
        Some(w) => w,
        None => return one("error: unknown command".into()),
    };
    if t.len() != want {
        return one("error: usage".into());
    }
    if c == "report" {
        return report(tickets);
    }
    let id = t[1];
    if c == "assign" && !(!t[2].is_empty() && t[2].bytes().all(|b| b.is_ascii_lowercase())) {
        return one("error: bad agent".into());
    }
    let v = match tickets.get_mut(id) {
        Some(v) => v,
        None => return one(format!("error: unknown ticket {}", id)),
    };
    let st = v.status;
    match c {
        "assign" => {
            if st == "resolved" || st == "closed" {
                return one(format!("error: {} is {}", id, st));
            }
            v.agent = Some(t[2].to_string());
            if st == "new" {
                v.status = "assigned";
            }
        }
        "start" => match st {
            "new" => return one(format!("error: {} has no assignee", id)),
            "assigned" => v.status = "in_progress",
            "in_progress" => return one(format!("error: {} already in progress", id)),
            _ => return one(format!("error: {} is {}", id, st)),
        },
        "resolve" => {
            if st != "in_progress" {
                return one(format!("error: {} cannot be resolved from {}", id, st));
            }
            v.status = "resolved";
        }
        "close" => {
            if st != "resolved" {
                return one(format!("error: {} cannot be closed from {}", id, st));
            }
            v.status = "closed";
        }
        "reopen" => {
            if st != "resolved" && st != "closed" {
                return one(format!("error: {} cannot be reopened from {}", id, st));
            }
            v.status = "in_progress";
            v.reopened += 1;
        }
        "escalate" => {
            if st == "closed" {
                return one(format!("error: {} is closed", id));
            }
            if v.pri == 3 {
                return one(format!("error: {} is already urgent", id));
            }
            v.pri += 1;
        }
        _ => {
            return one(format!(
                "{} [{}] {} agent={} reopened={}: {}",
                id,
                PRI[v.pri],
                st,
                v.agent.as_deref().unwrap_or("-"),
                v.reopened,
                v.title
            ))
        }
    }
    one("ok".into())
}

fn main() {
    let stdin = std::io::stdin();
    let mut tickets: BTreeMap<String, Ticket> = BTreeMap::new();
    let mut out = String::new();
    for line in stdin.lock().lines() {
        let l = line.unwrap();
        if l.trim_matches(' ').is_empty() {
            continue;
        }
        for o in exec(&l, &mut tickets) {
            out.push_str(&o);
            out.push('\n');
        }
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
