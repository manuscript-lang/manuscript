package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strings"
)

var pri = []string{"low", "normal", "high", "urgent"}
var statuses = []string{"new", "assigned", "in_progress", "resolved", "closed"}
var arity = map[string]int{"assign": 3, "start": 2, "resolve": 2, "close": 2, "reopen": 2, "escalate": 2, "show": 2, "report": 1}

type ticket struct {
	pri      int
	title    string
	agent    string
	status   string
	reopened int
}

var tickets = map[string]*ticket{}

func wellFormedID(s string) bool {
	i := 0
	for i < len(s) && s[i] >= 'A' && s[i] <= 'Z' {
		i++
	}
	if i == 0 || i >= len(s) || s[i] != '-' || i+1 >= len(s) {
		return false
	}
	for j := i + 1; j < len(s); j++ {
		if s[j] < '0' || s[j] > '9' {
			return false
		}
	}
	return true
}

func lower(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < 'a' || s[i] > 'z' {
			return false
		}
	}
	return true
}

func indexOf(list []string, s string) int {
	for i, x := range list {
		if x == s {
			return i
		}
	}
	return -1
}

func order(ids []string) {
	sort.Slice(ids, func(i, j int) bool {
		a, b := tickets[ids[i]], tickets[ids[j]]
		if a.pri != b.pri {
			return a.pri > b.pri
		}
		return ids[i] < ids[j]
	})
}

func report() []string {
	counts := map[string]int{}
	byAgent := map[string][]string{}
	var unassigned []string
	for id, t := range tickets {
		counts[t.status]++
		switch t.status {
		case "assigned", "in_progress":
			byAgent[t.agent] = append(byAgent[t.agent], id)
		case "new":
			unassigned = append(unassigned, id)
		}
	}
	var parts []string
	for _, s := range statuses {
		parts = append(parts, fmt.Sprintf("%s=%d", s, counts[s]))
	}
	out := []string{strings.Join(parts, " ")}
	agents := make([]string, 0, len(byAgent))
	for a := range byAgent {
		agents = append(agents, a)
	}
	sort.Strings(agents)
	for _, a := range agents {
		order(byAgent[a])
		out = append(out, a+": "+strings.Join(byAgent[a], " "))
	}
	if len(unassigned) > 0 {
		order(unassigned)
		out = append(out, "unassigned: "+strings.Join(unassigned, " "))
	}
	return out
}

func exec(line string) []string {
	t := strings.Split(line, " ")
	c := t[0]
	want, known := arity[c]
	if c != "open" && !known {
		return []string{"error: unknown command"}
	}
	if c == "open" {
		p := strings.SplitN(line, " ", 4)
		if len(p) < 4 || p[3] == "" {
			return []string{"error: usage"}
		}
		id, pr, title := p[1], p[2], p[3]
		if !wellFormedID(id) {
			return []string{"error: bad id"}
		}
		pi := indexOf(pri, pr)
		if pi < 0 {
			return []string{"error: bad priority"}
		}
		if tickets[id] != nil {
			return []string{"error: " + id + " already exists"}
		}
		tickets[id] = &ticket{pri: pi, title: title, status: "new"}
		return []string{"ok"}
	}
	if len(t) != want {
		return []string{"error: usage"}
	}
	if c == "report" {
		return report()
	}
	id := t[1]
	if c == "assign" && !lower(t[2]) {
		return []string{"error: bad agent"}
	}
	v := tickets[id]
	if v == nil {
		return []string{"error: unknown ticket " + id}
	}
	st := v.status
	switch c {
	case "assign":
		if st == "resolved" || st == "closed" {
			return []string{"error: " + id + " is " + st}
		}
		v.agent = t[2]
		if st == "new" {
			v.status = "assigned"
		}
	case "start":
		switch st {
		case "new":
			return []string{"error: " + id + " has no assignee"}
		case "assigned":
			v.status = "in_progress"
		case "in_progress":
			return []string{"error: " + id + " already in progress"}
		default:
			return []string{"error: " + id + " is " + st}
		}
	case "resolve":
		if st != "in_progress" {
			return []string{"error: " + id + " cannot be resolved from " + st}
		}
		v.status = "resolved"
	case "close":
		if st != "resolved" {
			return []string{"error: " + id + " cannot be closed from " + st}
		}
		v.status = "closed"
	case "reopen":
		if st != "resolved" && st != "closed" {
			return []string{"error: " + id + " cannot be reopened from " + st}
		}
		v.status = "in_progress"
		v.reopened++
	case "escalate":
		if st == "closed" {
			return []string{"error: " + id + " is closed"}
		}
		if v.pri == 3 {
			return []string{"error: " + id + " is already urgent"}
		}
		v.pri++
	case "show":
		agent := v.agent
		if agent == "" {
			agent = "-"
		}
		return []string{fmt.Sprintf("%s [%s] %s agent=%s reopened=%d: %s", id, pri[v.pri], st, agent, v.reopened, v.title)}
	}
	return []string{"ok"}
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	for sc.Scan() {
		l := sc.Text()
		if strings.Trim(l, " ") == "" {
			continue
		}
		for _, o := range exec(l) {
			fmt.Fprintln(w, o)
		}
	}
}
