use std::io::{BufRead, Write};

const SYM: [(u32, &str); 13] = [
    (1000, "M"), (900, "CM"), (500, "D"), (400, "CD"), (100, "C"), (90, "XC"), (50, "L"),
    (40, "XL"), (10, "X"), (9, "IX"), (5, "V"), (4, "IV"), (1, "I"),
];

fn to_roman(mut n: u32) -> String {
    let mut out = String::new();
    for (v, s) in SYM {
        while n >= v {
            out.push_str(s);
            n -= v;
        }
    }
    out
}

fn letter(c: u8) -> i32 {
    match c {
        b'I' => 1,
        b'V' => 5,
        b'X' => 10,
        b'L' => 50,
        b'C' => 100,
        b'D' => 500,
        b'M' => 1000,
        _ => 0,
    }
}

fn solve_line(line: &str) -> String {
    let b = line.as_bytes();
    if b.iter().all(|c| c.is_ascii_digit()) {
        if b[0] == b'0' {
            return "invalid".into();
        }
        let n: u64 = line.parse().unwrap();
        return if (1..=3999).contains(&n) { to_roman(n as u32) } else { "invalid".into() };
    }
    if !b.iter().all(|&c| letter(c) != 0) {
        return "invalid".into();
    }
    let mut total = 0i32;
    for i in 0..b.len() {
        let v = letter(b[i]);
        if i + 1 < b.len() && letter(b[i + 1]) > v {
            total -= v;
        } else {
            total += v;
        }
    }
    if (1..=3999).contains(&total) && to_roman(total as u32) == line {
        total.to_string()
    } else {
        "invalid".into()
    }
}

fn main() {
    let stdin = std::io::stdin();
    let mut out = String::new();
    for line in stdin.lock().lines() {
        let line = line.unwrap();
        if line.trim_matches(' ').is_empty() {
            continue;
        }
        out.push_str(&solve_line(&line));
        out.push('\n');
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
