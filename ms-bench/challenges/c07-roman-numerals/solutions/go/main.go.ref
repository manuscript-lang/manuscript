package main

import (
	"bufio"
	"os"
	"strconv"
	"strings"
)

var vals = []int{1000, 900, 500, 400, 100, 90, 50, 40, 10, 9, 5, 4, 1}
var syms = []string{"M", "CM", "D", "CD", "C", "XC", "L", "XL", "X", "IX", "V", "IV", "I"}

func toRoman(n int) string {
	var sb strings.Builder
	for i, v := range vals {
		for n >= v {
			sb.WriteString(syms[i])
			n -= v
		}
	}
	return sb.String()
}

func letterValue(c byte) int {
	switch c {
	case 'I':
		return 1
	case 'V':
		return 5
	case 'X':
		return 10
	case 'L':
		return 50
	case 'C':
		return 100
	case 'D':
		return 500
	case 'M':
		return 1000
	}
	return 0
}

func solveLine(line string) string {
	digits, roman := true, true
	for i := 0; i < len(line); i++ {
		if line[i] < '0' || line[i] > '9' {
			digits = false
		}
		if letterValue(line[i]) == 0 {
			roman = false
		}
	}
	if digits {
		if line[0] == '0' {
			return "invalid"
		}
		n, _ := strconv.Atoi(line)
		if n >= 1 && n <= 3999 {
			return toRoman(n)
		}
		return "invalid"
	}
	if !roman {
		return "invalid"
	}
	total := 0
	for i := 0; i < len(line); i++ {
		v := letterValue(line[i])
		if i+1 < len(line) && letterValue(line[i+1]) > v {
			total -= v
		} else {
			total += v
		}
	}
	if total >= 1 && total <= 3999 && toRoman(total) == line {
		return strconv.Itoa(total)
	}
	return "invalid"
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	for sc.Scan() {
		l := sc.Text()
		if strings.Trim(l, " ") == "" {
			continue
		}
		w.WriteString(solveLine(l) + "\n")
	}
}
