import {stdin, stdout, read_line} from "@std/io.ms"

# Digit value of a code point (0-9, a-z, A-Z), or -1.
fn digit_value(c: Int) -> Int:
    if c >= 48 and c <= 57:
        return c - 48
    if c >= 97 and c <= 122:
        return c - 87
    if c >= 65 and c <= 90:
        return c - 55
    return -1

# Parses 1 to 18 ASCII decimal digits.
fn parse_number(s: String) -> Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() < 1 or codes.length() > 18:
        return none
    var n = 0
    for c in codes:
        if c < 48 or c > 57:
            return none
        n = n * 10 + (c - 48)
    return some(n)

fn gcd(a: Int, b: Int) -> Int:
    var x = a
    var y = b
    while y != 0:
        let t = x % y
        x = y
        y = t
    return x

fn base_cmd(t: List[String]) -> String:
    let alphabet = "0123456789abcdefghijklmnopqrstuvwxyz".chars()
    let radix_in_opt = parse_number(t.at(2).unwrap())
    let radix_out_opt = parse_number(t.at(3).unwrap())
    if radix_in_opt.is_none() or radix_out_opt.is_none():
        return "error: bad base"
    let radix_in = radix_in_opt.unwrap()
    let radix_out = radix_out_opt.unwrap()
    if radix_in < 2 or radix_in > 36 or radix_out < 2 or radix_out > 36:
        return "error: bad base"
    let v = t.at(1).unwrap()
    if v.is_empty():
        return "error: bad digit"
    var n = 0
    for c in v.scalar_values():
        let d = digit_value(c)
        if d < 0 or d >= radix_in:
            return "error: bad digit"
        n = n * radix_in + d
    if n == 0:
        return "0"
    let out = List[String]()
    while n > 0:
        out.append(alphabet.at(n % radix_out).unwrap())
        n = n / radix_out
    return out.reverse().join("")

fn solve_line(line: String) -> String:
    let t = line.split(" ")
    let name = t.at(0).unwrap()
    var want = 0
    if name == "gcd" or name == "lcm":
        want = 3
    else if name == "isprime" or name == "factor":
        want = 2
    else if name == "base":
        want = 4
    else:
        return "error: unknown command"
    if t.length() != want:
        return "error: bad arguments"
    if name == "base":
        return base_cmd(t)
    let nums = List[Int]()
    var i = 1
    while i < t.length():
        let n = parse_number(t.at(i).unwrap())
        if n.is_none():
            return "error: bad arguments"
        nums.append(n.unwrap())
        i = i + 1
    if name == "gcd" or name == "lcm":
        let a = nums.at(0).unwrap()
        let b = nums.at(1).unwrap()
        if a > 1000000000 or b > 1000000000:
            return "error: out of range"
        let g = gcd(a, b)
        if name == "gcd":
            return "{g}"
        if a == 0 or b == 0:
            return "0"
        return "{a / g * b}"
    var n = nums.at(0).unwrap()
    if n > 10000000000:
        return "error: out of range"
    if name == "isprime":
        if n < 2:
            return "neither"
        var p = 2
        while p * p <= n:
            if n % p == 0:
                return "composite"
            p = p + 1
        return "prime"
    if n < 2:
        return "error: n must be at least 2"
    let parts = List[String]()
    var p = 2
    while p * p <= n:
        if n % p == 0:
            var e = 0
            while n % p == 0:
                n = n / p
                e = e + 1
            if e > 1:
                parts.append("{p}^{e}")
            else:
                parts.append("{p}")
        p = p + 1
    if n > 1:
        parts.append("{n}")
    return parts.join(" * ")

fn run() -> Result[Unit, Error]:
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let line = next.unwrap()
        if line.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        try stdout().write("{solve_line(line)}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
