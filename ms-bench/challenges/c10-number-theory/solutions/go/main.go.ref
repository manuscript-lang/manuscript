package main

import (
	"bufio"
	"fmt"
	"os"
	"strings"
)

const digits = "0123456789abcdefghijklmnopqrstuvwxyz"

var arity = map[string]int{"gcd": 3, "lcm": 3, "isprime": 2, "factor": 2, "base": 4}

// parseNumber returns the value of 1 to 18 ASCII digits.
func parseNumber(s string) (int64, bool) {
	if len(s) < 1 || len(s) > 18 {
		return 0, false
	}
	var n int64
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return 0, false
		}
		n = n*10 + int64(s[i]-'0')
	}
	return n, true
}

func gcd(a, b int64) int64 {
	for b != 0 {
		a, b = b, a%b
	}
	return a
}

func baseCmd(t []string) string {
	v := t[1]
	var bases [2]int64
	for i, s := range t[2:] {
		n, ok := parseNumber(s)
		if !ok || n < 2 || n > 36 {
			return "error: bad base"
		}
		bases[i] = n
	}
	from, to := bases[0], bases[1]
	if v == "" {
		return "error: bad digit"
	}
	var n int64
	for _, c := range strings.ToLower(v) {
		d := strings.IndexRune(digits, c)
		if d < 0 || int64(d) >= from {
			return "error: bad digit"
		}
		n = n*from + int64(d)
	}
	if n == 0 {
		return "0"
	}
	var out []byte
	for n > 0 {
		out = append([]byte{digits[n%to]}, out...)
		n /= to
	}
	return string(out)
}

func solveLine(line string) string {
	t := strings.Split(line, " ")
	want, known := arity[t[0]]
	if !known {
		return "error: unknown command"
	}
	if len(t) != want {
		return "error: bad arguments"
	}
	if t[0] == "base" {
		return baseCmd(t)
	}
	nums := make([]int64, 0, 2)
	for _, s := range t[1:] {
		n, ok := parseNumber(s)
		if !ok {
			return "error: bad arguments"
		}
		nums = append(nums, n)
	}
	switch t[0] {
	case "gcd", "lcm":
		for _, n := range nums {
			if n > 1000000000 {
				return "error: out of range"
			}
		}
		g := gcd(nums[0], nums[1])
		if t[0] == "gcd" {
			return fmt.Sprint(g)
		}
		if nums[0] == 0 || nums[1] == 0 {
			return "0"
		}
		return fmt.Sprint(nums[0] / g * nums[1])
	}
	n := nums[0]
	if n > 10000000000 {
		return "error: out of range"
	}
	if t[0] == "isprime" {
		if n < 2 {
			return "neither"
		}
		for p := int64(2); p*p <= n; p++ {
			if n%p == 0 {
				return "composite"
			}
		}
		return "prime"
	}
	if n < 2 {
		return "error: n must be at least 2"
	}
	var parts []string
	for p := int64(2); p*p <= n; p++ {
		if n%p != 0 {
			continue
		}
		e := 0
		for n%p == 0 {
			n /= p
			e++
		}
		if e > 1 {
			parts = append(parts, fmt.Sprintf("%d^%d", p, e))
		} else {
			parts = append(parts, fmt.Sprint(p))
		}
	}
	if n > 1 {
		parts = append(parts, fmt.Sprint(n))
	}
	return strings.Join(parts, " * ")
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	for sc.Scan() {
		l := sc.Text()
		if strings.Trim(l, " ") == "" {
			continue
		}
		w.WriteString(solveLine(l) + "\n")
	}
}
