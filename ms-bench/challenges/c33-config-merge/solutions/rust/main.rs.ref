use std::collections::{BTreeMap, HashMap};
use std::io::{self, Read, Write};

#[derive(Clone)]
enum Val {
    Str(String),
    Int(i64),
    Bool(bool),
    List(Vec<Val>),
}

fn trim(s: &str) -> &str {
    s.trim_matches(|c| c == ' ' || c == '\t')
}

fn valid_key(k: &str) -> bool {
    !k.is_empty()
        && k.split('.').all(|seg| {
            let b = seg.as_bytes();
            !b.is_empty()
                && (b[0].is_ascii_lowercase() || b[0] == b'_')
                && b[1..].iter().all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || *c == b'_')
        })
}

fn is_int(s: &str) -> bool {
    let d = s.strip_prefix('-').unwrap_or(s);
    (1..=15).contains(&d.len()) && d.bytes().all(|c| c.is_ascii_digit())
}

fn scalar(p: &str) -> Val {
    if p == "true" || p == "false" {
        return Val::Bool(p == "true");
    }
    if is_int(p) {
        return Val::Int(p.parse().unwrap());
    }
    if p.len() >= 2 && p.starts_with('"') && p.ends_with('"') {
        return Val::Str(p[1..p.len() - 1].to_string());
    }
    Val::Str(p.to_string())
}

fn parse_value(v: &str) -> Option<Val> {
    if v == "true" || v == "false" || is_int(v) {
        return Some(scalar(v));
    }
    if v.starts_with('"') {
        let b = v.as_bytes();
        let mut out = Vec::new();
        let mut i = 1;
        while i < b.len() {
            let c = b[i];
            if c == b'\\' && i + 1 < b.len() && (b[i + 1] == b'"' || b[i + 1] == b'\\') {
                out.push(b[i + 1]);
                i += 2;
                continue;
            }
            if c == b'"' {
                return if i == b.len() - 1 { Some(Val::Str(String::from_utf8(out).unwrap())) } else { None };
            }
            out.push(c);
            i += 1;
        }
        return None;
    }
    if v.starts_with('[') {
        if !v.ends_with(']') || v.len() < 2 {
            return None;
        }
        let inner = &v[1..v.len() - 1];
        if trim(inner).is_empty() {
            return Some(Val::List(vec![]));
        }
        let mut items = Vec::new();
        for piece in inner.split(',') {
            let p = trim(piece);
            if p.is_empty() {
                return None;
            }
            items.push(scalar(p));
        }
        return Some(Val::List(items));
    }
    Some(Val::Str(v.to_string()))
}

fn plain(v: &Val) -> String {
    match v {
        Val::Str(s) => s.clone(),
        Val::Int(i) => i.to_string(),
        Val::Bool(b) => b.to_string(),
        Val::List(l) => l.iter().map(plain).collect::<Vec<_>>().join(","),
    }
}

fn render(v: &Val) -> String {
    match v {
        Val::Str(s) => format!("\"{}\"", s.replace('\\', "\\\\").replace('"', "\\\"")),
        Val::List(l) => format!("[{}]", l.iter().map(render).collect::<Vec<_>>().join(", ")),
        _ => plain(v),
    }
}

struct Resolver<'a> {
    vals: &'a BTreeMap<String, Val>,
    memo: HashMap<String, Val>,
    key_errs: BTreeMap<String, Vec<String>>,
}

impl<'a> Resolver<'a> {
    fn resolve(&mut self, key: &str) -> Val {
        if let Some(m) = self.memo.get(key) {
            return m.clone();
        }
        let v = self.vals[key].clone();
        let text = match &v {
            Val::Str(s) => s.clone(),
            _ => {
                self.memo.insert(key.to_string(), v.clone());
                return v;
            }
        };
        let mut out = String::new();
        let mut i = 0;
        while i < text.len() {
            if text[i..].starts_with("${") {
                if let Some(j) = text[i + 2..].find('}') {
                    let name = &text[i + 2..i + 2 + j];
                    if valid_key(name) {
                        if self.vals.contains_key(name) {
                            let r = self.resolve(name);
                            out.push_str(&plain(&r));
                        } else {
                            out.push_str(&text[i..i + 3 + j]);
                            self.key_errs
                                .entry(key.to_string())
                                .or_default()
                                .push(format!("key {}: unresolved ${{{}}}", key, name));
                        }
                        i += j + 3;
                        continue;
                    }
                }
            }
            let ch = text[i..].chars().next().unwrap();
            out.push(ch);
            i += ch.len_utf8();
        }
        let r = Val::Str(out);
        self.memo.insert(key.to_string(), r.clone());
        r
    }
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut lines: Vec<&str> = input.split('\n').collect();
    if lines.last() == Some(&"") {
        lines.pop();
    }
    let mut layer = "base".to_string();
    let mut vals: BTreeMap<String, Val> = BTreeMap::new();
    let mut source: HashMap<String, String> = HashMap::new();
    let mut errs: Vec<String> = Vec::new();
    for (idx, raw) in lines.iter().enumerate() {
        let n = idx + 1;
        let l = trim(raw);
        if l.is_empty() || l.starts_with('#') {
            continue;
        }
        if let Some(rest) = l.strip_prefix("@@") {
            let name = trim(rest);
            layer = if name.is_empty() { "unnamed".to_string() } else { name.to_string() };
            continue;
        }
        if let Some(rest) = l.strip_prefix('!') {
            let k = trim(rest);
            if !valid_key(k) {
                errs.push(format!("line {}: syntax error", n));
                continue;
            }
            let prefix = format!("{}.", k);
            let doomed: Vec<String> = vals.keys().filter(|x| x.as_str() == k || x.starts_with(&prefix)).cloned().collect();
            for x in doomed {
                vals.remove(&x);
                source.remove(&x);
            }
            continue;
        }
        let eq = match l.find('=') {
            Some(e) => e,
            None => {
                errs.push(format!("line {}: syntax error", n));
                continue;
            }
        };
        let append = eq > 0 && l.as_bytes()[eq - 1] == b'+';
        let key = trim(&l[..if append { eq - 1 } else { eq }]);
        if !valid_key(key) {
            errs.push(format!("line {}: syntax error", n));
            continue;
        }
        let v = match parse_value(trim(&l[eq + 1..])) {
            Some(v) => v,
            None => {
                errs.push(format!("line {}: syntax error", n));
                continue;
            }
        };
        if append {
            let mut items = match vals.get(key) {
                None => Vec::new(),
                Some(Val::List(cur)) => cur.clone(),
                Some(_) => {
                    errs.push(format!("line {}: cannot append to non-list", n));
                    continue;
                }
            };
            match v {
                Val::List(more) => items.extend(more),
                other => items.push(other),
            }
            vals.insert(key.to_string(), Val::List(items));
        } else {
            vals.insert(key.to_string(), v);
        }
        source.insert(key.to_string(), layer.clone());
    }
    let keys: Vec<String> = vals.keys().cloned().collect();
    let mut r = Resolver { vals: &vals, memo: HashMap::new(), key_errs: BTreeMap::new() };
    let mut out = String::new();
    for k in &keys {
        let v = r.resolve(k);
        out.push_str(&format!("{} = {}  # {}\n", k, render(&v), source[k]));
    }
    let mut msgs = errs;
    for list in r.key_errs.values() {
        msgs.extend(list.iter().cloned());
    }
    if !msgs.is_empty() {
        out.push_str("errors:\n");
        for m in msgs {
            out.push_str(&format!("  {}\n", m));
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
