package main

import (
	"bufio"
	"fmt"
	"io"
	"os"
	"sort"
	"strconv"
	"strings"
)

type val struct {
	kind byte // 's' string, 'i' int, 'b' bool, 'l' list
	s    string
	i    int64
	b    bool
	list []val
}

func trim(s string) string { return strings.Trim(s, " \t") }

func isLower(c byte) bool { return (c >= 'a' && c <= 'z') || c == '_' }
func isDigit(c byte) bool { return c >= '0' && c <= '9' }

func validKey(k string) bool {
	if k == "" {
		return false
	}
	for _, seg := range strings.Split(k, ".") {
		if seg == "" || !isLower(seg[0]) {
			return false
		}
		for j := 1; j < len(seg); j++ {
			if !isLower(seg[j]) && !isDigit(seg[j]) {
				return false
			}
		}
	}
	return true
}

func isInt(s string) bool {
	d := strings.TrimPrefix(s, "-")
	if len(d) < 1 || len(d) > 15 {
		return false
	}
	for i := 0; i < len(d); i++ {
		if !isDigit(d[i]) {
			return false
		}
	}
	return true
}

func scalar(p string) val {
	if p == "true" || p == "false" {
		return val{kind: 'b', b: p == "true"}
	}
	if isInt(p) {
		n, _ := strconv.ParseInt(p, 10, 64)
		return val{kind: 'i', i: n}
	}
	if len(p) >= 2 && p[0] == '"' && p[len(p)-1] == '"' {
		return val{kind: 's', s: p[1 : len(p)-1]}
	}
	return val{kind: 's', s: p}
}

func parseValue(v string) (val, bool) {
	if v == "true" || v == "false" || isInt(v) {
		return scalar(v), true
	}
	if strings.HasPrefix(v, "\"") {
		var out []byte
		for i := 1; i < len(v); {
			c := v[i]
			if c == '\\' && i+1 < len(v) && (v[i+1] == '"' || v[i+1] == '\\') {
				out = append(out, v[i+1])
				i += 2
				continue
			}
			if c == '"' {
				if i == len(v)-1 {
					return val{kind: 's', s: string(out)}, true
				}
				return val{}, false
			}
			out = append(out, c)
			i++
		}
		return val{}, false
	}
	if strings.HasPrefix(v, "[") {
		if !strings.HasSuffix(v, "]") || len(v) < 2 {
			return val{}, false
		}
		inner := v[1 : len(v)-1]
		if trim(inner) == "" {
			return val{kind: 'l'}, true
		}
		var items []val
		for _, piece := range strings.Split(inner, ",") {
			p := trim(piece)
			if p == "" {
				return val{}, false
			}
			items = append(items, scalar(p))
		}
		return val{kind: 'l', list: items}, true
	}
	return val{kind: 's', s: v}, true
}

func plain(v val) string {
	switch v.kind {
	case 's':
		return v.s
	case 'i':
		return strconv.FormatInt(v.i, 10)
	case 'b':
		return strconv.FormatBool(v.b)
	}
	parts := make([]string, len(v.list))
	for i, it := range v.list {
		parts[i] = plain(it)
	}
	return strings.Join(parts, ",")
}

func render(v val) string {
	switch v.kind {
	case 's':
		return "\"" + strings.NewReplacer("\\", "\\\\", "\"", "\\\"").Replace(v.s) + "\""
	case 'l':
		parts := make([]string, len(v.list))
		for i, it := range v.list {
			parts[i] = render(it)
		}
		return "[" + strings.Join(parts, ", ") + "]"
	}
	return plain(v)
}

var (
	vals    = map[string]val{}
	memo    = map[string]val{}
	keyErrs = map[string][]string{}
)

func resolve(key string) val {
	if m, ok := memo[key]; ok {
		return m
	}
	v := vals[key]
	if v.kind != 's' {
		memo[key] = v
		return v
	}
	text := v.s
	var out strings.Builder
	for i := 0; i < len(text); {
		if strings.HasPrefix(text[i:], "${") {
			if j := strings.IndexByte(text[i+2:], '}'); j >= 0 && validKey(text[i+2:i+2+j]) {
				name := text[i+2 : i+2+j]
				if _, ok := vals[name]; ok {
					out.WriteString(plain(resolve(name)))
				} else {
					out.WriteString(text[i : i+3+j])
					keyErrs[key] = append(keyErrs[key], fmt.Sprintf("key %s: unresolved ${%s}", key, name))
				}
				i += j + 3
				continue
			}
		}
		out.WriteByte(text[i])
		i++
	}
	r := val{kind: 's', s: out.String()}
	memo[key] = r
	return r
}

func main() {
	data, _ := io.ReadAll(os.Stdin)
	lines := strings.Split(string(data), "\n")
	if lines[len(lines)-1] == "" {
		lines = lines[:len(lines)-1]
	}
	layer := "base"
	source := map[string]string{}
	var errs []string
	for idx, raw := range lines {
		n := idx + 1
		l := trim(raw)
		if l == "" || l[0] == '#' {
			continue
		}
		if strings.HasPrefix(l, "@@") {
			layer = trim(l[2:])
			if layer == "" {
				layer = "unnamed"
			}
			continue
		}
		if l[0] == '!' {
			k := trim(l[1:])
			if !validKey(k) {
				errs = append(errs, fmt.Sprintf("line %d: syntax error", n))
				continue
			}
			for x := range vals {
				if x == k || strings.HasPrefix(x, k+".") {
					delete(vals, x)
					delete(source, x)
				}
			}
			continue
		}
		eq := strings.IndexByte(l, '=')
		if eq < 0 {
			errs = append(errs, fmt.Sprintf("line %d: syntax error", n))
			continue
		}
		app := eq > 0 && l[eq-1] == '+'
		end := eq
		if app {
			end = eq - 1
		}
		key := trim(l[:end])
		if !validKey(key) {
			errs = append(errs, fmt.Sprintf("line %d: syntax error", n))
			continue
		}
		v, ok := parseValue(trim(l[eq+1:]))
		if !ok {
			errs = append(errs, fmt.Sprintf("line %d: syntax error", n))
			continue
		}
		if app {
			cur, exists := vals[key]
			if !exists {
				cur = val{kind: 'l'}
			}
			if cur.kind != 'l' {
				errs = append(errs, fmt.Sprintf("line %d: cannot append to non-list", n))
				continue
			}
			merged := append([]val{}, cur.list...)
			if v.kind == 'l' {
				merged = append(merged, v.list...)
			} else {
				merged = append(merged, v)
			}
			vals[key] = val{kind: 'l', list: merged}
		} else {
			vals[key] = v
		}
		source[key] = layer
	}
	keys := make([]string, 0, len(vals))
	for k := range vals {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	for _, k := range keys {
		fmt.Fprintf(out, "%s = %s  # %s\n", k, render(resolve(k)), source[k])
	}
	msgs := errs
	ek := make([]string, 0, len(keyErrs))
	for k := range keyErrs {
		ek = append(ek, k)
	}
	sort.Strings(ek)
	for _, k := range ek {
		msgs = append(msgs, keyErrs[k]...)
	}
	if len(msgs) > 0 {
		fmt.Fprintln(out, "errors:")
		for _, m := range msgs {
			fmt.Fprintln(out, "  "+m)
		}
	}
}
