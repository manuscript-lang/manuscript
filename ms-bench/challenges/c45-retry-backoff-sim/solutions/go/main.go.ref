package main

import (
	"bufio"
	"fmt"
	"os"
	"strconv"
	"strings"
)

type req struct {
	id     string
	start  int64
	k      int64
	t      int64
	status string
	done   int64
}

func num(s string) int64 {
	v, _ := strconv.ParseInt(s, 10, 64)
	return v
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<26)
	var base, factor, capv, max, jit, deadline, seed int64 = 100, 2, 5000, 5, 0, 0, 1
	var downs [][2]int64
	var limWin, limCount int64
	hasLimit := false
	var reqs []*req
	for sc.Scan() {
		t := strings.Fields(strings.ReplaceAll(sc.Text(), "\t", " "))
		if len(t) == 0 {
			continue
		}
		switch t[0] {
		case "policy":
			base, factor, capv, max = num(t[1]), num(t[2]), num(t[3]), num(t[4])
			jit, deadline, seed = num(t[5]), num(t[6]), num(t[7])
		case "down":
			downs = append(downs, [2]int64{num(t[1]), num(t[2])})
		case "limit":
			limWin, limCount, hasLimit = num(t[1]), num(t[2]), true
		case "req":
			reqs = append(reqs, &req{id: t[1], start: num(t[2]), k: 1, t: num(t[2])})
		}
	}
	state := seed
	var accepted []int64
	var out []string
	for {
		var r *req
		for _, q := range reqs {
			if q.status != "" {
				continue
			}
			if r == nil || q.t < r.t {
				r = q
			}
		}
		if r == nil {
			break
		}
		t, k := r.t, r.k
		res := ""
		var retryAfter int64
		for _, d := range downs {
			if d[0] <= t && t < d[1] {
				res = "down"
				break
			}
		}
		if res == "" {
			if hasLimit {
				cnt := int64(0)
				oldest := int64(0)
				for _, a := range accepted {
					if a > t-limWin {
						if cnt == 0 || a < oldest {
							oldest = a
						}
						cnt++
					}
				}
				if cnt >= limCount {
					res = "limited"
					retryAfter = oldest + limWin - t
				}
			}
			if res == "" {
				accepted = append(accepted, t)
				r.status = "ok"
				r.done = t
				out = append(out, fmt.Sprintf("t=%d %s #%d ok", t, r.id, k))
				continue
			}
		}
		r.done = t
		if k == max {
			r.status = "gave-up"
			out = append(out, fmt.Sprintf("t=%d %s #%d %s gave-up", t, r.id, k, res))
			continue
		}
		d := base
		if capv < d {
			d = capv
		}
		for i := int64(1); i < k; i++ {
			d *= factor
			if capv < d {
				d = capv
			}
		}
		state = state * 48271 % 2147483647
		rr := state % 1000
		d2 := d - d*jit*rr/100000
		if d2 < 1 {
			d2 = 1
		}
		wait := d2
		if res == "limited" && retryAfter > wait {
			wait = retryAfter
		}
		nt := t + wait
		if deadline > 0 && nt > r.start+deadline {
			r.status = "expired"
			out = append(out, fmt.Sprintf("t=%d %s #%d %s expired", t, r.id, k, res))
			continue
		}
		out = append(out, fmt.Sprintf("t=%d %s #%d %s retry@%d", t, r.id, k, res, nt))
		r.t = nt
		r.k = k + 1
	}
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	for _, o := range out {
		fmt.Fprintln(w, o)
	}
	okN, att := 0, int64(0)
	for _, r := range reqs {
		fmt.Fprintf(w, "%s %s attempts=%d done=%d\n", r.id, r.status, r.k, r.done)
		if r.status == "ok" {
			okN++
		}
		att += r.k
	}
	fmt.Fprintf(w, "total ok=%d failed=%d attempts=%d\n", okN, len(reqs)-okN, att)
}
