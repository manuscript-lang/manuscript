import { readFileSync } from "node:fs";

type Req = { id: string; start: number; k: number; t: number; status: string; done: number };

let base = 100;
let factor = 2;
let cap = 5000;
let max = 5;
let jit = 0;
let deadline = 0;
let seed = 1;
const downs: [number, number][] = [];
let limit: [number, number] | null = null;
const reqs: Req[] = [];

for (const line of readFileSync(0, "utf8").split("\n")) {
  const t = line.split(/[ \t]+/).filter((x) => x !== "");
  if (t.length === 0) continue;
  if (t[0] === "policy") {
    [base, factor, cap, max, jit, deadline, seed] = t.slice(1).map(Number);
  } else if (t[0] === "down") {
    downs.push([Number(t[1]), Number(t[2])]);
  } else if (t[0] === "limit") {
    limit = [Number(t[1]), Number(t[2])];
  } else if (t[0] === "req") {
    reqs.push({ id: t[1], start: Number(t[2]), k: 1, t: Number(t[2]), status: "", done: 0 });
  }
}

let state = seed;
const accepted: number[] = [];
const log: string[] = [];
for (;;) {
  let r: Req | null = null;
  for (const q of reqs) {
    if (q.status !== "") continue;
    if (r === null || q.t < r.t) r = q;
  }
  if (r === null) break;
  const t = r.t;
  const k = r.k;
  let res = "";
  let retryAfter = 0;
  if (downs.some(([a, b]) => a <= t && t < b)) res = "down";
  else {
    if (limit !== null) {
      const inWin = accepted.filter((a) => a > t - limit![0]);
      if (inWin.length >= limit[1]) {
        res = "limited";
        retryAfter = Math.min(...inWin) + limit[0] - t;
      }
    }
    if (res === "") {
      accepted.push(t);
      r.status = "ok";
      r.done = t;
      log.push(`t=${t} ${r.id} #${k} ok`);
      continue;
    }
  }
  r.done = t;
  if (k === max) {
    r.status = "gave-up";
    log.push(`t=${t} ${r.id} #${k} ${res} gave-up`);
    continue;
  }
  let d = Math.min(cap, base);
  for (let i = 1; i < k; i++) d = Math.min(cap, d * factor);
  state = (state * 48271) % 2147483647;
  const rr = state % 1000;
  const d2 = Math.max(1, d - Math.floor((d * jit * rr) / 100000));
  const wait = res === "limited" ? Math.max(d2, retryAfter) : d2;
  const nt = t + wait;
  if (deadline > 0 && nt > r.start + deadline) {
    r.status = "expired";
    log.push(`t=${t} ${r.id} #${k} ${res} expired`);
    continue;
  }
  log.push(`t=${t} ${r.id} #${k} ${res} retry@${nt}`);
  r.t = nt;
  r.k = k + 1;
}
const out = [...log];
for (const r of reqs) out.push(`${r.id} ${r.status} attempts=${r.k} done=${r.done}`);
const ok = reqs.filter((r) => r.status === "ok").length;
out.push(`total ok=${ok} failed=${reqs.length - ok} attempts=${reqs.reduce((s, r) => s + r.k, 0)}`);
process.stdout.write(out.map((o) => o + "\n").join(""));
