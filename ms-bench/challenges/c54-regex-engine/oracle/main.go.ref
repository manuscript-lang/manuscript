// Oracle for c54-regex-engine.
package main

import (
	"bufio"
	"fmt"
	"os"
	"strconv"
	"strings"
)

type RErr struct{ msg string }

func rfail(m string) { panic(RErr{m}) }

type Node struct {
	kind     string // char any class seq alt group repeat bol eol wordb nwordb backref look empty
	ch       byte
	set      [256]bool
	neg      bool
	kids     []*Node
	idx      int // capture index for group / backref
	min, max int
	greedy   bool
	negLook  bool
	name     string
}

type Regex struct {
	root    *Node
	ngroups int
	names   []string // names[i] is name of group i+1 ("" if none)
	icase   bool
	dotall  bool
	multi   bool
}

type P struct {
	s       string
	i       int
	r       *Regex
	refs    []*Node
	nameIdx map[string]int
}

func (p *P) more() bool { return p.i < len(p.s) }

func isWord(c byte) bool {
	return c == '_' || (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}
func hexv(c byte) int {
	switch {
	case c >= '0' && c <= '9':
		return int(c - '0')
	case c >= 'a' && c <= 'f':
		return int(c-'a') + 10
	case c >= 'A' && c <= 'F':
		return int(c-'A') + 10
	}
	return -1
}
func isAlnum(c byte) bool {
	return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
}

func shorthand(c byte) (set [256]bool, ok bool) {
	ok = true
	switch c {
	case 'd', 'D':
		for x := '0'; x <= '9'; x++ {
			set[x] = true
		}
	case 'w', 'W':
		for x := 0; x < 256; x++ {
			set[x] = isWord(byte(x))
		}
	case 's', 'S':
		for _, x := range " \t\n\r\f\v" {
			set[x] = true
		}
	default:
		return set, false
	}
	if c == 'D' || c == 'W' || c == 'S' {
		for x := 0; x < 256; x++ {
			set[x] = !set[x]
		}
	}
	return
}

func (p *P) parseAlt() *Node {
	var alts []*Node
	alts = append(alts, p.parseSeq())
	for p.more() && p.s[p.i] == '|' {
		p.i++
		alts = append(alts, p.parseSeq())
	}
	if len(alts) == 1 {
		return alts[0]
	}
	return &Node{kind: "alt", kids: alts}
}

func (p *P) quantAt() (min, max int, n int, ok bool) {
	// returns quantifier at p.i (without lazy marker); n = chars consumed
	if !p.more() {
		return
	}
	switch p.s[p.i] {
	case '*':
		return 0, -1, 1, true
	case '+':
		return 1, -1, 1, true
	case '?':
		return 0, 1, 1, true
	case '{':
		j := p.i + 1
		k := j
		for k < len(p.s) && p.s[k] >= '0' && p.s[k] <= '9' {
			k++
		}
		if k == j {
			return
		}
		a, _ := strconv.Atoi(p.s[j:k])
		if len(p.s[j:k]) > 4 {
			a = 99999
		}
		if k < len(p.s) && p.s[k] == '}' {
			return a, a, k + 1 - p.i, true
		}
		if k < len(p.s) && p.s[k] == ',' {
			k++
			j2 := k
			for k < len(p.s) && p.s[k] >= '0' && p.s[k] <= '9' {
				k++
			}
			if k < len(p.s) && p.s[k] == '}' {
				if k == j2 {
					return a, -1, k + 1 - p.i, true
				}
				b, _ := strconv.Atoi(p.s[j2:k])
				if len(p.s[j2:k]) > 4 {
					b = 99999
				}
				return a, b, k + 1 - p.i, true
			}
		}
	}
	return
}

func (p *P) parseSeq() *Node {
	seq := &Node{kind: "seq"}
	for p.more() && p.s[p.i] != '|' && p.s[p.i] != ')' {
		atom := p.parseAtom()
		if mn, mx, n, ok := p.quantAt(); ok {
			if atom.kind == "bol" || atom.kind == "eol" || atom.kind == "wordb" || atom.kind == "nwordb" || atom.kind == "look" {
				rfail("nothing to repeat")
			}
			if mx != -1 && mn > mx || mn > 1000 || mx > 1000 {
				rfail("bad repeat")
			}
			p.i += n
			greedy := true
			if p.more() && p.s[p.i] == '?' {
				greedy = false
				p.i++
			}
			if _, _, _, ok2 := p.quantAt(); ok2 {
				rfail("nothing to repeat")
			}
			atom = &Node{kind: "repeat", kids: []*Node{atom}, min: mn, max: mx, greedy: greedy}
		}
		seq.kids = append(seq.kids, atom)
	}
	return seq
}

func (p *P) parseEscape(inClass bool) (*Node, byte, bool) {
	// at p.s[p.i] == '\\'; returns (node for non-literal, literal byte, isLiteral)
	p.i++
	if !p.more() {
		rfail("bad escape")
	}
	c := p.s[p.i]
	p.i++
	if set, ok := shorthand(c); ok {
		return &Node{kind: "class", set: set}, 0, false
	}
	switch c {
	case 'n':
		return nil, '\n', true
	case 't':
		return nil, '\t', true
	case 'r':
		return nil, '\r', true
	case 'x':
		if p.i+1 < len(p.s) && hexv(p.s[p.i]) >= 0 && hexv(p.s[p.i+1]) >= 0 {
			v := hexv(p.s[p.i])*16 + hexv(p.s[p.i+1])
			p.i += 2
			return nil, byte(v), true
		}
		rfail("bad escape")
	}
	if !isAlnum(c) {
		return nil, c, true
	}
	if !inClass {
		switch {
		case c == 'b':
			return &Node{kind: "wordb"}, 0, false
		case c == 'B':
			return &Node{kind: "nwordb"}, 0, false
		case c >= '1' && c <= '9':
			n := &Node{kind: "backref", idx: int(c - '0')}
			p.refs = append(p.refs, n)
			return n, 0, false
		case c == 'k':
			if p.more() && p.s[p.i] == '<' {
				j := strings.IndexByte(p.s[p.i:], '>')
				if j > 1 {
					n := &Node{kind: "backref", name: p.s[p.i+1 : p.i+j]}
					p.i += j + 1
					p.refs = append(p.refs, n)
					return n, 0, false
				}
			}
			rfail("bad escape")
		}
	}
	rfail("bad escape")
	return nil, 0, false
}

func (p *P) parseClass() *Node {
	n := &Node{kind: "class"}
	p.i++ // [
	if p.more() && p.s[p.i] == '^' {
		n.neg = true
		p.i++
	}
	first := true
	for {
		if !p.more() {
			rfail("unterminated class")
		}
		c := p.s[p.i]
		if c == ']' && !first {
			p.i++
			break
		}
		first = false
		// read one item
		var lo byte
		var loSet *Node
		if c == '\\' {
			nd, lit, isLit := p.parseEscape(true)
			if isLit {
				lo = lit
			} else {
				loSet = nd
			}
		} else {
			lo = c
			p.i++
		}
		if loSet != nil {
			for x := 0; x < 256; x++ {
				if loSet.set[x] {
					n.set[x] = true
				}
			}
			if p.more() && p.s[p.i] == '-' && p.i+1 < len(p.s) && p.s[p.i+1] != ']' {
				rfail("bad range")
			}
			continue
		}
		if p.more() && p.s[p.i] == '-' && p.i+1 < len(p.s) && p.s[p.i+1] != ']' {
			p.i++
			var hi byte
			if p.s[p.i] == '\\' {
				nd, lit, isLit := p.parseEscape(true)
				if !isLit {
					_ = nd
					rfail("bad range")
				}
				hi = lit
			} else {
				hi = p.s[p.i]
				p.i++
			}
			if hi < lo {
				rfail("bad range")
			}
			for x := int(lo); x <= int(hi); x++ {
				n.set[x] = true
			}
		} else {
			n.set[lo] = true
		}
	}
	return n
}

func (p *P) parseAtom() *Node {
	c := p.s[p.i]
	switch c {
	case '*', '+', '?':
		rfail("nothing to repeat")
	case '(':
		p.i++
		kind := "group"
		name := ""
		neg := false
		if p.more() && p.s[p.i] == '?' {
			p.i++
			if !p.more() {
				rfail("bad group")
			}
			switch p.s[p.i] {
			case ':':
				p.i++
				kind = "ncgroup"
			case '=':
				p.i++
				kind = "look"
			case '!':
				p.i++
				kind = "look"
				neg = true
			case '<':
				j := p.i + 1
				k := j
				for k < len(p.s) && isWord(p.s[k]) {
					k++
				}
				if k == j || k >= len(p.s) || p.s[k] != '>' || (p.s[j] >= '0' && p.s[j] <= '9') {
					rfail("bad group")
				}
				name = p.s[j:k]
				p.i = k + 1
			default:
				rfail("bad group")
			}
		}
		idx := 0
		if kind == "group" {
			p.r.ngroups++
			idx = p.r.ngroups
			if name != "" {
				if _, dup := p.nameIdx[name]; dup {
					rfail("duplicate group name")
				}
				p.nameIdx[name] = idx
			}
			p.r.names = append(p.r.names, name)
		}
		body := p.parseAlt()
		if !p.more() || p.s[p.i] != ')' {
			rfail("unmatched (")
		}
		p.i++
		switch kind {
		case "group":
			return &Node{kind: "group", idx: idx, kids: []*Node{body}}
		case "look":
			return &Node{kind: "look", negLook: neg, kids: []*Node{body}}
		}
		return body
	case '[':
		return p.parseClass()
	case '.':
		p.i++
		return &Node{kind: "any"}
	case '^':
		p.i++
		return &Node{kind: "bol"}
	case '$':
		p.i++
		return &Node{kind: "eol"}
	case '\\':
		nd, lit, isLit := p.parseEscape(false)
		if isLit {
			return &Node{kind: "char", ch: lit}
		}
		return nd
	}
	p.i++
	return &Node{kind: "char", ch: c}
}

func compile(pat string) *Regex {
	r := &Regex{}
	p := &P{s: pat, r: r, nameIdx: map[string]int{}}
	if strings.HasPrefix(pat, "(?") {
		j := 2
		for j < len(pat) && (pat[j] == 'i' || pat[j] == 'm' || pat[j] == 's') {
			j++
		}
		if j > 2 && j < len(pat) && pat[j] == ')' {
			for _, f := range pat[2:j] {
				switch f {
				case 'i':
					r.icase = true
				case 'm':
					r.multi = true
				case 's':
					r.dotall = true
				}
			}
			p.i = j + 1
		}
	}
	r.root = p.parseAlt()
	if p.more() {
		rfail("unmatched )")
	}
	for _, ref := range p.refs {
		if ref.name != "" {
			idx, ok := p.nameIdx[ref.name]
			if !ok {
				rfail("bad backreference")
			}
			ref.idx = idx
		} else if ref.idx > r.ngroups {
			rfail("bad backreference")
		}
	}
	return r
}

// ---- matcher ----
type M struct {
	r     *Regex
	s     string
	caps  []int // 2*(ngroups+1), -1 unset
	steps int
}

func lower(c byte) byte {
	if c >= 'A' && c <= 'Z' {
		return c + 32
	}
	return c
}
func swap(c byte) byte {
	if c >= 'A' && c <= 'Z' {
		return c + 32
	}
	if c >= 'a' && c <= 'z' {
		return c - 32
	}
	return c
}

func (m *M) classMatch(n *Node, c byte) bool {
	in := n.set[c]
	if !in && m.r.icase {
		in = n.set[swap(c)]
	}
	return in != n.neg
}

func (m *M) wordAt(i int) bool { return i >= 0 && i < len(m.s) && isWord(m.s[i]) }

func (m *M) match(n *Node, pos int, k func(int) bool) bool {
	switch n.kind {
	case "char":
		if pos < len(m.s) && (m.s[pos] == n.ch || (m.r.icase && lower(m.s[pos]) == lower(n.ch))) {
			return k(pos + 1)
		}
		return false
	case "any":
		if pos < len(m.s) && (m.r.dotall || m.s[pos] != '\n') {
			return k(pos + 1)
		}
		return false
	case "class":
		if pos < len(m.s) && m.classMatch(n, m.s[pos]) {
			return k(pos + 1)
		}
		return false
	case "seq":
		return m.seq(n.kids, 0, pos, k)
	case "alt":
		for _, a := range n.kids {
			if m.match(a, pos, k) {
				return true
			}
		}
		return false
	case "group":
		os, oe := m.caps[2*n.idx], m.caps[2*n.idx+1]
		if m.match(n.kids[0], pos, func(e int) bool {
			ps, pe := m.caps[2*n.idx], m.caps[2*n.idx+1]
			m.caps[2*n.idx], m.caps[2*n.idx+1] = pos, e
			if k(e) {
				return true
			}
			m.caps[2*n.idx], m.caps[2*n.idx+1] = ps, pe
			return false
		}) {
			return true
		}
		m.caps[2*n.idx], m.caps[2*n.idx+1] = os, oe
		return false
	case "repeat":
		return m.loop(n, 0, pos, k)
	case "bol":
		if pos == 0 || (m.r.multi && m.s[pos-1] == '\n') {
			return k(pos)
		}
		return false
	case "eol":
		if pos == len(m.s) || (m.r.multi && m.s[pos] == '\n') {
			return k(pos)
		}
		return false
	case "wordb", "nwordb":
		b := m.wordAt(pos-1) != m.wordAt(pos)
		if b == (n.kind == "wordb") {
			return k(pos)
		}
		return false
	case "backref":
		s, e := m.caps[2*n.idx], m.caps[2*n.idx+1]
		if s < 0 {
			return false
		}
		l := e - s
		if pos+l > len(m.s) {
			return false
		}
		for j := 0; j < l; j++ {
			a, b := m.s[s+j], m.s[pos+j]
			if a != b && !(m.r.icase && lower(a) == lower(b)) {
				return false
			}
		}
		return k(pos + l)
	case "look":
		saved := append([]int{}, m.caps...)
		ok := m.match(n.kids[0], pos, func(int) bool { return true })
		if n.negLook {
			copy(m.caps, saved)
			if ok {
				return false
			}
			return k(pos)
		}
		if !ok {
			copy(m.caps, saved)
			return false
		}
		if k(pos) {
			return true
		}
		copy(m.caps, saved)
		return false
	}
	return false
}

func (m *M) seq(kids []*Node, i int, pos int, k func(int) bool) bool {
	if i == len(kids) {
		return k(pos)
	}
	return m.match(kids[i], pos, func(p int) bool { return m.seq(kids, i+1, p, k) })
}

func (m *M) loop(n *Node, count, pos int, k func(int) bool) bool {
	body := n.kids[0]
	if count < n.min {
		return m.match(body, pos, func(p int) bool { return m.loop(n, count+1, p, k) })
	}
	canMore := n.max == -1 || count < n.max
	tryBody := func() bool {
		return m.match(body, pos, func(p int) bool {
			if p == pos {
				return k(p)
			}
			return m.loop(n, count+1, p, k)
		})
	}
	if n.greedy {
		if canMore && tryBody() {
			return true
		}
		return k(pos)
	}
	if k(pos) {
		return true
	}
	return canMore && tryBody()
}

// matchAt tries a match starting exactly at start; returns end or -1. If full, must end at len.
func (r *Regex) matchAt(s string, start int, full bool) ([]int, bool) {
	m := &M{r: r, s: s, caps: make([]int, 2*(r.ngroups+1))}
	for i := range m.caps {
		m.caps[i] = -1
	}
	end := -1
	if m.match(r.root, start, func(e int) bool {
		if full && e != len(s) {
			return false
		}
		end = e
		return true
	}) {
		m.caps[0], m.caps[1] = start, end
		return m.caps, true
	}
	return nil, false
}

func (r *Regex) search(s string, from int) ([]int, bool) {
	for st := from; st <= len(s); st++ {
		if c, ok := r.matchAt(s, st, false); ok {
			return c, true
		}
	}
	return nil, false
}

func (r *Regex) findAll(s string) [][]int {
	var res [][]int
	pos := 0
	for pos <= len(s) {
		c, ok := r.search(s, pos)
		if !ok {
			break
		}
		res = append(res, c)
		if c[1] == c[0] {
			pos = c[1] + 1
		} else {
			pos = c[1]
		}
	}
	return res
}

func quote(s string) string {
	var b strings.Builder
	b.WriteByte('"')
	for i := 0; i < len(s); i++ {
		c := s[i]
		switch {
		case c == '\\':
			b.WriteString("\\\\")
		case c == '"':
			b.WriteString("\\\"")
		case c == '\n':
			b.WriteString("\\n")
		case c == '\t':
			b.WriteString("\\t")
		case c == '\r':
			b.WriteString("\\r")
		case c < 0x20 || c > 0x7e:
			fmt.Fprintf(&b, "\\x%02x", c)
		default:
			b.WriteByte(c)
		}
	}
	b.WriteByte('"')
	return b.String()
}

func unescape(s string) (string, bool) {
	var b strings.Builder
	for i := 0; i < len(s); i++ {
		if s[i] != '\\' {
			b.WriteByte(s[i])
			continue
		}
		i++
		if i >= len(s) {
			return "", false
		}
		switch s[i] {
		case 'n':
			b.WriteByte('\n')
		case 't':
			b.WriteByte('\t')
		case '\\':
			b.WriteByte('\\')
		case 'x':
			if i+2 < len(s)+0 && i+2 <= len(s)-1+0 && hexv(s[i+1]) >= 0 && hexv(s[i+2]) >= 0 {
				b.WriteByte(byte(hexv(s[i+1])*16 + hexv(s[i+2])))
				i += 2
			} else {
				return "", false
			}
		default:
			return "", false
		}
	}
	return b.String(), true
}

func capLine(r *Regex, s string, caps []int, g int) string {
	label := strconv.Itoa(g)
	if g > 0 && r.names[g-1] != "" {
		label += " (" + r.names[g-1] + ")"
	}
	if caps[2*g] < 0 {
		return label + ": unset"
	}
	return fmt.Sprintf("%s: %d..%d %s", label, caps[2*g], caps[2*g+1], quote(s[caps[2*g]:caps[2*g+1]]))
}

func expand(r *Regex, tmpl, s string, caps []int) string {
	var b strings.Builder
	for i := 0; i < len(tmpl); i++ {
		c := tmpl[i]
		if c != '$' || i+1 >= len(tmpl) {
			b.WriteByte(c)
			continue
		}
		n := tmpl[i+1]
		g := -1
		switch {
		case n == '$':
			b.WriteByte('$')
			i++
			continue
		case n >= '0' && n <= '9':
			g = int(n - '0')
			if g > r.ngroups {
				rfail("bad replacement")
			}
			i++
		case n == '{':
			j := strings.IndexByte(tmpl[i:], '}')
			if j < 0 {
				rfail("bad replacement")
			}
			name := tmpl[i+2 : i+j]
			for gi, nm := range r.names {
				if nm == name && nm != "" {
					g = gi + 1
				}
			}
			if g < 0 {
				rfail("bad replacement")
			}
			i += j
		default:
			b.WriteByte('$')
			continue
		}
		if caps[2*g] >= 0 {
			b.WriteString(s[caps[2*g]:caps[2*g+1]])
		}
	}
	return b.String()
}

func run(line string, out *strings.Builder) {
	f := strings.Split(line, "\t")
	cmd := f[0]
	need := map[string]int{"test": 3, "match": 3, "full": 3, "find-all": 3, "split": 3, "replace": 4}
	n, ok := need[cmd]
	if !ok || len(f) != n {
		out.WriteString("error: bad command\n")
		return
	}
	subj, ok := unescape(f[2])
	if !ok {
		out.WriteString("error: bad command\n")
		return
	}
	tmpl := ""
	if cmd == "replace" {
		tmpl, ok = unescape(f[3])
		if !ok {
			out.WriteString("error: bad command\n")
			return
		}
	}
	r := compile(f[1])
	switch cmd {
	case "test":
		_, found := r.search(subj, 0)
		fmt.Fprintf(out, "%v\n", found)
	case "match", "full":
		var caps []int
		var found bool
		if cmd == "match" {
			caps, found = r.search(subj, 0)
		} else {
			caps, found = r.matchAt(subj, 0, true)
		}
		if !found {
			out.WriteString("no match\n")
			return
		}
		for g := 0; g <= r.ngroups; g++ {
			out.WriteString(capLine(r, subj, caps, g) + "\n")
		}
	case "find-all":
		ms := r.findAll(subj)
		for _, c := range ms {
			fmt.Fprintf(out, "%d..%d %s\n", c[0], c[1], quote(subj[c[0]:c[1]]))
		}
		fmt.Fprintf(out, "(%d matches)\n", len(ms))
	case "replace":
		ms := r.findAll(subj)
		var b strings.Builder
		last := 0
		for _, c := range ms {
			b.WriteString(subj[last:c[0]])
			b.WriteString(expand(r, tmpl, subj, c))
			last = c[1]
		}
		b.WriteString(subj[last:])
		out.WriteString(quote(b.String()) + "\n")
	case "split":
		var pieces []string
		last := 0
		for _, c := range r.findAll(subj) {
			if c[1] == c[0] {
				continue
			}
			pieces = append(pieces, subj[last:c[0]])
			last = c[1]
		}
		pieces = append(pieces, subj[last:])
		for _, p := range pieces {
			out.WriteString(quote(p) + "\n")
		}
		fmt.Fprintf(out, "(%d pieces)\n", len(pieces))
	}
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	var out strings.Builder
	for sc.Scan() {
		line := strings.TrimSuffix(sc.Text(), "\r")
		if line == "" {
			continue
		}
		func() {
			defer func() {
				if r := recover(); r != nil {
					e, ok := r.(RErr)
					if !ok {
						panic(r)
					}
					out.WriteString("error: " + e.msg + "\n")
				}
			}()
			run(line, &out)
		}()
	}
	os.Stdout.WriteString(out.String())
}
