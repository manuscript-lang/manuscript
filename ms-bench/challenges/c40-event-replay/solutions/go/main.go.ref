package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strconv"
	"strings"
)

type item struct{ qty, price int }

type state struct {
	name  string
	items map[string]item
}

var argc = map[string]int{"created": 0, "item_added": 3, "item_removed": 1, "paid": 1, "shipped": 0, "cancelled": 0}

func isDigits(s string) bool {
	if s == "" {
		return false
	}
	for _, c := range s {
		if c < '0' || c > '9' {
			return false
		}
	}
	return true
}

func total(st *state) int {
	t := 0
	for _, it := range st.items {
		t += it.qty * it.price
	}
	return t
}

// apply runs one validated event on st and returns an error message ("" on success).
func apply(st *state, ev []string, ver int) string {
	typ, a, s := ev[0], ev[1:], st.name
	invalid := fmt.Sprintf("invalid %s in %s at v%d", typ, s, ver)
	switch typ {
	case "created":
		if s != "none" {
			return invalid
		}
		st.name = "open"
	case "item_added":
		if s != "open" {
			return invalid
		}
		q, _ := strconv.Atoi(a[1])
		p, _ := strconv.Atoi(a[2])
		old := st.items[a[0]]
		st.items[a[0]] = item{old.qty + q, p}
	case "item_removed":
		if s != "open" {
			return invalid
		}
		if _, ok := st.items[a[0]]; !ok {
			return fmt.Sprintf("no such item %s at v%d", a[0], ver)
		}
		delete(st.items, a[0])
	case "paid":
		if s != "open" {
			return invalid
		}
		if len(st.items) == 0 {
			return fmt.Sprintf("empty order at v%d", ver)
		}
		amount, _ := strconv.Atoi(a[0])
		if tot := total(st); amount != tot {
			return fmt.Sprintf("wrong amount expected=%d at v%d", tot, ver)
		}
		st.name = "paid"
	case "shipped":
		if s != "paid" {
			return invalid
		}
		st.name = "shipped"
	default:
		if s != "open" && s != "paid" {
			return invalid
		}
		st.name = "cancelled"
	}
	return ""
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	log := map[string][][]string{}
	replay := func(id string, n int) *state {
		st := &state{"none", map[string]item{}}
		for k, ev := range log[id][:n] {
			apply(st, ev, k+1)
		}
		return st
	}
	summary := func(id string, st *state, ver int) {
		fmt.Fprintf(out, "%s state=%s v=%d items=%d total=%d\n", id, st.name, ver, len(st.items), total(st))
		keys := make([]string, 0, len(st.items))
		for k := range st.items {
			keys = append(keys, k)
		}
		sort.Strings(keys)
		for _, k := range keys {
			fmt.Fprintf(out, "  %s x%d @%d\n", k, st.items[k].qty, st.items[k].price)
		}
	}
	for sc.Scan() {
		t := strings.FieldsFunc(sc.Text(), func(r rune) bool { return r == ' ' || r == '\t' })
		if len(t) == 0 {
			continue
		}
		if t[0] == "show" {
			if len(t) != 2 {
				fmt.Fprintln(out, "error: bad line")
			} else if evs, ok := log[t[1]]; !ok {
				fmt.Fprintf(out, "error: unknown aggregate %s\n", t[1])
			} else {
				summary(t[1], replay(t[1], len(evs)), len(evs))
			}
			continue
		}
		if t[0] == "at" {
			if len(t) != 3 {
				fmt.Fprintln(out, "error: bad line")
			} else if evs, ok := log[t[1]]; !ok {
				fmt.Fprintf(out, "error: unknown aggregate %s\n", t[1])
			} else if v, err := strconv.Atoi(t[2]); !isDigits(t[2]) || err != nil || v > len(evs) {
				fmt.Fprintln(out, "error: bad version")
			} else {
				summary(t[1], replay(t[1], v), v)
			}
			continue
		}
		if len(t) < 3 {
			fmt.Fprintln(out, "error: bad line")
			continue
		}
		id, ver, typ, a := t[0], t[1], t[2], t[3:]
		if !isDigits(ver) {
			fmt.Fprintln(out, "error: bad version")
			continue
		}
		cur := len(log[id])
		if v, err := strconv.Atoi(ver); err != nil || v != cur+1 {
			fmt.Fprintf(out, "%s: conflict v=%s expected=%d\n", id, ver, cur+1)
			continue
		}
		n, known := argc[typ]
		if !known {
			fmt.Fprintf(out, "%s: unknown event %s\n", id, typ)
			continue
		}
		bad := len(a) != n
		if !bad && typ == "item_added" {
			q, _ := strconv.Atoi(a[1])
			bad = !isDigits(a[1]) || !isDigits(a[2]) || q == 0
		}
		if !bad && typ == "paid" {
			bad = !isDigits(a[0])
		}
		if bad {
			fmt.Fprintf(out, "%s: bad arguments for %s\n", id, typ)
			continue
		}
		st := replay(id, cur)
		ev := append([]string{typ}, a...)
		if msg := apply(st, ev, cur+1); msg != "" {
			fmt.Fprintf(out, "%s: %s\n", id, msg)
			continue
		}
		log[id] = append(log[id], ev)
		fmt.Fprintf(out, "%s: %s -> %s v=%d\n", id, typ, st.name, cur+1)
	}
}
