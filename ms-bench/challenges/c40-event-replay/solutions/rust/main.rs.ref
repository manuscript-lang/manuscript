use std::collections::{BTreeMap, HashMap};
use std::io::{Read, Write};

struct State {
    name: &'static str,
    items: BTreeMap<String, (i64, i64)>,
}

fn is_digits(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|c| c.is_ascii_digit())
}

fn total(st: &State) -> i64 {
    st.items.values().map(|(q, p)| q * p).sum()
}

// Runs one validated event on `st`; returns an error message on failure.
fn apply(st: &mut State, ev: &[String], ver: usize) -> Option<String> {
    let typ = ev[0].as_str();
    let a = &ev[1..];
    let s = st.name;
    let invalid = format!("invalid {} in {} at v{}", typ, s, ver);
    match typ {
        "created" => {
            if s != "none" {
                return Some(invalid);
            }
            st.name = "open";
        }
        "item_added" => {
            if s != "open" {
                return Some(invalid);
            }
            let q: i64 = a[1].parse().unwrap();
            let p: i64 = a[2].parse().unwrap();
            let e = st.items.entry(a[0].clone()).or_insert((0, 0));
            *e = (e.0 + q, p);
        }
        "item_removed" => {
            if s != "open" {
                return Some(invalid);
            }
            if st.items.remove(&a[0]).is_none() {
                return Some(format!("no such item {} at v{}", a[0], ver));
            }
        }
        "paid" => {
            if s != "open" {
                return Some(invalid);
            }
            if st.items.is_empty() {
                return Some(format!("empty order at v{}", ver));
            }
            let tot = total(st);
            if a[0].parse::<i64>().unwrap() != tot {
                return Some(format!("wrong amount expected={} at v{}", tot, ver));
            }
            st.name = "paid";
        }
        "shipped" => {
            if s != "paid" {
                return Some(invalid);
            }
            st.name = "shipped";
        }
        _ => {
            if s != "open" && s != "paid" {
                return Some(invalid);
            }
            st.name = "cancelled";
        }
    }
    None
}

fn replay(log: &HashMap<String, Vec<Vec<String>>>, id: &str, n: usize) -> State {
    let mut st = State { name: "none", items: BTreeMap::new() };
    if let Some(evs) = log.get(id) {
        for (k, ev) in evs.iter().take(n).enumerate() {
            apply(&mut st, ev, k + 1);
        }
    }
    st
}

fn summary(out: &mut String, id: &str, st: &State, ver: usize) {
    out.push_str(&format!("{} state={} v={} items={} total={}\n", id, st.name, ver, st.items.len(), total(st)));
    for (k, (q, p)) in &st.items {
        out.push_str(&format!("  {} x{} @{}\n", k, q, p));
    }
}

fn main() {
    let mut input = String::new();
    std::io::stdin().read_to_string(&mut input).unwrap();
    let mut out = String::new();
    let mut log: HashMap<String, Vec<Vec<String>>> = HashMap::new();
    for line in input.split('\n') {
        let t: Vec<&str> = line.split(|c| c == ' ' || c == '\t').filter(|x| !x.is_empty()).collect();
        if t.is_empty() {
            continue;
        }
        if t[0] == "show" {
            if t.len() != 2 {
                out.push_str("error: bad line\n");
            } else if let Some(evs) = log.get(t[1]) {
                let n = evs.len();
                let st = replay(&log, t[1], n);
                summary(&mut out, t[1], &st, n);
            } else {
                out.push_str(&format!("error: unknown aggregate {}\n", t[1]));
            }
            continue;
        }
        if t[0] == "at" {
            if t.len() != 3 {
                out.push_str("error: bad line\n");
            } else if let Some(evs) = log.get(t[1]) {
                match t[2].parse::<usize>() {
                    Ok(v) if is_digits(t[2]) && v <= evs.len() => {
                        let st = replay(&log, t[1], v);
                        summary(&mut out, t[1], &st, v);
                    }
                    _ => out.push_str("error: bad version\n"),
                }
            } else {
                out.push_str(&format!("error: unknown aggregate {}\n", t[1]));
            }
            continue;
        }
        if t.len() < 3 {
            out.push_str("error: bad line\n");
            continue;
        }
        let (id, ver, typ, a) = (t[0], t[1], t[2], &t[3..]);
        if !is_digits(ver) {
            out.push_str("error: bad version\n");
            continue;
        }
        let cur = log.get(id).map_or(0, |v| v.len());
        if ver.parse::<usize>().ok() != Some(cur + 1) {
            out.push_str(&format!("{}: conflict v={} expected={}\n", id, ver, cur + 1));
            continue;
        }
        let n = match typ {
            "created" | "shipped" | "cancelled" => 0,
            "item_added" => 3,
            "item_removed" | "paid" => 1,
            _ => {
                out.push_str(&format!("{}: unknown event {}\n", id, typ));
                continue;
            }
        };
        let mut bad = a.len() != n;
        if !bad && typ == "item_added" {
            bad = !is_digits(a[1]) || !is_digits(a[2]) || a[1].parse::<i64>().unwrap_or(0) == 0;
        }
        if !bad && typ == "paid" {
            bad = !is_digits(a[0]);
        }
        if bad {
            out.push_str(&format!("{}: bad arguments for {}\n", id, typ));
            continue;
        }
        let mut st = replay(&log, id, cur);
        let mut ev = vec![typ.to_string()];
        ev.extend(a.iter().map(|s| s.to_string()));
        if let Some(msg) = apply(&mut st, &ev, cur + 1) {
            out.push_str(&format!("{}: {}\n", id, msg));
            continue;
        }
        log.entry(id.to_string()).or_default().push(ev);
        out.push_str(&format!("{}: {} -> {} v={}\n", id, typ, st.name, cur + 1));
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
