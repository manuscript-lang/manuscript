import { readFileSync } from "node:fs";

type Event = string[];
type State = { state: string; items: Map<string, [number, number]> };

const digits = (s: string) => /^[0-9]+$/.test(s);
const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
const argc: Record<string, number> = { created: 0, item_added: 3, item_removed: 1, paid: 1, shipped: 0, cancelled: 0 };
const log = new Map<string, Event[]>();
const out: string[] = [];

const total = (st: State) => [...st.items.values()].reduce((s, [q, p]) => s + q * p, 0);

// Applies one event to st; returns an error message or null. Arguments are already validated.
function apply(st: State, ev: Event, ver: number): string | null {
  const [typ, ...a] = ev;
  const s = st.state;
  const invalid = `invalid ${typ} in ${s} at v${ver}`;
  switch (typ) {
    case "created":
      if (s !== "none") return invalid;
      st.state = "open";
      return null;
    case "item_added": {
      if (s !== "open") return invalid;
      const old = st.items.get(a[0]) ?? [0, 0];
      st.items.set(a[0], [old[0] + parseInt(a[1], 10), parseInt(a[2], 10)]);
      return null;
    }
    case "item_removed":
      if (s !== "open") return invalid;
      if (!st.items.has(a[0])) return `no such item ${a[0]} at v${ver}`;
      st.items.delete(a[0]);
      return null;
    case "paid": {
      if (s !== "open") return invalid;
      if (st.items.size === 0) return `empty order at v${ver}`;
      const tot = total(st);
      if (parseInt(a[0], 10) !== tot) return `wrong amount expected=${tot} at v${ver}`;
      st.state = "paid";
      return null;
    }
    case "shipped":
      if (s !== "paid") return invalid;
      st.state = "shipped";
      return null;
    default:
      if (s !== "open" && s !== "paid") return invalid;
      st.state = "cancelled";
      return null;
  }
}

function replay(id: string, n: number): State {
  const st: State = { state: "none", items: new Map() };
  (log.get(id) ?? []).slice(0, n).forEach((ev, k) => apply(st, ev, k + 1));
  return st;
}

function summary(id: string, st: State, ver: number) {
  out.push(`${id} state=${st.state} v=${ver} items=${st.items.size} total=${total(st)}`);
  for (const k of [...st.items.keys()].sort(cmp)) {
    const [q, p] = st.items.get(k)!;
    out.push(`  ${k} x${q} @${p}`);
  }
}

for (const line of readFileSync(0, "utf8").split("\n")) {
  const t = line.split(/[ \t]+/).filter((x) => x !== "");
  if (t.length === 0) continue;
  if (t[0] === "show") {
    if (t.length !== 2) out.push("error: bad line");
    else if (!log.has(t[1])) out.push(`error: unknown aggregate ${t[1]}`);
    else summary(t[1], replay(t[1], log.get(t[1])!.length), log.get(t[1])!.length);
    continue;
  }
  if (t[0] === "at") {
    if (t.length !== 3) out.push("error: bad line");
    else if (!log.has(t[1])) out.push(`error: unknown aggregate ${t[1]}`);
    else if (!digits(t[2]) || BigInt(t[2]) > BigInt(log.get(t[1])!.length)) out.push("error: bad version");
    else summary(t[1], replay(t[1], parseInt(t[2], 10)), parseInt(t[2], 10));
    continue;
  }
  if (t.length < 3) {
    out.push("error: bad line");
    continue;
  }
  const [id, ver, typ, ...a] = t;
  if (!digits(ver)) {
    out.push("error: bad version");
    continue;
  }
  const cur = log.get(id)?.length ?? 0;
  if (BigInt(ver) !== BigInt(cur + 1)) {
    out.push(`${id}: conflict v=${ver} expected=${cur + 1}`);
    continue;
  }
  if (!(typ in argc)) {
    out.push(`${id}: unknown event ${typ}`);
    continue;
  }
  const badArgs =
    a.length !== argc[typ] ||
    (typ === "item_added" && (!digits(a[1]) || !digits(a[2]) || parseInt(a[1], 10) === 0)) ||
    (typ === "paid" && !digits(a[0]));
  if (badArgs) {
    out.push(`${id}: bad arguments for ${typ}`);
    continue;
  }
  const st = replay(id, cur);
  const err = apply(st, [typ, ...a], cur + 1);
  if (err) {
    out.push(`${id}: ${err}`);
    continue;
  }
  if (!log.has(id)) log.set(id, []);
  log.get(id)!.push([typ, ...a]);
  out.push(`${id}: ${typ} -> ${st.state} v=${cur + 1}`);
}
process.stdout.write(out.map((l) => l + "\n").join(""));
