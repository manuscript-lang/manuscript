use std::io::{BufRead, Write};

const BAD: &str = "error: bad command";

fn parse_num(s: &str) -> Option<usize> {
    if s.is_empty() || s.len() > 6 || !s.bytes().all(|b| b.is_ascii_digit()) {
        return None;
    }
    s.parse().ok()
}

fn lcs(a: &[u8], b: &[u8]) -> usize {
    let mut prev = vec![0usize; b.len() + 1];
    for &x in a {
        let mut cur = vec![0usize; b.len() + 1];
        for j in 0..b.len() {
            cur[j + 1] = if x == b[j] { prev[j] + 1 } else { prev[j + 1].max(cur[j]) };
        }
        prev = cur;
    }
    prev[b.len()]
}

fn edit(a: &[u8], b: &[u8]) -> usize {
    let mut prev: Vec<usize> = (0..=b.len()).collect();
    for i in 1..=a.len() {
        let mut cur = vec![0usize; b.len() + 1];
        cur[0] = i;
        for j in 1..=b.len() {
            let sub = if a[i - 1] == b[j - 1] { 0 } else { 1 };
            cur[j] = (prev[j] + 1).min(cur[j - 1] + 1).min(prev[j - 1] + sub);
        }
        prev = cur;
    }
    prev[b.len()]
}

fn solve_line(line: &str) -> String {
    let t: Vec<&str> = line.split(' ').collect();
    match t[0] {
        "lcs" | "edit" => {
            if t.len() != 3 || t[1].is_empty() || t[2].is_empty() {
                return BAD.into();
            }
            let (a, b) = (t[1].as_bytes(), t[2].as_bytes());
            if t[0] == "lcs" { lcs(a, b).to_string() } else { edit(a, b).to_string() }
        }
        "knap" => {
            if t.len() < 2 {
                return BAD.into();
            }
            let capacity = match parse_num(t[1]) {
                Some(c) => c,
                None => return BAD.into(),
            };
            let mut best = vec![0usize; capacity + 1];
            for tok in &t[2..] {
                let p: Vec<&str> = tok.split(':').collect();
                if p.len() != 2 {
                    return BAD.into();
                }
                let (w, v) = match (parse_num(p[0]), parse_num(p[1])) {
                    (Some(w), Some(v)) if w >= 1 => (w, v),
                    _ => return BAD.into(),
                };
                for c in (w..=capacity).rev() {
                    best[c] = best[c].max(best[c - w] + v);
                }
            }
            best[capacity].to_string()
        }
        "coins" => {
            if t.len() < 3 {
                return BAD.into();
            }
            let amount = match parse_num(t[1]) {
                Some(a) => a,
                None => return BAD.into(),
            };
            let mut cs = Vec::new();
            for tok in &t[2..] {
                match parse_num(tok) {
                    Some(c) if c >= 1 => cs.push(c),
                    _ => return BAD.into(),
                }
            }
            const INF: usize = 1_000_000_000;
            let mut best = vec![INF; amount + 1];
            best[0] = 0;
            for a in 1..=amount {
                for &c in &cs {
                    if c <= a && best[a - c] + 1 < best[a] {
                        best[a] = best[a - c] + 1;
                    }
                }
            }
            if best[amount] >= INF { "impossible".into() } else { best[amount].to_string() }
        }
        _ => BAD.into(),
    }
}

fn main() {
    let stdin = std::io::stdin();
    let mut out = String::new();
    for line in stdin.lock().lines() {
        let line = line.unwrap();
        if line.trim_matches(' ').is_empty() {
            continue;
        }
        out.push_str(&solve_line(&line));
        out.push('\n');
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
