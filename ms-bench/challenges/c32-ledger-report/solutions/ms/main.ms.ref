import {stdin, stdout, read_all} from "@std/io.ms"
import Set from "@std/collections.ms"

# --- text helpers (ASCII data) -------------------------------------------------

fn trim_blanks(s: String) -> String:
    let codes = s.scalar_values()
    var start = 0
    var end = codes.length()
    while start < end and (codes.at(start).unwrap() == 32 or codes.at(start).unwrap() == 9):
        start = start + 1
    while end > start and (codes.at(end - 1).unwrap() == 32 or codes.at(end - 1).unwrap() == 9):
        end = end - 1
    return s.slice(start, end)

fn all_digits(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn pad_left(s: String, width: Int, fill: String) -> String:
    return s.pad_start(width, fill).unwrap()

# --- CSV record splitting -------------------------------------------------------

fn split_fields(line: String) -> List[String]:
    let chars = line.chars()
    let n = chars.length()
    let fields = List[String]()
    var i = 0
    while true:
        if i < n and chars.at(i).unwrap() == "\"":
            i = i + 1
            let buf = List[String]()
            while i < n:
                let c = chars.at(i).unwrap()
                if c == "\"":
                    if i + 1 < n and chars.at(i + 1).unwrap() == "\"":
                        buf.append("\"")
                        i = i + 2
                        continue
                    i = i + 1
                    break
                buf.append(c)
                i = i + 1
            fields.append(buf.join(""))
        else:
            var j = i
            while j < n and chars.at(j).unwrap() != ",":
                j = j + 1
            fields.append(chars.slice(i, j).join(""))
            i = j
        if i < n and chars.at(i).unwrap() == ",":
            i = i + 1
            if i == n:
                fields.append("")
                break
            continue
        break
    let trimmed = List[String]()
    for f in fields:
        trimmed.append(trim_blanks(f))
    return trimmed

# --- dates -------------------------------------------------------------------

fn is_leap(y: Int) -> Bool:
    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)

fn days_in_month(y: Int, m: Int) -> Int:
    if m == 2:
        if is_leap(y):
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31

# Returns the normalised YYYY-MM-DD date or none.
fn parse_date(s: String) -> Optional[String]:
    if s.length() != 10:
        return none
    var y = 0
    var m = 0
    var d = 0
    if s.slice(4, 5) == "-" and s.slice(7, 8) == "-" and all_digits(s.slice(0, 4)) and all_digits(s.slice(5, 7)) and all_digits(s.slice(8, 10)):
        y = s.slice(0, 4).parse_int().unwrap()
        m = s.slice(5, 7).parse_int().unwrap()
        d = s.slice(8, 10).parse_int().unwrap()
    else if s.slice(2, 3) == "/" and s.slice(5, 6) == "/" and all_digits(s.slice(0, 2)) and all_digits(s.slice(3, 5)) and all_digits(s.slice(6, 10)):
        m = s.slice(0, 2).parse_int().unwrap()
        d = s.slice(3, 5).parse_int().unwrap()
        y = s.slice(6, 10).parse_int().unwrap()
    else:
        return none
    if m < 1 or m > 12:
        return none
    if d < 1 or d > days_in_month(y, m):
        return none
    return some("{pad_left("{y}", 4, "0")}-{pad_left("{m}", 2, "0")}-{pad_left("{d}", 2, "0")}")

# --- money -------------------------------------------------------------------

# Parses the amount grammar into signed cents, or none.
fn parse_amount(input: String) -> Optional[Int]:
    var s = input
    var neg = false
    if s.length() >= 2 and s.starts_with("(") and s.ends_with(")"):
        neg = true
        s = s.slice(1, s.length() - 1)
        if s.starts_with("-"):
            return none
    else if s.starts_with("-"):
        neg = true
        s = s.slice(1, s.length())
    if s.starts_with("$"):
        s = s.slice(1, s.length())
    var whole = s
    var frac = ""
    let dot = s.index_of(".")
    if dot.is_some():
        whole = s.slice(0, dot.unwrap())
        frac = s.slice(dot.unwrap() + 1, s.length())
        if frac.length() < 1 or frac.length() > 2 or not all_digits(frac):
            return none
    if whole.contains(","):
        let groups = whole.split(",")
        var k = 0
        for g in groups:
            if not all_digits(g):
                return none
            if k == 0 and g.length() > 3:
                return none
            if k > 0 and g.length() != 3:
                return none
            k = k + 1
        whole = groups.join("")
    else if not all_digits(whole):
        return none
    if whole.length() + frac.length() > 12:
        return none
    if frac.length() == 1:
        frac = "{frac}0"
    var cents = whole.parse_int().unwrap() * 100
    if frac.length() == 2:
        cents = cents + frac.parse_int().unwrap()
    if neg:
        return some(0 - cents)
    return some(cents)

fn money(cents: Int) -> String:
    var sign = ""
    var a = cents
    if cents < 0:
        sign = "-"
        a = 0 - cents
    let digits = "{a / 100}".chars()
    let out = List[String]()
    var i = 0
    while i < digits.length():
        if i > 0 and (digits.length() - i) % 3 == 0:
            out.append(",")
        out.append(digits.at(i).unwrap())
        i = i + 1
    return "{sign}{out.join("")}.{pad_left("{a % 100}", 2, "0")}"

fn abs_value(v: Int) -> Int:
    if v < 0:
        return 0 - v
    return v

# --- report ---------------------------------------------------------------------

type Tx:
    date: String
    account: String
    desc: String
    amount: Int

type Acc:
    balance: Int
    credits: Int
    debits: Int
    count: Int

fn by_text(left: String, right: String) -> Int:
    return left.compare(right)

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let lines = data.to_text().unwrap_or("").split("\n")
    if lines.length() > 0 and lines.at(lines.length() - 1).unwrap().is_empty():
        lines.remove(lines.length() - 1)
    var saw_header = false
    let seen = Set[String]()
    let txs = List[Tx]()
    let errs = List[String]()
    var dups = 0
    var idx = 0
    while idx < lines.length():
        let line = lines.at(idx).unwrap()
        idx = idx + 1
        let t = trim_blanks(line)
        if t.is_empty() or t.starts_with("#"):
            continue
        if not saw_header:
            saw_header = true
            continue
        let f = split_fields(line)
        if f.length() != 4:
            errs.append("line {idx}: field count")
            continue
        let date = parse_date(f.at(0).unwrap())
        if date.is_none():
            errs.append("line {idx}: bad date")
            continue
        let account = f.at(1).unwrap()
        if account.is_empty():
            errs.append("line {idx}: bad account")
            continue
        let amount = parse_amount(f.at(3).unwrap())
        if amount.is_none():
            errs.append("line {idx}: bad amount")
            continue
        let desc = f.at(2).unwrap()
        let key = "{date.unwrap()}|{amount.unwrap()}|{account.length()}|{account}|{desc}"
        if seen.contains(key):
            dups = dups + 1
            continue
        seen.add(key)
        txs.append(Tx(date: date.unwrap(), account: account, desc: desc, amount: amount.unwrap()))
    let accounts = Map[String, Acc]()
    let months = Map[String, Int]()
    for t in txs:
        if not accounts.contains(t.account):
            accounts.add(key: t.account, value: Acc(balance: 0, credits: 0, debits: 0, count: 0))
        let a = accounts.get(t.account).unwrap()
        a.balance = a.balance + t.amount
        a.count = a.count + 1
        if t.amount > 0:
            a.credits = a.credits + t.amount
        if t.amount < 0:
            a.debits = a.debits - t.amount
        let month = t.date.slice(0, 7)
        months.add(key: month, value: months.get_or(key: month, fallback: 0) + t.amount)
    let out = List[String]()
    out.append("transactions: {txs.length()}")
    out.append("duplicates: {dups}")
    out.append("errors: {errs.length()}")
    out.append("accounts:")
    for name in accounts.keys().sorted(compare: by_text):
        let a = accounts.get(name).unwrap()
        out.append("  {name} balance={money(a.balance)} credits={money(a.credits)} debits={money(a.debits)} count={a.count}")
    out.append("months:")
    for m in months.keys().sorted(compare: by_text):
        out.append("  {m} net={money(months.get(m).unwrap())}")
    if txs.length() > 0:
        var best = txs.at(0).unwrap()
        for t in txs:
            if abs_value(t.amount) > abs_value(best.amount):
                best = t
        out.append("largest: {best.date} | {best.account} | {best.desc} | {money(best.amount)}")
    if errs.length() > 0:
        out.append("errors:")
        for e in errs:
            out.append("  {e}")
    try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
