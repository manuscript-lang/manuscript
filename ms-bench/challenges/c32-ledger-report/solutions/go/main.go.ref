package main

import (
	"bufio"
	"fmt"
	"io"
	"os"
	"sort"
	"strconv"
	"strings"
)

func trimBlanks(s string) string { return strings.Trim(s, " \t") }

func splitFields(line string) []string {
	var fields []string
	i, n := 0, len(line)
	for {
		if i < n && line[i] == '"' {
			i++
			var buf []byte
			for i < n {
				if line[i] == '"' {
					if i+1 < n && line[i+1] == '"' {
						buf = append(buf, '"')
						i += 2
						continue
					}
					i++
					break
				}
				buf = append(buf, line[i])
				i++
			}
			fields = append(fields, string(buf))
		} else {
			j := strings.IndexByte(line[i:], ',')
			if j < 0 {
				j = n
			} else {
				j += i
			}
			fields = append(fields, line[i:j])
			i = j
		}
		if i < n && line[i] == ',' {
			i++
			if i == n {
				fields = append(fields, "")
				break
			}
			continue
		}
		break
	}
	for k := range fields {
		fields[k] = trimBlanks(fields[k])
	}
	return fields
}

func allDigits(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

func atoi(s string) int { v, _ := strconv.Atoi(s); return v }

func isLeap(y int) bool { return y%4 == 0 && (y%100 != 0 || y%400 == 0) }

func parseDate(s string) (string, bool) {
	var y, m, d int
	switch {
	case len(s) == 10 && s[4] == '-' && s[7] == '-' && allDigits(s[:4]) && allDigits(s[5:7]) && allDigits(s[8:]):
		y, m, d = atoi(s[:4]), atoi(s[5:7]), atoi(s[8:])
	case len(s) == 10 && s[2] == '/' && s[5] == '/' && allDigits(s[:2]) && allDigits(s[3:5]) && allDigits(s[6:]):
		m, d, y = atoi(s[:2]), atoi(s[3:5]), atoi(s[6:])
	default:
		return "", false
	}
	if m < 1 || m > 12 {
		return "", false
	}
	dim := []int{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}[m-1]
	if m == 2 && isLeap(y) {
		dim = 29
	}
	if d < 1 || d > dim {
		return "", false
	}
	return fmt.Sprintf("%04d-%02d-%02d", y, m, d), true
}

func parseAmount(s string) (int64, bool) {
	neg := false
	if len(s) >= 2 && s[0] == '(' && s[len(s)-1] == ')' {
		neg = true
		s = s[1 : len(s)-1]
		if strings.HasPrefix(s, "-") {
			return 0, false
		}
	} else if strings.HasPrefix(s, "-") {
		neg = true
		s = s[1:]
	}
	s = strings.TrimPrefix(s, "$")
	whole, frac, hasDot := strings.Cut(s, ".")
	if hasDot && (len(frac) < 1 || len(frac) > 2 || !allDigits(frac)) {
		return 0, false
	}
	if strings.Contains(whole, ",") {
		groups := strings.Split(whole, ",")
		if len(groups[0]) < 1 || len(groups[0]) > 3 {
			return 0, false
		}
		for k, g := range groups {
			if !allDigits(g) || (k > 0 && len(g) != 3) {
				return 0, false
			}
		}
		whole = strings.Join(groups, "")
	} else if !allDigits(whole) {
		return 0, false
	}
	if len(whole)+len(frac) > 12 {
		return 0, false
	}
	for len(frac) < 2 {
		frac += "0"
	}
	w, _ := strconv.ParseInt(whole, 10, 64)
	f, _ := strconv.ParseInt(frac, 10, 64)
	c := w*100 + f
	if neg {
		c = -c
	}
	return c, true
}

func money(c int64) string {
	sign := ""
	if c < 0 {
		sign = "-"
		c = -c
	}
	whole := strconv.FormatInt(c/100, 10)
	var parts []string
	for len(whole) > 3 {
		parts = append([]string{whole[len(whole)-3:]}, parts...)
		whole = whole[:len(whole)-3]
	}
	parts = append([]string{whole}, parts...)
	return fmt.Sprintf("%s%s.%02d", sign, strings.Join(parts, ","), c%100)
}

type tx struct {
	date, account, desc string
	amount              int64
}

type acc struct {
	balance, credits, debits int64
	count                    int
}

func main() {
	data, _ := io.ReadAll(os.Stdin)
	lines := strings.Split(string(data), "\n")
	if lines[len(lines)-1] == "" {
		lines = lines[:len(lines)-1]
	}
	sawHeader := false
	seen := map[string]bool{}
	var txs []tx
	var errs []string
	dups := 0
	for idx, line := range lines {
		t := trimBlanks(line)
		if t == "" || t[0] == '#' {
			continue
		}
		if !sawHeader {
			sawHeader = true
			continue
		}
		n := idx + 1
		f := splitFields(line)
		if len(f) != 4 {
			errs = append(errs, fmt.Sprintf("line %d: field count", n))
			continue
		}
		date, ok := parseDate(f[0])
		if !ok {
			errs = append(errs, fmt.Sprintf("line %d: bad date", n))
			continue
		}
		if f[1] == "" {
			errs = append(errs, fmt.Sprintf("line %d: bad account", n))
			continue
		}
		amount, ok := parseAmount(f[3])
		if !ok {
			errs = append(errs, fmt.Sprintf("line %d: bad amount", n))
			continue
		}
		key := fmt.Sprintf("%q|%q|%q|%d", date, f[1], f[2], amount)
		if seen[key] {
			dups++
			continue
		}
		seen[key] = true
		txs = append(txs, tx{date, f[1], f[2], amount})
	}
	accounts := map[string]*acc{}
	months := map[string]int64{}
	for _, t := range txs {
		a := accounts[t.account]
		if a == nil {
			a = &acc{}
			accounts[t.account] = a
		}
		a.balance += t.amount
		a.count++
		if t.amount > 0 {
			a.credits += t.amount
		}
		if t.amount < 0 {
			a.debits -= t.amount
		}
		months[t.date[:7]] += t.amount
	}
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	fmt.Fprintf(out, "transactions: %d\nduplicates: %d\nerrors: %d\naccounts:\n", len(txs), dups, len(errs))
	names := make([]string, 0, len(accounts))
	for k := range accounts {
		names = append(names, k)
	}
	sort.Strings(names)
	for _, k := range names {
		a := accounts[k]
		fmt.Fprintf(out, "  %s balance=%s credits=%s debits=%s count=%d\n", k, money(a.balance), money(a.credits), money(a.debits), a.count)
	}
	fmt.Fprintln(out, "months:")
	keys := make([]string, 0, len(months))
	for k := range months {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	for _, k := range keys {
		fmt.Fprintf(out, "  %s net=%s\n", k, money(months[k]))
	}
	abs := func(v int64) int64 {
		if v < 0 {
			return -v
		}
		return v
	}
	if len(txs) > 0 {
		best := txs[0]
		for _, t := range txs {
			if abs(t.amount) > abs(best.amount) {
				best = t
			}
		}
		fmt.Fprintf(out, "largest: %s | %s | %s | %s\n", best.date, best.account, best.desc, money(best.amount))
	}
	if len(errs) > 0 {
		fmt.Fprintln(out, "errors:")
		for _, e := range errs {
			fmt.Fprintln(out, "  "+e)
		}
	}
}
