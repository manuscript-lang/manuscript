use std::collections::{BTreeMap, BTreeSet};
use std::io::{BufRead, Write};

const MONTHS: [&str; 12] = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const METHODS: [&str; 7] = ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"];
const PROTOS: [&str; 3] = ["HTTP/1.0", "HTTP/1.1", "HTTP/2.0"];

struct Rec {
    ip: String,
    hour: String,
    route: String,
    status: u32,
    bytes: u64,
    ms: u64,
}

// Parses s when it is lo..=hi ASCII digits.
fn digits(s: &str, lo: usize, hi: usize) -> Option<u64> {
    if s.len() < lo || s.len() > hi || !s.bytes().all(|b| b.is_ascii_digit()) {
        return None;
    }
    s.parse().ok()
}

fn parse(line: &str) -> Option<Rec> {
    let parts: Vec<&str> = line.split('"').collect();
    if parts.len() != 3 {
        return None;
    }
    let (before, req, after) = (parts[0], parts[1], parts[2]);
    let before = before.strip_suffix(' ')?;
    let after = after.strip_prefix(' ')?;
    let b: Vec<&str> = before.split(' ').collect();
    if b.len() != 5 {
        return None;
    }
    let ip_parts: Vec<&str> = b[0].split('.').collect();
    if ip_parts.len() != 4 || !ip_parts.iter().all(|p| digits(p, 1, 3).map_or(false, |v| v <= 255)) {
        return None;
    }
    if b[1..3].iter().any(|t| t.is_empty() || t.contains('[')) {
        return None;
    }
    let ts = b[3].strip_prefix('[')?;
    let zone = b[4].strip_suffix(']')?;
    let tb = ts.as_bytes();
    if !ts.is_ascii() || tb.len() != 20 || tb[2] != b'/' || tb[6] != b'/' || tb[11] != b':' || tb[14] != b':' || tb[17] != b':' {
        return None;
    }
    let dd = digits(&ts[0..2], 2, 2)?;
    digits(&ts[7..11], 4, 4)?;
    let hh = digits(&ts[12..14], 2, 2)?;
    let mm = digits(&ts[15..17], 2, 2)?;
    let ss = digits(&ts[18..20], 2, 2)?;
    if dd < 1 || dd > 31 || hh > 23 || mm > 59 || ss > 59 || !MONTHS.contains(&&ts[3..6]) {
        return None;
    }
    let zb = zone.as_bytes();
    if zb.len() != 5 || (zb[0] != b'+' && zb[0] != b'-') || digits(&zone[1..], 4, 4).is_none() {
        return None;
    }
    let q: Vec<&str> = req.split(' ').collect();
    if q.len() != 3 || !METHODS.contains(&q[0]) || !q[1].starts_with('/') || !PROTOS.contains(&q[2]) {
        return None;
    }
    let a: Vec<&str> = after.split(' ').collect();
    if a.len() != 3 {
        return None;
    }
    let status = digits(a[0], 3, 3)?;
    if !(100..=599).contains(&status) {
        return None;
    }
    let bytes = if a[1] == "-" { 0 } else { digits(a[1], 1, 10)? };
    let (secs, frac) = a[2].split_once('.')?;
    let ms = digits(secs, 1, 4)? * 1000 + digits(frac, 3, 3)?;
    let mut target = q[1];
    if let Some(i) = target.find(|c| c == '?' || c == '#') {
        target = &target[..i];
    }
    let segs: Vec<&str> = target
        .split('/')
        .map(|s| if !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit()) { ":id" } else { s })
        .collect();
    Some(Rec {
        ip: b[0].to_string(),
        hour: ts[12..14].to_string(),
        route: format!("{} {}", q[0], segs.join("/")),
        status: status as u32,
        bytes,
        ms,
    })
}

fn main() {
    let stdin = std::io::stdin();
    let mut recs = Vec::new();
    let mut bad = 0;
    for line in stdin.lock().lines() {
        let l = line.unwrap();
        if l.trim_matches(' ').is_empty() {
            continue;
        }
        match parse(&l) {
            Some(r) => recs.push(r),
            None => bad += 1,
        }
    }
    let mut out = String::new();
    let total: u64 = recs.iter().map(|r| r.bytes).sum();
    let ips: BTreeSet<&String> = recs.iter().map(|r| &r.ip).collect();
    out.push_str(&format!("requests={} malformed={} bytes={} ips={}\n", recs.len(), bad, total, ips.len()));
    let mut cls = [0; 6];
    let mut hours: BTreeMap<&str, usize> = BTreeMap::new();
    let mut routes: BTreeMap<&str, Vec<&Rec>> = BTreeMap::new();
    for r in &recs {
        cls[(r.status / 100) as usize] += 1;
        *hours.entry(&r.hour).or_default() += 1;
        routes.entry(&r.route).or_default().push(r);
    }
    out.push_str(&format!("status 1xx={} 2xx={} 3xx={} 4xx={} 5xx={}\n", cls[1], cls[2], cls[3], cls[4], cls[5]));
    if hours.is_empty() {
        out.push_str("hours none\n");
    } else {
        let items: Vec<String> = hours.iter().map(|(h, n)| format!("{}={}", h, n)).collect();
        out.push_str(&format!("hours {}\n", items.join(" ")));
    }
    if routes.is_empty() {
        out.push_str("endpoints none\n");
    }
    let mut ordered: Vec<(&&str, &Vec<&Rec>)> = routes.iter().collect();
    ordered.sort_by(|a, b| b.1.len().cmp(&a.1.len()).then(a.0.cmp(b.0)));
    for (name, rs) in ordered.into_iter().take(5) {
        let mut ts: Vec<u64> = rs.iter().map(|r| r.ms).collect();
        ts.sort();
        let n = ts.len() as u64;
        let sum: u64 = ts.iter().sum();
        let avg = (2 * sum + n) / (2 * n);
        let p95 = ts[((95 * n + 99) / 100 - 1) as usize];
        let errs = rs.iter().filter(|r| r.status >= 400).count();
        out.push_str(&format!("endpoint {} {} avg={}ms p95={}ms errors={}\n", n, name, avg, p95, errs));
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
