package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strings"
)

var months = map[string]bool{"Jan": true, "Feb": true, "Mar": true, "Apr": true, "May": true, "Jun": true,
	"Jul": true, "Aug": true, "Sep": true, "Oct": true, "Nov": true, "Dec": true}
var methods = map[string]bool{"GET": true, "POST": true, "PUT": true, "DELETE": true, "PATCH": true, "HEAD": true, "OPTIONS": true}
var protos = map[string]bool{"HTTP/1.0": true, "HTTP/1.1": true, "HTTP/2.0": true}

type rec struct {
	ip, hour, route string
	status, bytes   int
	ms              int
}

// digits parses s when it is lo..hi ASCII digits.
func digits(s string, lo, hi int) (int, bool) {
	if len(s) < lo || len(s) > hi {
		return 0, false
	}
	n := 0
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return 0, false
		}
		n = n*10 + int(s[i]-'0')
	}
	return n, true
}

func parse(line string) (rec, bool) {
	var r rec
	parts := strings.Split(line, "\"")
	if len(parts) != 3 {
		return r, false
	}
	before, req, after := parts[0], parts[1], parts[2]
	if !strings.HasSuffix(before, " ") || !strings.HasPrefix(after, " ") {
		return r, false
	}
	b := strings.Split(before[:len(before)-1], " ")
	if len(b) != 5 {
		return r, false
	}
	ipParts := strings.Split(b[0], ".")
	if len(ipParts) != 4 {
		return r, false
	}
	for _, p := range ipParts {
		if v, ok := digits(p, 1, 3); !ok || v > 255 {
			return r, false
		}
	}
	for _, tok := range b[1:3] {
		if tok == "" || strings.Contains(tok, "[") {
			return r, false
		}
	}
	t1, t2 := b[3], b[4]
	if !strings.HasPrefix(t1, "[") || !strings.HasSuffix(t2, "]") {
		return r, false
	}
	ts, zone := t1[1:], t2[:len(t2)-1]
	if len(ts) != 20 || ts[2] != '/' || ts[6] != '/' || ts[11] != ':' || ts[14] != ':' || ts[17] != ':' {
		return r, false
	}
	dd, ok1 := digits(ts[0:2], 2, 2)
	_, ok2 := digits(ts[7:11], 4, 4)
	hh, ok3 := digits(ts[12:14], 2, 2)
	mm, ok4 := digits(ts[15:17], 2, 2)
	ss, ok5 := digits(ts[18:20], 2, 2)
	if !ok1 || !ok2 || !ok3 || !ok4 || !ok5 || dd < 1 || dd > 31 || hh > 23 || mm > 59 || ss > 59 || !months[ts[3:6]] {
		return r, false
	}
	if len(zone) != 5 || (zone[0] != '+' && zone[0] != '-') {
		return r, false
	}
	if _, ok := digits(zone[1:], 4, 4); !ok {
		return r, false
	}
	q := strings.Split(req, " ")
	if len(q) != 3 || !methods[q[0]] || !strings.HasPrefix(q[1], "/") || !protos[q[2]] {
		return r, false
	}
	a := strings.Split(after[1:], " ")
	if len(a) != 3 {
		return r, false
	}
	status, ok := digits(a[0], 3, 3)
	if !ok || status < 100 || status > 599 {
		return r, false
	}
	nbytes := 0
	if a[1] != "-" {
		if nbytes, ok = digits(a[1], 1, 10); !ok {
			return r, false
		}
	}
	tp := strings.Split(a[2], ".")
	if len(tp) != 2 {
		return r, false
	}
	secs, ok1 := digits(tp[0], 1, 4)
	frac, ok2 := digits(tp[1], 3, 3)
	if !ok1 || !ok2 {
		return r, false
	}
	target := q[1]
	if i := strings.IndexAny(target, "?#"); i >= 0 {
		target = target[:i]
	}
	segs := strings.Split(target, "/")
	for i, s := range segs {
		if _, isNum := digits(s, 1, 1<<30); isNum {
			segs[i] = ":id"
		}
	}
	return rec{ip: b[0], hour: ts[12:14], route: q[0] + " " + strings.Join(segs, "/"), status: status, bytes: nbytes, ms: secs*1000 + frac}, true
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	var recs []rec
	bad := 0
	for sc.Scan() {
		l := sc.Text()
		if strings.Trim(l, " ") == "" {
			continue
		}
		if r, ok := parse(l); ok {
			recs = append(recs, r)
		} else {
			bad++
		}
	}
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	total := 0
	ips := map[string]bool{}
	var cls [6]int
	hours := map[string]int{}
	routes := map[string][]rec{}
	for _, r := range recs {
		total += r.bytes
		ips[r.ip] = true
		cls[r.status/100]++
		hours[r.hour]++
		routes[r.route] = append(routes[r.route], r)
	}
	fmt.Fprintf(w, "requests=%d malformed=%d bytes=%d ips=%d\n", len(recs), bad, total, len(ips))
	fmt.Fprintf(w, "status 1xx=%d 2xx=%d 3xx=%d 4xx=%d 5xx=%d\n", cls[1], cls[2], cls[3], cls[4], cls[5])
	hs := make([]string, 0, len(hours))
	for h := range hours {
		hs = append(hs, h)
	}
	sort.Strings(hs)
	if len(hs) == 0 {
		fmt.Fprintln(w, "hours none")
	} else {
		items := make([]string, len(hs))
		for i, h := range hs {
			items[i] = fmt.Sprintf("%s=%d", h, hours[h])
		}
		fmt.Fprintln(w, "hours "+strings.Join(items, " "))
	}
	if len(routes) == 0 {
		fmt.Fprintln(w, "endpoints none")
		return
	}
	names := make([]string, 0, len(routes))
	for n := range routes {
		names = append(names, n)
	}
	sort.Slice(names, func(i, j int) bool {
		a, b := names[i], names[j]
		if len(routes[a]) != len(routes[b]) {
			return len(routes[a]) > len(routes[b])
		}
		return a < b
	})
	if len(names) > 5 {
		names = names[:5]
	}
	for _, name := range names {
		rs := routes[name]
		ts := make([]int, len(rs))
		sum, errs := 0, 0
		for i, r := range rs {
			ts[i] = r.ms
			sum += r.ms
			if r.status >= 400 {
				errs++
			}
		}
		sort.Ints(ts)
		n := len(ts)
		avg := (2*sum + n) / (2 * n)
		p95 := ts[(95*n+99)/100-1]
		fmt.Fprintf(w, "endpoint %d %s avg=%dms p95=%dms errors=%d\n", n, name, avg, p95, errs)
	}
}
