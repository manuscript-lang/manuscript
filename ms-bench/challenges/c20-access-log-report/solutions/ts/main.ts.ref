import { readFileSync } from "node:fs";

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const METHODS = ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"];
const PROTOS = ["HTTP/1.0", "HTTP/1.1", "HTTP/2.0"];

type Rec = { ip: string; hour: string; route: string; status: number; bytes: number; ms: number };

function parse(line: string): Rec | null {
  const parts = line.split('"');
  if (parts.length !== 3) return null;
  const [before, req, after] = parts;
  if (!before.endsWith(" ") || !after.startsWith(" ")) return null;
  const b = before.slice(0, -1).split(" ");
  if (b.length !== 5) return null;
  const [ip, ident, user, t1, t2] = b;
  const ipm = /^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$/.exec(ip);
  if (!ipm || ipm.slice(1).some((g) => Number(g) > 255)) return null;
  for (const tok of [ident, user]) if (tok === "" || tok.includes("[")) return null;
  if (!t1.startsWith("[") || !t2.endsWith("]")) return null;
  const tm = /^([0-9]{2})\/([A-Za-z]{3})\/([0-9]{4}):([0-9]{2}):([0-9]{2}):([0-9]{2}) [+-][0-9]{4}$/.exec(t1.slice(1) + " " + t2.slice(0, -1));
  if (!tm) return null;
  const dd = Number(tm[1]);
  if (dd < 1 || dd > 31 || !MONTHS.includes(tm[2]) || Number(tm[4]) > 23 || Number(tm[5]) > 59 || Number(tm[6]) > 59) return null;
  const r = req.split(" ");
  if (r.length !== 3 || !METHODS.includes(r[0]) || !r[1].startsWith("/") || !PROTOS.includes(r[2])) return null;
  const a = after.slice(1).split(" ");
  if (a.length !== 3) return null;
  const [status, nbytes, time] = a;
  if (!/^[0-9]{3}$/.test(status) || Number(status) < 100 || Number(status) > 599) return null;
  if (nbytes !== "-" && !/^[0-9]{1,10}$/.test(nbytes)) return null;
  const tmm = /^([0-9]{1,4})\.([0-9]{3})$/.exec(time);
  if (!tmm) return null;
  let target = r[1];
  const cuts = [target.indexOf("?"), target.indexOf("#")].filter((i) => i >= 0);
  if (cuts.length) target = target.slice(0, Math.min(...cuts));
  const route = target.split("/").map((s) => (/^[0-9]+$/.test(s) ? ":id" : s)).join("/");
  return {
    ip, hour: tm[4], route: `${r[0]} ${route}`, status: Number(status),
    bytes: nbytes === "-" ? 0 : Number(nbytes), ms: Number(tmm[1]) * 1000 + Number(tmm[2]),
  };
}

const lines = readFileSync(0, "utf8").split("\n");
if (lines[lines.length - 1] === "") lines.pop();
const recs: Rec[] = [];
let bad = 0;
for (const l of lines) {
  if (l.replace(/ /g, "") === "") continue;
  const r = parse(l);
  if (r) recs.push(r);
  else bad++;
}
const out: string[] = [];
out.push(`requests=${recs.length} malformed=${bad} bytes=${recs.reduce((s, r) => s + r.bytes, 0)} ips=${new Set(recs.map((r) => r.ip)).size}`);
const cls = [1, 2, 3, 4, 5].map((c) => recs.filter((r) => Math.floor(r.status / 100) === c).length);
out.push("status " + cls.map((n, i) => `${i + 1}xx=${n}`).join(" "));
const hours = new Map<string, number>();
for (const r of recs) hours.set(r.hour, (hours.get(r.hour) ?? 0) + 1);
out.push("hours " + (hours.size ? [...hours.keys()].sort().map((h) => `${h}=${hours.get(h)}`).join(" ") : "none"));
const routes = new Map<string, Rec[]>();
for (const r of recs) {
  if (!routes.has(r.route)) routes.set(r.route, []);
  routes.get(r.route)!.push(r);
}
if (routes.size === 0) out.push("endpoints none");
const cmp = (a: string, b: string) => (a < b ? -1 : a > b ? 1 : 0);
const top = [...routes.entries()].sort((x, y) => y[1].length - x[1].length || cmp(x[0], y[0])).slice(0, 5);
for (const [name, rs] of top) {
  const ts = rs.map((r) => r.ms).sort((x, y) => x - y);
  const n = ts.length;
  const sum = ts.reduce((s, x) => s + x, 0);
  const avg = Math.floor((2 * sum + n) / (2 * n));
  const p95 = ts[Math.floor((95 * n + 99) / 100) - 1];
  const errs = rs.filter((r) => r.status >= 400).length;
  out.push(`endpoint ${n} ${name} avg=${avg}ms p95=${p95}ms errors=${errs}`);
}
process.stdout.write(out.map((x) => x + "\n").join(""));
