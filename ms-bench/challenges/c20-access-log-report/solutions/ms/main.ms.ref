import {stdin, stdout, read_line} from "@std/io.ms"
import Set from "@std/collections.ms"

# Parses s when it is lo to hi ASCII digits.
fn digits(s: String, lo: Int, hi: Int) -> Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() < lo or codes.length() > hi:
        return none
    var n = 0
    for c in codes:
        if c < 48 or c > 57:
            return none
        n = n * 10 + (c - 48)
    return some(n)

fn in_list(items: List[String], value: String) -> Bool:
    for item in items:
        if item == value:
            return true
    return false

type Entry:
    ip: String
    hour: Int
    route: String
    status: Int
    bytes: Int
    ms: Int

type RouteStats:
    times: List[Int]
    errors: Int

fn route_of(method: String, target: String) -> String:
    var cut = target.length()
    let q = target.index_of("?")
    if q.is_some() and q.unwrap() < cut:
        cut = q.unwrap()
    let h = target.index_of("#")
    if h.is_some() and h.unwrap() < cut:
        cut = h.unwrap()
    let segments = List[String]()
    for seg in target.slice(0, cut).split("/"):
        if digits(seg, 1, 1000000).is_some():
            segments.append(":id")
        else:
            segments.append(seg)
    return "{method} {segments.join("/")}"

fn parse(line: String) -> Optional[Entry]:
    let parts = line.split("\"")
    if parts.length() != 3:
        return none
    let before = parts.at(0).unwrap()
    let req = parts.at(1).unwrap()
    let after = parts.at(2).unwrap()
    if not before.ends_with(" ") or not after.starts_with(" "):
        return none
    let b = before.slice(0, before.length() - 1).split(" ")
    if b.length() != 5:
        return none
    let ip_parts = b.at(0).unwrap().split(".")
    if ip_parts.length() != 4:
        return none
    for p in ip_parts:
        let v = digits(p, 1, 3)
        if v.is_none() or v.unwrap() > 255:
            return none
    var i = 1
    while i < 3:
        let tok = b.at(i).unwrap()
        if tok.is_empty() or tok.contains("["):
            return none
        i = i + 1
    let t1 = b.at(3).unwrap()
    let t2 = b.at(4).unwrap()
    if not t1.starts_with("[") or not t2.ends_with("]"):
        return none
    let ts = t1.slice(1, t1.length())
    let zone = t2.slice(0, t2.length() - 1)
    let tc = ts.scalar_values()
    if tc.length() != 20:
        return none
    # '/' is 47 and ':' is 58
    if tc.at(2).unwrap() != 47 or tc.at(6).unwrap() != 47 or tc.at(11).unwrap() != 58 or tc.at(14).unwrap() != 58 or tc.at(17).unwrap() != 58:
        return none
    let dd = digits(ts.slice(0, 2), 2, 2)
    let yyyy = digits(ts.slice(7, 11), 4, 4)
    let hh = digits(ts.slice(12, 14), 2, 2)
    let mm = digits(ts.slice(15, 17), 2, 2)
    let ss = digits(ts.slice(18, 20), 2, 2)
    if dd.is_none() or yyyy.is_none() or hh.is_none() or mm.is_none() or ss.is_none():
        return none
    let months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]
    if dd.unwrap() < 1 or dd.unwrap() > 31 or hh.unwrap() > 23 or mm.unwrap() > 59 or ss.unwrap() > 59:
        return none
    if not in_list(months, ts.slice(3, 6)):
        return none
    let zc = zone.scalar_values()
    if zc.length() != 5 or (zc.at(0).unwrap() != 43 and zc.at(0).unwrap() != 45):
        return none
    if digits(zone.slice(1, 5), 4, 4).is_none():
        return none
    let q = req.split(" ")
    if q.length() != 3:
        return none
    let methods = ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"]
    let protos = ["HTTP/1.0", "HTTP/1.1", "HTTP/2.0"]
    if not in_list(methods, q.at(0).unwrap()) or not q.at(1).unwrap().starts_with("/") or not in_list(protos, q.at(2).unwrap()):
        return none
    let a = after.slice(1, after.length()).split(" ")
    if a.length() != 3:
        return none
    let status = digits(a.at(0).unwrap(), 3, 3)
    if status.is_none() or status.unwrap() < 100 or status.unwrap() > 599:
        return none
    var nbytes = 0
    if a.at(1).unwrap() != "-":
        let nb = digits(a.at(1).unwrap(), 1, 10)
        if nb.is_none():
            return none
        nbytes = nb.unwrap()
    let tp = a.at(2).unwrap().split(".")
    if tp.length() != 2:
        return none
    let secs = digits(tp.at(0).unwrap(), 1, 4)
    let frac = digits(tp.at(1).unwrap(), 3, 3)
    if secs.is_none() or frac.is_none():
        return none
    return some(Entry(
        ip: b.at(0).unwrap(),
        hour: hh.unwrap(),
        route: route_of(q.at(0).unwrap(), q.at(1).unwrap()),
        status: status.unwrap(),
        bytes: nbytes,
        ms: secs.unwrap() * 1000 + frac.unwrap()
    ))

fn two(n: Int) -> String:
    if n < 10:
        return "0{n}"
    return "{n}"

fn run() -> Result[Unit, Error]:
    let ips = Set[String]()
    let hours = List[Int]()
    var h = 0
    while h < 24:
        hours.append(0)
        h = h + 1
    let classes = [0, 0, 0, 0, 0, 0]
    let routes = Map[String, RouteStats]()
    var good = 0
    var bad = 0
    var total_bytes = 0
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let line = next.unwrap()
        if line.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        let parsed = parse(line)
        if parsed.is_none():
            bad = bad + 1
            continue
        let e = parsed.unwrap()
        good = good + 1
        total_bytes = total_bytes + e.bytes
        ips.add(e.ip)
        hours.set(e.hour, hours.at(e.hour).unwrap() + 1)
        let cls = e.status / 100
        classes.set(cls, classes.at(cls).unwrap() + 1)
        let stats = routes.get(e.route)
        var failed = 0
        if e.status >= 400:
            failed = 1
        if stats.is_none():
            routes.add(key: e.route, value: RouteStats(times: [e.ms], errors: failed))
        else:
            stats.unwrap().times.append(e.ms)
            stats.unwrap().errors = stats.unwrap().errors + failed
    try stdout().write("requests={good} malformed={bad} bytes={total_bytes} ips={ips.length()}\n".to_bytes())
    try stdout().write("status 1xx={classes.at(1).unwrap()} 2xx={classes.at(2).unwrap()} 3xx={classes.at(3).unwrap()} 4xx={classes.at(4).unwrap()} 5xx={classes.at(5).unwrap()}\n".to_bytes())
    let hour_items = List[String]()
    h = 0
    while h < 24:
        if hours.at(h).unwrap() > 0:
            hour_items.append("{two(h)}={hours.at(h).unwrap()}")
        h = h + 1
    if hour_items.is_empty():
        try stdout().write("hours none\n".to_bytes())
    else:
        try stdout().write("hours {hour_items.join(" ")}\n".to_bytes())
    if routes.is_empty():
        try stdout().write("endpoints none\n".to_bytes())
        return stdout().flush()
    let names = routes.keys().sorted(compare: fn(left: String, right: String) -> Int:
        let diff = routes.get(right).unwrap().times.length() - routes.get(left).unwrap().times.length()
        if diff != 0:
            return diff
        return left.compare(right)
    )
    var shown = 0
    for name in names:
        if shown >= 5:
            break
        shown = shown + 1
        let stats = routes.get(name).unwrap()
        let times = stats.times.sorted(compare: fn(left: Int, right: Int) -> Int:
            return left - right
        )
        let n = times.length()
        var sum = 0
        for t in times:
            sum = sum + t
        let avg = (2 * sum + n) / (2 * n)
        let p95 = times.at((95 * n + 99) / 100 - 1).unwrap()
        try stdout().write("endpoint {n} {name} avg={avg}ms p95={p95}ms errors={stats.errors}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
