use std::collections::BTreeMap;
use std::io::{self, Read, Write};

#[derive(Default)]
struct Node {
    kids: BTreeMap<u8, Node>,
    end: bool,
    count: usize,
}

impl Node {
    fn find(&self, prefix: &[u8]) -> Option<&Node> {
        let mut n = self;
        for c in prefix {
            n = n.kids.get(c)?;
        }
        Some(n)
    }

    fn insert(&mut self, word: &[u8]) -> bool {
        if self.find(word).map_or(false, |n| n.end) {
            return false;
        }
        let mut cur = self;
        cur.count += 1;
        for c in word {
            cur = cur.kids.entry(*c).or_default();
            cur.count += 1;
        }
        cur.end = true;
        true
    }

    fn collect(&self, prefix: &mut Vec<u8>, limit: usize, acc: &mut Vec<String>) {
        if acc.len() >= limit {
            return;
        }
        if self.end {
            acc.push(String::from_utf8(prefix.clone()).unwrap());
        }
        // BTreeMap iterates in ascending key order.
        for (c, k) in &self.kids {
            if acc.len() >= limit {
                return;
            }
            prefix.push(*c);
            k.collect(prefix, limit, acc);
            prefix.pop();
        }
    }
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut root = Node::default();
    let mut out = String::new();
    for line in input.split('\n') {
        if line.trim().is_empty() {
            continue;
        }
        let p: Vec<&str> = line.split(' ').collect();
        match p[0] {
            "insert" => out.push_str(if root.insert(p[1].as_bytes()) { "added\n" } else { "exists\n" }),
            "has" => {
                let yes = root.find(p[1].as_bytes()).map_or(false, |n| n.end);
                out.push_str(if yes { "yes\n" } else { "no\n" });
            }
            "count" => {
                let c = root.find(p[1].as_bytes()).map_or(0, |n| n.count);
                out.push_str(&format!("{}\n", c));
            }
            "complete" => {
                let k: usize = p[2].parse().unwrap();
                let mut acc = Vec::new();
                if let Some(n) = root.find(p[1].as_bytes()) {
                    n.collect(&mut p[1].as_bytes().to_vec(), k, &mut acc);
                }
                if acc.is_empty() {
                    out.push_str("none\n");
                } else {
                    out.push_str(&format!("{}\n", acc.join(" ")));
                }
            }
            _ => {}
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
