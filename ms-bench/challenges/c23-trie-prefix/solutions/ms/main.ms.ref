import {stdin, stdout, read_all} from "@std/io.ms"

# The dictionary is a sorted list of distinct words. Words that start with a prefix form one
# contiguous block that begins at the prefix's lower bound.

# First index whose word is >= key in byte order.
fn lower_bound(words: List[String], key: String) -> Int:
    var lo = 0
    var hi = words.length()
    while lo < hi:
        let mid = (lo + hi) / 2
        if words.at(mid).unwrap().compare(key) < 0:
            lo = mid + 1
        else:
            hi = mid
    return lo

# Number of words from `start` on that begin with `prefix`, at most `limit`.
fn matching(words: List[String], prefix: String, start: Int, limit: Int) -> Int:
    var n = 0
    var i = start
    while i < words.length() and n < limit:
        if not words.at(i).unwrap().starts_with(prefix):
            break
        n = n + 1
        i = i + 1
    return n

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let text = data.to_text().unwrap_or("")
    let words = List[String]()
    let out = List[String]()
    for line in text.split("\n"):
        if line.trim().is_empty():
            continue
        let p = line.split(" ")
        let cmd = p.at(0).unwrap()
        let arg = p.at(1).unwrap()
        let at = lower_bound(words, arg)
        let present = at < words.length() and words.at(at).unwrap() == arg
        if cmd == "insert":
            if present:
                out.append("exists")
            else:
                words.with_values(at, 0, [arg])
                out.append("added")
        else if cmd == "has":
            if present:
                out.append("yes")
            else:
                out.append("no")
        else if cmd == "count":
            out.append("{matching(words, arg, at, words.length())}")
        else if cmd == "complete":
            let limit = p.at(2).unwrap().parse_int().unwrap()
            let n = matching(words, arg, at, limit)
            if n == 0:
                out.append("none")
            else:
                out.append(words.slice(at, at + n).join(" "))
    if not out.is_empty():
        try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
