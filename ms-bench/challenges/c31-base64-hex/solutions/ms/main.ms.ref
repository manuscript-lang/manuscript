import {stdin, stdout, read_all} from "@std/io.ms"
import from_scalars from "@std/string.ms"

fn alphabet() -> String:
    return "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

fn hex_digits() -> String:
    return "0123456789abcdef"

# Character at index i of a constant ASCII table.
fn pick(table: String, i: Int) -> String:
    return table.at(i).unwrap()

fn b64_encode(text: String) -> String:
    let bytes = text.to_bytes().values()
    let out = List[String]()
    var i = 0
    while i < bytes.length():
        let n = bytes.length() - i
        var v = bytes.at(i).unwrap() * 65536
        if n > 1:
            v = v + bytes.at(i + 1).unwrap() * 256
        if n > 2:
            v = v + bytes.at(i + 2).unwrap()
        out.append(pick(alphabet(), (v / 262144) % 64))
        out.append(pick(alphabet(), (v / 4096) % 64))
        if n > 1:
            out.append(pick(alphabet(), (v / 64) % 64))
        else:
            out.append("=")
        if n > 2:
            out.append(pick(alphabet(), v % 64))
        else:
            out.append("=")
        i = i + 3
    return out.join("")

# Turns decoded bytes into text, or none unless every byte is printable ASCII (32 to 126).
fn printable(bytes: List[Int]) -> Optional[String]:
    for b in bytes:
        if b < 32 or b > 126:
            return none
    match from_scalars(bytes):
        ok(text): return some(text)
        error(_): return none

fn b64_decode(t: String) -> Optional[String]:
    let codes = t.scalar_values()
    if codes.length() % 4 != 0:
        return none
    var body = codes.length()
    while body > 0 and codes.at(body - 1).unwrap() == 61:
        body = body - 1
    if codes.length() - body > 2:
        return none
    let vals = List[Int]()
    var i = 0
    while i < body:
        let v = alphabet().index_of(t.slice(i, i + 1).unwrap())
        if v.is_none():
            return none
        vals.append(v.unwrap())
        i = i + 1
    let bytes = List[Int]()
    var g = 0
    while g < vals.length():
        let size = vals.length() - g
        var glen = 4
        if size < 4:
            glen = size
        var n = 0
        var k = 0
        while k < 4:
            n = n * 64
            if k < glen:
                n = n + vals.at(g + k).unwrap()
            k = k + 1
        let raw = [n / 65536, (n / 256) % 256, n % 256]
        let keep = glen - 1
        var j = keep
        while j < 3:
            if raw.at(j).unwrap() != 0:
                return none
            j = j + 1
        j = 0
        while j < keep:
            bytes.append(raw.at(j).unwrap())
            j = j + 1
        g = g + 4
    return printable(bytes)

fn hex_decode(t: String) -> Optional[String]:
    let codes = t.scalar_values()
    if codes.length() % 2 != 0:
        return none
    let digits = List[Int]()
    for c in codes:
        var d = -1
        if c >= 48 and c <= 57:
            d = c - 48
        else if c >= 97 and c <= 102:
            d = c - 87
        else if c >= 65 and c <= 70:
            d = c - 55
        if d < 0:
            return none
        digits.append(d)
    let bytes = List[Int]()
    var i = 0
    while i < digits.length():
        bytes.append(digits.at(i).unwrap() * 16 + digits.at(i + 1).unwrap())
        i = i + 2
    return printable(bytes)

fn hex_encode(text: String) -> String:
    let out = List[String]()
    for b in text.to_bytes().values():
        out.append(pick(hex_digits(), b / 16))
        out.append(pick(hex_digits(), b % 16))
    return out.join("")

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let text = data.to_text().unwrap_or("")
    let out = List[String]()
    for line in text.split("\n"):
        var only_spaces = true
        for c in line.scalar_values():
            if c != 32:
                only_spaces = false
        if only_spaces:
            continue
        let sp = line.index_of(" ")
        var cmd = line
        var arg = ""
        if sp.is_some():
            cmd = line.slice(0, sp.unwrap()).unwrap()
            arg = line.slice(sp.unwrap() + 1, line.length()).unwrap()
        var res: Optional[String] = none
        if cmd == "b64e":
            res = some(b64_encode(arg))
        else if cmd == "hexe":
            res = some(hex_encode(arg))
        else if cmd == "b64d":
            res = b64_decode(arg)
        else if cmd == "hexd":
            res = hex_decode(arg)
        out.append(res.unwrap_or("error"))
    if not out.is_empty():
        try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
