import { readFileSync } from "node:fs";

const ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const HEX = "0123456789abcdef";

function b64Encode(text: string): string {
  const bytes = [...text].map((c) => c.charCodeAt(0));
  let out = "";
  for (let i = 0; i < bytes.length; i += 3) {
    const n = bytes.length - i;
    const v = (bytes[i] << 16) | ((n > 1 ? bytes[i + 1] : 0) << 8) | (n > 2 ? bytes[i + 2] : 0);
    out += ALPHA[(v >> 18) & 63] + ALPHA[(v >> 12) & 63];
    out += n > 1 ? ALPHA[(v >> 6) & 63] : "=";
    out += n > 2 ? ALPHA[v & 63] : "=";
  }
  return out;
}

function printable(bytes: number[]): string | null {
  return bytes.every((b) => b >= 32 && b <= 126) ? String.fromCharCode(...bytes) : null;
}

function b64Decode(t: string): string | null {
  if (t.length % 4 !== 0) return null;
  let body = t;
  let pad = 0;
  while (body.endsWith("=")) { body = body.slice(0, -1); pad++; }
  if (pad > 2) return null;
  const vals: number[] = [];
  for (const c of body) {
    const v = ALPHA.indexOf(c);
    if (v < 0) return null;
    vals.push(v);
  }
  const bytes: number[] = [];
  for (let i = 0; i < vals.length; i += 4) {
    const g = vals.slice(i, i + 4);
    let n = 0;
    for (let k = 0; k < 4; k++) n = n * 64 + (k < g.length ? g[k] : 0);
    const keep = g.length - 1; // 4 -> 3, 3 -> 2, 2 -> 1
    const raw = [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    if (raw.slice(keep).some((b) => b !== 0)) return null;
    bytes.push(...raw.slice(0, keep));
  }
  return printable(bytes);
}

function hexDecode(t: string): string | null {
  if (t.length % 2 !== 0 || !/^[0-9a-fA-F]*$/.test(t)) return null;
  const bytes: number[] = [];
  for (let i = 0; i < t.length; i += 2) bytes.push(parseInt(t.slice(i, i + 2), 16));
  return printable(bytes);
}

const out: string[] = [];
for (const line of readFileSync(0, "utf8").split("\n")) {
  if (line.replace(/ /g, "") === "") continue;
  const sp = line.indexOf(" ");
  const cmd = sp < 0 ? line : line.slice(0, sp);
  const text = sp < 0 ? "" : line.slice(sp + 1);
  let res: string | null;
  if (cmd === "b64e") res = b64Encode(text);
  else if (cmd === "hexe") res = [...text].map((c) => HEX[c.charCodeAt(0) >> 4] + HEX[c.charCodeAt(0) & 15]).join("");
  else if (cmd === "b64d") res = b64Decode(text);
  else if (cmd === "hexd") res = hexDecode(text);
  else res = null;
  out.push(res === null ? "error" : res);
}
process.stdout.write(out.map((l) => l + "\n").join(""));
