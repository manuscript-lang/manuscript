use std::io::{self, Read, Write};

fn parse_row(line: &str) -> Vec<String> {
    let b = line.as_bytes();
    let n = b.len();
    let mut fields = Vec::new();
    let mut i = 0;
    loop {
        if i < n && b[i] == b'"' {
            i += 1;
            let mut buf = Vec::new();
            while i < n {
                if b[i] == b'"' {
                    if i + 1 < n && b[i + 1] == b'"' {
                        buf.push(b'"');
                        i += 2;
                        continue;
                    }
                    i += 1;
                    break;
                }
                buf.push(b[i]);
                i += 1;
            }
            fields.push(String::from_utf8(buf).unwrap());
        } else {
            let j = line[i..].find(',').map_or(n, |k| k + i);
            fields.push(line[i..j].to_string());
            i = j;
        }
        if i < n && b[i] == b',' {
            i += 1;
            if i == n {
                fields.push(String::new());
                break;
            }
            continue;
        }
        break;
    }
    fields
}

fn is_int(s: &str) -> bool {
    let d = s.strip_prefix('-').unwrap_or(s);
    !d.is_empty() && d.bytes().all(|c| c.is_ascii_digit())
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut rows: Vec<Vec<String>> = input.split('\n').filter(|l| !l.is_empty()).map(parse_row).collect();
    if rows.is_empty() {
        return;
    }
    let cols = rows[0].len();
    for r in rows.iter_mut() {
        r.truncate(cols);
        while r.len() < cols {
            r.push(String::new());
        }
    }
    let numeric: Vec<bool> = (0..cols).map(|c| rows.len() > 1 && rows[1..].iter().all(|r| is_int(&r[c]))).collect();
    let width: Vec<usize> = (0..cols).map(|c| rows.iter().map(|r| r[c].len()).max().unwrap()).collect();
    let line = |r: &Vec<String>| -> String {
        let cells: Vec<String> = r
            .iter()
            .enumerate()
            .map(|(c, cell)| if numeric[c] { format!("{:>w$}", cell, w = width[c]) } else { format!("{:<w$}", cell, w = width[c]) })
            .collect();
        cells.join(" | ").trim_end_matches(' ').to_string()
    };
    let mut out = String::new();
    out.push_str(&line(&rows[0]));
    out.push('\n');
    let dashes: Vec<String> = width.iter().map(|w| "-".repeat(*w)).collect();
    out.push_str(&dashes.join("-+-"));
    out.push('\n');
    for r in &rows[1..] {
        out.push_str(&line(r));
        out.push('\n');
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
