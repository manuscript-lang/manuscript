package main

import (
	"bufio"
	"io"
	"os"
	"strings"
)

func parseRow(line string) []string {
	var fields []string
	i, n := 0, len(line)
	for {
		if i < n && line[i] == '"' {
			i++
			var buf []byte
			for i < n {
				if line[i] == '"' {
					if i+1 < n && line[i+1] == '"' {
						buf = append(buf, '"')
						i += 2
						continue
					}
					i++
					break
				}
				buf = append(buf, line[i])
				i++
			}
			fields = append(fields, string(buf))
		} else {
			j := strings.IndexByte(line[i:], ',')
			if j < 0 {
				j = n
			} else {
				j += i
			}
			fields = append(fields, line[i:j])
			i = j
		}
		if i < n && line[i] == ',' {
			i++
			if i == n {
				fields = append(fields, "")
				break
			}
			continue
		}
		break
	}
	return fields
}

func isInt(s string) bool {
	if strings.HasPrefix(s, "-") {
		s = s[1:]
	}
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

func main() {
	data, _ := io.ReadAll(os.Stdin)
	var rows [][]string
	for _, l := range strings.Split(string(data), "\n") {
		if l != "" {
			rows = append(rows, parseRow(l))
		}
	}
	if len(rows) == 0 {
		return
	}
	cols := len(rows[0])
	for i, r := range rows {
		if len(r) > cols {
			r = r[:cols]
		}
		for len(r) < cols {
			r = append(r, "")
		}
		rows[i] = r
	}
	numeric := make([]bool, cols)
	width := make([]int, cols)
	for c := 0; c < cols; c++ {
		numeric[c] = len(rows) > 1
		for i, r := range rows {
			if len(r[c]) > width[c] {
				width[c] = len(r[c])
			}
			if i > 0 && !isInt(r[c]) {
				numeric[c] = false
			}
		}
	}
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	line := func(r []string) {
		cells := make([]string, cols)
		for c, cell := range r {
			pad := strings.Repeat(" ", width[c]-len(cell))
			if numeric[c] {
				cells[c] = pad + cell
			} else {
				cells[c] = cell + pad
			}
		}
		out.WriteString(strings.TrimRight(strings.Join(cells, " | "), " ") + "\n")
	}
	line(rows[0])
	dashes := make([]string, cols)
	for c := range dashes {
		dashes[c] = strings.Repeat("-", width[c])
	}
	out.WriteString(strings.Join(dashes, "-+-") + "\n")
	for _, r := range rows[1:] {
		line(r)
	}
}
