package main

import (
	"bufio"
	"fmt"
	"os"
	"sort"
	"strconv"
	"strings"
)

type task struct {
	id, p  int
	due    int // days since 1970-01-01, noDue when absent
	title  string
	done   bool
}

const noDue = int(^uint(0) >> 1)

func floorDiv(a, b int) int {
	q := a / b
	if a%b != 0 && (a < 0) != (b < 0) {
		q--
	}
	return q
}

func toDays(y, m, d int) int {
	if m <= 2 {
		y--
	}
	era := floorDiv(y, 400)
	yoe := y - era*400
	mm := m - 3
	if m <= 2 {
		mm = m + 9
	}
	doy := (153*mm+2)/5 + d - 1
	doe := yoe*365 + yoe/4 - yoe/100 + doy
	return era*146097 + doe - 719468
}

func fromDays(z int) string {
	z += 719468
	era := floorDiv(z, 146097)
	doe := z - era*146097
	yoe := (doe - doe/1460 + doe/36524 - doe/146096) / 365
	doy := doe - (365*yoe + yoe/4 - yoe/100)
	mp := (5*doy + 2) / 153
	d := doy - (153*mp+2)/5 + 1
	m := mp + 3
	if mp >= 10 {
		m = mp - 9
	}
	y := yoe + era*400
	if m <= 2 {
		y++
	}
	return fmt.Sprintf("%04d-%02d-%02d", y, m, d)
}

func isDigits(s string) bool {
	if s == "" {
		return false
	}
	for _, c := range s {
		if c < '0' || c > '9' {
			return false
		}
	}
	return true
}

func parseDate(s string) (int, bool) {
	if len(s) != 10 || s[4] != '-' || s[7] != '-' {
		return 0, false
	}
	if !isDigits(s[0:4]) || !isDigits(s[5:7]) || !isDigits(s[8:10]) {
		return 0, false
	}
	y, _ := strconv.Atoi(s[0:4])
	m, _ := strconv.Atoi(s[5:7])
	d, _ := strconv.Atoi(s[8:10])
	if y < 1970 || y > 2100 || m < 1 || m > 12 || d < 1 {
		return 0, false
	}
	leap := (y%4 == 0 && y%100 != 0) || y%400 == 0
	dim := []int{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31}[m-1]
	if m == 2 && leap {
		dim = 29
	}
	if d > dim {
		return 0, false
	}
	return toDays(y, m, d), true
}

func isPrio(s string) bool { return s == "1" || s == "2" || s == "3" }

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	tasks := map[int]*task{}
	nextID := 1
	for sc.Scan() {
		t := strings.FieldsFunc(sc.Text(), func(r rune) bool { return r == ' ' || r == '\t' })
		if len(t) == 0 {
			continue
		}
		c, n := t[0], len(t)
		fits := map[string]bool{"add": n >= 4, "done": n == 2, "drop": n == 2, "prio": n == 3, "snooze": n == 3, "list": n == 2, "summary": n == 2, "agenda": n == 3}
		if !fits[c] {
			fmt.Fprintln(out, "error: bad command")
			continue
		}
		switch c {
		case "add":
			if !isPrio(t[1]) {
				fmt.Fprintln(out, "error: bad priority")
				continue
			}
			due := noDue
			if t[2] != "-" {
				d, ok := parseDate(t[2])
				if !ok {
					fmt.Fprintln(out, "error: bad date")
					continue
				}
				due = d
			}
			p, _ := strconv.Atoi(t[1])
			tasks[nextID] = &task{id: nextID, p: p, due: due, title: strings.Join(t[3:], " ")}
			fmt.Fprintf(out, "added %d\n", nextID)
			nextID++
			continue
		case "done", "drop", "prio", "snooze":
			k := -1
			if isDigits(t[1]) {
				k, _ = strconv.Atoi(t[1])
			}
			tk, ok := tasks[k]
			switch {
			case !ok:
				fmt.Fprintf(out, "error: no such task %s\n", t[1])
			case c == "done":
				if tk.done {
					fmt.Fprintf(out, "error: already done %s\n", t[1])
				} else {
					tk.done = true
					fmt.Fprintln(out, "ok")
				}
			case c == "drop":
				delete(tasks, k)
				fmt.Fprintln(out, "ok")
			case c == "prio":
				if !isPrio(t[2]) {
					fmt.Fprintln(out, "error: bad priority")
				} else {
					tk.p, _ = strconv.Atoi(t[2])
					fmt.Fprintln(out, "ok")
				}
			case !isDigits(t[2]):
				fmt.Fprintln(out, "error: bad days")
			case tk.done:
				fmt.Fprintf(out, "error: already done %s\n", t[1])
			case tk.due == noDue:
				fmt.Fprintf(out, "error: no due date %s\n", t[1])
			default:
				days, _ := strconv.Atoi(t[2])
				tk.due += days
				fmt.Fprintf(out, "ok %s\n", fromDays(tk.due))
			}
			continue
		}
		today, ok := parseDate(t[1])
		if !ok {
			fmt.Fprintln(out, "error: bad date")
			continue
		}
		var open []*task
		doneCount := 0
		for _, tk := range tasks {
			if tk.done {
				doneCount++
			} else {
				open = append(open, tk)
			}
		}
		overdue := func(tk *task) bool { return tk.due != noDue && tk.due < today }
		switch c {
		case "list":
			if len(open) == 0 {
				fmt.Fprintln(out, "no open tasks")
				continue
			}
			sort.Slice(open, func(i, j int) bool {
				a, b := open[i], open[j]
				if overdue(a) != overdue(b) {
					return overdue(a)
				}
				if a.p != b.p {
					return a.p < b.p
				}
				if a.due != b.due {
					return a.due < b.due
				}
				return a.id < b.id
			})
			for _, tk := range open {
				mark, due := ".", "-"
				if overdue(tk) {
					mark = "!"
				}
				if tk.due != noDue {
					due = fromDays(tk.due)
				}
				fmt.Fprintf(out, "%s %d p%d %s %s\n", mark, tk.id, tk.p, due, tk.title)
			}
		case "summary":
			var od, td, up, nd int
			best, bestN := noDue, 0
			for _, tk := range open {
				switch {
				case tk.due == noDue:
					nd++
				case tk.due < today:
					od++
				case tk.due == today:
					td++
				default:
					up++
				}
				if tk.due != noDue && tk.due >= today {
					if tk.due < best {
						best, bestN = tk.due, 1
					} else if tk.due == best {
						bestN++
					}
				}
			}
			fmt.Fprintf(out, "open=%d done=%d overdue=%d today=%d upcoming=%d nodue=%d\n", len(open), doneCount, od, td, up, nd)
			if bestN == 0 {
				fmt.Fprintln(out, "next: none")
			} else {
				fmt.Fprintf(out, "next: %s x%d\n", fromDays(best), bestN)
			}
		default:
			days := 0
			if isDigits(t[2]) {
				days, _ = strconv.Atoi(t[2])
			}
			if days < 1 || days > 60 {
				fmt.Fprintln(out, "error: bad days")
				continue
			}
			sort.Slice(open, func(i, j int) bool {
				if open[i].p != open[j].p {
					return open[i].p < open[j].p
				}
				return open[i].id < open[j].id
			})
			for i := 0; i < days; i++ {
				var ids []string
				for _, tk := range open {
					if tk.due == today+i {
						ids = append(ids, strconv.Itoa(tk.id))
					}
				}
				list := "-"
				if len(ids) > 0 {
					list = strings.Join(ids, ",")
				}
				fmt.Fprintf(out, "%s: %s\n", fromDays(today+i), list)
			}
		}
	}
}
