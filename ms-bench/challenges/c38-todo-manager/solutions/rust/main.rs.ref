use std::collections::BTreeMap;
use std::io::{Read, Write};

struct Task {
    p: i64,
    due: Option<i64>,
    title: String,
    done: bool,
}

fn to_days(mut y: i64, m: i64, d: i64) -> i64 {
    if m <= 2 {
        y -= 1;
    }
    let era = y.div_euclid(400);
    let yoe = y - era * 400;
    let mm = if m > 2 { m - 3 } else { m + 9 };
    let doy = (153 * mm + 2) / 5 + d - 1;
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
    era * 146097 + doe - 719468
}

fn from_days(z: i64) -> String {
    let z = z + 719468;
    let era = z.div_euclid(146097);
    let doe = z - era * 146097;
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);
    let mp = (5 * doy + 2) / 153;
    let d = doy - (153 * mp + 2) / 5 + 1;
    let m = if mp < 10 { mp + 3 } else { mp - 9 };
    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };
    format!("{:04}-{:02}-{:02}", y, m, d)
}

fn is_digits(s: &str) -> bool {
    !s.is_empty() && s.bytes().all(|c| c.is_ascii_digit())
}

fn parse_date(s: &str) -> Option<i64> {
    let b = s.as_bytes();
    if b.len() != 10 || b[4] != b'-' || b[7] != b'-' {
        return None;
    }
    if !is_digits(&s[0..4]) || !is_digits(&s[5..7]) || !is_digits(&s[8..10]) {
        return None;
    }
    let y: i64 = s[0..4].parse().ok()?;
    let m: i64 = s[5..7].parse().ok()?;
    let d: i64 = s[8..10].parse().ok()?;
    if y < 1970 || y > 2100 || m < 1 || m > 12 || d < 1 {
        return None;
    }
    let leap = (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
    let dim = [31, if leap { 29 } else { 28 }, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][(m - 1) as usize];
    if d > dim {
        return None;
    }
    Some(to_days(y, m, d))
}

fn is_prio(s: &str) -> bool {
    s == "1" || s == "2" || s == "3"
}

fn main() {
    let mut input = String::new();
    std::io::stdin().read_to_string(&mut input).unwrap();
    let mut out = String::new();
    let mut tasks: BTreeMap<i64, Task> = BTreeMap::new();
    let mut next_id = 1i64;
    for line in input.split('\n') {
        let t: Vec<&str> = line.split(|c| c == ' ' || c == '\t').filter(|x| !x.is_empty()).collect();
        if t.is_empty() {
            continue;
        }
        let (c, n) = (t[0], t.len());
        let fits = match c {
            "add" => n >= 4,
            "done" | "drop" | "list" | "summary" => n == 2,
            "prio" | "snooze" | "agenda" => n == 3,
            _ => false,
        };
        if !fits {
            out.push_str("error: bad command\n");
            continue;
        }
        if c == "add" {
            if !is_prio(t[1]) {
                out.push_str("error: bad priority\n");
                continue;
            }
            let mut due = None;
            if t[2] != "-" {
                due = parse_date(t[2]);
                if due.is_none() {
                    out.push_str("error: bad date\n");
                    continue;
                }
            }
            tasks.insert(next_id, Task { p: t[1].parse().unwrap(), due, title: t[3..].join(" "), done: false });
            out.push_str(&format!("added {}\n", next_id));
            next_id += 1;
            continue;
        }
        if matches!(c, "done" | "drop" | "prio" | "snooze") {
            let k: i64 = if is_digits(t[1]) { t[1].parse().unwrap_or(-1) } else { -1 };
            if !tasks.contains_key(&k) {
                out.push_str(&format!("error: no such task {}\n", t[1]));
                continue;
            }
            if c == "drop" {
                tasks.remove(&k);
                out.push_str("ok\n");
                continue;
            }
            let tk = tasks.get_mut(&k).unwrap();
            match c {
                "done" => {
                    if tk.done {
                        out.push_str(&format!("error: already done {}\n", t[1]));
                    } else {
                        tk.done = true;
                        out.push_str("ok\n");
                    }
                }
                "prio" => {
                    if !is_prio(t[2]) {
                        out.push_str("error: bad priority\n");
                    } else {
                        tk.p = t[2].parse().unwrap();
                        out.push_str("ok\n");
                    }
                }
                _ => {
                    if !is_digits(t[2]) {
                        out.push_str("error: bad days\n");
                    } else if tk.done {
                        out.push_str(&format!("error: already done {}\n", t[1]));
                    } else if let Some(d) = tk.due {
                        let nd = d + t[2].parse::<i64>().unwrap();
                        tk.due = Some(nd);
                        out.push_str(&format!("ok {}\n", from_days(nd)));
                    } else {
                        out.push_str(&format!("error: no due date {}\n", t[1]));
                    }
                }
            }
            continue;
        }
        let today = match parse_date(t[1]) {
            Some(d) => d,
            None => {
                out.push_str("error: bad date\n");
                continue;
            }
        };
        let mut open: Vec<(i64, &Task)> = tasks.iter().filter(|(_, v)| !v.done).map(|(k, v)| (*k, v)).collect();
        let overdue = |v: &Task| v.due.map_or(false, |d| d < today);
        match c {
            "list" => {
                if open.is_empty() {
                    out.push_str("no open tasks\n");
                    continue;
                }
                open.sort_by_key(|(id, v)| (!overdue(v), v.p, v.due.unwrap_or(i64::MAX), *id));
                for (id, v) in open {
                    out.push_str(&format!(
                        "{} {} p{} {} {}\n",
                        if overdue(v) { "!" } else { "." },
                        id,
                        v.p,
                        v.due.map_or("-".to_string(), from_days),
                        v.title
                    ));
                }
            }
            "summary" => {
                let done = tasks.values().filter(|v| v.done).count();
                let cnt = |f: &dyn Fn(Option<i64>) -> bool| open.iter().filter(|(_, v)| f(v.due)).count();
                out.push_str(&format!(
                    "open={} done={} overdue={} today={} upcoming={} nodue={}\n",
                    open.len(),
                    done,
                    cnt(&|d| d.map_or(false, |d| d < today)),
                    cnt(&|d| d == Some(today)),
                    cnt(&|d| d.map_or(false, |d| d > today)),
                    cnt(&|d| d.is_none())
                ));
                let fut: Vec<i64> = open.iter().filter_map(|(_, v)| v.due).filter(|d| *d >= today).collect();
                match fut.iter().min() {
                    None => out.push_str("next: none\n"),
                    Some(m) => out.push_str(&format!("next: {} x{}\n", from_days(*m), fut.iter().filter(|d| *d == m).count())),
                }
            }
            _ => {
                let days: i64 = if is_digits(t[2]) { t[2].parse().unwrap_or(0) } else { 0 };
                if days < 1 || days > 60 {
                    out.push_str("error: bad days\n");
                    continue;
                }
                open.sort_by_key(|(id, v)| (v.p, *id));
                for i in 0..days {
                    let ids: Vec<String> = open.iter().filter(|(_, v)| v.due == Some(today + i)).map(|(id, _)| id.to_string()).collect();
                    out.push_str(&format!("{}: {}\n", from_days(today + i), if ids.is_empty() { "-".to_string() } else { ids.join(",") }));
                }
            }
        }
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
