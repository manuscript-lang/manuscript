import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

# due is days since 1970-01-01, or -1 when the task has no due date.
type Task:
    id: Int
    p: Int
    due: Int
    title: String
    done: Bool
    alive: Bool

type Todo:
    tasks: List[Task]
    out: StringBuilder

fn fields(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").unwrap()
    return spaced.split(" ").filter(fn(part: String) -> Bool:
        return not part.is_empty()
    )

fn all_digits(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn emit(todo: Todo, text: String) -> Unit:
    todo.out.append(text)
    todo.out.append("\n")

fn pad(n: Int, width: Int) -> String:
    return "{n}".pad_start(target_length: width, padding: "0").unwrap()

fn to_days(year: Int, m: Int, d: Int) -> Int:
    var y = year
    if m <= 2:
        y = y - 1
    let era = y / 400
    let yoe = y - era * 400
    var mm = m - 3
    if m <= 2:
        mm = m + 9
    let doy = (153 * mm + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468

fn from_days(days: Int) -> String:
    let z = days + 719468
    let era = z / 146097
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy + 2) / 153
    let d = doy - (153 * mp + 2) / 5 + 1
    var m = mp + 3
    if mp >= 10:
        m = mp - 9
    var y = yoe + era * 400
    if m <= 2:
        y = y + 1
    return "{pad(y, 4)}-{pad(m, 2)}-{pad(d, 2)}"

# Returns days since the epoch, or -1 for an invalid date.
fn parse_date(s: String) -> Int:
    if s.length() != 10 or s.at(4).unwrap() != "-" or s.at(7).unwrap() != "-":
        return -1
    let ys = s.slice(0, 4)
    let ms = s.slice(5, 7)
    let ds = s.slice(8, 10)
    if not all_digits(ys) or not all_digits(ms) or not all_digits(ds):
        return -1
    let y = ys.parse_int().unwrap()
    let m = ms.parse_int().unwrap()
    let d = ds.parse_int().unwrap()
    if y < 1970 or y > 2100 or m < 1 or m > 12 or d < 1:
        return -1
    let leap = (y % 4 == 0 and y % 100 != 0) or y % 400 == 0
    let lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    var dim = lengths.at(m - 1).unwrap()
    if m == 2 and leap:
        dim = 29
    if d > dim:
        return -1
    return to_days(y, m, d)

fn is_prio(s: String) -> Bool:
    return s == "1" or s == "2" or s == "3"

fn find_task(todo: Todo, token: String) -> Optional[Task]:
    if not all_digits(token):
        return none
    let id = token.parse_int().unwrap_or(-1)
    for tk in todo.tasks:
        if tk.id == id and tk.alive:
            return some(tk)
    return none

fn fits(c: String, n: Int) -> Bool:
    if c == "add":
        return n >= 4
    if c == "done" or c == "drop" or c == "list" or c == "summary":
        return n == 2
    if c == "prio" or c == "snooze" or c == "agenda":
        return n == 3
    return false

fn add(todo: Todo, t: List[String]) -> Unit:
    if not is_prio(t.at(1).unwrap()):
        return emit(todo, "error: bad priority")
    var due = -1
    if t.at(2).unwrap() != "-":
        due = parse_date(t.at(2).unwrap())
        if due < 0:
            return emit(todo, "error: bad date")
    let id = todo.tasks.length() + 1
    let title = t.slice(3, t.length()).join(" ")
    todo.tasks.append(Task(id: id, p: t.at(1).unwrap().parse_int().unwrap(), due: due, title: title, done: false, alive: true))
    emit(todo, "added {id}")

fn edit(todo: Todo, c: String, t: List[String]) -> Unit:
    let token = t.at(1).unwrap()
    let found = find_task(todo, token)
    if found.is_none():
        return emit(todo, "error: no such task {token}")
    let tk = found.unwrap()
    if c == "done":
        if tk.done:
            return emit(todo, "error: already done {token}")
        tk.done = true
        return emit(todo, "ok")
    if c == "drop":
        tk.alive = false
        return emit(todo, "ok")
    if c == "prio":
        if not is_prio(t.at(2).unwrap()):
            return emit(todo, "error: bad priority")
        tk.p = t.at(2).unwrap().parse_int().unwrap()
        return emit(todo, "ok")
    if not all_digits(t.at(2).unwrap()):
        return emit(todo, "error: bad days")
    if tk.done:
        return emit(todo, "error: already done {token}")
    if tk.due < 0:
        return emit(todo, "error: no due date {token}")
    tk.due = tk.due + t.at(2).unwrap().parse_int().unwrap()
    emit(todo, "ok {from_days(tk.due)}")

fn is_overdue(tk: Task, today: Int) -> Bool:
    return tk.due >= 0 and tk.due < today

fn due_key(tk: Task) -> Int:
    if tk.due < 0:
        return 1000000000
    return tk.due

fn list_open(todo: Todo, today: Int) -> Unit:
    let open = todo.tasks.filter(fn(tk: Task) -> Bool:
        return tk.alive and not tk.done
    )
    if open.is_empty():
        return emit(todo, "no open tasks")
    let sorted = open.sorted(compare: fn(a: Task, b: Task) -> Int:
        let oa = is_overdue(a, today)
        let ob = is_overdue(b, today)
        if oa != ob:
            if oa:
                return -1
            return 1
        if a.p != b.p:
            return a.p - b.p
        if due_key(a) != due_key(b):
            return due_key(a) - due_key(b)
        return a.id - b.id
    )
    for tk in sorted:
        var mark = "."
        if is_overdue(tk, today):
            mark = "!"
        var due = "-"
        if tk.due >= 0:
            due = from_days(tk.due)
        emit(todo, "{mark} {tk.id} p{tk.p} {due} {tk.title}")

fn summary(todo: Todo, today: Int) -> Unit:
    var open = 0
    var finished = 0
    var overdue = 0
    var due_today = 0
    var upcoming = 0
    var no_due = 0
    var best = -1
    var best_n = 0
    for tk in todo.tasks:
        if not tk.alive:
            continue
        if tk.done:
            finished = finished + 1
            continue
        open = open + 1
        if tk.due < 0:
            no_due = no_due + 1
            continue
        if tk.due < today:
            overdue = overdue + 1
            continue
        if tk.due == today:
            due_today = due_today + 1
        else:
            upcoming = upcoming + 1
        if best < 0 or tk.due < best:
            best = tk.due
            best_n = 1
        else if tk.due == best:
            best_n = best_n + 1
    emit(todo, "open={open} done={finished} overdue={overdue} today={due_today} upcoming={upcoming} nodue={no_due}")
    if best < 0:
        emit(todo, "next: none")
    else:
        emit(todo, "next: {from_days(best)} x{best_n}")

fn agenda(todo: Todo, today: Int, days_text: String) -> Unit:
    var days = 0
    if all_digits(days_text):
        days = days_text.parse_int().unwrap_or(0)
    if days < 1 or days > 60:
        return emit(todo, "error: bad days")
    let open = todo.tasks.filter(fn(tk: Task) -> Bool:
        return tk.alive and not tk.done
    ).sorted(compare: fn(a: Task, b: Task) -> Int:
        if a.p != b.p:
            return a.p - b.p
        return a.id - b.id
    )
    var i = 0
    while i < days:
        let ids = List[String]()
        for tk in open:
            if tk.due == today + i:
                ids.append("{tk.id}")
        var text = "-"
        if not ids.is_empty():
            text = ids.join(",")
        emit(todo, "{from_days(today + i)}: {text}")
        i = i + 1

fn step(todo: Todo, t: List[String]) -> Unit:
    let c = t.at(0).unwrap()
    if not fits(c, t.length()):
        return emit(todo, "error: bad command")
    if c == "add":
        return add(todo, t)
    if c == "done" or c == "drop" or c == "prio" or c == "snooze":
        return edit(todo, c, t)
    let today = parse_date(t.at(1).unwrap())
    if today < 0:
        return emit(todo, "error: bad date")
    if c == "list":
        return list_open(todo, today)
    if c == "summary":
        return summary(todo, today)
    agenda(todo, today, t.at(2).unwrap())

fn run() -> Result[Unit, Error]:
    let todo = Todo(tasks: List[Task](), out: StringBuilder())
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let t = fields(next.unwrap())
        if t.is_empty():
            continue
        step(todo, t)
    try stdout().write(todo.out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
