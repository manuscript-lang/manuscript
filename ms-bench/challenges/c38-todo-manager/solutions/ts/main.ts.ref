import { readFileSync } from "node:fs";

type Task = { p: number; due: number | null; title: string; done: boolean };

// Days since 1970-01-01 for a proleptic Gregorian date (Howard Hinnant's algorithm).
function toDays(y: number, m: number, d: number): number {
  y -= m <= 2 ? 1 : 0;
  const era = Math.floor(y / 400);
  const yoe = y - era * 400;
  const doy = Math.floor((153 * (m + (m > 2 ? -3 : 9)) + 2) / 5) + d - 1;
  const doe = yoe * 365 + Math.floor(yoe / 4) - Math.floor(yoe / 100) + doy;
  return era * 146097 + doe - 719468;
}
function fromDays(z: number): string {
  z += 719468;
  const era = Math.floor(z / 146097);
  const doe = z - era * 146097;
  const yoe = Math.floor((doe - Math.floor(doe / 1460) + Math.floor(doe / 36524) - Math.floor(doe / 146096)) / 365);
  const doy = doe - (365 * yoe + Math.floor(yoe / 4) - Math.floor(yoe / 100));
  const mp = Math.floor((5 * doy + 2) / 153);
  const d = doy - Math.floor((153 * mp + 2) / 5) + 1;
  const m = mp < 10 ? mp + 3 : mp - 9;
  const y = yoe + era * 400 + (m <= 2 ? 1 : 0);
  const pad = (n: number, w: number) => String(n).padStart(w, "0");
  return `${pad(y, 4)}-${pad(m, 2)}-${pad(d, 2)}`;
}
function parseDate(s: string): number | null {
  const m = /^([0-9]{4})-([0-9]{2})-([0-9]{2})$/.exec(s);
  if (!m) return null;
  const y = +m[1], mo = +m[2], d = +m[3];
  if (y < 1970 || y > 2100 || mo < 1 || mo > 12 || d < 1) return null;
  const leap = (y % 4 === 0 && y % 100 !== 0) || y % 400 === 0;
  const dim = [31, leap ? 29 : 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31][mo - 1];
  return d > dim ? null : toDays(y, mo, d);
}

const tasks = new Map<number, Task>();
let nextId = 1;
const out: string[] = [];
const isPrio = (s: string) => s === "1" || s === "2" || s === "3";
const isDigits = (s: string) => /^[0-9]+$/.test(s);

for (const line of readFileSync(0, "utf8").split("\n")) {
  const t = line.split(/[ \t]+/).filter((x) => x !== "");
  if (t.length === 0) continue;
  const c = t[0];
  const n = t.length;
  const fits: Record<string, boolean> = {
    add: n >= 4, done: n === 2, drop: n === 2, prio: n === 3, snooze: n === 3, list: n === 2, summary: n === 2, agenda: n === 3,
  };
  if (!fits[c]) {
    out.push("error: bad command");
    continue;
  }
  if (c === "add") {
    if (!isPrio(t[1])) out.push("error: bad priority");
    else {
      let due: number | null = null;
      if (t[2] !== "-") due = parseDate(t[2]);
      if (t[2] !== "-" && due === null) out.push("error: bad date");
      else {
        tasks.set(nextId, { p: +t[1], due, title: t.slice(3).join(" "), done: false });
        out.push(`added ${nextId++}`);
      }
    }
    continue;
  }
  if (c === "done" || c === "drop" || c === "prio" || c === "snooze") {
    const k = isDigits(t[1]) ? parseInt(t[1], 10) : -1;
    const tk = tasks.get(k);
    if (!tk) out.push(`error: no such task ${t[1]}`);
    else if (c === "done") {
      if (tk.done) out.push(`error: already done ${t[1]}`);
      else {
        tk.done = true;
        out.push("ok");
      }
    } else if (c === "drop") {
      tasks.delete(k);
      out.push("ok");
    } else if (c === "prio") {
      if (!isPrio(t[2])) out.push("error: bad priority");
      else {
        tk.p = +t[2];
        out.push("ok");
      }
    } else if (!isDigits(t[2])) out.push("error: bad days");
    else if (tk.done) out.push(`error: already done ${t[1]}`);
    else if (tk.due === null) out.push(`error: no due date ${t[1]}`);
    else {
      tk.due += parseInt(t[2], 10);
      out.push(`ok ${fromDays(tk.due)}`);
    }
    continue;
  }
  const today = parseDate(t[1]);
  if (today === null) {
    out.push("error: bad date");
    continue;
  }
  const open = [...tasks.entries()].filter(([, v]) => !v.done);
  if (c === "list") {
    if (open.length === 0) {
      out.push("no open tasks");
      continue;
    }
    const overdue = (v: Task) => v.due !== null && v.due < today;
    open.sort(([ia, a], [ib, b]) => {
      const oa = overdue(a) ? 0 : 1, ob = overdue(b) ? 0 : 1;
      if (oa !== ob) return oa - ob;
      if (a.p !== b.p) return a.p - b.p;
      const da = a.due ?? Infinity, db = b.due ?? Infinity;
      if (da !== db) return da < db ? -1 : 1;
      return ia - ib;
    });
    for (const [id, v] of open) {
      out.push(`${overdue(v) ? "!" : "."} ${id} p${v.p} ${v.due === null ? "-" : fromDays(v.due)} ${v.title}`);
    }
  } else if (c === "summary") {
    const done = [...tasks.values()].filter((v) => v.done).length;
    const dues = open.map(([, v]) => v.due);
    const cnt = (f: (d: number | null) => boolean) => dues.filter(f).length;
    out.push(
      `open=${open.length} done=${done} overdue=${cnt((d) => d !== null && d < today)} today=${cnt((d) => d === today)} upcoming=${cnt((d) => d !== null && d > today)} nodue=${cnt((d) => d === null)}`,
    );
    const fut = dues.filter((d): d is number => d !== null && d >= today);
    if (fut.length === 0) out.push("next: none");
    else {
      const m = Math.min(...fut);
      out.push(`next: ${fromDays(m)} x${fut.filter((d) => d === m).length}`);
    }
  } else {
    const days = isDigits(t[2]) ? parseInt(t[2], 10) : 0;
    if (days < 1 || days > 60) {
      out.push("error: bad days");
      continue;
    }
    const sorted = [...open].sort(([ia, a], [ib, b]) => a.p - b.p || ia - ib);
    for (let i = 0; i < days; i++) {
      const ids = sorted.filter(([, v]) => v.due === today + i).map(([id]) => id);
      out.push(`${fromDays(today + i)}: ${ids.length ? ids.join(",") : "-"}`);
    }
  }
}
process.stdout.write(out.map((l) => l + "\n").join(""));
