import {stdin, stdout, read_line} from "@std/io.ms"

# Returns "ok" or "error N" for one line of text.
fn check(line: String) -> String:
    let kinds = List[Int]()
    let positions = List[Int]()
    var index = 0
    for c in line.scalar_values():
        index = index + 1
        # opener codes: ( 40, [ 91, { 123; closer codes: ) 41, ] 93, } 125
        if c == 40 or c == 91 or c == 123:
            kinds.append(c)
            positions.append(index)
        else:
            var want = 0
            if c == 41:
                want = 40
            else if c == 93:
                want = 91
            else if c == 125:
                want = 123
            if want != 0:
                let depth = kinds.length()
                if depth == 0 or kinds.at(depth - 1).unwrap() != want:
                    return "error {index}"
                kinds.remove(depth - 1)
                positions.remove(depth - 1)
    if kinds.length() > 0:
        return "error {positions.at(0).unwrap()}"
    return "ok"

fn run() -> Result[Unit, Error]:
    while true:
        let line = try read_line(input: stdin(), max_bytes: 1048576)
        if line.is_none():
            break
        try stdout().write("{check(line.unwrap())}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
