package main

import (
	"bufio"
	"math/big"
	"os"
	"strings"
)

func digitsOnly(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return false
		}
	}
	return true
}

func solveLine(line string) string {
	t := strings.Split(line, " ")
	if len(t) != 3 || (t[0] != "add" && t[0] != "sub" && t[0] != "mul") {
		return "error: bad command"
	}
	if !digitsOnly(t[1]) || !digitsOnly(t[2]) {
		return "error: bad number"
	}
	a, _ := new(big.Int).SetString(t[1], 10)
	b, _ := new(big.Int).SetString(t[2], 10)
	r := new(big.Int)
	switch t[0] {
	case "add":
		r.Add(a, b)
	case "sub":
		r.Sub(a, b)
	default:
		r.Mul(a, b)
	}
	return r.String()
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	for sc.Scan() {
		l := sc.Text()
		if strings.Trim(l, " ") == "" {
			continue
		}
		w.WriteString(solveLine(l) + "\n")
	}
}
