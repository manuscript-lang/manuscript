import {stdin, stdout, read_line} from "@std/io.ms"
import {parse, BigInt} from "@std/bigint.ms"

fn digits_only(s: String) -> Bool:
    if s.is_empty():
        return false
    for c in s.scalar_values():
        if c < 48 or c > 57:
            return false
    return true

fn solve_line(line: String) -> String:
    let t = line.split(" ")
    let op = t.at(0).unwrap()
    if t.length() != 3 or (op != "add" and op != "sub" and op != "mul"):
        return "error: bad command"
    if not digits_only(t.at(1).unwrap()) or not digits_only(t.at(2).unwrap()):
        return "error: bad number"
    let a = parse(t.at(1).unwrap(), 10).unwrap()
    let b = parse(t.at(2).unwrap(), 10).unwrap()
    if op == "add":
        return a.add(b).to_string(10)
    if op == "sub":
        return a.subtract(b).to_string(10)
    return a.multiply(b).to_string(10)

fn run() -> Result[Unit, Error]:
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let line = next.unwrap()
        if line.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        try stdout().write("{solve_line(line)}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
