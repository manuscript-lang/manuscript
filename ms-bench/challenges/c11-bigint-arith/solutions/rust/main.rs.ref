use std::cmp::Ordering;
use std::io::{BufRead, Write};

// Magnitudes are little-endian base-10 digit vectors without trailing (high) zeros.
fn parse(s: &str) -> Vec<u8> {
    let mut v: Vec<u8> = s.bytes().rev().map(|b| b - b'0').collect();
    trim(&mut v);
    v
}

fn trim(v: &mut Vec<u8>) {
    while v.last() == Some(&0) {
        v.pop();
    }
}

fn cmp(a: &[u8], b: &[u8]) -> Ordering {
    if a.len() != b.len() {
        return a.len().cmp(&b.len());
    }
    for i in (0..a.len()).rev() {
        if a[i] != b[i] {
            return a[i].cmp(&b[i]);
        }
    }
    Ordering::Equal
}

fn add(a: &[u8], b: &[u8]) -> Vec<u8> {
    let mut out = Vec::new();
    let mut carry = 0u8;
    for i in 0..a.len().max(b.len()) {
        let s = a.get(i).copied().unwrap_or(0) + b.get(i).copied().unwrap_or(0) + carry;
        out.push(s % 10);
        carry = s / 10;
    }
    if carry > 0 {
        out.push(carry);
    }
    out
}

// Requires a >= b.
fn sub(a: &[u8], b: &[u8]) -> Vec<u8> {
    let mut out = Vec::new();
    let mut borrow = 0i8;
    for i in 0..a.len() {
        let mut d = a[i] as i8 - b.get(i).copied().unwrap_or(0) as i8 - borrow;
        borrow = 0;
        if d < 0 {
            d += 10;
            borrow = 1;
        }
        out.push(d as u8);
    }
    trim(&mut out);
    out
}

fn mul(a: &[u8], b: &[u8]) -> Vec<u8> {
    let mut acc = vec![0u32; a.len() + b.len() + 1];
    for (i, &x) in a.iter().enumerate() {
        for (j, &y) in b.iter().enumerate() {
            acc[i + j] += x as u32 * y as u32;
        }
    }
    let mut out = Vec::new();
    let mut carry = 0u32;
    for v in acc {
        let t = v + carry;
        out.push((t % 10) as u8);
        carry = t / 10;
    }
    trim(&mut out);
    out
}

fn render(neg: bool, v: &[u8]) -> String {
    if v.is_empty() {
        return "0".into();
    }
    let s: String = v.iter().rev().map(|d| (d + b'0') as char).collect();
    if neg { format!("-{}", s) } else { s }
}

fn solve_line(line: &str) -> String {
    let t: Vec<&str> = line.split(' ').collect();
    if t.len() != 3 || !["add", "sub", "mul"].contains(&t[0]) {
        return "error: bad command".into();
    }
    let ok = |s: &str| !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit());
    if !ok(t[1]) || !ok(t[2]) {
        return "error: bad number".into();
    }
    let (a, b) = (parse(t[1]), parse(t[2]));
    match t[0] {
        "add" => render(false, &add(&a, &b)),
        "mul" => render(false, &mul(&a, &b)),
        _ => match cmp(&a, &b) {
            Ordering::Less => render(true, &sub(&b, &a)),
            _ => render(false, &sub(&a, &b)),
        },
    }
}

fn main() {
    let stdin = std::io::stdin();
    let mut out = String::new();
    for line in stdin.lock().lines() {
        let line = line.unwrap();
        if line.trim_matches(' ').is_empty() {
            continue;
        }
        out.push_str(&solve_line(&line));
        out.push('\n');
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
