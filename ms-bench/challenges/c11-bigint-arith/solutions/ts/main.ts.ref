import { readFileSync } from "node:fs";

function solveLine(line: string): string {
  const t = line.split(" ");
  if (t.length !== 3 || !["add", "sub", "mul"].includes(t[0])) return "error: bad command";
  if (!/^[0-9]+$/.test(t[1]) || !/^[0-9]+$/.test(t[2])) return "error: bad number";
  const a = BigInt(t[1]);
  const b = BigInt(t[2]);
  return String(t[0] === "add" ? a + b : t[0] === "sub" ? a - b : a * b);
}

const lines = readFileSync(0, "utf8").split("\n");
if (lines[lines.length - 1] === "") lines.pop();
let out = "";
for (const l of lines) if (l.replace(/ /g, "") !== "") out += solveLine(l) + "\n";
process.stdout.write(out);
