import {stdin, stdout, read_line} from "@std/io.ms"
import Set from "@std/collections.ms"

type Booking:
    id: String
    room: String
    date: String
    st: String
    en: String
    a: Int
    b: Int
    n: Int
    act: Bool

fn is_digit(c: Int) -> Bool:
    return c >= 48 and c <= 57

fn is_lower(c: Int) -> Bool:
    return c >= 97 and c <= 122

# Value of codes[lo..hi) when all are digits, else -1.
fn digits(codes: List[Int], lo: Int, hi: Int) -> Int:
    var n = 0
    var i = lo
    while i < hi:
        let c = codes.at(i).unwrap()
        if not is_digit(c):
            return -1
        n = n * 10 + (c - 48)
        i = i + 1
    return n

# 1 to 6 digits, else -1.
fn number(s: String) -> Int:
    let c = s.scalar_values()
    if c.length() < 1 or c.length() > 6:
        return -1
    return digits(c, 0, c.length())

fn is_leap(y: Int) -> Bool:
    return (y % 4 == 0 and y % 100 != 0) or y % 400 == 0

fn days_in_month(y: Int, m: Int) -> Int:
    if m == 2:
        if is_leap(y):
            return 29
        return 28
    if m == 4 or m == 6 or m == 9 or m == 11:
        return 30
    return 31

fn valid_date(s: String) -> Bool:
    let c = s.scalar_values()
    if c.length() != 10 or c.at(4).unwrap() != 45 or c.at(7).unwrap() != 45:
        return false
    let y = digits(c, 0, 4)
    let m = digits(c, 5, 7)
    let d = digits(c, 8, 10)
    if y < 2000 or y > 2099 or m < 1 or m > 12 or d < 1:
        return false
    return d <= days_in_month(y, m)

# Minutes since midnight, or -1.
fn hm(s: String) -> Int:
    let c = s.scalar_values()
    if c.length() != 5 or c.at(2).unwrap() != 58:
        return -1
    let h = digits(c, 0, 2)
    let m = digits(c, 3, 5)
    if h < 0 or m < 0 or h > 23 or m > 59:
        return -1
    return h * 60 + m

fn valid_room_name(s: String) -> Bool:
    let c = s.scalar_values()
    if c.length() < 1 or c.length() > 10 or not is_lower(c.at(0).unwrap()):
        return false
    for x in c:
        if not is_lower(x) and not is_digit(x):
            return false
    return true

fn valid_id(s: String) -> Bool:
    let c = s.scalar_values()
    if c.is_empty():
        return false
    for x in c:
        if not is_lower(x) and not is_digit(x) and x != 45:
            return false
    return true

fn report(rooms: Map[String, Int], order: List[Booking]) -> List[String]:
    let out = List[String]()
    let names = rooms.keys().sorted(compare: fn(left: String, right: String) -> Int:
        return left.compare(right)
    )
    for name in names:
        let bs = List[Booking]()
        for k in order:
            if k.room == name and k.act:
                bs.append(k)
        let sorted_bs = bs.sorted(compare: fn(left: Booking, right: Booking) -> Int:
            let by_date = left.date.compare(right.date)
            if by_date != 0:
                return by_date
            if left.a != right.a:
                return left.a - right.a
            return left.id.compare(right.id)
        )
        var mins = 0
        let dates = Set[String]()
        for k in sorted_bs:
            mins = mins + k.b - k.a
            dates.add(k.date)
        let days = dates.length()
        var util = 0
        if days > 0:
            util = (mins * 200 + 720 * days) / (1440 * days)
        out.append("{name} cap={rooms.get(name).unwrap()} active={sorted_bs.length()} minutes={mins} util={util}%")
        for k in sorted_bs:
            out.append("  {k.date} {k.st}-{k.en} {k.id} attendees={k.n}")
    var act = 0
    for k in order:
        if k.act:
            act = act + 1
    out.append("bookings active={act} cancelled={order.length() - act}")
    return out

fn try_book(rooms: Map[String, Int], order: List[Booking], t: List[String]) -> String:
    let id = t.at(1).unwrap()
    let r = t.at(2).unwrap()
    let d = t.at(3).unwrap()
    let a = hm(t.at(4).unwrap())
    let b = hm(t.at(5).unwrap())
    let n = number(t.at(6).unwrap())
    if not rooms.contains(r):
        return "error: unknown room"
    if not valid_date(d):
        return "error: bad date"
    if a < 0 or b < 0:
        return "error: bad time"
    if b <= a:
        return "error: bad range"
    if a % 15 != 0 or b % 15 != 0:
        return "error: not aligned"
    if a < 480 or b > 1200:
        return "error: outside hours"
    if b - a > 240:
        return "error: too long"
    if n < 1:
        return "error: bad attendees"
    if n > rooms.get(r).unwrap():
        return "error: over capacity"
    for k in order:
        if k.act and k.room == r and k.date == d and a < k.b and k.a < b:
            return "error: conflict with {k.id}"
    order.append(Booking(id: id, room: r, date: d, st: t.at(4).unwrap(), en: t.at(5).unwrap(), a: a, b: b, n: n, act: true))
    return "ok {id}"

fn run_command(rooms: Map[String, Int], used: Set[String], order: List[Booking], index: Map[String, Booking], t: List[String]) -> List[String]:
    let c = t.at(0).unwrap()
    if c == "room":
        if t.length() != 3:
            return ["error: usage"]
        if not valid_room_name(t.at(1).unwrap()):
            return ["error: bad room name"]
        let cap = number(t.at(2).unwrap())
        if cap < 1 or cap > 500:
            return ["error: bad capacity"]
        if rooms.contains(t.at(1).unwrap()):
            return ["error: room exists"]
        rooms.add(key: t.at(1).unwrap(), value: cap)
        return ["ok"]
    if c == "book":
        if t.length() != 7:
            return ["error: usage"]
        let id = t.at(1).unwrap()
        if not valid_id(id):
            return ["error: bad id"]
        if used.contains(id):
            return ["error: duplicate id"]
        used.add(id)
        let before = order.length()
        let msg = try_book(rooms, order, t)
        if order.length() > before:
            index.add(key: id, value: order.at(before).unwrap())
        return [msg]
    if c == "cancel":
        if t.length() != 2:
            return ["error: usage"]
        let found = index.get(t.at(1).unwrap())
        if found.is_none():
            return ["error: unknown booking"]
        let k = found.unwrap()
        if not k.act:
            return ["error: already cancelled"]
        k.act = false
        return ["ok"]
    if c == "report":
        if t.length() != 1:
            return ["error: usage"]
        return report(rooms, order)
    return ["error: unknown command"]

fn run() -> Result[Unit, Error]:
    let rooms = Map[String, Int]()
    let used = Set[String]()
    let order = List[Booking]()
    let index = Map[String, Booking]()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let l = next.unwrap()
        if l.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        for s in run_command(rooms, used, order, index, l.split(" ")):
            try stdout().write("{s}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
