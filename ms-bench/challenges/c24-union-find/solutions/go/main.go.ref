package main

import (
	"bufio"
	"fmt"
	"io"
	"os"
	"strconv"
	"strings"
)

var parent, size []int

func find(x int) int {
	for parent[x] != x {
		parent[x] = parent[parent[x]]
		x = parent[x]
	}
	return x
}

func main() {
	data, _ := io.ReadAll(os.Stdin)
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	var lines []string
	for _, l := range strings.Split(string(data), "\n") {
		if strings.TrimSpace(l) != "" {
			lines = append(lines, l)
		}
	}
	n, _ := strconv.Atoi(lines[0])
	parent = make([]int, n)
	size = make([]int, n)
	for i := range parent {
		parent[i] = i
		size[i] = 1
	}
	sets := n
	for _, line := range lines[1:] {
		p := strings.Split(line, " ")
		if p[0] == "count" {
			fmt.Fprintln(out, sets)
			continue
		}
		var args []int
		bad := false
		for _, a := range p[1:] {
			v, _ := strconv.Atoi(a)
			if v < 0 || v >= n {
				bad = true
			}
			args = append(args, v)
		}
		if bad {
			fmt.Fprintln(out, "error")
			continue
		}
		switch p[0] {
		case "size":
			fmt.Fprintln(out, size[find(args[0])])
		case "connected":
			if find(args[0]) == find(args[1]) {
				fmt.Fprintln(out, "yes")
			} else {
				fmt.Fprintln(out, "no")
			}
		case "union":
			a, b := find(args[0]), find(args[1])
			if a == b {
				fmt.Fprintln(out, "same")
			} else {
				parent[a] = b
				size[b] += size[a]
				sets--
				fmt.Fprintln(out, "merged")
			}
		}
	}
}
