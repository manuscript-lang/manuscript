import {stdin, stdout, read_all} from "@std/io.ms"

# Finds the set representative, halving the path as it climbs.
fn find(parent: List[Int], start: Int) -> Int:
    var x = start
    while parent.at(x).unwrap() != x:
        let grand = parent.at(parent.at(x).unwrap()).unwrap()
        parent.set(x, grand)
        x = grand
    return x

fn run() -> Result[Unit, Error]:
    let data = try read_all(input: stdin())
    let text = data.to_text().unwrap_or("")
    let lines = List[String]()
    for line in text.split("\n"):
        if not line.trim().is_empty():
            lines.append(line)
    let out = List[String]()
    if lines.is_empty():
        return stdout().flush()
    let n = lines.at(0).unwrap().trim().parse_int().unwrap()
    let parent = List[Int]()
    let size = List[Int]()
    var i = 0
    while i < n:
        parent.append(i)
        size.append(1)
        i = i + 1
    var sets = n
    var k = 1
    while k < lines.length():
        let p = lines.at(k).unwrap().split(" ")
        k = k + 1
        let cmd = p.at(0).unwrap()
        if cmd == "count":
            out.append("{sets}")
            continue
        var bad = false
        let args = List[Int]()
        var j = 1
        while j < p.length():
            let v = p.at(j).unwrap().parse_int().unwrap()
            if v < 0 or v >= n:
                bad = true
            args.append(v)
            j = j + 1
        if bad:
            out.append("error")
        else if cmd == "size":
            out.append("{size.at(find(parent, args.at(0).unwrap())).unwrap()}")
        else if cmd == "connected":
            if find(parent, args.at(0).unwrap()) == find(parent, args.at(1).unwrap()):
                out.append("yes")
            else:
                out.append("no")
        else if cmd == "union":
            let a = find(parent, args.at(0).unwrap())
            let b = find(parent, args.at(1).unwrap())
            if a == b:
                out.append("same")
            else:
                parent.set(a, b)
                size.set(b, size.at(b).unwrap() + size.at(a).unwrap())
                sets = sets - 1
                out.append("merged")
    if not out.is_empty():
        try stdout().write("{out.join("\n")}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
