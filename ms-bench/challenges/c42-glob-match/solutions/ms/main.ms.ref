import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Atom:
    kind: Int
    c: Int
    neg: Bool
    lo: List[Int]
    hi: List[Int]

type Cursor:
    p: List[Int]
    i: Int

fn fields(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").unwrap()
    return spaced.split(" ").filter(fn(part: String) -> Bool:
        return not part.is_empty()
    )

fn simple(kind: Int, c: Int) -> Atom:
    return Atom(kind: kind, c: c, neg: false, lo: List[Int](), hi: List[Int]())

# Reads one class character, honoring a backslash escape.
fn next_char(cur: Cursor) -> Result[Int, String]:
    if cur.i >= cur.p.length():
        return error("bad")
    let c = cur.p.at(cur.i).unwrap()
    if c == 92:
        if cur.i + 1 >= cur.p.length():
            return error("bad")
        let d = cur.p.at(cur.i + 1).unwrap()
        cur.i = cur.i + 2
        return ok(d)
    cur.i = cur.i + 1
    return ok(c)

# cur.i is just after the opening bracket.
fn parse_class(cur: Cursor) -> Result[Atom, String]:
    var neg = false
    if cur.i < cur.p.length() and cur.p.at(cur.i).unwrap() == 33:
        neg = true
        cur.i = cur.i + 1
    let lo = List[Int]()
    let hi = List[Int]()
    while true:
        if cur.i >= cur.p.length():
            return error("bad")
        if cur.p.at(cur.i).unwrap() == 93:
            if lo.is_empty():
                return error("bad")
            cur.i = cur.i + 1
            return ok(Atom(kind: 3, c: 0, neg: neg, lo: lo, hi: hi))
        let c = try next_char(cur)
        if cur.i + 1 < cur.p.length() and cur.p.at(cur.i).unwrap() == 45 and cur.p.at(cur.i + 1).unwrap() != 93:
            cur.i = cur.i + 1
            let d = try next_char(cur)
            if d < c:
                return error("bad")
            lo.append(c)
            hi.append(d)
        else:
            lo.append(c)
            hi.append(c)
    return error("bad")

fn parse(p: List[Int]) -> Result[List[List[List[Atom]]], String]:
    let cur = Cursor(p: p, i: 0)
    let elems = List[List[List[Atom]]]()
    var run = List[Atom]()
    while cur.i < p.length():
        let ch = p.at(cur.i).unwrap()
        if ch == 92:
            if cur.i + 1 >= p.length():
                return error("bad")
            run.append(simple(0, p.at(cur.i + 1).unwrap()))
            cur.i = cur.i + 2
        else if ch == 63:
            run.append(simple(1, 0))
            cur.i = cur.i + 1
        else if ch == 42:
            run.append(simple(2, 0))
            cur.i = cur.i + 1
        else if ch == 91:
            cur.i = cur.i + 1
            run.append(try parse_class(cur))
        else if ch == 125:
            return error("bad")
        else if ch == 123:
            if not run.is_empty():
                elems.append([run])
                run = List[Atom]()
            cur.i = cur.i + 1
            let alts = List[List[Atom]]()
            var alt = List[Atom]()
            var closed = false
            while not closed:
                if cur.i >= p.length():
                    return error("bad")
                let c = p.at(cur.i).unwrap()
                if c == 125:
                    alts.append(alt)
                    cur.i = cur.i + 1
                    closed = true
                else if c == 123:
                    return error("bad")
                else if c == 44:
                    alts.append(alt)
                    alt = List[Atom]()
                    cur.i = cur.i + 1
                else if c == 92:
                    if cur.i + 1 >= p.length():
                        return error("bad")
                    alt.append(simple(0, p.at(cur.i + 1).unwrap()))
                    cur.i = cur.i + 2
                else if c == 63:
                    alt.append(simple(1, 0))
                    cur.i = cur.i + 1
                else if c == 42:
                    alt.append(simple(2, 0))
                    cur.i = cur.i + 1
                else if c == 91:
                    cur.i = cur.i + 1
                    alt.append(try parse_class(cur))
                else:
                    alt.append(simple(0, c))
                    cur.i = cur.i + 1
            elems.append(alts)
        else:
            run.append(simple(0, ch))
            cur.i = cur.i + 1
    if not run.is_empty():
        elems.append([run])
    return ok(elems)

fn expansions(elems: List[List[List[Atom]]]) -> List[List[Atom]]:
    var acc = [List[Atom]()]
    for alts in elems:
        let next = List[List[Atom]]()
        for pre in acc:
            for alt in alts:
                let e = pre.clone()
                for a in alt:
                    e.append(a)
                next.append(e)
        acc = next
    return acc

fn split_atoms(atoms: List[Atom]) -> List[List[Atom]]:
    let segs = List[List[Atom]]()
    var cur = List[Atom]()
    for a in atoms:
        if a.kind == 0 and a.c == 47:
            segs.append(cur)
            cur = List[Atom]()
        else:
            cur.append(a)
    segs.append(cur)
    return segs

fn atom_ok(a: Atom, c: Int) -> Bool:
    if a.kind == 0:
        return c == a.c
    if a.kind == 1:
        return true
    var inside = false
    var k = 0
    while k < a.lo.length():
        if a.lo.at(k).unwrap() <= c and c <= a.hi.at(k).unwrap():
            inside = true
            break
        k = k + 1
    return inside != a.neg

fn seg_match(atoms: List[Atom], s: List[Int]) -> Bool:
    let m = s.length()
    if m > 0 and s.at(0).unwrap() == 46:
        if atoms.is_empty():
            return false
        let first = atoms.at(0).unwrap()
        if first.kind != 0 or first.c != 46:
            return false
    var cur = List[Bool]()
    var j = 0
    while j <= m:
        cur.append(j == 0)
        j = j + 1
    for a in atoms:
        let nxt = List[Bool]()
        if a.kind == 2:
            var run = false
            var q = 0
            while q <= m:
                run = run or cur.at(q).unwrap()
                nxt.append(run)
                q = q + 1
        else:
            nxt.append(false)
            var q = 0
            while q < m:
                if cur.at(q).unwrap() and atom_ok(a, s.at(q).unwrap()):
                    nxt.append(true)
                else:
                    nxt.append(false)
                q = q + 1
        cur = nxt
    return cur.at(m).unwrap()

fn is_globstar(a: List[Atom]) -> Bool:
    return a.length() == 2 and a.at(0).unwrap().kind == 2 and a.at(1).unwrap().kind == 2

type Matcher:
    ps: List[List[Atom]]
    xs: List[List[Int]]
    memo: List[Int]
    width: Int

fn rec(mt: Matcher, i: Int, j: Int) -> Bool:
    let key = i * mt.width + j
    let seen = mt.memo.at(key).unwrap()
    if seen >= 0:
        return seen == 1
    var r = false
    if i == mt.ps.length():
        r = j == mt.xs.length()
    else if is_globstar(mt.ps.at(i).unwrap()):
        r = rec(mt, i + 1, j)
        if not r and j < mt.xs.length():
            let x = mt.xs.at(j).unwrap()
            if x.is_empty() or x.at(0).unwrap() != 46:
                r = rec(mt, i, j + 1)
    else if j < mt.xs.length():
        r = seg_match(mt.ps.at(i).unwrap(), mt.xs.at(j).unwrap()) and rec(mt, i + 1, j + 1)
    if r:
        mt.memo.set(key, 1)
    else:
        mt.memo.set(key, 0)
    return r

fn match_segs(ps: List[List[Atom]], xs: List[List[Int]]) -> Bool:
    let width = xs.length() + 1
    var memo = List[Int]()
    var n = 0
    while n < (ps.length() + 1) * width:
        memo.append(-1)
        n = n + 1
    return rec(Matcher(ps: ps, xs: xs, memo: memo, width: width), 0, 0)

fn judge(pattern: String, path: String) -> String:
    match parse(pattern.scalar_values()):
        error(_):
            return "error: invalid pattern"
        ok(elems):
            let xs = path.split("/").map(fn(s: String) -> List[Int]:
                return s.scalar_values()
            )
            for e in expansions(elems):
                if match_segs(split_atoms(e), xs):
                    return "match"
            return "no match"

fn run() -> Result[Unit, Error]:
    let out = StringBuilder()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let t = fields(next.unwrap())
        if t.is_empty():
            continue
        if t.length() != 2:
            out.append("error: bad line\n")
        else:
            out.append(judge(t.at(0).unwrap(), t.at(1).unwrap()))
            out.append("\n")
    try stdout().write(out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
