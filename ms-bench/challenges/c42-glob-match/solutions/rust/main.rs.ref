use std::collections::HashMap;
use std::io::{self, Read, Write};

#[derive(Clone, Copy, PartialEq)]
enum Kind {
    Lit,
    Any,
    Star,
    Class,
}

#[derive(Clone)]
struct Atom {
    k: Kind,
    c: u8,
    neg: bool,
    items: Vec<(u8, u8)>,
}

fn atom(k: Kind, c: u8) -> Atom {
    Atom { k, c, neg: false, items: Vec::new() }
}

fn get(p: &[u8], j: usize) -> Option<(u8, usize)> {
    if j >= p.len() {
        return None;
    }
    if p[j] == b'\\' {
        if j + 1 >= p.len() {
            return None;
        }
        return Some((p[j + 1], j + 2));
    }
    Some((p[j], j + 1))
}

fn parse_class(p: &[u8], mut i: usize) -> Option<(Atom, usize)> {
    let mut neg = false;
    if i < p.len() && p[i] == b'!' {
        neg = true;
        i += 1;
    }
    let mut items = Vec::new();
    loop {
        if i >= p.len() {
            return None;
        }
        if p[i] == b']' {
            if items.is_empty() {
                return None;
            }
            return Some((Atom { k: Kind::Class, c: 0, neg, items }, i + 1));
        }
        let (c, j) = get(p, i)?;
        i = j;
        if i + 1 < p.len() && p[i] == b'-' && p[i + 1] != b']' {
            let (d, j) = get(p, i + 1)?;
            i = j;
            if d < c {
                return None;
            }
            items.push((c, d));
        } else {
            items.push((c, c));
        }
    }
}

fn parse(p: &[u8]) -> Option<Vec<Vec<Vec<Atom>>>> {
    let mut elems: Vec<Vec<Vec<Atom>>> = Vec::new();
    let mut cur: Vec<Atom> = Vec::new();
    let mut i = 0;
    while i < p.len() {
        let ch = p[i];
        match ch {
            b'\\' => {
                if i + 1 >= p.len() {
                    return None;
                }
                cur.push(atom(Kind::Lit, p[i + 1]));
                i += 2;
            }
            b'?' => {
                cur.push(atom(Kind::Any, 0));
                i += 1;
            }
            b'*' => {
                cur.push(atom(Kind::Star, 0));
                i += 1;
            }
            b'[' => {
                let (a, j) = parse_class(p, i + 1)?;
                cur.push(a);
                i = j;
            }
            b'}' => return None,
            b'{' => {
                if !cur.is_empty() {
                    elems.push(vec![std::mem::take(&mut cur)]);
                }
                i += 1;
                let mut alts: Vec<Vec<Atom>> = Vec::new();
                let mut alt: Vec<Atom> = Vec::new();
                loop {
                    if i >= p.len() {
                        return None;
                    }
                    let c = p[i];
                    match c {
                        b'}' => {
                            alts.push(std::mem::take(&mut alt));
                            i += 1;
                            break;
                        }
                        b'{' => return None,
                        b',' => {
                            alts.push(std::mem::take(&mut alt));
                            i += 1;
                        }
                        b'\\' => {
                            if i + 1 >= p.len() {
                                return None;
                            }
                            alt.push(atom(Kind::Lit, p[i + 1]));
                            i += 2;
                        }
                        b'?' => {
                            alt.push(atom(Kind::Any, 0));
                            i += 1;
                        }
                        b'*' => {
                            alt.push(atom(Kind::Star, 0));
                            i += 1;
                        }
                        b'[' => {
                            let (a, j) = parse_class(p, i + 1)?;
                            alt.push(a);
                            i = j;
                        }
                        _ => {
                            alt.push(atom(Kind::Lit, c));
                            i += 1;
                        }
                    }
                }
                elems.push(alts);
            }
            _ => {
                cur.push(atom(Kind::Lit, ch));
                i += 1;
            }
        }
    }
    if !cur.is_empty() {
        elems.push(vec![cur]);
    }
    Some(elems)
}

fn expansions(elems: &[Vec<Vec<Atom>>]) -> Vec<Vec<Atom>> {
    let mut acc: Vec<Vec<Atom>> = vec![Vec::new()];
    for alts in elems {
        let mut next = Vec::new();
        for pre in &acc {
            for alt in alts {
                let mut e = pre.clone();
                e.extend(alt.iter().cloned());
                next.push(e);
            }
        }
        acc = next;
    }
    acc
}

fn split_atoms(atoms: &[Atom]) -> Vec<Vec<Atom>> {
    let mut segs = Vec::new();
    let mut cur = Vec::new();
    for a in atoms {
        if a.k == Kind::Lit && a.c == b'/' {
            segs.push(std::mem::take(&mut cur));
        } else {
            cur.push(a.clone());
        }
    }
    segs.push(cur);
    segs
}

fn seg_match(atoms: &[Atom], s: &[u8]) -> bool {
    let m = s.len();
    if m > 0 && s[0] == b'.' && (atoms.is_empty() || atoms[0].k != Kind::Lit || atoms[0].c != b'.') {
        return false;
    }
    let mut cur = vec![false; m + 1];
    cur[0] = true;
    for a in atoms {
        let mut nxt = vec![false; m + 1];
        if a.k == Kind::Star {
            let mut run = false;
            for j in 0..=m {
                run = run || cur[j];
                nxt[j] = run;
            }
        } else {
            for j in 0..m {
                if !cur[j] {
                    continue;
                }
                let c = s[j];
                let ok = match a.k {
                    Kind::Lit => c == a.c,
                    Kind::Any => true,
                    _ => a.items.iter().any(|&(lo, hi)| lo <= c && c <= hi) != a.neg,
                };
                if ok {
                    nxt[j + 1] = true;
                }
            }
        }
        cur = nxt;
    }
    cur[m]
}

fn is_globstar(a: &[Atom]) -> bool {
    a.len() == 2 && a[0].k == Kind::Star && a[1].k == Kind::Star
}

fn rec(ps: &[Vec<Atom>], xs: &[&str], i: usize, j: usize, memo: &mut HashMap<(usize, usize), bool>) -> bool {
    if let Some(&v) = memo.get(&(i, j)) {
        return v;
    }
    let r = if i == ps.len() {
        j == xs.len()
    } else if is_globstar(&ps[i]) {
        let mut r = rec(ps, xs, i + 1, j, memo);
        if !r && j < xs.len() && !xs[j].starts_with('.') {
            r = rec(ps, xs, i, j + 1, memo);
        }
        r
    } else if j < xs.len() {
        seg_match(&ps[i], xs[j].as_bytes()) && rec(ps, xs, i + 1, j + 1, memo)
    } else {
        false
    };
    memo.insert((i, j), r);
    r
}

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    let mut out = String::new();
    for line in input.split('\n') {
        let t: Vec<&str> = line.split(|c| c == ' ' || c == '\t').filter(|x| !x.is_empty()).collect();
        if t.is_empty() {
            continue;
        }
        if t.len() != 2 {
            out.push_str("error: bad line\n");
            continue;
        }
        let elems = match parse(t[0].as_bytes()) {
            Some(e) => e,
            None => {
                out.push_str("error: invalid pattern\n");
                continue;
            }
        };
        let xs: Vec<&str> = t[1].split('/').collect();
        let ok = expansions(&elems).iter().any(|e| {
            let ps = split_atoms(e);
            rec(&ps, &xs, 0, 0, &mut HashMap::new())
        });
        out.push_str(if ok { "match\n" } else { "no match\n" });
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
