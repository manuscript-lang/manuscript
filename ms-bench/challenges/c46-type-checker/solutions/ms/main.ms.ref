import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Tok:
    kind: String
    text: String
    col: Int

type Failure:
    msg: String
    col: Int

type Node:
    case Lit(col: Int, ty: String)
    case Var(col: Int, name: String)
    case Neg(col: Int, inner: Node)
    case Not(col: Int, inner: Node)
    case Bin(col: Int, op: String, left: Node, right: Node)
    case Call(col: Int, name: String, args: List[Node])
    case Let(col: Int, name: String, bound: Node, body: Node)
    case If(col: Int, cond: Node, yes: Node, no: Node)

type Env:
    case EnvEnd
    case Bind(name: String, typ: String, rest: Env)

type Sig:
    params: List[String]
    ret: String

type Parser:
    toks: List[Tok]
    pos: Int
    eof: Int

fn fail(msg: String, col: Int) -> Failure:
    return Failure(msg: msg, col: col)

fn is_digit(c: Int) -> Bool:
    return c >= 48 and c <= 57

fn is_start(c: Int) -> Bool:
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

fn is_keyword(w: String) -> Bool:
    return w == "let" or w == "in" or w == "if" or w == "then" or w == "else" or w == "true" or w == "false" or w == "and" or w == "or" or w == "not"

fn is_sym(c: Int) -> Bool:
    return c == 43 or c == 45 or c == 42 or c == 60 or c == 62 or c == 40 or c == 41 or c == 44 or c == 61

fn lex(line: String) -> Result[List[Tok], Failure]:
    let cs = line.scalar_values()
    let n = cs.length()
    let toks = List[Tok]()
    var i = 0
    while i < n:
        let c = cs.at(i).unwrap()
        let col = i + 1
        if c == 32 or c == 9:
            i = i + 1
        else if is_digit(c):
            var j = i
            while j < n and is_digit(cs.at(j).unwrap()):
                j = j + 1
            toks.append(Tok(kind: "int", text: line.slice(i, j), col: col))
            i = j
        else if is_start(c):
            var j = i
            while j < n and (is_start(cs.at(j).unwrap()) or is_digit(cs.at(j).unwrap())):
                j = j + 1
            let w = line.slice(i, j)
            var kind = "id"
            if is_keyword(w):
                kind = w
            toks.append(Tok(kind: kind, text: w, col: col))
            i = j
        else if c == 34:
            var j = i + 1
            while j < n and cs.at(j).unwrap() != 34:
                j = j + 1
            if j >= n:
                return error(fail("unterminated string", col))
            toks.append(Tok(kind: "str", text: line.slice(i, j + 1), col: col))
            i = j + 1
        else:
            var two = ""
            if i + 1 < n:
                two = line.slice(i, i + 2)
            if two == "<=" or two == ">=" or two == "==" or two == "!=":
                toks.append(Tok(kind: two, text: two, col: col))
                i = i + 2
            else if is_sym(c):
                let s = line.slice(i, i + 1)
                toks.append(Tok(kind: s, text: s, col: col))
                i = i + 1
            else:
                return error(fail("unexpected character '{line.slice(i, i + 1)}'", col))
    return ok(toks)

fn col_of(n: Node) -> Int:
    match n:
        Lit(col, _): return col
        Var(col, _): return col
        Neg(col, _): return col
        Not(col, _): return col
        Bin(col, _, _, _): return col
        Call(col, _, _): return col
        Let(col, _, _, _): return col
        If(col, _, _, _): return col

fn with_col(n: Node, c: Int) -> Node:
    match n:
        Lit(_, ty): return Node.Lit(col: c, ty: ty)
        Var(_, name): return Node.Var(col: c, name: name)
        Neg(_, inner): return Node.Neg(col: c, inner: inner)
        Not(_, inner): return Node.Not(col: c, inner: inner)
        Bin(_, op, left, right): return Node.Bin(col: c, op: op, left: left, right: right)
        Call(_, name, args): return Node.Call(col: c, name: name, args: args)
        Let(_, name, bound, body): return Node.Let(col: c, name: name, bound: bound, body: body)
        If(_, cond, yes, no): return Node.If(col: c, cond: cond, yes: yes, no: no)

fn peek(p: Parser) -> String:
    if p.pos < p.toks.length():
        return p.toks.at(p.pos).unwrap().kind
    return ""

fn cur_col(p: Parser) -> Int:
    if p.pos < p.toks.length():
        return p.toks.at(p.pos).unwrap().col
    return p.eof

fn advance(p: Parser) -> Tok:
    let t = p.toks.at(p.pos).unwrap()
    p.pos = p.pos + 1
    return t

fn expect(p: Parser, kind: String) -> Result[Unit, Failure]:
    if peek(p) != kind:
        return error(fail("syntax error", cur_col(p)))
    p.pos = p.pos + 1
    return ok(unit)

fn expect_id(p: Parser) -> Result[Tok, Failure]:
    if peek(p) != "id":
        return error(fail("syntax error", cur_col(p)))
    return ok(advance(p))

fn mk_bin(op: String, l: Node, r: Node) -> Node:
    return Node.Bin(col: col_of(l), op: op, left: l, right: r)

fn is_cmp(k: String) -> Bool:
    return k == "<" or k == "<=" or k == ">" or k == ">=" or k == "==" or k == "!="

fn parse_expr(p: Parser) -> Result[Node, Failure]:
    let k = peek(p)
    if k == "let":
        let t = advance(p)
        let name = try expect_id(p)
        try expect(p, "=")
        let e1 = try parse_expr(p)
        try expect(p, "in")
        let e2 = try parse_expr(p)
        return ok(Node.Let(col: t.col, name: name.text, bound: e1, body: e2))
    if k == "if":
        let t = advance(p)
        let c = try parse_expr(p)
        try expect(p, "then")
        let a = try parse_expr(p)
        try expect(p, "else")
        let b = try parse_expr(p)
        return ok(Node.If(col: t.col, cond: c, yes: a, no: b))
    return parse_or(p)

fn parse_or(p: Parser) -> Result[Node, Failure]:
    var l = try parse_and(p)
    while peek(p) == "or":
        advance(p)
        let r = try parse_and(p)
        l = mk_bin("or", l, r)
    return ok(l)

fn parse_and(p: Parser) -> Result[Node, Failure]:
    var l = try parse_not(p)
    while peek(p) == "and":
        advance(p)
        let r = try parse_not(p)
        l = mk_bin("and", l, r)
    return ok(l)

fn parse_not(p: Parser) -> Result[Node, Failure]:
    if peek(p) == "not":
        let t = advance(p)
        let e = try parse_not(p)
        return ok(Node.Not(col: t.col, inner: e))
    return parse_cmp(p)

fn parse_cmp(p: Parser) -> Result[Node, Failure]:
    let l = try parse_add(p)
    if is_cmp(peek(p)):
        let op = advance(p).kind
        let r = try parse_add(p)
        return ok(mk_bin(op, l, r))
    return ok(l)

fn parse_add(p: Parser) -> Result[Node, Failure]:
    var l = try parse_mul(p)
    while peek(p) == "+" or peek(p) == "-":
        let op = advance(p).kind
        let r = try parse_mul(p)
        l = mk_bin(op, l, r)
    return ok(l)

fn parse_mul(p: Parser) -> Result[Node, Failure]:
    var l = try parse_unary(p)
    while peek(p) == "*":
        advance(p)
        let r = try parse_unary(p)
        l = mk_bin("*", l, r)
    return ok(l)

fn parse_unary(p: Parser) -> Result[Node, Failure]:
    if peek(p) == "-":
        let t = advance(p)
        let e = try parse_unary(p)
        return ok(Node.Neg(col: t.col, inner: e))
    return parse_atom(p)

fn parse_call(p: Parser, name: Tok) -> Result[Node, Failure]:
    advance(p)
    let args = List[Node]()
    if peek(p) != ")":
        args.append(try parse_expr(p))
        while peek(p) == ",":
            advance(p)
            args.append(try parse_expr(p))
    try expect(p, ")")
    return ok(Node.Call(col: name.col, name: name.text, args: args))

fn parse_atom(p: Parser) -> Result[Node, Failure]:
    let k = peek(p)
    if k == "int":
        return ok(Node.Lit(col: advance(p).col, ty: "Int"))
    if k == "str":
        return ok(Node.Lit(col: advance(p).col, ty: "Str"))
    if k == "true" or k == "false":
        return ok(Node.Lit(col: advance(p).col, ty: "Bool"))
    if k == "id":
        let t = advance(p)
        if peek(p) == "(":
            return parse_call(p, t)
        return ok(Node.Var(col: t.col, name: t.text))
    if k == "(":
        let t = advance(p)
        let e = try parse_expr(p)
        try expect(p, ")")
        return ok(with_col(e, t.col))
    return error(fail("syntax error", cur_col(p)))

fn need(t: String, want: String, col: Int) -> Result[Unit, Failure]:
    if t != want:
        return error(fail("expected {want}, found {t}", col))
    return ok(unit)

fn lookup(env: Env, name: String) -> Optional[String]:
    match env:
        EnvEnd: return none
        Bind(n, t, rest):
            if n == name:
                return some(t)
            return lookup(rest, name)

fn builtin(name: String) -> Optional[Sig]:
    if name == "len":
        return some(Sig(params: ["Str"], ret: "Int"))
    if name == "str":
        return some(Sig(params: ["Int"], ret: "Str"))
    if name == "abs":
        return some(Sig(params: ["Int"], ret: "Int"))
    if name == "min" or name == "max":
        return some(Sig(params: ["Int", "Int"], ret: "Int"))
    if name == "concat":
        return some(Sig(params: ["Str", "Str"], ret: "Str"))
    if name == "even":
        return some(Sig(params: ["Int"], ret: "Bool"))
    return none

fn check_bin(op: String, l: Node, r: Node, env: Env) -> Result[String, Failure]:
    let lt = try check(l, env)
    let rt = try check(r, env)
    if op == "+":
        if lt != "Int" and lt != "Str":
            return error(fail("expected Int or Str, found {lt}", col_of(l)))
        try need(rt, lt, col_of(r))
        return ok(lt)
    if op == "-" or op == "*":
        try need(lt, "Int", col_of(l))
        try need(rt, "Int", col_of(r))
        return ok("Int")
    if op == "==" or op == "!=":
        try need(rt, lt, col_of(r))
        return ok("Bool")
    if is_cmp(op):
        try need(lt, "Int", col_of(l))
        try need(rt, "Int", col_of(r))
        return ok("Bool")
    try need(lt, "Bool", col_of(l))
    try need(rt, "Bool", col_of(r))
    return ok("Bool")

fn check_call(col: Int, name: String, args: List[Node], env: Env) -> Result[String, Failure]:
    let found = builtin(name)
    if found.is_none():
        return error(fail("unknown function {name}", col))
    let sig = found.unwrap()
    if args.length() != sig.params.length():
        return error(fail("wrong number of arguments for {name}: expected {sig.params.length()}, found {args.length()}", col))
    var i = 0
    while i < args.length():
        let a = args.at(i).unwrap()
        let t = try check(a, env)
        try need(t, sig.params.at(i).unwrap(), col_of(a))
        i = i + 1
    return ok(sig.ret)

fn check_unary(inner: Node, want: String, env: Env) -> Result[String, Failure]:
    let t = try check(inner, env)
    try need(t, want, col_of(inner))
    return ok(want)

fn check_if(cond: Node, yes: Node, no: Node, env: Env) -> Result[String, Failure]:
    let ct = try check(cond, env)
    try need(ct, "Bool", col_of(cond))
    let tt = try check(yes, env)
    let et = try check(no, env)
    try need(et, tt, col_of(no))
    return ok(tt)

fn check_var(col: Int, name: String, env: Env) -> Result[String, Failure]:
    let t = lookup(env, name)
    if t.is_none():
        return error(fail("unbound variable {name}", col))
    return ok(t.unwrap())

fn check_let(name: String, bound: Node, body: Node, env: Env) -> Result[String, Failure]:
    let t1 = try check(bound, env)
    return check(body, Env.Bind(name: name, typ: t1, rest: env))

fn check(n: Node, env: Env) -> Result[String, Failure]:
    match n:
        Lit(_, ty): return ok(ty)
        Var(col, name): return check_var(col, name, env)
        Neg(_, inner): return check_unary(inner, "Int", env)
        Not(_, inner): return check_unary(inner, "Bool", env)
        Bin(_, op, l, r): return check_bin(op, l, r, env)
        Call(col, name, args): return check_call(col, name, args, env)
        Let(_, name, bound, body): return check_let(name, bound, body, env)
        If(_, cond, yes, no): return check_if(cond, yes, no, env)

fn run_line(line: String) -> String:
    var end = line.length()
    while end > 0:
        let c = line.scalar_at(end - 1).unwrap()
        if c != 32 and c != 9:
            break
        end = end - 1
    let toks = match lex(line):
        ok(ts): ts
        error(f):
            return "error: {f.msg} at {f.col}"
    let p = Parser(toks: toks, pos: 0, eof: end + 1)
    let tree = match parse_expr(p):
        ok(nd): nd
        error(f):
            return "error: {f.msg} at {f.col}"
    if p.pos < p.toks.length():
        return "error: syntax error at {cur_col(p)}"
    match check(tree, Env.EnvEnd):
        ok(t): return t
        error(f): return "error: {f.msg} at {f.col}"

fn run() -> Result[Unit, Error]:
    let out = StringBuilder()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let line = next.unwrap()
        if line.length() == end_of_blank(line):
            continue
        out.append(run_line(line))
        out.append("\n")
    try stdout().write(out.freeze().to_bytes())
    return stdout().flush()

fn end_of_blank(line: String) -> Int:
    var i = 0
    while i < line.length():
        let c = line.scalar_at(i).unwrap()
        if c != 32 and c != 9:
            return -1
        i = i + 1
    return line.length()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
