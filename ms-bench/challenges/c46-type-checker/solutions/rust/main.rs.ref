use std::io::{self, Read, Write};

#[derive(Clone)]
struct Tok {
    kind: String,
    text: String,
    col: usize,
}

#[derive(Clone)]
enum Kind {
    Int,
    Bool,
    Str,
    Var(String),
    Neg(Box<Node>),
    Not(Box<Node>),
    Bin(String, Box<Node>, Box<Node>),
    Call(String, Vec<Node>),
    Let(String, Box<Node>, Box<Node>),
    If(Box<Node>, Box<Node>, Box<Node>),
}

#[derive(Clone)]
struct Node {
    col: usize,
    k: Kind,
}

struct Err {
    msg: String,
    col: usize,
}

type R<T> = Result<T, Err>;

fn fail<T>(msg: String, col: usize) -> R<T> {
    Err(Err { msg, col })
}

const KEYWORDS: [&str; 10] = ["let", "in", "if", "then", "else", "true", "false", "and", "or", "not"];

fn builtin(name: &str) -> Option<(&'static [&'static str], &'static str)> {
    Some(match name {
        "len" => (&["Str"], "Int"),
        "str" => (&["Int"], "Str"),
        "abs" => (&["Int"], "Int"),
        "min" | "max" => (&["Int", "Int"], "Int"),
        "concat" => (&["Str", "Str"], "Str"),
        "even" => (&["Int"], "Bool"),
        _ => return None,
    })
}

fn is_cmp(k: &str) -> bool {
    matches!(k, "<" | "<=" | ">" | ">=" | "==" | "!=")
}

fn lex(line: &str) -> R<Vec<Tok>> {
    let b = line.as_bytes();
    let n = b.len();
    let mut toks = Vec::new();
    let mut i = 0;
    while i < n {
        let c = b[i];
        let col = i + 1;
        if c == b' ' || c == b'\t' {
            i += 1;
        } else if c.is_ascii_digit() {
            let mut j = i;
            while j < n && b[j].is_ascii_digit() {
                j += 1;
            }
            toks.push(Tok { kind: "int".into(), text: line[i..j].into(), col });
            i = j;
        } else if c.is_ascii_alphabetic() || c == b'_' {
            let mut j = i;
            while j < n && (b[j].is_ascii_alphanumeric() || b[j] == b'_') {
                j += 1;
            }
            let w = &line[i..j];
            let kind = if KEYWORDS.contains(&w) { w } else { "id" };
            toks.push(Tok { kind: kind.into(), text: w.into(), col });
            i = j;
        } else if c == b'"' {
            match line[i + 1..].find('"') {
                None => return fail("unterminated string".into(), col),
                Some(off) => {
                    let j = i + 1 + off;
                    toks.push(Tok { kind: "str".into(), text: line[i..=j].into(), col });
                    i = j + 1;
                }
            }
        } else {
            let two = if i + 2 <= n { &line[i..i + 2] } else { "" };
            if matches!(two, "<=" | ">=" | "==" | "!=") {
                toks.push(Tok { kind: two.into(), text: two.into(), col });
                i += 2;
            } else if b"+-*<>(),=".contains(&c) {
                let s = (c as char).to_string();
                toks.push(Tok { kind: s.clone(), text: s, col });
                i += 1;
            } else {
                return fail(format!("unexpected character '{}'", c as char), col);
            }
        }
    }
    Ok(toks)
}

struct Parser {
    toks: Vec<Tok>,
    pos: usize,
    eof: usize,
}

fn mk(col: usize, k: Kind) -> Node {
    Node { col, k }
}

impl Parser {
    fn peek(&self) -> &str {
        if self.pos < self.toks.len() {
            &self.toks[self.pos].kind
        } else {
            ""
        }
    }
    fn col(&self) -> usize {
        if self.pos < self.toks.len() {
            self.toks[self.pos].col
        } else {
            self.eof
        }
    }
    fn next(&mut self) -> Tok {
        let t = self.toks[self.pos].clone();
        self.pos += 1;
        t
    }
    fn expect(&mut self, k: &str) -> R<Tok> {
        if self.peek() != k {
            return fail("syntax error".into(), self.col());
        }
        Ok(self.next())
    }
    fn bin(op: &str, l: Node, r: Node) -> Node {
        mk(l.col, Kind::Bin(op.into(), Box::new(l), Box::new(r)))
    }
    fn expr(&mut self) -> R<Node> {
        match self.peek() {
            "let" => {
                let t = self.next();
                let name = self.expect("id")?;
                self.expect("=")?;
                let e1 = self.expr()?;
                self.expect("in")?;
                let e2 = self.expr()?;
                Ok(mk(t.col, Kind::Let(name.text, Box::new(e1), Box::new(e2))))
            }
            "if" => {
                let t = self.next();
                let c = self.expr()?;
                self.expect("then")?;
                let a = self.expr()?;
                self.expect("else")?;
                let b = self.expr()?;
                Ok(mk(t.col, Kind::If(Box::new(c), Box::new(a), Box::new(b))))
            }
            _ => self.or(),
        }
    }
    fn or(&mut self) -> R<Node> {
        let mut l = self.and()?;
        while self.peek() == "or" {
            self.next();
            let r = self.and()?;
            l = Self::bin("or", l, r);
        }
        Ok(l)
    }
    fn and(&mut self) -> R<Node> {
        let mut l = self.not()?;
        while self.peek() == "and" {
            self.next();
            let r = self.not()?;
            l = Self::bin("and", l, r);
        }
        Ok(l)
    }
    fn not(&mut self) -> R<Node> {
        if self.peek() == "not" {
            let t = self.next();
            let e = self.not()?;
            return Ok(mk(t.col, Kind::Not(Box::new(e))));
        }
        self.cmp()
    }
    fn cmp(&mut self) -> R<Node> {
        let l = self.add()?;
        if is_cmp(self.peek()) {
            let op = self.next().kind;
            let r = self.add()?;
            return Ok(Self::bin(&op, l, r));
        }
        Ok(l)
    }
    fn add(&mut self) -> R<Node> {
        let mut l = self.mul()?;
        while self.peek() == "+" || self.peek() == "-" {
            let op = self.next().kind;
            let r = self.mul()?;
            l = Self::bin(&op, l, r);
        }
        Ok(l)
    }
    fn mul(&mut self) -> R<Node> {
        let mut l = self.unary()?;
        while self.peek() == "*" {
            self.next();
            let r = self.unary()?;
            l = Self::bin("*", l, r);
        }
        Ok(l)
    }
    fn unary(&mut self) -> R<Node> {
        if self.peek() == "-" {
            let t = self.next();
            let e = self.unary()?;
            return Ok(mk(t.col, Kind::Neg(Box::new(e))));
        }
        self.atom()
    }
    fn atom(&mut self) -> R<Node> {
        let k = self.peek().to_string();
        match k.as_str() {
            "int" => Ok(mk(self.next().col, Kind::Int)),
            "str" => Ok(mk(self.next().col, Kind::Str)),
            "true" | "false" => Ok(mk(self.next().col, Kind::Bool)),
            "id" => {
                let t = self.next();
                if self.peek() == "(" {
                    self.next();
                    let mut args = Vec::new();
                    if self.peek() != ")" {
                        args.push(self.expr()?);
                        while self.peek() == "," {
                            self.next();
                            args.push(self.expr()?);
                        }
                    }
                    self.expect(")")?;
                    return Ok(mk(t.col, Kind::Call(t.text, args)));
                }
                Ok(mk(t.col, Kind::Var(t.text)))
            }
            "(" => {
                let t = self.next();
                let mut e = self.expr()?;
                self.expect(")")?;
                e.col = t.col;
                Ok(e)
            }
            _ => fail("syntax error".into(), self.col()),
        }
    }
}

fn need(t: &str, want: &str, col: usize) -> R<()> {
    if t != want {
        return fail(format!("expected {}, found {}", want, t), col);
    }
    Ok(())
}

fn check(n: &Node, env: &mut Vec<(String, String)>) -> R<String> {
    match &n.k {
        Kind::Int => Ok("Int".into()),
        Kind::Bool => Ok("Bool".into()),
        Kind::Str => Ok("Str".into()),
        Kind::Var(name) => match env.iter().rev().find(|(k, _)| k == name) {
            Some((_, t)) => Ok(t.clone()),
            None => fail(format!("unbound variable {}", name), n.col),
        },
        Kind::Neg(e) => {
            need(&check(e, env)?, "Int", e.col)?;
            Ok("Int".into())
        }
        Kind::Not(e) => {
            need(&check(e, env)?, "Bool", e.col)?;
            Ok("Bool".into())
        }
        Kind::Bin(op, l, r) => {
            let lt = check(l, env)?;
            let rt = check(r, env)?;
            let op = op.as_str();
            if op == "+" {
                if lt != "Int" && lt != "Str" {
                    return fail(format!("expected Int or Str, found {}", lt), l.col);
                }
                need(&rt, &lt, r.col)?;
                Ok(lt)
            } else if op == "-" || op == "*" {
                need(&lt, "Int", l.col)?;
                need(&rt, "Int", r.col)?;
                Ok("Int".into())
            } else if op == "==" || op == "!=" {
                need(&rt, &lt, r.col)?;
                Ok("Bool".into())
            } else if is_cmp(op) {
                need(&lt, "Int", l.col)?;
                need(&rt, "Int", r.col)?;
                Ok("Bool".into())
            } else {
                need(&lt, "Bool", l.col)?;
                need(&rt, "Bool", r.col)?;
                Ok("Bool".into())
            }
        }
        Kind::Call(name, args) => {
            let (params, ret) = match builtin(name) {
                Some(s) => s,
                None => return fail(format!("unknown function {}", name), n.col),
            };
            if args.len() != params.len() {
                return fail(
                    format!("wrong number of arguments for {}: expected {}, found {}", name, params.len(), args.len()),
                    n.col,
                );
            }
            for (a, p) in args.iter().zip(params.iter()) {
                let t = check(a, env)?;
                need(&t, p, a.col)?;
            }
            Ok(ret.into())
        }
        Kind::Let(name, e1, e2) => {
            let t1 = check(e1, env)?;
            env.push((name.clone(), t1));
            let r = check(e2, env);
            env.pop();
            r
        }
        Kind::If(c, a, b) => {
            need(&check(c, env)?, "Bool", c.col)?;
            let tt = check(a, env)?;
            let et = check(b, env)?;
            need(&et, &tt, b.col)?;
            Ok(tt)
        }
    }
}

fn run_line(line: &str) -> String {
    let go = || -> R<String> {
        let toks = lex(line)?;
        let eof = line.trim_end_matches(|c| c == ' ' || c == '\t').len() + 1;
        let mut p = Parser { toks, pos: 0, eof };
        let n = p.expr()?;
        if p.pos < p.toks.len() {
            return fail("syntax error".into(), p.col());
        }
        check(&n, &mut Vec::new())
    };
    match go() {
        Ok(t) => t,
        Err(e) => format!("error: {} at {}", e.msg, e.col),
    }
}

fn main() {
    let mut s = String::new();
    io::stdin().read_to_string(&mut s).unwrap();
    let mut out = String::new();
    for line in s.split('\n') {
        if line.trim_matches(|c| c == ' ' || c == '\t').is_empty() {
            continue;
        }
        out.push_str(&run_line(line));
        out.push('\n');
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
