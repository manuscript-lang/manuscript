import {stdin, stdout, read_line} from "@std/io.ms"
import StringBuilder from "@std/string.ms"

type Task:
    id: String
    arr: Int
    cost: Int
    fails: Int
    high: Bool
    attempts: Int
    res: String
    state: Int

type Worker:
    task: Int
    start: Int
    end: Int
    busy: Int

type Queue:
    items: List[Int]
    head: Int

type Pool:
    tasks: List[Task]
    workers: List[Worker]
    high: Queue
    normal: Queue
    capacity: Int
    retries: Int
    makespan: Int

fn fields(line: String) -> List[String]:
    let spaced = line.replace_all(old: "\t", new: " ").unwrap()
    return spaced.split(" ").filter(fn(part: String) -> Bool:
        return not part.is_empty()
    )

fn queue_len(q: Queue) -> Int:
    return q.items.length() - q.head

fn waiting(p: Pool) -> Int:
    return queue_len(p.high) + queue_len(p.normal)

fn queue_pop(q: Queue) -> Int:
    let v = q.items.at(q.head).unwrap()
    q.head = q.head + 1
    return v

fn begin(p: Pool, w: Int, i: Int, t: Int) -> Unit:
    let task = p.tasks.at(i).unwrap()
    let worker = p.workers.at(w).unwrap()
    task.attempts = task.attempts + 1
    worker.task = i
    worker.start = t
    worker.end = t + task.cost
    worker.busy = worker.busy + task.cost

fn enqueue(p: Pool, i: Int) -> Unit:
    if p.tasks.at(i).unwrap().high:
        p.high.items.append(i)
    else:
        p.normal.items.append(i)

fn complete(p: Pool, w: Int) -> Unit:
    let worker = p.workers.at(w).unwrap()
    let i = worker.task
    let task = p.tasks.at(i).unwrap()
    worker.task = -1
    if worker.end > p.makespan:
        p.makespan = worker.end
    if task.attempts <= task.fails:
        if task.attempts < p.retries + 1:
            enqueue(p, i)
        else:
            task.state = 2
            task.res = "{task.id} failed attempts={task.attempts} end={worker.end}"
    else:
        task.state = 1
        task.res = "{task.id} ok worker={w + 1} start={worker.start} end={worker.end} attempts={task.attempts}"

fn first_idle(p: Pool) -> Int:
    var w = 0
    while w < p.workers.length():
        if p.workers.at(w).unwrap().task < 0:
            return w
        w = w + 1
    return -1

fn next_time(p: Pool, order: List[Int], ai: Int) -> Int:
    var t = -1
    for worker in p.workers:
        if worker.task >= 0 and (t < 0 or worker.end < t):
            t = worker.end
    if ai < order.length():
        let a = p.tasks.at(order.at(ai).unwrap()).unwrap().arr
        if t < 0 or a < t:
            t = a
    return t

fn step_completions(p: Pool, t: Int) -> Unit:
    var w = 0
    while w < p.workers.length():
        let worker = p.workers.at(w).unwrap()
        if worker.task >= 0 and worker.end == t:
            complete(p, w)
        w = w + 1

fn step_dispatch(p: Pool, t: Int) -> Unit:
    var w = 0
    while w < p.workers.length():
        if p.workers.at(w).unwrap().task < 0 and waiting(p) > 0:
            if queue_len(p.high) > 0:
                begin(p, w, queue_pop(p.high), t)
            else:
                begin(p, w, queue_pop(p.normal), t)
        w = w + 1

fn arrive(p: Pool, i: Int, t: Int) -> Unit:
    let idle = first_idle(p)
    if idle >= 0:
        begin(p, idle, i, t)
        return unit
    if waiting(p) < p.capacity:
        enqueue(p, i)
        return unit
    let task = p.tasks.at(i).unwrap()
    task.state = 3
    task.res = "{task.id} rejected at={t}"

fn simulate(p: Pool, order: List[Int]) -> Unit:
    var ai = 0
    while true:
        let t = next_time(p, order, ai)
        if t < 0:
            break
        step_completions(p, t)
        step_dispatch(p, t)
        while ai < order.length() and p.tasks.at(order.at(ai).unwrap()).unwrap().arr == t:
            arrive(p, order.at(ai).unwrap(), t)
            ai = ai + 1

fn count_state(p: Pool, state: Int) -> Int:
    return p.tasks.filter(fn(t: Task) -> Bool:
        return t.state == state
    ).length()

fn run() -> Result[Unit, Error]:
    var pool_line = List[String]()
    let tasks = List[Task]()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        let t = fields(next.unwrap())
        if t.is_empty():
            continue
        if pool_line.is_empty():
            pool_line = t
            continue
        var fails = 0
        var high = false
        var k = 4
        while k < t.length():
            let x = t.at(k).unwrap()
            if x == "high":
                high = true
            else:
                fails = x.slice(6, x.length()).parse_int().unwrap_or(0)
            k = k + 1
        tasks.append(Task(
            id: t.at(1).unwrap(),
            arr: t.at(2).unwrap().parse_int().unwrap_or(0),
            cost: t.at(3).unwrap().parse_int().unwrap_or(1),
            fails: fails, high: high, attempts: 0, res: "", state: 0
        ))
    let wcount = pool_line.at(1).unwrap().parse_int().unwrap_or(1)
    let workers = List[Worker]()
    var w = 0
    while w < wcount:
        workers.append(Worker(task: -1, start: 0, end: 0, busy: 0))
        w = w + 1
    let pool = Pool(
        tasks: tasks, workers: workers,
        high: Queue(items: List[Int](), head: 0), normal: Queue(items: List[Int](), head: 0),
        capacity: pool_line.at(2).unwrap().parse_int().unwrap_or(0),
        retries: pool_line.at(3).unwrap().parse_int().unwrap_or(0),
        makespan: 0
    )
    let idx = List[Int]()
    var i = 0
    while i < tasks.length():
        idx.append(i)
        i = i + 1
    let order = idx.sorted(compare: fn(a: Int, b: Int) -> Int:
        let x = tasks.at(a).unwrap().arr
        let y = tasks.at(b).unwrap().arr
        if x != y:
            if x < y:
                return -1
            return 1
        return a - b
    )
    simulate(pool, order)
    let out = StringBuilder()
    for task in tasks:
        out.append(task.res)
        out.append("\n")
    var n = 0
    while n < wcount:
        out.append("worker {n + 1} busy={workers.at(n).unwrap().busy}\n")
        n = n + 1
    out.append("summary ok={count_state(pool, 1)} failed={count_state(pool, 2)} rejected={count_state(pool, 3)} makespan={pool.makespan}\n")
    try stdout().write(out.freeze().to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
