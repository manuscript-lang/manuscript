import * as fs from "node:fs";

type Task = {
  id: string;
  arr: number;
  cost: number;
  fails: number;
  high: boolean;
  attempts: number;
  res: string;
  state: "ok" | "failed" | "rejected" | "";
};
type Run = { task: number; start: number; end: number } | null;

const lines = fs
  .readFileSync(0, "utf8")
  .split("\n")
  .map((l) => l.split(/[ \t]+/).filter((x) => x !== ""))
  .filter((t) => t.length > 0);

const W = parseInt(lines[0][1], 10);
const Q = parseInt(lines[0][2], 10);
const R = parseInt(lines[0][3], 10);
const tasks: Task[] = [];
for (const t of lines.slice(1)) {
  let fails = 0;
  let high = false;
  for (const x of t.slice(4)) {
    if (x === "high") high = true;
    else fails = parseInt(x.slice("fails=".length), 10);
  }
  tasks.push({ id: t[1], arr: parseInt(t[2], 10), cost: parseInt(t[3], 10), fails, high, attempts: 0, res: "", state: "" });
}
const order = tasks.map((_, i) => i).sort((a, b) => tasks[a].arr - tasks[b].arr || a - b);

const run: Run[] = new Array(W).fill(null);
const busy: number[] = new Array(W).fill(0);
const qh: number[] = [];
const qn: number[] = [];
let qhHead = 0;
let qnHead = 0;
let ai = 0;
let makespan = 0;

const waiting = () => qh.length - qhHead + (qn.length - qnHead);

function start(w: number, i: number, t: number): void {
  const tk = tasks[i];
  tk.attempts++;
  run[w] = { task: i, start: t, end: t + tk.cost };
  busy[w] += tk.cost;
}

for (;;) {
  let t = -1;
  for (const r of run) if (r !== null && (t < 0 || r.end < t)) t = r.end;
  if (ai < order.length) {
    const a = tasks[order[ai]].arr;
    if (t < 0 || a < t) t = a;
  }
  if (t < 0) break;
  for (let w = 0; w < W; w++) {
    const r = run[w];
    if (r !== null && r.end === t) {
      const tk = tasks[r.task];
      run[w] = null;
      makespan = Math.max(makespan, r.end);
      if (tk.attempts <= tk.fails) {
        if (tk.attempts < R + 1) (tk.high ? qh : qn).push(r.task);
        else {
          tk.state = "failed";
          tk.res = `${tk.id} failed attempts=${tk.attempts} end=${r.end}`;
        }
      } else {
        tk.state = "ok";
        tk.res = `${tk.id} ok worker=${w + 1} start=${r.start} end=${r.end} attempts=${tk.attempts}`;
      }
    }
  }
  for (let w = 0; w < W; w++) {
    if (run[w] === null && waiting() > 0) {
      if (qhHead < qh.length) start(w, qh[qhHead++], t);
      else start(w, qn[qnHead++], t);
    }
  }
  while (ai < order.length && tasks[order[ai]].arr === t) {
    const i = order[ai++];
    const idle = run.findIndex((r) => r === null);
    if (idle >= 0) start(idle, i, t);
    else if (waiting() < Q) (tasks[i].high ? qh : qn).push(i);
    else {
      tasks[i].state = "rejected";
      tasks[i].res = `${tasks[i].id} rejected at=${t}`;
    }
  }
}

const out: string[] = tasks.map((tk) => tk.res);
for (let w = 0; w < W; w++) out.push(`worker ${w + 1} busy=${busy[w]}`);
const count = (s: string) => tasks.filter((tk) => tk.state === s).length;
out.push(`summary ok=${count("ok")} failed=${count("failed")} rejected=${count("rejected")} makespan=${makespan}`);
process.stdout.write(out.map((l) => l + "\n").join(""));
