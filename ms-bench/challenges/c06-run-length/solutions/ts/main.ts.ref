import { readFileSync } from "node:fs";

function solveLine(line: string): string {
  const i = line.indexOf(" ");
  if (i < 0) return "error";
  const cmd = line.slice(0, i);
  const rest = line.slice(i + 1);
  if (cmd === "E") {
    if (!/^[A-Za-z]+$/.test(rest)) return "error";
    return rest.replace(/(.)\1*/g, (m, c) => `${m.length}${c}`);
  }
  if (cmd === "D") {
    if (!/^([1-9][0-9]*[A-Za-z])+$/.test(rest)) return "error";
    return rest.replace(/([1-9][0-9]*)([A-Za-z])/g, (_m, n, c) => c.repeat(Number(n)));
  }
  return "error";
}

const lines = readFileSync(0, "utf8").split("\n");
if (lines[lines.length - 1] === "") lines.pop();
let out = "";
for (const l of lines) {
  if (l.replace(/ /g, "") === "") continue;
  out += solveLine(l) + "\n";
}
process.stdout.write(out);
