use std::io::{BufRead, Write};

fn solve_line(line: &str) -> String {
    let i = match line.find(' ') {
        Some(i) => i,
        None => return "error".to_string(),
    };
    let (cmd, rest) = (&line[..i], &line[i + 1..]);
    let b = rest.as_bytes();
    match cmd {
        "E" => {
            if b.is_empty() || !b.iter().all(|c| c.is_ascii_alphabetic()) {
                return "error".to_string();
            }
            let mut out = String::new();
            let mut k = 0;
            while k < b.len() {
                let mut j = k;
                while j < b.len() && b[j] == b[k] {
                    j += 1;
                }
                out.push_str(&(j - k).to_string());
                out.push(b[k] as char);
                k = j;
            }
            out
        }
        "D" => {
            let mut out = String::new();
            let mut k = 0;
            let mut pairs = 0;
            while k < b.len() {
                if !(b'1'..=b'9').contains(&b[k]) {
                    return "error".to_string();
                }
                let mut n = 0usize;
                while k < b.len() && b[k].is_ascii_digit() {
                    n = n * 10 + (b[k] - b'0') as usize;
                    k += 1;
                }
                if k >= b.len() || !b[k].is_ascii_alphabetic() {
                    return "error".to_string();
                }
                out.push_str(&(b[k] as char).to_string().repeat(n));
                k += 1;
                pairs += 1;
            }
            if pairs == 0 {
                return "error".to_string();
            }
            out
        }
        _ => "error".to_string(),
    }
}

fn main() {
    let stdin = std::io::stdin();
    let mut out = String::new();
    for line in stdin.lock().lines() {
        let line = line.unwrap();
        if line.trim_matches(' ').is_empty() {
            continue;
        }
        out.push_str(&solve_line(&line));
        out.push('\n');
    }
    std::io::stdout().write_all(out.as_bytes()).unwrap();
}
