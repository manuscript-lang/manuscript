use std::collections::HashMap;
use std::io::{Read, Write};

fn main() {
    let mut data = Vec::new();
    std::io::stdin().read_to_end(&mut data).unwrap();
    let mut counts: HashMap<String, u64> = HashMap::new();
    let mut cur = String::new();
    for &b in data.iter().chain(std::iter::once(&b' ')) {
        if b.is_ascii_alphabetic() {
            cur.push(b.to_ascii_lowercase() as char);
        } else if !cur.is_empty() {
            *counts.entry(std::mem::take(&mut cur)).or_insert(0) += 1;
        }
    }
    let mut all: Vec<_> = counts.into_iter().collect();
    all.sort_by(|a, b| b.1.cmp(&a.1).then(a.0.cmp(&b.0)));
    let mut out = std::io::stdout().lock();
    for (w, n) in all.into_iter().take(10) {
        writeln!(out, "{} {}", w, n).unwrap();
    }
}
