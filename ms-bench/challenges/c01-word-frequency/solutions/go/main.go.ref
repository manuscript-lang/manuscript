package main

import (
	"bufio"
	"fmt"
	"io"
	"os"
	"sort"
	"strings"
)

func main() {
	data, _ := io.ReadAll(os.Stdin)
	counts := map[string]int{}
	var cur []byte
	flush := func() {
		if len(cur) > 0 {
			counts[strings.ToLower(string(cur))]++
			cur = cur[:0]
		}
	}
	for _, b := range data {
		if (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') {
			cur = append(cur, b)
		} else {
			flush()
		}
	}
	flush()
	type kv struct {
		w string
		n int
	}
	var all []kv
	for w, n := range counts {
		all = append(all, kv{w, n})
	}
	sort.Slice(all, func(i, j int) bool {
		if all[i].n != all[j].n {
			return all[i].n > all[j].n
		}
		return all[i].w < all[j].w
	})
	if len(all) > 10 {
		all = all[:10]
	}
	out := bufio.NewWriter(os.Stdout)
	defer out.Flush()
	for _, e := range all {
		fmt.Fprintf(out, "%s %d\n", e.w, e.n)
	}
}
