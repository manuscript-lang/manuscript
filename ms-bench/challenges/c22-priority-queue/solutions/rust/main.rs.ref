use std::cmp::Reverse;
use std::collections::BinaryHeap;
use std::io::{self, Read, Write};

fn main() {
    let mut input = String::new();
    io::stdin().read_to_string(&mut input).unwrap();
    // Min-heap on (priority, push sequence): equal priorities leave in push order.
    let mut heap: BinaryHeap<Reverse<(i64, usize, String)>> = BinaryHeap::new();
    let mut seq = 0usize;
    let mut out = String::new();
    for line in input.split('\n') {
        if line.trim().is_empty() {
            continue;
        }
        let p: Vec<&str> = line.split(' ').collect();
        match p[0] {
            "push" => {
                heap.push(Reverse((p[1].parse().unwrap(), seq, p[2].to_string())));
                seq += 1;
            }
            "pop" => match heap.pop() {
                Some(Reverse((pr, _, n))) => out.push_str(&format!("{} {}\n", n, pr)),
                None => out.push_str("empty\n"),
            },
            "peek" => match heap.peek() {
                Some(Reverse((pr, _, n))) => out.push_str(&format!("{} {}\n", n, pr)),
                None => out.push_str("empty\n"),
            },
            "size" => out.push_str(&format!("{}\n", heap.len())),
            "drain" => {
                if heap.is_empty() {
                    out.push_str("empty\n");
                }
                while let Some(Reverse((pr, _, n))) = heap.pop() {
                    out.push_str(&format!("{} {}\n", n, pr));
                }
            }
            _ => {}
        }
    }
    io::stdout().write_all(out.as_bytes()).unwrap();
}
