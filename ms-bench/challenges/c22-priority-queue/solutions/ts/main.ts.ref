import { readFileSync } from "node:fs";

type Entry = { prio: number; name: string };
// Sorted ascending by priority; equal priorities keep push order because we insert after them.
const queue: Entry[] = [];
const out: string[] = [];
const fmt = (e: Entry) => `${e.name} ${e.prio}`;
for (const line of readFileSync(0, "utf8").split("\n")) {
  if (line.trim() === "") continue;
  const p = line.split(" ");
  if (p[0] === "push") {
    const e = { prio: parseInt(p[1], 10), name: p[2] };
    let lo = 0, hi = queue.length;
    while (lo < hi) {
      const mid = (lo + hi) >> 1;
      if (queue[mid].prio <= e.prio) lo = mid + 1; else hi = mid;
    }
    queue.splice(lo, 0, e);
  } else if (p[0] === "pop") {
    out.push(queue.length ? fmt(queue.shift()!) : "empty");
  } else if (p[0] === "peek") {
    out.push(queue.length ? fmt(queue[0]) : "empty");
  } else if (p[0] === "size") {
    out.push(String(queue.length));
  } else if (p[0] === "drain") {
    if (!queue.length) out.push("empty");
    while (queue.length) out.push(fmt(queue.shift()!));
  }
}
process.stdout.write(out.map((l) => l + "\n").join(""));
