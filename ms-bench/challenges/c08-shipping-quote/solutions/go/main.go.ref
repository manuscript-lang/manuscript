package main

import (
	"bufio"
	"fmt"
	"os"
	"strings"
)

const header = "order,country,weight_g,service,declared_cents"

var services = []string{"standard", "express", "overnight"}

func money(c int) string { return fmt.Sprintf("%d.%02d", c/100, c%100) }

func zoneOf(c string) int {
	switch c {
	case "US":
		return 1
	case "CA", "MX":
		return 2
	case "AT", "BE", "DE", "ES", "FR", "IE", "IT", "NL", "PT", "SE":
		return 3
	}
	return 4
}

// digits parses s when it is 1..max ASCII digits.
func digits(s string, max int) (int, bool) {
	if len(s) < 1 || len(s) > max {
		return 0, false
	}
	n := 0
	for i := 0; i < len(s); i++ {
		if s[i] < '0' || s[i] > '9' {
			return 0, false
		}
		n = n*10 + int(s[i]-'0')
	}
	return n, true
}

func validOrder(s string) bool {
	if s == "" {
		return false
	}
	for i := 0; i < len(s); i++ {
		c := s[i]
		if !((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-') {
			return false
		}
	}
	return true
}

func main() {
	sc := bufio.NewScanner(os.Stdin)
	sc.Buffer(make([]byte, 1<<20), 1<<24)
	var lines []string
	for sc.Scan() {
		lines = append(lines, sc.Text())
	}
	if len(lines) == 0 || lines[0] != header {
		fmt.Println("error: bad header")
		return
	}
	rates := map[int][2]int{1: {499, 120}, 2: {899, 180}, 3: {1499, 250}, 4: {2199, 400}}
	w := bufio.NewWriter(os.Stdout)
	defer w.Flush()
	seen := map[string]bool{}
	count := map[string]int{}
	totals := map[string]int{}
	rejected := 0
	for i := 1; i < len(lines); i++ {
		l := lines[i]
		if strings.Trim(l, " ") == "" {
			continue
		}
		f := strings.Split(l, ",")
		why := ""
		weight, dec := 0, 0
		if len(f) != 5 {
			why = "malformed row"
		} else {
			var wOK, dOK bool
			weight, wOK = digits(f[2], 5)
			dec, dOK = digits(f[4], 8)
			svcOK := f[3] == "standard" || f[3] == "express" || f[3] == "overnight"
			cc := f[1]
			switch {
			case !validOrder(f[0]):
				why = "bad order"
			case len(cc) != 2 || cc[0] < 'A' || cc[0] > 'Z' || cc[1] < 'A' || cc[1] > 'Z':
				why = "bad country"
			case !wOK || weight < 1 || weight > 30000:
				why = "bad weight"
			case !svcOK:
				why = "bad service"
			case !dOK || dec > 10000000:
				why = "bad declared"
			case seen[f[0]]:
				why = "duplicate order"
			case f[3] == "overnight" && zoneOf(cc) != 1:
				why = "overnight unavailable"
			}
		}
		if why != "" {
			fmt.Fprintf(w, "line %d: rejected: %s\n", i+1, why)
			rejected++
			continue
		}
		oid, svc := f[0], f[3]
		seen[oid] = true
		z := zoneOf(f[1])
		band := (weight + 499) / 500
		rate := rates[z][0] + rates[z][1]*(band-1)
		base := rate
		if svc == "express" {
			base = (rate*3 + 1) / 2
		} else if svc == "overnight" {
			base = rate * 3
		}
		if svc == "standard" && z == 1 && weight <= 2000 && dec >= 5000 {
			base = 0
		}
		fuel := (base*8 + 50) / 100
		ins := 0
		if dec > 10000 {
			ins = (dec + 50) / 100
		}
		total := base + fuel + ins
		count[svc]++
		totals[svc] += total
		fmt.Fprintf(w, "%s | zone=%d | band=%d | base=%s | fuel=%s | insurance=%s | total=%s\n", oid, z, band, money(base), money(fuel), money(ins), money(total))
	}
	orders, sum := 0, 0
	for _, k := range services {
		fmt.Fprintf(w, "service %s: orders=%d total=%s\n", k, count[k], money(totals[k]))
		orders += count[k]
		sum += totals[k]
	}
	fmt.Fprintf(w, "summary: orders=%d rejected=%d total=%s\n", orders, rejected, money(sum))
}
