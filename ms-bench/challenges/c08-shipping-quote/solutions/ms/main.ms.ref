import {stdin, stdout, read_line} from "@std/io.ms"
import Set from "@std/collections.ms"

fn money(c: Int) -> String:
    let cents = c % 100
    if cents < 10:
        return "{c / 100}.0{cents}"
    return "{c / 100}.{cents}"

fn zone_of(c: String) -> Int:
    if c == "US":
        return 1
    if c == "CA" or c == "MX":
        return 2
    let europe = ["AT", "BE", "DE", "ES", "FR", "IE", "IT", "NL", "PT", "SE"]
    for e in europe:
        if e == c:
            return 3
    return 4

# Parses s when it is 1 to max_len ASCII digits.
fn digits(s: String, max_len: Int) -> Optional[Int]:
    let codes = s.scalar_values()
    if codes.length() < 1 or codes.length() > max_len:
        return none
    var n = 0
    for c in codes:
        if c < 48 or c > 57:
            return none
        n = n * 10 + (c - 48)
    return some(n)

fn valid_order(s: String) -> Bool:
    let codes = s.scalar_values()
    if codes.is_empty():
        return false
    for c in codes:
        let ok = (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45
        if not ok:
            return false
    return true

fn valid_country(s: String) -> Bool:
    let codes = s.scalar_values()
    if codes.length() != 2:
        return false
    return codes.at(0).unwrap() >= 65 and codes.at(0).unwrap() <= 90 and codes.at(1).unwrap() >= 65 and codes.at(1).unwrap() <= 90

fn service_index(s: String) -> Int:
    if s == "standard":
        return 0
    if s == "express":
        return 1
    if s == "overnight":
        return 2
    return -1

fn reject_reason(f: List[String], seen: Set[String]) -> String:
    if f.length() != 5:
        return "malformed row"
    if not valid_order(f.at(0).unwrap()):
        return "bad order"
    if not valid_country(f.at(1).unwrap()):
        return "bad country"
    let w = digits(f.at(2).unwrap(), 5)
    if w.is_none() or w.unwrap() < 1 or w.unwrap() > 30000:
        return "bad weight"
    if service_index(f.at(3).unwrap()) < 0:
        return "bad service"
    let d = digits(f.at(4).unwrap(), 8)
    if d.is_none() or d.unwrap() > 10000000:
        return "bad declared"
    if seen.contains(f.at(0).unwrap()):
        return "duplicate order"
    if f.at(3).unwrap() == "overnight" and zone_of(f.at(1).unwrap()) != 1:
        return "overnight unavailable"
    return ""

fn run() -> Result[Unit, Error]:
    let lines = List[String]()
    while true:
        let next = try read_line(input: stdin(), max_bytes: 1048576)
        if next.is_none():
            break
        lines.append(next.unwrap())
    if lines.is_empty() or lines.at(0).unwrap() != "order,country,weight_g,service,declared_cents":
        try stdout().write("error: bad header\n".to_bytes())
        return stdout().flush()
    let starts = [499, 899, 1499, 2199]
    let steps = [120, 180, 250, 400]
    let names = ["standard", "express", "overnight"]
    let counts = [0, 0, 0]
    let totals = [0, 0, 0]
    let seen = Set[String]()
    var rejected = 0
    var i = 1
    while i < lines.length():
        let l = lines.at(i).unwrap()
        i = i + 1
        if l.replace_all(old: " ", new: "").unwrap().is_empty():
            continue
        let f = l.split(",")
        let why = reject_reason(f, seen)
        if not why.is_empty():
            try stdout().write("line {i}: rejected: {why}\n".to_bytes())
            rejected = rejected + 1
            continue
        let id = f.at(0).unwrap()
        seen.add(id)
        let weight = digits(f.at(2).unwrap(), 5).unwrap()
        let declared = digits(f.at(4).unwrap(), 8).unwrap()
        let service = service_index(f.at(3).unwrap())
        let zone = zone_of(f.at(1).unwrap())
        let band = (weight + 499) / 500
        let rate = starts.at(zone - 1).unwrap() + steps.at(zone - 1).unwrap() * (band - 1)
        var base = rate
        if service == 1:
            base = (rate * 3 + 1) / 2
        else if service == 2:
            base = rate * 3
        if service == 0 and zone == 1 and weight <= 2000 and declared >= 5000:
            base = 0
        let fuel = (base * 8 + 50) / 100
        var insurance = 0
        if declared > 10000:
            insurance = (declared + 50) / 100
        let total = base + fuel + insurance
        counts.set(service, counts.at(service).unwrap() + 1)
        totals.set(service, totals.at(service).unwrap() + total)
        try stdout().write("{id} | zone={zone} | band={band} | base={money(base)} | fuel={money(fuel)} | insurance={money(insurance)} | total={money(total)}\n".to_bytes())
    var orders = 0
    var sum = 0
    var k = 0
    while k < 3:
        try stdout().write("service {names.at(k).unwrap()}: orders={counts.at(k).unwrap()} total={money(totals.at(k).unwrap())}\n".to_bytes())
        orders = orders + counts.at(k).unwrap()
        sum = sum + totals.at(k).unwrap()
        k = k + 1
    try stdout().write("summary: orders={orders} rejected={rejected} total={money(sum)}\n".to_bytes())
    return stdout().flush()

export fn main() -> Int:
    match run():
        ok(_): return 0
        error(_): return 1
